from yianc.frontend.lex.token import Token, PunctuatorKind, KeywordKind;
from yianc.frontend.source import Position, Span;
from yianc.frontend.text import SourceText;
from fmt.rules import word, prefix, closer, ends_operand, closes_type, hug_before, hug_after, binary, paren_space, bracket_hugs;
from fmt.trivia import gap, Gap;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;

struct Flags { inline_: bool, postfix: bool, tight: bool, closure_open: bool, closure_close: bool }

// These annotations depend only on lexical neighbourhoods, never on semantic analysis.
fn annotations(tokens: Vec<Token>&, count: u64) -> Vec<Flags> {
    let flags = Vec<Flags>.new();
    let braces = Vec<u64>.new();
    defer braces.drop();
    let operand_end = false;
    for index in 0u64..count {
        let token = &tokens[index];
        let marker = token.is_punct(PunctuatorKind.Star) || token.is_punct(PunctuatorKind.Ampersand);
        let postfix = marker && operand_end && closes_type(tokens, index, count);
        operand_end = if marker { postfix } else { ends_operand(token) };
        let tight = token.is_punct(PunctuatorKind.Equal) && index >= 2 && tokens[index - 1].is_identifier() &&
        (tokens[index - 2].is_punct(PunctuatorKind.LParen) || tokens[index - 2].is_punct(PunctuatorKind.Comma));
        flags.push(Flags(false, postfix, tight, false, false));

        if token.is_punct(PunctuatorKind.LBrace) { braces.push(index); } elif token.is_punct(PunctuatorKind.RBrace) && !braces.is_empty() {
            let opening = *braces.pop().unwrap();
            if tokens[opening].span.start.row == token.span.start.row {
                for inside in opening.. (index + 1) { flags[inside].inline_ = true; }
            }
        }
    }

    let opening = Option<u64>.None;
    operand_end = false;
    for index in 0u64..count {
        let token = &tokens[index];
        if token.is_punct(PunctuatorKind.Pipe) {
            if opening.is_none() && !operand_end { opening = Option<u64>.Some(index); flags[index].closure_open = true; } elif opening.is_some() { opening = Option<u64>.None; flags[index].closure_close = true; }
            operand_end = false;
        } else { operand_end = ends_operand(token) || flags[index].postfix; }
    }
    flags
}

struct Layout {
    tokens: Vec<Token>&,
    source: SourceText,
    flags: Vec<Flags>,
    count: u64,
    output: String,
    line_open: bool,
    pending: u64,
    depth: u64,
    parens: u64,
    blank_pending: bool,
}

impl Layout {
    static fn new(text: str, tokens: Vec<Token>&, count: u64) -> Self {
        Self(tokens, SourceText.new(text), annotations(tokens, count), count, String.new(), false, 0, 0, 0, false)
    }

    fn write(text: str) {
        if text == "" { return; }
        if !self.line_open {
            if self.blank_pending && !self.output.is_empty() { self.output.push('\n'); }
            self.blank_pending = false;
            for index in 0u64.. (self.pending * 4) { self.output.push(' '); }
            self.line_open = true;
        }
        self.output.push_str(text);
    }

    fn end_line() {
        if !self.line_open { return; }
        while self.output.as_str().ends_with(" ") { self.output.pop(); }
        self.output.push('\n');
        self.line_open = false;
    }

    fn newline(level: u64, blank: bool) {
        self.end_line();
        self.pending = level;
        self.blank_pending = blank && !self.output.is_empty();
    }

    fn indent(index: u64) -> u64 {
        let token = &self.tokens[index];
        let level = self.depth;
        if token.is_punct(PunctuatorKind.RBrace) && !self.flags[index].inline_ && level > 0 { level -= 1; }
        let closes = token.is_punct(PunctuatorKind.RParen) || token.is_punct(PunctuatorKind.RBracket);
        if self.parens > (if closes { 1u64 } else { 0u64 }) { level += 1; }
        level
    }

    fn breaks(index: u64, trivia: Gap&) -> bool {
        let token = &self.tokens[index];
        let previous = &self.tokens[index - 1];
        if (previous.is_punct(PunctuatorKind.LBrace) || (previous.is_punct(PunctuatorKind.Semicolon) && self.parens == 0)) && !self.flags[index - 1].inline_ { return true; }
        if token.is_punct(PunctuatorKind.RBrace) && !self.flags[index].inline_ { return true; }
        if previous.is_punct(PunctuatorKind.RBrace) {
            if token.is_keyword(KeywordKind.Else) || token.is_keyword(KeywordKind.Elif) { return false; }
            return match token.kind() { Punctuator(kind) => match kind { Semicolon | Comma | RParen | RBracket | Dot | RBrace | RAngle => false, _ => true, }, _ => true, };
        }
        trivia.broken
    }

    fn space(index: u64) -> bool {
        let token = &self.tokens[index];
        let previous = &self.tokens[index - 1];
        if self.flags[index].closure_close || self.flags[index - 1].closure_open { return false; }
        if self.flags[index - 1].closure_close { return true; }
        if (token.is_punct(PunctuatorKind.Equal) && self.flags[index].tight) || (previous.is_punct(PunctuatorKind.Equal) && self.flags[index - 1].tight) { return false; }
        if token.is_punct(PunctuatorKind.LAngle) || token.is_punct(PunctuatorKind.RAngle) || previous.is_punct(PunctuatorKind.LAngle) { return false; }
        if previous.is_punct(PunctuatorKind.RAngle) {
            return !(hug_before(token) || token.is_punct(PunctuatorKind.LParen) || token.is_punct(PunctuatorKind.LBracket) || token.is_punct(PunctuatorKind.Star) || token.is_punct(PunctuatorKind.Ampersand) || token.is_punct(PunctuatorKind.RAngle));
        }
        if token.is_punct(PunctuatorKind.RBrace) { return !previous.is_punct(PunctuatorKind.LBrace); }
        if hug_before(token) { return false; }
        if token.is_punct(PunctuatorKind.LBracket) { return !bracket_hugs(previous, self.flags[index - 1].postfix); }
        if token.is_punct(PunctuatorKind.LParen) {
            return !((word(previous) && !paren_space(previous)) || prefix(previous, self.tokens, index - 1) ||
                match previous.kind() { Punctuator(kind) => match kind { RParen | RBracket | RAngle | LParen | LBracket | Dot | Question => true, _ => false, }, _ => false, });
        }
        if hug_after(previous) { return false; }
        if previous.is_punct(PunctuatorKind.Exclamation) {
            return !(word(token) || token.is_punct(PunctuatorKind.LParen) || token.is_punct(PunctuatorKind.LBracket) || token.is_punct(PunctuatorKind.Star) || token.is_punct(PunctuatorKind.Ampersand));
        }
        if token.is_punct(PunctuatorKind.At) || binary(token) || token.is_punct(PunctuatorKind.Minus) || token.is_punct(PunctuatorKind.Plus) { return true; }
        if previous.is_punct(PunctuatorKind.Colon) || previous.is_punct(PunctuatorKind.Comma) { return true; }
        if previous.is_punct(PunctuatorKind.Minus) || previous.is_punct(PunctuatorKind.Plus) { return !prefix(previous, self.tokens, index - 1); }
        if previous.is_punct(PunctuatorKind.Star) || previous.is_punct(PunctuatorKind.Ampersand) {
            if self.flags[index - 1].postfix { return !self.flags[index].postfix; }
            return !prefix(previous, self.tokens, index - 1);
        }
        if token.is_punct(PunctuatorKind.Star) || token.is_punct(PunctuatorKind.Ampersand) { return !self.flags[index].postfix; }
        if token.is_punct(PunctuatorKind.DotDot) || previous.is_punct(PunctuatorKind.DotDot) { return false; }
        true
    }

    fn comments(trivia: Gap&) {
        for comment in trivia.comments {
            let body = clean_comment(comment.text);
            defer body.drop();
            if comment.own_line || !self.line_open {
                self.end_line();
                self.newline(self.depth + (if self.parens > 0 { 1u64 } else { 0u64 }), comment.blank_before);
                self.write(body.as_str());
            } else { self.write(" "); self.write(body.as_str()); }
            self.end_line();
        }
    }

    fn track(index: u64) {
        let token = &self.tokens[index];
        if token.is_punct(PunctuatorKind.LParen) || token.is_punct(PunctuatorKind.LBracket) { self.parens += 1; } elif token.is_punct(PunctuatorKind.RParen) || token.is_punct(PunctuatorKind.RBracket) { if self.parens > 0 { self.parens -= 1; } } elif token.is_punct(PunctuatorKind.LBrace) && !self.flags[index].inline_ { self.depth += 1; } elif token.is_punct(PunctuatorKind.RBrace) && !self.flags[index].inline_ && self.depth > 0 { self.depth -= 1; }
    }

    fn render() -> String {
        let index = 0u64;
        let previous = Position(0, 0);
        while index < self.count {
            let token = &self.tokens[index];
            let trivia = gap(self.source.slice(Span(previous, token.span.start)), previous.column);
            defer trivia.drop();

            // Formatted strings are opaque. Preserve their source region, including interpolation spacing.
            let formatted = match token.kind() { FStrStart => true, _ => false, };
            if !formatted { self.comments(&trivia); }
            if index == 0 {
                if !self.output.is_empty() { self.blank_pending = trivia.blank_before; }
            } elif self.breaks(index, &trivia) {
                self.newline(self.indent(index), if formatted { false } else { trivia.blank_before });
            } elif self.line_open && self.space(index) { self.output.push(' '); }

            if formatted {
                let stop = index;
                while stop < self.count && !(match self.tokens[stop].kind() { FStrEnd => true, _ => false, }) { stop += 1; }
                let after = if stop < self.count { stop + 1 } else { stop };
                let end = if after < self.count { self.tokens[after].span.start } else { self.tokens[stop].span.end };
                self.write(trim_end(self.source.slice(Span(token.span.start, end))));
                previous = if after > 0 { self.tokens[after - 1].span.end } else { end };
                index = after;
                continue;
            }
            self.write(token.raw.as_str());
            self.track(index);
            previous = token.span.end;
            index += 1;
        }
        let footer = gap(self.source.tail(previous), previous.column);
        defer footer.drop();
        self.comments(&footer);
        self.end_line();
        let output = self.output;
        self.output = String.new();
        output
    }
}

impl Drop for Layout {
    pub fn drop() { self.source.drop(); self.flags.drop(); self.output.drop(); }
}

fn clean_comment(text: str) -> String {
    let output = String.new();
    let first = true;
    for line in text.split("\n") {
        if !first { output.push('\n'); }
        output.push_str(trim_end(line));
        first = false;
    }
    output
}

pub fn format_tokens(text: str, tokens: Vec<Token>&) -> String {
    let count = tokens.len();
    if count > 0 && tokens[count - 1].is_eof() { count -= 1; }
    let layout = Layout.new(text, tokens, count);
    defer layout.drop();
    layout.render()
}

fn trim_end(text: str) -> str {
    let end = 0u64;
    for entry in text.char_indices() {
        let offset = entry[0];
        let current = entry[1];
        let code = u32(current);
        let whitespace = (code >= 9 && code <= 13) || (code >= 28 && code <= 32) || code == 0x85 || code == 0xA0 ||
        code == 0x1680 || (code >= 0x2000 && code <= 0x200A) || code == 0x2028 || code == 0x2029 || code == 0x202F || code == 0x205F || code == 0x3000;
        if !whitespace { end = offset + if code < 0x80 { 1u64 } elif code < 0x800 { 2u64 } elif code < 0x10000 { 3u64 } else { 4u64 }; }
    }
    str.from_slice_unchecked(text.as_slice()[0u64..end])
}
