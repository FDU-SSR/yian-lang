from yianc.common.ids import SourceId;
from yianc.frontend.prepare import FrontendPhase;
from yianc.diagnostics.model import AnalysisError;
from fmt.layout import format_tokens;
from yianc.frontend.prepare import prepare_file;

// Formatting validates the source without desugaring or semantic analysis.
// A syntax failure is deliberately represented as None so callers can preserve
// the established CLI behavior of skipping files that cannot be formatted.
pub fn format_text(text: str, path: str) -> Result<Option<String>, AnalysisError> {
    let prepared = match prepare_file(SourceId(0), path, text, FrontendPhase.Ast) {
        Ok(value) => value,
        Err(problem) => {
            problem.drop();
            return Result<Option<String>, AnalysisError>.Ok(Option<String>.None);
        },
    };
    defer prepared.drop();

    let formatted = format_tokens(text, &prepared.tokens);
    Result<Option<String>, AnalysisError>.Ok(Option<String>.Some(formatted))
}
