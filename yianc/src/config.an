from std.cli import ArgumentParser, Nargs, ArgMatches, Action;
from std.core.process import env_var;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation, UserDiagnostic;
from yianc.diagnostics.report import report;
from yianc.frontend.source import SourceTable;
from std.core.convert import From;

const EXIT_FAILURE: i32 = 1;
const EXIT_USAGE_ERROR: i32 = 2;

pub struct CliError { pub message: String, pub status: i32, pub usage: Option<String> }

impl UserDiagnostic for CliError {
    pub fn message() -> String { String.from(&self.message.as_str()) }
    pub fn location() -> DiagnosticLocation { DiagnosticLocation.Global }
    pub fn code() -> DiagnosticCode { DiagnosticCode.CommandLine }
}

impl Drop for CliError {
    pub fn drop() {
        self.message.drop();
        match &self.usage { Some(value) => value.drop(), None => {}, }
    }
}

fn config_error(text: String, status: i32) -> CliError {
    let trimmed = text.as_str().trim();
    let body = if trimmed.starts_with("error: ") { str.from_slice_unchecked(trimmed.as_slice()[7u64..trimmed.as_slice().len()]) } else { trimmed };
    let message = String.from(&body);
    text.drop();
    CliError(message, status, Option<String>.None)
}

pub enum CompilerAction {
    Compile,
    Check,
}

pub enum OutputKind {
    Exe, Ll, Bc,
}

impl OutputKind {
    pub fn extension() -> str {
        match self { Exe => "", Ll => "ll", Bc => "bc", }
    }
}

pub struct CompilerConfig {
    pub action: CompilerAction,
    pub inputs: Vec<String>,
    pub compiler_root: String,
    pub root_explicit: bool,
    pub packages: Option<String>,
    pub raw_pointers: bool,
    pub target: OutputKind,
    pub target_explicit: bool,
    pub output: Option<String>,
    pub optimization: u8,
    pub dump: bool,
    pub profile: bool,
    pub profile_output: Option<String>,
    pub runtime_profile_dir: Option<String>,
    pub log_enabled: bool,
    pub log_spec: Option<String>,
    pub log_file: Option<String>,
    pub link_libraries: Vec<String>,
    pub link_searches: Vec<String>,
    pub cfg_inline: bool,
    pub fat_check_elimination: bool,
}

// Empty and unset select the default; only 0 and 1 are accepted values.
fn environment_switch(name: str, fallback: bool) -> Result<bool, String> {
    // Nested Result/Option patterns are avoided so the value branch is unambiguous.
    match env_var(name) {
        Ok(option) => match option {
            Some(value) => {
                defer value.drop();
                if value.as_str() == "" { return Result<bool, String>.Ok(fallback); }
                if value.as_str() == "0" { return Result<bool, String>.Ok(false); }
                if value.as_str() == "1" { return Result<bool, String>.Ok(true); }
                let message = String.new();
                message.push_str("error: ");
                message.push_str(name);
                message.push_str(" must be 0 or 1\n");
                Result<bool, String>.Err(message)
            },
            None => Result<bool, String>.Ok(fallback),
        },
        Err(problem) => {
            defer problem.drop();
            let message = String.new();
            message.push_str("error: could not read ");
            message.push_str(name);
            message.push_str(": ");
            message.push_str(problem.msg());
            message.push('\n');
            Result<bool, String>.Err(message)
        },
    }
}

fn string_values(arg_matches: ArgMatches&, name: str) -> Vec<String> {
    let result = Vec<String>.new();
    match arg_matches.get_many(name) {
        Ok(Some(values)) => {
            for value in values {
                match value { Text(text) => result.push(String.from(&text.as_str())), _ => {}, }
            }
        },
        _ => {},
    }
    result
}

impl CompilerConfig {
    static fn from_matches(arg_matches: ArgMatches&) -> Result<Self, CliError> {
        let check = *arg_matches.get_bool("check").unwrap().unwrap();

        let inputs = string_values(arg_matches, "inputs");
        if inputs.is_empty() {
            inputs.drop();
            return Result<Self, CliError>.Err(config_error(String.from(&"error: the following arguments are required: PATH\n"), EXIT_USAGE_ERROR));
        }

        let root = match arg_matches.get_string("compiler-root") {
            Ok(Some(value)) => String.from(&value),
            _ => String.from(&"."),
        };
        let packages = match arg_matches.get_string("packages") {
            Ok(Some(value)) => Option<String>.Some(String.from(&value)),
            _ => Option<String>.None,
        };
        let raw = *arg_matches.get_bool("raw-pointers").unwrap().unwrap();
        let target_explicit = match arg_matches.was_provided("target") { Ok(value) => value, Err(_) => false, };
        let target = match arg_matches.get_string("target") {
            Ok(Some(text)) => match text {
                "ll" => OutputKind.Ll, "bc" => OutputKind.Bc, _ => OutputKind.Exe,
            },
            _ => OutputKind.Exe,
        };
        let output = match arg_matches.get_string("output") {
            Ok(Some(text)) => Option<String>.Some(String.from(&text)),
            _ => Option<String>.None,
        };
        let optimization = match arg_matches.get_string("optimization") {
            Ok(Some(text)) => match text { "1" => 1u8, "2" => 2u8, "3" => 3u8, _ => 0u8, },
            _ => 0u8,
        };
        let dump = *arg_matches.get_bool("dump").unwrap().unwrap();
        let log_enabled = *arg_matches.get_bool("log").unwrap().unwrap();
        let profile = *arg_matches.get_bool("profile").unwrap().unwrap();
        let profile_output = match arg_matches.get_string("profile-output") {
            Ok(Some(value)) => Option<String>.Some(String.from(&value)),
            _ => Option<String>.None,
        };
        let runtime_profile_dir = match arg_matches.get_string("runtime-profile-dir") {
            Ok(Some(value)) => Option<String>.Some(String.from(&value)),
            _ => Option<String>.None,
        };
        let log_spec = match arg_matches.get_string("log-spec") { Ok(Some(value)) => Option<String>.Some(String.from(&value)), _ => Option<String>.None, };
        let log_file = match arg_matches.get_string("log-file") { Ok(Some(value)) => Option<String>.Some(String.from(&value)), _ => Option<String>.None, };
        let link_libraries = string_values(arg_matches, "link-lib");
        let link_searches = string_values(arg_matches, "link-search");
        let cfg_inline_disabled = *arg_matches.get_bool("no-cfg-inline").unwrap().unwrap();
        let eliminate_disabled = *arg_matches.get_bool("no-fat-check-elimination").unwrap().unwrap();
        let action = if check { CompilerAction.Check } else { CompilerAction.Compile };
        let config = Self(action, inputs, root, arg_matches.get_string("compiler-root").unwrap().is_some(), packages, raw, target, target_explicit, output, optimization,
            dump, profile, profile_output, runtime_profile_dir, log_enabled, log_spec, log_file, link_libraries, link_searches,
            true, true);
        let transferred = false;
        defer { if !transferred { config.drop(); } };
        config.cfg_inline = match environment_switch("YIAN_CFG_INLINE", true) {
            Ok(value) => value && !cfg_inline_disabled,
            Err(message) => return Result<Self, CliError>.Err(config_error(message, EXIT_USAGE_ERROR)),
        };
        config.fat_check_elimination = match environment_switch("YIAN_FAT_CHECK_ELIMINATION", true) {
            Ok(value) => value && !eliminate_disabled,
            Err(message) => return Result<Self, CliError>.Err(config_error(message, EXIT_USAGE_ERROR)),
        };

        match &config.runtime_profile_dir {
            Some(value) => {
                if value.is_empty() { return Result<Self, CliError>.Err(config_error(String.from(&"--runtime-profile-dir PATH cannot be empty"), EXIT_FAILURE)); }
                if check { return Result<Self, CliError>.Err(config_error(String.from(&"--runtime-profile-dir requires compilation without --check"), EXIT_FAILURE)); }
                if target != OutputKind.Exe { return Result<Self, CliError>.Err(config_error(String.from(&"--runtime-profile-dir requires target exe"), EXIT_FAILURE)); }
                if !value.as_str().starts_with("/") { return Result<Self, CliError>.Err(config_error(String.from(&"--runtime-profile-dir PATH must be absolute"), EXIT_FAILURE)); }
            },
            None => {},
        }
        if !log_enabled && config.log_spec.is_some() { return Result<Self, CliError>.Err(config_error(String.from(&"--log-spec requires --log"), EXIT_FAILURE)); }
        if !log_enabled && config.log_file.is_some() { return Result<Self, CliError>.Err(config_error(String.from(&"--log-file requires --log"), EXIT_FAILURE)); }
        match &config.profile_output {
            Some(value) => {
                if !profile { return Result<Self, CliError>.Err(config_error(String.from(&"--profile-output requires --profile"), EXIT_FAILURE)); }
                if value.is_empty() { return Result<Self, CliError>.Err(config_error(String.from(&"--profile-output PATH cannot be empty"), EXIT_FAILURE)); }
            },
            None => {},
        }
        if check && target_explicit { return Result<Self, CliError>.Err(config_error(String.from(&"--check does not accept --target"), EXIT_FAILURE)); }
        if check && config.output.is_some() { return Result<Self, CliError>.Err(config_error(String.from(&"--check does not accept --output"), EXIT_FAILURE)); }
        if check && (!config.link_libraries.is_empty() || !config.link_searches.is_empty()) {
            return Result<Self, CliError>.Err(config_error(String.from(&"--check does not accept native link options"), EXIT_FAILURE));
        }
        transferred = true;
        Result<Self, CliError>.Ok(config)
    }
}

impl Drop for CompilerConfig {
    pub fn drop() {
        let index = 0u64;

        while index < self.inputs.len() {
            self.inputs[index].drop();
            index += 1u64;
        }

        self.inputs.drop();
        self.compiler_root.drop();

        match &self.packages {
            Some(value) => value.drop(),
            None => {},
        }
        match &self.output { Some(value) => value.drop(), None => {}, }
        match &self.log_spec { Some(value) => value.drop(), None => {}, }
        match &self.log_file { Some(value) => value.drop(), None => {}, }
        match &self.profile_output { Some(value) => value.drop(), None => {}, }
        match &self.runtime_profile_dir { Some(value) => value.drop(), None => {}, }
        for value in self.link_libraries { value.drop(); }
        for value in self.link_searches { value.drop(); }
        self.link_libraries.drop();
        self.link_searches.drop();
    }
}

// Argument failures are terminal: the caller receives no error value.
fn exit_with_error(error: CliError) -> ! {
    match &error.usage { Some(value) => @eprint(value.as_str()), None => {}, }
    let sources = SourceTable.new();
    report(&error, &sources);
    exit(error.status);
}

// Configuration, help text and error text own their storage independently of the parser and command-line strings.
// Help requests write stdout and exit 0; argument failures report to stderr and exit.
pub fn parse_args() -> CompilerConfig {
    let parser = ArgumentParser.new("compiler");
    defer parser.drop();

    parser.description("YIAN compiler");

    parser.add_argument("check")
    .long("check").action(Action.StoreTrue)
    .help("type-check sources without generating an artifact");

    parser.add_argument("compiler-root")
    .long("compiler-root").metavar("PATH")
    .help("checkout root used for standard-library trust");

    parser.add_argument("packages")
    .long("packages").metavar("PATH")
    .help("v2 or v3 package map");

    parser.add_argument("raw-pointers")
    .long("raw-pointers").action(Action.StoreTrue)
    .help("analyze sources for raw-pointer mode");

    parser.add_argument("target")
    .long("target").short('t').choices(["exe", "ll", "bc"].as_slice()).default_value("exe").metavar("TARGET")
    .help("output kind");

    parser.add_argument("output")
    .long("output").short('o').metavar("PATH")
    .help("output path");

    parser.add_argument("optimization")
    .short('O').choices(["0", "1", "2", "3"].as_slice()).default_value("0")
    .help("optimization level");

    parser.add_argument("dump")
    .long("dump").action(Action.StoreTrue)
    .help("write completed stage observations");

    parser.add_argument("profile")
    .long("profile").action(Action.StoreTrue)
    .help("enable compiler stage timings");

    parser.add_argument("profile-output")
    .long("profile-output").metavar("PATH")
    .help("write structured compiler profile JSON to PATH (requires --profile)");

    parser.add_argument("runtime-profile-dir")
    .long("runtime-profile-dir").metavar("PATH")
    .help("build an instrumented executable that records runtime statistics to the absolute run directory PATH");

    parser.add_argument("log")
    .long("log").action(Action.StoreTrue)
    .help("enable compiler logging");

    parser.add_argument("log-spec")
    .long("log-spec")
    .help("channel=level logging configuration (requires --log)");

    parser.add_argument("log-file")
    .long("log-file")
    .help("additional logging output file (requires --log)");

    parser.add_argument("link-lib")
    .long("link-lib").action(Action.Append)
    .help("native library name");

    parser.add_argument("link-search")
    .long("link-search").action(Action.Append)
    .help("native library directory");

    parser.add_argument("no-cfg-inline")
    .long("no-cfg-inline").action(Action.StoreTrue)
    .help("disable CFG inlining");

    parser.add_argument("no-fat-check-elimination")
    .long("no-fat-check-elimination").action(Action.StoreTrue)
    .help("disable fat safety-check elimination");

    parser.add_argument("inputs")
    .nargs(Nargs.ZeroOrMore).metavar("INPUT")
    .help("input files or directories");

    match parser.parse_env() {
        Ok(outcome) => match outcome {
            Help(text) => {
                @print(text.as_str());
                exit(0);
            },
            Parsed(arg_matches) => {
                defer arg_matches.drop();
                match CompilerConfig.from_matches(&arg_matches) {
                    Ok(config) => config,
                    Err(error) => exit_with_error(error),
                }
            },
        },
        Err(error) => {
            let usage = match parser.format_usage() {
                Ok(text) => Option<String>.Some(text),
                Err(problem) => { problem.drop(); Option<String>.None },
            };
            let message = String.new();
            if error.argument() != "" { message.push_str(error.argument()); message.push_str(": "); }
            message.push_str(error.message());
            exit_with_error(CliError(message, EXIT_USAGE_ERROR, usage))
        },
    }
}
