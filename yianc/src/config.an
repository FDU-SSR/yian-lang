from std.cli import ArgumentParser, Nargs, ArgMatches, Action;

pub enum CompilerAction {
    Compile,
    Check,
    Invalid { message: String },
    Help {
        text: String
    },
}

pub enum OutputKind {
    Exe, Ll, Bc,
}

impl OutputKind {
    pub fn extension() -> str {
        match self { Exe => "", Ll => "ll", Bc => "bc", }
    }
}

pub struct CompilerConfig {
    pub action: CompilerAction,
    pub inputs: Vec<String>,
    pub compiler_root: String,
    pub root_explicit: bool,
    pub packages: Option<String>,
    pub raw_pointers: bool,
    pub allow_ffi: bool,
    pub target: OutputKind,
    pub target_explicit: bool,
    pub output: Option<String>,
    pub optimization: u8,
    pub dump: bool,
    pub profile: bool,
    pub profile_output: Option<String>,
    pub runtime_profile_dir: Option<String>,
    pub log_spec: Option<String>,
    pub log_file: Option<String>,
    pub link_libraries: Vec<String>,
    pub link_searches: Vec<String>,
}

fn string_values(matches: ArgMatches&, name: str) -> Vec<String> {
    let result = Vec<String>.new();
    match matches.get_many(name) {
        Ok(Some(values)) => {
            for value in values {
                match value { Text(text) => result.push(String.from(&text.as_str())), _ => {}, }
            }
        },
        _ => {},
    }
    result
}

impl CompilerConfig {
    static fn help(text: String) -> Self {
        Self(CompilerAction.Help(text), Vec<String>.new(), String.new(), false, Option<String>.None, false, false,
            OutputKind.Exe, false, Option<String>.None, 0u8, false, false, Option<String>.None, Option<String>.None, Option<String>.None, Option<String>.None,
            Vec<String>.new(), Vec<String>.new())
    }

    static fn from_matches(matches: ArgMatches&) -> Result<Self, String> {
        let check = *matches.get_bool("check").unwrap().unwrap();

        let inputs = string_values(matches, "inputs");
        if inputs.is_empty() {
            inputs.drop();
            return Result<Self, String>.Err(String.from(&"error: the following arguments are required: PATH\n"));
        }

        let root = match matches.get_string("compiler-root") {
            Ok(Some(value)) => String.from(&value),
            _ => String.from(&"."),
        };
        let packages = match matches.get_string("packages") {
            Ok(Some(value)) => Option<String>.Some(String.from(&value)),
            _ => Option<String>.None,
        };
        let raw = *matches.get_bool("raw-pointers").unwrap().unwrap();
        let ffi = *matches.get_bool("allow-ffi").unwrap().unwrap();
        let target_explicit = match matches.was_provided("target") { Ok(value) => value, Err(_) => false, };
        let target = match matches.get_string("target") {
            Ok(Some(text)) => match text {
                "ll" => OutputKind.Ll, "bc" => OutputKind.Bc, _ => OutputKind.Exe,
            },
            _ => OutputKind.Exe,
        };
        let output = match matches.get_string("output") {
            Ok(Some(text)) => Option<String>.Some(String.from(&text)),
            _ => Option<String>.None,
        };
        let optimization = match matches.get_string("optimization") {
            Ok(Some(text)) => match text { "1" => 1u8, "2" => 2u8, "3" => 3u8, _ => 0u8, },
            _ => 0u8,
        };
        let dump = *matches.get_bool("dump").unwrap().unwrap();
        let profile = *matches.get_bool("profile").unwrap().unwrap();
        let profile_output = match matches.get_string("profile-output") {
            Ok(Some(value)) => Option<String>.Some(String.from(&value)),
            _ => Option<String>.None,
        };
        let runtime_profile_dir = match matches.get_string("runtime-profile-dir") {
            Ok(Some(value)) => Option<String>.Some(String.from(&value)),
            _ => Option<String>.None,
        };
        let log_spec = match matches.get_string("log-spec") { Ok(Some(value)) => Option<String>.Some(String.from(&value)), _ => Option<String>.None, };
        let log_file = match matches.get_string("log-file") { Ok(Some(value)) => Option<String>.Some(String.from(&value)), _ => Option<String>.None, };
        let link_libraries = string_values(matches, "link-lib");
        let link_searches = string_values(matches, "link-search");

        let runtime_profile_error = match &runtime_profile_dir {
            Some(value) if value.is_empty() => Option<String>.Some(String.from(&"error: --runtime-profile-dir PATH cannot be empty\n")),
            Some(_) if check => Option<String>.Some(String.from(&"error: --runtime-profile-dir requires compilation without --check\n")),
            Some(_) if target != OutputKind.Exe => Option<String>.Some(String.from(&"error: --runtime-profile-dir requires target exe\n")),
            Some(value) if !value.as_str().starts_with("/") => Option<String>.Some(String.from(&"error: --runtime-profile-dir PATH must be absolute\n")),
            _ => Option<String>.None,
        };
        let profile_error = match &profile_output {
            Some(value) if value.is_empty() => Option<String>.Some(String.from(&"error: --profile-output PATH cannot be empty\n")),
            _ => Option<String>.None,
        };
        let action = match runtime_profile_error {
            Some(message) => CompilerAction.Invalid(message),
            None => match profile_error {
                Some(message) => CompilerAction.Invalid(message),
                None => if check && target_explicit {
                    CompilerAction.Invalid(String.from(&"error: --check does not accept --target\n"))
                } elif check && output.is_some() {
                    CompilerAction.Invalid(String.from(&"error: --check does not accept --output\n"))
                } elif check && (!link_libraries.is_empty() || !link_searches.is_empty()) {
                    CompilerAction.Invalid(String.from(&"error: --check does not accept native link options\n"))
                } elif check {
                    CompilerAction.Check
                } else {
                    CompilerAction.Compile
                },
            },
        };
        Result<Self, String>.Ok(Self(action, inputs, root, matches.get_string("compiler-root").unwrap().is_some(), packages, raw, ffi, target, target_explicit, output, optimization,
            dump, profile, profile_output, runtime_profile_dir, log_spec, log_file, link_libraries, link_searches))
    }
}

impl Drop for CompilerConfig {
    pub fn drop() {
        match &self.action {
            Help(text) | Invalid(text) => text.drop(),
            Check => {},
            Compile => {},
        }

        let index = 0u64;

        while index < self.inputs.len() {
            self.inputs[index].drop();
            index += 1u64;
        }

        self.inputs.drop();
        self.compiler_root.drop();

        match &self.packages {
            Some(value) => value.drop(),
            None => {},
        }
        match &self.output { Some(value) => value.drop(), None => {}, }
        match &self.log_spec { Some(value) => value.drop(), None => {}, }
        match &self.log_file { Some(value) => value.drop(), None => {}, }
        match &self.profile_output { Some(value) => value.drop(), None => {}, }
        match &self.runtime_profile_dir { Some(value) => value.drop(), None => {}, }
        for value in self.link_libraries { value.drop(); }
        for value in self.link_searches { value.drop(); }
        self.link_libraries.drop();
        self.link_searches.drop();
    }
}

// Configuration and error text own their storage independently of the parser and command-line strings.
pub fn parse_args() -> Result<CompilerConfig, String> {
    let parser = ArgumentParser.new("compiler");
    defer parser.drop();

    parser.description("YIAN compiler");

    parser.add_argument("check")
    .long("check").action(Action.StoreTrue)
    .help("type-check sources without generating an artifact");

    parser.add_argument("compiler-root")
    .long("compiler-root").metavar("PATH")
    .help("checkout root used for standard-library trust");

    parser.add_argument("packages")
    .long("packages").metavar("PATH")
    .help("v2 package map");

    parser.add_argument("raw-pointers")
    .long("raw-pointers").action(Action.StoreTrue)
    .help("analyze sources for raw-pointer mode");

    parser.add_argument("allow-ffi")
    .long("allow-ffi").action(Action.StoreTrue)
    .help("allow FFI in standalone sources");

    parser.add_argument("target")
    .long("target").short('t').choices(["exe", "ll", "bc"].as_slice()).default_value("exe").metavar("TARGET")
    .help("output kind");

    parser.add_argument("output")
    .long("output").short('o').metavar("PATH")
    .help("output path");

    parser.add_argument("optimization")
    .short('O').choices(["0", "1", "2", "3"].as_slice()).default_value("0")
    .help("optimization level");

    parser.add_argument("dump")
    .long("dump").action(Action.StoreTrue)
    .help("write completed stage observations");

    parser.add_argument("profile")
    .long("profile").action(Action.StoreTrue)
    .help("report actual stage timings");

    parser.add_argument("profile-output")
    .long("profile-output").metavar("PATH")
    .help("write structured compiler profile JSON to PATH");

    parser.add_argument("runtime-profile-dir")
    .long("runtime-profile-dir").metavar("PATH")
    .help("build an instrumented executable that records runtime statistics to the absolute run directory PATH");

    parser.add_argument("log-spec")
    .long("log-spec")
    .help("channel=level logging configuration");

    parser.add_argument("log-file")
    .long("log-file")
    .help("additional logging output file");

    parser.add_argument("link-lib")
    .long("link-lib").action(Action.Append)
    .help("native library name");

    parser.add_argument("link-search")
    .long("link-search").action(Action.Append)
    .help("native library directory");

    parser.add_argument("inputs")
    .nargs(Nargs.ZeroOrMore).metavar("INPUT")
    .help("input files or directories");

    match parser.parse_env() {
        Ok(outcome) => match outcome {
            Help(text) => Result<CompilerConfig, String>.Ok(CompilerConfig.help(text)),
            Parsed(matches) => {
                defer matches.drop();
                CompilerConfig.from_matches(&matches)
            },
        },
        Err(error) => {
            defer error.drop();
            let diagnostic = String.new();

            match parser.format_usage() {
                Ok(text) => {
                    defer text.drop();
                    diagnostic.push_str(text.as_str());
                },
                Err(problem) => problem.drop(),
            }

            let message = error.format();
            defer message.drop();
            diagnostic.push_str(message.as_str());
            Result<CompilerConfig, String>.Err(diagnostic)
        },
    }
}
