from yianc.types.model import Parameter;
from yianc.types.store import TypeStore;
from yianc.types.substitution import substitute;
from yianc.common.ids import TypeId, DefId;
from yianc.diagnostics.model import AnalysisError;
from std.collections.hash_map import HashMap;
from std.core.iter import Iterator, IntoIterator;

pub struct CallableSignature {
    pub definition: DefId,
    pub parameters: Vec<Parameter>,
    pub result: TypeId,
    pub receiver: Option<TypeId>,
    pub is_static: bool,
    pub is_header: bool,
    pub is_ffi: bool,
}

impl Drop for CallableSignature {
    pub fn drop() {
        self.parameters.drop();
    }
}

// This query borrows only session-owned records and remains valid after resolution ends.
pub fn store_substitutions(store: TypeStore&, type_id: TypeId) -> Result<HashMap<TypeId, TypeId>, AnalysisError> {
    let map = HashMap<TypeId, TypeId>.new();
    let accepted = false;
    defer {
        if !accepted {
            map.drop();
        }
    };

    match store.require(type_id)? {
        Nominal(id, arguments) => {
            let definition = *store.definition(*id).unwrap();
            let index = 0u64;

            while index < arguments.len() {
                let generic = *definition.generic(index).unwrap();

                if generic != arguments[index] {
                    map.insert(generic, arguments[index]);
                }

                index += 1;
            }
        },
        _ => @panic("callable instance is not nominal"),
    }

    accepted = true;
    Result<HashMap<TypeId, TypeId>, AnalysisError>.Ok(map)
}

// The returned parameter list belongs to the caller; identities belong to the type store.
pub fn store_signature(store: TypeStore&, type_id: TypeId) -> Result<CallableSignature, AnalysisError> {
    let substitutions = store_substitutions(store, type_id)?;
    defer substitutions.drop();
    let id = match store.require(type_id)? {
        Nominal(id, _) => *id,
        _ => @panic("invalid callable identity"),
    };
    let body = match store.complete_definition(id)? {
        Function(value) => value,
        Method(value) => value,
        _ => @panic("definition is not callable"),
    };
    let parameters = Vec<Parameter>.new();
    let accepted = false;
    defer {
        if !accepted {
            parameters.drop();
        }
    };

    for parameter in body.parameters {
        parameters.push(Parameter(parameter.name, substitute(store, parameter.type_id, &substitutions)?, parameter.span));
    }

    let result = substitute(store, body.result, &substitutions)?;
    let receiver = match &body.receiver {
        Some(value) => Option<TypeId>.Some(substitute(store, *value, &substitutions)?),
        None => Option<TypeId>.None,
    };

    accepted = true;
    Result<CallableSignature, AnalysisError>.Ok(CallableSignature(id, parameters, result, receiver, body.is_static, body.is_header, body.is_ffi))
}
