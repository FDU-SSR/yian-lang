from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import DiagnosticCode, AnalysisError;
from yianc.package.model import PackageMap, PackageSpec, NativeLLVM;
from yianc.package.provenance import normalize_path, within;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.fs import read_to_string, metadata;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;
from std.core.option import Option;
from std.core.path import PathBuf, Path;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;
from json.parse import parse;
from json.value import Value, Object;

fn invalid(message: str) -> AnalysisError {
    AnalysisError.user(DiagnosticCode.Source, Option<SourceSpan>.None, message)
}

fn field(table: Object&, name: str) -> Result<Value&, AnalysisError> {
    match table.get(name) {
        Some(value) => Result<Value&, AnalysisError>.Ok(value),
        None => Result<Value&, AnalysisError>.Err(invalid("missing package map field"))
    }
}

fn text(value: Value&) -> Result<str, AnalysisError> {
    match value {
        String(value) => Result<str, AnalysisError>.Ok(value.as_str()),
        _ => Result<str, AnalysisError>.Err(invalid("package map field must be a string"))
    }
}

fn object(value: Value&) -> Result<Object&, AnalysisError> {
    match value {
        Object(value) => Result<Object&, AnalysisError>.Ok(value),
        _ => Result<Object&, AnalysisError>.Err(invalid("package map field must be an object"))
    }
}

fn require_path_kind(path: str, directory: bool) -> Result<(), AnalysisError> {
    let info = match metadata(path) {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<(), AnalysisError>.Err(invalid(error.msg()));
        },
    };

    if (directory && !info.is_dir()) || (!directory && !info.is_file()) {
        return Result<(), AnalysisError>.Err(invalid("package path has an invalid file kind"));
    }

    Result<(), AnalysisError>.Ok(())
}

impl PackageMap {
    static pub fn load(path: str) -> Result<Self, AnalysisError> {
        let content = match read_to_string(path) {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                return Result<Self, AnalysisError>.Err(invalid(error.msg()));
            }
        };

        defer content.drop();
        let document = match parse(content.as_str()) {
            Ok(value) => value,
            Err(_) => return Result<Self, AnalysisError>.Err(invalid("invalid package map JSON"))
        };

        defer document.drop();
        Self.from_document(&document)
    }

    static pub fn from_document(document: Value&) -> Result<Self, AnalysisError> {
        let top = object(document)?;
        let format = field(top, "format")?;
        let valid_version = match format {
            Number(value) => match value {
                Signed(value) => *value == 2,
                Unsigned(value) => *value == 2,
                _ => false
            },
            _ => false
        };

        if !valid_version {
            return Result<Self, AnalysisError>.Err(invalid("package map requires format 2"));
        }

        let table = object(field(top, "packages")?)?;
        let result = Self.new();
        let transferred = false;
        defer {
            if !transferred {
                result.drop();
            }
        };

        let members = table.iter();

        loop {
            let member = match members.next() {
                Some(value) => value,
                None => break
            };

            let package = parse_spec(member[0], member[1])?;

            if result.find(package.name.as_str()).is_some() {
                package.drop();
                return Result<Self, AnalysisError>.Err(invalid("duplicate package name"));
            }

            result.packages.push(package);
        }

        if result.find("std").is_none() {
            return Result<Self, AnalysisError>.Err(invalid("package map requires std"));
        }

        match top.get("root") {
            None => {},
            Some(value) => match value {
                Null => {},
                _ => {
                    let name = text(value)?;

                    if result.find(name).is_none() {
                        return Result<Self, AnalysisError>.Err(invalid("unknown root package"));
                    }

                    result.root = Option<String>.Some(String.from(&name));
                }
            },
        }

        for package in result.packages {
            for dependency in package.dependencies {
                if result.find(dependency.as_str()).is_none() {
                    return Result<Self, AnalysisError>.Err(invalid("unknown package dependency"));
                }
            }
        }

        transferred = true;
        Result<Self, AnalysisError>.Ok(result)
    }
}

// This aggregate is the sole owner of every successfully parsed field.
fn parse_spec(name: str, value: Value&) -> Result<PackageSpec, AnalysisError> {
    if name.as_slice().len() == 0 {
        return Result<PackageSpec, AnalysisError>.Err(invalid("empty package name"));
    }

    let data = object(value)?;
    let root = text(field(data, "sourceRoot")?)?;
    if root.as_slice().len() == 0 {
        return Result<PackageSpec, AnalysisError>.Err(invalid("empty package source root"));
    }

    let source_root = normalize_path(root)?;
    let package = PackageSpec(String.from(&name), source_root, String.new(), Option<PathBuf>.None,
        Vec<String>.new(), false, Option<NativeLLVM>.None);
    let transferred = false;
    defer { if !transferred { package.drop(); } };

    require_path_kind(package.source_root.as_str(), true)?;
    package.kind = parse_kind(data)?;
    package.entry = parse_entry(data)?;
    package.dependencies = parse_dependencies(data)?;
    package.allows_ffi = parse_ffi(data)?;
    package.native_llvm = parse_native(data, &package)?;

    transferred = true;
    Result<PackageSpec, AnalysisError>.Ok(package)
}

fn parse_kind(data: Object&) -> Result<String, AnalysisError> {
    let kind = match data.get("kind") {
        None => "bin",
        Some(value) => text(value)?,
    };
    if kind != "bin" && kind != "lib" && kind != "hybrid" {
        return Result<String, AnalysisError>.Err(invalid("invalid package kind"));
    }
    Result<String, AnalysisError>.Ok(String.from(&kind))
}

fn parse_entry(data: Object&) -> Result<Option<PathBuf>, AnalysisError> {
    let value = match data.get("entry") {
        None => return Result<Option<PathBuf>, AnalysisError>.Ok(Option<PathBuf>.None),
        Some(value) => value,
    };
    match value {
        Null => return Result<Option<PathBuf>, AnalysisError>.Ok(Option<PathBuf>.None),
        _ => {},
    }

    let path = text(value)?;
    if path.as_slice().len() == 0 {
        return Result<Option<PathBuf>, AnalysisError>.Err(invalid("empty package entry"));
    }
    require_path_kind(path, false)?;
    Result<Option<PathBuf>, AnalysisError>.Ok(Option<PathBuf>.Some(normalize_path(path)?))
}

fn parse_dependencies(data: Object&) -> Result<Vec<String>, AnalysisError> {
    match data.get("dependencies") {
        None => Result<Vec<String>, AnalysisError>.Ok(Vec<String>.new()),
        Some(value) => string_array(value),
    }
}

fn parse_ffi(data: Object&) -> Result<bool, AnalysisError> {
    let value = match data.get("ffi") {
        None => return Result<bool, AnalysisError>.Ok(false),
        Some(value) => value,
    };
    match value {
        Boolean(enabled) => Result<bool, AnalysisError>.Ok(*enabled),
        _ => Result<bool, AnalysisError>.Err(invalid("ffi must be boolean")),
    }
}

// Partial string arrays release each copied string before releasing their buffer.
fn string_array(value: Value&) -> Result<Vec<String>, AnalysisError> {
    let values = match value {
        Array(values) => values,
        _ => return Result<Vec<String>, AnalysisError>.Err(invalid("expected an array of strings")),
    };
    let strings = Vec<String>.new();
    let transferred = false;
    defer { if !transferred { drop_strings(&strings); } };
    for value in *values {
        let entry = text(value)?;
        strings.push(String.from(&entry));
    }
    transferred = true;
    Result<Vec<String>, AnalysisError>.Ok(strings)
}
fn drop_strings(strings: Vec<String>&) {
    for value in *strings { value.drop(); }
    strings.drop();
}

fn parse_native(data: Object&, package: PackageSpec&) -> Result<Option<NativeLLVM>, AnalysisError> {
    let value = match data.get("nativeLLVM") {
        None => return Result<Option<NativeLLVM>, AnalysisError>.Ok(Option<NativeLLVM>.None),
        Some(value) => value,
    };
    match value {
        Null => return Result<Option<NativeLLVM>, AnalysisError>.Ok(Option<NativeLLVM>.None),
        _ => {},
    }
    if !package.allows_ffi {
        return Result<Option<NativeLLVM>, AnalysisError>.Err(invalid("nativeLLVM requires ffi permission"));
    }

    let native_data = object(value)?;
    validate_native_header(native_data)?;
    let native = NativeLLVM(22, Vec<String>.new(), Vec<String>.new());
    let transferred = false;
    defer { if !transferred { native.drop(); } };
    native.components = string_array(field(native_data, "components")?)?;
    native.sources = string_array(field(native_data, "sources")?)?;

    if native.components.len() == 0 {
        return Result<Option<NativeLLVM>, AnalysisError>.Err(invalid("nativeLLVM requires components"));
    }
    for component in native.components { validate_component(component.as_str())?; }

    let root = match package.source_root.as_path().parent() {
        Some(root) => root,
        None => return Result<Option<NativeLLVM>, AnalysisError>.Err(invalid("package root is unavailable")),
    };
    for path in native.sources { validate_native_source(path.as_str(), root)?; }

    transferred = true;
    Result<Option<NativeLLVM>, AnalysisError>.Ok(Option<NativeLLVM>.Some(native))
}

fn validate_native_header(data: Object&) -> Result<(), AnalysisError> {
    let entries = data.iter();
    loop {
        let entry = match entries.next() { Some(value) => value, None => break };
        if entry[0] != "major" && entry[0] != "components" && entry[0] != "sources" {
            return Result<(), AnalysisError>.Err(invalid("unknown nativeLLVM field"));
        }
    }

    let valid = match field(data, "major")? {
        Number(number) => match number {
            Signed(value) => *value == 22,
            Unsigned(value) => *value == 22,
            _ => false,
        },
        _ => false,
    };
    if !valid { return Result<(), AnalysisError>.Err(invalid("nativeLLVM requires LLVM 22")); }
    Result<(), AnalysisError>.Ok(())
}

fn validate_component(name: str) -> Result<(), AnalysisError> {
    let bytes = name.as_slice();
    if bytes.len() == 0 { return Result<(), AnalysisError>.Err(invalid("empty LLVM component")); }

    for index in 0u64..bytes.len() {
        let byte = bytes[index];
        let alpha = (byte >= b'A' && byte <= b'Z') || (byte >= b'a' && byte <= b'z');
        if !alpha && !(index > 0 && byte >= b'0' && byte <= b'9') {
            return Result<(), AnalysisError>.Err(invalid("invalid LLVM component"));
        }
    }
    Result<(), AnalysisError>.Ok(())
}

fn validate_native_source(path: str, root: Path) -> Result<(), AnalysisError> {
    if path.starts_with("/") || !path.ends_with(".c") {
        return Result<(), AnalysisError>.Err(invalid("invalid native source"));
    }
    let parts = path.split("/");
    loop {
        let part = match parts.next() { Some(value) => value, None => break };
        if part == ".." {
            return Result<(), AnalysisError>.Err(invalid("native source outside package"));
        }
    }

    let joined = root.join(path);
    defer joined.drop();
    let canonical = normalize_path(joined.as_str())?;
    defer canonical.drop();
    if !within(canonical.as_str(), root.as_str()) {
        return Result<(), AnalysisError>.Err(invalid("native source outside package"));
    }
    require_path_kind(canonical.as_str(), false)
}
