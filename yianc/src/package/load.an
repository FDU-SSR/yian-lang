from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation;
from yianc.input_error import InputError;
from yianc.package.model import PackageMap, PackageSpec, NativeC, NativeLLVM;
from yianc.package.provenance import normalize_path, within;
from std.core.convert import From;
from std.core.fs import read_to_string, metadata;
from std.core.io import File, OpenMode, Read;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;
from std.core.path import PathBuf, Path;
from json.parse import parse;
from json.value import Value, Object;

fn invalid(message: str) -> InputError {
    InputError(DiagnosticCode.Source, DiagnosticLocation.Global, String.from(&message))
}

fn at_file(error: InputError, path: str) -> InputError {
    error.location.drop();
    error.location = DiagnosticLocation.File(String.from(&path));
    error
}

fn field(table: Object&, name: str) -> Result<Value&, InputError> {
    match table.get(name) {
        Some(value) => Result<Value&, InputError>.Ok(value),
        None => Result<Value&, InputError>.Err(invalid("missing package map field"))
    }
}

fn text(value: Value&) -> Result<str, InputError> {
    match value {
        String(value) => Result<str, InputError>.Ok(value.as_str()),
        _ => Result<str, InputError>.Err(invalid("package map field must be a string"))
    }
}

fn object(value: Value&) -> Result<Object&, InputError> {
    match value {
        Object(value) => Result<Object&, InputError>.Ok(value),
        _ => Result<Object&, InputError>.Err(invalid("package map field must be an object"))
    }
}

fn require_path_kind(path: str, directory: bool) -> Result<(), InputError> {
    let info = match metadata(path) {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<(), InputError>.Err(invalid(error.msg()));
        },
    };

    if (directory && !info.is_dir()) || (!directory && !info.is_file()) {
        return Result<(), InputError>.Err(invalid("package path has an invalid file kind"));
    }

    Result<(), InputError>.Ok(())
}

impl PackageMap {
    static pub fn load(path: str) -> Result<Self, InputError> {
        let content = match read_to_string(path) {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                return Result<Self, InputError>.Err(at_file(invalid(error.msg()), path));
            }
        };

        defer content.drop();
        let document = match parse(content.as_str()) {
            Ok(value) => value,
            Err(_) => return Result<Self, InputError>.Err(at_file(invalid("invalid package map JSON"), path))
        };

        defer document.drop();
        match Self.from_document(&document) {
            Ok(value) => Result<Self, InputError>.Ok(value),
            Err(error) => Result<Self, InputError>.Err(at_file(error, path)),
        }
    }

    static pub fn from_document(document: Value&) -> Result<Self, InputError> {
        let top = object(document)?;
        let format = field(top, "format")?;
        let format_version = match format {
            Number(value) => match value {
                Signed(value) => if *value == 2 { 2u64 } elif *value == 3 { 3u64 } else { 0u64 },
                Unsigned(value) => if *value == 2u64 { 2u64 } elif *value == 3u64 { 3u64 } else { 0u64 },
                _ => 0u64
            },
            _ => 0u64
        };

        if format_version != 2u64 && format_version != 3u64 {
            return Result<Self, InputError>.Err(invalid("package map requires format 2 or 3"));
        }
        if format_version == 2u64 && top.get("nativeRoots").is_some() {
            return Result<Self, InputError>.Err(invalid("format 2 cannot declare nativeRoots"));
        }

        let table = object(field(top, "packages")?)?;
        let result = Self.new();
        let transferred = false;
        defer {
            if !transferred {
                result.drop();
            }
        };

        let members = table.iter();

        loop {
            let member = match members.next() {
                Some(value) => value,
                None => break
            };

            let package = parse_spec(member[0], member[1], format_version == 3u64)?;

            if result.find(package.name.as_str()).is_some() {
                package.drop();
                return Result<Self, InputError>.Err(invalid("duplicate package name"));
            }

            result.packages.push(package);
        }

        if result.find("std").is_none() {
            return Result<Self, InputError>.Err(invalid("package map requires std"));
        }

        match top.get("root") {
            None => {},
            Some(value) => match value {
                Null => {},
                _ => {
                    let name = text(value)?;

                    if result.find(name).is_none() {
                        return Result<Self, InputError>.Err(invalid("unknown root package"));
                    }

                    result.root = Option<String>.Some(String.from(&name));
                }
            },
        }

        if format_version == 3u64 {
            match top.get("nativeRoots") {
                None => {},
                Some(value) => {
                    let names = string_array(value)?;
                    let transferred_names = false;
                    defer { if !transferred_names { drop_strings(&names); } };
                    for name in names {
                        if result.find(name.as_str()).is_none() {
                            return Result<Self, InputError>.Err(invalid("unknown native root package"));
                        }
                        for existing in result.native_roots {
                            if existing.as_str() == name.as_str() {
                                return Result<Self, InputError>.Err(invalid("duplicate native root package"));
                            }
                        }
                        result.native_roots.push(String.from(&name.as_str()));
                    }
                    drop_strings(&names);
                    transferred_names = true;
                },
            }
        }

        for package in result.packages {
            for dependency in package.dependencies {
                if result.find(dependency.as_str()).is_none() {
                    return Result<Self, InputError>.Err(invalid("unknown package dependency"));
                }
            }
        }

        transferred = true;
        Result<Self, InputError>.Ok(result)
    }
}

// This aggregate is the sole owner of every successfully parsed field.
fn parse_spec(name: str, value: Value&, format3: bool) -> Result<PackageSpec, InputError> {
    if name.as_slice().len() == 0 {
        return Result<PackageSpec, InputError>.Err(invalid("empty package name"));
    }

    let data = object(value)?;
    let root = text(field(data, "sourceRoot")?)?;
    if root.as_slice().len() == 0 {
        return Result<PackageSpec, InputError>.Err(invalid("empty package source root"));
    }

    let source_root = normalize_path(root)?;
    if !format3 && data.get("nativeC").is_some() {
        source_root.drop();
        return Result<PackageSpec, InputError>.Err(invalid("format 2 cannot declare nativeC"));
    }
    let package = PackageSpec(String.from(&name), source_root, String.new(), Option<PathBuf>.None,
        Vec<String>.new(), false, Option<NativeLLVM>.None, Option<NativeC>.None);
    let transferred = false;
    defer { if !transferred { package.drop(); } };

    require_path_kind(package.source_root.as_str(), true)?;
    package.kind = parse_kind(data)?;
    package.entry = parse_entry(data)?;
    package.dependencies = parse_dependencies(data)?;
    package.allows_ffi = parse_ffi(data)?;
    package.native_llvm = parse_native(data, &package)?;
    if format3 { package.native_c = parse_native_c(data, &package)?; }

    transferred = true;
    Result<PackageSpec, InputError>.Ok(package)
}

fn parse_kind(data: Object&) -> Result<String, InputError> {
    let kind = match data.get("kind") {
        None => "bin",
        Some(value) => text(value)?,
    };
    if kind != "bin" && kind != "lib" && kind != "hybrid" {
        return Result<String, InputError>.Err(invalid("invalid package kind"));
    }
    Result<String, InputError>.Ok(String.from(&kind))
}

fn parse_entry(data: Object&) -> Result<Option<PathBuf>, InputError> {
    let value = match data.get("entry") {
        None => return Result<Option<PathBuf>, InputError>.Ok(Option<PathBuf>.None),
        Some(value) => value,
    };
    match value {
        Null => return Result<Option<PathBuf>, InputError>.Ok(Option<PathBuf>.None),
        _ => {},
    }

    let path = text(value)?;
    if path.as_slice().len() == 0 {
        return Result<Option<PathBuf>, InputError>.Err(invalid("empty package entry"));
    }
    require_path_kind(path, false)?;
    Result<Option<PathBuf>, InputError>.Ok(Option<PathBuf>.Some(normalize_path(path)?))
}

fn parse_dependencies(data: Object&) -> Result<Vec<String>, InputError> {
    match data.get("dependencies") {
        None => Result<Vec<String>, InputError>.Ok(Vec<String>.new()),
        Some(value) => string_array(value),
    }
}

fn parse_ffi(data: Object&) -> Result<bool, InputError> {
    let value = match data.get("ffi") {
        None => return Result<bool, InputError>.Ok(false),
        Some(value) => value,
    };
    match value {
        Boolean(enabled) => Result<bool, InputError>.Ok(*enabled),
        _ => Result<bool, InputError>.Err(invalid("ffi must be boolean")),
    }
}

// Partial string arrays release each copied string before releasing their buffer.
fn string_array(value: Value&) -> Result<Vec<String>, InputError> {
    let values = match value {
        Array(values) => values,
        _ => return Result<Vec<String>, InputError>.Err(invalid("expected an array of strings")),
    };
    let strings = Vec<String>.new();
    let transferred = false;
    defer { if !transferred { drop_strings(&strings); } };
    for value in *values {
        let entry = text(value)?;
        strings.push(String.from(&entry));
    }
    transferred = true;
    Result<Vec<String>, InputError>.Ok(strings)
}
fn drop_strings(strings: Vec<String>&) {
    for value in *strings { value.drop(); }
    strings.drop();
}

fn has_string(values: Vec<String>&, value: str) -> bool {
    for existing in *values {
        if existing.as_str() == value { return true; }
    }
    false
}

fn normal_archive(path: str) -> bool {
    let file = match File.open(path, OpenMode.Read) {
        Ok(value) => value,
        Err(problem) => { problem.drop(); return false; },
    };
    defer file.drop();
    let header: u8[8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    match file.read_exact(header.as_slice()) {
        Ok(_) => header[0] == b'!' && header[1] == b'<' && header[2] == b'a' &&
            header[3] == b'r' && header[4] == b'c' && header[5] == b'h' &&
            header[6] == b'>' && header[7] == b'\n',
        Err(problem) => { problem.drop(); false },
    }
}

fn parse_native_c_paths(data: Object&, field_name: str, package_root: Path,
    suffix: str, directory: bool, archive: bool) -> Result<Vec<String>, InputError> {
    let value = match data.get(field_name) {
        None => return Result<Vec<String>, InputError>.Ok(Vec<String>.new()),
        Some(value) => value,
    };
    let raw = string_array(value)?;
    defer drop_strings(&raw);
    let output = Vec<String>.new();
    let transferred = false;
    defer { if !transferred { drop_strings(&output); } };
    for input in raw {
        let path = input.as_str();
        if path == "" || Path.new(path).is_absolute() || (suffix != "" && !path.ends_with(suffix)) {
            return Result<Vec<String>, InputError>.Err(invalid("invalid nativeC path"));
        }
        let parts = path.split("/");
        loop {
            let part = match parts.next() { Some(value) => value, None => break };
            if part == ".." {
                return Result<Vec<String>, InputError>.Err(invalid("nativeC path escapes package"));
            }
        }
        let joined = package_root.join(path);
        defer joined.drop();
        let canonical = normalize_path(joined.as_str())?;
        defer canonical.drop();
        if !within(canonical.as_str(), package_root.as_str()) {
            return Result<Vec<String>, InputError>.Err(invalid("nativeC path escapes package"));
        }
        require_path_kind(canonical.as_str(), directory)?;
        if archive && !normal_archive(canonical.as_str()) {
            return Result<Vec<String>, InputError>.Err(invalid("nativeC archive is not a regular ar archive"));
        }
        let relative = if canonical.as_str() == package_root.as_str() { "." }
            else {
                let start = package_root.as_str().as_slice().len() + 1u64;
                str.from_slice_unchecked(canonical.as_str().as_slice()[start..canonical.as_str().as_slice().len()])
            };
        if has_string(&output, relative) {
            return Result<Vec<String>, InputError>.Err(invalid("duplicate nativeC path"));
        }
        output.push(String.from(&relative));
    }
    transferred = true;
    Result<Vec<String>, InputError>.Ok(output)
}

fn parse_native_c(data: Object&, package: PackageSpec&) -> Result<Option<NativeC>, InputError> {
    let value = match data.get("nativeC") {
        None => return Result<Option<NativeC>, InputError>.Ok(Option<NativeC>.None),
        Some(value) => value,
    };
    if !package.allows_ffi {
        return Result<Option<NativeC>, InputError>.Err(invalid("nativeC requires ffi permission"));
    }
    let native_data = object(value)?;
    let entries = native_data.iter();
    loop {
        let entry = match entries.next() { Some(value) => value, None => break };
        if entry[0] != "sources" && entry[0] != "includeDirs" && entry[0] != "archives" {
            return Result<Option<NativeC>, InputError>.Err(invalid("unknown nativeC field"));
        }
    }
    let root = match package.source_root.as_path().parent() {
        Some(root) => normalize_path(root.as_str())?,
        None => return Result<Option<NativeC>, InputError>.Err(invalid("package root is unavailable")),
    };
    defer root.drop();
    let native = NativeC(Vec<String>.new(), Vec<String>.new(), Vec<String>.new());
    let transferred = false;
    defer { if !transferred { native.drop(); } };
    native.sources = parse_native_c_paths(native_data, "sources", root.as_path(), ".c", false, false)?;
    native.include_dirs = parse_native_c_paths(native_data, "includeDirs", root.as_path(), "", true, false)?;
    native.archives = parse_native_c_paths(native_data, "archives", root.as_path(), ".a", false, true)?;
    if native.sources.is_empty() && native.archives.is_empty() {
        return Result<Option<NativeC>, InputError>.Err(invalid("nativeC requires a source or archive"));
    }
    transferred = true;
    Result<Option<NativeC>, InputError>.Ok(Option<NativeC>.Some(native))
}

fn parse_native(data: Object&, package: PackageSpec&) -> Result<Option<NativeLLVM>, InputError> {
    let value = match data.get("nativeLLVM") {
        None => return Result<Option<NativeLLVM>, InputError>.Ok(Option<NativeLLVM>.None),
        Some(value) => value,
    };
    match value {
        Null => return Result<Option<NativeLLVM>, InputError>.Ok(Option<NativeLLVM>.None),
        _ => {},
    }
    if !package.allows_ffi {
        return Result<Option<NativeLLVM>, InputError>.Err(invalid("nativeLLVM requires ffi permission"));
    }

    let native_data = object(value)?;
    validate_native_header(native_data)?;
    let native = NativeLLVM(22, Vec<String>.new(), Vec<String>.new());
    let transferred = false;
    defer { if !transferred { native.drop(); } };
    native.components = string_array(field(native_data, "components")?)?;
    native.sources = string_array(field(native_data, "sources")?)?;

    if native.components.len() == 0 {
        return Result<Option<NativeLLVM>, InputError>.Err(invalid("nativeLLVM requires components"));
    }
    for component in native.components { validate_component(component.as_str())?; }

    let root = match package.source_root.as_path().parent() {
        Some(root) => root,
        None => return Result<Option<NativeLLVM>, InputError>.Err(invalid("package root is unavailable")),
    };
    for path in native.sources { validate_native_source(path.as_str(), root)?; }

    transferred = true;
    Result<Option<NativeLLVM>, InputError>.Ok(Option<NativeLLVM>.Some(native))
}

fn validate_native_header(data: Object&) -> Result<(), InputError> {
    let entries = data.iter();
    loop {
        let entry = match entries.next() { Some(value) => value, None => break };
        if entry[0] != "major" && entry[0] != "components" && entry[0] != "sources" {
            return Result<(), InputError>.Err(invalid("unknown nativeLLVM field"));
        }
    }

    let valid = match field(data, "major")? {
        Number(number) => match number {
            Signed(value) => *value == 22,
            Unsigned(value) => *value == 22,
            _ => false,
        },
        _ => false,
    };
    if !valid { return Result<(), InputError>.Err(invalid("nativeLLVM requires LLVM 22")); }
    Result<(), InputError>.Ok(())
}

fn validate_component(name: str) -> Result<(), InputError> {
    let bytes = name.as_slice();
    if bytes.len() == 0 { return Result<(), InputError>.Err(invalid("empty LLVM component")); }

    for index in 0u64..bytes.len() {
        let byte = bytes[index];
        let alpha = (byte >= b'A' && byte <= b'Z') || (byte >= b'a' && byte <= b'z');
        if !alpha && !(index > 0 && byte >= b'0' && byte <= b'9') {
            return Result<(), InputError>.Err(invalid("invalid LLVM component"));
        }
    }
    Result<(), InputError>.Ok(())
}

fn validate_native_source(path: str, root: Path) -> Result<(), InputError> {
    if path.starts_with("/") || !path.ends_with(".c") {
        return Result<(), InputError>.Err(invalid("invalid native source"));
    }
    let parts = path.split("/");
    loop {
        let part = match parts.next() { Some(value) => value, None => break };
        if part == ".." {
            return Result<(), InputError>.Err(invalid("native source outside package"));
        }
    }

    let joined = root.join(path);
    defer joined.drop();
    let canonical = normalize_path(joined.as_str())?;
    defer canonical.drop();
    if !within(canonical.as_str(), root.as_str()) {
        return Result<(), InputError>.Err(invalid("native source outside package"));
    }
    require_path_kind(canonical.as_str(), false)
}
