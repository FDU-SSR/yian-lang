from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.analysis.dump import hir_dump;
from yianc.analysis.driver import MiddleEndDriver;
from yianc.codegen.session import TargetLayout;
from yianc.codegen.driver import BackendDriver;
from yianc.config import CompilerAction, parse_args;
from yianc.diagnostics.model import DiagnosticReporter, UserDiagnostic;
from yianc.diagnostics.report import report;
from yianc.frontend.source import SourceMap;
from yianc.frontend.driver import FrontendDriver;
from yianc.preprocess import load_packages, build_trust, collect_sources;
from yianc.telemetry.log import LogLevel;
from yianc.telemetry.profile import ProfileKind;
from yianc.telemetry.trace import CompilerTrace;
from std.core.io import Stderr, Write;

const EXIT_FAILURE: i32 = 1;

struct CliReporter {
    // The session owns the unit table; this reporter borrows a local handle while it renders.
    sources: SourceMap&,
}

impl DiagnosticReporter for CliReporter {
    pub fn report(diagnostic: UserDiagnostic&) {
        report(diagnostic, self.sources);
    }
}

fn main() {
    // Parse command line arguments
    let config = parse_args();
    defer config.drop();
    let check = &config.action matches Check;

    // Initialize the compiler trace for telemetry and profiling
    let trace = CompilerTrace.new(&config);
    defer trace.drop();
    trace.start_pass("compiler.total", "main", "compiler.total", ProfileKind.Stage);
    if !check { trace.event("main", LogLevel.Info, "compiling source inputs", Option<str>.None); }

    // Load packages, build trust, and collect source files
    trace.start_pass("preprocessing", "main", "preprocessing", ProfileKind.Stage);
    let packages = load_packages(&config, &trace);
    let trust = build_trust(&config, &trace, packages.as_ref());
    let sources = collect_sources(&config, &trace);
    trace.finish("preprocessing");

    // Run the frontend driver
    trace.start_pass("frontend", "main", "frontend", ProfileKind.Stage);
    let frontend = FrontendDriver.new(sources, config.dump, &trace);
    defer frontend.drop();
    let units = match frontend.run() {
        Ok(value) => value,
        Err(problem) => {
            trace.fail("frontend");
            report(&problem, &sources);
            exit(EXIT_FAILURE);
        },
    };
    trace.finish("frontend");

    // Create the analysis session and the target layout before semantic analysis.
    let session = dyn AnalysisSession.new(units, config.raw_pointers, trust, packages);
    let layout = match TargetLayout.new(&session.types, config.raw_pointers, config.optimization,
        config.runtime_profile_dir.is_some(), Option<CompilerTrace&>.Some(&trace)) {
        Ok(value) => value,
        Err(problem) => {
            report(&problem, &units);
            exit(EXIT_FAILURE);
        },
    };

    let options = AnalysisOptions.new();
    options.require_entry = !check;
    options.entry_optional = check;
    options.verify_hir = true;
    options.sizes = Option<TypeSizeProvider&>.Some(layout.backend_types());
    options.trace = Option<CompilerTrace&>.Some(&trace);

    let reporter = CliReporter(&units);
    // Run the middle-end driver for semantic analysis
    let middle = MiddleEndDriver.new(session, options, &reporter);
    defer middle.drop();

    trace.start_pass("semantic_analysis", "main", "semantic analysis", ProfileKind.Stage);
    let result = match middle.run() {
        Ok(value) => value,
        Err(problem) => {
            trace.fail("semantic_analysis");
            report(&problem, &units);
            exit(EXIT_FAILURE);
        },
    };
    trace.finish("semantic_analysis");
    // The layout borrows the session type store; release it before releasing the result.
    defer result.drop();
    defer layout.drop();

    if config.dump {
        match hir_dump(result.session, &result.output) {
            Ok(_) => {},
            Err(problem) => { report(&problem, &units); exit(EXIT_FAILURE); },
        }
    }
    if check {
        for pass_id in ["cfg_pipeline", "llvm_pipeline", "native_pipeline", "llvm.lower", "llvm.verify_before_optimization",
            "llvm.optimize", "llvm.verify_after_optimization", "llvm.emit_native", "llvm.serialize_ir", "llvm.serialize_bitcode",
            "native.prepare", "native.runtime_compile", "native.runtime_archive", "native.c_shim_compile", "native.link_flags", "native.link"] {
            trace.skip(*pass_id, "check stops after semantic analysis");
        }
        trace.finish("compiler.total");
    } else {
        let backend = BackendDriver.new(&result, &layout, &config, Option<CompilerTrace&>.Some(&trace));
        defer backend.drop();
        let compile_result = backend.run();
        trace.finish("compiler.total");
        match compile_result {
            Ok(_) => {},
            Err(error) => {
                report(&error, &units);
                match &error {
                    Native(problem) => match Stderr.new().write_all(problem.stderr.as_slice()) {
                        Ok(_) => {}, Err(write_error) => write_error.drop(),
                    },
                    _ => {},
                }
                exit(EXIT_FAILURE);
            },
        }
    }
    match trace.finalize(true) {
        Some(warning) => { report(&warning, &units); warning.drop(); },
        None => {},
    }
}
