from yianc.analysis.session.output import AnalysisOptions;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.codegen.session import BackendOptions;
from yianc.config import CompilerAction, CompilerConfig, parse_args;
from yianc.driver.backend import BackendDriver;
from yianc.driver.frontend import FrontendDriver;
from yianc.driver.middle import MiddleEndDriver;
from yianc.driver.profile import ProfileKind;
from yianc.driver.report import report;
from yianc.driver.trace import CompilerTrace;
from yianc.frontend.source import SourceManager;
from std.core.drop import Drop;
from std.core.env import exit;


const EXIT_FAILURE: i32 = 1;
const EXIT_USAGE_ERROR: i32 = 2;

fn main() {
    // Parse arguments, then handle help and invalid invocations before compilation.
    let config = match parse_args() {
        Ok(value) => value,
        Err(message) => {
            @eprintln(f"{message.as_str()}");
            exit(EXIT_USAGE_ERROR);
        },
    };
    defer config.drop();

    match &config.action {
        Help(text) => { @print(f"{text.as_str()}"); return; },
        Invalid(message) => { @eprintln(f"{message.as_str()}"); exit(EXIT_FAILURE); },
        Check => {},
        Compile => {},
    }

    let check = match &config.action { Check => true, _ => false, };
    let trace = match CompilerTrace.new(&config, check) {
        Ok(value) => value,
        Err(problem) => { @eprintln(f"{problem.as_str()}"); exit(EXIT_FAILURE); },
    };
    defer trace.drop();
    let profile_complete = false;
    defer trace.finalize(profile_complete);

    let total = trace.start_pass("compiler.total", "main", "compiler.total", ProfileKind.Stage);
    if !check { trace.event("main", 3, "compiling source inputs", Option<str>.None); }

    // Compile mode times source preparation; check mode stops before backend compilation.
    let source_started = if check { 0u64 } else { trace.start_pass("source_preparation", "main", "source preparation", ProfileKind.Stage) };
    let frontend = match FrontendDriver.prepare(&config, Option<CompilerTrace&>.Some(&trace)) {
        Ok(value) => value,
        Err(problem) => {
            if !check { trace.fail("source_preparation", source_started); }
            report(&problem.diagnostic, Option<SourceManager&>.None);
            exit(EXIT_FAILURE);
        },
    };
    if !check { trace.finish("source_preparation", source_started); }

    let middle = MiddleEndDriver.new(frontend.take_session(), config.raw_pointers);
    defer middle.drop();

    let runtime_profile_dir = match &config.runtime_profile_dir { Some(value) => Option<str>.Some(value.as_str()), None => Option<str>.None };
    // Analysis needs the target layout provider from the initialized backend session.
    let backend = match BackendDriver.new(middle.analysis_session(), BackendOptions(config.raw_pointers, config.optimization, runtime_profile_dir), Option<CompilerTrace&>.Some(&trace)) {
        Ok(value) => value,
        Err(problem) => {
            report(&problem.diagnostic, Option<SourceManager&>.Some(middle.analysis_session().source_manager()));
            exit(EXIT_FAILURE);
        },
    };
    defer backend.drop();

    if check {
        let options = AnalysisOptions.new();
        options.require_entry = false;
        options.entry_optional = true;
        options.recover = true;
        options.verify_hir = true;
        options.sizes = Option<TypeSizeProvider&>.Some(backend.size_provider());
        options.trace = Option<CompilerTrace&>.Some(&trace);
        let ok = middle.check(options, config.dump);

        for pass_id in ["cfg_pipeline", "llvm_pipeline", "native_pipeline", "llvm.lower", "llvm.verify_before_optimization",
            "llvm.optimize", "llvm.verify_after_optimization", "llvm.emit_native", "llvm.serialize_ir", "llvm.serialize_bitcode",
            "native.prepare", "native.runtime_compile", "native.runtime_archive", "native.c_shim_compile", "native.link_flags", "native.link"] {
            trace.skip(*pass_id, "check stops after semantic analysis");
        }
        trace.finish("compiler.total", total);
        profile_complete = ok;
        if !ok { exit(EXIT_FAILURE); }
        return;
    }

    let options = AnalysisOptions.new();
    options.require_entry = true;
    options.entry_optional = false;
    options.recover = false;
    options.verify_hir = true;
    options.sizes = Option<TypeSizeProvider&>.Some(backend.size_provider());
    options.trace = Option<CompilerTrace&>.Some(&trace);
    let analyzed_at = trace.start_pass("semantic_analysis", "main", "semantic analysis", ProfileKind.Stage);
    if !middle.analyze(options, config.dump) {
        trace.fail("semantic_analysis", analyzed_at);
        exit(EXIT_FAILURE);
    }
    trace.finish("semantic_analysis", analyzed_at);

    let ok = backend.compile(&config, middle.output(), Option<CompilerTrace&>.Some(&trace));
    trace.finish("compiler.total", total);
    profile_complete = ok;
    if !ok { exit(EXIT_FAILURE); }
}
