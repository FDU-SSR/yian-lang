from yianc.analysis.session.session import AnalysisSession;
from yianc.common.ids import UnitId, SourceId;
from yianc.common.location import SourceSpan;
from yianc.common.traversal import WalkControl;
from yianc.frontend.ast.node import Expr;
from yianc.frontend.ast.atoms import BuiltinKind;
from yianc.frontend.ast.walk import TryAstVisitor, try_walk_program;
from yianc.diagnostics.model import DiagnosticCode, AnalysisError, AnalysisErrorKind, AnalysisStage;

struct RestrictedVisitor {
    source: SourceId,
}

impl TryAstVisitor<AnalysisError> for RestrictedVisitor {
    pub fn enter_expr(node: Expr&) -> Result<WalkControl, AnalysisError> {
        match &node.data {
            Builtin(kind, _, _) => {
                let restricted = match kind {
                    SizeOf => false,
                    Panic => false,
                    FfiAddr => false,
                    FfiParts => false,
                    FfiNull => false,
                    FfiPtrCast => false,
                    _ => true,
                };

                if restricted {
                    return Result<WalkControl, AnalysisError>.Err(AnalysisError.named(DiagnosticCode.Restricted,
                        Option<SourceSpan>.Some(SourceSpan(self.source, node.span)), "restricted operation '@", kind.spelling(), "' is only allowed in the standard library"));
                }
            },
            _ => {},
        }

        Result<WalkControl, AnalysisError>.Ok(WalkControl.Continue)
    }
}

pub fn check_restricted(session: AnalysisSession&) -> Result<(), AnalysisError> {
    let index = 0u64;

    while index < session.len() {
        let unit = *session.unit(UnitId(index)).unwrap();

        if !unit.allows_restricted {
            let visitor = RestrictedVisitor(unit.source);
            match try_walk_program<AnalysisError>(unit.prepared.tree.unwrap().root, &visitor) {
                Ok(_) => {},
                Err(error) => return Result<(), AnalysisError>.Err(error.with_stage(AnalysisStage.Restricted)),
            }
        }

        index += 1;
    }

    Result<(), AnalysisError>.Ok(())
}
