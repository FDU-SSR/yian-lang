from yianc.analysis.resolution.context import ResolutionContext, Declaration;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.analysis.ty.display import type_text;
from yianc.common.ids import UnitId, TypeId;
from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import AnalysisError, DiagnosticCode;
from std.core.iter import Iterator, IntoIterator;

fn failure(message: str) -> AnalysisError {
    AnalysisError.user(DiagnosticCode.Internal, Option<SourceSpan>.None, message)
}

fn main_in(ctx: ResolutionContext&, unit: UnitId) -> Option<Declaration&> {
    let index = 0u64;
    while index < ctx.len() {
        let declaration = ctx.declaration(index);
        if declaration.unit == unit {
            match &declaration.item.data {
                FuncDef(_, name, _, _, _, _) => {
                    if name.data.name.as_str() == "main" { return Option<Declaration&>.Some(declaration); }
                },
                _ => {},
            }
        }
        index += 1;
    }
    Option<Declaration&>.None
}

fn register(ctx: ResolutionContext&, declaration: Declaration&) -> Result<Option<TypeId>, AnalysisError> {
    match &declaration.item.data {
        FuncDef(_, _, generics, _, _, _) => {
            if generics.len() != 0 {
                return Result<Option<TypeId>, AnalysisError>.Err(ctx.error(declaration.unit, declaration.item.span, DiagnosticCode.Type, "The 'main' function cannot have generics"));
            }
        },
        _ => return Result<Option<TypeId>, AnalysisError>.Err(AnalysisError.internal("entry is not a function")),
    }
    let type_id = ctx.session.symbols.get(declaration.symbol).unwrap().type_id;
    match ctx.session.types.complete_definition(*declaration.definition.unwrap())? {
        Function(signature) => {
            if signature.result != ctx.primitives.void {
                let name = type_text(ctx, signature.result);
                defer name.drop();
                let message = String.from(&"main must return void, not ");
                defer message.drop();
                message.push_str(name.as_str());
                message.push_str("; use std.core.env.exit(code) for non-zero exit");
                return Result<Option<TypeId>, AnalysisError>.Err(ctx.error(declaration.unit, declaration.item.span, DiagnosticCode.Type, message.as_str()));
            }
        },
        _ => return Result<Option<TypeId>, AnalysisError>.Err(AnalysisError.internal("entry signature is not a function")),
    }
    Result<Option<TypeId>, AnalysisError>.Ok(Option<TypeId>.Some(type_id))
}

pub fn select_entry(ctx: ResolutionContext&, options: AnalysisOptions&) -> Result<Option<TypeId>, AnalysisError> {
    match ctx.session.package_map() {
        Some(map) => match map.root_name() {
            Some(root) => {
                let spec = map.find(root).unwrap();
                let entry = match &spec.entry {
                    Some(path) => path.as_str(),
                    None => {
                        if !options.require_entry { return Result<Option<TypeId>, AnalysisError>.Ok(Option<TypeId>.None); }
                        let message = String.from(&"Package '");
                        defer message.drop();
                        message.push_str(root);
                        message.push_str("' has no program entry (kind '");
                        message.push_str(spec.kind.as_str());
                        message.push_str("')");
                        return Result<Option<TypeId>, AnalysisError>.Err(failure(message.as_str()));
                    },
                };
                let index = 0u64;
                while index < ctx.session.len() {
                    let unit = *ctx.session.unit(UnitId(index)).unwrap();
                    if ctx.session.source(unit.source).unwrap().canonical_path() == entry {
                        return match main_in(ctx, unit.id) {
                            Some(declaration) => register(ctx, declaration),
                            None => {
                                if options.entry_optional { Result<Option<TypeId>, AnalysisError>.Ok(Option<TypeId>.None) } else {
                                    let message = String.from(&"No 'main' function found in the program entry ");
                                    defer message.drop();
                                    message.push_str(entry);
                                    Result<Option<TypeId>, AnalysisError>.Err(failure(message.as_str()))
                                }
                            },
                        };
                    }
                    index += 1;
                }
                let message = String.from(&"Program entry ");
                defer message.drop();
                message.push_str(entry);
                message.push_str(" was not passed to the compiler");
                return Result<Option<TypeId>, AnalysisError>.Err(failure(message.as_str()));
            },
            None => {},
        },
        None => {},
    }

    let candidates = Vec<Declaration&>.new();
    defer candidates.drop();
    let index = 0u64;
    while index < ctx.session.len() {
        let unit = *ctx.session.unit(UnitId(index)).unwrap();
        if !unit.is_stdlib {
            match main_in(ctx, unit.id) {
                Some(declaration) => candidates.push(declaration), None => {},
            }
        }
        index += 1;
    }
    for candidate in candidates {
        match &candidate.item.data {
            FuncDef(_, _, generics, _, _, _) => {
                if generics.len() != 0 {
                    return Result<Option<TypeId>, AnalysisError>.Err(ctx.error(candidate.unit, candidate.item.span, DiagnosticCode.Type, "The 'main' function cannot have generics"));
                }
            },
            _ => {},
        }
    }
    if candidates.len() == 0 {
        if options.entry_optional { return Result<Option<TypeId>, AnalysisError>.Ok(Option<TypeId>.None); }
        return Result<Option<TypeId>, AnalysisError>.Err(failure("No 'main' function found"));
    }
    if candidates.len() > 1 {
        if options.entry_optional { return Result<Option<TypeId>, AnalysisError>.Ok(Option<TypeId>.None); }
        let declaration = candidates[1];
        return Result<Option<TypeId>, AnalysisError>.Err(ctx.error(declaration.unit, declaration.item.span, DiagnosticCode.Type, "Multiple 'main' functions found"));
    }
    register(ctx, candidates[0])
}
