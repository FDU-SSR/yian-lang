from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.session.output import AnalysisOutput;
from yianc.analysis.ty.callable import signature, instance_substitutions;
from yianc.analysis.ty.substitution import substitute;
from yianc.analysis.ty.aggregate import payload_fields;
from yianc.analysis.ty.model import StructField;
from yianc.analysis.constant.floating import round_float;
from yianc.analysis.ty.validation import validate_concrete_value;
from yianc.analysis.ty.substitution import has_generic;
from yianc.analysis.ty.trait_object import object_methods;
from yianc.analysis.hir.node import HirNode;
from yianc.analysis.hir.pattern import PatternNode;
from yianc.analysis.hir.traversal import HirVisitor, walk_expr;
from yianc.analysis.definition.worklist import WorkState;
from yianc.common.ids import HirId, PatternId, TypeId, SymbolId, NameId, DefId;
from yianc.common.location import SourceSpan;
from yianc.common.traversal import WalkControl;
from yianc.frontend.ast.operator import BinaryOperator, UnaryOperator;
from yianc.diagnostics.model import AnalysisError;
from std.collections.hash_set import HashSet;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;
from std.num.f64 import to_bits;

fn invalid(span: SourceSpan, message: str) -> AnalysisError {
    AnalysisError.internal(message).with_location(span)
}

fn addressable_path(ctx: ResolutionContext&, id: HirId, active: HashSet<HirId>&) -> Result<bool, AnalysisError> {
    if !active.insert(id) { return Result<bool, AnalysisError>.Ok(false); }
    let node = ctx.session.hir.require(id)?;
    let addressable = match &node.kind {
        Var(_) => node.is_place,
        Unary(value) => node.is_place && value.op == UnaryOperator.Deref,
        FieldAccess(value) => node.is_place && addressable_path(ctx, value.receiver, active)?,
        TupleAccess(value) => node.is_place && addressable_path(ctx, value.receiver, active)?,
        ArrayAccess(value) => node.is_place && addressable_path(ctx, value.array, active)?,
        SliceAccess(_) => true,
        Block(value) => {
            if !node.is_place || value.stmts.len() == 0 {
                false
            } else {
                addressable_path(ctx, value.stmts[value.stmts.len() - 1u64], active)?
            }
        },
        _ => false,
    };
    active.remove(&id);
    Result<bool, AnalysisError>.Ok(addressable)
}

// IDs and stores remain borrowed. Traversal only reads edges and validates exported bodies.
struct HirVerifier {
    ctx: ResolutionContext&,
    result: TypeId,
    exported: HashSet<TypeId>&,
    active: HashSet<HirId>,
    active_patterns: HashSet<PatternId>,
    loops: Vec<TypeId>,
}

impl Drop for HirVerifier {
    pub fn drop() {
        self.active.drop();
        self.active_patterns.drop();
        self.loops.drop();
    }
}

impl HirVerifier {
    fn fields(type_id: TypeId, expected: Vec<StructField>&, values: Vec<(NameId, HirId)>&, span: SourceSpan) -> Result<(), AnalysisError> {
        if expected.len() != values.len() {
            return Result<(), AnalysisError>.Err(invalid(span, "exported aggregate field count is inconsistent"));
        }
        let substitutions = instance_substitutions(self.ctx, type_id)?;
        defer substitutions.drop();
        let names = HashSet<NameId>.new();
        defer names.drop();

        for entry in *values {
            if !names.insert(entry[0]) {
                return Result<(), AnalysisError>.Err(invalid(span, "exported aggregate has a duplicate field"));
            }
            let found = false;
            for field in *expected {
                if field.name == entry[0] {
                    self.value(entry[1], substitute(&self.ctx.session.types, field.type_id, &substitutions)?, span)?;
                    found = true;
                    break;
                }
            }
            if !found {
                return Result<(), AnalysisError>.Err(invalid(span, "exported aggregate has an unknown field"));
            }
        }
        Result<(), AnalysisError>.Ok(())
    }

    fn node(id: HirId, span: SourceSpan) -> Result<HirNode&, AnalysisError> {
        match self.ctx.session.hir.get(id) {
            Some(value) => Result<HirNode&, AnalysisError>.Ok(value),
            None => Result<HirNode&, AnalysisError>.Err(invalid(span, "exported HIR contains an invalid expression ID")),
        }
    }

    fn value(id: HirId, expected: TypeId, span: SourceSpan) -> Result<(), AnalysisError> {
        let actual = self.node(id, span)?.type_id;
        if actual != expected && actual != self.ctx.primitives.never {
            return Result<(), AnalysisError>.Err(invalid(span, "exported HIR value has an inconsistent type"));
        }
        Result<(), AnalysisError>.Ok(())
    }

    fn symbol(id: SymbolId, expected: TypeId, span: SourceSpan) -> Result<(), AnalysisError> {
        let symbol = match self.ctx.session.symbols.get(id) {
            Some(value) => value,
            None => return Result<(), AnalysisError>.Err(invalid(span, "exported HIR contains an invalid symbol ID")),
        };
        if symbol.type_id != expected {
            return Result<(), AnalysisError>.Err(invalid(span, "exported HIR symbol has an inconsistent type"));
        }
        Result<(), AnalysisError>.Ok(())
    }

    fn require_addressable(id: HirId, span: SourceSpan) -> Result<(), AnalysisError> {
        let active = HashSet<HirId>.new();
        defer active.drop();
        if !addressable_path(self.ctx, id, &active)? {
            return Result<(), AnalysisError>.Err(invalid(span, "exported address consumer is not backed by a place"));
        }
        Result<(), AnalysisError>.Ok(())
    }

    fn call(type_id: TypeId, arguments: Vec<HirId>&, result: TypeId, receiver: Option<HirId>, require_body: bool, span: SourceSpan) -> Result<(), AnalysisError> {
        if has_generic(&self.ctx.session.types, type_id) {
            return Result<(), AnalysisError>.Err(invalid(span, "exported call contains unresolved generic arguments"));
        }
        let callable = signature(self.ctx, type_id)?;
        defer callable.drop();

        if require_body && !callable.is_header && !self.exported.contains(&type_id) {
            return Result<(), AnalysisError>.Err(invalid(span, "exported call has no checked function body"));
        }

        if arguments.len() != callable.parameters.len() || result != callable.result {
            return Result<(), AnalysisError>.Err(invalid(span, "exported call does not match its signature"));
        }
        let index = 0u64;
        for parameter in callable.parameters {
            self.value(arguments[index], parameter.type_id, span)?;
            index += 1;
        }

        match receiver {
            Some(value) => {
                if callable.is_static || callable.receiver.is_none() {
                    return Result<(), AnalysisError>.Err(invalid(span, "exported instance call has no receiver signature"));
                }
                let self_type = *callable.receiver.unwrap();
                let expected = match self.ctx.session.types.require(self_type)? {
                    TraitObject(_) => self_type,
                    _ => self.ctx.session.types.reference(self_type),
                };
                self.value(value, expected, span)?;
            },
            None => {
                if callable.receiver.is_some() && !callable.is_static {
                    return Result<(), AnalysisError>.Err(invalid(span, "exported instance call is missing its receiver"));
                }
            },
        }
        Result<(), AnalysisError>.Ok(())
    }

    fn check_literals(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            BoolLiteral(_) => {
                if node.type_id != self.ctx.primitives.boolean || node.is_place {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported boolean literal has an inconsistent type or place flag"));
                }
            },
            CharLiteral(value) => {
                if node.type_id != self.ctx.primitives.character || node.is_place || *value > 0x10FFFF || (*value >= 0xD800 && *value <= 0xDFFF) {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported character literal is invalid"));
                }
            },
            StrLiteral(name) => {
                if node.type_id != self.ctx.primitives.string || node.is_place || self.ctx.session.names.get(*name).is_none() {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported string literal is invalid"));
                }
            },
            IntLiteral(value) => {
                let valid = match self.ctx.session.types.require(node.type_id)? {
                    IntLiteral => value.is_untyped(),
                    Integer(bits, signed) | CScalar(bits, signed, _) => !value.is_untyped() && value.storage_width().bits() == *bits && value.is_signed() == *signed,
                    _ => false,
                };
                if !valid || node.is_place {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported integer literal has an inconsistent representation"));
                }
            },
            FloatLiteral(value) => {
                let valid = match self.ctx.session.types.require(node.type_id)? {
                    FloatLiteral => true,
                    Float(width) => to_bits(*value) == to_bits(round_float(*value, *width)),
                    _ => false,
                };
                if !valid || node.is_place {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported floating literal has an inconsistent representation"));
                }
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }

    fn check_aggregates(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            StructConstruct(value) => {
                if value.struct_id != node.type_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported constructor type is inconsistent"));
                }
                let definition = match self.ctx.session.types.require(node.type_id)? {
                    Nominal(id, _) => *id,
                    _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported struct has no nominal identity")),
                };
                let fields = match self.ctx.session.types.complete_definition(definition)? {
                    Struct(body) => &body.fields,
                    _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported struct constructor does not refer to a struct")),
                };
                self.fields(node.type_id, fields, &value.field_values, node.span)?;
            },
            VariantConstruct(value) => {
                if value.enum_id != node.type_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported variant type is inconsistent"));
                }
                let fields = payload_fields(self.ctx, value.variant.payload)?;
                defer fields.drop();
                match &value.args {
                    Some(arguments) => {
                        self.fields(node.type_id, &fields, arguments, node.span)?;
                    },
                    None => {
                        if fields.len() != 0 {
                            return Result<(), AnalysisError>.Err(invalid(node.span, "exported variant is missing its payload"));
                        }
                    },
                }
            },
            Tuple(value) => match self.ctx.session.types.require(node.type_id)? {
                Tuple(types) => {
                    if types.len() != value.field_values.len() {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported tuple arity is inconsistent"));
                    }
                    let index = 0u64;
                    for type_id in *types {
                        self.value(value.field_values[index], *type_id, node.span)?;
                        index += 1;
                    }
                },
                _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported tuple has a non-tuple type")),
            },
            Array(value) => match self.ctx.session.types.require(node.type_id)? {
                Array(element, count) => {
                    if *element != value.element_type {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported array element type is inconsistent"));
                    }
                    match self.ctx.session.types.require(*count)? {
                        LiteralValue(length, negative, _) => {
                            if *negative || *length != value.elements.len() {
                                return Result<(), AnalysisError>.Err(invalid(node.span, "exported array length is inconsistent"));
                            }
                        },
                        _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported array length is not concrete")),
                    }
                    for item in value.elements {
                        self.value(*item, *element, node.span)?;
                    }
                },
                _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported array has a non-array type")),
            },
            ArrayRepeat(value) => match self.ctx.session.types.require(node.type_id)? {
                Array(element, _) => {
                    if *element != value.element_type {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported repeated array element type is inconsistent"));
                    }
                    self.value(value.element, *element, node.span)?;
                },
                _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported repeated array has a non-array type")),
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }

    fn check_bindings(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            Var(symbol) => {
                self.symbol(*symbol, node.type_id, node.span)?;
            },
            Let(value) => match &value.symbol_id {
                Some(symbol) => {
                    let record = match self.ctx.session.symbols.get(*symbol) {
                        Some(value) => value,
                        None => return Result<(), AnalysisError>.Err(invalid(node.span, "exported binding contains an invalid symbol ID")),
                    };
                    validate_concrete_value(self.ctx, record.type_id, node.span)?;
                    match &value.init {
                        Some(init) => {
                            self.value(*init, record.type_id, node.span)?;
                        },
                        None => {},
                    }
                },
                None => {},
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }

    fn check_calls(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            Call(value) => {
                self.call(value.func, &value.args, node.type_id, Option<HirId>.None, true, node.span)?;
            },
            MethodCall(value) => {
                self.call(value.method_id, &value.args, node.type_id, Option<HirId>.Some(value.receiver), true, node.span)?;
            },
            TraitObjectMethodCall(value) => {
                // A dynamic slot describes an interface signature, including default methods.
                // Concrete vtable entries own the executable body references.
                self.call(value.method_id, &value.args, node.type_id, Option<HirId>.Some(value.receiver), false, node.span)?;
                let expected = self.ctx.session.types.trait_object(value.trait_type_id);
                self.value(value.receiver, expected, node.span)?;
                let slots = object_methods(self.ctx, value.trait_type_id)?;
                defer slots.drop();
                if value.slot_index >= slots.len() || slots[value.slot_index] != value.method_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported dynamic call has an inconsistent slot"));
                }
            },
            TraitObjectCoerce(value) => {
                if node.type_id != self.ctx.session.types.trait_object(value.trait_type_id) {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported trait object has an inconsistent type"));
                }

                let source = self.node(value.value, node.span)?.type_id;
                let valid_source = match self.ctx.session.types.require(source)? {
                    Pointer(inner) | Reference(inner) => *inner == value.concrete_type_id,
                    _ => false,
                };

                if !valid_source {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported trait object has an inconsistent concrete receiver"));
                }

                let slots = object_methods(self.ctx, value.trait_type_id)?;
                defer slots.drop();

                if slots.len() != value.method_ids.len() {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported trait object has an inconsistent vtable length"));
                }

                let index = 0u64;

                for method in value.method_ids {
                    let actual = signature(self.ctx, *method)?;
                    defer actual.drop();
                    let expected = signature(self.ctx, slots[index])?;
                    defer expected.drop();

                    if has_generic(&self.ctx.session.types, *method) || (!actual.is_header && !self.exported.contains(method)) {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported vtable entry has no concrete checked body"));
                    }

                    let valid_receiver = match &actual.receiver {
                        Some(type_id) => *type_id == value.concrete_type_id,
                        None => false,
                    };

                    if actual.is_static || !valid_receiver || actual.result != expected.result || actual.parameters.len() != expected.parameters.len() {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported vtable entry has an inconsistent signature"));
                    }

                    let parameter_index = 0u64;

                    for parameter in actual.parameters {
                        if parameter.type_id != expected.parameters[parameter_index].type_id {
                            return Result<(), AnalysisError>.Err(invalid(node.span, "exported vtable parameter type is inconsistent"));
                        }

                        parameter_index += 1;
                    }

                    index += 1;
                }
            },
            Invoke(value) => {
                let target = self.node(value.callable, node.span)?.type_id;
                let parameters = Vec<TypeId>.new();
                defer parameters.drop();
                let result = match self.ctx.session.types.require(target)? {
                    FunctionPointer(types, result) => {
                        for type_id in *types {
                            parameters.push(*type_id);
                        };
                        *result
                    },
                    Closure(_, types, result, _, _, _) => {
                        for parameter in *types {
                            parameters.push(parameter.type_id);
                        };
                        *result
                    },
                    _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported invoke target is not callable")),
                };
                if result != node.type_id || parameters.len() != value.args.len() {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported invoke does not match its signature"));
                }
                let index = 0u64;
                for type_id in parameters {
                    self.value(value.args[index], *type_id, node.span)?;
                    index += 1;
                }
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }

    fn check_control(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            Return(value) => match value {
                Some(id) => {
                    self.value(*id, self.result, node.span)?;
                },
                None => {
                    if self.result != self.ctx.primitives.void {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported return is missing a value"));
                    }
                },
            },
            Loop(_) => {
                self.loops.push(node.type_id);
            },
            Break(value) => {
                if self.loops.len() == 0 {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported break has no enclosing loop"));
                }
                let expected = self.loops[self.loops.len() - 1];
                match value {
                    Some(id) => {
                        self.value(*id, expected, node.span)?;
                    },
                    None => {
                        if expected != self.ctx.primitives.void {
                            return Result<(), AnalysisError>.Err(invalid(node.span, "exported break is missing its loop value"));
                        }
                    },
                }
            },
            Continue => {
                if self.loops.len() == 0 {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported continue has no enclosing loop"));
                }
            },
            If(value) => {
                self.value(value.cond, self.ctx.primitives.boolean, node.span)?;
                match &value.else_branch {
                    Some(branch) => {
                        self.value(value.then_branch, node.type_id, node.span)?;
                        self.value(*branch, node.type_id, node.span)?;
                    },
                    None => {},
                }
            },
            Match(value) => {
                for arm in value.arms {
                    self.value(arm.body, node.type_id, arm.span)?;
                    match &arm.guard {
                        Some(guard) => {
                            self.value(*guard, self.ctx.primitives.boolean, arm.span)?;
                        },
                        None => {},
                    }
                }
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }

    fn check_operations(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            Cast(value) => {
                if value.target_type != node.type_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported cast target differs from its result"));
                }
            },
            BitCast(value) => {
                if value.target_type != node.type_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported bit cast target differs from its result"));
                }
            },
            Binary(value) => {
                if value.op == BinaryOperator.Assign {
                    self.require_addressable(value.left, node.span)?;
                }
            },
            Unary(value) => {
                if value.op == UnaryOperator.Deref && !node.is_place {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported dereference is not a place"));
                }
                if value.op == UnaryOperator.AddrOf {
                    let function_address = match self.ctx.session.types.require(node.type_id)? { FunctionPointer(_, _) => true, _ => false, };
                    if function_address {
                        let is_function = match &self.node(value.operand, node.span)?.kind { Ty => true, _ => false, };
                        if !is_function {
                            return Result<(), AnalysisError>.Err(invalid(node.span, "exported function address has a non-function operand"));
                        }
                    } else {
                        self.require_addressable(value.operand, node.span)?;
                    }
                }
            },
            FieldAccess(value) => {
                if value.field.type_id != node.type_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported field type differs from its result"));
                }
                if node.is_place { self.require_addressable(value.receiver, node.span)?; }
            },
            TupleAccess(value) => {
                if node.is_place { self.require_addressable(value.receiver, node.span)?; }
            },
            ArrayAccess(value) => {
                self.require_addressable(value.array, node.span)?;
            },
            Invoke(value) => {
                let callable_type = self.node(value.callable, node.span)?.type_id;
                let is_closure = match self.ctx.session.types.require(callable_type)? { Closure(_, _, _, _, _, _) => true, _ => false, };
                if is_closure { self.require_addressable(value.callable, node.span)?; }
            },
            Block(value) if node.is_place => {
                if value.stmts.len() == 0 {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported place block has no final value"));
                }
                let last_id = value.stmts[value.stmts.len() - 1u64];
                let last = self.node(last_id, node.span)?;
                if last.type_id != node.type_id {
                    return Result<(), AnalysisError>.Err(invalid(node.span, "exported place block type differs from its final value"));
                }
                self.require_addressable(last_id, node.span)?;
                if value.stmts.len() == 2 {
                    let binding = self.node(value.stmts[0], node.span)?;
                    match &binding.kind {
                        Let(value) => {
                            let initializer = match &value.init {
                                Some(value) => Option<HirId>.Some(*value),
                                None => Option<HirId>.None,
                            };
                            let symbol_id = match &value.symbol_id {
                                Some(value) => Option<SymbolId>.Some(*value),
                                None => Option<SymbolId>.None,
                            };
                            match initializer {
                                Some(initializer) => match symbol_id {
                                    Some(symbol_id) => {
                                        let same_variable = match &last.kind { Var(variable) => *variable == symbol_id, _ => false, };
                                        if same_variable {
                                            let symbol = match self.ctx.session.symbols.get(symbol_id) {
                                                Some(value) => value,
                                                None => return Result<(), AnalysisError>.Err(invalid(node.span, "exported address temporary has an invalid symbol")),
                                            };
                                            if symbol.type_id != node.type_id || self.node(initializer, node.span)?.type_id != node.type_id {
                                                return Result<(), AnalysisError>.Err(invalid(node.span, "exported address temporary has an inconsistent type"));
                                            }
                                        }
                                    },
                                    None => {},
                                },
                                None => {},
                            }
                        },
                        _ => {},
                    }
                }
            },
            Builtin(value) => {
                for type_id in value.type_args {
                    self.ctx.session.types.require(*type_id)?;
                }
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }

    fn check_closure(node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            Closure(value) => match self.ctx.session.types.require(node.type_id)? {
                Closure(captures, _, _, _, environment, call_method) => {
                    if captures.len() != value.captures.len() || environment.is_none() || call_method.is_none() {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported closure metadata is incomplete"));
                    }

                    if !self.exported.contains(call_method.unwrap()) {
                        return Result<(), AnalysisError>.Err(invalid(node.span, "exported closure has no checked call body"));
                    }
                    let index = 0u64;
                    for capture in *captures {
                        if capture.name != value.captures[index][0] {
                            return Result<(), AnalysisError>.Err(invalid(node.span, "exported closure capture order is inconsistent"));
                        }
                        self.value(value.captures[index][1], capture.type_id, node.span)?;
                        index += 1;
                    }
                },
                _ => return Result<(), AnalysisError>.Err(invalid(node.span, "exported closure has no closure type")),
            },
            _ => {},
        }

        Result<(), AnalysisError>.Ok(())
    }
}

impl HirVisitor for HirVerifier {
    pub fn enter_expr(id: HirId, node: HirNode&) -> Result<WalkControl, AnalysisError> {
        if self.active.contains(&id) {
            return Result<WalkControl, AnalysisError>.Err(invalid(node.span, "exported HIR contains an expression cycle"));
        }
        self.active.insert(id);

        if self.ctx.session.source(node.span.source).is_none() {
            return Result<WalkControl, AnalysisError>.Err(invalid(node.span, "exported HIR contains an invalid source ID"));
        }
        self.ctx.session.types.require(node.type_id)?;
        match &node.kind {
            Ty => {},
            _ => {
                validate_concrete_value(self.ctx, node.type_id, node.span)?;
            },
        }

        self.check_literals(node)?;
        self.check_aggregates(node)?;
        self.check_bindings(node)?;
        self.check_calls(node)?;
        self.check_control(node)?;
        self.check_operations(node)?;
        self.check_closure(node)?;

        Result<WalkControl, AnalysisError>.Ok(WalkControl.Continue)
    }

    pub fn leave_expr(id: HirId, node: HirNode&) -> Result<(), AnalysisError> {
        match &node.kind {
            Loop(_) => {
                self.loops.pop();
            }, _ => {}
        }
        self.active.remove(&id);
        Result<(), AnalysisError>.Ok(())
    }

    pub fn enter_pattern(id: PatternId, node: PatternNode&) -> Result<WalkControl, AnalysisError> {
        if self.active_patterns.contains(&id) {
            return Result<WalkControl, AnalysisError>.Err(invalid(node.span, "exported HIR contains a pattern cycle"));
        }
        self.active_patterns.insert(id);

        if self.ctx.session.source(node.span.source).is_none() {
            return Result<WalkControl, AnalysisError>.Err(invalid(node.span, "exported pattern contains an invalid source ID"));
        }

        validate_concrete_value(self.ctx, node.type_id, node.span)?;
        match &node.kind {
            BindPattern(value) => {
                let symbol = match self.ctx.session.symbols.get(value.symbol_id) {
                    Some(record) => record,
                    None => return Result<WalkControl, AnalysisError>.Err(invalid(node.span, "exported pattern contains an invalid symbol ID")),
                };

                // Borrowed matching binds references while pattern nodes describe the tested value.
                if symbol.type_id != node.type_id && symbol.type_id != self.ctx.session.types.reference(node.type_id) {
                    return Result<WalkControl, AnalysisError>.Err(invalid(node.span, "exported pattern binding type is inconsistent"));
                }
            },
            LiteralPattern(value) => match &value.condition {
                Some(condition) => {
                    self.value(*condition, self.ctx.primitives.boolean, node.span)?;
                },
                None => {},
            },
            _ => {},
        }
        Result<WalkControl, AnalysisError>.Ok(WalkControl.Continue)
    }

    pub fn leave_pattern(id: PatternId, node: PatternNode&) -> Result<(), AnalysisError> {
        self.active_patterns.remove(&id);
        Result<(), AnalysisError>.Ok(())
    }
}

pub fn verify_hir(ctx: ResolutionContext&, output: AnalysisOutput&) -> Result<(), AnalysisError> {
    let exported = HashSet<TypeId>.new();
    defer exported.drop();
    let checked = HashSet<DefId>.new();
    defer checked.drop();

    for definition in output.checked {
        let record = match ctx.session.types.definition(*definition) {
            Some(value) => value,
            None => return Result<(), AnalysisError>.Err(AnalysisError.internal("analysis output contains an invalid definition ID")),
        };

        if !record.is_complete() || !checked.insert(*definition) {
            return Result<(), AnalysisError>.Err(invalid(record.header().span, "analysis output has an incomplete or duplicate definition"));
        }
    }

    for procedure in output.procedures {
        let root = ctx.session.hir.require(procedure.root)?;
        if !exported.insert(procedure.type_id) {
            return Result<(), AnalysisError>.Err(invalid(root.span, "function instance is exported twice"));
        }

        if !checked.contains(&procedure.definition) {
            return Result<(), AnalysisError>.Err(invalid(root.span, "exported function is absent from the checked definition list"));
        }
    }

    match &output.entry {
        Some(type_id) => {
            if !exported.contains(type_id) {
                return Result<(), AnalysisError>.Err(AnalysisError.internal("analysis entry has no exported body"));
            }
        },
        None => {},
    }

    // Visit shared nodes by each incoming edge; break and return validity depend on context.
    for procedure in output.procedures {
        let root = ctx.session.hir.require(procedure.root)?;
        let record = match ctx.session.definitions.get(procedure.type_id) {
            Some(value) => value,
            None => return Result<(), AnalysisError>.Err(invalid(root.span, "exported function has no procedure record")),
        };
        if record.definition != procedure.definition || record.unit != procedure.unit {
            return Result<(), AnalysisError>.Err(invalid(root.span, "exported procedure identity is inconsistent"));
        }
        match ctx.session.worklist.state(procedure.type_id) {
            Some(Complete) => {},
            _ => return Result<(), AnalysisError>.Err(invalid(root.span, "exported procedure has not completed analysis")),
        }
        let callable = signature(ctx, procedure.type_id)?;
        defer callable.drop();
        let checker = HirVerifier(ctx, callable.result, &exported, HashSet<HirId>.new(), HashSet<PatternId>.new(), Vec<TypeId>.new());
        defer checker.drop();
        let captures = procedure.captures.len();
        let receiver_count = if callable.receiver.is_some() && !callable.is_static {
            1u64
        } else {
            0u64
        };
        if procedure.parameters.len() != captures + receiver_count + callable.parameters.len() {
            return Result<(), AnalysisError>.Err(invalid(root.span, "exported parameter list does not match its signature"));
        }

        let position = 0u64;
        for capture in procedure.captures {
            let symbol = match ctx.session.symbols.get(capture[1]) {
                Some(value) => value,
                None => return Result<(), AnalysisError>.Err(invalid(root.span, "exported capture contains an invalid symbol ID")),
            };
            if capture[0] != symbol.name || capture[1] != procedure.parameters[position] {
                return Result<(), AnalysisError>.Err(invalid(root.span, "exported capture symbols are inconsistent"));
            }
            validate_concrete_value(ctx, symbol.type_id, root.span)?;
            position += 1;
        }

        if receiver_count != 0 {
            checker.symbol(procedure.parameters[position], ctx.session.types.reference(*callable.receiver.unwrap()), root.span)?;
            position += 1;
        }
        for parameter in callable.parameters {
            checker.symbol(procedure.parameters[position], parameter.type_id, root.span)?;
            position += 1;
        }
        checker.value(procedure.root, callable.result, root.span)?;
        walk_expr(&ctx.session.hir, procedure.root, &checker)?;
    }
    Result<(), AnalysisError>.Ok(())
}
