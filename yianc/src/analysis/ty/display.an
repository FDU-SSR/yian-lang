from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.names import NameInterner;
from yianc.analysis.ty.store import TypeStore;
from yianc.common.ids import TypeId;
from std.core.iter import Iterator, IntoIterator;

fn append(types: TypeStore&, names: NameInterner&, id: TypeId, text: String&, depth: u64) {
    if depth > 64 {
        text.push_str("...");
        return;
    }

    match *types.get(id).unwrap() {
        Reference(inner) => {
            append(types, names, *inner, text, depth + 1);
            text.push_str("&");
        },
        Pointer(inner) => {
            append(types, names, *inner, text, depth + 1);
            text.push_str("*");
        },
        CPointer(inner) => {
            text.push_str("cptr<");
            append(types, names, *inner, text, depth + 1);
            text.push_str(">");
        },
        Slice(inner) => {
            append(types, names, *inner, text, depth + 1);
            text.push_str("[]");
        },
        Array(inner, length) => {
            append(types, names, *inner, text, depth + 1);
            text.push_str("[");
            append(types, names, *length, text, depth + 1);
            text.push_str("]");
        },
        Tuple(elements) => {
            text.push_str("(");
            let index = 0u64;
            for element in *elements {
                if index != 0 { text.push_str(", "); }
                append(types, names, *element, text, depth + 1);
                index += 1;
            }
            text.push_str(")");
        },
        FunctionPointer(parameters, result) => {
            text.push_str("fn(");
            let index = 0u64;
            for parameter in *parameters {
                if index != 0 { text.push_str(", "); }
                append(types, names, *parameter, text, depth + 1);
                index += 1;
            }
            text.push_str(") -> ");
            append(types, names, *result, text, depth + 1);
        },
        CScalar(_, _, name) | Opaque(name, _) => text.push_str(names.text(*name)),
        Nominal(definition, arguments) => {
            text.push_str(names.text(types.definition(*definition).unwrap().header().name));

            if arguments.len() != 0 {
                text.push_str("<");
                let index = 0u64;

                for argument in *arguments {
                    if index != 0 {
                        text.push_str(", ");
                    }

                    append(types, names, *argument, text, depth + 1);
                    index += 1;
                }

                text.push_str(">");
            }
        },
        Generic(name) => text.push_str(names.text(*name)),
        ConstGeneric(name, _) => text.push_str(names.text(*name)),
        LiteralValue(bits, negative, _) => {
            if *negative {
                text.push_str("-");
            }

            let number = bits.to_string_radix(10);
            defer number.drop();
            text.push_str(number.as_str());
        },
        Integer(bits, signed) => {
            text.push_str(if *signed {
                    "i"
                } else {
                    "u"
                });
            let number = u64(*bits).to_string_radix(10);
            defer number.drop();
            text.push_str(number.as_str());
        },
        Float(bits) => {
            text.push_str("f");
            let number = u64(*bits).to_string_radix(10);
            defer number.drop();
            text.push_str(number.as_str());
        },
        Bool => text.push_str("bool"), Char => text.push_str("char"), Str => text.push_str("str"), Void => text.push_str("void"), Never => text.push_str("!"), IntLiteral => text.push_str("IntLiteralType"), FloatLiteral => text.push_str("FloatLiteralType"),
        TraitObject(inner) => {
            append(types, names, *inner, text, depth + 1);
            text.push_str("&");
        },
        SelfType(_) => text.push_str("Self"),
        Closure(captures, parameters, result, _, _, _) => {
            text.push_str("|");
            let index = 0u64;
            for capture in *captures {
                if index != 0 { text.push_str(", "); }
                text.push_str(names.text(capture.name));
                text.push_str(": ");
                append(types, names, capture.type_id, text, depth + 1);
                index += 1;
            }
            text.push_str("| (");
            index = 0;
            for parameter in *parameters {
                if index != 0 { text.push_str(", "); }
                text.push_str(names.text(parameter.name));
                text.push_str(": ");
                append(types, names, parameter.type_id, text, depth + 1);
                index += 1;
            }
            text.push_str(") -> ");
            append(types, names, *result, text, depth + 1);
        },
        _ => text.push_str("composite type"),
    }
}

// The caller owns the resulting message buffer; it borrows no type-store text.
pub fn type_text(ctx: ResolutionContext&, id: TypeId) -> String {
    let text = String.new();
    append(&ctx.session.types, &ctx.session.names, id, &text, 0);
    text
}

// This overload renders a stored type without requiring a resolution context.
pub fn stored_type_text(types: TypeStore&, names: NameInterner&, id: TypeId) -> String {
    let text = String.new();
    append(types, names, id, &text, 0);
    text
}
