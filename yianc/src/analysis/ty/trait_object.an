from yianc.analysis.resolution.context import ResolutionContext;
from yianc.types.trait_object import store_object_methods;
from yianc.common.ids import TypeId;
from yianc.diagnostics.model import AnalysisError;

pub fn object_methods(ctx: ResolutionContext&, trait_id: TypeId) -> Result<Vec<TypeId>, AnalysisError> {
    store_object_methods(ctx.types, ctx.names, trait_id)
}
