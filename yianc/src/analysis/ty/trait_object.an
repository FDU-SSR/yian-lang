from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.ty.callable import store_substitutions, store_signature;
from yianc.analysis.ty.store import TypeStore;
from yianc.analysis.names import NameInterner;
from yianc.analysis.ty.substitution import substitute;
from yianc.common.ids import TypeId, NameId;
from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import AnalysisError, DiagnosticCode;
from std.collections.sort import sort_by;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;
from std.core.string import String;

fn before(left: TypeId&, right: TypeId&) -> bool {
    left.index < right.index
}

fn mentions(store: TypeStore&, type_id: TypeId, self_type: TypeId) -> Result<bool, AnalysisError> {
    if type_id == self_type {
        return Result<bool, AnalysisError>.Ok(true);
    }

    match store.require(type_id)? {
        Pointer(inner) => mentions(store, *inner, self_type),
        Reference(inner) => mentions(store, *inner, self_type),
        Slice(inner) => mentions(store, *inner, self_type),
        TraitObject(inner) => mentions(store, *inner, self_type),
        Array(inner, _) => mentions(store, *inner, self_type),
        Tuple(elements) => {
            for element in *elements {
                if mentions(store, *element, self_type)? {
                    return Result<bool, AnalysisError>.Ok(true);
                }
            }

            Result<bool, AnalysisError>.Ok(false)
        },
        Nominal(_, arguments) => {
            for argument in *arguments {
                if mentions(store, *argument, self_type)? {
                    return Result<bool, AnalysisError>.Ok(true);
                }
            }

            Result<bool, AnalysisError>.Ok(false)
        },
        FunctionPointer(parameters, result) => {
            for parameter in *parameters {
                if mentions(store, *parameter, self_type)? {
                    return Result<bool, AnalysisError>.Ok(true);
                }
            }

            mentions(store, *result, self_type)
        },
        _ => Result<bool, AnalysisError>.Ok(false),
    }
}

// Declaration IDs give dynamic slots a deterministic order independent of hash buckets.
// Static methods have no dynamic slot. Instance signatures cannot depend on concrete Self.
pub fn object_methods(ctx: ResolutionContext&, trait_id: TypeId) -> Result<Vec<TypeId>, AnalysisError> {
    store_object_methods(&ctx.session.types, &ctx.session.names, trait_id)
}

pub fn store_object_methods(store: TypeStore&, names: NameInterner&, trait_id: TypeId) -> Result<Vec<TypeId>, AnalysisError> {
    let definition = match store.require(trait_id)? {
        Nominal(id, _) => *id, _ => return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.internal("trait object has invalid trait identity"))
    };
    let methods = match store.complete_definition(definition)? {
        Trait(methods) => methods, _ => return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.internal("trait object target is not a trait"))
    };
    let result = Vec<TypeId>.new();
    let transferred = false;
    defer {
        if !transferred {
            result.drop();
        }
    };
    let substitutions = store_substitutions(store, trait_id)?;
    defer substitutions.drop();
    let trait_header = *store.definition(definition).unwrap();
    let templates = Vec<TypeId>.new();
    defer templates.drop();

    for method in methods.values() {
        templates.push(*method);
    }

    sort_by(templates.as_slice(), before);

    for method in templates {
        let id = match store.require(*method)? {
            Nominal(id, _) => *id, _ => return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.internal("trait member has invalid identity"))
        };
        let header = *store.definition(id).unwrap();
        let callable = store_signature(store, *method)?;
        defer callable.drop();

        if callable.is_static {
            continue;
        }

        if header.generic_count() != trait_header.generic_count() + 1 {
            return Result<Vec<TypeId>, AnalysisError>.Err(object_error(names, trait_header.header().name,
                header.header().name, "has generic parameters", header.header().span));
        }

        let self_type = *header.generic(trait_header.generic_count()).unwrap();

        for parameter in callable.parameters {
            if mentions(store, parameter.type_id, self_type)? {
                let span = match parameter.span { Some(value) => value, None => trait_header.header().span, };
                return Result<Vec<TypeId>, AnalysisError>.Err(object_error(names, trait_header.header().name,
                    header.header().name, "uses Self in a parameter", span));
            }
        }

        if mentions(store, callable.result, self_type)? {
            return Result<Vec<TypeId>, AnalysisError>.Err(object_error(names, trait_header.header().name,
                header.header().name, "returns Self", header.header().span));
        }

        substitutions.insert(self_type, store.trait_object(trait_id));
        result.push(substitute(store, *method, &substitutions)?);
    }

    transferred = true;
    Result<Vec<TypeId>, AnalysisError>.Ok(result)
}

fn object_error(names: NameInterner&, trait_name: NameId, method_name: NameId, detail: str, span: SourceSpan) -> AnalysisError {
    let message = String.from(&"trait '");
    defer message.drop();
    message.push_str(names.text(trait_name));
    message.push_str("' is not object-safe: instance method '");
    message.push_str(names.text(method_name));
    message.push_str("' ");
    message.push_str(detail);
    AnalysisError.user(DiagnosticCode.Type, Option<SourceSpan>.Some(span), message.as_str())
}
