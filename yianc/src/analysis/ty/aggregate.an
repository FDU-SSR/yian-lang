from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.ty.model import StructField;
from yianc.common.ids import TypeId;
from yianc.diagnostics.model import AnalysisError;

// The list is caller-owned; field records borrow only session identities and positions.
pub fn payload_fields(ctx: ResolutionContext&, payload: Option<TypeId>) -> Result<Vec<StructField>, AnalysisError> {
    match payload {
        None => Result<Vec<StructField>, AnalysisError>.Ok(Vec<StructField>.new()),
        Some(type_id) => match ctx.session.types.require(type_id)? {
            Nominal(id, _) => match ctx.session.types.complete_definition(*id)? {
                Struct(body) => Result<Vec<StructField>, AnalysisError>.Ok(body.fields.clone()),
                _ => Result<Vec<StructField>, AnalysisError>.Err(AnalysisError.internal("enum payload is not an aggregate")),
            },
            _ => Result<Vec<StructField>, AnalysisError>.Err(AnalysisError.internal("enum payload has invalid identity")),
        },
    }
}
