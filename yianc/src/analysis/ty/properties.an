from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.ty.callable import store_substitutions;
from yianc.analysis.ty.store import TypeStore;
from yianc.analysis.ty.substitution import substitute;
from yianc.common.ids import TypeId;
from yianc.diagnostics.model import AnalysisError;
from std.core.iter import Iterator, IntoIterator;
from std.collections.hash_set import HashSet;

// Finalization rejects storage cycles before these structural queries run.
pub fn is_zst(ctx: ResolutionContext&, type_id: TypeId) -> Result<bool, AnalysisError> {
    store_is_zst(&ctx.session.types, type_id)
}

pub fn store_is_zst(store: TypeStore&, type_id: TypeId) -> Result<bool, AnalysisError> {
    let visiting = HashSet<TypeId>.new();
    defer visiting.drop();
    zst_inner(store, type_id, &visiting)
}

fn zst_inner(store: TypeStore&, type_id: TypeId, visiting: HashSet<TypeId>&) -> Result<bool, AnalysisError> {
    // Reference cycles carry an address; they do not make an aggregate a ZST.

    if !visiting.insert(type_id) {
        return Result<bool, AnalysisError>.Ok(false);
    }

    defer visiting.remove(&type_id);

    match store.require(type_id)? {
        Void => Result<bool, AnalysisError>.Ok(true),
        Never => Result<bool, AnalysisError>.Ok(true),
        Pointer(inner) => zst_inner(store, *inner, visiting),
        Reference(inner) => zst_inner(store, *inner, visiting),
        Tuple(elements) => {
            for element in *elements {
                if !zst_inner(store, *element, visiting)? {
                    return Result<bool, AnalysisError>.Ok(false);
                }
            }

            Result<bool, AnalysisError>.Ok(true)
        },
        Array(element, length) => {
            let empty = match store.require(*length)? {
                LiteralValue(bits, _, _) => *bits == 0, _ => false
            };
            Result<bool, AnalysisError>.Ok(empty || zst_inner(store, *element, visiting)?)
        },
        Closure(_, _, _, _, environment, _) => match environment {
            Some(value) => zst_inner(store, *value, visiting),
            None => Result<bool, AnalysisError>.Err(AnalysisError.internal("closure has no completed environment")),
        },
        Nominal(id, _) => {
            let substitutions = store_substitutions(store, type_id)?;
            defer substitutions.drop();

            match store.complete_definition(*id)? {
                Struct(body) => {
                    for field in body.fields {
                        if !zst_inner(store, substitute(store, field.type_id, &substitutions)?, visiting)? {
                            return Result<bool, AnalysisError>.Ok(false);
                        }
                    }

                    Result<bool, AnalysisError>.Ok(true)
                },
                Enum(body) => {
                    if body.variants.len() == 0 {
                        return Result<bool, AnalysisError>.Ok(true);
                    }

                    if body.variants.len() != 1 {
                        return Result<bool, AnalysisError>.Ok(false);
                    }

                    match body.variants[0].payload {
                        Some(payload) => zst_inner(store, substitute(store, payload, &substitutions)?, visiting),
                        None => Result<bool, AnalysisError>.Ok(true),
                    }
                },
                Function(_) => Result<bool, AnalysisError>.Ok(true),
                Method(_) => Result<bool, AnalysisError>.Ok(true),
                _ => Result<bool, AnalysisError>.Ok(false),
            }
        },
        _ => Result<bool, AnalysisError>.Ok(false),
    }
}
