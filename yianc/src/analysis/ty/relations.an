from yianc.analysis.resolution.context import ResolutionContext;
from yianc.common.ids import TypeId;
from yianc.types.model import TypeData;
from yianc.analysis.ty.display import type_text;
from yianc.diagnostics.model import AnalysisError;
from std.core.iter import Iterator, IntoIterator;
from yianc.types.space import F64_TYPE_ID, FLOAT_LITERAL_TYPE_ID, I32_TYPE_ID, INT_LITERAL_TYPE_ID, NEVER_TYPE_ID, U64_TYPE_ID;

pub fn is_integer(ctx: ResolutionContext&, id: TypeId) -> bool {
    match *ctx.types.get(id).unwrap() {
        Integer(_, _) => true,
        CScalar(_) => true,
        IntLiteral => true,
        _ => false,
    }
}

pub fn is_numeric(ctx: ResolutionContext&, id: TypeId) -> bool {
    if is_integer(ctx, id) {
        return true;
    }

    match *ctx.types.get(id).unwrap() {
        Float(_) => true,
        FloatLiteral => true,
        _ => false,
    }
}

pub fn default_type(ctx: ResolutionContext&, id: TypeId) -> TypeId {
    if id == TypeId(INT_LITERAL_TYPE_ID) {
        return TypeId(I32_TYPE_ID);
    }

    if id == TypeId(FLOAT_LITERAL_TYPE_ID) {
        return TypeId(F64_TYPE_ID);
    }

    match *ctx.types.get(id).unwrap() {
        Pointer(inner) => ctx.types.pointer(default_type(ctx, *inner)),
        Reference(inner) => ctx.types.reference(default_type(ctx, *inner)),
        Tuple(elements) => {
            let concrete = Vec<TypeId>.new();
            defer concrete.drop();

            for element in *elements {
                concrete.push(default_type(ctx, *element));
            }

            ctx.types.tuple(&concrete)
        },
        Array(element, length) => ctx.types.array(default_type(ctx, *element), *length),
        _ => id,
    }
}

pub fn compatible(ctx: ResolutionContext&, actual: TypeId, expected: TypeId) -> bool {
    if actual == expected || actual == TypeId(NEVER_TYPE_ID) {
        return true;
    }

    if actual == TypeId(INT_LITERAL_TYPE_ID) {
        return match *ctx.types.get(expected).unwrap() {
            Integer(_, _) => true, CScalar(_) => true, Float(_) => true, IntLiteral => true, FloatLiteral => true, _ => false
        };
    }

    if actual == TypeId(FLOAT_LITERAL_TYPE_ID) {
        return match *ctx.types.get(expected).unwrap() {
            Float(_) => true,
            _ => false,
        };
    }

    match *ctx.types.get(actual).unwrap() {
        Pointer(inner) => match *ctx.types.get(expected).unwrap() {
            Reference(value) => *inner == *value,
            Slice(value) => !ctx.raw_pointers && *inner == *value,
            Pointer(value) => match *ctx.types.get(*inner).unwrap() {
                Array(element, _) => *element == *value, _ => false
            },
            TraitObject(_) => true,
            _ => false,
        },
        Reference(inner) => match *ctx.types.get(expected).unwrap() {
            TraitObject(_) => true, _ => false
        },
        Slice(element) => match *ctx.types.get(expected).unwrap() {
            Reference(value) => *element == *value, _ => false
        },
        Array(element, length) => match *ctx.types.get(expected).unwrap() {
            Pointer(value) => *element == *value,
            Array(value, count) => *length == *count && compatible(ctx, *element, *value),
            _ => false,
        },
        Tuple(elements) => match *ctx.types.get(expected).unwrap() {
            Tuple(values) => {
                if elements.len() != values.len() {
                    return false;
                }

                let index = 0u64;

                while index < elements.len() {
                    if !compatible(ctx, elements[index], values[index]) {
                        return false;
                    }

                    index += 1;
                }

                true
            },
            _ => false,
        },
        _ => false,
    }
}

pub fn has_literal(ctx: ResolutionContext&, type_id: TypeId) -> bool {
    match *ctx.types.get(type_id).unwrap() {
        IntLiteral => true,
        FloatLiteral => true,
        Pointer(inner) => has_literal(ctx, *inner),
        Reference(inner) => has_literal(ctx, *inner),
        Tuple(elements) => {
            for element in *elements {
                if has_literal(ctx, *element) {
                    return true;
                }
            }

            false
        },
        Array(element, _) => has_literal(ctx, *element),
        _ => false,
    }
}

// A slice range index is the standard Range<u64> nominal aggregate.
pub fn is_u64_range(ctx: ResolutionContext&, id: TypeId) -> bool {
    match *ctx.types.get(id).unwrap() {
        Nominal(_, arguments) => {
            if arguments.len() != 1u64 || arguments[0] != TypeId(U64_TYPE_ID) {
                return false;
            }
            let text = type_text(ctx, id);
            let matched = text.as_str() == "Range<u64>";
            text.drop();
            matched
        },
        _ => false,
    }
}
