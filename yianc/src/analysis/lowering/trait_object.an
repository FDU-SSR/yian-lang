from yianc.analysis.lowering.checker import ExprChecker;
from yianc.analysis.ty.trait_object import object_methods;
from yianc.analysis.ty.method_lookup import lookup_method, implements;
from yianc.analysis.ty.callable import signature, schedule;
from yianc.analysis.ty.display import type_text;
from yianc.analysis.hir.node import HirKind, TraitObjectCoerce, TraitObjectMethodCall;
from yianc.common.ids import TypeId, HirId, NameId;
from yianc.common.location import SourceSpan;
from yianc.frontend.source import Span;
from yianc.frontend.ast.operator import UnaryOperator;
from yianc.diagnostics.model import AnalysisError, DiagnosticCode;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;
from std.core.string import String;

impl ExprChecker {
    pub fn make_trait_object(id: HirId, expected: TypeId, trait_id: TypeId) -> Result<HirId, AnalysisError> {
        let node = self.ctx.session.hir.require(id)?;
        let concrete = match self.ctx.session.types.require(node.type_id)? {
            Pointer(inner) => *inner,
            Reference(inner) => *inner,
            _ => return Result<HirId, AnalysisError>.Err(self.error(node.span.span, "trait object requires a concrete pointer or reference")),
        };

        match &node.kind {
            Unary(value) => {
                if value.op == UnaryOperator.AddrOf && !self.ctx.session.hir.require(value.operand)?.is_place {
                    return Result<HirId, AnalysisError>.Err(self.error(node.span.span, "cannot create a trait object from a temporary value"));
                }
            },
            _ => {},
        }

        let required = object_methods(self.ctx, trait_id)?;
        defer required.drop();

        if !implements(self.ctx, concrete, trait_id, node.span)? {
            let trait_name = type_text(self.ctx, trait_id);
            defer trait_name.drop();
            let concrete_name = type_text(self.ctx, concrete);
            defer concrete_name.drop();
            let message = String.from(&"type '");
            defer message.drop();
            message.push_str(concrete_name.as_str());
            message.push_str("' does not implement '");
            message.push_str(trait_name.as_str());
            message.push_str("'");
            return Result<HirId, AnalysisError>.Err(self.error(node.span.span, message.as_str()));
        }

        let implementations = Vec<TypeId>.new();
        let transferred = false;
        defer {
            if !transferred {
                implementations.drop();
            }
        };

        for method in required {
            let definition = match self.ctx.session.types.require(*method)? {
                Nominal(id, _) => *id, _ => return Result<HirId, AnalysisError>.Err(AnalysisError.internal("dynamic slot is not nominal"))
            };
            let name = self.ctx.session.types.definition(definition).unwrap().header().name;
            let implementation = lookup_method(self.ctx, concrete, name, Option<TypeId>.Some(trait_id), node.span)?;
            let callable = signature(self.ctx, implementation)?;
            defer callable.drop();

            if !callable.is_header {
                schedule(self.ctx, implementation)?;
            }

            implementations.push(implementation);
        }

        transferred = true;
        Result<HirId, AnalysisError>.Ok(self.node(node.span.span, expected, false, HirKind.TraitObjectCoerce(TraitObjectCoerce(id, concrete, trait_id, implementations))))
    }

    pub fn dynamic_method(span: Span, receiver: HirId, trait_id: TypeId, name: NameId, values: Vec<HirId>&) -> Result<HirId, AnalysisError> {
        let methods = object_methods(self.ctx, trait_id)?;
        defer methods.drop();
        let slot = 0u64;

        for method in methods {
            let definition = match self.ctx.session.types.require(*method)? {
                Nominal(id, _) => *id, _ => return Result<HirId, AnalysisError>.Err(AnalysisError.internal("dynamic slot is not nominal"))
            };

            if self.ctx.session.types.definition(definition).unwrap().header().name == name {
                let callable = signature(self.ctx, *method)?;
                defer callable.drop();

                if values.len() != callable.parameters.len() {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "dynamic method argument count mismatch"));
                }

                let args = Vec<HirId>.new();
                let accepted = false;
                defer {
                    if !accepted {
                        args.drop();
                    }
                };
                let index = 0u64;

                while index < values.len() {
                    args.push(self.coerce(values[index], callable.parameters[index].type_id)?);
                    index += 1;
                }

                accepted = true;
                return Result<HirId, AnalysisError>.Ok(self.node(span, callable.result, false, HirKind.TraitObjectMethodCall(TraitObjectMethodCall(receiver, trait_id, *method, slot, args))));
            }

            slot += 1;
        }

        Result<HirId, AnalysisError>.Err(self.error(span, "trait object method does not exist"))
    }
}
