from yianc.analysis.lowering.checker import ExprChecker;
from yianc.analysis.resolution.types import resolve_type;
from yianc.analysis.ty.callable import signature;
from yianc.analysis.ty.method_lookup import lookup_method_with_generics;
from yianc.analysis.hir.node import HirKind, Unary, Block;
from yianc.common.ids import HirId, TypeId, NameId;
from yianc.frontend.ast.node import Expr, TypeSyntax, Argument;
from yianc.frontend.ast.operator import UnaryOperator;
from yianc.frontend.source import Span;
from yianc.diagnostics.model import AnalysisError, AnalysisErrorKind, DiagnosticCode;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.collections.hash_set import HashSet;
from yianc.analysis.ty.display import type_text;
from std.core.convert import From;

impl ExprChecker {
    pub fn method(span: Span, name_span: Option<Span>, receiver: Expr&, spelling: str,
        generics: Vec<TypeSyntax&>&, args: Vec<Argument&>&) -> Result<HirId, AnalysisError> {
        let error_span = match name_span { Some(value) => value, None => span };
        let receiver_id = self.expression(receiver)?;
        let receiver_type = self.type_of(receiver_id);
        let static_call = match &self.ctx.session.hir.require(receiver_id)?.kind {
            Ty => true,
            _ => false,
        };
        let name = self.ctx.session.names.intern(spelling);

        if static_call {
            match self.variant(span, name_span, receiver_type, name, args)? {
                Some(value) => return Result<HirId, AnalysisError>.Ok(value),
                None => {},
            }
        }

        let values = Vec<HirId>.new();
        let types = Vec<TypeId>.new();
        defer {
            values.drop();
            types.drop();
        };

        for arg in *args {
            if arg.data.name.is_some() {
                return Result<HirId, AnalysisError>.Err(self.error(arg.span, "method arguments cannot be named"));
            }

            let value = self.expression(arg.data.value)?;
            values.push(value);
            types.push(self.type_of(value));
        }

        let required = Option<TypeId>.None;
        let generic_start = 0u64;

        if static_call {
            match self.ctx.session.types.require(receiver_type)? {
                Nominal(id, _) => match self.ctx.session.types.complete_definition(*id)? {
                    Trait(methods) => {
                        if generics.len() == 0 {
                            return Result<HirId, AnalysisError>.Err(self.error(span, "trait-qualified static call requires an explicit Self type"));
                        }

                        required = Option<TypeId>.Some(receiver_type);
                        let declared = match methods.get(&name) {
                            Some(value) => *value,
                            None => return Result<HirId, AnalysisError>.Err(self.error(span, "Unknown trait method")),
                        };
                        let declared_signature = signature(self.ctx, declared)?;
                        defer declared_signature.drop();
                        if !declared_signature.is_static {
                            return Result<HirId, AnalysisError>.Err(self.error(span, "trait-qualified calls require a static method"));
                        }

                        receiver_type = self.local_type(generics[0])?;
                        generic_start = 1;
                    },
                    _ => {},
                },
                _ => {},
            }
        }

        // Resolve explicit arguments before candidate inference; owner arguments remain fixed.
        let explicit = Vec<TypeId>.new();
        defer explicit.drop();
        let argument_index = generic_start;

        while argument_index < generics.len() {
            explicit.push(self.local_type(generics[argument_index])?);
            argument_index += 1;
        }

        let provided = if explicit.len() == 0 {
            Option<Vec<TypeId>&>.None
        } else {
            Option<Vec<TypeId>&>.Some(&explicit)
        };

        let method_id = Option<TypeId>.None;
        let prefix = Vec<HirId>.new();
        let transferred = false;
        defer {
            if !transferred {
                prefix.drop();
            }
        };
        let visited = HashSet<TypeId>.new();
        defer visited.drop();

        // Receiver adaptation terminates on a repeated type rather than an arbitrary depth.
        while true {
            if !visited.insert(receiver_type) {
                return Result<HirId, AnalysisError>.Err(self.error(span, "automatic dereference cycle"));
            }

            match self.ctx.session.types.require(receiver_type)? {
                TraitObject(trait_id) => {
                    if generics.len() != 0 {
                        return Result<HirId, AnalysisError>.Err(self.error(span, "dynamic method cannot have generic arguments"));
                    }

                    match self.ctx.session.types.require(*trait_id)? {
                        Nominal(definition, _) => match self.ctx.session.types.complete_definition(*definition)? {
                            Trait(methods) => {},
                            _ => return Result<HirId, AnalysisError>.Err(AnalysisError.internal("trait object has a non-trait type")),
                        },
                        _ => return Result<HirId, AnalysisError>.Err(AnalysisError.internal("trait object identity is not nominal")),
                    };
                    let result = self.dynamic_method(span, name_span, receiver_id, *trait_id, name, &values)?;

                    if prefix.len() == 0 {
                        return Result<HirId, AnalysisError>.Ok(result);
                    }

                    prefix.push(result);
                    transferred = true;
                    return Result<HirId, AnalysisError>.Ok(self.node(span, self.type_of(result), false, HirKind.Block(Block(prefix))));
                },
                _ => {},
            }

            match lookup_method_with_generics(self.ctx, receiver_type, name, required, Option<Vec<TypeId>&>.Some(&types), provided, self.ctx.span(self.unit, error_span)) {
                Ok(value) => {
                    method_id = Option<TypeId>.Some(value);
                    break;
                },
                Err(problem) => {
                    if static_call && problem.diagnostic.code == DiagnosticCode.NoSuchMethod {
                        let message = String.from(&"Unknown static method call '");
                        defer message.drop();
                        message.push_str(spelling);
                        message.push_str("' on ");
                        let receiver_name = type_text(self.ctx, receiver_type);
                        defer receiver_name.drop();
                        message.push_str(receiver_name.as_str());
                        return Result<HirId, AnalysisError>.Err(problem.with_message(message.as_str()));
                    }
                    if static_call || problem.kind != AnalysisErrorKind.NoCandidate {
                        return Result<HirId, AnalysisError>.Err(problem);
                    }

                    let inner = match self.ctx.session.types.require(receiver_type)? {
                        Reference(value) => Option<TypeId>.Some(*value),
                        Pointer(value) => Option<TypeId>.Some(*value),
                        _ => Option<TypeId>.None,
                    };

                    match inner {
                        Some(value) => {
                            problem.drop();
                            receiver_type = value;
                            receiver_id = self.node(span, value, true, HirKind.Unary(Unary(UnaryOperator.Deref, receiver_id)));
                        },
                        None => match self.deref_value(span, receiver_id, &prefix)? {
                            Some(value) => {
                                problem.drop();
                                receiver_id = value;
                                receiver_type = self.type_of(value);
                            },
                            None => return Result<HirId, AnalysisError>.Err(problem),
                        },
                    }
                },
            }
        }

        let method_type = *method_id.unwrap();
        let callable = signature(self.ctx, method_type)?;
        defer callable.drop();

        if callable.is_static {
            return self.call_values(span, method_type, &values, Option<HirId>.None, name_span);
        }

        if static_call {
            let message = String.from(&"cannot call instance method '");
            defer message.drop();
            message.push_str(spelling);
            message.push_str("' as a static method on '");
            let receiver_name = type_text(self.ctx, receiver_type);
            defer receiver_name.drop();
            message.push_str(receiver_name.as_str());
            message.push_str("'; declare it 'static fn' or call it on an instance");
            return Result<HirId, AnalysisError>.Err(self.error(span, message.as_str()));
        }

        let reference = self.ctx.session.types.reference(receiver_type);
        let borrowed = self.node(span, reference, false, HirKind.Unary(Unary(UnaryOperator.AddrOf, receiver_id)));
        let call = self.call_values(span, method_type, &values, Option<HirId>.Some(borrowed), name_span)?;

        if prefix.len() == 0 {
            return Result<HirId, AnalysisError>.Ok(call);
        }

        // The resulting block owns adaptation temporaries and evaluates the receiver once.
        prefix.push(call);
        transferred = true;
        Result<HirId, AnalysisError>.Ok(self.node(span, self.type_of(call), false, HirKind.Block(Block(prefix))))
    }
}
