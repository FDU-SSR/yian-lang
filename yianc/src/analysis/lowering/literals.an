from yianc.analysis.lowering.checker import ExprChecker;
from yianc.analysis.resolution.types import scalar_name;
from yianc.types.model import TypeData;
from yianc.analysis.hir.node import HirKind;
from yianc.common.integer_value import IntegerValue, IntegerWidth;
from yianc.common.integer import cast_integer, integer_fits;
from yianc.analysis.constant.floating import round_float;
from yianc.analysis.constant.definitions import evaluate_constant;
from yianc.common.ids import HirId, TypeId;
from yianc.types.store import C_CHAR_TYPE_ID, C_INT_TYPE_ID, C_UINT_TYPE_ID, C_SIZE_TYPE_ID, BOOL_TYPE_ID, CHAR_TYPE_ID, F64_TYPE_ID, FLOAT_LITERAL_TYPE_ID, I32_TYPE_ID, INT_LITERAL_TYPE_ID, STR_TYPE_ID, U64_TYPE_ID;
from yianc.common.location import SourceSpan;
from yianc.frontend.ast.node import Literal;
from yianc.frontend.source import Span;
from yianc.frontend.lex.token import IntSuffix;
from yianc.diagnostics.model import DiagnosticCode, AnalysisError;
from yianc.analysis.ty.validation import contains_ffi;
from std.core.iter import Iterator, IntoIterator;

impl ExprChecker {
    fn integer_literal(span: Span, magnitude: u64, negative: bool, suffix: IntSuffix) -> Result<HirId, AnalysisError> {
        let type_id = match &suffix {
            Unsuffixed => TypeId(INT_LITERAL_TYPE_ID),
            I8 => self.ctx.types.primitive(TypeData.Integer(8, true))?,
            I16 => self.ctx.types.primitive(TypeData.Integer(16, true))?,
            I32 => self.ctx.types.primitive(TypeData.Integer(32, true))?,
            I64 => self.ctx.types.primitive(TypeData.Integer(64, true))?,
            U8 => self.ctx.types.primitive(TypeData.Integer(8, false))?,
            U16 => self.ctx.types.primitive(TypeData.Integer(16, false))?,
            U32 => self.ctx.types.primitive(TypeData.Integer(32, false))?,
            U64 => TypeId(U64_TYPE_ID),
            Int => TypeId(I32_TYPE_ID),
            Uint => self.ctx.types.primitive(TypeData.Integer(32, false))?,
        };
        let integer = IntegerValue.untyped(magnitude, negative);

        if type_id != TypeId(INT_LITERAL_TYPE_ID) {
            match self.ctx.types.require(type_id)? {
                Integer(bits, signed) => {
                    if !integer_fits(integer, *bits, *signed) {
                        return Result<HirId, AnalysisError>.Err(self.error(span, "integer literal is out of range for its suffix"));
                    }

                    integer = cast_integer(integer, *IntegerWidth.from_bits(*bits).unwrap(), *signed);
                },
                _ => {},
            }
        }

        Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.IntLiteral(integer)))
    }

    fn literal(span: Span, literal: Literal&) -> Result<HirId, AnalysisError> {
        let result = match literal {
            Integer(value) => return self.integer_literal(span, value.data.value, value.data.negative, value.data.suffix),
            Float(value) => {
                let type_id = match &value.data.suffix {
                    Unsuffixed => TypeId(FLOAT_LITERAL_TYPE_ID),
                    F16 => self.ctx.types.primitive(TypeData.Float(16))?,
                    F32 => self.ctx.types.primitive(TypeData.Float(32))?,
                    F64 => TypeId(F64_TYPE_ID),
                    Float => TypeId(F64_TYPE_ID),
                };
                let number = match self.ctx.types.require(type_id)? {
                    Float(bits) => round_float(value.data.value, *bits),
                    _ => value.data.value,
                };
                self.node(span, type_id, false, HirKind.FloatLiteral(number))
            },
            Boolean(value) => self.node(span, TypeId(BOOL_TYPE_ID), false, HirKind.BoolLiteral(value.data.value)),
            StringLiteral(value) => {
                let interned = self.ctx.names.intern(value.data.value.as_str());
                self.node(span, TypeId(STR_TYPE_ID), false, HirKind.StrLiteral(interned))
            },
            Character(value) => {
                let chars = value.data.value.as_str().chars();
                let character = match chars.next() {
                    Some(value) => value,
                    None => return Result<HirId, AnalysisError>.Err(self.error(span, "empty character literal")),
                };
                self.node(span, TypeId(CHAR_TYPE_ID), false, HirKind.CharLiteral(u32(character)))
            },
        };

        Result<HirId, AnalysisError>.Ok(result)
    }

    fn identifier(span: Span, name: str, synthetic: bool) -> Result<HirId, AnalysisError> {
        if name == "c_int" || name == "c_uint" || name == "c_size" || name == "c_char" {
            if !self.ffi_allowed {
                return Result<HirId, AnalysisError>.Err(self.error(span, "extern C function calls require an ffi fn"));
            }

            let type_id = if name == "c_char" {
                TypeId(C_CHAR_TYPE_ID)
            } elif name == "c_size" {
                TypeId(C_SIZE_TYPE_ID)
            } elif name == "c_uint" {
                TypeId(C_UINT_TYPE_ID)
            } else {
                TypeId(C_INT_TYPE_ID)
            };
            return Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty));
        }

        match scalar_name(self.ctx, name) {
            Some(type_id) => return Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty)),
            None => {},
        }

        let interned = self.ctx.names.intern(name);
        let symbol = match self.ctx.symbols.lookup(self.scope, interned) {
            Some(value) => value,
            None => return Result<HirId, AnalysisError>.Err(AnalysisError.named(DiagnosticCode.Undefined,
                Option<SourceSpan>.Some(self.ctx.span(self.unit, span)), "Unknown identifier '", name, "'")),
        };
        let record = *self.ctx.symbols.get(symbol).unwrap();
        let type_id = record.type_id;

        match &record.kind {
            Variable => Result<HirId, AnalysisError>.Ok(self.node(span, type_id, true, HirKind.Var(symbol))),
            Parameter => Result<HirId, AnalysisError>.Ok(self.node(span, type_id, true, HirKind.Var(symbol))),
            Function => Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty)),
            Type => {
                match self.ctx.types.require(type_id)? {
                    LiteralValue(bits, negative, value_type) => {
                        if *value_type == TypeId(BOOL_TYPE_ID) {
                            return Result<HirId, AnalysisError>.Ok(self.node(span, *value_type, false, HirKind.BoolLiteral(*bits != 0)));
                        }

                        let integer = IntegerValue.untyped(*bits, *negative);

                        match self.ctx.types.require(*value_type)? {
                            Integer(width, signed) => {
                                integer = cast_integer(integer, *IntegerWidth.from_bits(*width).unwrap(), *signed);
                            },
                            _ => {},
                        }

                        return Result<HirId, AnalysisError>.Ok(self.node(span, *value_type, false, HirKind.IntLiteral(integer)));
                    },
                    _ => {},
                }

                Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty))
            },
            Alias => {
                if !self.ffi_allowed && contains_ffi(self.ctx.types, type_id, false) {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "C ABI alias requires an ffi function"));
                }
                Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty))
            },
            Constant => evaluate_constant(self.ctx, symbol),
            Module => Result<HirId, AnalysisError>.Err(self.error(span, "module is not a value")),
        }
    }
}
