from yianc.analysis.constant.value import IntegerValue, ConstEvalError;
from yianc.analysis.constant.integer import magnitude;
from yianc.frontend.ast.operator import BinaryOperator;
from std.num.f64 import from_bits;

// Numbers own normalized little-endian base-2^32 digits; zero has no sign or digits.
pub struct BigInteger {
    digits: Vec<u32>,
    negative: bool,
}

impl BigInteger {
    static pub fn zero() -> Self { Self(Vec<u32>.new(), false) }

    static pub fn from_small(value: IntegerValue) -> Self {
        Self.from_magnitude(magnitude(value), value.is_negative())
    }

    static pub fn from_magnitude(value: u64, negative: bool) -> Self {
        let digits = Vec<u32>.new();
        if value != 0 {
            digits.push(u32(value));
            if (value >> 32u32) != 0 { digits.push(u32(value >> 32u32)); }
        }
        Self(digits, negative && value != 0)
    }

    pub fn is_negative() -> bool { self.negative }
    pub fn is_zero() -> bool { self.digits.len() == 0 }

    fn normalize() {
        while self.digits.len() != 0 && self.digits[self.digits.len() - 1] == 0 {
            self.digits.pop();
        }
        if self.digits.len() == 0 { self.negative = false; }
    }

    fn digit(index: u64) -> u32 {
        if index < self.digits.len() { self.digits[index] } else { 0u32 }
    }

    pub fn low_bits() -> u64 {
        let bits = u64(self.digit(0)) | (u64(self.digit(1)) << 32u32);
        if self.negative { 0u64 - bits } else { bits }
    }

    pub fn small_magnitude() -> Option<u64> {
        if self.digits.len() > 2 { return Option<u64>.None; }
        Option<u64>.Some(u64(self.digit(0)) | (u64(self.digit(1)) << 32u32))
    }

    fn absolute_compare(other: Self&) -> i32 {
        if self.digits.len() != other.digits.len() {
            return if self.digits.len() < other.digits.len() { -1 } else { 1 };
        }
        let index = self.digits.len();
        while index != 0 {
            index -= 1;
            if self.digits[index] != other.digits[index] {
                return if self.digits[index] < other.digits[index] { -1 } else { 1 };
            }
        }
        0
    }

    pub fn compare(other: Self&) -> i32 {
        if self.negative != other.negative { return if self.negative { -1 } else { 1 }; }
        let order = self.absolute_compare(other);
        if self.negative { -order } else { order }
    }

    fn absolute_add(other: Self&) -> Self {
        let digits = Vec<u32>.new();
        let length = if self.digits.len() > other.digits.len() { self.digits.len() } else { other.digits.len() };
        let carry = 0u64;
        let index = 0u64;
        while index < length {
            let sum = u64(self.digit(index)) + u64(other.digit(index)) + carry;
            digits.push(u32(sum));
            carry = sum >> 32u32;
            index += 1;
        }
        if carry != 0 { digits.push(u32(carry)); }
        Self(digits, false)
    }

    // The caller guarantees that the left magnitude is at least the right magnitude.
    fn absolute_subtract(other: Self&) -> Self {
        let digits = Vec<u32>.new();
        let borrow = 0u64;
        let index = 0u64;
        while index < self.digits.len() {
            let left = u64(self.digits[index]);
            let right = u64(other.digit(index)) + borrow;
            digits.push(u32(left - right));
            borrow = if left < right { 1u64 } else { 0u64 };
            index += 1;
        }
        let result = Self(digits, false);
        result.normalize();
        result
    }

    pub fn add(other: Self&) -> Self {
        if self.negative == other.negative {
            let result = self.absolute_add(other);
            result.negative = self.negative && !result.is_zero();
            return result;
        }
        let order = self.absolute_compare(other);
        let result = if order >= 0 { self.absolute_subtract(other) } else { other.absolute_subtract(self) };
        result.negative = if order >= 0 { self.negative } else { other.negative };
        result.normalize();
        result
    }

    pub fn negated() -> Self {
        let result = self.clone();
        if !result.is_zero() { result.negative = !result.negative; }
        result
    }

    pub fn subtract(other: Self&) -> Self {
        let negative = other.negated();
        defer negative.drop();
        self.add(&negative)
    }

    pub fn multiply(other: Self&) -> Self {
        if self.is_zero() || other.is_zero() { return Self.zero(); }
        let digits = Vec<u32>.new();
        let length = self.digits.len() + other.digits.len();
        let index = 0u64;
        while index < length { digits.push(0u32); index += 1; }
        index = 0;
        while index < self.digits.len() {
            let carry = 0u64;
            let right = 0u64;
            while right < other.digits.len() {
                let position = index + right;
                let product = u64(self.digits[index]) * u64(other.digits[right]) + u64(digits[position]) + carry;
                digits[position] = u32(product);
                carry = product >> 32u32;
                right += 1;
            }
            digits[index + other.digits.len()] = u32(carry);
            index += 1;
        }
        let result = Self(digits, self.negative != other.negative);
        result.normalize();
        result
    }

    fn bit_length() -> u64 {
        if self.is_zero() { return 0; }
        let top = self.digits[self.digits.len() - 1];
        let count = 0u64;
        while top != 0 { top >>= 1u32; count += 1; }
        return (self.digits.len() - 1) * 32 + count;
    }

    fn bit(index: u64) -> bool {
        (self.digit(index / 32) & (1u32 << u32(index % 32))) != 0
    }

    pub fn shift_left(count: u64) -> Result<Self, ConstEvalError> {
        if self.is_zero() { return Result<Self, ConstEvalError>.Ok(Self.zero()); }
        if count > 0xFFFFFFFFFFFFFFFFu64 - self.bit_length() {
            return Result<Self, ConstEvalError>.Err(ConstEvalError.Overflow);
        }
        let digits = Vec<u32>.new();
        let words = count / 32;
        let shift = u32(count % 32);
        let index = 0u64;
        while index < words { digits.push(0u32); index += 1; }
        index = 0;
        let carry = 0u64;
        while index < self.digits.len() {
            let bits = (u64(self.digits[index]) << shift) | carry;
            digits.push(u32(bits));
            carry = bits >> 32u32;
            index += 1;
        }
        if carry != 0 { digits.push(u32(carry)); }
        Result<Self, ConstEvalError>.Ok(Self(digits, self.negative))
    }

    // Negative right shifts round toward negative infinity, including discarded low bits.
    pub fn shift_right(count: u64) -> Self {
        if count >= self.bit_length() { return Self.from_magnitude(if self.negative { 1u64 } else { 0u64 }, self.negative); }
        let words = count / 32;
        let shift = u32(count % 32);
        let discarded = false;
        let index = 0u64;
        while index < words { discarded = discarded || self.digits[index] != 0; index += 1; }
        if shift != 0 { discarded = discarded || (self.digits[words] & ((1u32 << shift) - 1)) != 0; }
        let digits = Vec<u32>.new();
        index = words;
        while index < self.digits.len() {
            let bits = (u64(self.digit(index + 1)) << 32u32) | u64(self.digits[index]);
            digits.push(u32(bits >> shift));
            index += 1;
        }
        let result = Self(digits, self.negative);
        result.normalize();
        if self.negative && discarded {
            let one = Self.from_magnitude(1, true);
            defer one.drop();
            let rounded = result.add(&one);
            result.drop();
            return rounded;
        }
        result
    }

    // Binary long division is independent of host signed overflow and truncates toward zero.
    pub fn divide(other: Self&) -> Result<(Self, Self), ConstEvalError> {
        if other.is_zero() { return Result<(Self, Self), ConstEvalError>.Err(ConstEvalError.DivisionByZero); }
        let remainder = self.clone();
        remainder.negative = false;
        let quotient = Self.zero();
        let difference = if self.bit_length() >= other.bit_length() { self.bit_length() - other.bit_length() } else {
            remainder.negative = self.negative;
            return Result<(Self, Self), ConstEvalError>.Ok((quotient, remainder));
        };
        let shifted = match other.shift_left(difference) {
            Ok(value) => value,
            Err(error) => { quotient.drop(); remainder.drop(); return Result<(Self, Self), ConstEvalError>.Err(error); },
        };
        shifted.negative = false;
        let index = 0u64;
        while index <= difference / 32 { quotient.digits.push(0u32); index += 1; }
        let bit = difference;
        loop {
            if remainder.absolute_compare(&shifted) >= 0 {
                let next = remainder.absolute_subtract(&shifted);
                remainder.drop();
                remainder = next;
                quotient.digits[bit / 32] |= 1u32 << u32(bit % 32);
            }
            if bit == 0 { break; }
            let next = shifted.shift_right(1);
            shifted.drop();
            shifted = next;
            bit -= 1;
        }
        shifted.drop();
        quotient.negative = self.negative != other.negative;
        remainder.negative = self.negative;
        quotient.normalize();
        remainder.normalize();
        Result<(Self, Self), ConstEvalError>.Ok((quotient, remainder))
    }

    fn twos_digit(index: u64, carry: u64&) -> u32 {
        if !self.negative { return self.digit(index); }
        let bits = u64(~self.digit(index)) + *carry;
        *carry = bits >> 32u32;
        u32(bits)
    }

    pub fn bitwise(op: BinaryOperator, other: Self&) -> Self {
        let length = (if self.digits.len() > other.digits.len() { self.digits.len() } else { other.digits.len() }) + 1;
        let digits = Vec<u32>.new();
        let left_carry = 1u64;
        let right_carry = 1u64;
        let index = 0u64;
        while index < length {
            let left = self.twos_digit(index, &left_carry);
            let right = other.twos_digit(index, &right_carry);
            digits.push(match op { BitAnd => left & right, BitOr => left | right, _ => left ^ right, });
            index += 1;
        }
        let negative = (digits[length - 1] & 0x80000000u32) != 0;
        if negative {
            let carry = 1u64;
            index = 0;
            while index < length {
                let bits = u64(~digits[index]) + carry;
                digits[index] = u32(bits);
                carry = bits >> 32u32;
                index += 1;
            }
        }
        let result = Self(digits, negative);
        result.normalize();
        result
    }

    pub fn inverted() -> Self {
        let negative = self.negated();
        defer negative.drop();
        let one = Self.from_magnitude(1, true);
        defer one.drop();
        negative.add(&one)
    }

    pub fn binary(op: BinaryOperator, other: Self&) -> Result<Self, ConstEvalError> {
        let value = match op {
            Add => self.add(other), Sub => self.subtract(other), Mul => self.multiply(other),
            Div | Mod => {
                let pair = self.divide(other)?;
                if op == BinaryOperator.Div { pair[1].drop(); pair[0] } else { pair[0].drop(); pair[1] }
            },
            BitAnd | BitOr | BitXor => self.bitwise(op, other),
            Shl | Shr => {
                if other.negative { return Result<Self, ConstEvalError>.Err(ConstEvalError.NegativeShift); }
                let count = match other.small_magnitude() {
                    Some(value) => value,
                    None => {
                        if op == BinaryOperator.Shr { return Result<Self, ConstEvalError>.Ok(Self.from_magnitude(if self.negative { 1u64 } else { 0u64 }, self.negative)); }
                        return Result<Self, ConstEvalError>.Err(ConstEvalError.Overflow);
                    },
                };
                if op == BinaryOperator.Shl { self.shift_left(count)? } else { self.shift_right(count) }
            },
            _ => return Result<Self, ConstEvalError>.Err(ConstEvalError.InvalidOperator),
        };
        Result<Self, ConstEvalError>.Ok(value)
    }

    // Round the leading 53 bits once, with a sticky suffix for ties-to-even.
    pub fn to_float() -> f64 {
        let length = self.bit_length();
        if length == 0 { return 0.0; }
        let shift = if length > 53 { length - 53 } else { 0u64 };
        let top = 0u64;
        let index = length;
        while index > shift { index -= 1; top = (top << 1u32) | if self.bit(index) { 1u64 } else { 0u64 }; }
        if shift != 0 {
            let sticky = false;
            index = 0;
            while index + 1 < shift { sticky = sticky || self.bit(index); index += 1; }
            if self.bit(shift - 1) && (sticky || (top & 1) != 0) { top += 1; }
        }
        let number = if shift > 1023 { from_bits(0x7FF0000000000000u64) } else {
            f64(top) * from_bits((shift + 1023) << 52u32)
        };
        if self.negative { -number } else { number }
    }
}

impl Clone for BigInteger {
    pub fn clone() -> Self { Self(self.digits.clone(), self.negative) }
}

impl Drop for BigInteger {
    pub fn drop() { self.digits.drop(); }
}
