from yianc.common.ids import NameId;
from yianc.common.integer_value import IntegerValue;

pub enum ConstValue {
    Integer {
        value: IntegerValue
    },
    Float {
        value: f64
    },
    Bool {
        value: bool
    },
    Char {
        value: char
    },
    String {
        name: NameId
    },
    Array {
        elements: Vec<ConstValue>
    },
    ArrayRepeat {
        element: ConstValue&,
        length: u64
    },
}

impl Clone for ConstValue {
    pub fn clone() -> Self {
        match self {
            Integer(value) => Self.Integer(*value),
            Float(value) => Self.Float(*value),
            Bool(value) => Self.Bool(*value),
            Char(value) => Self.Char(*value),
            String(value) => Self.String(*value),
            Array(elements) => {
                let copies = Vec<ConstValue>.new();

                for element in *elements {
                    copies.push(element.clone());
                }

                Self.Array(copies)
            },
            ArrayRepeat(element, length) => {
                let pointer = *element;
                let copy = pointer.clone();
                let stored = dyn copy;
                Self.ArrayRepeat(stored, *length)
            },
        }
    }
}

impl Drop for ConstValue {
    pub fn drop() {
        match self {
            Array(elements) => {
                for element in *elements {
                    element.drop();
                }

                elements.drop();
            },
            ArrayRepeat(element, _) => {
                let pointer = *element;
                pointer.drop();
                del pointer;
            },
            _ => {},
        }
    }
}
