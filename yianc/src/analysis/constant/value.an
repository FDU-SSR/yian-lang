from yianc.common.ids import NameId;
from yianc.analysis.constant.big_integer import BigInteger;
from std.core.drop import Drop;

pub enum ConstEvalError {
    Overflow,
    DivisionByZero,
    NegativeShift,
    InvalidCast,
    InvalidOperator,
    NotConstant,
}

impl ConstEvalError {
    pub fn message() -> str {
        match self {
            Overflow => "untyped integer exceeds the supported magnitude",
            DivisionByZero => "division by zero",
            NegativeShift => "negative shift",
            InvalidCast => "invalid constant conversion",
            InvalidOperator => "invalid constant operator",
            NotConstant => "expression is not compile-time evaluable",
        }
    }
}

// Only supported widths can reach bit arithmetic and shift expressions.
pub enum IntegerWidth {
    W8,
    W16,
    W32,
    W64,
}

impl IntegerWidth {
    static pub fn from_bits(bits: u32) -> Result<Self, ConstEvalError> {
        match bits {
            8 => Result<Self, ConstEvalError>.Ok(Self.W8),
            16 => Result<Self, ConstEvalError>.Ok(Self.W16),
            32 => Result<Self, ConstEvalError>.Ok(Self.W32),
            64 => Result<Self, ConstEvalError>.Ok(Self.W64),
            _ => Result<Self, ConstEvalError>.Err(ConstEvalError.InvalidCast),
        }
    }

    pub fn bits() -> u32 {
        match self {
            W8 => 8u32,
            W16 => 16u32,
            W32 => 32u32,
            W64 => 64u32
        }
    }

    pub fn mask() -> u64 {
        if *self == Self.W64 {
            return 0xFFFFFFFFFFFFFFFFu64;
        }

        return (1u64 << self.bits()) - 1;
    }
}

enum IntegerRepresentation {
    Untyped {
        magnitude: u64,
        negative: bool
    },
    Fixed {
        bits: u64,
        width: IntegerWidth,
        signed: bool
    },
}

// Private representation prevents non-normalized bits or a negative untyped zero.
pub struct IntegerValue {
    representation: IntegerRepresentation
}

impl IntegerValue {
    static pub fn untyped(magnitude: u64, negative: bool) -> Self {
        Self(IntegerRepresentation.Untyped(magnitude, negative && magnitude != 0))
    }

    static pub fn fixed(bits: u64, width: IntegerWidth, signed: bool) -> Self {
        Self(IntegerRepresentation.Fixed(bits & width.mask(), width, signed))
    }

    pub fn is_untyped() -> bool {
        match &self.representation {
            Untyped(_, _) => true,
            Fixed(_, _, _) => false
        }
    }

    pub fn raw_bits() -> u64 {
        match &self.representation {
            Untyped(magnitude, _) => *magnitude,
            Fixed(bits, _, _) => *bits
        }
    }

    // Untyped magnitudes use all 64 storage bits without gaining a fixed-width type.
    pub fn storage_width() -> IntegerWidth {
        match &self.representation {
            Untyped(_, _) => IntegerWidth.W64,
            Fixed(_, width, _) => *width
        }
    }

    pub fn is_signed() -> bool {
        match &self.representation {
            Untyped(_, _) => false,
            Fixed(_, _, signed) => *signed
        }
    }

    pub fn is_negative() -> bool {
        match &self.representation {
            Untyped(_, negative) => *negative,
            Fixed(bits, width, signed) => *signed && (*bits & (1u64 << (width.bits() - 1))) != 0,
        }
    }
}

pub enum ConstValue {
    Integer {
        value: IntegerValue
    },
    LargeInteger {
        value: BigInteger
    },
    Float {
        value: f64
    },
    Bool {
        value: bool
    },
    Char {
        value: u32
    },
    String {
        name: NameId
    },
}

impl Clone for ConstValue {
    pub fn clone() -> Self {
        match self {
            Integer(value) => Self.Integer(*value),
            LargeInteger(value) => Self.LargeInteger(value.clone()),
            Float(value) => Self.Float(*value),
            Bool(value) => Self.Bool(*value),
            Char(value) => Self.Char(*value),
            String(value) => Self.String(*value),
        }
    }
}

impl Drop for ConstValue {
    pub fn drop() {
        match self { LargeInteger(value) => value.drop(), _ => {}, }
    }
}
