// Compatibility entrypoints borrow the current snapshot and return owned query data.
from yianc.analysis.editor import EditorSnapshot;
from yianc.analysis.editor.query_model import EditorCompletionKind as CompletionKind, EditorCompletionItem as CompletionItem, EditorCompletionResult as CompletionResult, EditorSignatureHelp as SignatureHelp;
from yianc.analysis.editor.completion import completion_at as complete;
from yianc.analysis.editor.signatures import signature_help_at as signature_help;
from yianc.common.ids import SourceId;
from yianc.diagnostics.model import AnalysisError;
from std.core.option import Option;
from std.core.result import Result;

pub typedef EditorCompletionKind = CompletionKind;
pub typedef EditorCompletionItem = CompletionItem;
pub typedef EditorCompletionResult = CompletionResult;
pub typedef EditorSignatureHelp = SignatureHelp;

pub fn completion_at(snapshot: EditorSnapshot&, source: SourceId, row: u64, column: u64)
-> Result<EditorCompletionResult, AnalysisError> {
    complete(snapshot, source, row, column)
}

pub fn signature_help_at(snapshot: EditorSnapshot&, source: SourceId, row: u64, column: u64)
-> Option<EditorSignatureHelp> {
    signature_help(snapshot, source, row, column)
}
