from yianc.config import CompilerConfig;
from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.codegen.session import BackendSession, BackendOptions;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from yianc.diagnostics.model import AnalysisError, Diagnostic, DiagnosticCode, Severity, AnalysisStage;
from yianc.diagnostics.render import write_json, render;
from yianc.frontend.source import SourceManager;
from yianc.driver.paths import source_roots;
from yianc.driver.host import associated_root;
from yianc.driver.trace import CompilerTrace;
from yianc.driver.profile import ProfileKind;
from yianc.driver.dump import StageDumps;
from yianc.analysis.session.prepare import PreparationObserver;
from json.write import Writer;
from std.core.drop import Drop;
from std.core.io import Stdout, Stderr;
from std.core.option import Option;
from std.core.path import Path;
from std.core.fs import try_exists;
from std.core.result import Result;
from std.core.vec import Vec;
from std.core.iter import Iterator, IntoIterator;

// The caller owns every diagnostic and keeps its source manager alive throughout rendering.
fn emit(json: bool, diagnostics: Vec<Diagnostic>&, stage: Option<AnalysisStage>, sources: Option<SourceManager&>) -> bool {
    let errors = 0u64;
    let warnings = 0u64;
    for diagnostic in *diagnostics {
        if diagnostic.severity == Severity.Error { errors += 1; }
        if diagnostic.severity == Severity.Warning { warnings += 1; }
    }
    if json {
        let writer = Writer.new();
        defer writer.drop();
        writer.begin_object();
        writer.key("format");
        writer.write_u64(1);
        writer.key("ok");
        writer.write_bool(errors == 0);
        writer.key("stage");
        match stage { Some(value) => writer.write_string(value.name()), None => writer.write_null(), }
        writer.key("summary");
        writer.begin_object();
        writer.key("errors");
        writer.write_u64(errors);
        writer.key("warnings");
        writer.write_u64(warnings);
        writer.end_object();
        writer.key("diagnostics");
        writer.begin_array();
        for diagnostic in *diagnostics {
            match write_json(diagnostic, &writer, sources) { Ok(_) => {}, Err(problem) => { problem.drop(); return false; }, }
        }
        writer.end_array();
        writer.end_object();
        let text = match writer.finish() { Ok(value) => value, Err(_) => return false, };
        defer text.drop();
        return match Stdout.new().write_str(text.as_str()) {
            Ok(_) => match Stdout.new().write_str("\n") { Ok(_) => true, Err(problem) => { problem.drop(); false }, },
            Err(problem) => { problem.drop(); false },
        };
    }
    for diagnostic in *diagnostics {
        let text = match render(diagnostic, sources) { Ok(value) => value, Err(problem) => { problem.drop(); return false; }, };
        defer text.drop();
        match Stderr.new().write_str(text.as_str()) { Ok(_) => {}, Err(problem) => { problem.drop(); return false; }, }
        match Stderr.new().write_str("\n") { Ok(_) => {}, Err(problem) => { problem.drop(); return false; }, }
    }
    true
}

fn emit_error(json: bool, problem: Diagnostic&, sources: Option<SourceManager&>) {
    // Configuration and I/O failures precede analysis and use the CLI's text error channel.
    let analysis_json = json && !(problem.code == DiagnosticCode.Source && problem.location.is_none());

    // This temporary vector borrows shallow diagnostic records; only its storage is released.
    let diagnostics = Vec<Diagnostic>.new();
    defer diagnostics.drop();
    diagnostics.push(*problem);
    emit(analysis_json, &diagnostics, problem.stage, sources);
}

fn start_profile(trace: Option<CompilerTrace&>, pass_id: str) -> u64 {
    match trace { Some(value) => value.start_pass(pass_id, "input", pass_id, ProfileKind.Pass), None => 0u64 }
}

fn finish_profile(trace: Option<CompilerTrace&>, pass_id: str, token: u64, success: bool) {
    match trace {
        Some(value) => if success { value.finish(pass_id, token); } else { value.fail(pass_id, token); },
        None => {},
    }
}

pub fn prepare(config: CompilerConfig&) -> Result<AnalysisSession, AnalysisError> {
    prepare_profiled(config, Option<CompilerTrace&>.None)
}

pub fn prepare_profiled(config: CompilerConfig&, trace: Option<CompilerTrace&>) -> Result<AnalysisSession, AnalysisError> {
    let transferred = false;
    let packages = match &config.packages {
        Some(path) => {
            let token = start_profile(trace, "input.package_map");
            match PackageMap.load(path.as_str()) {
                Ok(value) => { finish_profile(trace, "input.package_map", token, true); Option<PackageMap>.Some(value) },
                Err(problem) => { finish_profile(trace, "input.package_map", token, false); return Result<AnalysisSession, AnalysisError>.Err(problem); },
            }
        },
        None => {
            match trace { Some(value) => value.skip("input.package_map", "standalone compilation has no package map"), None => {}, }
            Option<PackageMap>.None
        },
    };
    defer {
        if !transferred { match &packages { Some(value) => value.drop(), None => {}, } }
    };
    let map = match &packages { Some(value) => Option<PackageMap&>.Some(value), None => Option<PackageMap&>.None, };
    let roots_token = start_profile(trace, "input.source_roots");
    let roots_result = source_roots(config, map);
    match &roots_result {
        Ok(_) => finish_profile(trace, "input.source_roots", roots_token, true),
        Err(_) => finish_profile(trace, "input.source_roots", roots_token, false),
    }
    let roots = roots_result?;
    defer roots.drop();
    let trust = SourceTrust.new(roots.standard_library.as_str())?;
    defer {
        if !transferred {
            trust.drop();
        }
    };

    // Harness trust belongs to the compiler checkout, independently of standard-library overrides.
    let harness_checkout = associated_root()?;
    defer harness_checkout.drop();
    let harnesses = ["tests/basic/std", "tests/safety/std"];

    for harness in harnesses {
        let root = Path.new(harness_checkout.as_str()).join(*harness);
        defer root.drop();

        match try_exists(root.as_str()) {
            Ok(exists) => {
                if exists {
                    trust.add_test_root(root.as_str())?;
                }
            },
            Err(problem) => {
                defer problem.drop();
                return Result<AnalysisSession, AnalysisError>.Err(AnalysisError.internal(problem.msg()));
            },
        }
    }

    transferred = true;
    let dumps = StageDumps(config.dump, trace);
    let observe = match &config.action { Compile => config.dump || trace.is_some(), _ => false };
    let observer = if observe { Option<PreparationObserver&>.Some(&dumps) } else { Option<PreparationObserver&>.None };
    AnalysisSession.prepare_observed(&config.inputs, trust, packages, config.raw_pointers, config.allow_ffi, observer)
}

pub fn analyze_cli(config: CompilerConfig&, json: bool) -> bool {
    let trace = match CompilerTrace.new(config, true) {
        Ok(value) => value,
        Err(problem) => {
            defer problem.drop();
            match Stderr.new().write_str(problem.as_str()) { Ok(_) => {}, Err(error) => error.drop(), }
            return false;
        },
    };
    defer trace.drop();
    defer trace.report();
    let started = trace.start("main", "source preparation");
    let session = match prepare(config) {
        Ok(value) => value,
        Err(problem) => {
            defer problem.drop();
            emit_error(json, &problem.diagnostic, Option<SourceManager&>.None);
            return false;
        },
    };
    defer session.drop();
    trace.finish("source preparation", started);

    let backend = match BackendSession.new(&session, BackendOptions(session.raw_pointers, 0u8)) {
        Ok(value) => value,
        Err(problem) => {
            defer problem.drop();
            emit_error(json, &problem.diagnostic, Option<SourceManager&>.Some(session.source_manager()));
            return false;
        },
    };
    defer backend.drop();
    let options = AnalysisOptions.new();
    options.sizes = Option<TypeSizeProvider&>.Some(backend.size_provider());

    options.recover = true;
    options.trace = Option<CompilerTrace&>.Some(&trace);
    match session.analyze_report(options) {
        Ok(report) => {
            defer report.drop();
            let emitted = emit(json, &report.diagnostics, report.failed_stage, Option<SourceManager&>.Some(session.source_manager()));
            emitted && report.ok()
        },
        Err(problem) => {
            defer problem.drop();
            emit_error(json, &problem.diagnostic, Option<SourceManager&>.Some(session.source_manager()));
            false
        },
    }
}
