from yianc.common.ids import UnitId, TypeId, ScopeId, SymbolId, DefId, HirId;
from yianc.common.location import SourceSpan;
from yianc.common.names import NameInterner;
from yianc.analysis.permissions import SourcePermissions;
from yianc.analysis.definition.registry import DefinitionRegistry;
from yianc.analysis.definition.worklist import DefinitionWorklist;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.ty.impl_registry import ImplRegistry;
from yianc.analysis.symbol.scope import SymbolStore;
from yianc.analysis.symbol.model import SymbolKind;
from yianc.analysis.constant.evaluate import ConstantEvaluator;
from yianc.types.store import TypeStore;
from yianc.types.layout import TypeSizeProvider;
from yianc.frontend.unit import UnitTable;
from yianc.frontend.ast.node import Item;
from yianc.frontend.source import Span;
from yianc.package.model import PackageMap;
from yianc.diagnostics.model import DiagnosticCode, AnalysisError, DiagnosticReporter, Severity;
from yianc.analysis.session.output import AnalysisWarning;
from std.core.convert import From;
from std.collections.arena import Arena;
from std.collections.hash_map import HashMap;
from std.core.iter import Iterator, IntoIterator;

pub enum DeclarationState {
    Declared,
    Resolving,
    Complete,
    Failed,
}

// Syntax references belong to the frontend table; this record owns no AST resources.
pub struct Declaration {
    pub item: Item&,
    pub unit: UnitId,
    pub scope: ScopeId,
    pub symbol: SymbolId,
    pub definition: Option<DefId>,
    pub state: DeclarationState,
}

// The context borrows shared compilation tables and driver-owned semantic registries.
pub struct ResolutionContext {
    pub units: UnitTable&,
    pub packages: Option<PackageMap&>,
    pub names: NameInterner&,
    pub types: TypeStore&,
    pub symbols: SymbolStore&,
    pub hir: HirStore&,
    pub stdlib_root: str,
    pub permissions: Vec<SourcePermissions>&,
    pub definitions: DefinitionRegistry&,
    pub worklist: DefinitionWorklist&,
    pub impls: ImplRegistry&,
    pub raw_pointers: bool,
    pub scopes: Vec<ScopeId>,
    declarations: Arena<Declaration>,
    pub callable_scopes: HashMap<DefId, ScopeId>,
    pub constants: HashMap<SymbolId, HirId>,
    pub closure_captures: HashMap<DefId, Vec<SymbolId>>,
    pub evaluator: ConstantEvaluator,
    pub alias_stack: Vec<SymbolId>,
    pub constant_stack: Vec<SymbolId>,
    reporter: Option<DiagnosticReporter&>,
}

impl ResolutionContext {
    static pub fn new(units: UnitTable&, packages: Option<PackageMap&>, names: NameInterner&,
        types: TypeStore&, symbols: SymbolStore&, hir: HirStore&, stdlib_root: str,
        permissions: Vec<SourcePermissions>&, definitions: DefinitionRegistry&,
        worklist: DefinitionWorklist&, impls: ImplRegistry&, raw_pointers: bool,
        sizes: Option<TypeSizeProvider&>, reporter: Option<DiagnosticReporter&>) -> Result<Self, AnalysisError> {
        let evaluator = ConstantEvaluator.new(types, hir, sizes);
        let scopes = Vec<ScopeId>.new();
        let accepted = false;
        defer {
            if !accepted {
                scopes.drop();
            }
        };

        let index = 0u64;

        while index < units.len() {
            let scope = symbols.create_scope(Option<ScopeId>.None)?;
            scopes.push(scope);
            index += 1;
        }

        accepted = true;
        Result<Self, AnalysisError>.Ok(Self(units, packages, names, types, symbols, hir,
            stdlib_root, permissions, definitions, worklist, impls, raw_pointers, scopes,
            Arena<Declaration>.new(), HashMap<DefId, ScopeId>.new(), HashMap<SymbolId, HirId>.new(),
            HashMap<DefId, Vec<SymbolId>>.new(), evaluator, Vec<SymbolId>.new(),
            Vec<SymbolId>.new(), reporter))
    }

    pub fn span(unit: UnitId, span: Span) -> SourceSpan {
        self.units.file(unit);
        SourceSpan(unit, span)
    }

    pub fn error(unit: UnitId, span: Span, code: DiagnosticCode, message: str) -> AnalysisError {
        AnalysisError.user(code, Option<SourceSpan>.Some(self.span(unit, span)), message)
    }

    pub fn warning(unit: UnitId, span: Span, code: DiagnosticCode, message: str) {
        if code.severity() != Severity.Warning { @panic("analysis warning requires a warning code"); }
        let warning = AnalysisWarning(code, self.span(unit, span), String.from(&message));
        defer warning.drop();
        match self.reporter { Some(reporter) => reporter.report(&warning), None => {}, }
    }

    pub fn add(declaration: Declaration) {
        self.declarations.alloc(declaration);
    }

    pub fn len() -> u64 {
        self.declarations.len()
    }

    pub fn declaration(index: u64) -> Declaration& {
        *self.declarations.get(index).unwrap()
    }

    pub fn for_symbol(symbol: SymbolId) -> Option<Declaration&> {
        for declaration in self.declarations {
            if declaration.symbol == symbol {
                return Option<Declaration&>.Some(declaration);
            }
        }

        Option<Declaration&>.None
    }

    pub fn intrinsic(name: str) -> Option<TypeId> {
        let index = 0u64;
        while index < self.symbols.symbol_count() {
            let symbol = self.symbols.symbol_at(index).unwrap();
            index += 1;
            if symbol.kind == SymbolKind.Type && self.permissions.get(symbol.unit.index).unwrap().is_stdlib && self.names.text(symbol.name) == name {
                match self.types.get(symbol.type_id) {
                    Some(Nominal(_, _)) => return Option<TypeId>.Some(symbol.type_id),
                    _ => {},
                }
            }
        }
        Option<TypeId>.None
    }
}

impl Drop for ResolutionContext {
    pub fn drop() {
        self.declarations.drop();
        self.callable_scopes.drop();
        self.constants.drop();
        self.alias_stack.drop();
        self.constant_stack.drop();

        for captures in self.closure_captures.values() {
            captures.drop();
        }

        self.closure_captures.drop();
        self.scopes.drop();
    }
}
