from yianc.common.ids import UnitId, ScopeId, SymbolId, DefId, TypeId, SourceId, HirId;
from yianc.common.location import SourceSpan;
from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.constant.evaluate import ConstantEvaluator, TypeSizeProvider;
from yianc.frontend.ast.node import Item;
from yianc.frontend.source import Position, Span;
from yianc.diagnostics.model import Diagnostic, DiagnosticCode, AnalysisError;
from std.collections.arena import Arena;
from std.collections.hash_map import HashMap;
from std.core.iter import Iterator, IntoIterator;

pub enum DeclarationState {
    Declared,
    Resolving,
    Complete,
    Failed,
}

// Syntax references belong to the session; this record owns no AST resources.
pub struct Declaration {
    pub item: Item&,
    pub unit: UnitId,
    pub scope: ScopeId,
    pub symbol: SymbolId,
    pub definition: Option<DefId>,
    pub state: DeclarationState,
}

// The fixed builtin type prefix lives in TypeStore; the context keeps no second cache.

// The context lives for one analysis run and borrows its session throughout.
pub struct ResolutionContext {
    pub session: AnalysisSession&,
    pub scopes: Vec<ScopeId>,
    declarations: Arena<Declaration>,
    pub callable_scopes: HashMap<DefId, ScopeId>,
    pub constants: HashMap<SymbolId, HirId>,
    pub closure_captures: HashMap<DefId, Vec<SymbolId>>,
    pub evaluator: ConstantEvaluator,
    pub alias_stack: Vec<SymbolId>,
    pub constant_stack: Vec<SymbolId>,
    pub warnings: Vec<Diagnostic>,
}

impl ResolutionContext {
    static pub fn new(session: AnalysisSession&, sizes: Option<TypeSizeProvider&>) -> Result<Self, AnalysisError> {
        let evaluator = ConstantEvaluator.new(&session.types, &session.hir, sizes);
        let scopes = Vec<ScopeId>.new();
        let accepted = false;
        defer {
            if !accepted {
                scopes.drop();
            }
        };

        let index = 0u64;

        while index < session.len() {
            let scope = session.symbols.create_scope(Option<ScopeId>.None)?;
            scopes.push(scope);
            index += 1;
        }

        accepted = true;
        Result<Self, AnalysisError>.Ok(Self(session, scopes, Arena<Declaration>.new(), HashMap<DefId, ScopeId>.new(), HashMap<SymbolId, HirId>.new(), HashMap<DefId, Vec<SymbolId>>.new(), evaluator, Vec<SymbolId>.new(), Vec<SymbolId>.new(), Vec<Diagnostic>.new()))
    }

    pub fn span(unit: UnitId, span: Span) -> SourceSpan {
        SourceSpan(self.session.unit(unit).unwrap().source, span)
    }

    pub fn error(unit: UnitId, span: Span, code: DiagnosticCode, message: str) -> AnalysisError {
        AnalysisError.user(code, Option<SourceSpan>.Some(self.span(unit, span)), message)
    }

    pub fn warning(unit: UnitId, span: Span, code: DiagnosticCode, message: str) {
        self.warnings.push(Diagnostic.warning(code, Option<SourceSpan>.Some(self.span(unit, span)), message));
    }

    pub fn add(declaration: Declaration) {
        self.declarations.alloc(declaration);
    }

    pub fn len() -> u64 {
        self.declarations.len()
    }

    pub fn declaration(index: u64) -> Declaration& {
        *self.declarations.get(index).unwrap()
    }

    pub fn for_symbol(symbol: SymbolId) -> Option<Declaration&> {
        for declaration in self.declarations {
            if declaration.symbol == symbol {
                return Option<Declaration&>.Some(declaration);
            }
        }

        Option<Declaration&>.None
    }

    pub fn intrinsic(name: str) -> Option<TypeId> {
        self.session.intrinsic_type(name)
    }
}

impl Drop for ResolutionContext {
    pub fn drop() {
        self.declarations.drop();
        self.callable_scopes.drop();
        self.constants.drop();
        self.alias_stack.drop();
        self.constant_stack.drop();

        for captures in self.closure_captures.values() {
            captures.drop();
        }

        self.closure_captures.drop();
        self.warnings.drop();
        self.scopes.drop();
    }
}
