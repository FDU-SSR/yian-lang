from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.resolution.types import resolve_type;
from yianc.analysis.resolution.declarations import collect_generics, has_attr;
from yianc.analysis.resolution.definitions import parameters, annotations;
from yianc.analysis.definition.registry import Procedure, DefinitionKind;
from yianc.analysis.symbol.model import Symbol, SymbolKind;
from yianc.analysis.ty.model import DefinitionHeader, NominalKind, DefinitionBody, CallableDefinition;
from yianc.analysis.ty.impl_registry import ImplRecord, ImplCondition;
from yianc.analysis.ty.validation import contains_ffi;
from yianc.common.ids import UnitId, ScopeId, TypeId, DefId, NameId, SymbolId;
from yianc.common.location import SourceSpan;
from yianc.frontend.ast.node import Item, MethodDecl, Block;
from yianc.frontend.ast.atoms import AttrKind;
from yianc.diagnostics.model import DiagnosticCode, AnalysisError, AnalysisErrorKind, AnalysisStage;
from std.collections.hash_map import HashMap;
from std.core.iter import Iterator, IntoIterator;

fn drop_conditions(conditions: Vec<ImplCondition>&) {
    for condition in *conditions {
        condition.drop();
    }

    conditions.drop();
}

fn bind_self(ctx: ResolutionContext&, unit: UnitId, scope: ScopeId, type_id: TypeId) -> Result<(), AnalysisError> {
    let name = ctx.session.names.intern("Self");
    let symbol = ctx.session.symbols.add(Symbol(name, SymbolKind.Type, type_id, unit, Option<SourceSpan>.None,
        false, false, false, Option<SymbolId>.None, Option<DefId>.None));
    ctx.session.symbols.bind(scope, name, symbol)?;
    Result<(), AnalysisError>.Ok(())
}

pub fn resolve_method(ctx: ResolutionContext&, unit: UnitId, parent: ScopeId, receiver: TypeId, previous: Vec<TypeId>&, syntax: MethodDecl&, body: Option<Block&>, trait_member: bool) -> Result<TypeId, AnalysisError> {
    let seen = Vec<AttrKind>.new();
    defer seen.drop();

    for attr in syntax.data.attrs {
        for previous in seen {
            if *previous == attr.data.kind {
                return Result<TypeId, AnalysisError>.Err(ctx.error(unit, attr.span, DiagnosticCode.Duplicate, "duplicate method modifier"));
            }
        }

        seen.push(attr.data.kind);
    }

    if has_attr(&syntax.data.attrs, AttrKind.PubFfi) && (!has_attr(&syntax.data.attrs, AttrKind.Ffi) || has_attr(&syntax.data.attrs, AttrKind.Pub)) {
        return Result<TypeId, AnalysisError>.Err(ctx.error(unit, syntax.span, DiagnosticCode.Access, "pub(ffi) requires an ffi method and excludes pub"));
    }

    if body.is_none() && has_attr(&syntax.data.attrs, AttrKind.Ffi) {
        return Result<TypeId, AnalysisError>.Err(ctx.error(unit, syntax.span, DiagnosticCode.Access, "ffi method requires a body"));
    }

    let scope = ctx.session.symbols.create_scope(Option<ScopeId>.Some(parent))?;
    bind_self(ctx, unit, scope, receiver)?;
    let own_generics = collect_generics(ctx, unit, scope, &syntax.data.generics)?;
    defer own_generics.drop();
    annotations(ctx, unit, scope, &syntax.data.generics, false)?;
    let generics = previous.clone();
    let accepted = false;
    defer {
        if !accepted {
            generics.drop();
        }
    };

    for generic in own_generics {
        generics.push(*generic);
    }

    let name = ctx.session.names.intern(syntax.data.name.data.name.as_str());
    let name_span = ctx.span(unit, syntax.span);

    if (has_attr(&syntax.data.attrs, AttrKind.Ffi) || has_attr(&syntax.data.attrs, AttrKind.PubFfi)) && !ctx.session.unit(unit).unwrap().allows_ffi {
        return Result<TypeId, AnalysisError>.Err(ctx.error(unit, syntax.span, DiagnosticCode.Access, "FFI method requires permission"));
    }

    let definition = ctx.session.types.register(DefinitionHeader(NominalKind.Method, name, name_span, unit), generics);
    accepted = true;
    ctx.callable_scopes.insert(definition, scope);
    let args = Vec<TypeId>.new();
    defer args.drop();
    let record = *ctx.session.types.definition(definition).unwrap();
    let index = 0u64;

    while index < record.generic_count() {
        args.push(*record.generic(index).unwrap());
        index += 1;
    }

    let type_id = ctx.session.types.instance(definition, &args)?;
    let result = match &syntax.data.ret_type {
        Some(value) => resolve_type(ctx, unit, scope, *value)?,
        None => ctx.primitives.void,
    };
    let params = parameters(ctx, unit, scope, &syntax.data.params)?;

    if has_attr(&syntax.data.attrs, AttrKind.Pub) {
        let exposed = contains_ffi(&ctx.session.types, result, false);

        for parameter in params {
            if contains_ffi(&ctx.session.types, parameter.type_id, false) {
                exposed = true;
            }
        }

        if exposed {
            params.drop();
            return Result<TypeId, AnalysisError>.Err(ctx.error(unit, syntax.span, DiagnosticCode.Access, "public method cannot expose a C ABI type"));
        }
    }

    ctx.session.types.finish_definition(definition, DefinitionBody.Method(CallableDefinition(params, result, Option<TypeId>.Some(receiver),
        has_attr(&syntax.data.attrs, AttrKind.Static), body.is_none(), has_attr(&syntax.data.attrs, AttrKind.Ffi), false, has_attr(&syntax.data.attrs, AttrKind.PubFfi), trait_member || has_attr(&syntax.data.attrs, AttrKind.Pub), previous.len())))?;

    match body {
        Some(value) => {
            ctx.session.definitions.register(Procedure(definition, type_id, unit, value, DefinitionKind.Method))?;
        },
        None => {},
    }

    Result<TypeId, AnalysisError>.Ok(type_id)
}

pub fn resolve_trait(ctx: ResolutionContext&, index: u64) -> Result<(), AnalysisError> {
    let declaration = ctx.declaration(index);
    let definition = *declaration.definition.unwrap();
    let trait_id = ctx.session.symbols.get(declaration.symbol).unwrap().type_id;
    let receiver = ctx.session.types.self_type(trait_id);
    let generics = Vec<TypeId>.new();
    defer generics.drop();
    let record = *ctx.session.types.definition(definition).unwrap();
    let generic_index = 0u64;

    while generic_index < record.generic_count() {
        generics.push(*record.generic(generic_index).unwrap());
        generic_index += 1;
    }

    generics.push(receiver);

    let methods = HashMap<NameId, TypeId>.new();
    let transferred = false;
    defer {
        if !transferred {
            methods.drop();
        }
    };

    match &declaration.item.data {
        TraitDef(_, _, _, items) => {
            for member in *items {
                let id = match member {
                    Declaration(value) => resolve_method(ctx, declaration.unit, declaration.scope, receiver, &generics, *value, Option<Block&>.None, true)?,
                    Definition(value) => resolve_method(ctx, declaration.unit, declaration.scope, receiver, &generics, value.data.decl, Option<Block&>.Some(value.data.body), true)?,
                };
                let nominal = match ctx.session.types.require(id)? {
                    Nominal(value, _) => *value,
                    _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("method has invalid identity")),
                };
                let name = ctx.session.types.definition(nominal).unwrap().header().name;

                if methods.contains(&name) {
                    return Result<(), AnalysisError>.Err(ctx.error(declaration.unit, declaration.item.span, DiagnosticCode.Duplicate, "duplicate trait method"));
                }

                methods.insert(name, id);
            }
        },
        _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("invalid trait syntax")),
    }

    transferred = true;
    ctx.session.types.finish_definition(definition, DefinitionBody.Trait(methods))
}

pub fn resolve_impls(ctx: ResolutionContext&) -> Result<(), AnalysisError> {
    let index = 0u64;

    while index < ctx.session.len() {
        let unit = UnitId(index);
        let root = ctx.session.unit(unit).unwrap().prepared.tree.unwrap().root;

        for item in root.data.items {
            resolve_impl(ctx, unit, *item)?;
        }

        index += 1;
    }

    Result<(), AnalysisError>.Ok(())
}

fn resolve_impl(ctx: ResolutionContext&, unit: UnitId, item: Item&) -> Result<(), AnalysisError> {
    match &item.data {
        Impl(generics, target, trait_type, items, conditions) => {
            let scope = ctx.session.symbols.create_scope(Option<ScopeId>.Some(ctx.scopes[unit.index]))?;
            let generic_ids = collect_generics(ctx, unit, scope, generics)?;
            let methods = HashMap<NameId, TypeId>.new();
            let obligations = Vec<ImplCondition>.new();
            let accepted = false;
            defer {
                if !accepted {
                    generic_ids.drop();
                    methods.drop();
                    drop_conditions(&obligations);
                }
            };
            annotations(ctx, unit, scope, generics, false)?;
            let receiver = resolve_type(ctx, unit, scope, *target)?;
            bind_self(ctx, unit, scope, receiver)?;
            let trait_id = match trait_type {
                Some(value) => Option<TypeId>.Some(resolve_type(ctx, unit, scope, *value)?),
                None => Option<TypeId>.None,
            };

            for condition in *conditions {
                let name = ctx.session.names.intern(condition.data.name.data.name.as_str());
                let symbol = match ctx.session.symbols.lookup(scope, name) {
                    Some(value) => value,
                    None => return Result<(), AnalysisError>.Err(ctx.error(unit, condition.span, DiagnosticCode.Undefined, "unknown impl condition parameter")),
                };
                let traits = Vec<TypeId>.new();
                let moved = false;
                defer {
                    if !moved {
                        traits.drop();
                    }
                };

                for syntax in condition.data.traits {
                    traits.push(resolve_type(ctx, unit, scope, *syntax)?);
                }

                moved = true;
                obligations.push(ImplCondition(ctx.session.symbols.get(symbol).unwrap().type_id, traits));
            }

            for method in *items {
                let name = ctx.session.names.intern(method.data.decl.data.name.data.name.as_str());

                if methods.contains(&name) {
                    return Result<(), AnalysisError>.Err(ctx.error(unit, method.span, DiagnosticCode.Duplicate, "duplicate impl method"));
                }

                methods.insert(name, resolve_method(ctx, unit, scope, receiver, &generic_ids, method.data.decl, Option<Block&>.Some(method.data.body), trait_id.is_some())?);
            }

            accepted = true;
            ctx.session.impls.register(ImplRecord(ctx.span(unit, item.span), generic_ids, receiver, trait_id, obligations, methods, false));
        },
        _ => {},
    }
    Result<(), AnalysisError>.Ok(())
}
