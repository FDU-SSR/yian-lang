from yianc.common.ids import SourceId;
from yianc.common.location import SourceSpan;
from yianc.analysis.session.session import AnalysisSession, SourcePermissions;
from yianc.config import FrontendPhase;
from yianc.diagnostics.model import DiagnosticCode, AnalysisError, AnalysisStage;
from yianc.diagnostics.render import detach;
from yianc.frontend.prepare import PreparedFile, prepare_file, PreparationError, PreparationStage;
from yianc.frontend.source import collect_sources, SourceDocument;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from std.core.drop import Drop;
from std.core.convert import From;
from std.core.iter import Iterator, IntoIterator;

// Observers borrow the partial session synchronously; preparation never retains them.
pub trait PreparationObserver {
    fn begin(pass_id: str) -> u64 { 0u64 }
    fn finish(pass_id: str, token: u64, success: bool) {}
    fn stage_complete(stage: PreparationStage, session: AnalysisSession&) -> Result<(), AnalysisError>;
}

fn begin_timing(observer: Option<PreparationObserver&>, pass_id: str) -> u64 {
    match observer { Some(value) => value.begin(pass_id), None => 0u64 }
}

fn finish_timing(observer: Option<PreparationObserver&>, pass_id: str, token: u64, success: bool) {
    match observer { Some(value) => value.finish(pass_id, token, success), None => {}, }
}

impl AnalysisSession {
    // Failure releases the partial session after its diagnostic locations are detached.
    static pub fn prepare(inputs: Vec<String>&, trust: SourceTrust, packages: Option<PackageMap>, raw_pointers: bool, allow_ffi: bool) -> Result<Self, AnalysisError> {
        Self.prepare_observed(inputs, trust, packages, raw_pointers, allow_ffi, Option<PreparationObserver&>.None)
    }

    static pub fn prepare_observed(inputs: Vec<String>&, trust: SourceTrust, packages: Option<PackageMap>, raw_pointers: bool, allow_ffi: bool, observer: Option<PreparationObserver&>) -> Result<Self, AnalysisError> {
        let session = Self.new(trust, packages, raw_pointers);
        let transferred = false;
        defer {
            if !transferred {
                session.drop();
            }
        };

        let collect_token = begin_timing(observer, "input.collect_sources");
        let paths_result = collect_sources(inputs);
        match &paths_result {
            Ok(_) => finish_timing(observer, "input.collect_sources", collect_token, true),
            Err(_) => finish_timing(observer, "input.collect_sources", collect_token, false),
        }
        let paths = match paths_result {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                return Result<Self, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.Source, Option<SourceSpan>.None, error.msg()));
            },
        };

        defer release_paths(&paths);

        for path in paths {
            let token = begin_timing(observer, "input.read_sources");
            let result = session.load_source(path.as_str());
            match &result {
                Ok(_) => finish_timing(observer, "input.read_sources", token, true),
                Err(_) => finish_timing(observer, "input.read_sources", token, false),
            }
            result?;
        }
        session.finish_loaded_sources(allow_ffi, observer)?;

        transferred = true;
        Result<Self, AnalysisError>.Ok(session)
    }

    // Source order is supplied by the caller; each buffer is copied into this session.
    static pub fn prepare_documents(documents: Vec<SourceDocument>&, trust: SourceTrust,
        packages: Option<PackageMap>, raw_pointers: bool, allow_ffi: bool,
        observer: Option<PreparationObserver&>) -> Result<Self, AnalysisError> {
        let session = Self.new(trust, packages, raw_pointers);
        let transferred = false;
        defer { if !transferred { session.drop(); } };

        for document in *documents {
            let token = begin_timing(observer, "input.read_sources");
            let result = session.load_text(document.path.as_str(), document.text.as_str());
            match &result {
                Ok(_) => finish_timing(observer, "input.read_sources", token, true),
                Err(_) => finish_timing(observer, "input.read_sources", token, false),
            }
            result?;
        }
        session.finish_loaded_sources(allow_ffi, observer)?;
        transferred = true;
        Result<Self, AnalysisError>.Ok(session)
    }

    fn finish_loaded_sources(allow_ffi: bool, observer: Option<PreparationObserver&>) -> Result<(), AnalysisError> {
        // Complete each frontend stage across the ordered input set before advancing to the next.
        let index = 0u64;
        while index < self.sources.len() {
            let source = SourceId(index);
            let lex_token = begin_timing(observer, "frontend.lex");
            let prepared_result = self.prepare_source(source);
            match &prepared_result {
                Ok(_) => finish_timing(observer, "frontend.lex", lex_token, true),
                Err(_) => finish_timing(observer, "frontend.lex", lex_token, false),
            }
            let prepared = match prepared_result {
                Ok(value) => value,
                Err(error) => {
                    match detach(&error.diagnostic, &self.sources) {
                        Ok(_) => {},
                        Err(problem) => { error.drop(); return Result<(), AnalysisError>.Err(problem); },
                    }
                    return Result<(), AnalysisError>.Err(error);
                },
            };
            let file = self.sources.file(source.index);
            let classify_token = begin_timing(observer, "input.classify_sources");
            let permissions = self.classify(file.canonical_path(), allow_ffi);
            finish_timing(observer, "input.classify_sources", classify_token, true);
            self.accept(prepared, permissions);
            index += 1u64;
        }
        match observer { Some(value) => { value.stage_complete(PreparationStage.Lex, self)?; }, None => {}, }

        for unit in self.units {
            let token = begin_timing(observer, "frontend.parse");
            let result = unit.prepared.parse();
            let success = match &result { Ok(_) => true, Err(_) => false };
            let finished = self.finish_preparation(result, unit.source);
            finish_timing(observer, "frontend.parse", token, success);
            finished?;
        }
        match observer { Some(value) => { value.stage_complete(PreparationStage.Parse, self)?; }, None => {}, }

        for unit in self.units {
            let file = self.sources.file(unit.source.index);
            let token = begin_timing(observer, "frontend.desugar");
            let result = unit.prepared.desugar(file.path());
            let success = match &result { Ok(_) => true, Err(_) => false };
            let finished = self.finish_preparation(result, unit.source);
            finish_timing(observer, "frontend.desugar", token, success);
            finished?;
        }
        match observer { Some(value) => { value.stage_complete(PreparationStage.Desugar, self)?; }, None => {}, }
        Result<(), AnalysisError>.Ok(())
    }

    fn load_source(path: str) -> Result<SourceId, AnalysisError> {
        match self.sources.load(path) {
            Ok(id) => Result<SourceId, AnalysisError>.Ok(SourceId(id)),
            Err(error) => {
                defer error.drop();
                let contextual = error.with_path(path);
                defer contextual.drop();
                Result<SourceId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.Source, Option<SourceSpan>.None, contextual.msg()))
            },
        }
    }

    fn load_text(path: str, text: str) -> Result<SourceId, AnalysisError> {
        match self.sources.load_text(path, text) {
            Ok(id) => Result<SourceId, AnalysisError>.Ok(SourceId(id)),
            Err(error) => {
                defer error.drop();
                let contextual = error.with_path(path);
                defer contextual.drop();
                Result<SourceId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.Source,
                    Option<SourceSpan>.None, contextual.msg()))
            },
        }
    }

    fn prepare_source(source: SourceId) -> Result<PreparedFile, AnalysisError> {
        let file = self.sources.file(source.index);

        match prepare_file(source, file.path(), file.text(), FrontendPhase.Tokens) {
            Ok(value) => Result<PreparedFile, AnalysisError>.Ok(value),
            Err(error) => {
                defer error.drop();
                let stage = match error.stage { Lex => AnalysisStage.Lex, Parse => AnalysisStage.Parse, Desugar => AnalysisStage.Desugar, };
                Result<PreparedFile, AnalysisError>.Err(AnalysisError.user(error.code,
                    Option<SourceSpan>.Some(SourceSpan(source, error.span)), error.message.as_str()).with_stage(stage))
            },
        }
    }

    fn finish_preparation(result: Result<(), PreparationError>, source: SourceId) -> Result<(), AnalysisError> {
        match result {
            Ok(_) => Result<(), AnalysisError>.Ok(()),
            Err(error) => {
                defer error.drop();
                let stage = match error.stage { Lex => AnalysisStage.Lex, Parse => AnalysisStage.Parse, Desugar => AnalysisStage.Desugar, };
                let problem = AnalysisError.user(error.code, Option<SourceSpan>.Some(SourceSpan(source, error.span)),
                    error.message.as_str()).with_stage(stage);
                match detach(&problem.diagnostic, &self.sources) {
                    Ok(_) => Result<(), AnalysisError>.Err(problem),
                    Err(detach_error) => { problem.drop(); Result<(), AnalysisError>.Err(detach_error) },
                }
            },
        }
    }

    // Permission precedence is independent of the spelling of the input path.
    fn classify(canonical: str, allow_ffi: bool) -> SourcePermissions {
        let stdlib = self.trust.is_stdlib(canonical);
        let restricted = self.trust.allows_restricted(canonical);
        let ffi = stdlib || allow_ffi;

        match &self.packages {
            None => {},
            Some(packages) => match packages.package_of(canonical) {
                None => {},
                Some(package) => {
                    ffi = package.allows_ffi;
                },
            },
        }

        SourcePermissions(stdlib, restricted, ffi)
    }
}

fn release_paths(paths: Vec<String>&) {
    for path in *paths {
        path.drop();
    }

    paths.drop();
}
