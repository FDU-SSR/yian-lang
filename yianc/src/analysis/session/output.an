from yianc.common.ids import DefId, TypeId, SymbolId, HirId, UnitId, NameId;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.driver.trace import CompilerTrace;
from yianc.diagnostics.model import Diagnostic, Severity, AnalysisStage;
from std.core.iter import Iterator, IntoIterator;

pub struct AnalysisOptions {
    pub require_entry: bool,
    pub entry_optional: bool,
    pub recover: bool,
    pub verify_hir: bool,
    // The caller keeps this provider alive for the entire synchronous analysis call.
    pub sizes: Option<TypeSizeProvider&>,
    pub trace: Option<CompilerTrace&>,
}

impl AnalysisOptions {
    static pub fn new() -> Self {
        Self(false, true, false, true, Option<TypeSizeProvider&>.None, Option<CompilerTrace&>.None)
    }
}

// HIR and symbols belong to the session; only the lists belong to this result.
pub struct AnalyzedProcedure {
    pub definition: DefId,
    pub type_id: TypeId,
    pub parameters: Vec<SymbolId>,
    pub root: HirId,
    pub unit: UnitId,
    pub captures: Vec<(NameId, SymbolId)>,
}

impl Drop for AnalyzedProcedure {
    pub fn drop() {
        self.parameters.drop();
        self.captures.drop();
    }
}

pub struct AnalysisOutput {
    pub checked: Vec<DefId>,
    pub procedures: Vec<AnalyzedProcedure>,
    pub entry: Option<TypeId>,
    pub warnings: Vec<Diagnostic>,
}

impl AnalysisOutput {
    static pub fn new() -> Self {
        Self(Vec<DefId>.new(), Vec<AnalyzedProcedure>.new(), Option<TypeId>.None, Vec<Diagnostic>.new())
    }
}

impl Drop for AnalysisOutput {
    pub fn drop() {
        for procedure in self.procedures {
            procedure.drop();
        }

        for warning in self.warnings {
            warning.drop();
        }

        self.checked.drop();
        self.procedures.drop();
        self.warnings.drop();
    }
}

// Diagnostics remain renderable with the owning session; only a clean run exports HIR.
pub struct AnalysisReport {
    pub output: Option<AnalysisOutput>,
    pub diagnostics: Vec<Diagnostic>,
    pub failed_stage: Option<AnalysisStage>,
}

impl AnalysisReport {
    static pub fn new() -> Self { Self(Option<AnalysisOutput>.None, Vec<Diagnostic>.new(), Option<AnalysisStage>.None) }

    pub fn ok() -> bool {
        for diagnostic in self.diagnostics { if diagnostic.severity == Severity.Error { return false; } }
        true
    }
}

impl Drop for AnalysisReport {
    pub fn drop() {
        match &self.output { Some(value) => value.drop(), None => {}, }
        for diagnostic in self.diagnostics { diagnostic.drop(); }
        self.diagnostics.drop();
    }
}
