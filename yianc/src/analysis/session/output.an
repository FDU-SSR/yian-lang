from yianc.common.ids import DefId, TypeId, SymbolId, HirId, UnitId, NameId;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.telemetry.trace import CompilerTrace;
from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation, UserDiagnostic;
from std.core.convert import From;
from std.core.iter import Iterator, IntoIterator;

pub struct AnalysisOptions {
    pub require_entry: bool,
    pub entry_optional: bool,
    pub verify_hir: bool,
    // The caller keeps this provider alive for the entire synchronous analysis call.
    pub sizes: Option<TypeSizeProvider&>,
    pub trace: Option<CompilerTrace&>,
}

impl AnalysisOptions {
    static pub fn new() -> Self {
        Self(false, true, true, Option<TypeSizeProvider&>.None, Option<CompilerTrace&>.None)
    }
}

// HIR and symbols belong to the session; only the lists belong to this result.
pub struct AnalyzedProcedure {
    pub definition: DefId,
    pub type_id: TypeId,
    pub parameters: Vec<SymbolId>,
    pub root: HirId,
    pub unit: UnitId,
    pub captures: Vec<(NameId, SymbolId)>,
}

impl Drop for AnalyzedProcedure {
    pub fn drop() {
        self.parameters.drop();
        self.captures.drop();
    }
}

pub struct AnalysisOutput {
    pub checked: Vec<DefId>,
    pub procedures: Vec<AnalyzedProcedure>,
    pub entry: Option<TypeId>,
}

impl AnalysisOutput {
    static pub fn new() -> Self {
        Self(Vec<DefId>.new(), Vec<AnalyzedProcedure>.new(), Option<TypeId>.None)
    }
}

impl Drop for AnalysisOutput {
    pub fn drop() {
        for procedure in self.procedures {
            procedure.drop();
        }

        self.checked.drop();
        self.procedures.drop();
    }
}

pub struct AnalysisWarning {
    pub code: DiagnosticCode,
    pub source: SourceSpan,
    pub message: String,
}

impl UserDiagnostic for AnalysisWarning {
    pub fn code() -> DiagnosticCode { self.code }
    pub fn location() -> DiagnosticLocation { DiagnosticLocation.Source(self.source) }
    pub fn message() -> String { String.from(&self.message.as_str()) }
}

impl Drop for AnalysisWarning {
    pub fn drop() { self.message.drop(); }
}
