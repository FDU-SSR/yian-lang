from yianc.common.ids import UnitId, TypeId;
from yianc.analysis.definition.registry import DefinitionRegistry;
from yianc.analysis.definition.worklist import DefinitionWorklist;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.names import NameInterner;
from yianc.analysis.symbol.scope import SymbolStore;
from yianc.analysis.symbol.model import SymbolKind;
from yianc.analysis.ty.impl_registry import ImplRegistry;
from yianc.analysis.ty.store import TypeStore;
from yianc.diagnostics.model import AnalysisError;
from yianc.frontend.unit import UnitData, UnitTable;
from yianc.frontend.source import SourceFile, SourceMap;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from std.core.iter import Iterator, IntoIterator;

pub enum AnalysisPhase {
    Prepared,
    Analyzing,
    Complete,
    Failed,
}

struct SourcePermissions {
    is_stdlib: bool,
    allows_restricted: bool,
    allows_ffi: bool,
}

// The middle-end owner receives the completed frontend table and keeps all semantic data.
pub struct AnalysisSession {
    units: UnitTable,
    trust: SourceTrust,
    packages: Option<PackageMap>,
    permissions: Vec<SourcePermissions>,
    permissions_ready: bool,
    pub names: NameInterner,
    pub types: TypeStore,
    pub symbols: SymbolStore,
    pub hir: HirStore,
    pub definitions: DefinitionRegistry,
    pub worklist: DefinitionWorklist,
    pub impls: ImplRegistry,
    pub raw_pointers: bool,
    phase: AnalysisPhase,
}

impl AnalysisSession {
    static pub fn new(units: UnitTable, raw_pointers: bool, trust: SourceTrust,
        packages: Option<PackageMap>) -> Self {
        Self(units, trust, packages, Vec<SourcePermissions>.new(), false,
            NameInterner.new(), TypeStore.new(), SymbolStore.new(), HirStore.new(),
            DefinitionRegistry.new(), DefinitionWorklist.new(), ImplRegistry.new(),
            raw_pointers, AnalysisPhase.Prepared)
    }

    pub fn unit(id: UnitId) -> Option<UnitData&> {
        self.units.get(id)
    }

    pub fn source(id: UnitId) -> SourceFile& {
        self.units.file(id)
    }

    pub fn len() -> u64 {
        self.units.len()
    }

    pub fn package_map() -> Option<PackageMap&> {
        match &self.packages {
            Some(value) => Option<PackageMap&>.Some(value),
            None => Option<PackageMap&>.None,
        }
    }

    pub fn stdlib_root() -> str {
        self.trust.stdlib_root()
    }

    // Permissions belong to the analysis session; the completed table owns sources, tokens and ASTs.
    pub fn classify_sources() -> Result<(), AnalysisError> {
        if self.permissions_ready { @panic("source permissions have already been classified"); }
        if self.phase != AnalysisPhase.Analyzing { @panic("analysis session is not analyzing"); }
        self.permissions_ready = true;
        let count = self.units.len();
        let index = 0u64;
        while index < count {
            let unit = UnitId(index);
            let canonical = self.units.file(unit).path();
            let stdlib = self.trust.is_stdlib(canonical);
            let restricted = self.trust.allows_restricted(canonical);
            let ffi = stdlib;
            match &self.packages {
                Some(packages) => match packages.package_of(canonical) {
                    Some(package) => ffi = package.allows_ffi,
                    None => {},
                },
                None => {},
            }
            self.permissions.push(SourcePermissions(stdlib, restricted, ffi));
            index += 1;
        }
        Result<(), AnalysisError>.Ok(())
    }

    fn permission(id: UnitId) -> SourcePermissions {
        match self.permissions.as_slice().get(id.index) {
            Some(value) => *value,
            None => @panic("source permissions are unavailable"),
        }
    }

    pub fn is_stdlib(id: UnitId) -> bool { self.permission(id).is_stdlib }
    pub fn allows_restricted(id: UnitId) -> bool { self.permission(id).allows_restricted }
    pub fn allows_ffi(id: UnitId) -> bool { self.permission(id).allows_ffi }

    // Intrinsic identity lives in the session, so later passes need no resolver.
    pub fn intrinsic_type(name: str) -> Option<TypeId> {
        let index = 0u64;
        while index < self.symbols.symbol_count() {
            let symbol = self.symbols.symbol_at(index).unwrap();
            index += 1;
            if symbol.kind == SymbolKind.Type && self.is_stdlib(symbol.unit) && self.names.text(symbol.name) == name {
                match self.types.get(symbol.type_id) {
                    Some(Nominal(_, _)) => return Option<TypeId>.Some(symbol.type_id),
                    _ => {},
                }
            }
        }
        Option<TypeId>.None
    }

    pub fn begin_analysis() {
        if self.phase != AnalysisPhase.Prepared {
            @panic("analysis session cannot be analyzed twice");
        }
        self.phase = AnalysisPhase.Analyzing;
    }

    pub fn complete_analysis(ok: bool) {
        self.phase = if ok { AnalysisPhase.Complete } else { AnalysisPhase.Failed };
    }
}

impl Drop for AnalysisSession {
    pub fn drop() {
        self.permissions.drop();
        match &self.packages {
            Some(packages) => packages.drop(),
            None => {},
        }
        self.trust.drop();
        self.worklist.drop();
        self.definitions.drop();
        self.impls.drop();
        self.hir.drop();
        self.symbols.drop();
        self.types.drop();
        self.names.drop();
        self.units.drop();
    }
}
