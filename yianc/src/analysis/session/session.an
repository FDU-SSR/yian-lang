from yianc.common.ids import SourceId, UnitId, TypeId;
from yianc.analysis.definition.registry import DefinitionRegistry;
from yianc.analysis.definition.worklist import DefinitionWorklist;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.names import NameInterner;
from yianc.analysis.symbol.scope import SymbolStore;
from yianc.analysis.symbol.model import SymbolKind;
from yianc.analysis.ty.impl_registry import ImplRegistry;
from yianc.analysis.ty.store import TypeStore;
from yianc.diagnostics.model import AnalysisError, DiagnosticSink;
from yianc.frontend.session import CompilationUnit, FrontendSession;
from yianc.frontend.source import SourceFile, SourceManager;
from yianc.package.model import PackageMap;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;

pub enum AnalysisPhase {
    Prepared,
    Analyzing,
    Complete,
    Failed,
}

// The middle-end owner composes the completed frontend owner and keeps all semantic data.
pub struct AnalysisSession {
    frontend: FrontendSession,
    pub names: NameInterner,
    pub types: TypeStore,
    pub symbols: SymbolStore,
    pub hir: HirStore,
    pub definitions: DefinitionRegistry,
    pub worklist: DefinitionWorklist,
    pub impls: ImplRegistry,
    pub diagnostics: DiagnosticSink,
    pub raw_pointers: bool,
    phase: AnalysisPhase,
}

impl AnalysisSession {
    static pub fn new(frontend: FrontendSession, raw_pointers: bool) -> Self {
        Self(frontend, NameInterner.new(), TypeStore.new(), SymbolStore.new(), HirStore.new(),
            DefinitionRegistry.new(), DefinitionWorklist.new(), ImplRegistry.new(), DiagnosticSink.new(),
            raw_pointers, AnalysisPhase.Prepared)
    }

    pub fn frontend() -> FrontendSession& {
        &self.frontend
    }

    pub fn unit(id: UnitId) -> Option<CompilationUnit&> {
        self.frontend.unit(id)
    }

    pub fn source(id: SourceId) -> Option<SourceFile&> {
        self.frontend.source(id)
    }

    pub fn len() -> u64 {
        self.frontend.len()
    }

    pub fn source_manager() -> SourceManager& {
        self.frontend.source_manager()
    }

    pub fn package_map() -> Option<PackageMap&> {
        self.frontend.package_map()
    }

    pub fn stdlib_root() -> str {
        self.frontend.stdlib_root()
    }

    // Intrinsic identity lives in the session, so later passes need no resolver.
    pub fn intrinsic_type(name: str) -> Option<TypeId> {
        let index = 0u64;
        while index < self.symbols.symbol_count() {
            let symbol = self.symbols.symbol_at(index).unwrap();
            index += 1;
            if symbol.kind == SymbolKind.Type && self.unit(symbol.unit).unwrap().is_stdlib && self.names.text(symbol.name) == name {
                match self.types.get(symbol.type_id) {
                    Some(Nominal(_, _)) => return Option<TypeId>.Some(symbol.type_id),
                    _ => {},
                }
            }
        }
        Option<TypeId>.None
    }

    pub fn begin_analysis() -> Result<(), AnalysisError> {
        if self.phase != AnalysisPhase.Prepared {
            return Result<(), AnalysisError>.Err(AnalysisError.internal("analysis session cannot be analyzed twice"));
        }
        self.phase = AnalysisPhase.Analyzing;
        Result<(), AnalysisError>.Ok(())
    }

    pub fn complete_analysis(ok: bool) {
        self.phase = if ok { AnalysisPhase.Complete } else { AnalysisPhase.Failed };
    }
}

impl Drop for AnalysisSession {
    pub fn drop() {
        self.diagnostics.drop();
        self.worklist.drop();
        self.definitions.drop();
        self.impls.drop();
        self.hir.drop();
        self.symbols.drop();
        self.types.drop();
        self.names.drop();
        self.frontend.drop();
    }
}
