from yianc.analysis.editor import EditorLocation;
from yianc.frontend.source import Position;
from std.core.drop import Drop;
from std.core.option import Option;
from std.core.string import String;
from std.core.vec import Vec;

from yianc.analysis.editor.availability import QueryCompleteness;

pub struct CallFrame {
    pub open_token: u64,
    pub active_parameter: u64,
    pub brackets: u64,
    pub braces: u64,
    pub angles: u64,
}

pub enum CompletionContext {
    Value,
    Type,
    Member,
    ImportPath,
    ImportName,
}

pub struct EditorSignatureHelp {
    pub label: String,
    pub parameter_labels: Vec<String>,
    pub active_parameter: u64,
}

impl Drop for EditorSignatureHelp {
    pub fn drop() {
        self.label.drop();
        for label in self.parameter_labels { label.drop(); }
        self.parameter_labels.drop();
    }
}

pub enum EditorCompletionKind {
    Function, Method, Field, Variant, Struct, Enum, Trait, Alias,
    Constant, Variable, Parameter, TypeParameter, Module, Package, Primitive, Text,
}

pub struct EditorCompletionItem {
    pub label: String,
    pub kind: EditorCompletionKind,
    pub detail: Option<String>,
    pub parameter_labels: Vec<String>,
}

impl Drop for EditorCompletionItem {
    pub fn drop() {
        self.label.drop();
        match &self.detail { Some(value) => value.drop(), None => {}, }
        for parameter in self.parameter_labels { parameter.drop(); }
        self.parameter_labels.drop();
    }
}

pub struct EditorCompletionResult {
    pub items: Vec<EditorCompletionItem>,
    pub replace: Option<EditorLocation>,
    pub completeness: QueryCompleteness,
}

impl Drop for EditorCompletionResult {
    pub fn drop() {
        for item in self.items { item.drop(); }
        self.items.drop();
        match &self.replace { Some(value) => value.drop(), None => {}, }
    }
}

pub struct CompletionPosition {
    pub prefix: String,
    pub replace: Option<EditorLocation>,
    pub context: CompletionContext,
    pub receiver_end: Option<Position>,
}

impl Drop for CompletionPosition {
    pub fn drop() {
        self.prefix.drop();
        match &self.replace { Some(value) => value.drop(), None => {}, }
    }
}
