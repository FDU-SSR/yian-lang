from yianc.common.ids import NameId, TypeId, SymbolId, UnitId, DefId;
from yianc.common.location import SourceSpan;
from std.core.drop import Drop;

pub enum SymbolKind {
    Type,
    Function,
    Variable,
    Parameter,
    Constant,
    Alias,
    Module,
}

pub struct Symbol {
    pub name: NameId,
    pub kind: SymbolKind,
    pub type_id: TypeId,
    pub unit: UnitId,
    pub span: Option<SourceSpan>,
    pub is_public: bool,
    pub is_static: bool,
    pub ffi_only: bool,
    pub const_origin: Option<SymbolId>,
    pub alias: Option<DefId>,
}
