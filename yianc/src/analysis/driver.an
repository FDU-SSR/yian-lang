from yianc.common.ids import UnitId;
from yianc.common.names import NameInterner;
from yianc.analysis.permissions import SourcePermissions;
from yianc.analysis.definition.registry import DefinitionRegistry;
from yianc.analysis.definition.worklist import DefinitionWorklist;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.ty.impl_registry import ImplRegistry;
from yianc.analysis.symbol.scope import SymbolSpace;
from yianc.analysis.session.output import AnalysisOptions, AnalysisOutput;
from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.resolution.declarations import collect_declarations;
from yianc.analysis.resolution.imports import resolve_imports;
from yianc.analysis.resolution.definitions import resolve_definitions;
from yianc.analysis.resolution.methods import resolve_impls;
from yianc.analysis.resolution.automatic import register_automatic;
from yianc.analysis.passes.restricted import check_restricted;
from yianc.analysis.passes.type_check import check_procedures;
from yianc.analysis.constant.definitions import evaluate_constants;
from yianc.analysis.ty.finalize import finalize_types;
from yianc.analysis.ty.impl_check import check_impls;
from yianc.analysis.ty.validation import validate_declarations;
from yianc.analysis.passes.definite_assignment import check_assignment;
from yianc.analysis.passes.coverage import check_coverage;
from yianc.analysis.passes.verify_hir import verify_hir;
from yianc.analysis.passes.address_storage import normalize_address_storage;
from yianc.analysis.passes.finalize_hir_types import finalize_hir_types;
from yianc.diagnostics.model import AnalysisError, AnalysisStage, DiagnosticReporter;
from yianc.frontend.unit import UnitTable;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from yianc.types.space import TypeSpace;
from yianc.telemetry.profile import ProfileKind;
from std.core.iter import Iterator, IntoIterator;

// The caller keeps the shared tables, package map, reporter and option services alive
// during analysis. The driver owns source trust, permissions and the analysis registries.
pub struct MiddleEndDriver {
    units: UnitTable&,
    packages: Option<PackageMap&>,
    names: NameInterner&,
    types: TypeSpace&,
    symbols: SymbolSpace&,
    hir: HirStore&,
    trust: SourceTrust,
    raw_pointers: bool,
    pub permissions: Vec<SourcePermissions>,
    definitions: DefinitionRegistry,
    worklist: DefinitionWorklist,
    impls: ImplRegistry,
    options: AnalysisOptions,
    reporter: DiagnosticReporter&,
    attempted: bool,
}

fn start_stage(options: AnalysisOptions&, pass_id: str, stage: AnalysisStage) {
    match options.trace {
        Some(trace) => trace.start_pass(pass_id, stage.name(), pass_id, ProfileKind.Pass),
        None => {},
    }
}

fn finish_stage(options: AnalysisOptions&, pass_id: str, success: bool) {
    match options.trace {
        Some(trace) => if success { trace.finish(pass_id); } else { trace.fail(pass_id); },
        None => {},
    }
}

fn at_stage(result: Result<(), AnalysisError>, pass_id: str, stage: AnalysisStage, options: AnalysisOptions&) -> Result<(), AnalysisError> {
    let success = match &result { Ok(_) => true, Err(_) => false };
    finish_stage(options, pass_id, success);
    match result { Ok(_) => Result<(), AnalysisError>.Ok(()), Err(problem) => Result<(), AnalysisError>.Err(problem.with_stage(stage)) }
}

impl MiddleEndDriver {
    static pub fn new(units: UnitTable&, packages: Option<PackageMap&>, names: NameInterner&,
        types: TypeSpace&, symbols: SymbolSpace&, hir: HirStore&, trust: SourceTrust,
        raw_pointers: bool, options: AnalysisOptions, reporter: DiagnosticReporter&) -> Self {
        Self(units, packages, names, types, symbols, hir, trust, raw_pointers,
            Vec<SourcePermissions>.new(), DefinitionRegistry.new(), DefinitionWorklist.new(),
            ImplRegistry.new(), options, reporter, false)
    }

    fn classify_sources() {
        let count = self.units.len();
        let index = 0u64;
        while index < count {
            let unit = UnitId(index);
            let canonical = self.units.file(unit).path();
            let stdlib = self.trust.is_stdlib(canonical);
            let restricted = self.trust.allows_restricted(canonical);
            let ffi = stdlib;
            match self.packages {
                Some(packages) => match packages.package_of(canonical) {
                    Some(package) => ffi = package.allows_ffi,
                    None => {},
                },
                None => {},
            }
            self.permissions.push(SourcePermissions(stdlib, restricted, ffi));
            index += 1;
        }
    }

    // The pass sequence is the middle-end contract; the first error terminates it.
    pub fn run() -> Result<AnalysisOutput, AnalysisError> {
        if self.attempted {
            @panic("analysis session cannot be analyzed twice");
        }
        self.attempted = true;
        let options = self.options;
        let reporter = self.reporter;

        start_stage(&options, "analysis.classify_sources", AnalysisStage.Classify);
        self.classify_sources();
        finish_stage(&options, "analysis.classify_sources", true);
        start_stage(&options, "analysis.restricted", AnalysisStage.Restricted);
        at_stage(check_restricted(self.units, &self.permissions), "analysis.restricted", AnalysisStage.Restricted, &options)?;
        start_stage(&options, "analysis.context", AnalysisStage.Resolve);
        let context_result = ResolutionContext.new(self.units, self.packages, self.names, self.types,
            self.symbols, self.hir, self.trust.stdlib_root(), &self.permissions, &self.definitions,
            &self.worklist, &self.impls, self.raw_pointers, options.sizes,
            Option<DiagnosticReporter&>.Some(reporter));
        match &context_result {
            Ok(_) => finish_stage(&options, "analysis.context", true),
            Err(_) => finish_stage(&options, "analysis.context", false),
        }
        let context = context_result?;
        defer context.drop();
        start_stage(&options, "analysis.collect_declarations", AnalysisStage.Resolve);
        at_stage(collect_declarations(&context), "analysis.collect_declarations", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.resolve_imports", AnalysisStage.Resolve);
        at_stage(resolve_imports(&context), "analysis.resolve_imports", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.resolve_definitions", AnalysisStage.Resolve);
        at_stage(resolve_definitions(&context), "analysis.resolve_definitions", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.resolve_impls", AnalysisStage.Resolve);
        at_stage(resolve_impls(&context), "analysis.resolve_impls", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.register_automatic", AnalysisStage.Resolve);
        at_stage(register_automatic(&context), "analysis.register_automatic", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.evaluate_constants", AnalysisStage.Resolve);
        at_stage(evaluate_constants(&context), "analysis.evaluate_constants", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.finalize_types", AnalysisStage.Finalize);
        at_stage(finalize_types(&context), "analysis.finalize_types", AnalysisStage.Finalize, &options)?;
        start_stage(&options, "analysis.check_impls", AnalysisStage.Resolve);
        at_stage(check_impls(&context), "analysis.check_impls", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.validate_declarations", AnalysisStage.Resolve);
        at_stage(validate_declarations(&context), "analysis.validate_declarations", AnalysisStage.Resolve, &options)?;
        start_stage(&options, "analysis.check_procedures", AnalysisStage.TypeCheck);
        let checked = check_procedures(&context, &options);
        match &checked {
            Ok(_) => finish_stage(&options, "analysis.check_procedures", true),
            Err(_) => finish_stage(&options, "analysis.check_procedures", false),
        }
        let output = match checked {
            Ok(value) => value,
            Err(problem) => return Result<AnalysisOutput, AnalysisError>.Err(problem.with_stage(AnalysisStage.TypeCheck)),
        };
        let accepted_output = false;
        defer {
            if !accepted_output {
                output.drop();
            }
        };
        start_stage(&options, "analysis.normalize_address_storage", AnalysisStage.TypeCheck);
        let normalized = normalize_address_storage(&context, &output);
        match &normalized {
            Ok(_) => finish_stage(&options, "analysis.normalize_address_storage", true),
            Err(_) => finish_stage(&options, "analysis.normalize_address_storage", false),
        }
        match normalized {
            Ok(_) => {},
            Err(problem) => return Result<AnalysisOutput, AnalysisError>.Err(problem.with_stage(AnalysisStage.TypeCheck)),
        }
        start_stage(&options, "analysis.finalize_hir_types", AnalysisStage.TypeCheck);
        let finalized = finalize_hir_types(&context, &output);
        match &finalized {
            Ok(_) => finish_stage(&options, "analysis.finalize_hir_types", true),
            Err(_) => finish_stage(&options, "analysis.finalize_hir_types", false),
        }
        match finalized {
            Ok(_) => {},
            Err(problem) => return Result<AnalysisOutput, AnalysisError>.Err(problem.with_stage(AnalysisStage.TypeCheck)),
        }
        // A callee failure leaves a partial call graph. It is never exported to the backend.
        if options.verify_hir {
            start_stage(&options, "analysis.verify_hir", AnalysisStage.TypeCheck);
            at_stage(verify_hir(&context, &output), "analysis.verify_hir", AnalysisStage.TypeCheck, &options)?;
        } else {
            match options.trace { Some(trace) => trace.skip("analysis.verify_hir", "disabled by analysis configuration"), None => {}, }
        }
        start_stage(&options, "analysis.check_coverage", AnalysisStage.Coverage);
        at_stage(check_coverage(&context, &output), "analysis.check_coverage", AnalysisStage.Coverage, &options)?;

        for procedure in output.procedures {
            start_stage(&options, "analysis.check_assignment", AnalysisStage.Assignment);
            let checked_assignment = check_assignment(&context, procedure);
            match &checked_assignment {
                Ok(_) => finish_stage(&options, "analysis.check_assignment", true),
                Err(_) => finish_stage(&options, "analysis.check_assignment", false),
            }
            match checked_assignment {
                Ok(_) => {},
                Err(problem) => return Result<AnalysisOutput, AnalysisError>.Err(problem.with_stage(AnalysisStage.Assignment)),
            }
        }

        accepted_output = true;
        Result<AnalysisOutput, AnalysisError>.Ok(output)
    }
}

impl Drop for MiddleEndDriver {
    pub fn drop() {
        self.permissions.drop();
        self.trust.drop();
        self.worklist.drop();
        self.definitions.drop();
        self.impls.drop();
    }
}
