from yianc.config import CompilerConfig;
from yianc.driver.log import CompilerLog, LogLevel;
from yianc.driver.timing import CompilerTiming;
from yianc.driver.profile import ProfileKind;
from llvm.observation import OperationKind, OperationObserver;

pub struct CompilerTrace { log: Option<CompilerLog>, timing: Option<CompilerTiming> }

impl CompilerTrace {
    static pub fn disabled() -> Self { Self(Option<CompilerLog>.None, Option<CompilerTiming>.None) }
    static pub fn new(config: CompilerConfig&) -> Self {
        let log = if config.log_enabled { match CompilerLog.new(config) {
            Ok(value) => Option<CompilerLog>.Some(value),
            Err(problem) => { @eprintln(problem); problem.drop(); exit(1); },
        } } else { Option<CompilerLog>.None };
        Self(log, CompilerTiming.from_config(config))
    }
    pub fn event(channel: str, severity: LogLevel, message: str, path: Option<str>) {
        match &self.log { Some(log) => log.event(channel, severity, message, path), None => {}, }
    }
    pub fn start(channel: str, name: str) { self.start_pass(name, channel, name, ProfileKind.Stage); }
    pub fn start_pass(pass_id: str, channel: str, name: str, kind: ProfileKind) {
        if kind == ProfileKind.Stage { self.event(channel, LogLevel.Debug, name, Option<str>.None); }
        match &self.timing { Some(timing) => timing.begin(pass_id, kind), None => {}, }
    }
    pub fn finish(name: str) { self.end_pass(name, true); }
    pub fn fail(name: str) { self.end_pass(name, false); }
    fn end_pass(name: str, success: bool) {
        match &self.timing { Some(timing) => timing.end(name, success), None => {}, }
    }
    pub fn skip(pass_id: str, reason: str) { match &self.timing { Some(timing) => timing.skip(pass_id, reason), None => {}, } }
    pub fn report() { match &self.timing { Some(timing) => timing.report(), None => {}, } }
    pub fn finalize(ok: bool) { match &self.timing { Some(timing) => timing.finalize(ok), None => {}, } }
}
impl Drop for CompilerTrace {
    pub fn drop() {
        match &self.log { Some(value) => value.drop(), None => {}, }
        match &self.timing { Some(value) => value.drop(), None => {}, }
    }
}

impl OperationObserver for CompilerTrace {
    pub fn begin(operation: OperationKind) {
        let pass_id = match operation {
            VerifyBeforeOptimization => "llvm.verify_before_optimization",
            Optimize => "llvm.optimize",
            VerifyAfterOptimization => "llvm.verify_after_optimization",
            EmitNative => "llvm.emit_native",
            SerializeIr => "llvm.serialize_ir",
            SerializeBitcode => "llvm.serialize_bitcode",
        };
        self.start_pass(pass_id, "llvm", pass_id, ProfileKind.Pass);
    }

    pub fn end(operation: OperationKind, success: bool) {
        let pass_id = match operation {
            VerifyBeforeOptimization => "llvm.verify_before_optimization",
            Optimize => "llvm.optimize",
            VerifyAfterOptimization => "llvm.verify_after_optimization",
            EmitNative => "llvm.emit_native",
            SerializeIr => "llvm.serialize_ir",
            SerializeBitcode => "llvm.serialize_bitcode",
        };
        self.end_pass(pass_id, success);
    }
}
