from yianc.analysis.session.session import AnalysisSession;
from yianc.common.ids import SourceId;
from yianc.common.location import SourceSpan;
from yianc.config import CompilerConfig;
from yianc.diagnostics.model import AnalysisError, DiagnosticCode;
from yianc.diagnostics.render import detach;
from yianc.driver.dump import StageDumps;
from yianc.driver.host import associated_root;
from yianc.driver.paths import source_roots;
from yianc.driver.profile import ProfileKind;
from yianc.driver.trace import CompilerTrace;
from yianc.frontend.prepare import PreparationStage;
from yianc.frontend.session import FrontendSession, PreparationObserver;
from yianc.frontend.source import SourceDocument, collect_sources;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from std.core.fs import try_exists;
from std.core.iter import Iterator, IntoIterator;
from std.core.path import Path;

fn start_profile(trace: Option<CompilerTrace&>, pass_id: str) -> u64 {
    match trace { Some(value) => value.start_pass(pass_id, "input", pass_id, ProfileKind.Pass), None => 0u64 }
}

fn finish_profile(trace: Option<CompilerTrace&>, pass_id: str, token: u64, success: bool) {
    match trace {
        Some(value) => if success { value.finish(pass_id, token); } else { value.fail(pass_id, token); },
        None => {},
    }
}

fn begin_timing(observer: Option<PreparationObserver&>, pass_id: str) -> u64 {
    match observer { Some(value) => value.begin(pass_id), None => 0u64 }
}

fn finish_timing(observer: Option<PreparationObserver&>, pass_id: str, token: u64, success: bool) {
    match observer { Some(value) => value.finish(pass_id, token, success), None => {}, }
}

fn release_paths(paths: Vec<String>&) {
    let index = 0u64;

    while index < paths.len() {
        paths[index].drop();
        index += 1u64;
    }

    paths.drop();
}

// Run the complete frontend pass sequence on an already loaded session.
fn prepare_session(session: FrontendSession&, allow_ffi: bool, observer: Option<PreparationObserver&>) -> Result<(), AnalysisError> {
    // Complete each frontend stage across the ordered input set before advancing to the next.
    let index = 0u64;
    while index < session.source_count() {
        let source = SourceId(index);
        let lex_token = begin_timing(observer, "frontend.lex");
        let prepared_result = session.prepare_source(source);
        match &prepared_result {
            Ok(_) => finish_timing(observer, "frontend.lex", lex_token, true),
            Err(_) => finish_timing(observer, "frontend.lex", lex_token, false),
        }
        let prepared = match prepared_result {
            Ok(value) => value,
            Err(error) => {
                match detach(&error.diagnostic, session.source_manager()) {
                    Ok(_) => {},
                    Err(problem) => { error.drop(); return Result<(), AnalysisError>.Err(problem); },
                }
                return Result<(), AnalysisError>.Err(error);
            },
        };
        let file = session.source(source).unwrap();
        let classify_token = begin_timing(observer, "input.classify_sources");
        let permissions = session.classify(file.canonical_path(), allow_ffi);
        finish_timing(observer, "input.classify_sources", classify_token, true);
        session.accept(prepared, permissions);
        index += 1u64;
    }
    match observer { Some(value) => { value.stage_complete(PreparationStage.Lex, session)?; }, None => {}, }

    index = 0u64;
    while index < session.len() {
        let unit = session.unit_at(index).unwrap();
        let token = begin_timing(observer, "frontend.parse");
        let result = unit.prepared.parse();
        let success = match &result { Ok(_) => true, Err(_) => false };
        let finished = session.finish_preparation(result, unit.source);
        finish_timing(observer, "frontend.parse", token, success);
        finished?;
        index += 1u64;
    }
    match observer { Some(value) => { value.stage_complete(PreparationStage.Parse, session)?; }, None => {}, }

    index = 0u64;
    while index < session.len() {
        let unit = session.unit_at(index).unwrap();
        let file = session.source(unit.source).unwrap();
        let token = begin_timing(observer, "frontend.desugar");
        let result = unit.prepared.desugar(file.path());
        let success = match &result { Ok(_) => true, Err(_) => false };
        let finished = session.finish_preparation(result, unit.source);
        finish_timing(observer, "frontend.desugar", token, success);
        finished?;
        index += 1u64;
    }
    match observer { Some(value) => { value.stage_complete(PreparationStage.Desugar, session)?; }, None => {}, }
    Result<(), AnalysisError>.Ok(())
}

// The frontend driver owns package/source/trust setup and the frontend pass sequence.
pub struct FrontendDriver {
    session: Option<FrontendSession>,
}

impl FrontendDriver {
    static pub fn prepare(config: CompilerConfig&, trace: Option<CompilerTrace&>) -> Result<Self, AnalysisError> {
        let packages = match &config.packages {
            Some(path) => {
                let token = start_profile(trace, "input.package_map");
                match PackageMap.load(path.as_str()) {
                    Ok(value) => { finish_profile(trace, "input.package_map", token, true); Option<PackageMap>.Some(value) },
                    Err(problem) => { finish_profile(trace, "input.package_map", token, false); return Result<Self, AnalysisError>.Err(problem); },
                }
            },
            None => {
                match trace { Some(value) => value.skip("input.package_map", "standalone compilation has no package map"), None => {}, }
                Option<PackageMap>.None
            },
        };
        let packages_transferred = false;
        defer {
            if !packages_transferred { match &packages { Some(value) => value.drop(), None => {}, } }
        };
        let map = match &packages { Some(value) => Option<PackageMap&>.Some(value), None => Option<PackageMap&>.None, };
        let roots_token = start_profile(trace, "input.source_roots");
        let roots_result = source_roots(config, map);
        match &roots_result {
            Ok(_) => finish_profile(trace, "input.source_roots", roots_token, true),
            Err(_) => finish_profile(trace, "input.source_roots", roots_token, false),
        }
        let roots = roots_result?;
        defer roots.drop();
        let trust = SourceTrust.new(roots.standard_library.as_str())?;
        let trust_transferred = false;
        defer {
            if !trust_transferred {
                trust.drop();
            }
        };

        // Harness trust belongs to the compiler checkout, independently of standard-library overrides.
        let harness_checkout = associated_root()?;
        defer harness_checkout.drop();
        let harnesses = ["tests/basic/std", "tests/safety/std"];

        for harness in harnesses {
            let root = Path.new(harness_checkout.as_str()).join(*harness);
            defer root.drop();

            match try_exists(root.as_str()) {
                Ok(exists) => {
                    if exists {
                        trust.add_test_root(root.as_str())?;
                    }
                },
                Err(problem) => {
                    defer problem.drop();
                    return Result<Self, AnalysisError>.Err(AnalysisError.internal(problem.msg()));
                },
            }
        }

        let session = FrontendSession.new(trust, packages);
        packages_transferred = true;
        trust_transferred = true;
        let accepted = false;
        defer { if !accepted { session.drop(); } };

        let dumps = StageDumps(config.dump, trace);
        let observer = if config.dump || trace.is_some() {
            Option<PreparationObserver&>.Some(&dumps)
        } else {
            Option<PreparationObserver&>.None
        };

        let collect_token = begin_timing(observer, "input.collect_sources");
        let paths_result = collect_sources(&config.inputs);
        match &paths_result {
            Ok(_) => finish_timing(observer, "input.collect_sources", collect_token, true),
            Err(_) => finish_timing(observer, "input.collect_sources", collect_token, false),
        }
        let paths = match paths_result {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                return Result<Self, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.Source, Option<SourceSpan>.None, error.msg()));
            },
        };
        defer release_paths(&paths);

        for path in paths {
            let token = begin_timing(observer, "input.read_sources");
            let result = session.load_source(path.as_str());
            match &result {
                Ok(_) => finish_timing(observer, "input.read_sources", token, true),
                Err(_) => finish_timing(observer, "input.read_sources", token, false),
            }
            result?;
        }
        prepare_session(&session, config.allow_ffi, observer)?;

        accepted = true;
        Result<Self, AnalysisError>.Ok(Self(Option<FrontendSession>.Some(session)))
    }

    // Source order is supplied by the caller; each buffer is copied into this owner.
    static pub fn prepare_documents(documents: Vec<SourceDocument>&, trust: SourceTrust,
        packages: Option<PackageMap>, allow_ffi: bool) -> Result<Self, AnalysisError> {
        let session = FrontendSession.new(trust, packages);
        let accepted = false;
        defer { if !accepted { session.drop(); } };

        for document in *documents {
            session.load_text(document.path.as_str(), document.text.as_str())?;
        }
        prepare_session(&session, allow_ffi, Option<PreparationObserver&>.None)?;
        accepted = true;
        Result<Self, AnalysisError>.Ok(Self(Option<FrontendSession>.Some(session)))
    }

    pub fn prepared_session() -> FrontendSession& {
        match &self.session {
            Some(value) => value,
            None => @panic("E599: frontend session has already been transferred"),
        }
    }

    pub fn take_session() -> FrontendSession {
        match self.session.take() {
            Some(value) => value,
            None => @panic("E599: frontend session has already been transferred"),
        }
    }
}

impl Drop for FrontendDriver {
    pub fn drop() {
        match &self.session {
            Some(value) => value.drop(),
            None => {},
        }
    }
}
