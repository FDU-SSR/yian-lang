from yianc.config import CompilerAction, CompilerConfig, OutputKind;
from yianc.driver.profile import ProfileRecorder, ProfileKind;
from std.core.convert import From;
from std.core.fmt import ToString;
from std.core.iter import Iterator, IntoIterator;

struct Timing { name: String, elapsed: u64 }
pub struct CompilerTiming {
    recorder: ProfileRecorder,
    timings: Vec<Timing>,
    terminal: bool,
    output: Option<String>,
    target: String,
    optimization: u8,
    raw_pointers: bool,
}

fn target_name(target: OutputKind) -> str {
    match target { Exe => "exe", Ll => "ll", Bc => "bc" }
}

impl CompilerTiming {
    static pub fn from_config(config: CompilerConfig&) -> Option<Self> {
        if !config.profile { return Option<Self>.None; }
        let output = match &config.profile_output {
            Some(value) if !value.is_empty() => Option<String>.Some(String.from(&value.as_str())),
            _ => Option<String>.None,
        };
        let target = if &config.action matches Check { String.from(&"check") } else { String.from(&target_name(config.target)) };
        Option<Self>.Some(Self(ProfileRecorder.new(), Vec<Timing>.new(), output.is_none(), output, target, config.optimization, config.raw_pointers))
    }

    pub fn begin(pass_id: str, kind: ProfileKind) { self.recorder.begin(pass_id, kind); }
    pub fn end(name: str, success: bool) {
        match self.recorder.end(name, success) {
            Some(elapsed) if self.terminal => self.timings.push(Timing(String.from(&name), elapsed)),
            _ => {},
        }
    }
    pub fn skip(pass_id: str, reason: str) { self.recorder.skip(pass_id, reason); }

    fn mark_unreached() {
        let known = [
            "compiler.total", "source_preparation", "semantic_analysis", "cfg_pipeline", "llvm_pipeline", "native_pipeline",
            "input.package_map", "input.source_roots", "input.collect_sources", "input.read_sources", "input.classify_sources",
            "frontend.lex", "frontend.parse", "frontend.desugar", "analysis.restricted", "analysis.context",
            "analysis.collect_declarations", "analysis.resolve_imports", "analysis.resolve_definitions", "analysis.resolve_impls",
            "analysis.register_automatic", "analysis.evaluate_constants", "analysis.finalize_types", "analysis.check_impls",
            "analysis.validate_declarations", "analysis.select_entry", "analysis.check_procedures", "analysis.normalize_address_storage",
            "analysis.verify_hir", "analysis.check_coverage", "analysis.check_assignment", "backend.initialize",
            "backend.finish_analysis", "cfg.lower", "cfg.verify_structure", "cfg.cleanup", "cfg.inline", "cfg.prepare_safety",
            "cfg.insert_checks", "cfg.eliminate_checks", "cfg.verify",
            "llvm.lower", "llvm.verify_before_optimization", "llvm.optimize", "llvm.verify_after_optimization", "llvm.emit_native",
            "llvm.serialize_ir", "llvm.serialize_bitcode", "native.prepare", "native.runtime_compile", "native.runtime_archive",
            "native.c_shim_compile", "native.link_flags", "native.link", "io.dump", "io.artifact_publish",
        ];
        for pass_id in known {
            if !self.recorder.has_pass(*pass_id) { self.recorder.skip(*pass_id, "not reached before compilation stopped or not selected by target"); }
        }
    }

    pub fn report() {
        if !self.terminal { return; }
        for timing in self.timings {
            let elapsed = (f64(timing.elapsed) / 1000000.0f64).to_string();
            defer elapsed.drop();
            @eprint("[profile] ");
            @eprint(timing.name.as_str());
            @eprint(": ");
            @eprint(elapsed);
            @eprintln(" ms");
        }
    }

    pub fn finalize(ok: bool) {
        self.report();
        self.mark_unreached();
        match &self.output {
            Some(path) => match self.recorder.write_report(path.as_str(), ok, self.target.as_str(), self.optimization, self.raw_pointers) {
                Ok(_) => {},
                Err(problem) => {
                    let warning = String.from(&"[profile] warning: could not write report: ");
                    warning.push_str(problem.as_str());
                    warning.push('\n');
                    defer warning.drop();
                    problem.drop();
                    @eprint(warning);
                },
            },
            None => {},
        }
    }

}
impl Drop for CompilerTiming {
    pub fn drop() {
        for timing in self.timings { timing.name.drop(); }
        self.timings.drop();
        match &self.output { Some(value) => value.drop(), None => {}, }
        self.recorder.drop();
        self.target.drop();
    }
}
