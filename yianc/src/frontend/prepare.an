from yianc.common.ids import SourceId;
from yianc.config import FrontendPhase;
from yianc.diagnostics.model import DiagnosticCode;
from yianc.frontend.ast.arena import AstTree;
from yianc.frontend.desugar import desugar;
from yianc.frontend.diagnostics import lex_code, parse_code;
from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.lex.token import Token, drop_tokens;
from yianc.frontend.parse.items import parse_program;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.source import Span;
from std.core.convert import From;
from std.core.drop import Drop;

pub enum PreparationStage {
    Lex,
    Parse,
    Desugar,
}

pub struct PreparationError {
    pub stage: PreparationStage,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span
}

impl Drop for PreparationError {
    pub fn drop() {
        self.message.drop();
    }
}

// Tokens and the optional tree transfer together; the parser owns neither after success.
pub struct PreparedFile {
    pub source: SourceId,
    pub tokens: Vec<Token>,
    pub tree: Option<AstTree>
}

impl Drop for PreparedFile {
    pub fn drop() {
        match &self.tree {
            Some(tree) => tree.drop(),
            None => {}
        }

        drop_tokens(&self.tokens);
    }
}

impl PreparedFile {
    // Parsing borrows tokens and transfers the completed tree into this owner only on success.
    pub fn parse() -> Result<(), PreparationError> {
        let parser = Parser.new(&self.tokens);
        defer parser.drop();
        let tree = match parse_program(&parser) {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                return Result<(), PreparationError>.Err(PreparationError(PreparationStage.Parse,
                    parse_code(error.message()), String.from(&error.message()), error.span()));
            },
        };
        self.tree = Option<AstTree>.Some(tree);
        Result<(), PreparationError>.Ok(())
    }

    pub fn desugar(path: str) -> Result<(), PreparationError> {
        // Mutate the owned tree; an arena shallow copy would retain stale allocation metadata.
        match desugar(self.tree.unwrap(), path) {
            Ok(_) => Result<(), PreparationError>.Ok(()),
            Err(error) => {
                defer error.drop();
                Result<(), PreparationError>.Err(PreparationError(PreparationStage.Desugar,
                    parse_code(error.message()), String.from(&error.message()), error.span()))
            },
        }
    }
}

pub fn prepare_file(id: SourceId, path: str, source: str, phase: FrontendPhase) -> Result<PreparedFile, PreparationError> {
    let tokens = match Lexer.new(source).run() {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<PreparedFile, PreparationError>.Err(PreparationError(PreparationStage.Lex, lex_code(error.message()), String.from(&error.message()), error.span()));
        },
    };

    let prepared = PreparedFile(id, tokens, Option<AstTree>.None);
    let transferred = false;
    defer {
        if !transferred {
            prepared.drop();
        }
    };

    if phase == FrontendPhase.Tokens {
        transferred = true;
        return Result<PreparedFile, PreparationError>.Ok(prepared);
    }

    prepared.parse()?;

    if phase == FrontendPhase.Desugared {
        prepared.desugar(path)?;
    }

    transferred = true;
    Result<PreparedFile, PreparationError>.Ok(prepared)
}
