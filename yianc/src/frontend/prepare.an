from yianc.common.ids import UnitId;
from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation, UserDiagnostic;
from yianc.frontend.ast.arena import AstTree;
from yianc.frontend.desugar import desugar;
from yianc.frontend.diagnostics import lex_code, parse_code;
from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.lex.token import Token, drop_tokens;
from yianc.frontend.parse.items import parse_program;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.source import Span;
from std.core.convert import From;

pub enum FrontendPhase {
    Tokens, Ast, Desugared
}

impl FrontendPhase {
    pub fn name() -> str {
        match self {
            Tokens => "tokens",
            Ast => "ast",
            Desugared => "desugared",
        }
    }
}

pub enum PreparationStage {
    Lex,
    Parse,
    Desugar,
}

pub struct LexDiagnostic {
    pub code: DiagnosticCode,
    pub source: SourceSpan,
    pub message: String,
}

impl UserDiagnostic for LexDiagnostic {
    pub fn code() -> DiagnosticCode { self.code }
    pub fn location() -> DiagnosticLocation { DiagnosticLocation.Source(self.source) }
    pub fn message() -> String { String.from(&self.message.as_str()) }
}

impl Drop for LexDiagnostic {
    pub fn drop() { self.message.drop(); }
}

pub struct ParseDiagnostic {
    pub code: DiagnosticCode,
    pub source: SourceSpan,
    pub message: String,
}

impl UserDiagnostic for ParseDiagnostic {
    pub fn code() -> DiagnosticCode { self.code }
    pub fn location() -> DiagnosticLocation { DiagnosticLocation.Source(self.source) }
    pub fn message() -> String { String.from(&self.message.as_str()) }
}

impl Drop for ParseDiagnostic {
    pub fn drop() { self.message.drop(); }
}

pub struct DesugarDiagnostic {
    pub code: DiagnosticCode,
    pub source: SourceSpan,
    pub message: String,
}

impl UserDiagnostic for DesugarDiagnostic {
    pub fn code() -> DiagnosticCode { self.code }
    pub fn location() -> DiagnosticLocation { DiagnosticLocation.Source(self.source) }
    pub fn message() -> String { String.from(&self.message.as_str()) }
}

impl Drop for DesugarDiagnostic {
    pub fn drop() { self.message.drop(); }
}

pub enum FrontendStageError {
    Lex { error: LexDiagnostic },
    Parse { error: ParseDiagnostic },
    Desugar { error: DesugarDiagnostic },
}

impl UserDiagnostic for FrontendStageError {
    pub fn code() -> DiagnosticCode {
        match self { Lex(error) => error.code(), Parse(error) => error.code(), Desugar(error) => error.code(), }
    }
    pub fn location() -> DiagnosticLocation {
        match self { Lex(error) => error.location(), Parse(error) => error.location(), Desugar(error) => error.location(), }
    }
    pub fn message() -> String {
        match self { Lex(error) => error.message(), Parse(error) => error.message(), Desugar(error) => error.message(), }
    }
}

impl Drop for FrontendStageError {
    pub fn drop() {
        match self { Lex(error) => error.drop(), Parse(error) => error.drop(), Desugar(error) => error.drop(), }
    }
}

// Tokens and the optional tree transfer together; the parser owns neither after success.
pub struct PreparedFile {
    pub tokens: Vec<Token>,
    pub tree: Option<AstTree>
}

impl Drop for PreparedFile {
    pub fn drop() {
        match &self.tree {
            Some(tree) => tree.drop(),
            None => {}
        }

        drop_tokens(&self.tokens);
    }
}

impl PreparedFile {
    // Parsing borrows tokens and transfers the completed tree into this owner only on success.
    pub fn parse(unit: UnitId) -> Result<(), FrontendStageError> {
        let parser = Parser.new(&self.tokens);
        defer parser.drop();
        let tree = match parse_program(&parser) {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                return Result<(), FrontendStageError>.Err(FrontendStageError.Parse(ParseDiagnostic(
                    parse_code(error.message()), SourceSpan(unit, error.span()), String.from(&error.message()))));
            },
        };
        self.tree = Option<AstTree>.Some(tree);
        Result<(), FrontendStageError>.Ok(())
    }

    pub fn desugar(unit: UnitId, path: str) -> Result<(), FrontendStageError> {
        // Mutate the owned tree; an arena shallow copy would retain stale allocation metadata.
        match desugar(self.tree.unwrap(), path) {
            Ok(_) => Result<(), FrontendStageError>.Ok(()),
            Err(error) => {
                defer error.drop();
                Result<(), FrontendStageError>.Err(FrontendStageError.Desugar(DesugarDiagnostic(
                    parse_code(error.message()), SourceSpan(unit, error.span()), String.from(&error.message()))))
            },
        }
    }
}

pub fn prepare_file(id: UnitId, path: str, source: str, phase: FrontendPhase) -> Result<PreparedFile, FrontendStageError> {
    let tokens = match Lexer.new(source).run() {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<PreparedFile, FrontendStageError>.Err(FrontendStageError.Lex(LexDiagnostic(lex_code(error.message()), SourceSpan(id, error.span()), String.from(&error.message()))));
        },
    };

    let prepared = PreparedFile(tokens, Option<AstTree>.None);
    let transferred = false;
    defer {
        if !transferred {
            prepared.drop();
        }
    };

    if phase == FrontendPhase.Tokens {
        transferred = true;
        return Result<PreparedFile, FrontendStageError>.Ok(prepared);
    }

    prepared.parse(id)?;

    if phase == FrontendPhase.Desugared {
        prepared.desugar(id, path)?;
    }

    transferred = true;
    Result<PreparedFile, FrontendStageError>.Ok(prepared)
}
