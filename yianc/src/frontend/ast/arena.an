from yianc.frontend.source import Span;
from yianc.frontend.ast.node import Identifier, IdentifierData, IntLiteral, IntLiteralData, FloatLiteral, FloatLiteralData, CharLiteral, CharLiteralData, StrLiteral, StrLiteralData, BoolLiteral, BoolLiteralData, Program, ProgramData, Block, BlockData, Argument, ArgumentData, VarInfo, VarInfoData, PatternParam, PatternParamData, PatternLet, PatternLetData, LetCondition, LetConditionData, ElifBranch, ElifBranchData, MatchArm, MatchArmData, Attr, AttrData, TypeGenericParam, TypeGenericParamData, ConstGenericParam, ConstGenericParamData, FieldInfo, FieldInfoData, VariantInfo, VariantInfoData, MethodDecl, MethodDeclData, MethodDef, MethodDefData, ExternFuncDecl, ExternFuncDeclData, ImplCondition, ImplConditionData, CaptureItem, CaptureItemData, FieldPattern, FieldPatternData, Expr, ExprData, TypeSyntax, TypeData, ConstExpr, ConstExprData, Pattern, PatternData, Item, ItemData;
from std.core.drop import Drop;
from std.core.ops import Index;
from std.core.vec import Vec;

from std.collections.arena import Arena;
from std.core.option import Option;
from std.core.iter import IntoIterator;

// Payload cleanup is separate from storage cleanup across all node categories.
fn drop_payloads<N>(nodes: Arena<N>*) {
    for node in *nodes { node.drop(); }
}

pub struct AstArena {
    identifier: Arena<Identifier>,
    int_literal: Arena<IntLiteral>,
    float_literal: Arena<FloatLiteral>,
    char_literal: Arena<CharLiteral>,
    str_literal: Arena<StrLiteral>,
    bool_literal: Arena<BoolLiteral>,
    program: Arena<Program>,
    block: Arena<Block>,
    argument: Arena<Argument>,
    var_info: Arena<VarInfo>,
    pattern_param: Arena<PatternParam>,
    pattern_let: Arena<PatternLet>,
    let_condition: Arena<LetCondition>,
    elif_branch: Arena<ElifBranch>,
    match_arm: Arena<MatchArm>,
    attr: Arena<Attr>,
    type_generic_param: Arena<TypeGenericParam>,
    const_generic_param: Arena<ConstGenericParam>,
    field_info: Arena<FieldInfo>,
    variant_info: Arena<VariantInfo>,
    method_decl: Arena<MethodDecl>,
    method_def: Arena<MethodDef>,
    extern_func_decl: Arena<ExternFuncDecl>,
    impl_condition: Arena<ImplCondition>,
    capture_item: Arena<CaptureItem>,
    field_pattern: Arena<FieldPattern>,
    expr: Arena<Expr>,
    type_syntax: Arena<TypeSyntax>,
    const_expr: Arena<ConstExpr>,
    pattern: Arena<Pattern>,
    item: Arena<Item>,
}

impl AstArena {
    static pub fn new() -> Self {
        return Self(
            identifier=Arena<Identifier>.new(),
            int_literal=Arena<IntLiteral>.new(),
            float_literal=Arena<FloatLiteral>.new(),
            char_literal=Arena<CharLiteral>.new(),
            str_literal=Arena<StrLiteral>.new(),
            bool_literal=Arena<BoolLiteral>.new(),
            program=Arena<Program>.new(),
            block=Arena<Block>.new(),
            argument=Arena<Argument>.new(),
            var_info=Arena<VarInfo>.new(),
            pattern_param=Arena<PatternParam>.new(),
            pattern_let=Arena<PatternLet>.new(),
            let_condition=Arena<LetCondition>.new(),
            elif_branch=Arena<ElifBranch>.new(),
            match_arm=Arena<MatchArm>.new(),
            attr=Arena<Attr>.new(),
            type_generic_param=Arena<TypeGenericParam>.new(),
            const_generic_param=Arena<ConstGenericParam>.new(),
            field_info=Arena<FieldInfo>.new(),
            variant_info=Arena<VariantInfo>.new(),
            method_decl=Arena<MethodDecl>.new(),
            method_def=Arena<MethodDef>.new(),
            extern_func_decl=Arena<ExternFuncDecl>.new(),
            impl_condition=Arena<ImplCondition>.new(),
            capture_item=Arena<CaptureItem>.new(),
            field_pattern=Arena<FieldPattern>.new(),
            expr=Arena<Expr>.new(),
            type_syntax=Arena<TypeSyntax>.new(),
            const_expr=Arena<ConstExpr>.new(),
            pattern=Arena<Pattern>.new(),
            item=Arena<Item>.new(),
        );
    }

    pub fn len() -> u64 {
        return self.identifier.len() + self.int_literal.len() + self.float_literal.len() + self.char_literal.len() + self.str_literal.len() + self.bool_literal.len() + self.program.len() + self.block.len() + self.argument.len() + self.var_info.len() + self.pattern_param.len() + self.pattern_let.len() + self.let_condition.len() + self.elif_branch.len() + self.match_arm.len() + self.attr.len() + self.type_generic_param.len() + self.const_generic_param.len() + self.field_info.len() + self.variant_info.len() + self.method_decl.len() + self.method_def.len() + self.extern_func_decl.len() + self.impl_condition.len() + self.capture_item.len() + self.field_pattern.len() + self.expr.len() + self.type_syntax.len() + self.const_expr.len() + self.pattern.len() + self.item.len();
    }

    pub fn alloc_identifier(data: IdentifierData, span: Span) -> Identifier& {
        return self.identifier.alloc(Identifier(data=data, span=span));
    }

    pub fn alloc_int_literal(data: IntLiteralData, span: Span) -> IntLiteral& {
        return self.int_literal.alloc(IntLiteral(data=data, span=span));
    }

    pub fn alloc_float_literal(data: FloatLiteralData, span: Span) -> FloatLiteral& {
        return self.float_literal.alloc(FloatLiteral(data=data, span=span));
    }

    pub fn alloc_char_literal(data: CharLiteralData, span: Span) -> CharLiteral& {
        return self.char_literal.alloc(CharLiteral(data=data, span=span));
    }

    pub fn alloc_str_literal(data: StrLiteralData, span: Span) -> StrLiteral& {
        return self.str_literal.alloc(StrLiteral(data=data, span=span));
    }

    pub fn alloc_bool_literal(data: BoolLiteralData, span: Span) -> BoolLiteral& {
        return self.bool_literal.alloc(BoolLiteral(data=data, span=span));
    }

    pub fn alloc_program(data: ProgramData, span: Span) -> Program& {
        return self.program.alloc(Program(data=data, span=span));
    }

    pub fn alloc_block(data: BlockData, span: Span) -> Block& {
        return self.block.alloc(Block(data=data, span=span));
    }

    pub fn alloc_argument(data: ArgumentData, span: Span) -> Argument& {
        return self.argument.alloc(Argument(data=data, span=span));
    }

    pub fn alloc_var_info(data: VarInfoData, span: Span) -> VarInfo& {
        return self.var_info.alloc(VarInfo(data=data, span=span));
    }

    pub fn alloc_pattern_param(data: PatternParamData, span: Span) -> PatternParam& {
        return self.pattern_param.alloc(PatternParam(data=data, span=span));
    }

    pub fn alloc_pattern_let(data: PatternLetData, span: Span) -> PatternLet& {
        return self.pattern_let.alloc(PatternLet(data=data, span=span));
    }

    pub fn alloc_let_condition(data: LetConditionData, span: Span) -> LetCondition& {
        return self.let_condition.alloc(LetCondition(data=data, span=span));
    }

    pub fn alloc_elif_branch(data: ElifBranchData, span: Span) -> ElifBranch& {
        return self.elif_branch.alloc(ElifBranch(data=data, span=span));
    }

    pub fn alloc_match_arm(data: MatchArmData, span: Span) -> MatchArm& {
        return self.match_arm.alloc(MatchArm(data=data, span=span));
    }

    pub fn alloc_attr(data: AttrData, span: Span) -> Attr& {
        return self.attr.alloc(Attr(data=data, span=span));
    }

    pub fn alloc_type_generic_param(data: TypeGenericParamData, span: Span) -> TypeGenericParam& {
        return self.type_generic_param.alloc(TypeGenericParam(data=data, span=span));
    }

    pub fn alloc_const_generic_param(data: ConstGenericParamData, span: Span) -> ConstGenericParam& {
        return self.const_generic_param.alloc(ConstGenericParam(data=data, span=span));
    }

    pub fn alloc_field_info(data: FieldInfoData, span: Span) -> FieldInfo& {
        return self.field_info.alloc(FieldInfo(data=data, span=span));
    }

    pub fn alloc_variant_info(data: VariantInfoData, span: Span) -> VariantInfo& {
        return self.variant_info.alloc(VariantInfo(data=data, span=span));
    }

    pub fn alloc_method_decl(data: MethodDeclData, span: Span) -> MethodDecl& {
        return self.method_decl.alloc(MethodDecl(data=data, span=span));
    }

    pub fn alloc_method_def(data: MethodDefData, span: Span) -> MethodDef& {
        return self.method_def.alloc(MethodDef(data=data, span=span));
    }

    pub fn alloc_extern_func_decl(data: ExternFuncDeclData, span: Span) -> ExternFuncDecl& {
        return self.extern_func_decl.alloc(ExternFuncDecl(data=data, span=span));
    }

    pub fn alloc_impl_condition(data: ImplConditionData, span: Span) -> ImplCondition& {
        return self.impl_condition.alloc(ImplCondition(data=data, span=span));
    }

    pub fn alloc_capture_item(data: CaptureItemData, span: Span) -> CaptureItem& {
        return self.capture_item.alloc(CaptureItem(data=data, span=span));
    }

    pub fn alloc_field_pattern(data: FieldPatternData, span: Span) -> FieldPattern& {
        return self.field_pattern.alloc(FieldPattern(data=data, span=span));
    }

    pub fn alloc_expr(data: ExprData, span: Span) -> Expr& {
        return self.expr.alloc(Expr(data=data, span=span));
    }

    pub fn alloc_type_syntax(data: TypeData, span: Span) -> TypeSyntax& {
        return self.type_syntax.alloc(TypeSyntax(data=data, span=span));
    }

    pub fn alloc_const_expr(data: ConstExprData, span: Span) -> ConstExpr& {
        return self.const_expr.alloc(ConstExpr(data=data, span=span));
    }

    pub fn alloc_pattern(data: PatternData, span: Span) -> Pattern& {
        return self.pattern.alloc(Pattern(data=data, span=span));
    }

    pub fn alloc_item(data: ItemData, span: Span) -> Item& {
        return self.item.alloc(Item(data=data, span=span));
    }
}

impl Drop for AstArena {
    pub fn drop() {
        // Release the payloads of every node category before freeing all node storage chunks.
        drop_payloads(&self.identifier);
        drop_payloads(&self.int_literal);
        drop_payloads(&self.float_literal);
        drop_payloads(&self.char_literal);
        drop_payloads(&self.str_literal);
        drop_payloads(&self.bool_literal);
        drop_payloads(&self.program);
        drop_payloads(&self.block);
        drop_payloads(&self.argument);
        drop_payloads(&self.var_info);
        drop_payloads(&self.pattern_param);
        drop_payloads(&self.pattern_let);
        drop_payloads(&self.let_condition);
        drop_payloads(&self.elif_branch);
        drop_payloads(&self.match_arm);
        drop_payloads(&self.attr);
        drop_payloads(&self.type_generic_param);
        drop_payloads(&self.const_generic_param);
        drop_payloads(&self.field_info);
        drop_payloads(&self.variant_info);
        drop_payloads(&self.method_decl);
        drop_payloads(&self.method_def);
        drop_payloads(&self.extern_func_decl);
        drop_payloads(&self.impl_condition);
        drop_payloads(&self.capture_item);
        drop_payloads(&self.field_pattern);
        drop_payloads(&self.expr);
        drop_payloads(&self.type_syntax);
        drop_payloads(&self.const_expr);
        drop_payloads(&self.pattern);
        drop_payloads(&self.item);

        self.identifier.clear();
        self.int_literal.clear();
        self.float_literal.clear();
        self.char_literal.clear();
        self.str_literal.clear();
        self.bool_literal.clear();
        self.program.clear();
        self.block.clear();
        self.argument.clear();
        self.var_info.clear();
        self.pattern_param.clear();
        self.pattern_let.clear();
        self.let_condition.clear();
        self.elif_branch.clear();
        self.match_arm.clear();
        self.attr.clear();
        self.type_generic_param.clear();
        self.const_generic_param.clear();
        self.field_info.clear();
        self.variant_info.clear();
        self.method_decl.clear();
        self.method_def.clear();
        self.extern_func_decl.clear();
        self.impl_condition.clear();
        self.capture_item.clear();
        self.field_pattern.clear();
        self.expr.clear();
        self.type_syntax.clear();
        self.const_expr.clear();
        self.pattern.clear();
        self.item.clear();

        *self = AstArena.new();
    }
}

pub struct AstTree { pub arena: AstArena, pub root: Program& }
impl Drop for AstTree {
    pub fn drop() { self.arena.drop(); }
}
