from yianc.frontend.ast.arena import AstArena, AstTree;
from yianc.frontend.ast.node import Expr, ExprData, Argument;
from yianc.frontend.ast.operator import BinaryOperator;
from yianc.frontend.ast.traversal import AstRewriter, rewrite_expr_children;
from std.core.vec import Vec;
from yianc.frontend.desugar.build import identifier, name_expr, method_call, argument;

struct ExpressionLowerer { arena: AstArena& }
impl AstRewriter for ExpressionLowerer {
    pub fn rewrite_expr(node: Expr&) -> Expr& {
        rewrite_expr_children(node, self);

        match &node.data {
            Binary(op, left, right) => {
                if *op == BinaryOperator.Range {
                    let args = Vec<Argument&>.new();
                    args.push(argument(self.arena, *left));
                    args.push(argument(self.arena, *right));
                    let callee = name_expr(self.arena, identifier(self.arena, node.span, "Range", false));
                    return self.arena.alloc_expr(ExprData.Call(callee=callee, args=args), node.span);
                }

                if *op == BinaryOperator.In {
                    let args = Vec<Argument&>.new();
                    args.push(argument(self.arena, *left));
                    return method_call(self.arena, node.span, *right, "contains", args);
                }
            },
            _ => {},
        }
        node
    }
}

// Range expressions construct Range; membership expressions use the right operand as the contains receiver.
pub fn lower_expressions(tree: AstTree&) {
    let pass = ExpressionLowerer(arena=&tree.arena);
    tree.root = pass.rewrite_program(tree.root);
}
