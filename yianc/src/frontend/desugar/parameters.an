from yianc.frontend.ast.arena import AstArena, AstTree;
from yianc.frontend.ast.node import Expr, Block, Pattern, PatternLetData, Parameter, VarInfoData, Item, MethodDef;
from yianc.frontend.ast.traversal import AstVisitor, walk_program;
from yianc.frontend.desugar.build import identifier, name_expr;

struct ParameterNormalizer { arena: AstArena& }
impl ParameterNormalizer {
    // Pattern parameters receive arguments through hidden names; original patterns are stored as body parameter bindings.
    fn normalize(params: Vec<Parameter>&, body: Block&) {
        let i: u64 = 0;

        while i < params.len() {
            let parameter = params[i];
            match parameter {
                Pattern(value) => {
                    let label = String.from(&"%arg_");
                    let digits = i.to_string_radix(10);
                    label.push_str(digits.as_str());
                    digits.drop();
                    let hidden = identifier(self.arena, value.span, label.as_str(), true);
                    label.drop();

                    let info = self.arena.alloc_var_info(VarInfoData(name=hidden, var_type=value.data.var_type), value.span);
                    params[i] = Parameter.Named(value=info);

                    let init = name_expr(self.arena, hidden);
                    let binding = self.arena.alloc_pattern_let(PatternLetData(pattern=value.data.pattern, var_type=value.data.var_type,
                        init_expr=init, else_branch=Option<Block&>.None, is_parameter=true), value.span);
                    body.data.parameter_bindings.push(binding);
                },
                Named(_) => {},
            }
            i += 1;
        }
    }
}
impl AstVisitor for ParameterNormalizer {
    pub fn enter_item(node: Item&) -> bool {
        match &node.data {
            FuncDef(_, _, _, params, _, body) => self.normalize(params, *body), _ => {}
        }
        true
    }

    pub fn enter_expr(node: Expr&) -> bool {
        match &node.data {
            ClosureExpr(_, params, _, body) => self.normalize(params, *body), _ => {}
        }
        true
    }

    pub fn enter_method_def(node: MethodDef&) -> bool {
        self.normalize(&node.data.decl.data.params, node.data.body);
        true
    }
}

// Normalize pattern parameters of functions, methods, and closures in place; parameter bindings precede body statements in traversal.
pub fn normalize_parameters(tree: AstTree&) {
    let pass = ParameterNormalizer(arena=&tree.arena);
    walk_program(tree.root, &pass);
}
