from yianc.frontend.source import Position, Span;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;

extern "C" {
    fn yian_compiler_is_alphanumeric(code: u32) -> i32;
    fn yian_compiler_is_printable(code: u32) -> i32;
}

// Immutable Unicode tables make text classification independent of the process locale.
pub ffi fn is_alphanumeric(value: char) -> bool { yian_compiler_is_alphanumeric(u32(value)) != 0 }

pub ffi fn is_printable(value: char) -> bool { yian_compiler_is_printable(u32(value)) != 0 }

// The line index owns offsets only. All returned views borrow the original UTF-8 text.
pub struct SourceText {
    text: str,
    lines: Vec<u64>,
}

impl SourceText {
    static pub fn new(text: str) -> Self {
        let lines = Vec<u64>.new();
        lines.push(0);
        for entry in text.char_indices() {
            let offset = entry[0];
            let current = entry[1];
            if current == '\n' { lines.push(offset + 1); }
        }
        Self(text, lines)
    }

    pub fn offset(position: Position) -> u64 {
        let bytes = self.text.as_slice();
        if position.row >= self.lines.len() { return bytes.len(); }

        let begin = self.lines[position.row];
        let column = 0u64;
        for entry in str.from_slice_unchecked(bytes[begin..bytes.len()]).char_indices() {
            let offset = entry[0];
            let current = entry[1];
            if column == position.column || current == '\n' { return begin + offset; }
            column += 1;
        }
        bytes.len()
    }

    pub fn slice(span: Span) -> str {
        let begin = self.offset(span.start);
        let end = self.offset(span.end);
        if end < begin { return ""; }
        str.from_slice_unchecked(self.text.as_slice()[begin..end])
    }

    // The returned suffix borrows the same source storage as slice().
    pub fn tail(start: Position) -> str {
        str.from_slice_unchecked(self.text.as_slice()[self.offset(start)..self.text.as_slice().len()])
    }
}

impl Drop for SourceText {
    pub fn drop() { self.lines.drop(); }
}
