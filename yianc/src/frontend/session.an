from yianc.common.ids import UnitId;
from yianc.diagnostics.output import OutputError;
from yianc.frontend.prepare import FrontendPhase, PreparedFile, FrontendStageError, PreparationStage, prepare_file;
from yianc.frontend.source import SourceFile, SourceMap, SourceTable;
from std.collections.arena import Arena;
from std.core.iter import Iterator, IntoIterator;

pub struct CompilationUnit {
    pub id: UnitId,
    pub prepared: PreparedFile,
}

impl Drop for CompilationUnit {
    pub fn drop() {
        self.prepared.drop();
    }
}

// Observers borrow the partial frontend owner synchronously; preparation never retains them.
pub trait PreparationObserver {
    fn begin(pass_id: str) {}
    fn finish(pass_id: str, success: bool) {}
    fn stage_complete(stage: PreparationStage, session: FrontendSession&) -> Result<(), OutputError>;
}

// This owner keeps every source and prepared AST for one run. Permissions live in AnalysisSession.
pub struct FrontendSession {
    sources: SourceTable,
    units: Arena<CompilationUnit>,
}

impl FrontendSession {
    static pub fn new(sources: SourceTable) -> Self {
        Self(sources, Arena<CompilationUnit>.new())
    }

    // A lexed file transfers here in the same order as the frozen source table.
    pub fn accept(id: UnitId, prepared: PreparedFile) {
        if id.index != self.units.len() { @panic("invalid compilation unit order"); }
        self.sources.file(id);
        self.units.alloc(CompilationUnit(id, prepared));
    }

    pub fn unit(id: UnitId) -> Option<CompilationUnit&> {
        self.units.get(id.index)
    }

    pub fn unit_at(index: u64) -> Option<CompilationUnit&> {
        self.units.get(index)
    }

    pub fn source(id: UnitId) -> SourceFile& {
        self.sources.file(id)
    }

    pub fn source_count() -> u64 { self.sources.len() }
    pub fn len() -> u64 { self.units.len() }
    pub fn source_table() -> SourceTable& { &self.sources }

    pub fn prepare_source(unit: UnitId) -> Result<PreparedFile, FrontendStageError> {
        let file = self.sources.file(unit);
        prepare_file(unit, file.path(), file.text(), FrontendPhase.Tokens)
    }

    pub fn finish_preparation(result: Result<(), FrontendStageError>, unit: UnitId) -> Result<(), FrontendStageError> {
        self.sources.file(unit);
        result
    }
}

impl Drop for FrontendSession {
    pub fn drop() {
        for unit in self.units {
            unit.drop();
        }
        self.units.drop();
        self.sources.drop();
    }
}
