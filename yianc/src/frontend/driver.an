from yianc.common.names import NameInterner;
from yianc.common.ids import UnitId;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation, UserDiagnostic;
from yianc.diagnostics.output import OutputError;
from yianc.frontend.dump import StageDumps;
from yianc.frontend.prepare import FrontendStageError, PreparationStage;
from yianc.frontend.preparation import FrontendPreparation, PreparationObserver;
from yianc.frontend.source import SourceTable;
from yianc.frontend.unit import UnitTable;
from yianc.telemetry.trace import CompilerTrace;

pub enum FrontendError {
    Stage { error: FrontendStageError },
    Dump { error: OutputError },
}

impl UserDiagnostic for FrontendError {
    pub fn code() -> DiagnosticCode {
        match self { Stage(error) => error.code(), Dump(error) => error.code(), }
    }
    pub fn location() -> DiagnosticLocation {
        match self { Stage(error) => error.location(), Dump(error) => error.location(), }
    }
    pub fn message() -> String {
        match self { Stage(error) => error.message(), Dump(error) => error.message(), }
    }
}

impl Drop for FrontendError {
    pub fn drop() {
        match self { Stage(error) => error.drop(), Dump(error) => error.drop(), }
    }
}

fn stage_complete(observer: PreparationObserver&, stage: PreparationStage, preparation: FrontendPreparation&) -> Result<(), FrontendError> {
    match observer.stage_complete(stage, preparation) {
        Ok(_) => Result<(), FrontendError>.Ok(()),
        Err(error) => Result<(), FrontendError>.Err(FrontendError.Dump(error)),
    }
}

// Each stage processes the entire frozen input set before the next stage starts.
fn prepare_session(preparation: FrontendPreparation&, observer: PreparationObserver&, names: NameInterner&) -> Result<(), FrontendError> {
    let index: u64 = 0;
    while index < preparation.source_count() {
        let unit = UnitId(index);
        observer.begin("frontend.lex");
        let result = preparation.prepare_source(unit, names);
        observer.finish("frontend.lex", match &result { Ok(_) => true, Err(_) => false });
        let prepared = match result {
            Ok(value) => value,
            Err(error) => return Result<(), FrontendError>.Err(FrontendError.Stage(error)),
        };
        preparation.accept(unit, prepared);
        index += 1;
    }
    stage_complete(observer, PreparationStage.Lex, preparation)?;

    index = 0;
    while index < preparation.len() {
        let unit = UnitId(index);
        let staged = preparation.unit(unit).unwrap();
        observer.begin("frontend.parse");
        let result = staged.parse(unit, names);
        observer.finish("frontend.parse", match &result { Ok(_) => true, Err(_) => false });
        match preparation.finish_preparation(result, unit) {
            Ok(_) => {},
            Err(error) => return Result<(), FrontendError>.Err(FrontendError.Stage(error)),
        }
        index += 1;
    }
    stage_complete(observer, PreparationStage.Parse, preparation)?;

    index = 0;
    while index < preparation.len() {
        let unit = UnitId(index);
        let staged = preparation.unit(unit).unwrap();
        let file = preparation.source(unit);
        observer.begin("frontend.desugar");
        let result = staged.desugar(unit, file.path(), names);
        observer.finish("frontend.desugar", match &result { Ok(_) => true, Err(_) => false });
        match preparation.finish_preparation(result, unit) {
            Ok(_) => {},
            Err(error) => return Result<(), FrontendError>.Err(FrontendError.Stage(error)),
        }
        index += 1;
    }
    stage_complete(observer, PreparationStage.Desugar, preparation)?;
    Result<(), FrontendError>.Ok(())
}

pub struct FrontendDriver {
    preparation: Option<FrontendPreparation>,
    trace: CompilerTrace&,
    names: NameInterner&,
    attempted: bool,
    dump: bool,
}

impl FrontendDriver {
    static pub fn new(sources: SourceTable, dump: bool, trace: CompilerTrace&, names: NameInterner&) -> Self {
        Self(Option<FrontendPreparation>.Some(FrontendPreparation.new(sources)), trace, names, false, dump)
    }

    // The completed table is the result; a failed run keeps the preparation for source_table() reporting.
    pub fn run() -> Result<UnitTable, FrontendError> {
        if self.attempted { @panic("frontend driver has already run"); }
        self.attempted = true;
        let dumps = StageDumps(self.dump, self.trace);
        {
            let preparation = match &self.preparation {
                Some(value) => value,
                None => @panic("frontend preparation is not available"),
            };
            prepare_session(preparation, &dumps, self.names)?;
        }
        match self.preparation.take() {
            Some(value) => {
                let units = value.finish();
                value.drop();
                Result<UnitTable, FrontendError>.Ok(units)
            },
            None => @panic("prepared frontend preparation is not available"),
        }
    }

    // Valid only after a failed run; success transfers the sources to the returned table.
    pub fn source_table() -> SourceTable& {
        match &self.preparation {
            Some(value) => value.source_table(),
            None => @panic("frontend preparation is not available"),
        }
    }
}

impl Drop for FrontendDriver {
    pub fn drop() { match &self.preparation { Some(value) => value.drop(), None => {}, } }
}
