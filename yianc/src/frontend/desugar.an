from yianc.frontend.ast.arena import AstTree;
from yianc.frontend.desugar.error import DesugarError;
from yianc.frontend.desugar.parameters import normalize_parameters;
from yianc.frontend.desugar.control import lower_control;
from yianc.frontend.desugar.expressions import lower_expressions;
from yianc.frontend.desugar.propagation import validate_propagation, lower_propagation;

// Validation failures leave the AST untouched; successful lowering represents syntax sugar as ordinary control flow and calls.
pub fn desugar(tree: AstTree&, path: str) -> Result<void, DesugarError> {
    validate_propagation(tree.root)?;

    // Normalize parameter bindings and control flow before expanding propagation in the existing callable context.
    normalize_parameters(tree);
    lower_control(tree, path);
    lower_expressions(tree);
    lower_propagation(tree);

    Result<void, DesugarError>.Ok({})
}
