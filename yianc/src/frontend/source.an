from std.core.path import PathBuf;
from yianc.common.ids import UnitId;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation;
from yianc.input_error import InputError;
from std.collections.sort import sort_by;
from std.core.convert import From;
from std.core.fs import Directory, DirEntryKind, metadata, read_to_string, canonicalize, resolve;
from std.core.io import IoError, IoErrorKind;
from std.core.ops import Add, AddAssign, Index;
from std.core.iter import Iterator, IntoIterator;
from json.write import Writer;

pub struct Position {
    pub row: u64,
    pub column: u64,
}

pub struct Span {
    pub start: Position,
    pub end: Position,
}

impl Span {
    // Write start and end coordinates as fields of an already-open JSON object.
    pub fn write_json(output: Writer&) {
        output.key("start");
        output.begin_array();
        output.write_u64(self.start.row);
        output.write_u64(self.start.column);
        output.end_array();

        output.key("end");
        output.begin_array();
        output.write_u64(self.end.row);
        output.write_u64(self.end.column);
        output.end_array();
    }
}

impl Add<Span, Span> for Span {
    pub fn add(other: Span) -> Span {
        let start = self.start;
        if other.start.row < start.row ||
        (other.start.row == start.row && other.start.column < start.column) {
            start = other.start;
        }

        let end = self.end;
        if other.end.row > end.row ||
        (other.end.row == end.row && other.end.column > end.column) {
            end = other.end;
        }

        return Span(start=start, end=end);
    }
}

impl AddAssign<Span, Span> for Span {
    pub fn add_assign(other: Span) -> Span {
        let merged = *self + other;
        self.start = merged.start;
        self.end = merged.end;
        return *self;
    }
}

pub struct SourceFile {
    // Disk input is newline-normalized; in-memory input keeps the caller's text.
    text: String,
    // Canonical source path, used as identity and by diagnostics, dumps and output naming.
    path: PathBuf,
}

pub struct SourceCollectionError {
    pub path: String,
    pub error: IoError,
}

impl Drop for SourceCollectionError {
    pub fn drop() { self.path.drop(); self.error.drop(); }
}

fn collection_error(path: str, error: IoError) -> SourceCollectionError {
    SourceCollectionError(String.from(&path), error)
}

impl SourceFile {
    static pub fn new(path: PathBuf, text: String) -> Self { Self(text, path) }

    pub fn path() -> str { self.path.as_str() }

    pub fn text() -> str { return self.text.as_str(); }
}

impl Drop for SourceFile {
    pub fn drop() {
        self.text.drop();
        self.path.drop();
    }
}

pub trait SourceMap {
    fn file(unit: UnitId) -> SourceFile&;
}

pub struct SourceTable {
    // UnitId is the storage key; duplicate paths are resolved by scanning file metadata.
    files: Vec<SourceFile>,
}

impl SourceTable {
    static pub fn new() -> Self {
        Self(Vec<SourceFile>.new())
    }

    // Load every yianc input once; duplicate canonical paths are skipped before reading.
    static pub fn from_paths(paths: Vec<String>&) -> Result<Self, SourceCollectionError> {
        let files = Vec<SourceFile>.new();
        let accepted = false;
        defer { if !accepted { release_files(&files); } };
        for path in *paths {
            let canonical = match canonicalize(path.as_str()) {
                Ok(value) => value,
                Err(error) => return Result<Self, SourceCollectionError>.Err(collection_error(path.as_str(), error)),
            };
            let duplicate = false;
            let current = 0u64;
            while current < files.len() {
                if files[current].path() == canonical.as_str() {
                    duplicate = true;
                    break;
                }
                current += 1u64;
            }
            if duplicate {
                canonical.drop();
                continue;
            }
            let text = match read_source(path.as_str()) {
                Ok(value) => value,
                Err(error) => {
                    canonical.drop();
                    return Result<Self, SourceCollectionError>.Err(collection_error(path.as_str(), error));
                },
            };
            files.push(SourceFile(text, canonical));
        }
        accepted = true;
        Result<Self, SourceCollectionError>.Ok(Self(files))
    }

    // Build the immutable table from caller-owned source files; duplicate conflicts are rejected.
    static pub fn from_files(files: Vec<SourceFile>) -> Result<Self, InputError> {
        let index = 0u64;
        while index < files.len() {
            let next = index + 1u64;
            while next < files.len() {
                if files[index].path() == files[next].path() && files[index].text() != files[next].text() {
                    let path = String.from(&files[index].path());
                    let release = 0u64;
                    while release < files.len() { files[release].drop(); release += 1u64; }
                    files.drop();
                    return Result<Self, InputError>.Err(InputError(DiagnosticCode.Source,
                        DiagnosticLocation.File(path), String.from(&"conflicting source text for path")));
                }
                next += 1u64;
            }
            index += 1u64;
        }
        let accepted = Vec<SourceFile>.new();
        while files.len() > 0 {
            let source = files.remove(0u64);
            let duplicate = false;
            let current = 0u64;
            while current < accepted.len() {
                if accepted[current].path() == source.path() {
                    duplicate = true;
                    break;
                }
                current += 1u64;
            }
            if duplicate { source.drop(); } else { accepted.push(source); }
        }
        Result<Self, InputError>.Ok(Self(accepted))
    }

    pub fn len() -> u64 { self.files.len() }
}

impl SourceMap for SourceTable {
    pub fn file(unit: UnitId) -> SourceFile& {
        match self.files.as_slice().get(unit.index) {
            Some(file) => file,
            None => @panic("invalid source unit ID"),
        }
    }
}

impl Drop for SourceTable {
    pub fn drop() {
        let index: u64 = 0;
        while index < self.files.len() {
            self.files[index].drop();
            index += 1;
        }
        self.files.drop();
    }
}

// Match text-mode source loading: CRLF and bare CR become one LF before lexing or formatting.
// The returned buffer has one owner; unchanged UTF-8 input is transferred without copying.
pub fn read_source(path: str) -> Result<String, IoError> {
    let raw = read_to_string(path)?;
    if !raw.as_str().contains_char('\r') { return Result<String, IoError>.Ok(raw); }
    defer raw.drop();

    let result = String.new();
    let bytes = raw.as_slice();
    let begin = 0u64;
    let index = 0u64;
    while index < bytes.len() {
        if bytes[index] != b'\r' { index += 1; continue; }
        result.push_str(str.from_slice_unchecked(bytes[begin..index]));
        result.push('\n');
        index += 1;
        if index < bytes.len() && bytes[index] == b'\n' { index += 1; }
        begin = index;
    }
    result.push_str(str.from_slice_unchecked(bytes[begin..bytes.len()]));
    Result<String, IoError>.Ok(result)
}

fn less(left: str, right: str) -> bool {
    let a = left.as_slice();
    let b = right.as_slice();
    let limit = a.len();
    if b.len() < limit {
        limit = b.len();
    }

    let index: u64 = 0u64;

    while index < limit {
        if a[index] < b[index] {
            return true;
        }

        if a[index] > b[index] {
            return false;
        }
        index += 1u64;
    }

    return a.len() < b.len();
}

// Sort only paths appended by this directory collection; preceding input roots retain their order.
fn sort_paths(paths: Vec<String>&, start: u64) {
    sort_by(paths.as_slice()[start..paths.len()], path_less);
}

fn path_less(left: String&, right: String&) -> bool {
    // pathlib orders path components, so directory "cli" sorts before sibling "cli.an".
    let a = left.as_slice();
    let b = right.as_slice();
    let begin_a = 0u64;
    let begin_b = 0u64;
    loop {
        let end_a = begin_a;
        let end_b = begin_b;
        while end_a < a.len() && a[end_a] != b'/' { end_a += 1; }
        while end_b < b.len() && b[end_b] != b'/' { end_b += 1; }
        let component_a = str.from_slice_unchecked(a[begin_a..end_a]);
        let component_b = str.from_slice_unchecked(b[begin_b..end_b]);
        if component_a != component_b { return less(component_a, component_b); }
        if end_a == a.len() || end_b == b.len() { return end_a == a.len() && end_b != b.len(); }
        begin_a = end_a + 1;
        begin_b = end_b + 1;
    }
}

// Recurse into actual directories; collect symlinks only when they target source files, never recurse into linked directories.
fn collect_dir(path: str, paths: Vec<String>&) -> Result<(), SourceCollectionError> {
    let directory = match Directory.open(path) {
        Ok(value) => value,
        Err(error) => return Result<(), SourceCollectionError>.Err(collection_error(path, error)),
    };
    defer directory.drop();

    loop {
        let next = match directory.next() {
            Ok(value) => value,
            Err(error) => return Result<(), SourceCollectionError>.Err(collection_error(path, error)),
        };
        let entry = match next {
            Some(value) => value,
            None => {
                break;
            },
        };
        defer entry.drop();
        let child = entry.path().as_str();
        let kind = entry.kind();
        if kind == DirEntryKind.Directory {
            collect_dir(child, paths)?;
        } elif kind == DirEntryKind.File {
            if entry.name().ends_with(".an") {
                paths.push(String.from(&child));
            }
        } elif kind == DirEntryKind.Link {
            let info = match entry.metadata() {
                Ok(value) => value,
                Err(error) => return Result<(), SourceCollectionError>.Err(collection_error(child, error)),
            };
            if info.is_file() && entry.name().ends_with(".an") {
                paths.push(String.from(&child));
            }
        }
    }

    Result<(), SourceCollectionError>.Ok(val=())
}

fn release_paths(paths: Vec<String>&) {
    let index = 0u64;

    while index < paths.len() {
        paths[index].drop();
        index += 1u64;
    }
    paths.drop();
}

fn release_files(files: Vec<SourceFile>&) {
    for file in *files { file.drop(); }
    files.drop();
}

// Preserve command-line root order and sort files within each directory; release collected paths on failure.
pub fn collect_sources(inputs: Vec<String>&) -> Result<Vec<String>, SourceCollectionError> {
    let paths = Vec<String>.new();
    let transferred = false;
    defer {
        if !transferred {
            release_paths(&paths);
        }
    };

    let index = 0u64;

    while index < inputs.len() {
        let root = inputs[index].as_str();
        let info = match metadata(root) {
            Ok(value) => value,
            Err(error) => return Result<Vec<String>, SourceCollectionError>.Err(collection_error(root, error)),
        };
        if info.is_dir() {
            let start = paths.len();
            collect_dir(root, &paths)?;
            sort_paths(&paths, start);
        } elif info.is_file() {
            if root.ends_with(".an") {
                paths.push(String.from(&root));
            }
        } else {
            let error = IoError.new(IoErrorKind.InvalidInput, "source path is not a file or directory");
            let contextual = error.with_path(root);
            error.drop();
            return Result<Vec<String>, SourceCollectionError>.Err(collection_error(root, contextual));
        }
        index += 1u64;
    }

    transferred = true;
    Result<Vec<String>, SourceCollectionError>.Ok(val=paths)
}
