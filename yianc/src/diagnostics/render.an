from yianc.diagnostics.model import UserDiagnostic, DiagnosticLocation;
from yianc.frontend.source import SourceMap, Span;
from std.core.fmt import ToString;
from std.core.iter import Iterator, IntoIterator;

// The caller owns the returned text; locations are resolved while the map is live.
pub fn render(diagnostic: UserDiagnostic&, sources: SourceMap&) -> String {
    let text = String.new();
    text.push_str(match diagnostic.severity() { Error => "error[", Warning => "warning[", Note => "note[", });
    text.push_str(diagnostic.code().text());
    text.push_str("]: ");
    let message = diagnostic.message();
    defer message.drop();
    text.push_str(message.as_str());
    let location = diagnostic.location();
    defer location.drop();
    match &location {
        Global => {},
        File(path) => {
            text.push_str("\n--> ");
            text.push_str(path.as_str());
        },
        Source(value) => {
            let file = sources.file(value.unit);
            append_location_block(&text, file.path(), file.text(), value.span);
        },
    }
    text
}

fn append_location_block(text: String&, path: str, source: str, span: Span) {
    text.push_str("\n--> ");
    text.push_str(path);
    let row = (span.start.row + 1).to_string();
    defer row.drop();
    let column = (span.start.column + 1).to_string();
    defer column.drop();
    text.push(':');
    text.push_str(row.as_str());
    text.push(':');
    text.push_str(column.as_str());
    match source_line(source, span.start.row) {
        Some(line) => {
            defer line.drop();
            text.push_str("\n    ");
            text.push_str(line.as_str());
            text.push_str("\n    ");
            append_indent(text, span.start.column);
            append_carets(text, marker_width(line.as_str(), span));
        },
        None => {},
    }
}

fn append_indent(text: String&, count: u64) {
    let index = 0u64;
    while index < count {
        text.push(' ');
        index += 1;
    }
}

fn append_carets(text: String&, count: u64) {
    let index = 0u64;
    while index < count {
        text.push('^');
        index += 1;
    }
}

fn scalar_count(value: str) -> u64 {
    let count = 0u64;
    for _ in value.chars() {
        count += 1;
    }
    count
}

// The caret line is omitted when the requested source row is absent.
fn source_line(text: str, row: u64) -> Option<String> {
    let result = String.new();
    let current = 0u64;
    let started = false;
    for ch in text.chars() {
        if current == row {
            if !started {
                started = true;
            }
            if ch == '\n' || ch == '\r' {
                break;
            }
            result.push(ch);
        } elif ch == '\n' {
            current += 1;
        }
    }
    if !started {
        result.drop();
        return Option<String>.None;
    }
    Option<String>.Some(result)
}

fn marker_width(line: str, span: Span) -> u64 {
    if span.start.row == span.end.row {
        if span.end.column > span.start.column {
            return span.end.column - span.start.column;
        }
        return 1u64;
    }
    let length = scalar_count(line);
    if length > span.start.column {
        return length - span.start.column;
    }
    1u64
}
