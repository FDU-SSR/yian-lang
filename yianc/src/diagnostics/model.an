from yianc.common.location import SourceSpan;
from yianc.frontend.source import Span;
from std.core.convert import From;
from std.core.fmt import ToString;

pub enum DiagnosticCode {
    UnterminatedComment,
    FString,
    Escape,
    UnterminatedLiteral,
    Lexical,
    EndOfInput,
    ExpectedToken,
    UnexpectedToken,
    ReservedWord,
    Syntax,
    Source,
    Duplicate,
    Undefined,
    UnknownType,
    ImportNotFound,
    NotPublic,
    NotAType,
    ImportEntry,
    UnknownPackage,
    NotDependency,
    NotModule,
    Resolution,
    Access,
    TypeMismatch,
    Inference,
    NoSuchField,
    NoSuchMethod,
    UnsupportedOperator,
    CircularAlias,
    RecursiveStorage,
    Type,
    Restricted,
    ControlFlow,
    Coverage,
    Uninitialized,
    UnreachablePattern,
    UnnecessaryPreludeImport,
    Unsupported,
    GenericArguments,
    Constant,
    Internal,
    CommandLine,
    LogConfiguration,
    OutputIo,
    NativeTool,
    ProfileOutput,
}

impl DiagnosticCode {
    pub fn text() -> str {
        match self {
            UnterminatedComment => "E101",
            FString => "E102",
            Escape => "E103",
            UnterminatedLiteral => "E105",
            Lexical => "E199",
            EndOfInput => "E201",
            ExpectedToken => "E202",
            UnexpectedToken => "E203",
            ReservedWord => "E204",
            Syntax => "E299",
            Source => "E399",
            Duplicate => "E303",
            Undefined => "E301",
            UnknownType => "E302",
            ImportNotFound => "E304",
            NotPublic => "E305",
            NotAType => "E306",
            ImportEntry => "E307",
            UnknownPackage => "E308",
            NotDependency => "E309",
            NotModule => "E310",
            Resolution => "E399",
            Access => "E399",
            TypeMismatch => "E401",
            Inference => "E402",
            NoSuchField => "E403",
            NoSuchMethod => "E404",
            UnsupportedOperator => "E406",
            CircularAlias => "E407",
            RecursiveStorage => "E599",
            Type => "E499",
            ControlFlow => "E499",
            Restricted => "E501",
            Coverage => "E504",
            Uninitialized => "E502",
            UnreachablePattern => "W501",
            UnnecessaryPreludeImport => "W502",
            Unsupported => "E598",
            GenericArguments => "E405",
            Constant => "E503",
            Internal => "E599",
            CommandLine => "E601",
            LogConfiguration => "E602",
            OutputIo => "E603",
            NativeTool => "E604",
            ProfileOutput => "W601",
        }
    }

    pub fn severity() -> Severity {
        let text = self.text().as_slice();
        if text.len() == 0 { @panic("empty diagnostic code"); }
        match text[0] {
            b'E' => Severity.Error,
            b'W' => Severity.Warning,
            b'N' => Severity.Note,
            _ => @panic("invalid diagnostic code severity"),
        }
    }
}

pub enum Severity {
    Error,
    Warning,
    Note,
}

pub trait UserDiagnostic {
    fn message() -> String;
    fn location() -> DiagnosticLocation;
    fn code() -> DiagnosticCode;

    fn severity() -> Severity {
        self.code().severity()
    }
}

pub trait DiagnosticReporter {
    fn report(diagnostic: UserDiagnostic&);
}

pub enum AnalysisStage {
    Lex, Parse, Desugar, Prelude, Restricted, Resolve, Finalize, TypeCheck, Coverage, Assignment, Codegen,
}

impl AnalysisStage {
    pub fn name() -> str {
        match self {
            Lex => "lex", Parse => "parse", Desugar => "desugar", Prelude => "prelude",
            Restricted => "restricted_ops", Resolve => "resolve", Finalize => "finalize",
            TypeCheck => "type_check", Coverage => "match_coverage", Assignment => "definite_assignment", Codegen => "codegen",
        }
    }
}

pub enum AnalysisErrorKind {
    User,
    NotConstant,
    NoCandidate,
    Unsupported,
}

// File locations own their paths; source locations borrow the session identity.
pub enum DiagnosticLocation {
    Global,
    File { path: String },
    Source { value: SourceSpan },
}

impl DiagnosticLocation {
    pub fn span() -> Option<Span> {
        match self {
            Source(value) => Option<Span>.Some(value.span),
            _ => Option<Span>.None,
        }
    }

    pub fn copy() -> Self {
        match self {
            Global => Self.Global,
            File(path) => Self.File(String.from(&path.as_str())),
            Source(value) => Self.Source(*value),
        }
    }
}

impl Drop for DiagnosticLocation {
    pub fn drop() {
        match self {
            File(path) => path.drop(),
            _ => {},
        }
    }
}

pub struct AnalysisError {
    pub kind: AnalysisErrorKind,
    pub code: DiagnosticCode,
    pub location: DiagnosticLocation,
    pub message: String,
    pub stage: Option<AnalysisStage>,
}

impl AnalysisError {
    pub fn with_stage(stage: AnalysisStage) -> Self {
        self.stage = Option<AnalysisStage>.Some(stage);
        *self
    }

    pub fn with_location(location: SourceSpan) -> Self {
        match &self.location {
            Global => self.location = DiagnosticLocation.Source(location),
            _ => {},
        };
        *self
    }

    pub fn with_message(message: str) -> Self {
        let owned = String.from(&message);
        self.message.drop();
        self.message = owned;
        *self
    }

    static pub fn user(code: DiagnosticCode, location: Option<SourceSpan>, message: str) -> Self {
        if code.severity() != Severity.Error { @panic("analysis error requires an error code"); }
        let primary = match location {
            Some(value) => DiagnosticLocation.Source(value),
            None => DiagnosticLocation.Global,
        };
        Self(AnalysisErrorKind.User, code, primary, String.from(&message), Option<AnalysisStage>.None)
    }

    static pub fn named(code: DiagnosticCode, location: Option<SourceSpan>, prefix: str, name: str, suffix: str) -> Self {
        let message = String.from(&prefix);
        defer message.drop();
        message.push_str(name);
        message.push_str(suffix);
        Self.user(code, location, message.as_str())
    }

    static pub fn arity(location: Option<SourceSpan>, subject: str, expected: u64, actual: u64, generic: bool) -> Self {
        let message = String.from(&subject);
        defer message.drop();
        let wanted = expected.to_string();
        defer wanted.drop();
        let provided = actual.to_string();
        defer provided.drop();
        message.push_str(" expects ");
        message.push_str(wanted.as_str());
        message.push_str(if generic { " generic arguments, got " } else { " arguments, got " });
        message.push_str(provided.as_str());
        Self.user(DiagnosticCode.GenericArguments, location, message.as_str())
    }

    static pub fn unsupported(location: Option<SourceSpan>, message: str) -> Self {
        let error = Self.user(DiagnosticCode.Unsupported, location, message);
        error.kind = AnalysisErrorKind.Unsupported;
        error
    }
}

impl UserDiagnostic for AnalysisError {
    pub fn message() -> String { String.from(&self.message.as_str()) }
    pub fn location() -> DiagnosticLocation { self.location.copy() }
    pub fn code() -> DiagnosticCode { self.code }
}

impl Drop for AnalysisError {
    pub fn drop() {
        self.location.drop();
        self.message.drop();
    }
}

pub struct MessageBuilder {
    text: String
}

impl MessageBuilder {
    static pub fn new() -> Self {
        Self(String.new())
    }

    pub fn append(text: str) {
        self.text.push_str(text);
    }

    pub fn number(value: u64) {
        let text = value.to_string();
        defer text.drop();
        self.append(text.as_str());
    }

    pub fn finish() -> String {
        let result = self.text;
        self.text = String.new();
        result
    }
}

impl Drop for MessageBuilder {
    pub fn drop() {
        self.text.drop();
    }
}
