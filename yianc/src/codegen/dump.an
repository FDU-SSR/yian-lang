from yianc.codegen.cfg.ids import FunctionId, BlockId, ValueId, ScopeId;
from yianc.codegen.cfg.model import CfgModule, SafetyStage, GuardKind, GuardSite;
from yianc.codegen.representation import PointerRepresentation;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation;
from yianc.diagnostics.output import OutputError;
from yianc.json_output import write_json;
from json.write import Writer;
from std.core.convert import From;
from std.core.fmt import ToString;
from std.core.fs import write;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;

fn stage_name(stage: SafetyStage) -> str {
    match stage { Neutral => "neutral", Prepared => "prepared", Optimized => "optimized" }
}

fn representation_name(representation: PointerRepresentation) -> str {
    match representation {
        NonPointer => "non-pointer", ZeroSized => "zero-sized", RawAddress => "raw-address",
        RawView => "raw-view", RawTraitObject => "raw-trait-object", FatPointer => "fat-pointer",
        FatReference => "fat-reference", FatView => "fat-view", FatTraitObject => "fat-trait-object",
    }
}

fn guard_kind_name(kind: GuardKind) -> str {
    match kind {
        ByteExtent => "byte-extent", AllocationSize => "allocation-size", AllocationResult => "allocation-result",
        HeapRoot => "heap-root", PointerStep => "pointer-step", PointerDifference => "pointer-difference",
        PointerOrder => "pointer-order", IndexOffset => "index-offset", ViewParts => "view-parts",
        SliceRange => "slice-range", ArgumentIndex => "argument-index", ArgumentData => "argument-data",
        PointerRemaining => "pointer-remaining", CastAccess => "cast-access", CastView => "cast-view",
        CastNonempty => "cast-nonempty", DynamicReceiver => "dynamic-receiver",
    }
}

fn guard_site_name(site: GuardSite) -> str {
    match site { Before => "before", AfterAllocation => "after-allocation", BeforeRelease => "before-release", AfterArgumentLoad => "after-argument-load" }
}

pub fn cfg_dump(module: CfgModule&) -> Result<(), OutputError> {
    let output = Writer.with_max_depth(512u64);
    defer output.drop();
    output.begin_array();
    for index in 0u64..module.len() {
        let function = *module.function(FunctionId(index)).unwrap();
        output.begin_object();
        output.key("function");
        output.write_u64(index);
        output.key("callable");
        output.write_u64(function.callable.index);
        output.key("result");
        output.write_u64(function.result_type.index);
        output.key("parameters");
        output.begin_array();
        for parameter in function.parameters { output.write_u64(parameter.index); }
        output.end_array();
        output.key("safety_stage");
        output.write_string(stage_name(module.safety_stage));
        output.key("scopes");
        output.begin_array();
        for scope_index in 0u64..function.scopes.len() {
            let scope = match function.scope(ScopeId(scope_index)) { Ok(value) => value, Err(problem) => { @panic("invalid CFG while dumping"); }, };
            output.begin_object();
            output.key("id");
            output.write_u64(scope_index);
            output.key("parent");
            match scope.parent { Some(value) => output.write_u64(value.index), None => output.write_null(), }
            output.key("callable");
            output.write_u64(scope.callable.index);
            output.key("needs_lock");
            match &function.fat_plan {
                Some(plan) => output.write_bool(plan.scopes[scope_index].needs_lock),
                None => output.write_null(),
            }
            output.end_object();
        }
        output.end_array();
        output.key("representations");
        output.begin_array();
        for representation in module.representations {
            output.begin_object();
            output.key("type");
            output.write_u64(representation.type_id.index);
            output.key("representation");
            output.write_string(representation_name(representation.representation));
            output.end_object();
        }
        output.end_array();
        output.key("values");
        output.begin_array();
        for index in 0u64..function.value_count() {
            let value = match function.value(ValueId(index)) { Ok(value) => value, Err(problem) => { @panic("invalid CFG while dumping"); }, };
            output.begin_object();
            output.key("id");
            output.write_u64(index);
            output.key("type");
            output.write_u64(value.type_id.index);
            match &value.kind {
                Integer(bits) => { output.key("integer"); output.write_u64(*bits); },
                Float(value) => {
                    let text = value.to_string();
                    defer text.drop();
                    output.key("float");
                    output.write_string(text.as_str());
                },
                Zero => { output.key("kind"); output.write_string("zero"); },
                Undef => { output.key("kind"); output.write_string("undef"); },
                Bytes(name) => { output.key("name"); output.write_u64(name.index); },
                Parameter(index) => { output.key("parameter"); output.write_u64(*index); },
                Function(callable) => { output.key("callable"); output.write_u64(callable.index); },
                Temporary(block, position) => {
                    output.key("block");
                    output.write_u64(block.index);
                    output.key("instruction");
                    output.write_u64(*position);
                },
            }
            output.end_object();
        }
        output.end_array();
        output.key("blocks");
        output.begin_array();
        for index in 0u64..function.block_count() {
            let block = match function.block(BlockId(index)) { Ok(value) => value, Err(problem) => { @panic("invalid CFG while dumping"); }, };
            output.begin_object();
            output.key("block");
            output.write_u64(index);
            output.key("instructions");
            output.begin_array();
            for instruction in block.instructions {
                output.begin_object();
                output.key("operation");
                output.write_string(instruction.operation.name());
                output.key("result");
                match instruction.result { Some(value) => output.write_u64(value.index), None => output.write_null(), }
                output.key("operands");
                output.begin_array();
                let operands = instruction.operation.operands();
                defer operands.drop();
                for operand in operands { output.write_u64(operand.index); }
                output.end_array();
                output.key("checks");
                output.begin_array();
                for check in instruction.checks {
                    output.begin_object();
                    output.key("kind");
                    output.write_string(check.name());
                    match check {
                        Access(_, kind) | Live(_, kind) | AccessBounds(_, kind) => { output.key("code"); output.write_string(kind.code()); },
                        _ => {},
                    }
                    output.key("operands");
                    output.begin_array();
                    let operands = check.operands();
                    defer operands.drop();
                    for operand in operands { output.write_u64(operand.index); }
                    output.end_array();
                    output.end_object();
                }
                output.end_array();
                output.key("guards");
                output.begin_array();
                for guard_record in instruction.guards {
                    output.begin_object();
                    output.key("kind");
                    output.write_string(guard_kind_name(guard_record.kind));
                    output.key("site");
                    output.write_string(guard_site_name(guard_record.site));
                    output.end_object();
                }
                output.end_array();
                output.key("live_proofs");
                output.begin_array();
                for proof in instruction.live_proofs {
                    output.begin_object();
                    output.key("address");
                    output.write_u64(proof.address.index);
                    output.key("witness");
                    output.begin_object();
                    output.key("block");
                    output.write_u64(proof.witness.block.index);
                    output.key("instruction");
                    output.write_u64(proof.witness.instruction);
                    output.key("check");
                    output.write_u64(proof.witness.check);
                    output.end_object();
                    output.end_object();
                }
                output.end_array();
                match &instruction.operation {
                    Binary(op, _, _) => { output.key("operator"); output.write_string(op.spelling()); },
                    Unary(op, _) => { output.key("operator"); output.write_string(op.spelling()); },
                    Call(callable, _) => { output.key("callee"); output.write_u64(callable.index); },
                    Builtin(kind, type_args, _) => {
                        output.key("builtin");
                        output.write_string(kind.spelling());
                        output.key("types");
                        output.begin_array();
                        for type_id in *type_args { output.write_u64(type_id.index); }
                        output.end_array();
                    },
                    EnumConstruct(tag, _) => { output.key("tag"); output.write_u64(*tag); },
                    EnumInitAt(_, enumeration, discriminant, _) => {
                        output.key("enum");
                        output.write_u64(enumeration.index);
                        output.key("tag");
                        output.write_u64(*discriminant);
                    },
                    EnumTagAt(_, enumeration) | EnumCopyAt(_, _, enumeration) => {
                        output.key("enum");
                        output.write_u64(enumeration.index);
                    },
                    EnumFieldAt(_, enumeration, discriminant, field) => {
                        output.key("enum");
                        output.write_u64(enumeration.index);
                        output.key("tag");
                        output.write_u64(*discriminant);
                        output.key("field");
                        output.write_u64(*field);
                    },
                    Extract(_, field) | FieldAddress(_, _, field) => { output.key("field"); output.write_u64(*field); },
                    ScopeEnter(scope) | ScopeExit(scope) => { output.key("scope"); output.write_u64(scope.index); },
                    _ => {},
                }
                output.end_object();
            }
            output.end_array();
            output.key("terminator");
            output.begin_object();
            match &*block.terminator.unwrap() {
                Return(value) => {
                    output.key("kind");
                    output.write_string("return");
                    output.key("value");
                    match value { Some(id) => output.write_u64(id.index), None => output.write_null(), }
                },
                Jump(destination) => { output.key("jump"); output.write_u64(destination.index); },
                Branch(condition, yes, no) => {
                    output.key("condition");
                    output.write_u64(condition.index);
                    output.key("yes");
                    output.write_u64(yes.index);
                    output.key("no");
                    output.write_u64(no.index);
                },
                Unreachable => { output.key("kind"); output.write_string("unreachable"); },
            }
            output.end_object();
            output.end_object();
        }
        output.end_array();
        output.end_object();
    }
    output.end_array();
    write_json(&output, "build/cfg.txt")
}

pub fn ir_dump(bytes: Vec<u8>&) -> Result<(), OutputError> {
    match write("build/ir.ll", bytes.as_slice()) {
        Ok(_) => Result<(), OutputError>.Ok(()),
        Err(problem) => {
            let message = String.from(&problem.msg());
            problem.drop();
            Result<(), OutputError>.Err(OutputError(message, DiagnosticCode.OutputIo,
                DiagnosticLocation.File(String.from(&"build/ir.ll"))))
        },
    }
}
