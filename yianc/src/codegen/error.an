from yianc.diagnostics.model import AnalysisError, AnalysisErrorKind, AnalysisStage, DiagnosticCode, DiagnosticLocation, UserDiagnostic;
from yianc.common.location import SourceSpan;
from std.core.convert import From;

pub enum CodegenErrorKind {
    User,
    LLVM,
    Target,
}

pub struct CodegenError {
    pub kind: CodegenErrorKind,
    pub code: DiagnosticCode,
    pub location: DiagnosticLocation,
    pub message: String,
    pub stage: Option<AnalysisStage>,
}

impl CodegenError {
    pub fn with_location(span: SourceSpan) -> Self {
        match &self.location {
            Global => self.location = DiagnosticLocation.Source(span),
            _ => {},
        };
        *self
    }

    static pub fn target(message: str) -> Self {
        Self(CodegenErrorKind.Target, DiagnosticCode.Unsupported, DiagnosticLocation.Global,
            String.from(&message), Option<AnalysisStage>.None)
    }

    static pub fn unsupported(span: SourceSpan, message: str) -> Self {
        Self(CodegenErrorKind.Target, DiagnosticCode.Unsupported, DiagnosticLocation.Source(span),
            String.from(&message), Option<AnalysisStage>.None)
    }

    static pub fn llvm_error(message: Vec<u8>) -> Self {
        defer message.drop();
        let text = match str.from_slice(message.as_slice()) {
            Some(value) => value,
            None => "LLVM returned a non-UTF-8 error",
        };
        Self(CodegenErrorKind.LLVM, DiagnosticCode.Internal, DiagnosticLocation.Global,
            String.from(&text), Option<AnalysisStage>.None)
    }
}

impl From<AnalysisError> for CodegenError {
    static pub fn from(value: AnalysisError&) -> Self {
        let kind = match value.kind {
            Unsupported => CodegenErrorKind.Target,
            User => CodegenErrorKind.User,
            _ => @panic("analysis probe result entered code generation"),
        };
        Self(kind, value.code, value.location, value.message, value.stage)
    }
}

impl UserDiagnostic for CodegenError {
    pub fn code() -> DiagnosticCode { self.code }
    pub fn location() -> DiagnosticLocation { self.location.copy() }
    pub fn message() -> String { String.from(&self.message.as_str()) }
}

impl Drop for CodegenError {
    pub fn drop() {
        self.location.drop();
        self.message.drop();
    }
}
