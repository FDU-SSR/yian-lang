from yianc.codegen.llvm.module import FunctionLowering;
from yianc.codegen.cfg.model import GuardKind, GuardSite;
from yianc.codegen.llvm.scalar import cast;
from yianc.codegen.error import CodegenError;
from yianc.codegen.abi.runtime import ENV_WORD, LITERAL_WORD, FAT_MAX_EXTENT_BYTES;
from yianc.common.ids import TypeId;
from yianc.analysis.ty.model import TypeData;
from yianc.codegen.representation import PointerRepresentation;
from llvm.ir import IrValue, BinaryOp, CastOp, IntCompare;

impl FunctionLowering {
    pub fn integer(value: u64) -> IrValue {
        self.owner.module.const_int(self.owner.module.int_type(64u32), value)
    }

    pub fn fat(type_id: TypeId) -> Result<bool, CodegenError> {
        Result<bool, CodegenError>.Ok(match self.owner.types.representation(type_id)? {
            FatPointer | FatReference | FatView | FatTraitObject => true,
            _ => false,
        })
    }

    pub fn view_length(value: IrValue) -> IrValue {
        self.builder.extract_value(value, if self.owner.types.raw_pointers() { 1u32 } else { 2u32 }, "")
    }

    pub fn pointer_word(type_id: TypeId, value: IrValue) -> Result<IrValue, CodegenError> {
        Result<IrValue, CodegenError>.Ok(if self.fat(type_id)? {
                self.builder.extract_value(value, 1u32, "")
            } else { self.integer(ENV_WORD) })
    }

    pub fn pointer_offset_bytes(value: IrValue) -> IrValue {
        self.builder.cast(CastOp.Zext, self.builder.extract_value(value, 2u32, ""),
            self.owner.module.int_type(64u32), "")
    }

    pub fn pointer_extent_bytes(value: IrValue) -> IrValue {
        self.builder.cast(CastOp.Zext, self.builder.extract_value(value, 3u32, ""),
            self.owner.module.int_type(64u32), "")
    }

    // The full pointer address is independent of the pointee layout.
    pub fn pointer_data(type_id: TypeId, value: IrValue) -> Result<IrValue, CodegenError> {
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(self.owner.module.pointer_type(0u32)));
        }
        if !self.fat(type_id)? {
            return Result<IrValue, CodegenError>.Ok(match self.owner.session.types.require(type_id)? {
                    Slice(_) | Str => self.builder.extract_value(value, 0u32, ""),
                    _ => value,
                });
        }

        let data = self.builder.extract_value(value, 0u32, "");
        match self.owner.session.types.require(type_id)? {
            Pointer(_) => {
                let indices = [self.pointer_offset_bytes(value)];
                Result<IrValue, CodegenError>.Ok(self.builder.gep(self.owner.module.int_type(8u32),
                    data, indices.as_slice(), false, ""))
            },
            _ => Result<IrValue, CodegenError>.Ok(data),
        }
    }

    // Callers establish offset <= extent <= FAT_MAX_EXTENT_BYTES before truncating.
    pub fn make_full_pointer(type_id: TypeId, data: IrValue, word: IrValue, offset_bytes: IrValue, extent_bytes: IrValue)
    -> Result<IrValue, CodegenError> {
        let native = self.owner.types.value_type(type_id)?;
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(native));
        }
        if self.owner.types.raw_pointers() {
            return Result<IrValue, CodegenError>.Ok(data);
        }

        let result = self.builder.insert_value(self.owner.module.undef_value(native), data, 0u32, "");
        result = self.builder.insert_value(result, word, 1u32, "");
        let narrow = self.owner.module.int_type(32u32);
        result = self.builder.insert_value(result, self.builder.cast(CastOp.Trunc, offset_bytes, narrow, ""), 2u32, "");
        Result<IrValue, CodegenError>.Ok(self.builder.insert_value(result, self.builder.cast(CastOp.Trunc, extent_bytes, narrow, ""), 3u32, ""))
    }

    pub fn make_view(type_id: TypeId, data: IrValue, word: IrValue, length: IrValue) -> Result<IrValue, CodegenError> {
        let native = self.owner.types.value_type(type_id)?;
        let result = self.builder.insert_value(self.owner.module.undef_value(native), data, 0u32, "");
        if self.owner.types.raw_pointers() {
            return Result<IrValue, CodegenError>.Ok(self.builder.insert_value(result, length, 1u32, ""));
        }
        result = self.builder.insert_value(result, word, 1u32, "");
        Result<IrValue, CodegenError>.Ok(self.builder.insert_value(result, length, 2u32, ""))
    }

    // The caller supplies a validated address for one object.
    pub fn make_place_pointer(type_id: TypeId, data: IrValue, word: IrValue) -> Result<IrValue, CodegenError> {
        let native = self.owner.types.value_type(type_id)?;
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(native));
        }
        if self.owner.types.raw_pointers() { return Result<IrValue, CodegenError>.Ok(data); }
        match self.owner.session.types.require(type_id)? {
            Pointer(element) => {
                self.require_guard(GuardKind.ByteExtent, GuardSite.Before)?;
                let stride = self.owner.module.abi_size(self.owner.types.value_type(*element)?);
                let extent = self.checked_byte_extent(self.integer(1u64), stride, FAT_MAX_EXTENT_BYTES, "R001")?;
                self.make_full_pointer(type_id, data, word, self.integer(0u64), extent)
            },
            Reference(_) => {
                let result = self.builder.insert_value(self.owner.module.undef_value(native), data, 0u32, "");
                Result<IrValue, CodegenError>.Ok(self.builder.insert_value(result, word, 1u32, ""))
            },
            _ => @panic("place address has no language pointer type"),
        }
    }

    pub fn pointer_cast(source: TypeId, target: TypeId, value: IrValue) -> Result<IrValue, CodegenError> {
        if source == target { return Result<IrValue, CodegenError>.Ok(value); }
        let store = &self.owner.session.types;
        let source_type = store.require(source)?;
        let target_type = store.require(target)?;
        let source_pointer = match source_type { Pointer(_) | Reference(_) | Slice(_) | Str => true, _ => false, };
        let target_pointer = match target_type { Pointer(_) | Reference(_) | Slice(_) | Str => true, _ => false, };
        if !source_pointer && !target_pointer {
            return cast(&self.builder, self.owner.types, self.owner.module, source, target, value);
        }
        if self.owner.types.is_zst(target)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(self.owner.types.value_type(target)?));
        }
        if !source_pointer || !target_pointer {
            @panic("invalid language pointer conversion");
        }

        let module = self.owner.module;
        let zero = self.integer(0u64);
        let array = false;
        let empty = false;
        match source_type {
            Pointer(element) | Reference(element) => match store.require(*element)? {
                Array(inner, count) => {
                    let is_match = match target_type { Pointer(target_element) | Reference(target_element) => *inner == *target_element, _ => false, };
                    if is_match {
                        let bits = match store.require(*count)? {
                            LiteralValue(bits, false, _) => *bits,
                            _ => @panic("array pointer conversion has no length"),
                        };
                        empty = bits == 0u64;
                        array = true;
                    }
                },
                _ => {},
            },
            _ => {},
        }
        if self.owner.types.is_zst(source)? {
            if empty {
                let slot = self.lock_slot(self.integer(LITERAL_WORD));
                let word = self.integer(LITERAL_WORD);
                return match target_type {
                    Pointer(_) => self.make_full_pointer(target, slot, word, zero, zero),
                    _ => self.make_place_pointer(target, slot, word),
                };
            }
            @panic("nonempty pointer conversion from a zero-sized value");
        }

        if !self.owner.types.raw_pointers() && !array {
            match (source_type, target_type) {
                (Pointer(_), Pointer(_)) => return Result<IrValue, CodegenError>.Ok(value),
                _ => {},
            }
        }
        let data = self.pointer_data(source, value)?;
        let word = self.pointer_word(source, value)?;
        if self.owner.types.raw_pointers() {
            return match target_type {
                Slice(_) | TypeData.Str => self.make_view(target, data, word, zero),
                _ => Result<IrValue, CodegenError>.Ok(data),
            };
        }

        match target_type {
            Pointer(_) => {
                let element = match source_type {
                    Pointer(element) | Reference(element) => *element,
                    _ => @panic("full pointer conversion has no source pointee"),
                };
                self.require_guard(GuardKind.ByteExtent, GuardSite.Before)?;
                let stride = module.abi_size(self.owner.types.value_type(element)?);
                let extent = self.checked_byte_extent(self.integer(1u64), stride, FAT_MAX_EXTENT_BYTES, "R001")?;
                match source_type {
                    Pointer(_) => {
                        self.require_guard(GuardKind.CastAccess, GuardSite.Before)?;
                        self.check_access(source, value)?;
                    },
                    _ => {},
                }
                self.make_full_pointer(target, data, word, zero, extent)
            },
            Slice(element) => {
                self.require_guard(GuardKind.PointerRemaining, GuardSite.Before)?;
                self.check_pointer_span(value, zero, "S004")?;
                let remaining = self.builder.binary(BinaryOp.Sub, self.pointer_extent_bytes(value), self.pointer_offset_bytes(value), "");
                let stride = module.abi_size(self.owner.types.value_type(*element)?);
                let length = if stride == 0u64 { zero } else {
                    self.builder.binary(BinaryOp.Udiv, remaining, self.integer(stride), "")
                };
                self.make_view(target, data, word, length)
            },
            Reference(_) => {
                match source_type {
                    TypeData.Str => {
                        self.require_guard(GuardKind.CastNonempty, GuardSite.Before)?;
                        self.checked(self.builder.icmp(IntCompare.Ne, self.view_length(value), zero, ""), "S007")?;
                        self.require_guard(GuardKind.CastView, GuardSite.Before)?;
                        self.check_view(source, value)?;
                    },
                    _ => {},
                }
                self.make_place_pointer(target, data, word)
            },
            _ => @panic("unsupported language pointer conversion"),
        }
    }
}
