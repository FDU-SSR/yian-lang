from yianc.codegen.llvm.module import FunctionLowering;
from yianc.codegen.llvm.scalar import cast;
from yianc.codegen.error import CodegenError;
from yianc.codegen.abi.runtime import ENV_WORD, LITERAL_WORD;
from yianc.common.ids import TypeId;
from yianc.analysis.ty.model import TypeData;
from llvm.ir import IrValue, BinaryOp, CastOp, IntCompare;
from std.core.result import Result;

impl FunctionLowering {
    pub fn integer(value: u64) -> IrValue {
        self.owner.module.const_int(self.owner.module.int_type(64u32), value)
    }

    pub fn fat(type_id: TypeId) -> Result<bool, CodegenError> {
        if self.owner.types.raw_pointers() || self.owner.types.is_zst(type_id)? {
            return Result<bool, CodegenError>.Ok(false);
        }
        Result<bool, CodegenError>.Ok(match self.owner.session.types.require(type_id)? {
                Pointer(_) | Reference(_) | Slice(_) | Str | TraitObject(_) => true,
                _ => false,
            })
    }

    pub fn view_length(value: IrValue) -> IrValue {
        self.builder.extract_value(value, if self.owner.types.raw_pointers() { 1u32 } else { 2u32 }, "")
    }

    pub fn pointer_word(type_id: TypeId, value: IrValue) -> Result<IrValue, CodegenError> {
        Result<IrValue, CodegenError>.Ok(if self.fat(type_id)? {
                self.builder.extract_value(value, 1u32, "")
            } else { self.integer(ENV_WORD) })
    }

    pub fn pointer_index(value: IrValue) -> IrValue {
        self.builder.cast(CastOp.Zext, self.builder.extract_value(value, 2u32, ""),
            self.owner.module.int_type(64u32), "")
    }

    pub fn pointer_size(value: IrValue) -> IrValue {
        self.builder.cast(CastOp.Zext, self.builder.extract_value(value, 3u32, ""),
            self.owner.module.int_type(64u32), "")
    }

    // Arithmetic keeps the allocation base fixed; only the element index changes.
    pub fn pointer_data(type_id: TypeId, value: IrValue) -> Result<IrValue, CodegenError> {
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(self.owner.module.pointer_type(0u32)));
        }
        if !self.fat(type_id)? {
            return Result<IrValue, CodegenError>.Ok(match self.owner.session.types.require(type_id)? {
                    Slice(_) | Str => self.builder.extract_value(value, 0u32, ""),
                    _ => value,
                });
        }

        let data = self.builder.extract_value(value, 0u32, "");
        match self.owner.session.types.require(type_id)? {
            Pointer(element) => {
                let indices = [self.pointer_index(value)];
                Result<IrValue, CodegenError>.Ok(self.builder.gep(self.owner.types.value_type(*element)?,
                    data, indices.as_slice(), false, ""))
            },
            _ => Result<IrValue, CodegenError>.Ok(data),
        }
    }

    // Callers establish range and lifetime checks before constructing a derived view.
    pub fn make_pointer(type_id: TypeId, data: IrValue, word: IrValue, index: IrValue, length: IrValue)
    -> Result<IrValue, CodegenError> {
        let native = self.owner.types.value_type(type_id)?;
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(native));
        }
        let view = match self.owner.session.types.require(type_id)? { Slice(_) | Str => true, _ => false, };
        if self.owner.types.raw_pointers() && !view {
            return Result<IrValue, CodegenError>.Ok(data);
        }

        let result = self.builder.insert_value(self.owner.module.undef_value(native), data, 0u32, "");
        if self.owner.types.raw_pointers() {
            result = self.builder.insert_value(result, length, 1u32, "");
        } else {
            result = self.builder.insert_value(result, word, 1u32, "");
            if view {
                result = self.builder.insert_value(result, length, 2u32, "");
            } else {
                match self.owner.session.types.require(type_id)? {
                    Pointer(_) => {
                        let narrow = self.owner.module.int_type(32u32);
                        result = self.builder.insert_value(result, self.builder.cast(CastOp.Trunc, index, narrow, ""), 2u32, "");
                        result = self.builder.insert_value(result, self.builder.cast(CastOp.Trunc, length, narrow, ""), 3u32, "");
                    },
                    _ => {},
                }
            }
        }
        Result<IrValue, CodegenError>.Ok(result)
    }

    pub fn pointer_cast(source: TypeId, target: TypeId, value: IrValue) -> Result<IrValue, CodegenError> {
        if source == target { return Result<IrValue, CodegenError>.Ok(value); }
        let store = &self.owner.session.types;
        let source_type = store.require(source)?;
        let target_type = store.require(target)?;
        let source_pointer = match source_type { Pointer(_) | Reference(_) | Slice(_) | Str => true, _ => false, };
        let target_pointer = match target_type { Pointer(_) | Reference(_) | Slice(_) | Str => true, _ => false, };
        if !source_pointer && !target_pointer {
            return cast(&self.builder, self.owner.types, self.owner.module, source, target, value);
        }
        if self.owner.types.is_zst(target)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(self.owner.types.value_type(target)?));
        }
        if !source_pointer || !target_pointer {
            return Result<IrValue, CodegenError>.Err(CodegenError.invalid("invalid language pointer conversion"));
        }

        let length = self.integer(1u64);
        let array = false;
        let empty = false;
        match source_type {
            Pointer(element) | Reference(element) => match store.require(*element)? {
                Array(inner, count) => {
                    let matches = match target_type { Pointer(target_element) | Reference(target_element) => *inner == *target_element, _ => false, };
                    if matches {
                        let bits = match store.require(*count)? {
                            LiteralValue(bits, false, _) => *bits,
                            _ => return Result<IrValue, CodegenError>.Err(CodegenError.invalid("array pointer conversion has no length")),
                        };
                        length = self.integer(bits);
                        empty = bits == 0u64;
                        array = true;
                    }
                },
                _ => {},
            },
            _ => {},
        }
        if self.owner.types.is_zst(source)? {
            if empty {
                let slot = self.lock_slot(self.integer(LITERAL_WORD));
                return self.make_pointer(target, slot, self.integer(LITERAL_WORD), self.integer(0u64), self.integer(0u64));
            }
            return Result<IrValue, CodegenError>.Err(CodegenError.invalid("nonempty pointer conversion from a zero-sized value"));
        }

        if !self.owner.types.raw_pointers() {
            if array { self.check_count(length)?; }
            match (source_type, target_type) {
                (Pointer(_), Pointer(_)) => {
                    if !array { return Result<IrValue, CodegenError>.Ok(value); }
                    self.check_access(source, value)?;
                },
                (Pointer(_), Reference(_)) | (Slice(_), Reference(_)) => {},
                (TypeData.Str, Reference(_)) => {
                    self.checked(self.builder.icmp(IntCompare.Ne, self.view_length(value), self.integer(0u64), ""), "S007")?;
                    self.check_view(source, value)?;
                },
                (Pointer(_), Slice(_)) => {
                    let index = self.pointer_index(value);
                    let size = self.pointer_size(value);
                    self.checked(self.builder.icmp(IntCompare.Ule, index, size, ""), "S004")?;
                    length = self.builder.binary(BinaryOp.Sub, size, index, "");
                },
                _ => {},
            }
        } else {
            match (source_type, target_type) {
                (Pointer(_), Slice(_)) => { length = self.integer(0u64); },
                _ => {},
            }
        }
        let data = self.pointer_data(source, value)?;
        self.make_pointer(target, data, self.pointer_word(source, value)?, self.integer(0u64), length)
    }
}
