from yianc.codegen.llvm.module import FunctionLowering;
from yianc.codegen.cfg.ids import ValueId;
from yianc.codegen.error import CodegenError;
from yianc.analysis.ty.queries import enum_variants;
from yianc.common.ids import TypeId;
from llvm.ir import IrValue, IntCompare;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;

impl FunctionLowering {
    // Packed enum payloads begin after the four-byte tag. Access alignment is conservative.
    pub fn enum_address(enumeration: TypeId, address: IrValue) -> Result<IrValue, CodegenError> {
        if self.owner.types.niche_payload(enumeration)?.is_some() { return Result<IrValue, CodegenError>.Ok(address); }
        let module = self.owner.module;
        let indices = [module.const_int(module.int_type(32u32), 0u64), module.const_int(module.int_type(32u32), 1u64)];
        Result<IrValue, CodegenError>.Ok(self.builder.gep(self.owner.types.value_type(enumeration)?, address, indices.as_slice(), false, ""))
    }

    pub fn enum_construct(type_id: TypeId, discriminant: u64, payload: Option<ValueId>, result: ValueId) -> Result<IrValue, CodegenError> {
        let types = self.owner.types;
        let module = self.owner.module;
        let native = types.value_type(type_id)?;
        if types.is_zst(type_id)? { return Result<IrValue, CodegenError>.Ok(module.const_null(native)); }
        if types.niche_payload(type_id)?.is_some() {
            return match payload {
                Some(value) => Result<IrValue, CodegenError>.Ok(self.builder.extract_value(self.get(value)?, 0u32, "")),
                None => Result<IrValue, CodegenError>.Ok(module.const_null(native)),
            };
        }
        let aggregate = module.const_null(native);
        aggregate = self.builder.insert_value(aggregate, module.const_int(module.int_type(32u32), discriminant), 0u32, "");
        match payload {
            Some(value) => {
                if !types.is_zst(self.cfg.value(value)?.type_id)? {
                    let slot = **self.enum_slots.get(&result).unwrap();
                    self.builder.store(aggregate, slot);
                    let pointer = self.enum_address(type_id, slot)?;
                    let stored = self.builder.store(self.get(value)?, pointer);
                    self.builder.set_alignment(stored, 1u32);
                    aggregate = self.builder.load(native, slot, "");
                }
            },
            None => {},
        }
        Result<IrValue, CodegenError>.Ok(aggregate)
    }

    pub fn enum_tag(value: ValueId) -> Result<IrValue, CodegenError> {
        let types = self.owner.types;
        let module = self.owner.module;
        let type_id = self.cfg.value(value)?.type_id;
        let variants = self.owner.types.variants_of(type_id)?;

        if types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(module.const_int(module.int_type(32u32),
                if variants.is_empty() { 0u64 } else { variants[0].discriminant }));
        }
        match types.niche_payload(type_id)? {
            Some(payload) => {
                let candidate = self.get(value)?;
                let pointer = match self.owner.session.types.require(payload)? {
                    Slice(_) | Str => self.builder.extract_value(candidate, 0u32, ""),
                    Pointer(_) | Reference(_) => if self.owner.types.raw_pointers() { candidate } else { self.builder.extract_value(candidate, 0u32, "") },
                    _ => candidate,
                };
                let empty = self.builder.icmp(IntCompare.Eq, pointer, module.const_null(module.pointer_type(0u32)), "");
                let unit = 0u64;
                let full = 0u64;
                for variant in variants {
                    if variant.payload.is_none() { unit = variant.discriminant; } else { full = variant.discriminant; }
                }
                Result<IrValue, CodegenError>.Ok(self.builder.select(empty,
                    module.const_int(module.int_type(32u32), unit), module.const_int(module.int_type(32u32), full), ""))
            },
            None => Result<IrValue, CodegenError>.Ok(self.builder.extract_value(self.get(value)?, 0u32, "")),
        }
    }

    pub fn enum_payload(type_id: TypeId, value: ValueId) -> Result<IrValue, CodegenError> {
        let types = self.owner.types;
        let module = self.owner.module;
        let native = types.value_type(type_id)?;
        if types.is_zst(type_id)? { return Result<IrValue, CodegenError>.Ok(module.const_null(native)); }
        let enumeration = self.cfg.value(value)?.type_id;
        if types.niche_payload(enumeration)?.is_some() {
            return Result<IrValue, CodegenError>.Ok(self.builder.insert_value(module.undef_value(native), self.get(value)?, 0u32, ""));
        }
        let slot = **self.enum_slots.get(&value).unwrap();
        self.builder.store(self.get(value)?, slot);
        let pointer = self.enum_address(enumeration, slot)?;
        let loaded = self.builder.load(native, pointer, "");
        self.builder.set_alignment(loaded, 1u32);
        Result<IrValue, CodegenError>.Ok(loaded)
    }
}
