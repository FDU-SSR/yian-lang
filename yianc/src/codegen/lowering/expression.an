from yianc.codegen.lowering.context import Lowering;
from yianc.codegen.cfg.ids import ValueId;
from yianc.codegen.cfg.model import ValueKind, Operation, Terminator, IndexBounds;
from yianc.codegen.error import CodegenError;
from yianc.analysis.hir.node import HirNode, Binary, Builtin;
from yianc.analysis.ty.queries import struct_fields, enum_variants;
from yianc.analysis.ty.model import TypeData;
from yianc.frontend.ast.atoms import BuiltinKind;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.common.ids import HirId, TypeId;
from yianc.frontend.ast.operator import BinaryOperator, UnaryOperator;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

impl Lowering {
    pub fn expression(id: HirId) -> Result<ValueId, CodegenError> {
        let node = self.session.hir.require(id)?;
        if self.current.is_none() {
            let type_id = match self.session.types.require(node.type_id)? {
                IntLiteral => self.session.types.primitive(TypeData.Integer(32u32, true))?,
                FloatLiteral => self.session.types.primitive(TypeData.Float(64u32))?,
                _ => node.type_id,
            };
            return Result<ValueId, CodegenError>.Ok(self.zero(type_id));
        }
        match self.lower_expression(id) {
            Ok(value) => Result<ValueId, CodegenError>.Ok(value),
            Err(problem) => Result<ValueId, CodegenError>.Err(problem.with_location(node.span)),
        }
    }

    fn lower_expression(id: HirId) -> Result<ValueId, CodegenError> {
        let node = self.session.hir.require(id)?;
        let result = match &node.kind {
            IntLiteral(value) => {
                let type_id = match self.session.types.require(node.type_id)? {
                    IntLiteral => self.session.types.primitive(TypeData.Integer(32u32, true))?,
                    _ => node.type_id,
                };
                self.function.add_value(type_id, ValueKind.Integer(
                    if value.is_untyped() && value.is_negative() { 0u64 - value.raw_bits() } else { value.raw_bits() }))
            },
            FloatLiteral(value) => {
                let type_id = match self.session.types.require(node.type_id)? {
                    FloatLiteral => self.session.types.primitive(TypeData.Float(64u32))?,
                    _ => node.type_id,
                };
                self.function.add_value(type_id, ValueKind.Float(*value))
            },
            BoolLiteral(value) => self.function.add_value(node.type_id, ValueKind.Integer(if *value { 1u64 } else { 0u64 })),
            CharLiteral(value) => self.function.add_value(node.type_id, ValueKind.Integer(u64(*value))),
            StrLiteral(value) => self.function.add_value(node.type_id, ValueKind.Bytes(*value)),
            Ty => {
                let callable = match self.session.types.require(node.type_id)? {
                    Nominal(definition, _) => match self.session.types.definition(*definition).unwrap().header().kind {
                        Function | Method => true,
                        _ => false,
                    },
                    _ => false,
                };
                if callable {
                    self.dependencies.push(node.type_id);
                    self.function.add_value(node.type_id, ValueKind.Function(node.type_id))
                } else { self.zero(node.type_id) }
            },
            Var(symbol) => {
                let record = self.session.symbols.get(*symbol).unwrap();
                match record.kind {
                    Function => {
                        self.dependencies.push(record.type_id);
                        self.function.add_value(node.type_id, ValueKind.Function(record.type_id))
                    },
                    _ => {
                        match self.captured_places.get(symbol) {
                            Some(address) => return self.emit(node.span, node.type_id, Operation.Read(*address)),
                            None => {},
                        }
                        let local = self.bind(*symbol)?;
                        self.emit(node.span, node.type_id, Operation.Load(local))?
                    },
                }
            },
            Block(value) => self.block_value(node, value)?,
            Semi(value) => {
                self.expression(*value)?;
                self.zero(node.type_id)
            },
            Let(value) => {
                let initial = match value.init {
                    Some(expr) => Option<ValueId>.Some(self.expression(expr)?),
                    None => Option<ValueId>.None,
                };
                match value.symbol_id {
                    Some(symbol) => {
                        let local = self.bind(symbol)?;
                        match initial {
                            Some(value) => { self.effect(node.span, Operation.Store(local, value))?; },
                            None => {},
                        }
                    },
                    None => {},
                }
                self.zero(node.type_id)
            },
            PatternLet(value) => {
                self.pattern_binding(node, value)?
            },
            If(value) => self.if_value(node, value)?,
            Match(value) => self.match_value(node, value)?,
            Loop(body) => self.loop_value(node, *body)?,
            Break(value) => self.break_value(node, *value)?,
            Continue => self.continue_value(node)?,
            Return(value) => self.return_value(node, *value)?,
            Defer(action) => {
                if self.scopes.is_empty() {
                    return Result<ValueId, CodegenError>.Err(CodegenError.invalid("defer has no cleanup scope"));
                }
                self.scopes[self.scopes.len() - 1].actions.push(*action);
                self.zero(node.type_id)
            },
            Delete(target) => {
                let value = self.expression(*target)?;
                self.effect(node.span, Operation.Delete(value))?;
                self.zero(node.type_id)
            },
            Binary(value) => self.binary_value(node, value)?,
            Unary(value) => {
                if value.op == UnaryOperator.AddrOf {
                    let function_pointer = match self.session.types.require(node.type_id)? { FunctionPointer(_, _) => true, _ => false, };
                    if function_pointer {
                        let callable = self.expression(value.operand)?;
                        return self.emit(node.span, node.type_id, Operation.Cast(callable));
                    }
                    let address = self.address(value.operand)?;
                    if self.function.value(address)?.type_id == node.type_id {
                        address
                    } else {
                        self.emit(node.span, node.type_id, Operation.Cast(address))?
                    }
                } elif value.op == UnaryOperator.Deref {
                    let address = self.expression(value.operand)?;
                    self.emit(node.span, node.type_id, Operation.Read(address))?
                } else {
                    let operand = self.expression(value.operand)?;
                    let type_id = match self.session.types.require(node.type_id)? {
                        IntLiteral | FloatLiteral => self.function.value(operand)?.type_id,
                        _ => node.type_id,
                    };
                    self.emit(node.span, type_id, Operation.Unary(value.op, operand))?
                }
            },
            Cast(value) => {
                let operand = self.expression(value.value)?;
                match self.session.types.require(self.function.value(operand)?.type_id)? {
                    Nominal(definition, _) => match self.session.types.definition(*definition).unwrap().header().kind {
                        Function | Method => self.dependencies.push(self.function.value(operand)?.type_id),
                        _ => {},
                    },
                    _ => {},
                }
                self.emit(node.span, node.type_id, Operation.Cast(operand))?
            },
            BitCast(value) => {
                let operand = self.expression(value.value)?;
                self.emit(node.span, node.type_id, Operation.Cast(operand))?
            },
            Call(value) => self.call(node, value.func, &value.args, Option<HirId>.None)?,
            Invoke(value) => {
                let arguments = Vec<ValueId>.new();
                let transferred = false;
                defer { if !transferred { arguments.drop(); } };
                let callable_type = self.session.hir.require(value.callable)?.type_id;
                let closure_method = match self.session.types.require(callable_type)? {
                    Closure(_, _, _, _, _, method) => {
                        let address = self.address(value.callable)?;
                        arguments.push(address);
                        *method
                    },
                    _ => Option<TypeId>.None,
                };
                let pointer = if closure_method.is_none() { Option<ValueId>.Some(self.expression(value.callable)?) } else { Option<ValueId>.None };
                for argument in value.args { arguments.push(self.expression(*argument)?); }
                transferred = true;
                match closure_method {
                    Some(method) => {
                        self.dependencies.push(method);
                        self.emit(node.span, node.type_id, Operation.Call(method, arguments))?
                    },
                    None => self.emit(node.span, node.type_id, Operation.Invoke(*pointer.unwrap(), arguments))?,
                }
            },
            Closure(value) => {
                let fields = Vec<ValueId>.new();
                let transferred = false;
                defer { if !transferred { fields.drop(); } };
                for capture in value.captures { fields.push(self.expression(capture[1])?); }
                transferred = true;
                self.emit(node.span, node.type_id, Operation.Aggregate(fields))?
            },
            MethodCall(value) => self.call(node, value.method_id, &value.args, Option<HirId>.Some(value.receiver))?,
            TraitObjectCoerce(value) => {
                let source = self.expression(value.value)?;
                let methods = Vec<TypeId>.new();
                for method in value.method_ids { methods.push(*method); self.dependencies.push(*method); }
                self.emit(node.span, node.type_id, Operation.TraitObject(source, methods))?
            },
            TraitObjectMethodCall(value) => {
                let receiver = self.expression(value.receiver)?;
                let arguments = Vec<ValueId>.new();
                let transferred = false;
                defer { if !transferred { arguments.drop(); } };
                for argument in value.args { arguments.push(self.expression(*argument)?); }
                transferred = true;
                self.emit(node.span, node.type_id, Operation.DynamicCall(receiver, value.method_id, value.slot_index, arguments))?
            },
            Builtin(value) => self.builtin(node, value)?,
            Tuple(value) => self.aggregate(node, &value.field_values)?,
            Array(value) => self.aggregate(node, &value.elements)?,
            ArrayRepeat(value) => {
                let element = self.expression(value.element)?;
                let count = match self.session.types.require(node.type_id)? {
                    Array(_, length) => match self.session.types.require(*length)? {
                        LiteralValue(bits, _, _) => *bits,
                        _ => return Result<ValueId, CodegenError>.Err(CodegenError.invalid("repeated array has no concrete length")),
                    },
                    _ => return Result<ValueId, CodegenError>.Err(CodegenError.invalid("repeated array has no array type")),
                };
                self.emit(node.span, node.type_id, Operation.Repeat(element, count))?
            },
            StructConstruct(value) => {
                // Initializers run in source order; values are arranged in declaration order afterwards.
                let evaluated = Vec<ValueId>.new();
                defer evaluated.drop();
                for field in value.field_values { evaluated.push(self.expression(field[1])?); }
                let members = self.types.fields_of(node.type_id)?;

                let fields = Vec<ValueId>.new();
                let transferred = false;
                defer { if !transferred { fields.drop(); } };
                for member in members {
                    let found = Option<ValueId>.None;
                    let index = 0u64;
                    for field in value.field_values {
                        if field[0] == member.name { found = Option<ValueId>.Some(evaluated[index]); break; }
                        index += 1u64;
                    }
                    match found {
                        Some(value) => fields.push(value),
                        None => return Result<ValueId, CodegenError>.Err(CodegenError.invalid("checked structure has a missing field")),
                    }
                }
                transferred = true;
                self.emit(node.span, node.type_id, Operation.Aggregate(fields))?
            },
            VariantConstruct(value) => {
                let variants = self.types.variants_of(node.type_id)?;

                let payload_type = Option<TypeId>.None;
                for variant in variants {
                    if variant.discriminant == value.variant.discriminant { payload_type = variant.payload; }
                }
                let payload = match payload_type {
                    Some(type_id) => {
                        let fields = Vec<ValueId>.new();
                        let transferred = false;
                        defer { if !transferred { fields.drop(); } };
                        let members = self.types.fields_of(type_id)?;

                        let evaluated = Vec<ValueId>.new();
                        defer evaluated.drop();
                        match &value.args {
                            Some(args) => {
                                for field in *args { evaluated.push(self.expression(field[1])?); }
                                for member in members {
                                    let found = Option<ValueId>.None;
                                    let index = 0u64;
                                    for field in *args {
                                        if field[0] == member.name { found = Option<ValueId>.Some(evaluated[index]); break; }
                                        index += 1u64;
                                    }
                                    match found {
                                        Some(value) => fields.push(value),
                                        None => return Result<ValueId, CodegenError>.Err(CodegenError.invalid("checked enum payload has a missing field")),
                                    }
                                }
                            },
                            None => {},
                        }
                        transferred = true;
                        Option<ValueId>.Some(self.emit(node.span, type_id, Operation.Aggregate(fields))?)
                    },
                    None => Option<ValueId>.None,
                };
                self.emit(node.span, node.type_id, Operation.EnumConstruct(value.variant.discriminant, payload))?
            },
            FieldAccess(value) => {
                if node.is_place {
                    let address = self.address(id)?;
                    self.emit(node.span, node.type_id, Operation.Read(address))?
                } else {
                    let aggregate = self.expression(value.receiver)?;
                    self.emit(node.span, node.type_id, Operation.Extract(aggregate, value.field.index))?
                }
            },
            TupleAccess(value) => {
                if node.is_place {
                    let address = self.address(id)?;
                    self.emit(node.span, node.type_id, Operation.Read(address))?
                } else {
                    let aggregate = self.expression(value.receiver)?;
                    self.emit(node.span, node.type_id, Operation.Extract(aggregate, value.index))?
                }
            },
            ArrayAccess(_) | SliceAccess(_) => {
                let address = self.address(id)?;
                self.emit(node.span, node.type_id, Operation.Read(address))?
            },
            DynValue(value) => {
                let initial = self.expression(*value)?;
                let unsigned = self.session.types.primitive(TypeData.Integer(64u32, false))?;
                let count = self.function.add_value(unsigned, ValueKind.Integer(1u64));
                let types = Vec<TypeId>.new();
                types.push(self.function.value(initial)?.type_id);
                let args = Vec<ValueId>.new();
                args.push(count);
                let pointer = self.emit(node.span, node.type_id, Operation.Builtin(BuiltinKind.Alloc, types, args))?;
                self.effect(node.span, Operation.Write(pointer, initial))?;
                pointer
            },
            DynBuffer(value) => {
                let count = self.expression(value.length)?;
                let types = Vec<TypeId>.new();
                types.push(value.element_type);
                let args = Vec<ValueId>.new();
                args.push(count);
                let pointer = self.emit(node.span, node.type_id, Operation.Builtin(BuiltinKind.Alloc, types, args))?;
                match value.element {
                    Some(element) => {
                        let initial = self.expression(element)?;
                        if !self.types.is_zst(value.element_type)? { self.effect(node.span, Operation.Fill(pointer, initial, count))?; }
                    },
                    None => {},
                }
                pointer
            },
        };
        match self.session.types.require(node.type_id)? {
            Never => { if self.current.is_some() { self.end(Terminator.Unreachable)?; } },
            _ => {},
        }
        Result<ValueId, CodegenError>.Ok(result)
    }

    pub fn address(id: HirId) -> Result<ValueId, CodegenError> {
        let node = self.session.hir.require(id)?;
        match self.lower_address(id) {
            Ok(value) => Result<ValueId, CodegenError>.Ok(value),
            Err(problem) => Result<ValueId, CodegenError>.Err(problem.with_location(node.span)),
        }
    }

    fn lower_address(id: HirId) -> Result<ValueId, CodegenError> {
        let node = self.session.hir.require(id)?;
        let reference = self.session.types.reference(node.type_id);
        match &node.kind {
            Block(value) => {
                if node.is_place { return self.block_address(node, value); }
                Result<ValueId, CodegenError>.Err(CodegenError.invalid("non-place block reached address lowering"))
            },
            Var(symbol) => {
                match self.captured_places.get(symbol) {
                    Some(address) => return Result<ValueId, CodegenError>.Ok(*address),
                    None => {},
                }
                let local = self.bind(*symbol)?;
                self.emit(node.span, reference, Operation.Address(local))
            },
            Unary(value) => {
                if value.op == UnaryOperator.Deref { return self.expression(value.operand); }
                Result<ValueId, CodegenError>.Err(CodegenError.invalid("non-dereference unary expression reached address lowering"))
            },
            FieldAccess(value) => {
                let receiver = self.session.hir.require(value.receiver)?;
                let address = self.address(value.receiver)?;
                self.emit(node.span, reference, Operation.FieldAddress(address, receiver.type_id, value.field.index))
            },
            TupleAccess(value) => {
                let receiver = self.session.hir.require(value.receiver)?;
                let address = self.address(value.receiver)?;
                self.emit(node.span, reference, Operation.FieldAddress(address, receiver.type_id, value.index))
            },
            ArrayAccess(value) => {
                let base = self.address(value.array)?;
                let pointer = self.session.types.pointer(value.element_type);
                let elements = self.emit(node.span, pointer, Operation.Cast(base))?;
                let index = self.expression(value.index)?;
                let unsigned = self.session.types.primitive(TypeData.Integer(64u32, false))?;
                let length = self.function.add_value(unsigned, ValueKind.Integer(value.length));
                self.emit(node.span, pointer, Operation.IndexAddress(elements, value.element_type, index, IndexBounds.Array(length)))
            },
            SliceAccess(value) => {
                let view = self.expression(value.slice)?;
                let index = self.expression(value.index)?;
                let unsigned = self.session.types.primitive(TypeData.Integer(64u32, false))?;
                let pointer = self.session.types.pointer(value.element_type);
                let arguments = Vec<ValueId>.new();
                arguments.push(view);
                let base = self.emit(node.span, pointer, Operation.Builtin(BuiltinKind.SliceGetPtr, Vec<TypeId>.new(), arguments))?;
                let lengths = Vec<ValueId>.new();
                lengths.push(view);
                let length = self.emit(node.span, unsigned, Operation.Builtin(BuiltinKind.SliceGetLen, Vec<TypeId>.new(), lengths))?;
                self.emit(node.span, pointer, Operation.IndexAddress(base, value.element_type, index, IndexBounds.Slice(length)))
            },
            _ => Result<ValueId, CodegenError>.Err(CodegenError.invalid("address lowering requires normalized storage")),
        }
    }

    pub fn aggregate(node: HirNode&, values: Vec<HirId>&) -> Result<ValueId, CodegenError> {
        let fields = Vec<ValueId>.new();
        let transferred = false;
        defer { if !transferred { fields.drop(); } };
        for value in *values { fields.push(self.expression(*value)?); }
        transferred = true;
        self.emit(node.span, node.type_id, Operation.Aggregate(fields))
    }

    pub fn call(node: HirNode&, callable: TypeId, args: Vec<HirId>&, receiver: Option<HirId>) -> Result<ValueId, CodegenError> {
        let arguments = Vec<ValueId>.new();
        let transferred = false;
        defer { if !transferred { arguments.drop(); } };
        match receiver {
            Some(value) => arguments.push(self.expression(value)?),
            None => {},
        }
        for arg in *args { arguments.push(self.expression(*arg)?); }
        self.dependencies.push(callable);
        transferred = true;
        self.emit(node.span, node.type_id, Operation.Call(callable, arguments))
    }

    pub fn builtin(node: HirNode&, value: Builtin&) -> Result<ValueId, CodegenError> {
        match value.kind {
            SizeOf => {
                let size = self.types.size_of(value.type_args[0])?;
                Result<ValueId, CodegenError>.Ok(self.function.add_value(node.type_id, ValueKind.Integer(size)))
            },
            Undef => Result<ValueId, CodegenError>.Ok(self.function.add_value(node.type_id, ValueKind.Undef)),
            FfiNull => Result<ValueId, CodegenError>.Ok(self.zero(node.type_id)),
            AssumeInit => self.expression(value.args[0]),
            BitCast => {
                let operand = self.expression(value.args[0])?;
                self.emit(node.span, node.type_id, Operation.Cast(operand))
            },
            Panic | RuntimeFail | Exit | SysRead | SysReadBytes | SysWrite | SysWriteBytes | Open | Close |
            MemCopy | SliceFromParts | SliceGetPtr | SliceGetLen | StrFromParts | StrGetPtr | StrGetLen |
            FfiAddr | FfiParts | FfiPtrCast | FfiCopyFrom | FfiCopyTo | Alloc | Realloc | Dangling |
            Sqrt | Sin | Cos | Argc | ArgBytes => {
                let args = Vec<ValueId>.new();
                let transferred = false;
                defer { if !transferred { args.drop(); } };
                for arg in value.args { args.push(self.expression(*arg)?); }
                let types = Vec<TypeId>.new();
                for type_id in value.type_args { types.push(*type_id); }
                transferred = true;
                self.emit(node.span, node.type_id, Operation.Builtin(value.kind, types, args))
            },
        }
    }

    pub fn binary_value(node: HirNode&, value: Binary&) -> Result<ValueId, CodegenError> {
        if value.op == BinaryOperator.LogicalAnd || value.op == BinaryOperator.LogicalOr {
            return self.short_circuit(node, value.left, value.right, value.op == BinaryOperator.LogicalAnd);
        }
        if value.op == BinaryOperator.Assign {
            let address = self.address(value.left)?;
            let rhs = self.expression(value.right)?;
            self.effect(node.span, Operation.Write(address, rhs))?;
            return Result<ValueId, CodegenError>.Ok(self.zero(node.type_id));
        }
        let op = match value.op {
            AddAssign => BinaryOperator.Add, SubAssign => BinaryOperator.Sub,
            MulAssign => BinaryOperator.Mul, DivAssign => BinaryOperator.Div,
            ModAssign => BinaryOperator.Mod, BitAndAssign => BinaryOperator.BitAnd,
            BitOrAssign => BinaryOperator.BitOr, BitXorAssign => BinaryOperator.BitXor,
            ShlAssign => BinaryOperator.Shl, ShrAssign => BinaryOperator.Shr,
            _ => value.op,
        };
        if op != value.op {
            let address = self.address(value.left)?;
            let lhs_type = self.session.hir.require(value.left)?.type_id;
            let lhs = self.emit(node.span, lhs_type, Operation.Read(address))?;
            let rhs = self.expression(value.right)?;
            let pointer = match self.session.types.require(lhs_type)? { Pointer(_) | CPointer(_) => true, _ => false, };
            let result = if pointer && (op == BinaryOperator.Add || op == BinaryOperator.Sub) {
                self.emit(node.span, lhs_type, Operation.PointerOffset(lhs, rhs, op == BinaryOperator.Sub))?
            } else {
                self.emit(node.span, lhs_type, Operation.Binary(op, lhs, rhs))?
            };
            self.effect(node.span, Operation.Write(address, result))?;
            return Result<ValueId, CodegenError>.Ok(self.zero(node.type_id));
        }

        let left = self.expression(value.left)?;
        let right = self.expression(value.right)?;
        let pointer = match self.session.types.require(self.function.value(left)?.type_id)? {
            Pointer(_) | CPointer(_) => true, _ => false,
        };
        if pointer && (value.op == BinaryOperator.Add || value.op == BinaryOperator.Sub) {
            if self.function.value(left)?.type_id == self.function.value(right)?.type_id {
                return self.emit(node.span, node.type_id, Operation.PointerDifference(left, right));
            }
            return self.emit(node.span, node.type_id, Operation.PointerOffset(left, right, value.op == BinaryOperator.Sub));
        }
        // Mathematical literal types survive semantic checking; runtime CFG operands use their default type.
        let type_id = match self.session.types.require(node.type_id)? {
            IntLiteral => self.session.types.primitive(TypeData.Integer(32u32, true))?,
            FloatLiteral => self.session.types.primitive(TypeData.Float(64u32))?,
            _ => node.type_id,
        };
        self.emit(node.span, type_id, Operation.Binary(op, left, right))
    }

}
