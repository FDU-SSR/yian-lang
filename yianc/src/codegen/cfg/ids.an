from std.core.hash import Hash, Murmur3Hasher;
from std.core.ops import PartialEq;

// IDs belong to one CFG owner. Block, value, and local IDs are scoped to a function.
pub struct FunctionId {
    pub index: u64,
}

impl PartialEq<FunctionId> for FunctionId {
    pub fn eq(other: FunctionId&) -> bool {
        self.index == other.index
    }
}

impl Hash<Murmur3Hasher> for FunctionId {
    pub fn hash(hasher: Murmur3Hasher&) {
        self.index.hash(hasher);
    }
}

