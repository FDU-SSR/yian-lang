from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.session.output import AnalysisOutput;
from yianc.analysis.ty.store import TypeStore;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.codegen.cfg.model import CfgModule;
from yianc.codegen.cfg.verify import verify_cfg, verify_structure;
from yianc.codegen.cfg.passes.checks import insert_checks;
from yianc.codegen.cfg.passes.cleanup import cleanup;
from yianc.codegen.lowering.context import lower_module;
from yianc.codegen.llvm.module import LlvmLowering;
from yianc.codegen.types import BackendTypes;
from yianc.codegen.error import CodegenError;
from yianc.config import OutputKind;
from yianc.driver.trace import CompilerTrace;
from yianc.driver.profile import ProfileKind;
from llvm.observation import OperationObserver;
from llvm.core import llvm_version;
from llvm.object import Module;
from std.core.drop import Drop;

pub struct BackendOptions {
    pub raw_pointers: bool,
    pub optimization: u8,
}

pub struct EmitOptions {
    pub target: OutputKind,
}

// TargetIdentity describes the native target used by code generation. It contains copied
// strings only, so it remains valid after the LLVM module that produced it is released.
pub struct TargetIdentity {
    target_triple: String,
    data_layout: String,
    llvm_version: (u32, u32, u32),
}

impl Drop for TargetIdentity {
    pub fn drop() {
        self.target_triple.drop();
        self.data_layout.drop();
    }
}

impl TargetIdentity {
    pub fn target_triple() -> str { self.target_triple.as_str() }
    pub fn data_layout() -> str { self.data_layout.as_str() }
    pub fn llvm_version() -> (u32, u32, u32) { self.llvm_version }
}

// target_identity reads the same target gate as BackendSession without analyzing source.
pub fn target_identity() -> Result<TargetIdentity, String> {
    let module = match Module.try_new("yian-target", 0u8) {
        Ok(value) => value,
        Err(message) => {
            let text = match str.from_slice(message.as_slice()) {
                Some(value) => String.from(&value),
                None => String.from(&"LLVM target module creation failed"),
            };
            message.drop();
            return Result<TargetIdentity, String>.Err(msg=text);
        },
    };
    defer module.close();
    let triple_bytes = module.target_triple();
    defer triple_bytes.drop();
    let triple_text = match str.from_slice(triple_bytes.as_slice()) {
        Some(value) => value,
        None => return Result<TargetIdentity, String>.Err(msg=String.from(&"LLVM target is not UTF-8")),
    };
    let layout_bytes = module.data_layout();
    defer layout_bytes.drop();
    let layout_text = match str.from_slice(layout_bytes.as_slice()) {
        Some(value) => value,
        None => return Result<TargetIdentity, String>.Err(msg=String.from(&"LLVM data layout is not UTF-8")),
    };
    if !triple_text.starts_with("x86_64-") || !triple_text.contains("linux") || triple_text.contains("x32")
    || module.abi_size(module.pointer_type(0u32)) != 8u64 {
        return Result<TargetIdentity, String>.Err(msg=String.from(&"backend requires Linux x86-64 LP64"));
    }
    Result<TargetIdentity, String>.Ok(val=TargetIdentity(
        target_triple=String.from(&triple_text),
        data_layout=String.from(&layout_text),
        llvm_version=llvm_version(),
    ))
}

pub struct Emission {
    pub target: OutputKind,
    pub bytes: Vec<u8>,
}

impl Drop for Emission {
    pub fn drop() { self.bytes.drop(); }
}

enum BackendPhase {
    Created, Lowered, Generated, Emitted, Failed,
}

// LLVM's owning module has a stable heap address across shallow return-value transfers.
pub struct BackendSession {
    analysis: AnalysisSession&,
    module: Module*,
    types: BackendTypes,
    options: BackendOptions,
    phase: BackendPhase,
    generated: Option<CfgModule&>,
}

fn start_profile(trace: Option<CompilerTrace&>, pass_id: str, kind: ProfileKind) -> u64 {
    match trace { Some(value) => value.start_pass(pass_id, "backend", pass_id, kind), None => 0u64 }
}

fn end_profile(trace: Option<CompilerTrace&>, pass_id: str, token: u64, success: bool) {
    match trace {
        Some(value) => if success { value.finish(pass_id, token); } else { value.fail(pass_id, token); },
        None => {},
    }
}

fn llvm_observer(trace: Option<CompilerTrace&>) -> Option<OperationObserver&> {
    match trace { Some(value) => Option<OperationObserver&>.Some(value), None => Option<OperationObserver&>.None }
}

fn lower_cfg(analysis: AnalysisSession&, types: BackendTypes&, output: AnalysisOutput&, trace: Option<CompilerTrace&>) -> Result<CfgModule, CodegenError> {
    let token = start_profile(trace, "cfg.lower", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.lower", token, success);
    let cfg = lower_module(analysis, types, output)?;
    success = true;
    Result<CfgModule, CodegenError>.Ok(cfg)
}

fn verify_cfg_structure_observed(cfg: CfgModule&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    let token = start_profile(trace, "cfg.verify_structure", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.verify_structure", token, success);
    verify_structure(cfg)?;
    success = true;
    Result<(), CodegenError>.Ok(val= ())
}

fn cleanup_cfg_observed(cfg: CfgModule&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    let token = start_profile(trace, "cfg.cleanup", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.cleanup", token, success);
    cleanup(cfg)?;
    success = true;
    Result<(), CodegenError>.Ok(val= ())
}

fn insert_checks_observed(cfg: CfgModule&, types: BackendTypes&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    let token = start_profile(trace, "cfg.insert_checks", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.insert_checks", token, success);
    insert_checks(cfg, types)?;
    success = true;
    Result<(), CodegenError>.Ok(val= ())
}

fn verify_cfg_observed(cfg: CfgModule&, types: BackendTypes&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    let token = start_profile(trace, "cfg.verify", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.verify", token, success);
    verify_cfg(cfg, types)?;
    success = true;
    Result<(), CodegenError>.Ok(val= ())
}

fn finish_analysis_observed(types: BackendTypes&, trace: Option<CompilerTrace&>) {
    let token = start_profile(trace, "backend.finish_analysis", ProfileKind.Pass);
    types.finish_analysis();
    end_profile(trace, "backend.finish_analysis", token, true);
}

fn lower_llvm(analysis: AnalysisSession&, types: BackendTypes&, module: Module&, cfg: CfgModule&,
    trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    let token = start_profile(trace, "llvm.lower", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "llvm.lower", token, success);
    let lowering = LlvmLowering.new(analysis, types, module, cfg.entry);
    defer lowering.drop();
    lowering.lower(cfg)?;
    success = true;
    Result<(), CodegenError>.Ok(val= ())
}

impl BackendSession {
    static pub fn new(analysis: AnalysisSession&, options: BackendOptions) -> Result<Self, CodegenError> {
        Self.new_observed(analysis, options, Option<CompilerTrace&>.None)
    }

    static pub fn new_observed(analysis: AnalysisSession&, options: BackendOptions, trace: Option<CompilerTrace&>) -> Result<Self, CodegenError> {
        let token = start_profile(trace, "backend.initialize", ProfileKind.Pass);
        let success = false;
        defer end_profile(trace, "backend.initialize", token, success);
        if options.raw_pointers != analysis.raw_pointers || options.optimization > 3u8 {
            return Result<Self, CodegenError>.Err(CodegenError.invalid("inconsistent backend configuration"));
        }
        let value = match Module.try_new("yian", options.optimization) {
            Ok(value) => value,
            Err(message) => return Result<Self, CodegenError>.Err(CodegenError.llvm_error(message)),
        };
        let accepted = false;
        defer { if !accepted { value.close(); } };
        let target_bytes = value.target_triple();
        defer target_bytes.drop();
        let target = match str.from_slice(target_bytes.as_slice()) {
            Some(text) => text,
            None => return Result<Self, CodegenError>.Err(CodegenError.invalid("LLVM target is not UTF-8")),
        };
        if !target.starts_with("x86_64-") || !target.contains("linux") || target.contains("x32")
        || value.abi_size(value.pointer_type(0u32)) != 8u64 {
            return Result<Self, CodegenError>.Err(CodegenError.target("backend requires Linux x86-64 LP64"));
        }
        let module = dyn value;
        let types = BackendTypes.new(&analysis.types, &*module, options.raw_pointers);
        accepted = true;
        success = true;
        Result<Self, CodegenError>.Ok(Self(analysis, module, types, options, BackendPhase.Created, Option<CfgModule&>.None))
    }

    pub fn size_provider() -> TypeSizeProvider& { &self.types }

    pub fn lower(output: AnalysisOutput&) -> Result<CfgModule, CodegenError> {
        self.lower_observed(output, Option<CompilerTrace&>.None)
    }

    pub fn lower_observed(output: AnalysisOutput&, trace: Option<CompilerTrace&>) -> Result<CfgModule, CodegenError> {
        if self.phase != BackendPhase.Created {
            return Result<CfgModule, CodegenError>.Err(CodegenError.invalid("backend lowering has already started"));
        }
        self.phase = BackendPhase.Failed;
        finish_analysis_observed(&self.types, trace);
        let cfg = lower_cfg(self.analysis, &self.types, output, trace)?;
        let accepted = false;
        defer { if !accepted { cfg.drop(); } };
        verify_cfg_structure_observed(&cfg, trace)?;
        cleanup_cfg_observed(&cfg, trace)?;
        insert_checks_observed(&cfg, &self.types, trace)?;
        verify_cfg_observed(&cfg, &self.types, trace)?;
        self.phase = BackendPhase.Lowered;
        accepted = true;
        Result<CfgModule, CodegenError>.Ok(cfg)
    }

    pub fn emit(cfg: CfgModule&, options: EmitOptions) -> Result<Emission, CodegenError> {
        self.emit_observed(cfg, options, Option<CompilerTrace&>.None)
    }

    pub fn emit_observed(cfg: CfgModule&, options: EmitOptions, trace: Option<CompilerTrace&>) -> Result<Emission, CodegenError> {
        self.check_cfg(cfg)?;
        if (self.phase != BackendPhase.Lowered && self.phase != BackendPhase.Generated) || options.target == OutputKind.None {
            return Result<Emission, CodegenError>.Err(CodegenError.invalid("backend emission is not permitted in this state"));
        }
        if self.phase == BackendPhase.Lowered { self.generate_observed(cfg, trace)?; }
        self.phase = BackendPhase.Failed;
        let bytes = match options.target {
            Ll => match self.module.try_ir_observed(llvm_observer(trace)) {
                Ok(value) => value,
                Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
            },
            Bc => {
                match self.module.optimize_observed(llvm_observer(trace)) {
                    Ok(_) => {},
                    Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
                }
                match self.module.try_bitcode_observed(llvm_observer(trace)) {
                    Ok(value) => value,
                    Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
                }
            },
            Asm => match self.module.assembly_observed(llvm_observer(trace)) {
                Ok(value) => value,
                Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
            },
            _ => match self.module.object_observed(llvm_observer(trace)) {
                Ok(value) => value,
                Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
            },
        };
        self.phase = BackendPhase.Emitted;
        Result<Emission, CodegenError>.Ok(Emission(options.target, bytes))
    }

    fn generate_observed(cfg: CfgModule&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
        self.phase = BackendPhase.Failed;
        verify_cfg_observed(cfg, &self.types, trace)?;
        insert_checks_observed(cfg, &self.types, trace)?;
        verify_cfg_observed(cfg, &self.types, trace)?;
        lower_llvm(self.analysis, &self.types, &*self.module, cfg, trace)?;
        self.generated = Option<CfgModule&>.Some(cfg);
        self.phase = BackendPhase.Generated;
        Result<(), CodegenError>.Ok(())
    }

    // The caller releases this byte snapshot independently of the LLVM module.
    pub fn llvm_snapshot(cfg: CfgModule&) -> Result<Vec<u8>, CodegenError> {
        self.llvm_snapshot_observed(cfg, Option<CompilerTrace&>.None)
    }

    pub fn llvm_snapshot_observed(cfg: CfgModule&, trace: Option<CompilerTrace&>) -> Result<Vec<u8>, CodegenError> {
        self.check_cfg(cfg)?;
        if self.phase != BackendPhase.Lowered && self.phase != BackendPhase.Generated {
            return Result<Vec<u8>, CodegenError>.Err(CodegenError.invalid("LLVM snapshot is unavailable in this state"));
        }
        if self.phase == BackendPhase.Lowered { self.generate_observed(cfg, trace)?; }
        match self.module.try_ir_observed(llvm_observer(trace)) {
            Ok(value) => Result<Vec<u8>, CodegenError>.Ok(value),
            Err(message) => Result<Vec<u8>, CodegenError>.Err(CodegenError.llvm_error(message)),
        }
    }

    // A generated graph stays borrowed and immutable through emission.
    fn check_cfg(cfg: CfgModule&) -> Result<(), CodegenError> {
        let owner: TypeStore& = &self.analysis.types;
        if cfg.type_store() != owner {
            return Result<(), CodegenError>.Err(CodegenError.invalid("CFG belongs to another analysis session"));
        }
        match self.generated {
            Some(value) => { if value != cfg { return Result<(), CodegenError>.Err(CodegenError.invalid("LLVM module represents another CFG")); } },
            None => {},
        }
        Result<(), CodegenError>.Ok(())
    }
}

impl Drop for BackendSession {
    pub fn drop() {
        self.types.drop();
        self.module.close();
        del self.module;
    }
}
