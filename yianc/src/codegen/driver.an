from yianc.config import CompilerConfig, OutputKind;
from yianc.analysis.session.output import AnalysisOutput;
from yianc.common.names import NameInterner;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.symbol.scope import SymbolSpace;
from yianc.types.space import TypeSpace;
from yianc.frontend.unit import UnitTable;
from yianc.package.model import PackageMap;
from yianc.codegen.session import TargetLayout, Emission;
from yianc.codegen.types import BackendTypes;
from yianc.codegen.cfg.model import CfgModule;
from yianc.codegen.cfg.verify import verify_cfg, verify_structure;
from yianc.codegen.cfg.passes.cleanup import cleanup;
from yianc.codegen.cfg.passes.inline import inline_cfg;
from yianc.codegen.cfg.passes.activation import prepare_safety;
from yianc.codegen.cfg.passes.eliminate import eliminate_checks;
from yianc.codegen.cfg.passes.options import CfgPassOptions;
from yianc.codegen.lowering.context import lower_module;
from yianc.codegen.llvm.module import LlvmLowering;
from yianc.codegen.error import CodegenError;
from yianc.codegen.dump import cfg_dump, ir_dump;
from yianc.codegen.native import NativeDriver, DriverError;
from yianc.roots import runtime_root;
from yianc.telemetry.profile import ProfileKind;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation, UserDiagnostic;
from yianc.diagnostics.output import OutputError;
from yianc.input_error import InputError;
from yianc.telemetry.trace import CompilerTrace;
from yianc.frontend.text import is_alphanumeric;
from yianc.common.ids import UnitId;
from llvm.observation import OperationObserver;
from std.core.convert import From;
from std.core.fs import create_dir_all, write, rename, remove_dir, remove_file, resolve;
from std.core.iter import Iterator, IntoIterator;
from std.core.path import Path;
from std.core.process import temporary_directory;
from llvm.object import Module;

pub enum BackendCompileError {
    Codegen { error: CodegenError },
    Output { error: OutputError },
    Input { error: InputError },
    Native { error: DriverError },
}

impl UserDiagnostic for BackendCompileError {
    pub fn code() -> DiagnosticCode { match self { Codegen(error) => error.code(), Output(error) => error.code(), Input(error) => error.code(), Native(error) => error.code(), } }
    pub fn location() -> DiagnosticLocation { match self { Codegen(error) => error.location(), Output(error) => error.location(), Input(error) => error.location(), Native(error) => error.location(), } }
    pub fn message() -> String { match self { Codegen(error) => error.message(), Output(error) => error.message(), Input(error) => error.message(), Native(error) => error.message(), } }
}
impl Drop for BackendCompileError {
    pub fn drop() { match self { Codegen(error) => error.drop(), Output(error) => error.drop(), Input(error) => error.drop(), Native(error) => error.drop(), } }
}

fn output_error(path: str, message: str) -> BackendCompileError {
    BackendCompileError.Output(OutputError(String.from(&message), DiagnosticCode.OutputIo, DiagnosticLocation.File(String.from(&path))))
}

pub enum BackendPhase {
    Created, Lowered, Generated, Emitted, Failed,
}

fn start_profile(trace: Option<CompilerTrace&>, pass_id: str, kind: ProfileKind) {
    match trace { Some(value) => value.start_pass(pass_id, "backend", pass_id, kind), None => {}, }
}

fn end_profile(trace: Option<CompilerTrace&>, pass_id: str, success: bool) {
    match trace {
        Some(value) => if success { value.finish(pass_id); } else { value.fail(pass_id); },
        None => {},
    }
}

fn llvm_observer(trace: Option<CompilerTrace&>) -> Option<OperationObserver&> {
    match trace { Some(value) => Option<OperationObserver&>.Some(value), None => Option<OperationObserver&>.None }
}

// Reference equality compares the type space address; TypeSpace has no structural equality.
fn same_type_space(left: TypeSpace&, right: TypeSpace&) -> bool {
    left == right
}

fn lower_cfg(hir: HirStore&, symbols: SymbolSpace&, types: BackendTypes&, output: AnalysisOutput&,
    trace: Option<CompilerTrace&>) -> Result<CfgModule, CodegenError> {
    start_profile(trace, "cfg.lower", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.lower", success);
    let cfg = lower_module(hir, symbols, types, output)?;
    success = true;
    Result<CfgModule, CodegenError>.Ok(cfg)
}

fn verify_structure_observed(cfg: CfgModule&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "cfg.verify_structure", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.verify_structure", success);
    verify_structure(cfg)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn cleanup_observed(cfg: CfgModule&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "cfg.cleanup", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.cleanup", success);
    cleanup(cfg)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn inline_observed(cfg: CfgModule&, types: BackendTypes&, options: CfgPassOptions, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "cfg.inline", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.inline", success);
    inline_cfg(cfg, types, options)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn prepare_safety_observed(cfg: CfgModule&, types: BackendTypes&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "cfg.prepare_safety", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.prepare_safety", success);
    prepare_safety(cfg, types)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn eliminate_observed(cfg: CfgModule&, types: BackendTypes&, options: CfgPassOptions, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "cfg.eliminate_checks", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.eliminate_checks", success);
    eliminate_checks(cfg, types, options)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn verify_cfg_observed(cfg: CfgModule&, types: BackendTypes&, trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "cfg.verify", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "cfg.verify", success);
    verify_cfg(cfg, types)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn finish_analysis_observed(types: BackendTypes&, trace: Option<CompilerTrace&>) {
    start_profile(trace, "backend.finish_analysis", ProfileKind.Pass);
    types.finish_analysis();
    end_profile(trace, "backend.finish_analysis", true);
}

fn lower_llvm(names: NameInterner&, units: UnitTable&, packages: Option<PackageMap&>,
    types: BackendTypes&, module: Module&,
    cfg: CfgModule&, program: str, runtime_profile_dir: Option<str>,
    trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
    start_profile(trace, "llvm.lower", ProfileKind.Pass);
    let success = false;
    defer end_profile(trace, "llvm.lower", success);
    let lowering = LlvmLowering.new(names, units, packages, types, module, cfg.entry,
        program, runtime_profile_dir);
    defer lowering.drop();
    lowering.lower(cfg)?;
    success = true;
    Result<(), CodegenError>.Ok(val=())
}

fn fail_publish(trace: Option<CompilerTrace&>) {
    match trace { Some(observer) => observer.fail("io.artifact_publish"), None => {}, }
}

fn cleanup_directory(directory: str, object: str, output: str) {
    match remove_file(object) { Ok(_) => {}, Err(error) => error.drop(), }
    match remove_file(output) { Ok(_) => {}, Err(error) => error.drop(), }
    match remove_dir(directory) { Ok(_) => {}, Err(error) => error.drop(), }
}

fn retain_object(object: str, output: str) {
    let retained = Path.new(output).with_extension("o");
    defer retained.drop();
    match rename(object, retained.as_str()) { Ok(_) => {}, Err(problem) => problem.drop(), }
}

fn destination(config: CompilerConfig&, units: UnitTable&) -> String {
    match &config.output {
        Some(value) => match config.target {
            Ll => {
                let path = Path.new(value.as_str()).with_extension("ll");
                defer path.drop();
                return String.from(&path.as_str());
            },
            Bc => {
                let path = Path.new(value.as_str()).with_extension("bc");
                defer path.drop();
                return String.from(&path.as_str());
            },
            Exe => return String.from(&value.as_str()),
        },
        None => {},
    }
    if config.target == OutputKind.Exe { return String.from(&"build/a.out"); }
    let file = units.file(UnitId(0u64)).path();
    let name = match Path.new(file).file_name() { Some(value) => value, None => "output", };
    let path = Path.new(name).with_extension(config.target.extension());
    defer path.drop();
    let output = Path.new("build").join(path.as_str());
    defer output.drop();
    String.from(&output.as_str())
}

// The backend driver owns the CFG and publishes the selected artifact.
pub struct BackendDriver {
    // The orchestrator owns these inputs for the driver's lifetime.
    output: AnalysisOutput&,
    units: UnitTable&,
    packages: Option<PackageMap&>,
    names: NameInterner&,
    symbols: SymbolSpace&,
    layout: TargetLayout&,
    config: CompilerConfig&,
    trace: Option<CompilerTrace&>,
    attempted: bool,
    cfg: Option<CfgModule>,
    phase: BackendPhase,
    program: String,
    runtime_profile_dir: Option<String>,
    pass_options: CfgPassOptions,
}

impl BackendDriver {
    static pub fn new(output: AnalysisOutput&, units: UnitTable&, packages: Option<PackageMap&>,
        names: NameInterner&, symbols: SymbolSpace&, types: TypeSpace&, layout: TargetLayout&,
        config: CompilerConfig&, trace: Option<CompilerTrace&>) -> Self {
        let layout_store: TypeSpace& = layout.backend_types().semantic_store();
        if !same_type_space(layout_store, types) {
            @panic("backend layout uses a different type space");
        }
        if layout.backend_types().raw_pointers() != output.raw_pointers
        || config.raw_pointers != output.raw_pointers {
            @panic("inconsistent backend configuration");
        }
        let pass_options = CfgPassOptions(config.cfg_inline, config.fat_check_elimination);
        Self(output, units, packages, names, symbols, layout, config, trace, false,
            Option<CfgModule>.None, BackendPhase.Created, String.new(), Option<String>.None,
            pass_options)
    }

    fn cfg_ref() -> CfgModule& {
        match &self.cfg {
            Some(value) => value,
            None => @panic("E599: CFG is not available"),
        }
    }

    fn lower(program: str, runtime_profile_dir: Option<str>,
        trace: Option<CompilerTrace&>) -> Result<CfgModule&, CodegenError> {
        if self.phase != BackendPhase.Created {
            @panic("backend lowering has already started");
        }
        self.phase = BackendPhase.Failed;
        self.program.drop();
        self.program = String.from(&program);
        match &self.runtime_profile_dir { Some(value) => value.drop(), None => {}, }
        self.runtime_profile_dir = match runtime_profile_dir { Some(value) => Option<String>.Some(String.from(&value)), None => Option<String>.None };
        finish_analysis_observed(self.layout.backend_types(), trace);
        let cfg = lower_cfg(self.output.hir(), self.symbols, self.layout.backend_types(), self.output, trace)?;
        let accepted = false;
        defer { if !accepted { cfg.drop(); } };
        verify_structure_observed(&cfg, trace)?;
        cleanup_observed(&cfg, trace)?;
        verify_cfg_observed(&cfg, self.layout.backend_types(), trace)?;
        if self.runtime_profile_dir.is_some() {
            match trace { Some(observer) => observer.skip("cfg.inline", "runtime profiling keeps logical function boundaries"), None => {}, }
        } elif self.layout.backend_types().raw_pointers() {
            match trace { Some(observer) => observer.skip("cfg.inline", "raw-pointer mode keeps original function boundaries"), None => {}, }
        } elif !self.pass_options.inline {
            match trace { Some(observer) => observer.skip("cfg.inline", "CFG inlining is disabled by configuration"), None => {}, }
        } else {
            inline_observed(&cfg, self.layout.backend_types(), self.pass_options, trace)?;
        }
        verify_cfg_observed(&cfg, self.layout.backend_types(), trace)?;
        prepare_safety_observed(&cfg, self.layout.backend_types(), trace)?;
        verify_cfg_observed(&cfg, self.layout.backend_types(), trace)?;
        eliminate_observed(&cfg, self.layout.backend_types(), self.pass_options, trace)?;
        verify_cfg_observed(&cfg, self.layout.backend_types(), trace)?;
        self.cfg = Option<CfgModule>.Some(cfg);
        accepted = true;
        self.phase = BackendPhase.Lowered;
        Result<CfgModule&, CodegenError>.Ok(self.cfg_ref())
    }

    fn generate(trace: Option<CompilerTrace&>) -> Result<(), CodegenError> {
        self.phase = BackendPhase.Failed;
        let cfg = self.cfg_ref();
        verify_cfg_observed(cfg, self.layout.backend_types(), trace)?;
        let profile_dir = match &self.runtime_profile_dir { Some(value) => Option<str>.Some(value.as_str()), None => Option<str>.None };
        lower_llvm(self.names, self.units, self.packages, self.layout.backend_types(),
            self.layout.llvm_module(), cfg,
            self.program.as_str(), profile_dir, trace)?;
        self.phase = BackendPhase.Generated;
        Result<(), CodegenError>.Ok(())
    }

    fn emit(target: OutputKind, trace: Option<CompilerTrace&>) -> Result<Emission, CodegenError> {
        if (self.phase != BackendPhase.Lowered && self.phase != BackendPhase.Generated) {
            @panic("backend emission is not permitted in this state");
        }
        if self.phase == BackendPhase.Lowered { self.generate(trace)?; }
        self.phase = BackendPhase.Failed;
        let module = self.layout.llvm_module();
        let bytes = match target {
            Ll => match module.try_ir_observed(llvm_observer(trace)) {
                Ok(value) => value,
                Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
            },
            Bc => {
                match module.optimize_observed(llvm_observer(trace)) {
                    Ok(_) => {},
                    Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
                }
                match module.try_bitcode_observed(llvm_observer(trace)) {
                    Ok(value) => value,
                    Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
                }
            },
            Exe => match module.object_observed(llvm_observer(trace)) {
                Ok(value) => value,
                Err(message) => return Result<Emission, CodegenError>.Err(CodegenError.llvm_error(message)),
            },
        };
        self.phase = BackendPhase.Emitted;
        Result<Emission, CodegenError>.Ok(Emission(target, bytes))
    }

    fn snapshot(trace: Option<CompilerTrace&>) -> Result<Vec<u8>, CodegenError> {
        if self.phase != BackendPhase.Lowered && self.phase != BackendPhase.Generated {
            @panic("LLVM snapshot is unavailable in this state");
        }
        if self.phase == BackendPhase.Lowered { self.generate(trace)?; }
        match self.layout.llvm_module().try_ir_observed(llvm_observer(trace)) {
            Ok(value) => Result<Vec<u8>, CodegenError>.Ok(value),
            Err(message) => Result<Vec<u8>, CodegenError>.Err(CodegenError.llvm_error(message)),
        }
    }

    pub fn run() -> Result<(), BackendCompileError> {
        if self.attempted {
            @panic("backend driver cannot run twice");
        }
        self.attempted = true;
        let config = self.config;
        let trace = self.trace;
        for library in config.link_libraries {
            let valid = !library.is_empty() && !library.as_str().starts_with("-");
            for current in library.as_str().chars() {
                if !is_alphanumeric(current) && !"_+.-".contains_char(current) { valid = false; }
            }
            if !valid {
                return Result<(), BackendCompileError>.Err(BackendCompileError.Output(
                    OutputError(String.from(&"invalid --link-lib name"), DiagnosticCode.CommandLine, DiagnosticLocation.Global)));
            }
        }
        match trace { Some(value) => value.start_pass("cfg_pipeline", "cfg", "HIR to CFG", ProfileKind.Stage), None => {}, };
        let destination_path = destination(config, self.units);
        defer destination_path.drop();
        let program = match resolve(destination_path.as_str()) {
            Ok(value) => { let text = String.from(&value.as_str()); value.drop(); text },
            Err(problem) => { problem.drop(); String.from(&destination_path.as_str()) },
        };
        defer program.drop();
        let runtime_profile_dir = match &config.runtime_profile_dir { Some(value) => Option<str>.Some(value.as_str()), None => Option<str>.None };
        let lowered = self.lower(program.as_str(), runtime_profile_dir, trace);
        let cfg = match lowered {
            Ok(value) => { match trace { Some(observer) => observer.finish("cfg_pipeline"), None => {}, }; value },
            Err(problem) => {
                match trace { Some(observer) => observer.fail("cfg_pipeline"), None => {}, }
                return Result<(), BackendCompileError>.Err(BackendCompileError.Codegen(problem));
            },
        };
        if config.dump {
            match trace { Some(value) => value.start_pass("io.dump", "io", "CFG dump", ProfileKind.Tool), None => {}, };
            match cfg_dump(cfg) {
                Ok(_) => match trace { Some(observer) => observer.finish("io.dump"), None => {}, },
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("io.dump"), None => {}, }
                    return Result<(), BackendCompileError>.Err(BackendCompileError.Output(problem));
                },
            }
        }
        match trace { Some(value) => value.start_pass("llvm_pipeline", "llvm", "LLVM lowering and emission", ProfileKind.Stage), None => {}, };
        if config.optimization == 0u8 { match trace { Some(value) => value.skip("llvm.optimize", "-O0 skips the LLVM IR optimization pipeline"), None => {}, } }
        if config.target == OutputKind.Ll {
            for pass_id in ["llvm.verify_before_optimization", "llvm.optimize", "llvm.verify_after_optimization", "llvm.emit_native", "llvm.serialize_bitcode"] {
                match trace { Some(value) => value.skip(*pass_id, "target ll serializes IR without the native emission verification pipeline"), None => {}, }
            }
        } else {
            if !config.dump { match trace { Some(value) => value.skip("llvm.serialize_ir", "LLVM IR serialization is only selected by target ll or --dump"), None => {}, } }
            if config.target != OutputKind.Bc { match trace { Some(value) => value.skip("llvm.serialize_bitcode", "bitcode serialization is only selected by target bc"), None => {}, } }
            if config.target != OutputKind.Exe { match trace { Some(value) => value.skip("llvm.emit_native", "selected target does not emit native object code"), None => {}, } }
        }
        if config.target != OutputKind.Exe {
            for pass_id in ["native.prepare", "native.runtime_compile", "native.runtime_archive", "native.c_shim_compile", "native.link_flags", "native.link"] {
                match trace { Some(value) => value.skip(*pass_id, "selected target does not invoke native linking"), None => {}, }
            }
        }
        if config.dump {
            let snapshot = self.snapshot(trace);
            let ir = match snapshot {
                Ok(value) => value,
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("llvm_pipeline"), None => {}, }
                    return Result<(), BackendCompileError>.Err(BackendCompileError.Codegen(problem));
                },
            };
            defer ir.drop();
            match trace { Some(value) => value.start_pass("io.dump", "io", "LLVM IR dump", ProfileKind.Tool), None => {}, };
            match ir_dump(&ir) {
                Ok(_) => match trace { Some(observer) => observer.finish("io.dump"), None => {}, },
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("io.dump"), None => {}, }
                    match trace { Some(observer) => observer.fail("llvm_pipeline"), None => {}, }
                    return Result<(), BackendCompileError>.Err(BackendCompileError.Output(problem));
                },
            }
        }
        let emitted = self.emit(config.target, trace);
        let emission = match emitted {
            Ok(value) => { match trace { Some(observer) => observer.finish("llvm_pipeline"), None => {}, }; value },
            Err(problem) => {
                match trace { Some(observer) => observer.fail("llvm_pipeline"), None => {}, }
                return Result<(), BackendCompileError>.Err(BackendCompileError.Codegen(problem));
            },
        };
        defer emission.drop();
        let path = destination(config, self.units);
        defer path.drop();
        match trace { Some(value) => value.start_pass("io.artifact_publish", "io", "prepare temporary artifact directory", ProfileKind.Tool), None => {}, };
        let publish_directory_ready = false;
        defer { if !publish_directory_ready { fail_publish(trace); } };
        let parent = match Path.new(path.as_str()).parent() { Some(value) => if value.as_str() == "" { "." } else { value.as_str() }, None => ".", };
        match create_dir_all(parent) { Ok(_) => {}, Err(problem) => { let error = output_error(path.as_str(), problem.msg()); problem.drop(); return Result<(), BackendCompileError>.Err(error); }, }
        let directory = match temporary_directory(parent) {
            Ok(value) => value,
            Err(problem) => { let error = output_error(path.as_str(), problem.msg()); problem.drop(); return Result<(), BackendCompileError>.Err(error); },
        };
        match trace { Some(observer) => observer.finish("io.artifact_publish"), None => {}, }
        publish_directory_ready = true;
        defer directory.drop();
        let object = Path.new(directory.as_str()).join("input.o");
        defer object.drop();
        let temporary = Path.new(directory.as_str()).join("output");
        defer temporary.drop();
        defer cleanup_directory(directory.as_str(), object.as_str(), temporary.as_str());
        match trace { Some(value) => value.start_pass("io.artifact_publish", "io", "write temporary compiler artifact", ProfileKind.Tool), None => {}, };
        match write(object.as_str(), emission.bytes.as_slice()) {
            Ok(_) => match trace { Some(observer) => observer.finish("io.artifact_publish"), None => {}, },
            Err(problem) => {
                match trace { Some(observer) => observer.fail("io.artifact_publish"), None => {}, }
                let error = output_error(path.as_str(), problem.msg());
                problem.drop();
                return Result<(), BackendCompileError>.Err(error);
            },
        }
        if config.target == OutputKind.Exe {
            match trace { Some(value) => value.start_pass("native_pipeline", "main", "native linking", ProfileKind.Stage), None => {}, };
            match trace { Some(value) => value.start_pass("native.prepare", "native", "native configuration", ProfileKind.Pass), None => {}, };
            let root = match runtime_root(config) {
                Ok(value) => value,
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("native.prepare"), None => {}, }
                    match trace { Some(observer) => observer.fail("native_pipeline"), None => {}, }
                    return Result<(), BackendCompileError>.Err(BackendCompileError.Input(problem));
                },
            };
            defer root.drop();
            let driver = match NativeDriver.new(root.as_str(), self.packages) {
                Ok(value) => value,
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("native.prepare"), None => {}, }
                    match trace { Some(observer) => observer.fail("native_pipeline"), None => {}, }
                    retain_object(object.as_str(), path.as_str());
                    return Result<(), BackendCompileError>.Err(BackendCompileError.Native(problem));
                },
            };
            match trace { Some(observer) => observer.finish("native.prepare"), None => {}, }
            defer driver.drop();
            match driver.link_observed(object.as_str(), temporary.as_str(), config.optimization,
                &config.link_libraries, &config.link_searches, config.runtime_profile_dir.is_some(), trace) {
                Ok(artifact) => artifact.drop(),
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("native_pipeline"), None => {}, }
                    retain_object(object.as_str(), path.as_str());
                    return Result<(), BackendCompileError>.Err(BackendCompileError.Native(problem));
                },
            }
            match trace { Some(observer) => observer.finish("native_pipeline"), None => {}, }
            match trace { Some(value) => value.start_pass("io.artifact_publish", "io", "publish native artifact", ProfileKind.Tool), None => {}, };
            match rename(temporary.as_str(), path.as_str()) {
                Ok(_) => match trace { Some(observer) => observer.finish("io.artifact_publish"), None => {}, },
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("io.artifact_publish"), None => {}, }
                    let error = output_error(path.as_str(), problem.msg());
                    problem.drop();
                    return Result<(), BackendCompileError>.Err(error);
                },
            }
        } else {
            match trace { Some(value) => value.start_pass("io.artifact_publish", "io", "publish compiler artifact", ProfileKind.Tool), None => {}, };
            match rename(object.as_str(), path.as_str()) {
                Ok(_) => match trace { Some(observer) => observer.finish("io.artifact_publish"), None => {}, },
                Err(problem) => {
                    match trace { Some(observer) => observer.fail("io.artifact_publish"), None => {}, }
                    let error = output_error(path.as_str(), problem.msg());
                    problem.drop();
                    return Result<(), BackendCompileError>.Err(error);
                },
            }
        }
        Result<(), BackendCompileError>.Ok(())
    }
}

impl Drop for BackendDriver {
    pub fn drop() {
        match &self.cfg {
            Some(value) => value.drop(),
            None => {},
        }
        self.program.drop();
        match &self.runtime_profile_dir { Some(value) => value.drop(), None => {}, }
    }
}
