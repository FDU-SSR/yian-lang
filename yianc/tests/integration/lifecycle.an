from std.core.fs import resolve;
from yianc.common.ids import UnitId;
from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.parse.items import parse_program;
from yianc.frontend.desugar import desugar;
from yianc.frontend.ast.format import AstFormatter;
from yianc.frontend.ast.node import Identifier;
from yianc.frontend.ast.traversal import AstVisitor, walk_program;
from yianc.frontend.source import SourceFile, SourceMap, SourceTable;
from yianc.frontend.unit import UnitTable;
from json.write import Writer;
from json.parse import parse;
from std.core.env import args;
from std.core.ops import Index;
from std.core.process import Command, ExitStatus;
from yianc.types.space import TypeSpace;
from yianc.common.names import NameInterner;
from yianc.analysis.symbol.scope import SymbolSpace;
from yianc.frontend.driver import FrontendDriver;
from yianc.telemetry.trace import CompilerTrace;
from yianc.analysis.driver import MiddleEndDriver;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.diagnostics.model import DiagnosticReporter, UserDiagnostic;
from yianc.package.provenance import SourceTrust;
from yianc.package.model import PackageMap;

struct DiagnosticCounter { count: u64 }
impl DiagnosticReporter for DiagnosticCounter {
    pub fn report(diagnostic: UserDiagnostic&) { self.count += 1; }
}

struct Counter { owned_names: u64 }
impl AstVisitor for Counter {
    pub fn enter_identifier(node: Identifier&) -> bool {
        if node.data.name.as_str() == "owned" { self.owned_names += 1; }
        true
    }
}
fn success() {
    let names = NameInterner.new();
    defer names.drop();
    let source = String.from(&"fn owned() { let text = \"中😀\"; for x in values() { consume(x); } }");
    let tokens = *Lexer.new(source.as_str(), &names).run().unwrap();
    source.drop();
    assert tokens[1].value() == "owned": "interned token identifier survives source release";
    let distinct = names.len();
    names.intern("owned");
    names.intern("中😀");
    assert names.len() == distinct: "identifier and decoded literal are already interned";
    let parser = Parser.new(&tokens, &names);
    defer parser.drop();
    let tree = *parse_program(&parser).unwrap();
    defer tree.drop();
    tokens.drop();
    let counter = Counter(0u64);
    walk_program(tree.root, &counter);
    assert counter.owned_names == 1: "AST names survive token release";
    desugar(&tree, "owned.an", &names).unwrap();
    let writer = Writer.with_max_depth(512u64);
    defer writer.drop();
    let formatter = AstFormatter.new(&writer);
    formatter.append_program(tree.root);
    let text = *writer.finish().unwrap();
    defer text.drop();
    let json = *parse(text.as_str()).unwrap();
    json.drop();
}
fn lex_failure() {
    let names = NameInterner.new();
    defer names.drop();
    let source = String.from(&"let name = \"owned\"; \"unterminated");
    let result = Lexer.new(source.as_str(), &names).run();
    source.drop();
    match result {
        Err(error) => { assert error.message().contains("Unterminated"): "lex error survives source release"; error.drop(); },
        Ok(tokens) => { tokens.drop(); @panic("lex failure accepted"); },
    }
}
fn parse_failure() {
    let names = NameInterner.new();
    defer names.drop();
    let source = String.from(&"struct Owned { field: str } fn broken() { let text = \"owned\"; call(");
    let tokens = *Lexer.new(source.as_str(), &names).run().unwrap();
    source.drop();
    let parser = Parser.new(&tokens, &names);
    defer parser.drop();
    let result = parse_program(&parser);
    tokens.drop();
    match result {
        Err(error) => { assert error.message().as_slice().len() != 0: "parse error survives token release"; error.drop(); },
        Ok(tree) => { tree.drop(); @panic("parse failure accepted"); },
    }
}
fn desugar_failure() {
    let names = NameInterner.new();
    defer names.drop();
    let source = String.from(&"const VALUE: i32 = source()?;");
    let tokens = *Lexer.new(source.as_str(), &names).run().unwrap();
    source.drop();
    let parser = Parser.new(&tokens, &names);
    defer parser.drop();
    let tree = *parse_program(&parser).unwrap();
    tokens.drop();
    let result = desugar(&tree, "owned.an", &names);
    tree.drop();
    match result {
        Err(error) => {
            assert error.message().contains("only allowed inside"): "desugar error owns message";
            assert error.span().end.column > error.span().start.column: "desugar error owns range";
            error.drop();
        },
        Ok(_) => @panic("desugar failure accepted"),
    }
}
fn unfinished_parser() {
    let names = NameInterner.new();
    defer names.drop();
    let tokens = *Lexer.new("name", &names).run().unwrap();
    defer tokens.drop();
    let parser = Parser.new(&tokens, &names);
    defer parser.drop();
    parser.identifier().unwrap();
    parser.error("owned error", tokens[0].span);
}

fn load_source(path: str, text: str, names: NameInterner&) -> SourceTable {
    let canonical = match resolve(path) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source path resolution failed"); },
    };
    let files = Vec<SourceFile>.new();
    files.push(SourceFile.new(canonical, String.from(&text), names));
    match SourceTable.from_files(files) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source load failed"); },
    }
}

fn trust() -> SourceTrust {
    match SourceTrust.new("../../../lib/src") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not create source trust"); },
    }
}

fn strict_lifecycle_units(names: NameInterner&) -> UnitTable {
    let trace = CompilerTrace.disabled();
    defer trace.drop();
    let frontend = FrontendDriver.new(load_source("/tmp/yian-native-strict-lifecycle.an", "struct Record { field: i32 }\nfn helper(value: Record) -> Record { value }\nconst SIZE: u64 = 8;\nfn main() { helper(Record(1)); }\n", names), false, &trace, names);
    defer frontend.drop();
    let units = match frontend.run() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture preparation failed"); },
    };
    units
}

fn check_strict_lifecycle(raw: bool) {
    let names = NameInterner.new();
    defer names.drop();
    let units = strict_lifecycle_units(&names);
    defer units.drop();
    let types = TypeSpace.new();
    defer types.drop();
    let symbols = SymbolSpace.new();
    defer symbols.drop();
    let reporter = DiagnosticCounter(0);
    let driver = MiddleEndDriver.new(&units, Option<PackageMap&>.None, &names, &types,
        &symbols, trust(), raw, AnalysisOptions.new(), &reporter);
    let analysis = driver.run();
    driver.drop();
    let output = match analysis {
        Ok(value) => value,
        Err(_) => @panic("strict analysis failed"),
    };
    defer output.drop();
    assert output.procedures.len() >= 2u64: "strict analysis exports checked procedure roots";
    assert reporter.count == 0u64: "a clean strict analysis emits no warnings";
    assert output.entry.is_some(): "strict analysis selects an entry when main exists";
    assert units.len() == 1u64: "the caller keeps its prepared unit alive after analysis";
}

// The second analysis violates the driver attempt guard; the caller isolates the panic.
fn repeat_analysis(raw: bool) {
    let names = NameInterner.new();
    defer names.drop();
    let units = strict_lifecycle_units(&names);
    defer units.drop();
    let types = TypeSpace.new();
    defer types.drop();
    let symbols = SymbolSpace.new();
    defer symbols.drop();
    let reporter = DiagnosticCounter(0);
    let driver = MiddleEndDriver.new(&units, Option<PackageMap&>.None, &names, &types,
        &symbols, trust(), raw, AnalysisOptions.new(), &reporter);
    defer driver.drop();
    let output = match driver.run() {
        Ok(value) => value,
        Err(_) => @panic("strict analysis failed"),
    };
    output.drop();
    match driver.run() {
        Ok(again) => @panic("strict session accepted a second analysis"),
        Err(_) => @panic("a repeated analysis returned a value error"),
    }
}

// Run one selectable negative branch in a child process so the invariant panic
// stays outside this process while its raw stderr and status are asserted.
fn assert_child_panic(flag: str, expected: str) {
    let arguments = args();
    let program = String.from(&arguments[0].as_str());
    defer program.drop();
    let command = Command.new(program.as_str());
    defer command.drop();
    command.arg(flag);
    let output = match command.output() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not start the isolation child"); },
    };
    defer output.drop();
    match output.status {
        ExitStatus.Exited(code) => assert code == 1i32: "an internal invariant exits with status 1",
        ExitStatus.Signaled(_) => @panic("an internal invariant was reported as a signal"),
    };
    let text = match str.from_slice(output.stderr.as_slice()) {
        Some(value) => value,
        None => @panic("isolation child stderr is not UTF-8"),
    };
    assert text.contains("yian: panic: "): "an internal invariant reports the panic prefix";
    assert text.contains(expected): "an internal invariant reports its reason";
    for argument in arguments { argument.drop(); }
    arguments.drop();
}

fn strict_analysis_lifecycle() {
    check_strict_lifecycle(false);
    check_strict_lifecycle(true);
    assert_child_panic("--repeat-analysis", "analysis session cannot be analyzed twice");
}

fn strict_analysis_reports_first_error() {
    let names = NameInterner.new();
    defer names.drop();
    let trace = CompilerTrace.disabled();
    defer trace.drop();
    let frontend = FrontendDriver.new(load_source("/tmp/yian-native-strict-error.an", "fn bad_one() { let value: i32 = true; }\nfn bad_two() { let value: bool = \"wrong\"; }\nfn main() {}\n", &names), false, &trace, &names);
    defer frontend.drop();
    let units = match frontend.run() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture preparation failed"); },
    };
    defer units.drop();
    let types = TypeSpace.new();
    defer types.drop();
    let symbols = SymbolSpace.new();
    defer symbols.drop();
    let reporter = DiagnosticCounter(0);
    let driver = MiddleEndDriver.new(&units, Option<PackageMap&>.None, &names, &types,
        &symbols, trust(), false, AnalysisOptions.new(), &reporter);
    defer driver.drop();
    match driver.run() {
        Ok(output) => @panic("invalid strict fixture passed analysis"),
        Err(error) => {
            assert error.code.text() == "E401": "strict failure keeps the type diagnostic code";
            assert error.message.as_str().contains("Expected type"):
            "strict failure reports the first type error";
            error.drop();
        },
    }
}

// The frontend hands over one completed unit per source, indexed by UnitId.
fn unit_table_contract() {
    let names = NameInterner.new();
    defer names.drop();
    let trace = CompilerTrace.disabled();
    defer trace.drop();
    let first_path = match resolve("/tmp/yian-native-unit-table-first.an") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source path resolution failed"); },
    };
    let second_path = match resolve("/tmp/yian-native-unit-table-second.an") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source path resolution failed"); },
    };
    let files = Vec<SourceFile>.new();
    files.push(SourceFile.new(first_path, String.from(&"fn first() {}\n"), &names));
    files.push(SourceFile.new(second_path, String.from(&"fn second() {}\n"), &names));
    let sources = match SourceTable.from_files(files) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source load failed"); },
    };
    let frontend = FrontendDriver.new(sources, false, &trace, &names);
    defer frontend.drop();
    let table = match frontend.run() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture preparation failed"); },
    };
    defer table.drop();
    let first = UnitId(0u64);
    let second = UnitId(1u64);
    assert table.len() == 2u64: "the table holds one unit per source";
    assert table[first].id.index == 0u64: "the first unit keeps its ID";
    assert table[second].id.index == 1u64: "the second unit keeps its ID";
    assert table[first].tokens.len() > 0u64: "the first unit keeps its tokens";
    assert table[first].tree.root.data.items.len() == 1u64: "the first unit keeps its AST";
    assert table.file(first).text() == "fn first() {}\n": "the table serves the first source";
    assert table.file(second).text() == "fn second() {}\n": "the table serves the second source";
}

fn main() {
    let arguments = args();
    if arguments.len() > 1u64 && arguments[1].as_str() == "--repeat-analysis" {
        repeat_analysis(false);
        return;
    }
    for argument in arguments { argument.drop(); }
    arguments.drop();
    success();
    lex_failure();
    parse_failure();
    desugar_failure();
    unfinished_parser();
    strict_analysis_lifecycle();
    strict_analysis_reports_first_error();
    unit_table_contract();
}
