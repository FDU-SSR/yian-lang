from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.lex.token import drop_tokens;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.parse.items import parse_program;
from yianc.frontend.desugar import desugar;
from yianc.frontend.ast.format import AstFormatter;
from yianc.frontend.ast.node import Identifier;
from yianc.frontend.ast.traversal import AstVisitor, walk_program;
from yianc.frontend.source import SourceDocument;
from json.write import Writer;
from json.parse import parse;
from std.core.drop import Drop;
from std.core.ops import Index;
from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.session.prepare import PreparationObserver;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.diagnostics.model import AnalysisErrorKind;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;

struct Counter { owned_names: u64 }
impl AstVisitor for Counter {
    pub fn enter_identifier(node: Identifier&) -> bool {
        if node.data.name.as_str() == "owned" { self.owned_names += 1; }
        true
    }
}
fn success() {
    let source = String.from(&"fn owned() { let text = \"中😀\"; for x in values() { consume(x); } }");
    let tokens = *Lexer.new(source.as_str()).run().unwrap();
    source.drop();
    assert tokens[1].value() == "owned": "tokens own identifier after source release";
    let parser = Parser.new(&tokens);
    defer parser.drop();
    let tree = *parse_program(&parser).unwrap();
    defer tree.drop();
    drop_tokens(&tokens);
    let counter = Counter(0u64);
    walk_program(tree.root, &counter);
    assert counter.owned_names == 1: "AST names survive token release";
    desugar(&tree, "owned.an").unwrap();
    let writer = Writer.with_max_depth(512u64);
    defer writer.drop();
    let formatter = AstFormatter.new(&writer);
    formatter.append_program(tree.root);
    let text = *writer.finish().unwrap();
    defer text.drop();
    let json = *parse(text.as_str()).unwrap();
    json.drop();
}
fn lex_failure() {
    let source = String.from(&"let name = \"owned\"; \"unterminated");
    let result = Lexer.new(source.as_str()).run();
    source.drop();
    match result {
        Err(error) => { assert error.message().contains("Unterminated"): "lex error survives source release"; error.drop(); },
        Ok(tokens) => { drop_tokens(&tokens); @panic("lex failure accepted"); },
    }
}
fn parse_failure() {
    let source = String.from(&"struct Owned { field: str } fn broken() { let text = \"owned\"; call(");
    let tokens = *Lexer.new(source.as_str()).run().unwrap();
    source.drop();
    let parser = Parser.new(&tokens);
    defer parser.drop();
    let result = parse_program(&parser);
    drop_tokens(&tokens);
    match result {
        Err(error) => { assert error.message().as_slice().len() != 0: "parse error survives token release"; error.drop(); },
        Ok(tree) => { tree.drop(); @panic("parse failure accepted"); },
    }
}
fn desugar_failure() {
    let source = String.from(&"const VALUE: i32 = source()?;");
    let tokens = *Lexer.new(source.as_str()).run().unwrap();
    source.drop();
    let parser = Parser.new(&tokens);
    defer parser.drop();
    let tree = *parse_program(&parser).unwrap();
    drop_tokens(&tokens);
    let result = desugar(&tree, "owned.an");
    tree.drop();
    match result {
        Err(error) => {
            assert error.message().contains("only allowed inside"): "desugar error owns message";
            assert error.span().end.column > error.span().start.column: "desugar error owns range";
            error.drop();
        },
        Ok(_) => @panic("desugar failure accepted"),
    }
}
fn unfinished_parser() {
    let tokens = *Lexer.new("name").run().unwrap();
    defer drop_tokens(&tokens);
    let parser = Parser.new(&tokens);
    defer parser.drop();
    parser.identifier().unwrap();
    parser.error("owned error", tokens[0].span);
}

fn release_documents(documents: Vec<SourceDocument>&) {
    for document in *documents { document.drop(); }
    documents.drop();
}

fn trust() -> SourceTrust {
    match SourceTrust.new("../../../lib/src") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not create source trust"); },
    }
}

fn check_strict_lifecycle(raw: bool) {
    let documents = Vec<SourceDocument>.new();
    documents.push(SourceDocument(path=String.from(&"/tmp/yian-native-strict-lifecycle.an"),
        text=String.from(&"struct Record { field: i32 }\nfn helper(value: Record) -> Record { value }\nconst SIZE: u64 = 8;\nfn main() { helper(Record(1)); }\n")));
    defer release_documents(&documents);
    let session = match AnalysisSession.prepare_documents(&documents, trust(), Option<PackageMap>.None,
        raw, false, Option<PreparationObserver&>.None) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("strict preparation failed"); },
    };
    let transferred = false;
    defer { if !transferred { session.drop(); } };
    let output = match session.analyze(AnalysisOptions.new()) {
        Ok(value) => value,
        Err(error) => { error.drop(); session.drop(); @panic("strict analysis failed"); },
    };
    assert output.procedures.len() >= 2u64: "strict analysis exports checked procedure roots";
    assert output.warnings.len() == 0u64: "a clean strict analysis emits no warnings";
    assert output.entry.is_some(): "strict analysis selects an entry when main exists";
    let second = session.analyze(AnalysisOptions.new());
    match second {
        Err(error) => { assert error.kind == AnalysisErrorKind.Internal: "a session cannot analyze twice"; error.drop(); },
        Ok(again) => { again.drop(); @panic("strict session accepted a second analysis"); },
    }
    assert session.len() == 1u64: "the session keeps its prepared unit until its owner drops";
    output.drop();
    transferred = true;
    session.drop();
}

fn strict_analysis_lifecycle() {
    check_strict_lifecycle(false);
    check_strict_lifecycle(true);
}

fn strict_analysis_reports_first_error() {
    let documents = Vec<SourceDocument>.new();
    documents.push(SourceDocument(path=String.from(&"/tmp/yian-native-strict-error.an"),
        text=String.from(&"fn bad_one() { let value: i32 = true; }\nfn bad_two() { let value: bool = \"wrong\"; }\nfn main() {}\n")));
    defer release_documents(&documents);
    let session = match AnalysisSession.prepare_documents(&documents, trust(), Option<PackageMap>.None,
        false, false, Option<PreparationObserver&>.None) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("strict error fixture preparation failed"); },
    };
    match session.analyze(AnalysisOptions.new()) {
        Ok(output) => { output.drop(); session.drop(); @panic("invalid strict fixture passed analysis"); },
        Err(error) => {
            assert error.diagnostic.code.text() == "E401": "strict failure keeps the type diagnostic code";
            assert error.diagnostic.message.as_str().contains("Expected type"):
            "strict failure reports the first type error";
            error.drop();
        },
    }
    session.drop();
}

fn main() {
    success();
    lex_failure();
    parse_failure();
    desugar_failure();
    unfinished_parser();
    strict_analysis_lifecycle();
    strict_analysis_reports_first_error();
}
