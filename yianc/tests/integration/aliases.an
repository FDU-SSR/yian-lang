from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.session.prepare import PreparationObserver;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.analysis.ty.queries import struct_fields;
from yianc.common.ids import TypeId;
from yianc.diagnostics.model import AnalysisError;
from yianc.frontend.source import SourceDocument;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from std.core.drop import Drop;

fn release_documents(documents: Vec<SourceDocument>&) {
    for document in *documents { document.drop(); }
    documents.drop();
}

fn trust() -> SourceTrust {
    match SourceTrust.new("../../../lib/src") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not create source trust"); },
    }
}

fn prepare(source: str, path: str) -> AnalysisSession {
    let documents = Vec<SourceDocument>.new();
    documents.push(SourceDocument(path=String.from(&path), text=String.from(&source)));
    defer release_documents(&documents);
    match AnalysisSession.prepare_documents(&documents, trust(), Option<PackageMap>.None,
        IS_RAW_MODE, false, Option<PreparationObserver&>.None) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("strict fixture preparation failed"); },
    }
}

fn analyze_success(source: str, path: str) -> AnalysisSession {
    let session = prepare(source, path);
    match session.analyze(AnalysisOptions.new()) {
        Ok(output) => { output.drop(); session },
        Err(error) => {
            error.drop();
            session.drop();
            @panic("strict fixture analysis failed");
        },
    }
}

fn analyze_failure(source: str, path: str) -> AnalysisError {
    let session = prepare(source, path);
    match session.analyze(AnalysisOptions.new()) {
        Ok(output) => { output.drop(); session.drop(); @panic("invalid fixture passed strict analysis"); },
        Err(error) => { session.drop(); error },
    }
}

fn symbol_type(session: AnalysisSession&, name: str) -> TypeId {
    let index = 0u64;
    while index < session.symbols.symbol_count() {
        let symbol = session.symbols.symbol_at(index).unwrap();
        if session.names.text(symbol.name) == name { return symbol.type_id; }
        index += 1u64;
    }
    @panic("fixture declaration is missing");
}

fn nested_aliases_share_structural_identity() {
    let source = "typedef Int = i32;\nstruct Box<T> { value: T }\ntrait View<T> { fn get() -> T; }\ntypedef Left = (Box<Int>, Int*, Int&, Int[], Int[4], Fn<(Int,), Int>, View<Int>&);\ntypedef Right = (Box<i32>, i32*, i32&, i32[], i32[4], Fn<(i32,), i32>, View<i32>&);\nstruct Vec<T> { value: T }\ntypedef AliasVec = Vec<Int>;\ntypedef DirectVec = Vec<i32>;\nfn main() { let left: Left; let right: Right; let alias: AliasVec; let direct: DirectVec; }\n";
    let session = analyze_success(source, "/tmp/yian-native-alias-identities.an");
    assert symbol_type(&session, "Left") == symbol_type(&session, "Right"):
    "transparent aliases preserve nested tuple, pointer, reference, slice, array, function and trait-object TypeIds";
    assert symbol_type(&session, "AliasVec") == symbol_type(&session, "DirectVec"):
    "nominal generic instances through aliases share the same TypeId";
    session.drop();
}

fn alias_binders_resolve_in_declaration_order() {
    let source = "struct Pair<A, B> { left: A, right: B }\ntypedef Reverse<A, B> = Pair<B, A>;\ntypedef Duplicate<T> = Pair<T, T>;\ntypedef First<A, B> = A;\ntypedef Chain<X, Y> = Reverse<Y, X>;\ntypedef Count = u64;\ntypedef Arr<T, const N: Count> = T[N];\ntypedef Reordered = Chain<i32, u64>;\ntypedef Expected = Pair<i32, u64>;\ntypedef Repeated = Duplicate<i32>;\ntypedef ExpectedRepeated = Pair<i32, i32>;\ntypedef Unused = First<i32, u64>;\ntypedef Array = Arr<i32, 4>;\ntypedef DirectArray = i32[4];\ntypedef Typed<T, const N: T> = T[N];\ntypedef Dependent = Typed<u64, 4>;\ntypedef DirectDependent = u64[4];\ntypedef DirectInt = i32;\nfn check_reordered(value: Reordered) -> Expected { value }\nfn check_repeated(value: Repeated) -> ExpectedRepeated { value }\nfn check_array(value: Array) -> DirectArray { value }\nfn check_dependent(value: Dependent) -> DirectDependent { value }\nfn check_unused(value: Unused) -> DirectInt { value }\nfn main() {}\n";
    let session = analyze_success(source, "/tmp/yian-native-alias-binders.an");
    assert symbol_type(&session, "Reordered") == symbol_type(&session, "Expected"):
    "generic alias binders apply in the declaration's order";
    assert symbol_type(&session, "Repeated") == symbol_type(&session, "ExpectedRepeated"):
    "repeated generic binders preserve structural identity";
    assert symbol_type(&session, "Array") == symbol_type(&session, "DirectArray"):
    "dependent array sizes preserve identity";
    session.drop();
}

fn explicit_and_inferred_alias_calls_analyze() {
    let source = "typedef Int = i32;\nstruct Box<T> { value: T }\ntypedef AliasBox<T> = Box<T>;\nfn identity<T>(value: T) -> T { value }\nfn main() {\n    identity<AliasBox<Int>>(AliasBox<Int>(1));\n    identity<Box<i32>>(Box<i32>(2));\n    identity(AliasBox<i32>(3));\n}\n";
    let session = analyze_success(source, "/tmp/yian-native-alias-instances.an");
    assert session.definitions.len() == 3u64:
    "two source procedures and one interned identity<i32> instance are registered";
    session.drop();
}

fn check_alias_failure(source: str, message: str, code: str) {
    let error = analyze_failure(source, "/tmp/yian-native-alias-cycle.an");
    assert error.diagnostic.message.as_str().contains(message):
    "unused alias cycles and undefined alias bodies retain their diagnostic";
    assert error.diagnostic.code.text() == code: "alias diagnostic keeps its code";
    error.drop();
}

fn alias_cycles_and_recursive_nominal_fields_keep_their_boundaries() {
    check_alias_failure("typedef A = A;\nfn main() {}\n", "A -> A", "E407");
    check_alias_failure("typedef A = B*; typedef B = A[];\nfn main() {}\n", "A -> B -> A", "E407");
    check_alias_failure("typedef A<T> = A<T*>;\nfn main() {}\n", "A -> A", "E407");
    check_alias_failure("typedef A = Missing;\nfn main() {}\n", "Undefined type: Missing", "E302");

    let source = "typedef Node = Link;\nstruct Link { next: Node* }\nfn main() { let node: Node; }\n";
    let session = analyze_success(source, "/tmp/yian-native-alias-recursive-field.an");
    let node = symbol_type(&session, "Node");
    let fields = struct_fields(&session.types, node).unwrap();
    defer fields.drop();
    assert fields.len() == 1u64 && fields[0u64].type_id == session.types.pointer(node):
    "a nominal boundary permits recursive pointer fields with the exact Node pointer identity";
    session.drop();
}

fn check_alias_argument_failure(declaration: str, use: str, message: str, code: str) {
    let source = String.from(&declaration);
    source.push_str("\nfn main() { let value: ");
    source.push_str(use);
    source.push_str("; }\n");
    let error = analyze_failure(source.as_str(), "/tmp/yian-native-alias-argument.an");
    assert error.diagnostic.code.text() == code: "alias argument diagnostic keeps its code";
    assert error.diagnostic.message.as_str().contains(message):
    "alias argument diagnostic keeps its reason";
    match &error.diagnostic.location {
        Some(location) => {
            let span = location.span();
            assert span.start.row == 1u64 && span.start.column == 23u64:
            "alias argument diagnostic points at the use";
        },
        None => @panic("alias argument diagnostic lost its source location"),
    }
    error.drop();
    source.drop();
}

fn alias_argument_diagnostics_point_to_the_use() {
    check_alias_argument_failure("typedef A<T> = T;", "A<i32, u64>", "expects 1 generic arguments", "E405");
    check_alias_argument_failure("typedef A<T> = T;", "A<4>", "requires a type argument", "E499");
    check_alias_argument_failure("typedef A<const N: u64> = i32[N];", "A<i32>", "requires a constant argument", "E499");
    check_alias_argument_failure("typedef A<const N: u64> = i32[N];", "A<4i32>", "incompatible type", "E499");
}

fn main() {
    nested_aliases_share_structural_identity();
    alias_binders_resolve_in_declaration_order();
    explicit_and_inferred_alias_calls_analyze();
    alias_cycles_and_recursive_nominal_fields_keep_their_boundaries();
    alias_argument_diagnostics_point_to_the_use();
}
