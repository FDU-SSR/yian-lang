from std.core.fs import resolve;
from yianc.frontend.driver import FrontendDriver;
from yianc.telemetry.trace import CompilerTrace;
from yianc.analysis.driver import MiddleEndDriver;
from yianc.analysis.session.output import AnalysisOptions;
from yianc.common.names import NameInterner;
from yianc.analysis.symbol.scope import SymbolSpace;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.definition.registry import DefinitionRegistry;
from yianc.analysis.definition.worklist import DefinitionWorklist;
from yianc.analysis.ty.impl_registry import ImplRegistry;
from yianc.analysis.permissions import SourcePermissions;
from yianc.analysis.resolution.context import ResolutionContext;
from yianc.analysis.resolution.declarations import collect_declarations;
from yianc.analysis.resolution.definitions import resolve_definitions;
from yianc.analysis.passes.type_check import check_procedures;
from yianc.types.queries import struct_fields;
from yianc.types.space import TypeSpace;
from yianc.types.layout import TypeSizeProvider;
from yianc.common.ids import UnitId, TypeId;
from yianc.diagnostics.model import AnalysisError, DiagnosticReporter, UserDiagnostic;
from yianc.frontend.source import SourceFile, SourceTable;
from yianc.frontend.unit import UnitTable;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;

struct IgnoreDiagnostics {}
impl DiagnosticReporter for IgnoreDiagnostics { pub fn report(diagnostic: UserDiagnostic&) {} }

fn load_source(path: str, text: str, names: NameInterner&) -> SourceTable {
    let canonical = match resolve(path) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source path resolution failed"); },
    };
    let files = Vec<SourceFile>.new();
    files.push(SourceFile.new(canonical, String.from(&text), names));
    match SourceTable.from_files(files) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source load failed"); },
    }
}

fn trust() -> SourceTrust {
    match SourceTrust.new("../../../lib/src") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not create source trust"); },
    }
}

struct AliasSymbols {
    names: NameInterner,
    symbols: SymbolSpace,
}

impl Drop for AliasSymbols {
    pub fn drop() {
        self.symbols.drop();
        self.names.drop();
    }
}

fn parse_units(source: str, path: str, names: NameInterner&) -> UnitTable {
    let trace = CompilerTrace.disabled();
    defer trace.drop();
    let frontend = FrontendDriver.new(load_source(path, source, names), false, &trace, names);
    defer frontend.drop();
    let units = match frontend.run() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("strict fixture preparation failed"); },
    };
    units
}

fn analyze_success(source: str, path: str, types: TypeSpace&) -> AliasSymbols {
    let names = NameInterner.new();
    let units = parse_units(source, path, &names);
    let symbols = SymbolSpace.new();
    let reporter = IgnoreDiagnostics();
    let driver = MiddleEndDriver.new(&units, Option<PackageMap&>.None, &names, types,
        &symbols, trust(), IS_RAW_MODE, AnalysisOptions.new(), &reporter);
    let output = match driver.run() {
        Ok(value) => value,
        Err(_) => @panic("strict fixture analysis failed"),
    };
    output.drop();
    driver.drop();
    units.drop();
    AliasSymbols(names, symbols)
}

fn analyze_failure(source: str, path: str, types: TypeSpace&) -> AnalysisError {
    let names = NameInterner.new();
    let units = parse_units(source, path, &names);
    let symbols = SymbolSpace.new();
    let reporter = IgnoreDiagnostics();
    let driver = MiddleEndDriver.new(&units, Option<PackageMap&>.None, &names, types,
        &symbols, trust(), IS_RAW_MODE, AnalysisOptions.new(), &reporter);
    match driver.run() {
        Ok(output) => @panic("invalid fixture passed strict analysis"),
        Err(error) => {
            driver.drop();
            symbols.drop();
            units.drop();
            names.drop();
            error
        },
    }
}

fn symbol_type(fixture: AliasSymbols&, name: str) -> TypeId {
    let index = 0u64;
    while index < fixture.symbols.symbol_count() {
        let symbol = fixture.symbols.symbol_at(index).unwrap();
        if fixture.names.text(symbol.name) == name { return symbol.type_id; }
        index += 1u64;
    }
    @panic("fixture declaration is missing");
}

fn nested_aliases_share_structural_identity() {
    let source = "typedef Int = i32;\nstruct Box<T> { value: T }\ntrait View<T> { fn get() -> T; }\ntypedef Left = (Box<Int>, Int*, Int&, Int[], Int[4], Fn<(Int,), Int>, View<Int>&);\ntypedef Right = (Box<i32>, i32*, i32&, i32[], i32[4], Fn<(i32,), i32>, View<i32>&);\nstruct Vec<T> { value: T }\ntypedef AliasVec = Vec<Int>;\ntypedef DirectVec = Vec<i32>;\nfn main() { let left: Left; let right: Right; let alias: AliasVec; let direct: DirectVec; }\n";
    let types = TypeSpace.new();
    defer types.drop();
    let fixture = analyze_success(source, "/tmp/yian-native-alias-identities.an", &types);
    assert symbol_type(&fixture, "Left") == symbol_type(&fixture, "Right"):
    "transparent aliases preserve nested tuple, pointer, reference, slice, array, function and trait-object TypeIds";
    assert symbol_type(&fixture, "AliasVec") == symbol_type(&fixture, "DirectVec"):
    "nominal generic instances through aliases share the same TypeId";
    fixture.drop();
}

fn alias_binders_resolve_in_declaration_order() {
    let source = "struct Pair<A, B> { left: A, right: B }\ntypedef Reverse<A, B> = Pair<B, A>;\ntypedef Duplicate<T> = Pair<T, T>;\ntypedef First<A, B> = A;\ntypedef Chain<X, Y> = Reverse<Y, X>;\ntypedef Count = u64;\ntypedef Arr<T, const N: Count> = T[N];\ntypedef Reordered = Chain<i32, u64>;\ntypedef Expected = Pair<i32, u64>;\ntypedef Repeated = Duplicate<i32>;\ntypedef ExpectedRepeated = Pair<i32, i32>;\ntypedef Unused = First<i32, u64>;\ntypedef Array = Arr<i32, 4>;\ntypedef DirectArray = i32[4];\ntypedef Typed<T, const N: T> = T[N];\ntypedef Dependent = Typed<u64, 4>;\ntypedef DirectDependent = u64[4];\ntypedef DirectInt = i32;\nfn check_reordered(value: Reordered) -> Expected { value }\nfn check_repeated(value: Repeated) -> ExpectedRepeated { value }\nfn check_array(value: Array) -> DirectArray { value }\nfn check_dependent(value: Dependent) -> DirectDependent { value }\nfn check_unused(value: Unused) -> DirectInt { value }\nfn main() {}\n";
    let types = TypeSpace.new();
    defer types.drop();
    let fixture = analyze_success(source, "/tmp/yian-native-alias-binders.an", &types);
    assert symbol_type(&fixture, "Reordered") == symbol_type(&fixture, "Expected"):
    "generic alias binders apply in the declaration's order";
    assert symbol_type(&fixture, "Repeated") == symbol_type(&fixture, "ExpectedRepeated"):
    "repeated generic binders preserve structural identity";
    assert symbol_type(&fixture, "Array") == symbol_type(&fixture, "DirectArray"):
    "dependent array sizes preserve identity";
    fixture.drop();
}

fn registered_definition_count(source: str, path: str, types: TypeSpace&) -> u64 {
    let names = NameInterner.new();
    defer names.drop();
    let units = parse_units(source, path, &names);
    defer units.drop();
    let symbols = SymbolSpace.new();
    defer symbols.drop();
    let hir = HirStore.new();
    defer hir.drop();
    let source_trust = trust();
    defer source_trust.drop();
    let permissions = Vec<SourcePermissions>.new();
    defer permissions.drop();
    let unit = UnitId(0u64);
    let canonical = units.file(unit).path();
    let stdlib = source_trust.is_stdlib(canonical);
    let restricted = source_trust.allows_restricted(canonical);
    permissions.push(SourcePermissions(stdlib, restricted, stdlib));
    let definitions = DefinitionRegistry.new();
    defer definitions.drop();
    let worklist = DefinitionWorklist.new();
    defer worklist.drop();
    let impls = ImplRegistry.new();
    defer impls.drop();
    let context = match ResolutionContext.new(&units, Option<PackageMap&>.None, &names, types,
        &symbols, &hir, source_trust.stdlib_root(), &permissions, &definitions, &worklist,
        &impls, IS_RAW_MODE, Option<TypeSizeProvider&>.None, Option<DiagnosticReporter&>.None) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not create direct alias analysis context"); },
    };
    defer context.drop();
    let options = AnalysisOptions.new();
    collect_declarations(&context).unwrap();
    resolve_definitions(&context).unwrap();
    match check_procedures(&context, &options) {
        Ok(output) => output.drop(),
        Err(error) => { error.drop(); @panic("could not check the alias calls"); },
    }
    definitions.len()
}

fn explicit_and_inferred_alias_calls_analyze() {
    let source = "typedef Int = i32;\nstruct Box<T> { value: T }\ntypedef AliasBox<T> = Box<T>;\nfn identity<T>(value: T) -> T { value }\nfn main() {\n    identity<AliasBox<Int>>(AliasBox<Int>(1));\n    identity<Box<i32>>(Box<i32>(2));\n    identity(AliasBox<i32>(3));\n}\n";
    let types = TypeSpace.new();
    defer types.drop();
    let registered = registered_definition_count(source, "/tmp/yian-native-alias-instances.an", &types);
    assert registered == 3u64:
    "two source procedures and one interned identity<i32> instance are registered";
}

fn check_alias_failure(source: str, message: str, code: str) {
    let types = TypeSpace.new();
    defer types.drop();
    let error = analyze_failure(source, "/tmp/yian-native-alias-cycle.an", &types);
    assert error.message.as_str().contains(message):
    "unused alias cycles and undefined alias bodies retain their diagnostic";
    assert error.code.text() == code: "alias diagnostic keeps its code";
    error.drop();
}

fn alias_cycles_and_recursive_nominal_fields_keep_their_boundaries() {
    check_alias_failure("typedef A = A;\nfn main() {}\n", "A -> A", "E407");
    check_alias_failure("typedef A = B*; typedef B = A[];\nfn main() {}\n", "A -> B -> A", "E407");
    check_alias_failure("typedef A<T> = A<T*>;\nfn main() {}\n", "A -> A", "E407");
    check_alias_failure("typedef A = Missing;\nfn main() {}\n", "Undefined type: Missing", "E302");

    let source = "typedef Node = Link;\nstruct Link { next: Node* }\nfn main() { let node: Node; }\n";
    let types = TypeSpace.new();
    defer types.drop();
    let fixture = analyze_success(source, "/tmp/yian-native-alias-recursive-field.an", &types);
    let node = symbol_type(&fixture, "Node");
    let fields = struct_fields(&types, node).unwrap();
    defer fields.drop();
    assert fields.len() == 1u64 && fields[0u64].type_id == types.pointer(node):
    "a nominal boundary permits recursive pointer fields with the exact Node pointer identity";
    fixture.drop();
}

fn check_alias_argument_failure(declaration: str, use: str, message: str, code: str) {
    let source = String.from(&declaration);
    source.push_str("\nfn main() { let value: ");
    source.push_str(use);
    source.push_str("; }\n");
    let types = TypeSpace.new();
    defer types.drop();
    let error = analyze_failure(source.as_str(), "/tmp/yian-native-alias-argument.an", &types);
    assert error.code.text() == code: "alias argument diagnostic keeps its code";
    assert error.message.as_str().contains(message):
    "alias argument diagnostic keeps its reason";
    match &error.location {
        Source(location) => {
            let span = location.span;
            assert span.start.row == 1u64 && span.start.column == 23u64:
            "alias argument diagnostic points at the use";
        },
        _ => @panic("alias argument diagnostic lost its source location"),
    }
    error.drop();
    source.drop();
}

fn alias_argument_diagnostics_point_to_the_use() {
    check_alias_argument_failure("typedef A<T> = T;", "A<i32, u64>", "expects 1 generic arguments", "E405");
    check_alias_argument_failure("typedef A<T> = T;", "A<4>", "requires a type argument", "E499");
    check_alias_argument_failure("typedef A<const N: u64> = i32[N];", "A<i32>", "requires a constant argument", "E499");
    check_alias_argument_failure("typedef A<const N: u64> = i32[N];", "A<4i32>", "incompatible type", "E499");
}

fn main() {
    nested_aliases_share_structural_identity();
    alias_binders_resolve_in_declaration_order();
    explicit_and_inferred_alias_calls_analyze();
    alias_cycles_and_recursive_nominal_fields_keep_their_boundaries();
    alias_argument_diagnostics_point_to_the_use();
}
