from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.lex.token import drop_tokens;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.parse.items import parse_program;
from yianc.frontend.ast.arena import AstTree;
from yianc.frontend.ast.node import Expr;
from yianc.frontend.ast.traversal import AstVisitor, walk_program;
from yianc.frontend.desugar import desugar;
from std.core.drop import Drop;
from std.core.ops import Index;

fn parsed(source: str) -> AstTree {
    let tokens = *Lexer.new(source).run().unwrap(); defer drop_tokens(&tokens);
    let parser = Parser.new(&tokens); defer parser.drop();
    *parse_program(&parser).unwrap()
}
struct Counter { tries: u64 }
impl AstVisitor for Counter {
    pub fn enter_expr(node: Expr&) -> bool {
        match &node.data { TryExpr(_) => { self.tries += 1; }, _ => {} }
        true
    }
}
fn allowed(source: str, expected: u64) {
    let tree = parsed(source); defer tree.drop();
    let before = Counter(0u64); walk_program(tree.root, &before);
    assert before.tries == expected: "context syntax present";
    desugar(&tree, "context.an").unwrap();
    let after = Counter(0u64); walk_program(tree.root, &after);
    assert after.tries == 0: "callable propagation lowered";
}
fn rejected(source: str) {
    let tree = parsed(source); defer tree.drop();
    let allocated = tree.arena.len();
    let items = tree.root.data.items.len();
    let before = Counter(0u64); walk_program(tree.root, &before);
    match desugar(&tree, "context.an") {
        Err(problem) => {
            defer problem.drop();
            assert problem.message().contains("only allowed inside"): "context error";
            assert problem.span().end.column > problem.span().start.column: "error source range";
        },
        Ok(_) => @panic("invalid context accepted"),
    }
    let after = Counter(0u64); walk_program(tree.root, &after);
    assert tree.arena.len() == allocated && tree.root.data.items.len() == items: "failure leaves arena and declarations";
    assert before.tries == after.tries: "failure leaves propagation syntax";
    match &tree.root.data.items[0].data { FuncDef(_, _, _, params, _, body) => {
        assert body.data.parameter_bindings.len() == 0: "validation precedes parameter normalization";
        match &params[0] { Pattern(_) => {}, _ => @panic("parameter modified on failure") }
    }, _ => {} }
}
fn main() {
    allowed("fn f() { let run = |captured = source()?| () { let nested = || () { nested()? }; body()?; }; outer()?; }", 4u64);
    allowed("struct S {} impl S { fn run() { source()?; } } trait T { fn run() { source()?; } }", 2u64);
    allowed("const C: fn() -> i32 = || () -> i32 { value? };", 1u64);
    allowed("const C: fn() -> i32 = |captured = || () { value? }| () { captured()? };", 2u64);
    rejected("const VALUE: i32 = source()?;");
    rejected("const C: fn() -> i32 = |captured = source()?| () { captured };");
    rejected("fn f((x,y): (i32,i32)) { value?; } const VALUE: i32 = source()?;");
}
