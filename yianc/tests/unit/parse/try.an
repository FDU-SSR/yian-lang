from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.lex.token import drop_tokens;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.parse.items import parse_program;
from yianc.frontend.ast.node import Expr;
from yianc.frontend.ast.operator import UnaryOperator, BinaryOperator;
from std.core.ops import Index;

fn inner(node: Expr&) -> Expr& {
    match &node.data { Semi(value) => *value, _ => @panic("statement") }
}
fn main() {
    let tokens = *Lexer.new("fn f() { x?; x??; -x?; (&x)?; f()?(); x?.field; x?[i]; }").run().unwrap();
    defer drop_tokens(&tokens);
    let parser = Parser.new(&tokens); defer parser.drop();
    let tree = *parse_program(&parser).unwrap(); defer tree.drop();
    let body = match &tree.root.data.items[0].data { FuncDef(_, _, _, _, _, body) => *body, _ => @panic("function") };
    let first = inner(body.data.stmts[0]);
    match &first.data { TryExpr(value) => {
        assert first.span.start.column == 9 && first.span.end.column == 11: "propagation span";
        match &value.data { Identifier(_) => {}, _ => @panic("operand") }
    }, _ => @panic("propagation") };
    match &inner(body.data.stmts[1]).data { TryExpr(value) => match &value.data {
        TryExpr(_) => {}, _ => @panic("nested propagation"),
    }, _ => @panic("outer propagation") };
    match &inner(body.data.stmts[2]).data { Unary(op, value) => {
        assert *op == UnaryOperator.Neg: "prefix negation";
        match &value.data { TryExpr(_) => {}, _ => @panic("postfix priority") }
    }, _ => @panic("negation") };
    match &inner(body.data.stmts[3]).data { TryExpr(value) => match &value.data {
        Unary(op, _) => { assert *op == UnaryOperator.AddrOf: "borrowed operand"; },
        _ => @panic("reference operand"),
    }, _ => @panic("borrowed propagation") };
    match &inner(body.data.stmts[4]).data { Call(callee, _) => match &callee.data {
        TryExpr(value) => match &value.data { Call(_, _) => {}, _ => @panic("producer call") },
        _ => @panic("propagated callable"),
    }, _ => @panic("call after propagation") };
    match &inner(body.data.stmts[5]).data { FieldAccess(receiver, _) => match &receiver.data {
        TryExpr(_) => {}, _ => @panic("propagated receiver"),
    }, _ => @panic("field after propagation") };
    match &inner(body.data.stmts[6]).data { Binary(op, value, _) => {
        assert *op == BinaryOperator.Index: "index after propagation";
        match &value.data { TryExpr(_) => {}, _ => @panic("propagated index receiver") }
    }, _ => @panic("index") }
}
