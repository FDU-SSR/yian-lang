from yianc.common.names import NameInterner;
from yianc.frontend.lex.lexer import Lexer;
from yianc.frontend.parse.state import Parser;
from yianc.frontend.parse.items import parse_program;
from std.core.ops import Index;

fn main() {
    let names = NameInterner.new();
    defer names.drop();
    let tokens = *Lexer.new("fn f() { (); }", &names).run().unwrap(); defer tokens.drop();
    let parser = Parser.new(&tokens, &names);
    let tree = *parse_program(&parser).unwrap(); defer tree.drop();
    assert parser.at_end(): "unit program consumed";
    match &tree.root.data.items[0].data {
        FuncDef(_, _, _, _, _, body) => match &body.data.stmts[0].data {
            Semi(value) => match &value.data {
                Tuple(elements) => { assert elements.len() == 0u64: "unit is an empty tuple"; },
                _ => @panic("unit tuple expression"),
            },
            _ => @panic("unit statement"),
        },
        _ => @panic("unit function"),
    }
}
