from yianc.analysis.constant.big_integer import BigInteger;
from yianc.frontend.ast.operator import BinaryOperator;

fn main() {
    let maximum = BigInteger.from_magnitude(0xFFFFFFFFFFFFFFFFu64, false);
    defer maximum.drop();
    let one = BigInteger.from_magnitude(1u64, false);
    defer one.drop();
    let extended = maximum.add(&one);
    defer extended.drop();
    assert extended.small_magnitude().is_none(): "addition carries into the third digit";

    let recovered = extended.subtract(&maximum);
    defer recovered.drop();
    assert recovered.compare(&one) == 0: "subtraction borrows across zero digits";

    let large = *one.shift_left(80u64).unwrap();
    defer large.drop();
    let minus = large.negated();
    defer minus.drop();
    let back = minus.shift_right(80u64);
    defer back.drop();
    let back_magnitude = back.small_magnitude();
    assert back.is_negative() && *back_magnitude.unwrap() == 1: "negative right shift";

    let inverted = large.inverted();
    defer inverted.drop();
    let intersected = inverted.bitwise(BinaryOperator.BitAnd, &large);
    defer intersected.drop();
    assert intersected.is_zero(): "infinite sign extension";

    let three = BigInteger.from_magnitude(3u64, false);
    defer three.drop();
    let division = *large.divide(&three).unwrap();
    defer division[0].drop();
    defer division[1].drop();
    let product = division[0].multiply(&three);
    defer product.drop();
    let recombined = product.add(&division[1]);
    defer recombined.drop();
    assert recombined.compare(&large) == 0: "division reconstructs the dividend";
}
