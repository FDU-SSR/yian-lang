from std.core.fs import resolve;
// CFG contract probe for the enum place operations.
//
// The probe builds a valid graph with EnumInitAt, EnumTagAt, EnumFieldAt and
// EnumCopyAt, then rejects malformed graphs before LLVM lowering.

from yianc.analysis.session.output import AnalysisOptions, AnalysisOutput;
from yianc.frontend.driver import FrontendDriver;
from yianc.frontend.unit import UnitTable;
from yianc.telemetry.trace import CompilerTrace;
from yianc.analysis.driver import MiddleEndDriver;
from yianc.types.space import TypeSpace;
from yianc.common.names import NameInterner;
from yianc.analysis.symbol.scope import SymbolSpace;
from yianc.analysis.hir.store import HirStore;
from yianc.types.model import AccessMode, AggregateDefinition, DefinitionBody, DefinitionHeader, EnumDefinition, EnumVariant, NominalKind, StructField, TypeData;
from yianc.codegen.cfg.ids import BlockId, FunctionId, ValueId;
from yianc.codegen.cfg.model import CfgFunction, CfgModule, Operation, SafetyCheck, Terminator, ValueKind;
from yianc.codegen.cfg.passes.checks import insert_checks;
from yianc.codegen.cfg.verify import verify_cfg;
from yianc.codegen.error import CodegenError;
from yianc.codegen.types import BackendTypes;
from yianc.common.ids import DefId, NameId, TypeId, UnitId;
from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import DiagnosticReporter, UserDiagnostic;
from yianc.frontend.source import SourceFile, Position, SourceTable, Span;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from llvm.object import Module;
from std.collections.hash_map import HashMap;
from std.core.env import args;
from std.core.process import Command, ExitStatus;

struct Fixture {
    packet: TypeId,
    payload: TypeId,
    integer: TypeId,
    long: TypeId,
    tag: TypeId,
    nothing: TypeId,
}

fn trust() -> SourceTrust {
    match SourceTrust.new("../../../../lib/src") {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not create source trust"); },
    }
}

fn load_source(path: str, text: str, names: NameInterner&) -> SourceTable {
    let canonical = match resolve(path) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source path resolution failed"); },
    };
    let files = Vec<SourceFile>.new();
    files.push(SourceFile.new(canonical, String.from(&text), names));
    match SourceTable.from_files(files) {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("fixture source load failed"); },
    }
}

fn definition(types: TypeSpace&, names: NameInterner&, name_text: str, kind: NominalKind, location: SourceSpan, generics: Vec<TypeId>) -> DefId {
    let name = names.intern(name_text);
    types.register(DefinitionHeader(kind, name, location, UnitId(0u64)), generics)
}

fn field(names: NameInterner&, name_text: str, type_id: TypeId, index: u64, location: SourceSpan) -> StructField {
    StructField(names.intern(name_text), type_id, AccessMode.Private, index, Option<SourceSpan>.Some(location))
}

struct IgnoreDiagnostics {}
impl DiagnosticReporter for IgnoreDiagnostics { pub fn report(diagnostic: UserDiagnostic&) {} }

// The malformed graph must stop at its invariant check rather than return a value.
fn reject(result: Result<(), CodegenError>, label: str) {
    match result {
        Ok(_) => @panic(label),
        Err(error) => { error.drop(); @panic(label); },
    }
}

// Builds a tagged enum with one unit variant and one two-field payload variant.
fn build_types(types: TypeSpace&, names: NameInterner&, location: SourceSpan) -> Fixture {
    let nothing = *types.primitive(TypeData.Void).unwrap();
    let integer = *types.primitive(TypeData.Integer(32u32, true)).unwrap();
    let long = *types.primitive(TypeData.Integer(64u32, true)).unwrap();
    let tag = *types.primitive(TypeData.Integer(32u32, false)).unwrap();

    let empty = Vec<TypeId>.new();
    defer empty.drop();

    let payload_definition = definition(types, names, "Data", NominalKind.Struct, location, Vec<TypeId>.new());
    let payload = *types.instance(payload_definition, &empty).unwrap();
    let members = Vec<StructField>.new();
    members.push(field(names, "number", integer, 0u64, location));
    members.push(field(names, "count", long, 1u64, location));
    types.finish_definition(payload_definition,
        DefinitionBody.Struct(AggregateDefinition(members, HashMap<NameId, TypeId>.new()))).unwrap();

    let packet_definition = definition(types, names, "Packet", NominalKind.Enum, location, Vec<TypeId>.new());
    let packet = *types.instance(packet_definition, &empty).unwrap();
    let variants = Vec<EnumVariant>.new();
    variants.push(EnumVariant(names.intern("Empty"), Option<TypeId>.None, 0u64, Option<SourceSpan>.Some(location)));
    variants.push(EnumVariant(names.intern("Data"), Option<TypeId>.Some(payload), 1u64, Option<SourceSpan>.Some(location)));
    types.finish_definition(packet_definition,
        DefinitionBody.Enum(EnumDefinition(variants, HashMap<NameId, TypeId>.new()))).unwrap();

    Fixture(packet, payload, integer, long, tag, nothing)
}

fn append(entry: BlockId, function: CfgFunction&, location: SourceSpan, type_id: Option<TypeId>, operation: Operation) -> ValueId {
    match function.append(entry, location, type_id, operation) {
        Ok(value) => *value.unwrap(),
        Err(error) => { error.drop(); @panic("the probe graph rejected a well-formed operation"); },
    }
}

fn effect(entry: BlockId, function: CfgFunction&, location: SourceSpan, operation: Operation) {
    match function.append(entry, location, Option<TypeId>.None, operation) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the probe graph rejected a well-formed effect"); },
    }
}

// A skeleton with a packet place, an integer place, and a terminated entry block.
struct Skeleton {
    module: Module*,
    types: BackendTypes,
    function: CfgFunction,
    cfg: CfgModule,
    entry: BlockId,
    packet_address: ValueId,
    integer_address: ValueId,
}

fn skeleton(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) -> Skeleton {
    let module = dyn Module.new("enum-storage-probe", 0u8);
    // The probe checks the generic access obligations, which raw mode attaches per access.
    let backend_types = BackendTypes.new(types, &*module, true);
    let function = CfgFunction.new(fixture.packet, fixture.nothing, Vec<TypeId>.new());
    let cfg = CfgModule.new(types, Option<TypeId>.None);
    let entry = function.add_block();
    let packet_reference = types.reference(fixture.packet);
    let packet_address = append(entry, &function, location, Option<TypeId>.Some(packet_reference),
        Operation.Address(function.add_local(fixture.packet)));
    let integer_reference = types.reference(fixture.integer);
    let integer_address = append(entry, &function, location, Option<TypeId>.Some(integer_reference),
        Operation.Address(function.add_local(fixture.integer)));
    Skeleton(module, backend_types, function, cfg, entry, packet_address, integer_address)
}

fn release(skeleton: Skeleton&) {
    skeleton.cfg.drop();
    skeleton.types.drop();
    skeleton.module.close();
    del skeleton.module;
}

// Verifies the seeded graph and returns the rejection result.
fn finish(skeleton: Skeleton&) -> Result<(), CodegenError> {
    match skeleton.function.terminate(skeleton.entry, Terminator.Unreachable) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the probe graph could not terminate its entry block"); },
    }
    match skeleton.cfg.add(skeleton.function) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the probe graph could not register its function"); },
    }
    verify_cfg(&skeleton.cfg, &skeleton.types)
}

fn check_valid(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    let number = values.function.add_value(fixture.integer, ValueKind.Integer(7u64));
    let count = values.function.add_value(fixture.long, ValueKind.Integer(9u64));
    let fields = Vec<ValueId>.new();
    fields.push(number);
    fields.push(count);
    effect(values.entry, &values.function, location,
        Operation.EnumInitAt(values.packet_address, fixture.packet, 1u64, fields));
    append(values.entry, &values.function, location, Option<TypeId>.Some(fixture.tag),
        Operation.EnumTagAt(values.packet_address, fixture.packet));
    append(values.entry, &values.function, location, Option<TypeId>.Some(fixture.integer),
        Operation.EnumFieldAt(values.packet_address, fixture.packet, 1u64, 0u64));
    let origin = append(values.entry, &values.function, location,
        Option<TypeId>.Some(types.reference(fixture.packet)),
        Operation.Address(values.function.add_local(fixture.packet)));
    effect(values.entry, &values.function, location,
        Operation.EnumCopyAt(values.packet_address, origin, fixture.packet));
    match values.function.terminate(values.entry, Terminator.Return(Option<ValueId>.None)) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the valid graph could not return from its entry block"); },
    }
    match values.cfg.add(values.function) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the valid graph could not register its function"); },
    }
    // Structural and SSA contract holds before any safety checks are attached.
    match verify_cfg(&values.cfg, &values.types) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the valid enum place graph was rejected"); },
    }
    match insert_checks(&values.cfg, &values.types) {
        Ok(_) => {},
        Err(error) => { error.drop(); @panic("the valid graph rejected check insertion"); },
    }

    let function = *values.cfg.function(FunctionId(0u64)).unwrap();
    let initialized = 0u64;
    let tagged = 0u64;
    let fielded = 0u64;
    let copied = 0u64;
    let copy_accesses = 0u64;
    for index in 0u64..function.block_count() {
        for instruction in function.block(BlockId(index)).unwrap().instructions {
            match &instruction.operation {
                EnumInitAt(_, _, _, operands) => {
                    initialized = instruction.checks.len();
                    assert instruction.result.is_none(): "enum place initialization is an effect";
                    let listed = instruction.operation.operands();
                    defer listed.drop();
                    assert listed.len() == operands.len() + 1u64: "the destination and every field are operands";
                    assert count_of(&instruction.checks, "access") == 1u64: "the destination receives an access check";
                },
                EnumTagAt(_, _) => {
                    tagged = instruction.checks.len();
                    let listed = instruction.operation.operands();
                    defer listed.drop();
                    assert listed.len() == 1u64: "the tag read has its address as its only operand";
                },
                EnumFieldAt(_, _, _, _) => {
                    fielded = instruction.checks.len();
                    let listed = instruction.operation.operands();
                    defer listed.drop();
                    assert listed.len() == 1u64: "the field read has its address as its only operand";
                },
                EnumCopyAt(_, _, _) => {
                    copied = instruction.checks.len();
                    copy_accesses = count_of(&instruction.checks, "access");
                    assert instruction.result.is_none(): "enum place copy is an effect";
                    let listed = instruction.operation.operands();
                    defer listed.drop();
                    assert listed.len() == 2u64: "both copy addresses are operands";
                },
                _ => {},
            }
        }
    }
    assert initialized == 1u64: "the initializer carries one access check";
    assert tagged == 1u64: "the tag read carries one access check";
    assert fielded == 1u64: "the field read carries one access check";
    assert copied == 2u64: "both copy addresses carry access checks";
    assert copy_accesses == 2u64: "copy checks are access checks";
}

fn count_of(checks: Vec<SafetyCheck>&, name: str) -> u64 {
    let total = 0u64;
    for check in *checks { if check.name() == name { total += 1u64; } }
    total
}

fn check_wrong_pointee(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    let number = values.function.add_value(fixture.integer, ValueKind.Integer(7u64));
    let count = values.function.add_value(fixture.long, ValueKind.Integer(9u64));
    let fields = Vec<ValueId>.new();
    fields.push(number);
    fields.push(count);
    effect(values.entry, &values.function, location,
        Operation.EnumInitAt(values.integer_address, fixture.packet, 1u64, fields));
    reject(finish(&values), "a non-enum destination is rejected");
}

fn check_invalid_variant(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    effect(values.entry, &values.function, location,
        Operation.EnumInitAt(values.packet_address, fixture.packet, 7u64, Vec<ValueId>.new()));
    reject(finish(&values), "an unknown discriminant is rejected");
}

fn check_invalid_field_type(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    let number = values.function.add_value(fixture.integer, ValueKind.Integer(7u64));
    let count = values.function.add_value(fixture.long, ValueKind.Integer(9u64));
    let fields = Vec<ValueId>.new();
    fields.push(count);
    fields.push(number);
    effect(values.entry, &values.function, location,
        Operation.EnumInitAt(values.packet_address, fixture.packet, 1u64, fields));
    reject(finish(&values), "a swapped payload field is rejected");
}

fn check_unit_fields(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    let fields = Vec<ValueId>.new();
    fields.push(values.function.add_value(fixture.integer, ValueKind.Integer(7u64)));
    effect(values.entry, &values.function, location,
        Operation.EnumInitAt(values.packet_address, fixture.packet, 0u64, fields));
    reject(finish(&values), "payload fields on a unit variant are rejected");
}

fn check_field_on_unit(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    append(values.entry, &values.function, location, Option<TypeId>.Some(fixture.integer),
        Operation.EnumFieldAt(values.packet_address, fixture.packet, 0u64, 0u64));
    reject(finish(&values), "a field read on a unit variant is rejected");
}

fn check_tag_type(types: TypeSpace&, fixture: Fixture&, location: SourceSpan) {
    let values = skeleton(types, fixture, location);
    defer release(&values);
    append(values.entry, &values.function, location, Option<TypeId>.Some(fixture.integer),
        Operation.EnumTagAt(values.packet_address, fixture.packet));
    reject(finish(&values), "a signed tag result is rejected");
}

// The probe document supplies source metadata; the hand-built CFG is the tested graph.
fn probe_units(names: NameInterner&) -> UnitTable {
    let trace = CompilerTrace.disabled();
    defer trace.drop();
    let frontend = FrontendDriver.new(load_source("/tmp/enum-storage-probe.an", "fn main() {}\n", names), false, &trace, names);
    defer frontend.drop();
    let units = match frontend.run() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("enum storage probe preparation failed"); },
    };
    units
}

fn analyze_probe(units: UnitTable&, types: TypeSpace&, names: NameInterner&,
    symbols: SymbolSpace&, hir: HirStore&, reporter: DiagnosticReporter&) -> AnalysisOutput {
    let driver = MiddleEndDriver.new(units, Option<PackageMap&>.None, names, types, symbols,
        hir, trust(), false, AnalysisOptions.new(), reporter);
    let analysis = driver.run();
    driver.drop();
    match analysis {
        Ok(output) => output,
        Err(error) => { error.drop(); @panic("enum storage probe analysis failed"); },
    }
}

// One malformed graph per process; the invariant panic terminates the child.
fn run_negative(index: u64) {
    let types = TypeSpace.new();
    defer types.drop();
    let names = NameInterner.new();
    defer names.drop();
    let symbols = SymbolSpace.new();
    defer symbols.drop();
    let hir = HirStore.new();
    defer hir.drop();
    let units = probe_units(&names);
    defer units.drop();
    let reporter = IgnoreDiagnostics();
    let output = analyze_probe(&units, &types, &names, &symbols, &hir, &reporter);
    defer output.drop();
    let location = SourceSpan(UnitId(0u64), Span(Position(0u64, 0u64), Position(0u64, 0u64)));
    let fixture = build_types(&types, &names, location);
    match index {
        0u64 => check_wrong_pointee(&types, &fixture, location),
        1u64 => check_invalid_variant(&types, &fixture, location),
        2u64 => check_invalid_field_type(&types, &fixture, location),
        3u64 => check_unit_fields(&types, &fixture, location),
        4u64 => check_field_on_unit(&types, &fixture, location),
        _ => check_tag_type(&types, &fixture, location),
    }
}

// Run one selectable negative branch in a child process so the invariant panic
// stays outside this process while its raw stderr and status are asserted.
fn assert_child_panic(flag: str, expected: str) {
    let arguments = args();
    let program = String.from(&arguments[0].as_str());
    defer program.drop();
    let command = Command.new(program.as_str());
    defer command.drop();
    command.arg(flag);
    let output = match command.output() {
        Ok(value) => value,
        Err(error) => { error.drop(); @panic("could not start the isolation child"); },
    };
    defer output.drop();
    match output.status {
        ExitStatus.Exited(code) => assert code == 1i32: "an internal invariant exits with status 1",
        ExitStatus.Signaled(_) => @panic("an internal invariant was reported as a signal"),
    };
    let text = match str.from_slice(output.stderr.as_slice()) {
        Some(value) => value,
        None => @panic("isolation child stderr is not UTF-8"),
    };
    assert text.contains("yian: panic: "): "an internal invariant reports the panic prefix";
    assert text.contains(expected): "an internal invariant reports its reason";
    for argument in arguments { argument.drop(); }
    arguments.drop();
}

fn main() {
    let arguments = args();
    if arguments.len() > 1u64 {
        let flag = arguments[1].as_str();
        if flag == "--wrong-pointee" { run_negative(0u64); return; }
        if flag == "--invalid-variant" { run_negative(1u64); return; }
        if flag == "--invalid-field-type" { run_negative(2u64); return; }
        if flag == "--unit-fields" { run_negative(3u64); return; }
        if flag == "--field-on-unit" { run_negative(4u64); return; }
        if flag == "--tag-type" { run_negative(5u64); return; }
    }
    for argument in arguments { argument.drop(); }
    arguments.drop();

    let types = TypeSpace.new();
    defer types.drop();
    let names = NameInterner.new();
    defer names.drop();
    let symbols = SymbolSpace.new();
    defer symbols.drop();
    let hir = HirStore.new();
    defer hir.drop();
    let units = probe_units(&names);
    defer units.drop();
    let reporter = IgnoreDiagnostics();
    let output = analyze_probe(&units, &types, &names, &symbols, &hir, &reporter);
    defer output.drop();

    let location = SourceSpan(UnitId(0u64), Span(Position(0u64, 0u64), Position(0u64, 0u64)));
    let fixture = build_types(&types, &names, location);
    check_valid(&types, &fixture, location);

    assert_child_panic("--wrong-pointee", "CFG operand type is inconsistent");
    assert_child_panic("--invalid-variant", "CFG enum place operation has an invalid discriminant");
    assert_child_panic("--invalid-field-type", "CFG operand type is inconsistent");
    assert_child_panic("--unit-fields", "CFG unit variant initializer has fields");
    assert_child_panic("--field-on-unit", "CFG enum field read has no payload");
    assert_child_panic("--tag-type", "CFG enum tag place type is invalid");
}
