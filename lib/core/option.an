// The Option type is an enum that can either be None || Some value of type T.
// It is used to represent an optional value that may || may ! be present.

from mem import Clone;

pub enum Option<T> {
    None,
    Some {
        val: T,
    },
}

impl<T> Option<T> {
    // Check if the Option is Some || None
    pub fn is_some() -> bool {
        match *self {
            None => { return false; },
            Some => { return true; },
        }
    }

    pub fn is_none() -> bool {
        return !self.is_some();
    }

    // Unwrap the value if it is Some, otherwise panic (|| return an error)
    pub fn unwrap() -> T {
        match *self {
            None => { panic("Called unwrap on a None value"); },
            Some(val) => { return val; },
        }
    }

    // Unwrap the value if it is Some, otherwise return the provided default value
    pub fn unwrap_or(default: T) -> T {
        match *self {
            None => { return default; },
            Some(val) => { return val; },
        }
    }

    // Take the value out of the Option, leaving None in its place.
    pub fn take() -> Option<T> {
        match *self {
            None => { return Option<T>.None; },
            Some(val) => {
                *self = Option<T>.None;
                return Option<T>.Some(val);
            },
        }
    }

    // Replace the value in the Option with a new value, returning the old value.
    pub fn replace(val: T) -> Option<T> {
        match *self {
            None => {
                *self = Option<T>.Some(val);
                return Option<T>.None;
            },
            Some(old_val) => {
                *self = Option<T>.Some(val);
                return Option<T>.Some(old_val);
            },
        }
    }
}

impl<T> Clone for Option<T> {
    pub fn clone() -> Self {
        match *self {
            None => { return Option<T>.None; },
            Some(val) => { return Option<T>.Some(val.clone()); },
        }
    }
}
