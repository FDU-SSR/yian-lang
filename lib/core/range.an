from std.core.clone import Clone;
from std.core.ops import PartialEq;
from std.core.option import Option;
from std.core.iter import Iterator, IntoIterator;

pub struct Range<T> {
    pub start: T,
    pub end: T,
}

impl<T> Clone for Range<T> {
    fn clone() -> Self {
        Self(
            start = self.start.clone(),
            end = self.end.clone()
        )
    }
}

impl<T> PartialEq<Range<T>> for Range<T> {
    fn eq(other: Range<T>*) -> bool {
        self.start == other.start && self.end == other.end
    }
}

impl<T> Iterator<T> for Range<T> {
    fn next() -> Option<T> {
        if self.start < self.end {
            let value = self.start.clone();
            self.start += 1;
            Option<T>.Some(value)
        } else {
            Option<T>.None
        }
    }
}
