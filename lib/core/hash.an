from ops import min;

pub trait Hasher {
    fn finish() -> u64;
    fn write(bytes: u8[]);
}

pub trait BuildHasher<T> {
    fn build_hasher() -> T;
}

pub trait Hash<T> {
    fn hash(hasher: T);
}

pub struct Murmur3Hasher {
    state: u64,
    len: u64,
    tail: u8[8],
    // u8* tail
    tail_len: u64,
    seed: u64,
}

impl Murmur3Hasher {
    static pub fn with_seed(seed: u64) -> Self {
        Self res
        res.state = seed;
        res.len = 0;
        res.tail_len = 0;
        res.seed = seed;
        // leave tail uninitialized
        return res;
    }
    fn mix(k: u64) {
        let C1: u64 = 0x87c37b91114253d5;
        let C2: u64 = 0x4cf5ad432745937f;

        k *= C1
        k.rotate_left(31);
        k *= C2
        let tmp: u64 = self.state;
        tmp ^= k
        tmp.rotate_left(27);
        self.state = (tmp * 5) + 0x52dce729;
    }
}

impl Hasher for Murmur3Hasher {
    fn finish() -> u64 {
        let state: u64 = self.state;

        if self.tail_len > 0 {
            let k: u64 = 0;
            memcpy(&k, &self.tail, self.tail_len);
            state ^= k * 0x4cf5ad432745937f
        }

        state ^= self.len
        state ^= state >> 33
        state = state * 0xff51afd7ed558ccd;
        state ^= state >> 33
        state = state * 0xc4ceb9fe1a85ec53;
        state ^= state >> 33

        return state;
    }

    fn write(bytes: u8[]) {
        let total_len: u64 = bytes.len();
        if total_len == 0 {
            return;
        }
        self.len += total_len

        let offset: u64 = 0;
        let bytes_ptr: u8* = bytes.ptr();

        if self.tail_len > 0 {
            let need: u64 = 8 - self.tail_len;
            let take: u64 = min((total_len - offset), need);

            memcpy(&self.tail[self.tail_len], bytes_ptr + offset, take);

            self.tail_len += take
            offset += take

            if self.tail_len == 8 {
                u64 k
                memcpy(&k, &self.tail, 8);
                self.mix(k);
                self.tail_len = 0;
            }
        }

        let remaining_after_tail: u64 = total_len - offset;
        let full_blocks: u64 = remaining_after_tail / 8;

        if full_blocks > 0 {
            let block_ptr: u8* = bytes_ptr + offset;
            for i in 0..full_blocks {
                u64 k
                memcpy(&k, block_ptr, 8);
                self.mix(k);
                block_ptr += 8
            }
            offset += full_blocks * 8
        }

        let remaining: u64 = total_len - offset;
        if remaining > 0 {
            memcpy(&self.tail, bytes_ptr + offset, remaining);
            self.tail_len = remaining;
        }
    }
}

pub struct Murmur3BuildHasher {
    seed: u64,
}

impl Murmur3BuildHasher {
    static pub fn with_seed(seed: u64) -> Self {
        return Self(seed);
    }
}

impl BuildHasher<Murmur3Hasher> for Murmur3BuildHasher {
    fn build_hasher() -> Murmur3Hasher {
        return Murmur3Hasher.with_seed(self.seed);
    }
}