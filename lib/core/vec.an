from std.core.raw_vec import RawVec;

from std.core.ops import Index, PartialEq, Deref, Add;
from std.core.clone import Clone;
from std.core.option import Option;
from std.core.convert import From, Into;
from std.core.drop import Drop;
from std.core.range import Range;

from std.core.slice import from_raw_parts;

pub struct Vec<T> {
    raw_vec: RawVec<T>,
    len: u64,
}

impl<T> Vec<T> {
    // Create a new, empty Vec
    static pub fn new() -> Self {
        Self(
            raw_vec = RawVec<T>.new(),
            len = 0
        )
    }

    // Create a Vec with specified capacity
    static pub fn with_capacity(capacity: u64) -> Self {
        Self(
            raw_vec = RawVec<T>.with_capacity(capacity),
            len = 0
        )
    }

    // Get a slice reference to the elements
    pub fn as_slice() -> T[] {
        from_raw_parts(self.raw_vec.ptr(), self.len)
    }

    // Push an element to the end. The argument is copied by value.
    pub fn push(value: T) {
        let len = self.len;

        if len == self.raw_vec.capacity() {
            self.raw_vec.grow();
        }

        let end = self.raw_vec.ptr() + len;
        *end = value;
        self.len += 1
    }

    // Clone another Vec's elements to the end; the source remains unchanged.
    pub fn extend(other: Vec<T>) {
        // Clone before reserving so self-extension and aliased descriptors are safe.
        let copied = other.clone();
        self.reserve(copied.len);
        for i in 0..copied.len {
            self.push(copied.raw_vec.ptr()[i]);
        }
        // The copied elements now belong to self; release only the temporary buffer.
        copied.len = 0;
        copied.drop();
    }

    // Pop an element from the end, returning None if empty
    pub fn pop() -> Option<T> {
        if self.len == 0 {
            Option<T>.None
        } else {
            self.len -= 1
            let end = self.raw_vec.ptr() + self.len;
            Option<T>.Some(*end)
        }
    }

    // Insert an element at index, shifting elements to the right
    // Panics if index > len
    pub fn insert(index: u64, value: T) {
        let len = self.len;
        if index > len {
            panic("index out of bounds");
        }

        if len == self.raw_vec.capacity() {
            self.raw_vec.grow();
        }

        let buf = self.raw_vec.ptr();

        // Shift elements to the right
        let i = len;
        while i > index {
            buf[i] = buf[i - 1];
            i -= 1;
        }

        buf[index] = value;
        self.len += 1;
    }

    // Remove an element at index, shifting elements to the left, returning the removed element
    // Panics if index >= len
    pub fn remove(index: u64) -> T {
        let len = self.len;
        if index >= len {
            panic("index out of bounds");
        }

        let buf = self.raw_vec.ptr();

        let ret = buf[index]; // The element to remove;

        // Shift elements to the left
        let i = index;
        while i < len - 1 {
            buf[i] = buf[i + 1];
            i += 1;
        }

        self.len -= 1;
        ret
    }

    // Remove the element at index, replacing it with the element at end, returning the removed element
    // Panics if index >= len
    pub fn swap_remove(index: u64) -> T {
        let len = self.len;
        if index >= len {
            panic("index out of bounds");
        }

        let buf = self.raw_vec.ptr();
        let ret = buf[index]; // The element to remove;
        self.len -= 1;

        if index != self.len {
             // Copy the last element to the removed spot
            buf[index] = buf[self.len];
        }

        ret
    }

    // Extend the Vec with a slice
    // This will clone the elements from the slice into the Vec, since slices are semantically not owned
    pub fn extend_from_slice(slice: T[]) {
        // Clone first because reserve may invalidate a slice into this Vec.
        let copied = slice.to_vec();
        self.reserve(copied.len);
        for i in 0..copied.len {
            self.push(copied.raw_vec.ptr()[i]);
        }
        copied.len = 0;
        copied.drop();
    }

    // Shorten the Vec, keeping the first `len` elements
    pub fn truncate(len: u64) {
        if len > self.len {
            return;
        }

        // drop the elements that are being truncated
        let buf = self.raw_vec.ptr();
        for i in len..self.len {
            buf[i].drop();
        }

        self.len = len;
    }

    // Remove all elements
    pub fn clear() {
        self.truncate(0);
    }

    // Reserve capacity for at least `additional` more elements
    pub fn reserve(additional: u64) {
        self.raw_vec.reserve(self.len, additional);
    }

    // Shrinks the capacity as much as possible
    pub fn shrink_to_fit() {
        if self.len < self.raw_vec.capacity() {
            self.raw_vec.shrink_to_fit(self.len);
        }
    }

    // Check if the Vec is empty
    pub fn is_empty() -> bool {
        self.len == 0
    }

    // Get the capacity
    pub fn capacity() -> u64 {
        self.raw_vec.capacity()
    }
}

// Implement Clone for Vec<T>
// This will clone the elements in the Vec, so it requires T to be Clone
impl<T> Clone for Vec<T> {
    pub fn clone() -> Self {
        self.as_slice().to_vec()
    }
}

impl<T> Index<u64, T*> for Vec<T> {
    pub fn index(index: u64*) -> T* {
        if *index >= self.len {
            panic("index out of bounds");
        }
        self.raw_vec.ptr() + *index
    }
}

impl<T> PartialEq<Vec<T>> for Vec<T> {
    pub fn eq(rhs: Vec<T>*) -> bool {
        self.as_slice() == rhs.as_slice()
    }
}

// Implement From for Vec<T> to create a Vec from a slice
// This will clone the elements from the slice into the Vec
impl<T> From<T[]> for Vec<T> {
    pub static fn from(value: T[]*) -> Self {
        value.to_vec()
    }
}

// Implement Into for Vec<T> to convert a Vec into a slice
// This will return a slice reference to the elements in the Vec
impl<T> Into<Vec<T>> for T[] {
    pub fn into() -> Vec<T> {
        Vec<T>.from(*self)
    }
}

// Implement Deref for Vec<T> to allow dereferencing to a slice
impl<T> Deref<T[]> for Vec<T> {
    pub fn deref() -> T[] {
        self.as_slice()
    }
}

// Concatenation creates an independent Vec by cloning both inputs.
impl<T> Add<Vec<T>, Vec<T>> for Vec<T> {
    pub fn add(rhs: Vec<T>) -> Vec<T> {
        let res = Vec<T>.with_capacity(self.len() + rhs.len());
        res.extend(*self);
        res.extend(rhs);
        res
    }
}

// Implement Drop for Vec<T> to allow dropping a Vec, freeing its resources
impl<T> Drop for Vec<T> {
    pub fn drop() {
        // Drop only the currently valid elements, then release the buffer.
        self.clear();
        self.raw_vec.drop();
        self.len = 0;
    }
}
