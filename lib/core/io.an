from vec import Vec;
from string import String;

// =====================================================================
// File open flags (Linux x86_64)
// =====================================================================
// O_RDONLY   = 0
// O_WRONLY   = 1
// O_RDWR     = 2
// O_CREAT    = 64
// O_TRUNC    = 512
// O_APPEND   = 1024
// O_WRONLY | O_CREAT | O_TRUNC  = 577
// O_WRONLY | O_CREAT | O_APPEND = 1089

// =====================================================================
// Terminal I/O
// =====================================================================

// Print a string to stdout (fd 1).
pub fn print(s: str) {
    sys_write(1, s);
}

// Print a string to stderr (fd 2).
pub fn eprint(s: str) {
    sys_write(2, s);
}

// Read a line from stdin (fd 0), stopping at newline or EOF.
// The trailing newline is NOT included in the returned String.
// Returns a heap-allocated String since the input length is unknown.
pub fn readline() -> String {
    let result: String = String.new();
    loop {
        u8[1] ch
        ch[0] = 0
        let s: str = sys_read(0, ch);
        let data: u8[] = s.as_slice();
        let n: u64 = data.len();
        if n == 0 {
            break;
        }
        // '\n' == 10
        if ch[0] == 10 {
            break;
        }
        result.push_str(s);
    }
    return result;
}

// =====================================================================
// Open mode wrappers
// =====================================================================

// Open a file for reading only (O_RDONLY = 0).
pub fn open_rdonly(path: str) -> i32 {
    let fd: i32 = open(path, 0);
    return fd;
}

// Open a file for writing (creates or truncates).
// flags = O_WRONLY | O_CREAT | O_TRUNC = 577
pub fn open_wronly(path: str) -> i32 {
    let fd: i32 = open(path, 577);
    return fd;
}

// Open a file for appending (creates if not exists).
// flags = O_WRONLY | O_CREAT | O_APPEND = 1089
pub fn open_append(path: str) -> i32 {
    let fd: i32 = open(path, 1089);
    return fd;
}

// =====================================================================
// High-level file I/O
// =====================================================================

// Open a file and read its entire content, returning as str.
// The reading is done with a 32-byte probe buffer in a loop.
pub fn read_file(path: str) -> str {
    let fd: i32 = open(path, 0);
    let buf: Vec<u8> = Vec<u8>.new();
    loop {
        u8[32] probe
        for i in 0u64..32 {
            probe[i] = 0
        }
        let s: str = sys_read(fd, probe);
        let data: u8[] = s.as_slice();
        let n: u64 = data.len();
        if n == 0 {
            break;
        }
        buf.extend_from_slice(data);
    }
    close(fd);
    return str.from(buf.as_slice());
}

// Write a str to a file at the given path (creates or truncates).
pub fn write_file(path: str, content: str) {
    let fd: i32 = open(path, 577);
    sys_write(fd, content);
    close(fd);
}

// Append a str to a file at the given path (creates if not exists).
pub fn append_file(path: str, content: str) {
    let fd: i32 = open(path, 1089);
    sys_write(fd, content);
    close(fd);
}
