pub struct RawVec<T> {
    data: T*,
    cap: u64,
}

impl<T> RawVec<T> {
    static pub fn new() -> Self {
        return Self(
            data = bitcast<T*>(0u64),
            cap = 0
        )
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        if capacity == 0 {
            return Self.new();
        }
        // Allocate memory for capacity elements
        let data: T* = dyn T[capacity];
        return Self(
            data = data,
            cap = capacity
        )
    }

    pub fn ptr() -> T* {
        return self.data;
    }

    pub fn capacity() -> u64 {
        return self.cap;
    }

    pub fn grow() {
        let old_cap: u64 = self.cap;
        u64 new_cap
        if old_cap == 0 {
            new_cap = 4;
        } else {
            new_cap = old_cap * 2;
        }

        let new_data: T* = dyn T[new_cap];

        if old_cap > 0 {
            // Copy existing elements to the new buffer
            // Since we assume the vector is full when grow() is called
            for i in 0..old_cap {
                new_data[i] = self.data[i]
            }
            del self.data;
        }

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn reserve(len: u64, additional: u64) {
        let required_cap: u64 = len + additional;
        if self.cap >= required_cap {
            return;
        }

        let new_cap: u64 = self.cap * 2;
        if new_cap < required_cap {
            new_cap = required_cap;
        }
        // Ensure minimum capacity
        if new_cap < 4 {
            new_cap = 4;
        }

        let new_data: T* = dyn T[new_cap];
        
        // Copy valid elements
        if len > 0 {
            for i in 0..len {
                new_data[i] = self.data[i]
            }
        }
        
        if self.cap > 0 {
            del self.data;
        }
        
        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn shrink_to_fit(len: u64) {
        if self.cap <= len {
            return;
        }
        
        if len == 0 {
            if self.cap > 0 {
                del self.data;
            }
            self.data = bitcast<T*>(0u64);
            self.cap = 0;
            return;
        }

        let new_data: T* = dyn T[len];
        
        // Copy valid elements
        for i in 0..len {
            new_data[i] = self.data[i]
        }
        
        if self.cap > 0 {
            del self.data;
        }
        
        self.data = new_data;
        self.cap = len;
    }
}