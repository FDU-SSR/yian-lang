from std.core.range import Range;
from std.core.drop import Drop;
from std.core.mem import memmove;

pub struct RawVec<T> {
    data: T*,
    cap: u64,
}

impl<T> RawVec<T> {
    static pub fn new() -> Self {
        let data: T* = dyn[0] T;
        Self(
            data = data,
            cap = 0x8000_0000_0000_0000u64
        )
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        if capacity == 0 {
            return Self.new();
        }
        // Allocate memory for capacity elements
        let data: T* = dyn[capacity] T;
        Self(
            data = data,
            cap = capacity | 0x8000_0000_0000_0000u64
        )
    }

    pub fn ptr() -> T* {
        self.data
    }

    pub fn capacity() -> u64 {
        self.cap & 0x7FFF_FFFF_FFFF_FFFFu64
    }

    pub fn grow() {
        let live_bit: u64 = 0x8000_0000_0000_0000u64;
        let was_live = (self.cap & live_bit) != 0;
        let old_cap = self.cap & 0x7FFF_FFFF_FFFF_FFFFu64;
        let new_cap = if old_cap == 0 { 4 } else { old_cap * 2 }

        let new_data: T* = dyn[new_cap] T;

        if was_live && old_cap > 0 {
            // Copy existing elements to the new buffer
            // Since we assume the vector is full when grow() is called
            memmove(new_data, self.data, old_cap);
        }
        if was_live {
            del self.data;
        }

        self.data = new_data;
        self.cap = new_cap | live_bit;
    }

    pub fn reserve(len: u64, additional: u64) {
        let live_bit: u64 = 0x8000_0000_0000_0000u64;
        let was_live = (self.cap & live_bit) != 0;
        let required_cap = len + additional;
        let current_cap = self.cap & 0x7FFF_FFFF_FFFF_FFFFu64;
        if was_live && current_cap >= required_cap {
            return;
        }

        let new_cap = current_cap * 2;
        if new_cap < required_cap {
            new_cap = required_cap;
        }
        // Ensure minimum capacity
        if new_cap < 4 {
            new_cap = 4;
        }

        let new_data: T* = dyn[new_cap] T;

        // Copy valid elements
        if len > 0 {
            memmove(new_data, self.data, len);
        }

        if was_live {
            del self.data;
        }

        self.data = new_data;
        self.cap = new_cap | live_bit;
    }

    pub fn shrink_to_fit(len: u64) {
        let live_bit: u64 = 0x8000_0000_0000_0000u64;
        let was_live = (self.cap & live_bit) != 0;
        let current_cap = self.cap & 0x7FFF_FFFF_FFFF_FFFFu64;
        if current_cap <= len {
            return;
        }

        if len == 0 {
            let new_data: T* = dyn[0] T;
            if was_live {
                del self.data;
            }
            self.data = new_data;
            self.cap = live_bit;
            return;
        }

        let new_data: T* = dyn[len] T;

        // Copy valid elements
        memmove(new_data, self.data, len);

        if was_live {
            del self.data;
        }

        self.data = new_data;
        self.cap = len | live_bit;
    }
}

// Implement Drop for RawVec<T> to allow dropping the RawVec and freeing its resources
impl<T> Drop for RawVec<T> {
    fn drop() {
        let live_bit: u64 = 0x8000_0000_0000_0000u64;
        if (self.cap & live_bit) != 0 {
            del self.data;
        }
        self.cap = 0;
    }
}
