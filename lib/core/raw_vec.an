from std.core.range import Range;
from std.core.drop import Drop;
from std.core.mem import memmove;

pub struct RawVec<T> {
    data: T*,
    cap: u64,
}

impl<T> RawVec<T> {
    static pub fn new() -> Self {
        // 空容器持真实堆块(dyn[0] 分配 8B 锁头,带堆键的合法胖指针):
        // data/ptr 非零,heap_ok/live 全通过,与后续 niche None 的全零编码不碰撞。
        Self(dyn[0] T, 0)
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        if capacity == 0 {
            return Self.new();
        }
        // Allocate memory for capacity elements
        let data: T* = dyn[capacity] T;
        Self(
            data = data,
            cap = capacity
        )
    }

    pub fn ptr() -> T* {
        self.data
    }

    pub fn capacity() -> u64 {
        self.cap
    }

    pub fn grow() {
        let old_cap = self.cap;
        let new_cap = if old_cap == 0 { 4 } else { old_cap * 2 }

        let new_data: T* = dyn[new_cap] T;

        if old_cap > 0 {
            // Copy existing elements to the new buffer
            // Since we assume the vector is full when grow() is called
            memmove(new_data, self.data, old_cap);
        }
        // data 恒为真实堆块(new() 即 dyn[0] 分配),旧块一律释放
        del self.data;

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn reserve(len: u64, additional: u64) {
        let required_cap = len + additional;
        if self.cap >= required_cap {
            return;
        }

        let new_cap = self.cap * 2;
        if new_cap < required_cap {
            new_cap = required_cap;
        }
        // Ensure minimum capacity
        if new_cap < 4 {
            new_cap = 4;
        }

        let new_data: T* = dyn[new_cap] T;

        // Copy valid elements
        if len > 0 {
            memmove(new_data, self.data, len);
        }

        // data 恒为真实堆块,旧块一律释放
        del self.data;

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn shrink_to_fit(len: u64) {
        if self.cap <= len {
            return;
        }

        // 统一走重新分配:len==0 时 new_data 为 dyn[0] 块(真实堆块,非悬垂)。
        // 旧实现 shrink 到空后 del 旧块却不重置 data,随后 Drop 对已释放块
        // 再 del → live 检查 trap;新实现 data 恒指向存活块,空容器 del 不 trap。
        let new_data: T* = dyn[len] T;

        // Copy valid elements
        if len > 0 {
            memmove(new_data, self.data, len);
        }

        // data 恒为真实堆块,旧块一律释放
        del self.data;

        self.data = new_data;
        self.cap = len;
    }
}

// Implement Drop for RawVec<T> to allow dropping the RawVec and freeing its resources.
// double-free/double-drop 防护由胖指针锁槽承担: 第二次 del 触达 SENTINEL → trap。
impl<T> Drop for RawVec<T> {
    fn drop() {
        del self.data;
    }
}
