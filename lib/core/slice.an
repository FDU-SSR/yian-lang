from option import Option;
from vec import Vec;
from iter import Iterator, IntoIterator;
from ops import PartialEq, Index;
from range import Range;

// A struct representation of a slice
struct SliceStruct<T> {
    pub ptr: T*,
    pub len: u64,
}

impl<T> T[] {
    // Convert a slice to a SliceStruct
    fn as_struct() -> SliceStruct<T> {
        let ret: SliceStruct<T>* = bitcast<SliceStruct<T>*>(self);
        return *ret;
    }

    // Get the raw pointer to the slice data
    pub fn ptr() -> T* {
        return self.as_struct().ptr;
    }

    // Get length of the slice
    pub fn len() -> u64 {
        return self.as_struct().len;
    }

    // Get element at index
    pub fn get(index: u64) -> Option<T> {
        let len: u64 = self.len();
        if index >= len {
            return Option<T>.None;
        }
        let ptr: T* = self.as_struct().ptr + index;
        return Option<T>.Some(*ptr);
    }

    // Get first element of the slice
    pub fn first() -> Option<T> {
        return self.get(0);
    }

    // Get last element of the slice
    pub fn last() -> Option<T> {
        let len: u64 = self.len();
        if len == 0 {
            return Option<T>.None;
        }
        return self.get(len - 1);
    }

    // Clone the slice into a Vec
    pub fn to_vec() -> Vec<T> {
        let s: SliceStruct<T> = self.as_struct();
        let vec: Vec<T> = Vec<T>.with_capacity(s.len);
        for i in 0..s.len {
            vec.push(s.ptr[i]);
        }
        return vec;
    }
}

pub fn from_raw_parts<T>(ptr: T*, len: u64) -> T[] {
    let slice_struct: SliceStruct<T> = SliceStruct<T>(
        ptr = ptr,
        len = len
    )
    let ret: T[]* = bitcast<T[]*>(&slice_struct);
    return *ret;
}

pub struct SliceIter<T> {
    pub ptr: T*,
    pub end: T*,
}

impl<T> SliceIter<T> {
    pub fn len() -> u64 {
        return self.end - self.ptr;
    }

    pub fn rev() -> RevSliceIter<T>  {
        return RevSliceIter<T>(
            ptr = self.end,
            begin = self.ptr
        )
    }
}

pub struct RevSliceIter<T> {
    pub ptr: T*,
    pub begin: T*,
}

impl<T> RevSliceIter<T> {
    pub fn len() -> u64 {
        return self.ptr - self.begin
    }

    pub fn rev() -> SliceIter<T> {
        return SliceIter<T>(
            ptr = self.begin,
            end = self.ptr
        )
    }
}

impl<T> Iterator<T> for SliceIter<T> {
    fn next() -> Option<T> {
        if self.ptr == self.end {
            return Option<T>.None;
        }
        let current: T* = self.ptr;
        self.ptr += 1
        return Option<T>.Some(*current);
    }
}

impl<T> Iterator<T> for RevSliceIter<T> {
    pub fn next() -> Option<T> {
        if self.ptr == self.begin {
            return Option<T>.None
        }
        self.ptr -= 1
        return Option<T>.Some(*self.ptr)
    }
}

impl<T> IntoIterator<SliceIter<T>> for T[] {
    pub fn into_iter() -> SliceIter<T> {
        let s: SliceStruct<T> = self.as_struct();
        return SliceIter<T>(
            ptr = s.ptr,
            end = s.ptr + s.len
        )
    }
}

impl<T, const N: u64> IntoIterator<SliceIter<T>> for T[N] {
    pub fn into_iter() -> SliceIter<T> {
        return SliceIter<T>(
            ptr = bitcast<T*>(self),
            end = bitcast<T*>(self) + N
        )
    }
}

impl<T> PartialEq<T[]> for T[] {
    pub fn eq(other: T[]) -> bool {
        if self.len() != other.len() {
            return false;
        }
        for i in 0..self.len() {
            if self.get(i).unwrap() != other.get(i).unwrap() {
                return false;
            }
        }
        return true;
    }
}

impl<T> Index<u64, T*> for T[] {
    fn index(index: u64) -> T* {
        return self.ptr() + index;
    }
}

impl<T> Index<Range<u64>, T[]> for T[] {
    fn index(range: Range<u64>) -> T[] {
        if range.end > self.len() {
            panic("Range out of bounds");
        }
        let start_ptr: T* = self.ptr() + range.start;
        let len: u64 = range.end - range.start;
        return from_raw_parts(start_ptr, len);
    }
}