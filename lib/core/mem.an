from std.core.range import Range;

pub fn memcpy<T>(dest: T*, src: T*, count: u64) {
    for i in 0..count {
        dest[i] = src[i].clone();
    }
}

pub fn memmove<T>(dest: T*, src: T*, count: u64) {
    if dest <= src {
        for i in 0..count {
            dest[i] = src[i];
        }
        return;
    }

    let i = count;
    while i > 0 {
        i -= 1;
        dest[i] = src[i];
    }
}
