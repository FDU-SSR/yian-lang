from range import Range;

// A trait for types that can be cloned to create a duplicate of the value.
//
// The clone method should return a new instance of the type equivalent to the original.
pub trait Clone {
    fn clone() -> Self;
}

// Implement clone for all basic types
// Integer types
impl Clone for i8 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for i16 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for i32 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for i64 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for u8 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for u16 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for u32 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for u64 {
    pub fn clone() -> Self {
        *self
    }
}

// Floating-point types
impl Clone for f32 {
    pub fn clone() -> Self {
        *self
    }
}

impl Clone for f64 {
    pub fn clone() -> Self {
        *self
    }
}

// Boolean type
impl Clone for bool {
    pub fn clone() -> Self {
        *self
    }
}

// Character type
impl Clone for char {
    pub fn clone() -> Self {
        *self
    }
}

// Void type
impl Clone for void {
    pub fn clone() -> Self {
        *self
    }
}

pub fn memcpy<T>(dest: T*, src: T*, count: u64) {
    for i in 0..count {
        dest[i] = src[i];
    }
}