from std.core.ops import Index;
from std.core.range import Range;

impl<T> Index<u64, T*> for T* {
    fn index(index: u64*) -> T* {
        *self + *index
    }
}

impl<T> Index<Range<u64>, T[]> for T* {
    fn index(range: Range<u64>*) -> T[] {
        let start: T* = *self + (*range).start;
        let len: u64 = (*range).end - (*range).start;
        __slice_from_parts(start, len)
    }
}
