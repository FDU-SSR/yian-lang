from option import Option;

// The Iterator trait defines a common interface for iterating over a sequence of values of type T. 
pub trait Iterator<T> {
    fn next() -> Option<T>;
}

// The IntoIterator trait allows a type to be converted into an iterator of type Iter
// This will consume the value of the type
pub trait IntoIterator<T> {
    fn into_iter() -> T;
}

impl<T> IntoIterator<T> for T if T: Iterator<T> {
    fn into_iter() -> T {
        return *self;
    }
}
