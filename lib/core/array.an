from std.core.ops import Index;
from std.core.range import Range;
from std.core.vec import Vec;
from std.core.slice import SliceIter;
from std.core.iter import IntoIterator;

impl<T, const N: u64> T[N] {
    fn as_slice() -> T[] {
        let p: T* = bitcast<T*>(self);
        __slice_from_parts(p, N)
    }

    fn to_vec() -> Vec<T> {
        self.as_slice().to_vec()
    }

    fn ptr() -> T* {
        let p: T* = bitcast<T*>(self);
        p
    }
}

impl<T, const N: u64> Index<u64, T*> for T[N] {
    fn index(index: u64*) -> T* {
        if *index >= N {
            panic("Index out of bounds\n");
        }
        let p: T* = bitcast<T*>(self);
        p + *index
    }
}

impl<T, const N: u64> Index<Range<u64>, T[]> for T[N] {
    fn index(range: Range<u64>*) -> T[] {
        if (*range).end > N {
            panic("Index out of bounds\n");
        }
        let p: T* = bitcast<T*>(self);
        let start: T* = p + (*range).start;
        let len: u64 = (*range).end - (*range).start;
        __slice_from_parts(start, len)
    }
}

impl<T, const N: u64> IntoIterator<SliceIter<T>> for T[N] {
    pub fn into_iter() -> SliceIter<T> {
        let p: T* = bitcast<T*>(self);
        SliceIter<T>(
            ptr = p,
            n = N,
        )
    }
}