from ops import Index;
from range import Range;
from vec import Vec;
from slice import from_raw_parts, SliceIter;
from iter import IntoIterator;

impl<T, const N: u64> T[N] {
    fn as_slice() -> T[] {
        from_raw_parts(bitcast<T*>(self), N)
    }

    fn to_vec() -> Vec<T> {
        self.as_slice().to_vec()
    }

    fn ptr() -> T* {
        bitcast<T*>(self)
    }
}

impl<T, const N: u64> Index<u64, T*> for T[N] {
    fn index(index: u64*) -> T* {
        if *index >= N {
            panic("Index out of bounds\n");
        }
        bitcast<T*>(self) + *index
    }
}

impl<T, const N: u64> Index<Range<u64>, T[]> for T[N] {
    fn index(range: Range<u64>*) -> T[] {
        if (*range).end > N {
            panic("Index out of bounds\n");
        }
        let start: T* = bitcast<T*>(self) + (*range).start;
        let len: u64 = (*range).end - (*range).start;
        from_raw_parts(start, len)
    }
}

impl<T, const N: u64> IntoIterator<SliceIter<T>> for T[N] {
    pub fn into_iter() -> SliceIter<T> {
        SliceIter<T>(
            ptr = bitcast<T*>(self),
            end = bitcast<T*>(self) + N
        )
    }
}