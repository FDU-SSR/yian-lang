from string import String;

pub trait ToString {
    fn to_string() -> String;
}

fn append_unsigned_digits(out: String*, value: u64) {
    if value >= 10u64 {
        append_unsigned_digits(out, value / 10u64);
    }
    let digit = u8(value % 10u64);
    out.push(char(b'0' + digit));
}

fn unsigned_to_string(value: u64) -> String {
    let out = String.new();
    append_unsigned_digits(&out, value);
    out.move()
}

fn signed_to_string(value: i64) -> String {
    if value >= 0 {
        return unsigned_to_string(u64(value));
    }

    let out = String.new();
    out.push('-');

    let mag: u64 = u64(value);
    mag = 0u64 - mag;
    append_unsigned_digits(&out, mag);
    out.move()
}

fn float_to_string(value: f64) -> String {
    if value != value {
        return String.from(&"NaN");
    }

    if value == 0.0 {
        return String.from(&"0");
    }

    let out = String.new();
    if value < 0.0 {
        out.push('-');
        value = -value;
    }

    let int_part: u64 = u64(value);
    append_unsigned_digits(&out, int_part);

    let frac: f64 = value - f64(int_part);
    if frac == 0.0 {
        return out.move();
    }

    out.push('.');
    let count: u64 = 0;
    while count < 6u64 {
        frac *= 10.0
        let digit: u8 = u8(frac);
        out.push(char(b'0' + digit));
        frac -= f64(digit)
        count += 1
        if frac == 0.0 {
            break;
        }
    }

    out.move()
}

impl ToString for u8 {
    fn to_string() -> String {
        unsigned_to_string(u64(*self))
    }
}

impl ToString for u16 {
    fn to_string() -> String {
        unsigned_to_string(u64(*self))
    }
}

impl ToString for u32 {
    fn to_string() -> String {
        unsigned_to_string(u64(*self))
    }
}

impl ToString for u64 {
    fn to_string() -> String {
        unsigned_to_string(*self)
    }
}

impl ToString for i8 {
    fn to_string() -> String {
        signed_to_string(i64(*self))
    }
}

impl ToString for i16 {
    fn to_string() -> String {
        signed_to_string(i64(*self))
    }
}

impl ToString for i32 {
    fn to_string() -> String {
        signed_to_string(i64(*self))
    }
}

impl ToString for i64 {
    fn to_string() -> String {
        signed_to_string(*self)
    }
}

impl ToString for f32 {
    fn to_string() -> String {
        float_to_string(f64(*self))
    }
}

impl ToString for f64 {
    fn to_string() -> String {
        float_to_string(*self)
    }
}

impl ToString for bool {
    fn to_string() -> String {
        if *self { String.from(&"true") } else { String.from(&"false") }
    }
}

impl ToString for char {
    fn to_string() -> String {
        let out = String.new();
        out.push(*self);
        out.move()
    }
}

impl ToString for void {
    fn to_string() -> String {
        String.from(&"void")
    }
}
