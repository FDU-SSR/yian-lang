pub trait Add<Rhs, Output> {
    fn add(rhs: Rhs) -> Output;
}

pub trait Sub<Rhs, Output> {
    fn sub(rhs: Rhs) -> Output;
}

pub trait Mul<Rhs, Output> {
    fn mul(rhs: Rhs) -> Output;
}

pub trait Div<Rhs, Output> {
    fn div(rhs: Rhs) -> Output;
}

pub trait Rem<Rhs, Output> {
    fn rem(rhs: Rhs) -> Output;
}

pub trait Neg<Output> {
    fn neg() -> Output;
}

pub trait BitAnd<Rhs, Output> {
    fn bit_and(rhs: Rhs) -> Output;
}

pub trait BitOr<Rhs, Output> {
    fn bit_or(rhs: Rhs) -> Output;
}

pub trait BitXor<Rhs, Output> {
    fn bit_xor(rhs: Rhs) -> Output;
}

pub trait BitNot<Output> {
    fn bit_not() -> Output;
}

pub trait Shl<Rhs, Output> {
    fn shl(rhs: Rhs) -> Output;
}

pub trait Shr<Rhs, Output> {
    fn shr(rhs: Rhs) -> Output;
}

pub trait PartialEq<Rhs> {
    fn eq(rhs: Rhs) -> bool;
    fn ne(rhs: Rhs) -> bool {
        return ! self.eq(rhs);
    }
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

impl PartialEq<Ordering> for Ordering {
    fn eq(rhs: Ordering) -> bool {
        match *self {
            Less => { match rhs { Less => { return true } _ => { return false } } }
            Equal => { match rhs { Equal => { return true } _ => { return false } } }
            Greater => { match rhs { Greater => { return true } _ => { return false } } }
        }
    }
}

pub trait PartialOrd<Rhs> {
    fn partial_cmp(rhs: Rhs) -> Ordering;

    fn lt(rhs: Rhs) -> bool {
        match self.partial_cmp(rhs) {
            Less => {
                return true
            }
            _ => {
                return false
            }
        }
    }

    fn le(rhs: Rhs) -> bool {
        match self.partial_cmp(rhs) {
            Less => {
                return true
            }
            Equal => {
                return true
            }
            _ => {
                return false
            }
        }
    }

    fn gt(rhs: Rhs) -> bool {
        match self.partial_cmp(rhs) {
            Greater => {
                return true
            }
            _ => {
                return false
            }
        }
    }

    fn ge(rhs: Rhs) -> bool {
        match self.partial_cmp(rhs) {
            Less => {
                return false
            }
            Equal => {
                return true
            }
            Greater => {
                return true
            }
        }
    }
}

pub fn max<T>(a: T, b: T) -> T {
    if a < b {
        return b;
    }
    return a;
}

pub fn min<T>(a: T, b: T) -> T {
    if a < b {
        return a;
    }
    return b;
}

pub trait Index<Idx, Target> {
    fn index(index: Idx) -> Target;
}

pub trait Deref<Target> {
    fn deref() -> Target;
}