pub trait Add<Rhs, Output> {
    add(Rhs rhs) -> Output
}

pub trait Sub<Rhs, Output> {
    sub(Rhs rhs) -> Output
}

pub trait Mul<Rhs, Output> {
    mul(Rhs rhs) -> Output
}

pub trait Div<Rhs, Output> {
    div(Rhs rhs) -> Output
}

pub trait Rem<Rhs, Output> {
    rem(Rhs rhs) -> Output
}

pub trait Neg<Output> {
    neg() -> Output
}

pub trait BitAnd<Rhs, Output> {
    bit_and(Rhs rhs) -> Output
}

pub trait BitOr<Rhs, Output> {
    bit_or(Rhs rhs) -> Output
}

pub trait BitXor<Rhs, Output> {
    bit_xor(Rhs rhs) -> Output
}

pub trait BitNot<Output> {
    bit_not() -> Output
}

pub trait Shl<Rhs, Output> {
    shl(Rhs rhs) -> Output
}

pub trait Shr<Rhs, Output> {
    shr(Rhs rhs) -> Output
}

pub trait PartialEq<Rhs> {
    eq(Rhs rhs) -> bool
    ne(Rhs rhs) -> bool {
        return not self.eq(rhs)
    }
}

pub enum Ordering {
    Less
    Equal
    Greater
}

pub trait PartialOrd<Rhs> {
    partial_cmp(Rhs rhs) -> Ordering

    lt(Rhs rhs) -> bool {
        match self.partial_cmp(rhs) {
            Less {
                return true
            }
            _ {
                return false
            }
        }
    }

    le(Rhs rhs) -> bool {
        match self.partial_cmp(rhs) {
            Less {
                return true
            }
            Equal {
                return true
            }
            _ {
                return false
            }
        }
    }

    gt(Rhs rhs) -> bool {
        match self.partial_cmp(rhs) {
            Greater {
                return true
            }
            _ {
                return false
            }
        }
    }

    ge(Rhs rhs) -> bool {
        match self.partial_cmp(rhs) {
            Less {
                return false
            }
            Equal {
                return true
            }
            Greater {
                return true
            }
        }
    }
}

pub max<T>(T a, T b) -> T {
    if a < b {
        return b
    }
    return a
}

pub min<T>(T a, T b) -> T {
    if a < b {
        return a
    }
    return b
}

pub trait Index<Idx, Target> {
    index(Idx index) -> Target*
}

pub trait Deref<Target> {
    deref() -> Target*
}