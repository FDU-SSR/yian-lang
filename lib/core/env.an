from std.core.vec import Vec;
from std.core.string import String;

// Return the process arguments as independently owned, validated UTF-8 strings.
pub fn args() -> Vec<String> {
    let n = __yian_argc();
    let result = Vec<String>.with_capacity(n);
    let i: u64 = 0;
    while i < n {
        let bytes: u8[] = __yian_arg_bytes(i);
        let raw_str = match str.from_slice(bytes) {
            Some(value) => value,
            None => panic("process argument is not valid UTF-8"),
        };
        let s = String.from(&raw_str);
        result.push(s);
        i += 1;
    }
    result
}

// Terminate immediately with the requested process status.
pub fn exit(code: i32) {
    __yian_exit(code);
}
