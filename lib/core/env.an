from std.core.vec import Vec;
from std.core.string import String;
from std.core.slice import from_raw_parts;

pub fn args() -> Vec<String> {
    let n = __yian_argc();
    let result = Vec<String>.with_capacity(n);
    let i: u64 = 0;
    while i < n {
        let ptr = __yian_argv_ptr(i);
        let len = __yian_cstrlen(ptr);
        let byte_slice: u8[] = from_raw_parts(ptr, len);
        let raw_str = str.from_slice_unchecked(byte_slice);
        let s = String.from(&raw_str);
        result.push(s);
        i += 1;
    }
    result
}

pub fn exit(code: i32) {
    __yian_exit(code);
}
