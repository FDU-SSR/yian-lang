from std.cli.value import ArgValue, ValueType, CliError, CliErrorKind;
from std.core.result import Result;
from std.core.drop import Drop;
from std.core.string import String;
from std.core.range import Range;

fn invalid(name: str, text: str) -> CliError {
    let message = String.from(&"invalid value or numeric overflow: ");
    message.push_str(text);
    defer message.drop();
    CliError.new(CliErrorKind.InvalidValue, name, message.as_str())
}

// 符号与幅度分别处理，以表示 i64 的最小负值。
pub fn convert(text: str, kind: ValueType, name: str) -> Result<ArgValue, CliError> {
    if kind == ValueType.Text { return Result<ArgValue, CliError>.Ok(ArgValue.Text(String.from(&text))); }
    if kind == ValueType.Bool {
        if text == "true" { return Result<ArgValue, CliError>.Ok(ArgValue.Bool(true)); }
        if text == "false" { return Result<ArgValue, CliError>.Ok(ArgValue.Bool(false)); }
        return Result<ArgValue, CliError>.Err(invalid(name, text));
    }
    let negative = text.starts_with("-");
    let magnitude = text;
    if negative || text.starts_with("+") { magnitude = text[1u64..text.as_slice().len()]; }
    if kind == ValueType.F64 {
        let value = match f64.parse(magnitude) {
            Ok(value) => value,
            Err(_) => return Result<ArgValue, CliError>.Err(invalid(name, text)),
        };
        return Result<ArgValue, CliError>.Ok(ArgValue.F64(if negative { -value } else { value }));
    }
    let value = match u64.parse(magnitude) {
        Ok(value) => value,
        Err(_) => return Result<ArgValue, CliError>.Err(invalid(name, text)),
    };
    if kind == ValueType.U64 {
        if negative { return Result<ArgValue, CliError>.Err(invalid(name, text)); }
        return Result<ArgValue, CliError>.Ok(ArgValue.U64(value));
    }
    if negative {
        if value > 0x8000_0000_0000_0000u64 { return Result<ArgValue, CliError>.Err(invalid(name, text)); }
        let signed = if value == 0x8000_0000_0000_0000u64 { i64(0x8000_0000_0000_0000u64) } else { -i64(value) };
        return Result<ArgValue, CliError>.Ok(ArgValue.I64(signed));
    }
    if value > 0x7FFF_FFFF_FFFF_FFFFu64 { return Result<ArgValue, CliError>.Err(invalid(name, text)); }
    Result<ArgValue, CliError>.Ok(ArgValue.I64(i64(value)))
}

pub fn is_option(text: str) -> bool {
    let bytes = text.as_slice();
    if bytes.len() < 2u64 || bytes[0u64] != b'-' { return false; }
    if bytes[1u64] >= b'0' && bytes[1u64] <= b'9' { return false; }
    if bytes.len() > 2u64 && bytes[1u64] == b'.' && bytes[2u64] >= b'0' && bytes[2u64] <= b'9' { return false; }
    true
}
