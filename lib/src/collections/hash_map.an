from std.core.option import Option;
from std.core.hash import Murmur3BuildHasher, Murmur3Hasher;
from std.core.ops import Index;
from std.core.iter import Iterator, IntoIterator;
from std.core.range import Range;
from std.core.drop import Drop;
from std.core.clone import Clone;
from std.core.fmt import Format, Formatter;
from std.core.result import Result;
from std.core.io import IoError;

pub struct HashMap<K, V> {
    buckets: Bucket<K, V>*,
    ctrls: u8*,
    size: u64,
    capacity: u64,
    growth_left: u64,
    hasher_builder: Murmur3BuildHasher,
}

struct Bucket<K, V> {
    key: K,
    value: V,
}

impl<K, V> HashMap<K, V> {
    static pub fn new() -> Self {
        Self.with_capacity_and_hasher(0, Murmur3BuildHasher.with_seed(0))
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        Self.with_capacity_and_hasher(capacity, Murmur3BuildHasher.with_seed(0))
    }

    static pub fn with_capacity_and_hasher(capacity: u64, hasher_builder: Murmur3BuildHasher) -> Self {
        let actual_capacity = capacity.next_power_of_two();

        let growth_left = Self.calculate_growth_left(actual_capacity);
        let ctrls: u8* = @alloc<u8>(actual_capacity);
        for i in 0..actual_capacity {
            ctrls[i] = 0b1111_1111
        }
        let buckets: Bucket<K, V>* = @alloc<Bucket<K, V>>(actual_capacity);

        Self(
            buckets,
            ctrls,
            0,
            actual_capacity,
            growth_left,
            hasher_builder
        )
    }

    static pub fn calculate_growth_left(capacity: u64) -> u64 {
        capacity * 3 / 4
    }

    pub fn insert(key: K, value: V) {
        if self.capacity == 0 {
            @runtime_fail("S002");
        }
        if self.growth_left == 0 {
            self.resize(self.capacity * 2);
        }
        let hash = self.hash_key(&key);
        let primary_index = hash & (self.capacity - 1);
        let h2 = self.get_h2(hash);
        let index = primary_index;
        for i in 0..self.capacity {
            let ctrl_byte = self.ctrls[index];

            if ctrl_byte == 0b1111_1111 || ctrl_byte == 0b1000_0000 {
                self.ctrls[index] = h2
                self.buckets[index].key = key
                self.buckets[index].value = value
                self.size += 1
                self.growth_left -= 1
                return;
            } elif ctrl_byte == h2 && self.buckets[index].key == key {
                // Duplicate key: keep the stored key and replace only the value.
                // Both the incoming key and the replaced value are discarded
                // without Drop; shallow copies may alias caller-owned storage.
                self.buckets[index].value = value
                return;
            }
            index = (index + 1) & (self.capacity - 1);
        }
    }

    // A single probe implementation serves borrowed lookup and resource transfer.
    fn find_index(key: K&) -> Option<u64> {
        if self.capacity == 0 { return Option<u64>.None; }

        let hash = self.hash_key(key);
        let index = hash & (self.capacity - 1);
        let h2 = self.get_h2(hash);
        for probe in 0..self.capacity {
            let control = self.ctrls[index];
            if control == 0xFF { return Option<u64>.None; }
            if control == h2 && self.buckets[index].key == *key {
                return Option<u64>.Some(index);
            }
            index = (index + 1) & (self.capacity - 1);
        }
        Option<u64>.None
    }

    pub fn get(key: K&) -> Option<V&> {
        match self.find_index(key) {
            Some(index) => Option<V&>.Some(&self.buckets[index].value),
            None => Option<V&>.None,
        }
    }

    pub fn remove(key: K&) -> bool {
        // Container removal does not release resources owned by either element.
        self.remove_entry(key).is_some()
    }

    pub fn contains(key: K&) -> bool {
        self.get(key).is_some()
    }

    // A hit replaces the bucket in place and transfers both old resources.
    pub fn insert_or_replace(key: K, value: V) -> Option<(K, V)> {
        match self.find_index(&key) {
            Some(index) => {
                let old = (self.buckets[index].key, self.buckets[index].value);
                self.buckets[index] = Bucket<K, V>(key, value);
                return Option<(K, V)>.Some(old);
            },
            None => {},
        }

        self.insert_absent(key, value);
        Option<(K, V)>.None
    }

    pub fn remove_entry(key: K&) -> Option<(K, V)> {
        let index = match self.find_index(key) {
            Some(index) => index,
            None => return Option<(K, V)>.None,
        };
        let entry = (self.buckets[index].key, self.buckets[index].value);
        self.ctrls[index] = 0x80;
        self.size -= 1;
        Option<(K, V)>.Some(entry)
    }

    // A hit returns the unused input key; the factory runs only on a miss.
    // The factory must not reenter or structurally modify this table.
    pub fn get_or_insert_with<F>(key: K, factory: F) -> (V&, Option<K>) {
        match self.find_index(&key) {
            Some(index) => return (&self.buckets[index].value, Option<K>.Some(key)),
            None => {},
        }

        let value = factory();
        let index = self.insert_absent(key, value);
        (&self.buckets[index].value, Option<K>.None)
    }

    // The caller has already excluded an equal key; no duplicate-key policy applies.
    fn insert_absent(key: K, value: V) -> u64 {
        if self.capacity == 0 { @runtime_fail("S002"); }
        if self.growth_left == 0 { self.resize(self.capacity * 2); }

        let hash = self.hash_key(&key);
        let index = hash & (self.capacity - 1);
        for probe in 0..self.capacity {
            let control = self.ctrls[index];
            if control == 0xFF || control == 0x80 {
                self.ctrls[index] = self.get_h2(hash);
                self.buckets[index] = Bucket<K, V>(key, value);
                self.size += 1;
                self.growth_left -= 1;
                return index;
            }
            index = (index + 1) & (self.capacity - 1);
        }
        @runtime_fail("S002")
    }

    // Structural mutation invalidates these borrowed iterators and element references.
    pub fn entries() -> HashMapEntryIter<K, V> {
        HashMapEntryIter<K, V>(self.buckets, self.ctrls, self.capacity, 0)
    }

    pub fn values() -> HashMapValueIter<K, V> {
        HashMapValueIter<K, V>(self.entries())
    }

    pub fn len() -> u64 {
        self.size
    }

    pub fn is_empty() -> bool {
        self.size == 0
    }

    pub fn clear() {
        if self.capacity == 0 {
            return;
        }
        for i in 0..self.capacity {
            self.ctrls[i] = 0b1111_1111
        }
        self.size = 0;
        self.growth_left = Self.calculate_growth_left(self.capacity);
    }

    fn get_h2(hash: u64) -> u8 {
        let h2: u8 = u8(hash >> 56);
        if h2 == 0xFF || h2 == 0x80 {
            h2 = (h2 & 0x7F) | 0x40;
        }
        h2
    }

    fn resize(new_capacity: u64) {
        let actual_capacity = new_capacity.next_power_of_two();
        if actual_capacity == self.capacity {
            return;
        }

        let old_ctrls: u8* = self.ctrls;
        let old_buckets: Bucket<K, V>* = self.buckets
        let old_capacity = self.capacity;

        let new_ctrls: u8* = @alloc<u8>(actual_capacity);
        for i in 0..actual_capacity {
            new_ctrls[i] = 0b1111_1111
        }
        let new_buckets: Bucket<K, V>* = @alloc<Bucket<K, V>>(actual_capacity);

        self.capacity = actual_capacity;
        self.growth_left = Self.calculate_growth_left(actual_capacity);
        self.size = 0;
        if old_capacity > 0 {
            for i in 0..old_capacity {
                let ctrl_byte = old_ctrls[i];
                if ctrl_byte != 0xFF && ctrl_byte != 0x80 {
                    let hash = self.hash_key(&old_buckets[i].key);
                    let h2 = self.get_h2(hash);
                    let primary_index = hash & (actual_capacity - 1);
                    for j in 0..actual_capacity {
                        let new_ctrl_byte = new_ctrls[primary_index];
                        if new_ctrl_byte == 0b1111_1111 {
                            new_ctrls[primary_index] = h2
                            new_buckets[primary_index].key = old_buckets[i].key
                            new_buckets[primary_index].value = old_buckets[i].value
                            self.size += 1
                            self.growth_left -= 1
                            break;
                        }
                        primary_index = (primary_index + 1) & (actual_capacity - 1);
                    }
                }
            }
            // del releases only the allocation. It does not recursively drop
            // bucket fields that were shallow-copied into the new table.
            del old_ctrls;
            del old_buckets;
        }
        self.ctrls = new_ctrls;
        self.buckets = new_buckets;
    }

    pub fn hash_key(key: K&) -> u64 {
        let hasher = self.hasher_builder.build_hasher();
        key.hash(&hasher);
        hasher.finish()
    }
}

impl<K, V> Drop for HashMap<K, V> {
    pub fn drop() {
        if self.capacity > 0 {
            del self.ctrls;
            del self.buckets;
        }
        self.size = 0;
        self.capacity = 0;
        self.growth_left = 0;
    }
}

impl<K, V> Clone for HashMap<K, V> {
    // Copy only the two owned buffers (ctrls + buckets); do not recursively copy resources owned by K/V.
    // Container clone has these semantics; callers explicitly clone keys and values when a deep copy is required.
    pub fn clone() -> Self {
        if self.capacity == 0 {
            @runtime_fail("S002");
        }
        let ctrls: u8* = @alloc<u8>(self.capacity);
        @memcpy(ctrls, self.ctrls, self.capacity);
        let buckets: Bucket<K, V>* = @alloc<Bucket<K, V>>(self.capacity);
        @memcpy(buckets, self.buckets, self.capacity * @sizeof<Bucket<K, V>>);
        Self(
            buckets,
            ctrls,
            self.size,
            self.capacity,
            self.growth_left,
            self.hasher_builder
        )
    }
}

impl<K, V> Index<K, V&> for HashMap<K, V> {
    pub fn index(key: K&) -> V& {
        if self.capacity == 0 {
            @panic("indexing into empty map");
        }
        let hash = self.hash_key(key);
        let primary_index = hash & (self.capacity - 1);
        let h2 = self.get_h2(hash);
        let index = primary_index;
        for i in 0..self.capacity {
            let ctrl_byte = self.ctrls[index];

            if ctrl_byte == 0b1111_1111 {
                @panic("key ! found");
            }

            if ctrl_byte == h2 {
                let bucket: Bucket<K, V>* = &self.buckets[index]
                if bucket.key == *key {
                    return &bucket.value;
                }
            }
            index = (index + 1) & (self.capacity - 1);
        }

        @panic("key ! found");
    }
}

pub struct HashMapEntryIter<K, V> {
    buckets: Bucket<K, V>*, ctrls: u8*, capacity: u64, index: u64,
}

impl<K, V> Iterator<(K&, V&)> for HashMapEntryIter<K, V> {
    pub fn next() -> Option<(K&, V&)> {
        while self.index < self.capacity {
            let index = self.index;
            self.index += 1;
            let control = self.ctrls[index];
            if control != 0xFF && control != 0x80 {
                return Option<(K&, V&)>.Some((&self.buckets[index].key, &self.buckets[index].value));
            }
        }
        Option<(K&, V&)>.None
    }
}

pub struct HashMapValueIter<K, V> { entries: HashMapEntryIter<K, V> }
impl<K, V> Iterator<V&> for HashMapValueIter<K, V> {
    pub fn next() -> Option<V&> {
        match self.entries.next() {
            Some(entry) => Option<V&>.Some(entry[1]),
            None => Option<V&>.None,
        }
    }
}

pub struct HashMapKeyIter<K, V> {
    buckets: Bucket<K, V>*,
    ctrls: u8*,
    capacity: u64,
    index: u64,
}

impl<K, V> Iterator<K&> for HashMapKeyIter<K, V> {
    pub fn next() -> Option<K&> {
        while self.index < self.capacity {
            let ctrl_byte = self.ctrls[self.index];
            if ctrl_byte != 0b1111_1111 && ctrl_byte != 0b1000_0000 {
                let key: K* = &self.buckets[self.index].key;
                self.index += 1
                return Option<K&>.Some(key);
            }
            self.index += 1
        }
        Option<K&>.None
    }
}

impl<K, V> IntoIterator<HashMapKeyIter<K, V>> for HashMap<K, V> {
    pub fn into_iter() -> HashMapKeyIter<K, V> {
        HashMapKeyIter<K, V>(
            buckets=self.buckets,
            ctrls=self.ctrls,
            capacity=self.capacity,
            index=0
        )
    }
}

impl<K, V> Format for HashMap<K, V> if K: Format, V: Format {
    fn fmt(out: Formatter&) -> Result<(), IoError> {
        out.write_str("{")?;
        let entries = self.entries();
        let first = true;
        loop {
            match entries.next() {
                Some(entry) => {
                    if !first { out.write_str(", ")?; }
                    first = false;
                    out.write_value(entry[0])?;
                    out.write_str(": ")?;
                    out.write_value(entry[1])?;
                },
                None => { break; },
            }
        }
        out.write_str("}")
    }
}
