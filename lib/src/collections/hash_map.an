from std.core.option import Option;
from std.core.hash import Murmur3BuildHasher, Murmur3Hasher;
from std.core.ops import Index;
from std.core.iter import Iterator, IntoIterator;
from std.core.range import Range;
from std.core.drop import Drop;
from std.core.clone import Clone;
from std.core.fmt import Format, Formatter, FormatSpec;
from std.core.result import Result;
from std.core.io import IoError;

pub struct HashMap<K, V> {
    raw: RawTable,
    hasher_builder: Murmur3BuildHasher,
}

struct Bucket<K, V> {
    key: K,
    value: V,
}

impl<K, V> HashMap<K, V> {
    static pub fn new() -> Self {
        Self.with_capacity_and_hasher(0, Murmur3BuildHasher.with_seed(0))
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        Self.with_capacity_and_hasher(capacity, Murmur3BuildHasher.with_seed(0))
    }

    static pub fn with_capacity_and_hasher(capacity: u64, hasher_builder: Murmur3BuildHasher) -> Self {
        Self(RawTable.with_capacity(capacity, @sizeof<Bucket<K, V>>), hasher_builder)
    }

    static pub fn calculate_growth_left(capacity: u64) -> u64 {
        RawTable.calculate_growth_left(capacity)
    }

    fn typed_buckets() -> Bucket<K, V>* {
        // A pointer to a zero-sized bucket is itself zero-sized. Querying the
        // pointer keeps the bucket layout in the backend for recovery builds.
        comptime if @sizeof<Bucket<K, V>*> == 0u64 {
            @dangling<Bucket<K, V>>()
        } else {
            @bitcast<Bucket<K, V>*>(self.raw.buckets)
        }
    }

    pub fn insert(key: K, value: V) {
        if self.raw.capacity == 0 {
            @runtime_fail("S002");
        }
        if self.raw.growth_left == 0 {
            self.grow();
        }
        let hash = self.hash_key(&key);
        let mask = self.raw.capacity - 1;
        let h2 = hash_fragment(hash);
        let buckets = self.typed_buckets();
        let index = hash & mask;
        for i in 0..self.raw.capacity {
            let control = self.raw.ctrls[index];
            if !is_occupied(control) {
                buckets[index].key = key;
                buckets[index].value = value;
                self.raw.record_insert(index, h2);
                return;
            } elif control == h2 && buckets[index].key == key {
                // Duplicate key: keep the stored key and replace only the value.
                // Both the incoming key and the replaced value are discarded
                // without Drop; shallow copies may alias caller-owned storage.
                buckets[index].value = value;
                return;
            }
            index = (index + 1) & mask;
        }
    }

    // A single probe implementation serves borrowed lookup and resource transfer.
    fn find_index(key: K&) -> Option<u64> {
        if self.raw.capacity == 0 { return Option<u64>.None; }

        let hash = self.hash_key(key);
        let mask = self.raw.capacity - 1;
        let index = hash & mask;
        let h2 = hash_fragment(hash);
        let buckets = self.typed_buckets();
        for probe in 0..self.raw.capacity {
            let control = self.raw.ctrls[index];
            if control == CTRL_EMPTY { return Option<u64>.None; }
            if control == h2 && buckets[index].key == *key {
                return Option<u64>.Some(index);
            }
            index = (index + 1) & mask;
        }
        Option<u64>.None
    }

    pub fn get(key: K&) -> Option<V&> {
        match self.find_index(key) {
            Some(index) => Option<V&>.Some(&self.typed_buckets()[index].value),
            None => Option<V&>.None,
        }
    }

    pub fn remove(key: K&) -> bool {
        // Container removal does not release resources owned by either element.
        self.remove_entry(key).is_some()
    }

    pub fn contains(key: K&) -> bool {
        self.get(key).is_some()
    }

    // A hit replaces the bucket in place and transfers both old resources.
    pub fn insert_or_replace(key: K, value: V) -> Option<(K, V)> {
        match self.find_index(&key) {
            Some(index) => {
                let bucket = self.typed_buckets() + index;
                let old = (bucket.key, bucket.value);
                *bucket = Bucket<K, V>(key, value);
                return Option<(K, V)>.Some(old);
            },
            None => {},
        }

        self.insert_absent(key, value);
        Option<(K, V)>.None
    }

    pub fn remove_entry(key: K&) -> Option<(K, V)> {
        let index = match self.find_index(key) {
            Some(index) => index,
            None => return Option<(K, V)>.None,
        };
        let bucket = self.typed_buckets() + index;
        let entry = (bucket.key, bucket.value);
        self.raw.record_remove(index);
        Option<(K, V)>.Some(entry)
    }

    // A hit returns the unused input key; the factory runs only on a miss.
    // The factory must not reenter or structurally modify this table.
    pub fn get_or_insert_with<F>(key: K, factory: F) -> (V&, Option<K>) {
        match self.find_index(&key) {
            Some(index) => return (&self.typed_buckets()[index].value, Option<K>.Some(key)),
            None => {},
        }

        let value = factory();
        let index = self.insert_absent(key, value);
        (&self.typed_buckets()[index].value, Option<K>.None)
    }

    // The caller has already excluded an equal key; no duplicate-key policy applies.
    fn insert_absent(key: K, value: V) -> u64 {
        if self.raw.capacity == 0 { @runtime_fail("S002"); }
        if self.raw.growth_left == 0 { self.grow(); }

        let hash = self.hash_key(&key);
        let index = self.raw.find_vacant(hash, true);
        self.typed_buckets()[index] = Bucket<K, V>(key, value);
        self.raw.record_insert(index, hash_fragment(hash));
        index
    }

    // Structural mutation invalidates these borrowed iterators and element references.
    pub fn entries() -> HashMapEntryIter<K, V> {
        HashMapEntryIter<K, V>(self.typed_buckets(), self.raw.ctrls, self.raw.capacity, 0)
    }

    pub fn values() -> HashMapValueIter<K, V> {
        HashMapValueIter<K, V>(self.entries())
    }

    pub fn len() -> u64 {
        self.raw.size
    }

    pub fn is_empty() -> bool {
        self.raw.size == 0
    }

    pub fn clear() {
        self.raw.clear();
    }

    fn grow() {
        let stride = @sizeof<Bucket<K, V>>;
        let old = self.raw;
        let old_buckets = self.typed_buckets();
        let next = self.raw.prepare_growth(stride);
        for i in 0..old.capacity {
            if is_occupied(old.ctrls[i]) {
                let hash = self.hash_key(&old_buckets[i].key);
                self.raw.rehash_bucket(&next, i, hash, stride);
            }
        }
        old.release(stride);
        self.raw.ctrls = next.ctrls;
        self.raw.buckets = next.buckets;
    }

    pub fn hash_key(key: K&) -> u64 {
        let hasher = self.hasher_builder.build_hasher();
        key.hash(&hasher);
        hasher.finish()
    }
}

impl<K, V> Drop for HashMap<K, V> {
    pub fn drop() {
        self.raw.drop_storage(@sizeof<Bucket<K, V>>);
    }
}

impl<K, V> Clone for HashMap<K, V> {
    // Copy only the two owned buffers (ctrls + buckets); do not recursively copy resources owned by K/V.
    // Container clone has these semantics; callers explicitly clone keys and values when a deep copy is required.
    pub fn clone() -> Self {
        Self(self.raw.clone_storage(@sizeof<Bucket<K, V>>), self.hasher_builder)
    }
}

impl<K, V> Index<K, V&> for HashMap<K, V> {
    pub fn index(key: K&) -> V& {
        if self.raw.capacity == 0 {
            @panic("indexing into empty map");
        }
        let hash = self.hash_key(key);
        let mask = self.raw.capacity - 1;
        let h2 = hash_fragment(hash);
        let buckets = self.typed_buckets();
        let index = hash & mask;
        for i in 0..self.raw.capacity {
            let ctrl_byte = self.raw.ctrls[index];

            if ctrl_byte == CTRL_EMPTY {
                @panic("key ! found");
            }

            if ctrl_byte == h2 {
                let bucket = buckets + index;
                if bucket.key == *key {
                    return &bucket.value;
                }
            }
            index = (index + 1) & mask;
        }

        @panic("key ! found");
    }
}

pub struct HashMapEntryIter<K, V> {
    buckets: Bucket<K, V>*, ctrls: u8*, capacity: u64, index: u64,
}

impl<K, V> Iterator<(K&, V&)> for HashMapEntryIter<K, V> {
    pub fn next() -> Option<(K&, V&)> {
        while self.index < self.capacity {
            let index = self.index;
            self.index += 1;
            let control = self.ctrls[index];
            if is_occupied(control) {
                return Option<(K&, V&)>.Some((&self.buckets[index].key, &self.buckets[index].value));
            }
        }
        Option<(K&, V&)>.None
    }
}

pub struct HashMapValueIter<K, V> { entries: HashMapEntryIter<K, V> }
impl<K, V> Iterator<V&> for HashMapValueIter<K, V> {
    pub fn next() -> Option<V&> {
        match self.entries.next() {
            Some(entry) => Option<V&>.Some(entry[1]),
            None => Option<V&>.None,
        }
    }
}

pub struct HashMapKeyIter<K, V> {
    buckets: Bucket<K, V>*,
    ctrls: u8*,
    capacity: u64,
    index: u64,
}

impl<K, V> Iterator<K&> for HashMapKeyIter<K, V> {
    pub fn next() -> Option<K&> {
        while self.index < self.capacity {
            if is_occupied(self.ctrls[self.index]) {
                let key: K* = &self.buckets[self.index].key;
                self.index += 1
                return Option<K&>.Some(key);
            }
            self.index += 1
        }
        Option<K&>.None
    }
}

impl<K, V> IntoIterator<HashMapKeyIter<K, V>> for HashMap<K, V> {
    pub fn into_iter() -> HashMapKeyIter<K, V> {
        HashMapKeyIter<K, V>(
            buckets=self.typed_buckets(),
            ctrls=self.raw.ctrls,
            capacity=self.raw.capacity,
            index=0
        )
    }
}

impl<K, V> Format for HashMap<K, V> if K: Format, V: Format {
    fn fmt(out: Formatter&, spec: FormatSpec&) -> Result<(), IoError> {
        spec.require_default()?;
        let inner = FormatSpec.new();
        out.write_str("{")?;
        let entries = self.entries();
        let first = true;
        loop {
            match entries.next() {
                Some(entry) => {
                    if !first { out.write_str(", ")?; }
                    first = false;
                    out.write_value(entry[0], &inner)?;
                    out.write_str(": ")?;
                    out.write_value(entry[1], &inner)?;
                },
                None => { break; },
            }
        }
        out.write_str("}")
    }
}

const CTRL_EMPTY: u8 = 0xFF;
const CTRL_DELETED: u8 = 0x80;
const MAX_POWER_OF_TWO: u64 = 0x8000_0000_0000_0000;

fn is_occupied(control: u8) -> bool {
    control != CTRL_EMPTY && control != CTRL_DELETED
}

fn hash_fragment(hash: u64) -> u8 {
    let h2 = u8(hash >> 56);
    if !is_occupied(h2) {
        h2 = (h2 & 0x7F) | 0x40;
    }
    h2
}

// The roots own separate allocations. A zero-sized bucket has no allocation.
struct RawTable {
    buckets: u8*,
    ctrls: u8*,
    size: u64,
    capacity: u64,
    growth_left: u64,
}

impl RawTable {
    static fn with_capacity(capacity: u64, stride: u64) -> Self {
        if capacity > MAX_POWER_OF_TWO {
            @runtime_fail("R001");
        }
        Self.allocate(capacity.next_power_of_two(), stride)
    }

    static fn allocate(capacity: u64, stride: u64) -> Self {
        let ctrls = @alloc<u8>(capacity);
        Self.reset_controls(ctrls, capacity);
        let buckets = if stride == 0 {
            @dangling<u8>()
        } else {
            @alloc<u8>(Self.bucket_bytes(capacity, stride))
        };
        Self(buckets, ctrls, 0, capacity, Self.calculate_growth_left(capacity))
    }

    static fn bucket_bytes(capacity: u64, stride: u64) -> u64 {
        if capacity > u64.max() / stride {
            @runtime_fail("R001");
        }
        capacity * stride
    }

    static fn calculate_growth_left(capacity: u64) -> u64 {
        capacity * 3 / 4
    }

    static fn reset_controls(ctrls: u8*, capacity: u64) {
        for i in 0..capacity {
            ctrls[i] = CTRL_EMPTY;
        }
    }

    fn clear() {
        if self.capacity == 0 {
            return;
        }
        Self.reset_controls(self.ctrls, self.capacity);
        self.size = 0;
        self.growth_left = Self.calculate_growth_left(self.capacity);
    }

    fn find_vacant(hash: u64, reuse_deleted: bool) -> u64 {
        let mask = self.capacity - 1;
        let index = hash & mask;
        for probe in 0..self.capacity {
            let control = self.ctrls[index];
            if control == CTRL_EMPTY || (reuse_deleted && control == CTRL_DELETED) {
                return index;
            }
            index = (index + 1) & mask;
        }
        @runtime_fail("S002")
    }

    fn record_insert(index: u64, h2: u8) {
        self.ctrls[index] = h2;
        self.count_insert();
    }

    fn count_insert() {
        self.size += 1;
        self.growth_left -= 1;
    }

    fn record_remove(index: u64) {
        self.ctrls[index] = CTRL_DELETED;
        self.size -= 1;
    }

    // Transfer the roots after rehashing, when these old roots can be released.
    fn prepare_growth(stride: u64) -> Self {
        if self.capacity >= MAX_POWER_OF_TWO {
            @runtime_fail("R001");
        }
        let next = Self.allocate(self.capacity * 2, stride);
        self.capacity = next.capacity;
        self.growth_left = next.growth_left;
        self.size = 0;
        next
    }

    fn rehash_bucket(next: RawTable&, old_index: u64, hash: u64, stride: u64) {
        let index = next.find_vacant(hash, false);
        next.ctrls[index] = hash_fragment(hash);
        if stride != 0 {
            @memcpy(next.buckets + index * stride, self.buckets + old_index * stride, stride);
        }
        self.count_insert();
    }

    fn clone_storage(stride: u64) -> Self {
        if self.capacity == 0 {
            @runtime_fail("S002");
        }
        let ctrls = @alloc<u8>(self.capacity);
        @memcpy(ctrls, self.ctrls, self.capacity);
        let buckets = @dangling<u8>();
        if stride != 0 {
            let bytes = Self.bucket_bytes(self.capacity, stride);
            buckets = @alloc<u8>(bytes);
            @memcpy(buckets, self.buckets, bytes);
        }
        Self(buckets, ctrls, self.size, self.capacity, self.growth_left)
    }

    fn release(stride: u64) {
        if self.capacity == 0 {
            return;
        }
        del self.ctrls;
        if stride != 0 {
            del self.buckets;
        }
    }

    fn drop_storage(stride: u64) {
        self.release(stride);
        self.size = 0;
        self.capacity = 0;
        self.growth_left = 0;
    }
}
