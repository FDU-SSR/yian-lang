from std.core.hash import Murmur3Hasher, Hash;

impl Hash<Murmur3Hasher> for f32 {
    fn hash(hasher: Murmur3Hasher&) {
        // Signed zeros compare equal and share the same hash representation.
        let value: f32 = if *self == 0.0f32 {
            0.0f32
        } else {
            *self
        };

        let bytes: u8[4] = [0, 0, 0, 0];
        @memcpy(&bytes, &value, 4);
        hasher.write(bytes.as_slice());
    }
}
