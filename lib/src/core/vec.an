from std.core.hash import Hash, Murmur3Hasher;
from std.core.ops import Index, PartialEq, Deref, Add;
from std.core.clone import Clone;
from std.core.option import Option;
from std.core.convert import From, Into;
from std.core.drop import Drop;
from std.core.fmt import Format, Formatter, FormatSpec;
from std.core.result import Result;
from std.core.io import IoError;

// The recovery compiler reads this marker before generating code.
const VEC_REQUIRES_BYTE_POINTER_METADATA: bool = true;

pub struct Vec<T> {
    raw_vec: RawVec,
}

impl<T> Vec<T> {
    static fn empty_data() -> u8* {
        comptime if @sizeof<T> == 0u64 {
            @dangling<u8>()
        } else {
            // A nonzero, type-aligned address also preserves Some(empty).
            @bitcast<u8*>(@dangling<T>())
        }
    }

    fn ptr() -> T* {
        comptime if @sizeof<T> == 0u64 {
            @dangling<T>()
        } else {
            @bitcast<T*>(self.raw_vec.data)
        }
    }

    // Create a new, empty Vec
    static pub fn new() -> Self {
        Self(raw_vec=RawVec(data=Self.empty_data(), cap=0, len=0))
    }

    // Return the current vector and leave an empty vector in its place.
    // The backing buffer is not copied or freed; existing aliases remain unchanged.
    pub fn take() -> Self {
        let result = *self;
        *self = Self.new();
        result
    }

    // Create a Vec with specified capacity
    static pub fn with_capacity(capacity: u64) -> Self {
        Self(raw_vec=RawVec.with_capacity(capacity, @sizeof<T>, Self.empty_data()))
    }

    // Get a slice reference to the elements
    pub fn as_slice() -> T[] {
        @slice_from_parts(self.ptr(), self.raw_vec.len)
    }

    // Push an element to the end. The argument is copied by value.
    pub fn push(value: T) {
        let len = self.raw_vec.prepare_slot(@sizeof<T>);
        *(self.ptr() + len) = value;
        self.raw_vec.len = len + 1;
    }

    // Append another Vec's elements to the end; the source remains unchanged.
    // `other` may be this same Vec, so its data pointer is read only after
    // `reserve`: growing moves the buffer that `other` pointed at before.
    pub fn extend(other: Vec<T>&) {
        self.raw_vec.extend(&other.raw_vec.data, other.raw_vec.len, @sizeof<T>);
    }

    // Pop an element from the end, returning None if empty
    pub fn pop() -> Option<T> {
        if self.raw_vec.len == 0 {
            Option<T>.None
        } else {
            self.raw_vec.len -= 1;
            let end = self.ptr() + self.raw_vec.len;
            Option<T>.Some(*end)
        }
    }

    // Insert an element at index, shifting elements to the right
    // Panics if index > len
    pub fn insert(index: u64, value: T) {
        self.raw_vec.prepare_insert(index, @sizeof<T>);
        self.ptr()[index] = value;
        self.raw_vec.len += 1;
    }

    // Remove an element at index, shifting elements to the left, returning the removed element
    // Panics if index >= len
    pub fn remove(index: u64) -> T {
        if index >= self.raw_vec.len {
            @runtime_fail("S001");
        }
        let value = self.ptr()[index];
        self.raw_vec.remove(index, @sizeof<T>);
        value
    }

    // Remove the element at index, replacing it with the element at end, returning the removed element
    // Panics if index >= len
    pub fn swap_remove(index: u64) -> T {
        if index >= self.raw_vec.len {
            @runtime_fail("S001");
        }
        let value = self.ptr()[index];
        self.raw_vec.swap_remove(index, @sizeof<T>);
        value
    }

    // Extend the Vec with a slice
    // Elements are copied bitwise, so a `T` that owns heap data ends up sharing
    // it with the source; the container neither clones nor owns the elements.
    // `slice` must not point into this Vec: `reserve` may move the buffer while
    // the slice keeps the address it was built with.
    pub fn extend_from_slice(slice: T[]) {
        let count = slice.len();
        comptime if @sizeof<T> == 0u64 {
            self.raw_vec.len += count;
        } else {
            let source = @bitcast<u8*>(slice.ptr());
            self.raw_vec.extend(&source, count, @sizeof<T>);
        }
    }

    // Shorten the Vec, keeping the first `len` elements
    pub fn truncate(len: u64) {
        if len > self.raw_vec.len {
            return;
        }

        // Element cleanup is the caller's responsibility. The container only
        // forgets the truncated range and retains the backing allocation.
        self.raw_vec.len = len;
    }

    // Remove all elements
    pub fn clear() {
        self.truncate(0);
    }

    // Reserve capacity for at least `additional` more elements
    pub fn reserve(additional: u64) {
        self.raw_vec.reserve(additional, @sizeof<T>);
    }

    // Reserve `additional` elements and return a writable pointer at `len`.
    // Callers write at most `additional` elements, then update the length with advance_len.
    // The caller initializes the slots before advancing the length.
    pub fn spare(additional: u64) -> T* {
        self.reserve(additional);
        return self.ptr() + self.raw_vec.len;
    }

    // Advance the length after writing `count` elements.
    pub fn advance_len(count: u64) {
        self.raw_vec.len += count;
    }

    // Shrinks the capacity as much as possible
    pub fn shrink_to_fit() {
        self.raw_vec.shrink_to_fit(@sizeof<T>, Self.empty_data());
    }

    // Check if the Vec is empty
    pub fn is_empty() -> bool {
        self.raw_vec.len == 0
    }

    // Get the capacity
    pub fn capacity() -> u64 {
        comptime if @sizeof<T> == 0u64 {
            u64.max()
        } else {
            self.raw_vec.cap
        }
    }
}

// Clone copies the element buffer the Vec itself manages; resources owned by the
// elements are not cloned recursively (call clone() on them explicitly if needed).
impl<T> Clone for Vec<T> {
    pub fn clone() -> Self {
        self.as_slice().to_vec()
    }
}

impl<T> Index<u64, T&> for Vec<T> {
    pub fn index(index: u64&) -> T& {
        if *index >= self.raw_vec.len {
            @runtime_fail("S001");
        }
        // The return type implicitly converts the typed pointer to a reference.
        return self.ptr() + *index;
    }
}

impl<T> PartialEq<Vec<T>> for Vec<T> {
    pub fn eq(rhs: Vec<T>&) -> bool {
        self.as_slice() == rhs.as_slice()
    }
}

// Implement From for Vec<T> to create a Vec from a slice
// This will clone the elements from the slice into the Vec
impl<T> From<T[]> for Vec<T> {
    pub static fn from(value: T[]&) -> Self {
        value.to_vec()
    }
}

// Implement Into for Vec<T> to convert a Vec into a slice
// This will return a slice reference to the elements in the Vec
impl<T> Into<Vec<T>> for T[] {
    pub fn into() -> Vec<T> {
        Vec<T>.from(self)
    }
}

// Implement Deref for Vec<T> to allow dereferencing to a slice
impl<T> Deref<T[]> for Vec<T> {
    pub fn deref() -> T[] {
        self.as_slice()
    }
}

// Concatenation builds a new Vec from bitwise copies of both inputs' elements.
impl<T> Add<Vec<T>, Vec<T>> for Vec<T> {
    pub fn add(rhs: Vec<T>) -> Vec<T> {
        let res = Vec<T>.with_capacity(checked_length(self.len(), rhs.len()));
        res.extend(self);
        res.extend(&rhs);
        res
    }
}

// Implement Drop for Vec<T> to release the backing allocation. Elements are
// not dropped by the container.
impl<T> Drop for Vec<T> {
    pub fn drop() {
        self.raw_vec.reset(Self.empty_data());
    }
}

impl<T> Hash<Murmur3Hasher> for Vec<T> {
    fn hash(hasher: Murmur3Hasher&) { self.as_slice().hash(hasher); }
}

impl<T> Format for Vec<T> if T: Format {
    fn fmt(out: Formatter&, spec: FormatSpec&) -> Result<(), IoError> {
        spec.require_default()?;
        let inner = FormatSpec.new();
        out.write_str("[")?;
        let index: u64 = 0;
        while index < self.len() {
            if index != 0u64 { out.write_str(", ")?; }
            out.write_value(&self.as_slice()[index], &inner)?;
            index += 1u64;
        }
        out.write_str("]")
    }
}

extern "C" {
    fn memmove(destination: cptr<u8>, source: cptr<u8>, count: c_size) -> cptr<u8>;
}

ffi fn move_bytes(destination: u8*, source: u8*, count: u64) {
    if count == 0 {
        return;
    }
    let (dst, _) = @ffi_parts(@slice_from_parts(destination, count));
    let (src, _) = @ffi_parts(@slice_from_parts(source, count));
    memmove(dst, src, c_size(count));
}

// Counts are in elements. For an allocated buffer, data is the allocation
// root and its byte extent is cap * stride. A zero stride never allocates.
struct RawVec {
    data: u8*,
    cap: u64,
    len: u64,
}

impl RawVec {
    static fn with_capacity(capacity: u64, stride: u64, empty: u8*) -> Self {
        let result = Self(data=empty, cap=0, len=0);
        if capacity != 0u64 && stride != 0u64 {
            result.resize(capacity, stride);
        }
        result
    }

    // Only called for nonzero capacities and strides. Publish the new root
    // and capacity after the checked allocation succeeds.
    fn resize(capacity: u64, stride: u64) {
        if capacity > u64.max() / stride {
            @runtime_fail("R001");
        }
        let bytes = capacity * stride;
        self.data = if self.cap == 0 {
            @alloc<u8>(bytes)
        } else {
            @realloc<u8>(self.data, bytes)
        };
        self.cap = capacity;
    }

    static fn doubled(capacity: u64) -> u64 {
        if capacity > u64.max() / 2u64 {
            @runtime_fail("R001");
        }
        capacity * 2
    }

    fn prepare_slot(stride: u64) -> u64 {
        let len = self.len;
        if stride != 0u64 && len == self.cap {
            self.resize(if len == 0u64 { 4 } else { Self.doubled(len) }, stride);
        }
        len
    }

    fn reserve(additional: u64, stride: u64) {
        if stride == 0u64 || additional <= self.cap - self.len {
            return;
        }
        let required = checked_length(self.len, additional);
        let preferred = Self.doubled(if self.cap < 2u64 { 2 } else { self.cap });
        self.resize(if preferred < required { required } else { preferred }, stride);
    }

    fn shrink_to_fit(stride: u64, empty: u8*) {
        if self.len >= self.cap {
            return;
        }
        if self.len == 0 {
            self.reset(empty);
        } else {
            self.resize(self.len, stride);
        }
    }

    fn reset(empty: u8*) {
        if self.cap != 0 {
            del self.data;
            self.data = empty;
            self.cap = 0;
        }
        self.len = 0;
    }

    fn prepare_insert(index: u64, stride: u64) {
        let len = self.len;
        if index > len {
            @runtime_fail("S001");
        }
        self.prepare_slot(stride);
        self.shift_tail(index + 1, index, len - index, stride);
    }

    fn remove(index: u64, stride: u64) {
        let last = self.len - 1;
        self.shift_tail(index, index + 1, last - index, stride);
        self.len = last;
    }

    fn shift_tail(destination: u64, source: u64, count: u64, stride: u64) {
        if count != 0u64 && stride != 0u64 {
            move_bytes(self.data + destination * stride, self.data + source * stride, count * stride);
        }
    }

    fn swap_remove(index: u64, stride: u64) {
        let last = self.len - 1;
        if stride != 0u64 && index != last {
            @memcpy(self.data + index * stride, self.data + last * stride, stride);
        }
        self.len = last;
    }

    // Read the source pointer after reserve. In a self-extension, source
    // refers to this descriptor's data field.
    fn extend(source: u8*&, count: u64, stride: u64) {
        if count == 0 {
            return;
        }
        if stride != 0 {
            self.reserve(count, stride);
            @memcpy(self.data + self.len * stride, *source, count * stride);
        }
        self.len += count;
    }
}

fn checked_length(len: u64, additional: u64) -> u64 {
    if additional > u64.max() - len {
        @runtime_fail("R001");
    }
    len + additional
}
