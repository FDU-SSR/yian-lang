from std.core.range import Range;

pub fn memcpy<T>(dest: T*, src: T*, count: u64) {
    for i in 0..count {
        dest[i] = src[i].clone();
    }
}

pub fn memmove<T>(dest: T*, src: T*, count: u64) {
    comptime if IS_RAW_MODE {
        if dest <= src {
            for i in 0..count {
                dest[i] = src[i];
            }
            return;
        }

        let i = count;
        while i > 0 {
            i -= 1;
            dest[i] = src[i];
        }
    } else {
        // Do not order fat pointers from different allocations: checked SECL
        // rejects cross-allocation ordering comparisons. A temporary buffer
        // also gives memmove its overlap-safe behavior.
        let temporary: T* = dyn[count] T;
        for i in 0..count {
            temporary[i] = src[i];
        }
        for i in 0..count {
            dest[i] = temporary[i];
        }
        del temporary;
    }
}
