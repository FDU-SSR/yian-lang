from std.core.range import Range;
from std.core.drop import Drop;

pub struct RawVec<T> {
    data: T*,
    cap: u64,
}

// 生命周期由使用者负责: 释放后再取用/再释放都是 UB, 这里不做任何检查。
// ZST(`@sizeof(T) == 0`)没有真实数据可处理: 分配/拷贝/释放全部用 if 拦掉,
// 只维护容量计数。
impl<T> RawVec<T> {
    static pub fn new() -> Self {
        Self(
            data=@alloc<T>(0),
            cap=0
        )
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        if capacity == 0 {
            return Self.new();
        }
        if @sizeof(T) == 0 {
            return Self(
                data=@alloc<T>(0),
                cap=capacity
            )
        }
        let data: T* = @alloc<T>(capacity);
        Self(
            data=data,
            cap=capacity
        )
    }

    pub fn ptr() -> T* {
        return self.data;
    }

    pub fn capacity() -> u64 {
        return self.cap;
    }

    pub fn grow() {
        if @sizeof(T) == 0 {
            self.cap = if self.cap == 0 { 4 } else { self.cap * 2 };
            return;
        }
        let old_cap: u64 = self.cap;
        let new_cap: u64 = if old_cap == 0 { 4 } else { old_cap * 2 };

        let new_data: T* = @alloc<T>(new_cap);

        if old_cap > 0 {
            // Since we assume the vector is full when grow() is called
            @memcpy(new_data, self.data, old_cap * @sizeof(T));
        }
        del self.data;

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn reserve(len: u64, additional: u64) {
        let required_cap: u64 = len + additional;
        if self.cap >= required_cap {
            return;
        }
        if @sizeof(T) == 0 {
            self.cap = required_cap;
            return;
        }

        let current_cap: u64 = self.cap;
        let new_cap: u64 = if current_cap > 0x3FFF_FFFF_FFFF_FFFFu64 {
            required_cap
        } else {
            current_cap * 2
        };
        if new_cap < required_cap {
            new_cap = required_cap;
        }
        // Ensure minimum capacity
        if new_cap < 4 {
            new_cap = 4;
        }

        let new_data: T* = @alloc<T>(new_cap);

        // Copy valid elements
        if len > 0 {
            @memcpy(new_data, self.data, len * @sizeof(T));
        }

        del self.data;

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn shrink_to_fit(len: u64) {
        if self.cap <= len {
            return;
        }
        if @sizeof(T) == 0 {
            self.cap = len;
            return;
        }

        if len == 0 {
            let new_data: T* = @alloc<T>(0);
            del self.data;
            self.data = new_data;
            self.cap = 0;
            return;
        }

        let new_data: T* = @alloc<T>(len);

        // Copy valid elements
        @memcpy(new_data, self.data, len * @sizeof(T));

        del self.data;

        self.data = new_data;
        self.cap = len;
    }
}

impl<T> Drop for RawVec<T> {
    fn drop() {
        if @sizeof(T) == 0 {
            return;
        }
        del self.data;
        self.cap = 0;
    }
}
