from std.core.range import Range;
from std.core.drop import Drop;

pub struct RawVec<T> {
    data: T*,
    cap: u64,
}

// 生命周期由使用者负责: 释放后再取用/再释放都是 UB, 这里不做任何检查。
// ZST(`@sizeof<T> == 0`)没有真实数据可处理: 分配/拷贝/释放全部用 if 拦掉,
// 只维护容量计数。
//
// 空态(`cap == 0`)不占堆块: 数据指针是 `@dangling<T>()`(地址 = T 的对齐值),
// 两模式表示一致, 空态只做零长度的指针算术/传递, 不解引用、不释放。
// 非零是硬要求: `Option<str>`/`Option<Slice<T>>` 这类单字段载荷用"载荷全零"
// 编码 None, 空容器(或由它派生的空 str/切片)一旦取到全零指针, `Some(空值)`
// 就会被误判成 `None`。`@dangling` 给出的地址是对齐值(≥ 1), 且是定值 ——
// `@undef` 会在不同优化级别下物化成不同位型, 不能用来承载这个不变量。
impl<T> RawVec<T> {
    static pub fn new() -> Self {
        Self.with_capacity(0)
    }

    // 空态数据指针: 指向 T 的悬垂指针, 不分配。
    static fn empty_data() -> T* {
        return @dangling<T>();
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        if @sizeof<T> == 0 {
            return @undef<Self>();
        }
        if capacity == 0 {
            return Self(
                data=Self.empty_data(),
                cap=0
            );
        }
        let data: T* = @alloc<T>(capacity);
        Self(
            data=data,
            cap=capacity
        )
    }

    pub fn ptr() -> T* {
        self.data
    }

    pub fn capacity() -> u64 {
        if @sizeof<T> == 0 {
            // ZST 没有存储上限: 报最大容量, Vec::push 的 len == capacity() 永不成立。
            u64.max()
        } else {
            self.cap
        }
    }

    // 释放当前缓冲。空态是悬垂指针而非堆块, 只有 cap > 0 才是分配过的。
    fn release_data() {
        if self.cap > 0 {
            del self.data;
        }
    }

    pub fn grow() {
        if @sizeof<T> == 0 {
            return;
        }
        let old_cap: u64 = self.cap;
        let new_cap: u64 = if old_cap == 0 { 4 } else { old_cap * 2 };

        let new_data: T*;
        if old_cap > 0 {
            new_data = @realloc<T>(self.data, new_cap);
        } else {
            new_data = @alloc<T>(new_cap);
        }

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn reserve(len: u64, additional: u64) {
        if @sizeof<T> == 0 {
            return;
        }
        let required_cap: u64 = len + additional;
        if self.cap >= required_cap {
            return;
        }

        let current_cap: u64 = self.cap;
        let new_cap: u64 = if current_cap == 0 { 4 } else { current_cap * 2 };
        if new_cap < required_cap {
            new_cap = required_cap;
        }
        // Ensure minimum capacity
        if new_cap < 4 {
            new_cap = 4;
        }

        let new_data: T*;
        if current_cap > 0 {
            new_data = @realloc<T>(self.data, new_cap);
        } else {
            new_data = @alloc<T>(new_cap);
        }

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn shrink_to_fit(len: u64) {
        if @sizeof<T> == 0 {
            return;
        }
        if self.cap <= len {
            return;
        }

        if len == 0 {
            // 到这里 cap > len == 0, 当前缓冲一定分配过。
            self.release_data();
            self.data = Self.empty_data();
            self.cap = 0;
            return;
        }

        let new_data: T* = @realloc<T>(self.data, len);

        self.data = new_data;
        self.cap = len;
    }
}

impl<T> Drop for RawVec<T> {
    fn drop() {
        if @sizeof<T> == 0 {
            return;
        }
        self.release_data();
        self.cap = 0;
    }
}
