from std.core.range import Range;
from std.core.drop import Drop;

pub struct RawVec<T> {
    data: T*,
    cap: u64,
}

// 生命周期由使用者负责: 释放后再取用/再释放都是 UB, 这里不做任何检查。
// ZST(`@sizeof(T) == 0`)没有真实数据可处理: 分配/拷贝/释放全部用 if 拦掉,
// 只维护容量计数。
//
// 空态(`cap == 0`)的数据指针分模式取值, 但两模式满足同一组不变量:
// 非零、且 `cap == 0` 时只做指针算术/传递, 不解引用、不释放。
//   - 裸模式: 共享的悬垂哨兵(指向本文件的字面量字节), 不占堆块;
//   - 胖模式: 真实的 `dyn[0] T` 块 —— 胖指针的长度/锁字段取自块头,
//     空态也必须在可校验的存活块上, 否则 `as_slice`/指针算术会触发
//     S003/S004。
// 非零是硬要求: `Option<str>`/`Option<Slice<T>>` 这类单字段载荷用"载荷全零"
// 编码 None, 空容器(或由它派生的空 str/切片)一旦取到全零指针, `Some(空值)`
// 就会被误判成 `None`。因此空态指针不能用 `@Undef`(它可能物化成零)。
impl<T> RawVec<T> {
    static pub fn new() -> Self {
        Self.with_capacity(0)
    }

    // 空态数据指针: 裸模式是共享的非零哨兵, 胖模式是新分配的真实空块。
    static fn empty_data() -> T* {
        let data: T* = comptime if IS_RAW_MODE {
            @bitcast<T*>(@str_get_ptr(" "))
        } else {
            @alloc<T>(0)
        };
        return data;
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        if @sizeof(T) == 0 {
            return @Undef<Self>();
        }
        if capacity == 0 {
            return Self(
                data=Self.empty_data(),
                cap=0
            );
        }
        let data: T* = @alloc<T>(capacity);
        Self(
            data=data,
            cap=capacity
        )
    }

    pub fn ptr() -> T* {
        self.data
    }

    pub fn capacity() -> u64 {
        if @sizeof(T) == 0 {
            // ZST 没有存储上限: 报最大容量, Vec::push 的 len == capacity() 永不成立。
            u64.max()
        } else {
            self.cap
        }
    }

    // 释放当前缓冲。裸模式的空态是哨兵而非堆块, 只有 cap > 0 才是分配过的。
    fn release_data() {
        comptime if IS_RAW_MODE {
            if self.cap > 0 {
                del self.data;
            }
        } else {
            del self.data;
        }
    }

    pub fn grow() {
        if @sizeof(T) == 0 {
            return;
        }
        let old_cap: u64 = self.cap;
        let new_cap: u64 = if old_cap == 0 { 4 } else { old_cap * 2 };

        let new_data: T* = @alloc<T>(new_cap);

        if old_cap > 0 {
            // Since we assume the vector is full when grow() is called
            @memcpy(new_data, self.data, old_cap * @sizeof(T));
        }
        self.release_data();

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn reserve(len: u64, additional: u64) {
        if @sizeof(T) == 0 {
            return;
        }
        let required_cap: u64 = len + additional;
        if self.cap >= required_cap {
            return;
        }

        let current_cap: u64 = self.cap;
        let new_cap: u64 = if current_cap == 0 { 4 } else { current_cap * 2 };
        if new_cap < required_cap {
            new_cap = required_cap;
        }
        // Ensure minimum capacity
        if new_cap < 4 {
            new_cap = 4;
        }

        let new_data: T* = @alloc<T>(new_cap);

        // Copy valid elements
        if len > 0 {
            @memcpy(new_data, self.data, len * @sizeof(T));
        }

        self.release_data();

        self.data = new_data;
        self.cap = new_cap;
    }

    pub fn shrink_to_fit(len: u64) {
        if @sizeof(T) == 0 {
            return;
        }
        if self.cap <= len {
            return;
        }

        if len == 0 {
            // 到这里 cap > len == 0, 当前缓冲一定分配过。
            self.release_data();
            self.data = Self.empty_data();
            self.cap = 0;
            return;
        }

        let new_data: T* = @alloc<T>(len);

        // Copy valid elements
        @memcpy(new_data, self.data, len * @sizeof(T));

        del self.data;

        self.data = new_data;
        self.cap = len;
    }
}

impl<T> Drop for RawVec<T> {
    fn drop() {
        if @sizeof(T) == 0 {
            return;
        }
        self.release_data();
        self.cap = 0;
    }
}
