from std.core.vec import Vec;
from std.core.string import String;
from std.core.result import Result;
from std.core.drop import Drop;
from std.core.range import Range;
from std.ffi.c_string import c_string_bytes;

// =====================================================================
// File open flags (Linux x86_64)
// =====================================================================
// O_RDONLY   = 0
// O_WRONLY   = 1
// O_RDWR     = 2
// O_CREAT    = 64
// O_TRUNC    = 512
// O_APPEND   = 1024
// O_WRONLY | O_CREAT | O_TRUNC  = 577
// O_WRONLY | O_CREAT | O_APPEND = 1089
// O_RDWR | O_CREAT              = 66

// =====================================================================
// IoError — structured I/O error
// =====================================================================

pub enum IoErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidInput,
    UnexpectedEof,
    Interrupted,
    Other,
}

pub struct IoError {
    kind: IoErrorKind,
    msg: String,
}

impl IoError {
    pub fn kind() -> IoErrorKind {
        self.kind
    }

    pub fn msg() -> str {
        self.msg.as_str()
    }

    pub static fn new(kind: IoErrorKind, msg: str) -> Self {
        let s = String.from(&msg);
        Self(kind=kind, msg=s)
    }

    pub static fn not_found(msg: str) -> Self {
        Self.new(IoErrorKind.NotFound, msg)
    }

    pub static fn permission_denied(msg: str) -> Self {
        Self.new(IoErrorKind.PermissionDenied, msg)
    }

    pub static fn unexpected_eof() -> Self {
        let s = String.from(&"unexpected EOF");
        Self(kind=IoErrorKind.UnexpectedEof, msg=s)
    }

    pub static fn other(msg: str) -> Self {
        Self.new(IoErrorKind.Other, msg)
    }
}

// =====================================================================
// OpenMode
// =====================================================================

pub enum OpenMode {
    Read,
    Write,
    Append,
    ReadWrite,
}

// Linux write(2) accepts at most 0x7ffff000 bytes per call.
const WRITE_CHUNK_MAX: u64 = 2147479552u64;

fn write_bytes_once(fd: i32, data: u8[]) -> Result<u64, IoError> {
    if data.len() == 0 {
        return Result<u64, IoError>.Ok(val=0u64);
    }
    let count = data.len();
    if count > WRITE_CHUNK_MAX {
        count = WRITE_CHUNK_MAX;
    }
    let written = @sys_write_bytes(fd, data[0u64..count]);
    if written < 0 {
        return Result<u64, IoError>.Err(msg=IoError.other("write failed"));
    }
    return Result<u64, IoError>.Ok(val=u64(written));
}

fn write_bytes_all_fd(fd: i32, data: u8[]) -> Result<u64, IoError> {
    let offset: u64 = 0;
    while offset < data.len() {
        let count = data.len() - offset;
        if count > WRITE_CHUNK_MAX {
            count = WRITE_CHUNK_MAX;
        }
        let end = offset + count;
        let written = @sys_write_bytes(fd, data[offset..end]);
        if written <= 0 {
            return Result<u64, IoError>.Err(msg=IoError.other("write failed"));
        }
        offset += u64(written);
    }
    return Result<u64, IoError>.Ok(val=offset);
}

// =====================================================================
// File — owning file handle
// =====================================================================

pub struct File {
    fd: i32,
}

impl File {
    fn assert_open() {
        if self.fd == -2 {
            @panic("file is closed");
        }
    }

    // Open a file at `path` with the given `mode`.
    pub static fn open(path: str, mode: OpenMode) -> Result<File, IoError> {
        let flags: i32 = match mode {
            Read => 0,
            Write => 577,
            Append => 1089,
            ReadWrite => 66,
        };
        let c_path = match c_string_bytes(path) {
            Ok(bytes) => bytes,
            Err(_) => return Result<File, IoError>.Err(
                msg=IoError.new(IoErrorKind.InvalidInput, "file path contains NUL")
            ),
        };
        defer c_path.drop();
        let fd: i32 = @open(str.from_slice_unchecked(c_path.as_slice()), flags);
        if fd < 0 {
            return Result<File, IoError>.Err(msg=IoError.not_found("cannot open file"));
        }
        Result<File, IoError>.Ok(val=File(fd=fd))
    }

    // Return the raw file descriptor.
    pub fn fd() -> i32 {
        self.assert_open();
        self.fd
    }

    // Read up to buf.len() bytes into the provided buffer.
    // Returns the number of bytes read. 0 means EOF.
    pub fn read(buf: u8[]) -> Result<u64, IoError> {
        self.assert_open();
        let s: str = @sys_read(self.fd, buf);
        Result<u64, IoError>.Ok(val=s.as_slice().len())
    }

    // Read the entire remaining content into a String.
    pub fn read_to_string() -> Result<String, IoError> {
        self.assert_open();
        let result = String.new();
        let buf: u8[4096];
        @assume_init(buf);
        loop {
            let s: str = @sys_read(self.fd, buf.as_slice());
            let data = s.as_slice();
            let n = data.len();
            if n == 0 {
                break;
            }
            result.push_str(s);
        }
        Result<String, IoError>.Ok(val=result)
    }

    // Write a str to the file. Returns the number of bytes written.
    pub fn write(data: str) -> Result<u64, IoError> {
        self.assert_open();
        write_bytes_once(self.fd, data.as_slice())
    }

    // Write the entire str to the file.
    pub fn write_all(data: str) -> Result<u64, IoError> {
        self.assert_open();
        write_bytes_all_fd(self.fd, data.as_slice())
    }

    // Write bytes without interpreting them as UTF-8.
    pub fn write_bytes(data: u8[]) -> Result<u64, IoError> {
        self.assert_open();
        write_bytes_once(self.fd, data)
    }

    // Write all bytes, including arbitrary binary data.
    pub fn write_bytes_all(data: u8[]) -> Result<u64, IoError> {
        self.assert_open();
        write_bytes_all_fd(self.fd, data)
    }

    // Close the file descriptor explicitly.
    // After @close(), the File records the closed state with fd = -2.
    pub fn close() -> Result<i32, IoError> {
        self.assert_open();
        let ret: i32 = @close(self.fd);
        self.fd = -2;
        if ret < 0 {
            return Result<i32, IoError>.Err(msg=IoError.other("close failed"));
        }
        Result<i32, IoError>.Ok(val=ret)
    }
}

// ------------------------------------------------------------------
// Drop — closes the fd if still valid
// ------------------------------------------------------------------

impl Drop for File {
    pub fn drop() {
        if self.fd != -2 {
            @close(self.fd);
            self.fd = -2;
        }
    }
}

// =====================================================================
// Stdin / Stdout / Stderr — standard stream wrappers
// =====================================================================

pub struct Stdin {}

impl Stdin {
    // Read a single line, excluding the trailing newline.
    pub static fn read_line() -> Result<String, IoError> {
        let result = String.new();
        let buf: u8[256];
        @assume_init(buf);
        loop {
            let s: str = @sys_read(0, buf.as_slice());
            let data = s.as_slice();
            let n = data.len();
            if n == 0 {
                break;
            }
            // scan for newline within the chunk
            let found: i32 = -1;
            for i in 0u64..n {
                if data[i] == 10u8 {
                    found = i32(i);
                    break;
                }
            }
            if found >= 0 {
                let newline_pos = u64(found);
                if newline_pos > 0 {
                    let byte_slice = data[0u64..newline_pos];
                    let line_data = str.from(&byte_slice);
                    result.push_str(line_data);
                }
                break;
            }
            result.push_str(s);
        }
        Result<String, IoError>.Ok(val=result)
    }

    // Read up to buf.len() bytes from stdin.
    pub static fn read(buf: u8[]) -> Result<u64, IoError> {
        let s: str = @sys_read(0, buf);
        Result<u64, IoError>.Ok(val=s.as_slice().len())
    }

    // Read all of stdin into a String.
    pub static fn read_to_string() -> Result<String, IoError> {
        let result = String.new();
        let buf: u8[4096];
        @assume_init(buf);
        loop {
            let s: str = @sys_read(0, buf.as_slice());
            let data = s.as_slice();
            let n = data.len();
            if n == 0 {
                break;
            }
            result.push_str(s);
        }
        // buf is a stack array; it is never del'd (del frees heap blocks only).
        Result<String, IoError>.Ok(val=result)
    }
}

pub struct Stdout {}

impl Stdout {
    pub static fn write(data: str) -> Result<u64, IoError> {
        write_bytes_once(1, data.as_slice())
    }

    pub static fn write_all(data: str) -> Result<u64, IoError> {
        write_bytes_all_fd(1, data.as_slice())
    }

    // no-op for unbuffered output; reserved for future buffering
    pub static fn flush() {}
}

pub struct Stderr {}

impl Stderr {
    pub static fn write(data: str) -> Result<u64, IoError> {
        write_bytes_once(2, data.as_slice())
    }

    pub static fn write_all(data: str) -> Result<u64, IoError> {
        write_bytes_all_fd(2, data.as_slice())
    }

    pub static fn flush() {}
}

// =====================================================================
// Terminal I/O convenience functions
// =====================================================================

pub fn print(s: str) {
    @sys_write(1, s);
}

pub fn readline() -> String {
    Stdin.read_line().unwrap().clone()
}

// =====================================================================
// High-level file I/O convenience functions
// =====================================================================

pub fn read_file(path: str) -> String {
    let f = File.open(path, OpenMode.Read).unwrap();
    let content = f.read_to_string().unwrap();
    f.drop();
    return *content;
}

pub fn write_file(path: str, content: str) {
    let f = File.open(path, OpenMode.Write).unwrap();
    f.write_all(content).unwrap();
    f.drop();
}

pub fn append_file(path: str, content: str) {
    let f = File.open(path, OpenMode.Append).unwrap();
    f.write_all(content).unwrap();
    f.drop();
}

// =====================================================================
// Low-level open wrappers (return Result<File, IoError>)
// =====================================================================

pub fn open_rdonly(path: str) -> Result<File, IoError> {
    File.open(path, OpenMode.Read)
}

pub fn open_wronly(path: str) -> Result<File, IoError> {
    File.open(path, OpenMode.Write)
}

pub fn open_append(path: str) -> Result<File, IoError> {
    File.open(path, OpenMode.Append)
}
