from std.core.hash import Murmur3Hasher, Hash;
from std.core.slice import from_raw_parts;
from std.core.convert import From, Into;

impl Hash<Murmur3Hasher> for f64 {
    fn hash(hasher: Murmur3Hasher) {
        let val: f64 = *self;
        let ptr: u8* = bitcast<u8*>(&val);
        hasher.write(from_raw_parts(ptr, 8));
    }
}

impl From<str> for f64 {
    pub static fn from(value: str*) -> Self {
        let bytes = value.as_slice();
        let len = bytes.len();
        if len == 0 {
            panic("invalid f64: empty string");
        }

        let seen_dot: bool = false;
        let has_int_digit: bool = false;
        let has_frac_digit: bool = false;

        let int_part: u64 = 0;
        let frac_part: f64 = 0.0;
        let divisor: f64 = 1.0;

        let i: u64 = 0;
        while i < len {
            let b = bytes[i];
            if b == b'.' {
                if seen_dot {
                    panic("invalid f64: multiple dots");
                }
                seen_dot = true;
            } elif b >= b'0' && b <= b'9' {
                let digit = b - b'0';
                if ! seen_dot {
                    has_int_digit = true;
                    int_part = int_part * 10 + u64(digit);
                } else {
                    has_frac_digit = true;
                    divisor *= 10.0
                    frac_part += f64(digit) / divisor
                }
            } else {
                panic("invalid f64: contains illegal character");
            }
            i += 1
        }

        if ! seen_dot {
            panic("invalid f64: missing dot");
        }
        if ! has_int_digit || ! has_frac_digit {
            panic("invalid f64: malformed decimal");
        }

        f64(int_part) + frac_part
    }
}
