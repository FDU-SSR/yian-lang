from std.core.hash import Murmur3Hasher, Hash;
from std.core.slice import from_raw_parts;
from std.core.convert import From, Into;
from std.core.string import String;

impl u64 {
    pub fn rotate_left(n: u64) {
        let shift = n % 64;
        if shift == 0 {
            return;
        }
        let left_part = *self << shift;
        let right_part = *self >> (64 - shift);
        *self = left_part | right_part;
    }

    pub fn next_power_of_two() -> u64 {
        let n: u64 = *self;
        if n <= 1 {
            return 1;
        }

        n -= 1;
        n |= n >> 1;
        n |= n >> 2;
        n |= n >> 4;
        n |= n >> 8;
        n |= n >> 16;
        n |= n >> 32;
        n + 1
    }

    pub fn align_up(alignment: u64) {
        if alignment == 0 {
            panic("alignment must be greater than 0");
        }
        let mask = alignment - 1;
        *self = (*self + mask) & !mask;
    }

    pub fn to_string_radix(radix: u64) -> String {
        if radix < 2 || radix > 36 {
            panic("radix must be between 2 and 36");
        }
        if *self == 0 {
            return String.from("0");
        }

        let n: u64 = *self;
        let digits = String.from("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ");
        let out = String.new();
        while n > 0 {
            let digit = n % radix;
            out += char(digits.as_slice()[digit]);
            n /= radix;
        }
        out.chars().rev().collect()
    }
}

impl Hash<Murmur3Hasher> for u64 {
    fn hash(hasher: Murmur3Hasher) {
        let val: u64 = *self;
        let ptr: u8* = bitcast<u8*>(&val);
        hasher.write(from_raw_parts(ptr, 8));
    }
}

impl From<str> for u64 {
    pub static fn from(value: str) -> Self {
        let bytes = value.as_slice();
        let len = bytes.len();
        if len == 0 {
            panic("invalid u64: empty string");
        }

        let out: u64 = 0;
        let max_u64: u64 = 18446744073709551615u64;
        let i: u64 = 0;
        while i < len {
            let b = bytes[i];
            if b < b'0' || b > b'9' {
                panic("invalid u64: contains non-digit");
            }

            let digit = u64(b - b'0');
            if out > (max_u64 - digit) / 10 {
                panic("invalid u64: overflow");
            }
            out = out * 10 + digit;
            i += 1
        }

        out
    }
}
