from std.collections.hash_map import HashMap, HashMapKeyIter;
from std.core.option import Option;
from std.core.iter import Iterator, IntoIterator;
from std.core.hash import Murmur3BuildHasher, Murmur3Hasher;
from std.core.drop import Drop;

pub struct HashSet<T> {
    map: HashMap<T, void>,
}

impl<T> HashSet<T> {
    static pub fn new() -> Self {
        Self(map = HashMap<T, void>.new())
    }

    static pub fn with_capacity(capacity: u64) -> Self {
        Self(map = HashMap<T, void>.with_capacity(capacity))
    }

    static pub fn with_capacity_and_hasher(capacity: u64, builder: Murmur3BuildHasher) -> Self {
        Self(map = HashMap<T, void>.with_capacity_and_hasher(capacity, builder))
    }

    pub fn insert(value: T) -> bool {
        if self.map.contains(&value) {
            value.drop();
            return false;
        }
        self.map.insert(value, void.new());
        true
    }

    pub fn contains(value: T*) -> bool {
        self.map.contains(value)
    }

    pub fn remove(value: T*) -> bool {
        self.map.remove(value)
    }

    pub fn len() -> u64 {
        self.map.len()
    }

    pub fn is_empty() -> bool {
        self.map.is_empty()
    }

    pub fn clear() {
        self.map.clear()
    }
}

impl<T> Drop for HashSet<T> {
    pub fn drop() {
        self.map.drop();
    }
}

pub typedef HashSetIter<T> = HashMapKeyIter<T, void>;

impl<T> IntoIterator<HashSetIter<T>> for HashSet<T> {
    pub fn into_iter() -> HashSetIter<T> {
        self.map.into_iter()
    }
}
