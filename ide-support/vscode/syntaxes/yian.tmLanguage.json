{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "YIAN",
    "scopeName": "source.yian",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#fstrings"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#chars"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.yian",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.yian",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "name": "string.interpolated.yian",
                    "begin": "f\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.yian"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.yian"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#fstring-escape"
                        },
                        {
                            "include": "#fstring-expression"
                        }
                    ]
                }
            ]
        },
        "fstring-escape": {
            "patterns": [
                {
                    "name": "constant.character.escape.yian",
                    "match": "\\\\[{}]"
                },
                {
                    "name": "constant.character.escape.yian",
                    "match": "\\\\."
                }
            ]
        },
        "fstring-expression": {
            "begin": "\\{",
            "end": "\\}",
            "name": "meta.embedded.expression.yian",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.embedded.begin.yian"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.embedded.end.yian"
                }
            },
            "patterns": [
                {
                    "include": "#fstring-expression"
                },
                {
                    "include": "$self"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.yian",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.yian"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.yian"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.yian",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "chars": {
            "patterns": [
                {
                    "name": "string.quoted.single.yian",
                    "match": "\\bb'(?:[^'\\\\]|\\\\.)*'"
                },
                {
                    "name": "string.quoted.single.yian",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.yian"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.yian"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.yian",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.yian",
                    "match": "\\b(?:[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*|0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\.[0-9a-fA-F](?:_?[0-9a-fA-F])*[pP][+-]?[0-9](?:_?[0-9])*)(?:f(?:16|32|64))?\\b"
                },
                {
                    "name": "constant.numeric.integer.yian",
                    "match": "\\b(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*|[0-9](?:_?[0-9])*)(?:[iu](?:8|16|32|64))?\\b"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "entity.other.attribute-name.yian",
                    "match": "@[A-Z][A-Za-z0-9_]*"
                },
                {
                    "name": "support.function.builtin.yian",
                    "match": "@[a-z_][A-Za-z0-9_]*"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.operator.typeof.yian",
                    "match": "\\btypeof\\b"
                },
                {
                    "name": "keyword.control.import.yian",
                    "match": "\\b(?:import|from|as)\\b"
                },
                {
                    "name": "keyword.control.yian",
                    "match": "\\b(?:if|elif|else|match|for|while|loop|in|break|continue|return|defer|assert|del)\\b"
                },
                {
                    "name": "keyword.declaration.yian",
                    "match": "\\b(?:let|typedef|struct|enum|trait|impl|fn|dyn|pub|static|const|comptime|inline|intrinsic)\\b"
                },
                {
                    "name": "constant.language.boolean.yian",
                    "match": "\\b(?:true|false)\\b"
                },
                {
                    "name": "constant.language.configuration.yian",
                    "match": "\\bIS_RAW_MODE\\b"
                },
                {
                    "name": "variable.language.self.yian",
                    "match": "\\bself\\b"
                },
                {
                    "name": "variable.language.wildcard.yian",
                    "match": "\\b_\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.yian",
                    "match": "\\b(?:void|bool|char|str|i8|i16|i32|i64|u8|u16|u32|u64|f16|f32|f64|int|uint|float)\\b"
                },
                {
                    "name": "entity.name.type.yian",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "meta.function.yian",
                    "match": "\\bfn\\s+[A-Za-z_][A-Za-z0-9_]*",
                    "captures": {
                        "0": {
                            "name": "entity.name.function.yian"
                        }
                    }
                },
                {
                    "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?:<[^<>()]*>\\s*)?\\(",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.yian"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.yian",
                    "match": "(?:<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\^=|&=|\\|=|->|=>|\\.\\.|<<|>>|[+\\-*/%^&|~!=<>])"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.yian",
                    "match": "[,;]"
                },
                {
                    "name": "punctuation.section.yian",
                    "match": "[(){}\\[\\]]"
                },
                {
                    "name": "punctuation.accessor.yian",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.type-annotation.yian",
                    "match": ":"
                }
            ]
        }
    }
}
