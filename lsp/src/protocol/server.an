from std.core.drop import Drop;
from std.core.fs import append;
from std.core.io import IoError, IoErrorKind, NonblockingGuard, Read, Stderr, Stdin, Stdout, Write, eprint, eprintln;
from std.core.path import Path;
from std.core.process import Command, Child, SpawnOptions, StdioMode, executable_path;
from std.core.time import Instant, monotonic_now;
from std.core.poller import PollEvent, PollInterests, Poller, PollSource, PollToken;
from json.value import Value, Number, Object;
from json.write import stringify;
from jsonrpc.frame import FrameDecoder, FrameError, WriteQueue;
from jsonrpc.message import Message, ProtocolError, RequestId, RpcError, encode, parse;
from lsp.config import Config;
from lsp.workspace.documents import Documents;
from lsp.workspace.units import UnitRevisions, WorkspaceUnits;
from lsp_protocol.sync import DidOpenParams, DidChangeParams, DidSaveParams, DidCloseParams;
from lsp_protocol.sync import DidChangeWatchedFilesParams, FileChangeType;
from lsp_protocol.uri import path_to_uri, uri_to_path;

enum PendingKind { Initialize, Synchronize, ClientRequest }

struct PendingRequest {
    internal_id: u64,
    revision: u64,
    topology_revision: u64,
    unit_key: String,
    unit_revision: u64,
    kind: PendingKind,
    client_id: Option<RequestId>,
}

struct DeferredRequest {
    id: RequestId,
    method: String,
    params: Option<Value>,
    unit_key: String,
    unit_revision: u64,
    route_provisional: bool,
}

struct PublishedDiagnostic {
    uri: String,
    unit_key: String,
}

impl Drop for PublishedDiagnostic {
    pub fn drop() {
        self.uri.drop();
        self.unit_key.drop();
    }
}

impl Drop for DeferredRequest {
    pub fn drop() {
        self.id.drop();
        self.method.drop();
        self.unit_key.drop();
        match &self.params { Some(value) => value.drop(), None => {}, }
    }
}

impl Drop for PendingRequest {
    pub fn drop() {
        match &self.client_id { Some(value) => value.drop(), None => {}, }
        self.unit_key.drop();
    }
}

struct ServerState {
    child: Child,
    poller: Poller,
    client_decoder: FrameDecoder,
    worker_decoder: FrameDecoder,
    client_output: WriteQueue,
    worker_output: WriteQueue,
    client_input_token: PollToken,
    worker_output_token: PollToken,
    worker_error_token: PollToken,
    client_output_token: Option<PollToken>,
    worker_input_token: Option<PollToken>,
    pending: Vec<PendingRequest>,
    deferred: Vec<DeferredRequest>,
    documents: Documents,
    published_diagnostics: Vec<PublishedDiagnostic>,
    workspace_units: WorkspaceUnits,
    unit_revisions: UnitRevisions,
    revision: u64,
    topology_revision: u64,
    next_internal_id: u64,
    next_server_request_id: i64,
    initialized: bool,
    supports_watchers: bool,
    supports_relative_watchers: bool,
    watchers_registered: bool,
    watchers_rejected: bool,
    watcher_pending_id: Option<i64>,
    watcher_bases: Vec<String>,
    watcher_patterns: Vec<String>,
    supports_semantic_refresh: bool,
    supports_inlay_hint_refresh: bool,
    worker_ready: bool,
    worker_initialized: bool,
    sync_in_flight: bool,
    topology_pending: bool,
    topology_retry_blocked: bool,
    shutdown_received: bool,
    exiting: bool,
    input_closed: bool,
    startup_started_ns: i64,
    exit_status: i32,
    workspace_root: Option<String>,
    trace_file: Option<String>,
}

fn process_error(message: str) -> IoError { IoError.other(message) }

fn empty_array() -> Value { Value.Array(Vec<Value>.new()) }
fn empty_object() -> Value { Value.Object(Object.new()) }

fn release_strings(values: Vec<String>&) {
    for value in *values { value.drop(); }
    values.drop();
}

fn byte_buffer(length: u64) -> Vec<u8> {
    let result = Vec<u8>.with_capacity(length);
    for _ in 0u64..length { result.push(0u8); }
    result
}

fn put(object: Object&, key: str, value: Value) {
    match object.insert(key, value) {
        Some(previous) => previous.drop(),
        None => {},
    }
}

fn field_string(object: Object&, key: str) -> Option<str> {
    match object.get(key) {
        Some(value) => value.as_string(),
        None => Option<str>.None,
    }
}

fn field_u64(object: Object&, key: str) -> Option<u64> {
    match object.get(key) {
        Some(value) => match value {
            Number(number) => match number {
                Unsigned(number) => Option<u64>.Some(*number),
                Signed(number) if *number >= 0i64 => Option<u64>.Some(u64(*number)),
                _ => Option<u64>.None,
            },
            _ => Option<u64>.None,
        },
        None => Option<u64>.None,
    }
}

fn make_frame(message: Message&) -> Result<Vec<u8>, IoError> {
    let json = match encode(message) {
        Ok(value) => value,
        Err(_) => return Result<Vec<u8>, IoError>.Err(process_error("could not encode JSON-RPC message")),
    };
    defer json.drop();
    let body = Vec<u8>.with_capacity(json.as_slice().len());
    body.extend_from_slice(json.as_slice());
    Result<Vec<u8>, IoError>.Ok(body)
}

fn frame_text(body: Vec<u8>) -> Result<String, IoError> {
    defer body.drop();
    match str.from_slice(body.as_slice()) {
        Some(value) => Result<String, IoError>.Ok(String.from(&value)),
        None => Result<String, IoError>.Err(IoError.new(IoErrorKind.InvalidData, "LSP frame is not UTF-8")),
    }
}

fn worker_command(config: Config&) -> Result<Child, IoError> {
    let path = match executable_path() {
        Ok(value) => value,
        Err(problem) => return Result<Child, IoError>.Err(problem),
    };
    defer path.drop();

    let command = Command.new(path.as_str());
    defer command.drop();
    command.arg("--worker");
    match &config.compiler_root {
        Some(root) => { command.arg("--compiler-root"); command.arg(root.as_str()); },
        None => {},
    }
    if config.raw_pointers { command.arg("--raw-pointers"); }
    command.arg("--log-level");
    command.arg(config.log_level.as_str());
    match &config.log_file {
        Some(path) => { command.arg("--log-file"); command.arg(path.as_str()); },
        None => {},
    }

    let options = SpawnOptions.new();
    options.stdin(StdioMode.Piped);
    options.stdout(StdioMode.Piped);
    options.stderr(StdioMode.Piped);
    command.spawn(options)
}

fn request_id_matches_json(id: RequestId&, value: Value&) -> bool {
    match id {
        RequestId.Null => match value { Value.Null => true, _ => false },
        RequestId.Signed(expected) => match value {
            Value.Number(number) => match number {
                Number.Signed(actual) => *expected == *actual,
                Number.Unsigned(actual) if *actual <= 9223372036854775807u64 => *expected == i64(*actual),
                _ => false,
            },
            _ => false,
        },
        RequestId.Unsigned(expected) => match value {
            Value.Number(number) => match number {
                Number.Unsigned(actual) => *expected == *actual,
                Number.Signed(actual) if *actual >= 0i64 => *expected == u64(*actual),
                _ => false,
            },
            _ => false,
        },
        RequestId.String(expected) => match value {
            Value.String(actual) => expected.as_str() == actual.as_str(),
            _ => false,
        },
    }
}

impl ServerState {
    static fn new(child: Child, input: NonblockingGuard&, output: NonblockingGuard&,
        config: Config&)
    -> Result<Self, IoError> {
        let poller = Poller.new();
        let client_source = PollSource.from_nonblocking(input)?;
        let client_input_token = poller.register(client_source, PollInterests.readable())?;
        let worker_stdout = match child.stdout() {
            Some(value) => value,
            None => return Result<Self, IoError>.Err(process_error("worker stdout pipe is missing")),
        };
        let worker_source = PollSource.from_reader(worker_stdout)?;
        let worker_output_token = poller.register(worker_source, PollInterests.readable())?;
        let worker_stderr = match child.stderr() {
            Some(value) => value,
            None => return Result<Self, IoError>.Err(process_error("worker stderr pipe is missing")),
        };
        let error_source = PollSource.from_reader(worker_stderr)?;
        let worker_error_token = poller.register(error_source, PollInterests.readable())?;
        let started = monotonic_now()?.nanoseconds();

        let state = Self(
            child=child,
            poller=poller,
            client_decoder=FrameDecoder.new(),
            worker_decoder=FrameDecoder.new(),
            client_output=WriteQueue.new(),
            worker_output=WriteQueue.new(),
            client_input_token=client_input_token,
            worker_output_token=worker_output_token,
            worker_error_token=worker_error_token,
            client_output_token=Option<PollToken>.None,
            worker_input_token=Option<PollToken>.None,
            pending=Vec<PendingRequest>.new(),
            deferred=Vec<DeferredRequest>.new(),
            documents=Documents.new(),
            published_diagnostics=Vec<PublishedDiagnostic>.new(),
            workspace_units=WorkspaceUnits.new(),
            unit_revisions=UnitRevisions.new(),
            revision=0u64,
            topology_revision=0u64,
            next_internal_id=1u64,
            next_server_request_id=1i64,
            initialized=false,
            supports_watchers=false,
            supports_relative_watchers=false,
            watchers_registered=false,
            watchers_rejected=false,
            watcher_pending_id=Option<i64>.None,
            watcher_bases=Vec<String>.new(),
            watcher_patterns=Vec<String>.new(),
            supports_semantic_refresh=false,
            supports_inlay_hint_refresh=false,
            worker_ready=false,
            worker_initialized=false,
            sync_in_flight=false,
            topology_pending=true,
            topology_retry_blocked=false,
            shutdown_received=false,
            exiting=false,
            input_closed=false,
            startup_started_ns=started,
            exit_status=1i32,
            workspace_root=Option<String>.None,
            trace_file=match &config.trace_file {
                Some(path) => Option<String>.Some(String.from(&path.as_str())),
                None => Option<String>.None,
            },
        );
        let _ = output.fd();
        state.queue_internal("worker/initialize", empty_object(), PendingKind.Initialize,
            0u64, 0u64, "", 0u64)?;
        Result<Self, IoError>.Ok(state)
    }

    fn queue_client(message: Message) -> Result<(), IoError> {
        let frame = make_frame(&message)?;
        defer { message.drop(); frame.drop(); };
        match self.client_output.enqueue(frame.as_slice()) {
            Ok(_) => Result<(), IoError>.Ok(()),
            Err(_) => Result<(), IoError>.Err(process_error("LSP output queue limit exceeded")),
        }
    }

    fn success(id: RequestId, value: Value) -> Result<(), IoError> {
        self.queue_client(Message.SuccessResponse(id, value))
    }

    fn error(id: RequestId, code: i64, text: str) -> Result<(), IoError> {
        let detail = RpcError(code=code, message=String.from(&text), data=Option<Value>.None);
        self.queue_client(Message.ErrorResponse(id, detail))
    }

    fn notification(method: str, params: Value) -> Result<(), IoError> {
        let name = String.from(&method);
        self.queue_client(Message.Notification(name, Option<Value>.Some(params)))
    }

    static fn append_watcher_pattern(bases: Vec<String>&, patterns: Vec<String>&,
        base_path: str, pattern: str) -> Result<(), IoError> {
        let base_uri = match path_to_uri(base_path) {
            Ok(value) => value,
            Err(problem) => { let _ = problem.kind; return Result<(), IoError>.Err(
                process_error("could not encode a watched input root")); },
        };
        let index = 0u64;
        while index < bases.len() {
            if bases[index].as_str() == base_uri.as_str() &&
                patterns[index].as_str() == pattern {
                base_uri.drop();
                return Result<(), IoError>.Ok(());
            }
            index += 1u64;
        }
        bases.push(base_uri);
        patterns.push(String.from(&pattern));
        Result<(), IoError>.Ok(())
    }

    static fn append_legacy_watcher(bases: Vec<String>&, patterns: Vec<String>&, pattern: str) {
        let index = 0u64;
        while index < patterns.len() {
            if bases[index].as_str().as_slice().len() == 0u64 &&
                patterns[index].as_str() == pattern { return; }
            index += 1u64;
        }
        bases.push(String.new());
        patterns.push(String.from(&pattern));
    }

    fn send_watcher_unregistration() -> Result<(), IoError> {
        if self.next_server_request_id >= 9007199254740991i64 {
            return Result<(), IoError>.Err(process_error("server request ID space exhausted"));
        }
        let request_id = self.next_server_request_id;
        self.next_server_request_id += 1i64;
        let registration = Object.new();
        put(&registration, "id", Value.String(String.from(&"yian-watched-files")));
        put(&registration, "method", Value.String(String.from(&"workspace/didChangeWatchedFiles")));
        let registrations = Vec<Value>.new();
        registrations.push(Value.Object(registration));
        let params = Object.new();
        put(&params, "unregisterations", Value.Array(registrations));
        self.queue_client(Message.Request(RequestId.Signed(request_id),
            String.from(&"client/unregisterCapability"), Option<Value>.Some(Value.Object(params))))
    }

    fn register_file_watchers() -> Result<(), IoError> {
        if !self.supports_watchers { return Result<(), IoError>.Ok(()); }
        let bases = Vec<String>.new();
        let patterns = Vec<String>.new();
        if self.supports_relative_watchers {
            if !self.workspace_units.routes_known() {
                if let Some(root) = &self.workspace_root {
                    Self.append_watcher_pattern(&bases, &patterns, root.as_str(), "**/*.an")?;
                    Self.append_watcher_pattern(&bases, &patterns, root.as_str(), "**/package.anx")?;
                }
            } else {
                let roots = self.workspace_units.primary_source_roots();
                for root in roots {
                    Self.append_watcher_pattern(&bases, &patterns, root.as_str(), "**/*.an")?;
                    root.drop();
                }
                roots.drop();
                let manifests = self.workspace_units.primary_manifest_paths();
                for manifest in manifests {
                    let path = Path.new(manifest.as_str());
                    match path.parent() {
                        Some(parent) => {
                            Self.append_watcher_pattern(&bases, &patterns, parent.as_str(), "package.anx")?;
                        },
                        None => {},
                    }
                    manifest.drop();
                }
                manifests.drop();
                let standard_library = self.workspace_units.standard_library_path();
                if standard_library.as_slice().len() != 0u64 {
                    Self.append_watcher_pattern(&bases, &patterns,
                        standard_library.as_str(), "**/*.an")?;
                }
                standard_library.drop();
                let index = 0u64;
                while index < self.documents.len() {
                    let document = self.documents.at(index);
                    let key = self.workspace_units.key_for_uri(document.uri.as_str());
                    if key.as_str().starts_with("file:") {
                        match uri_to_path(document.uri.as_str()) {
                            Ok(path) => {
                                let source = Path.new(path.as_str());
                                match source.parent() {
                                    Some(parent) => {
                                        Self.append_watcher_pattern(&bases, &patterns,
                                            parent.as_str(), "**/*.an")?;
                                    },
                                    None => {},
                                }
                                path.drop();
                            },
                            Err(problem) => { let _ = problem.kind; },
                        }
                    }
                    key.drop();
                    index += 1u64;
                }
            }
        } elif let Some(root) = &self.workspace_root {
            Self.append_legacy_watcher(&bases, &patterns, "**/*.an");
            Self.append_legacy_watcher(&bases, &patterns, "**/package.anx");
            let _ = root;
        }

        let same = bases.len() == self.watcher_bases.len() &&
            patterns.len() == self.watcher_patterns.len();
        let index = 0u64;
        while same && index < bases.len() {
            if bases[index].as_str() != self.watcher_bases[index].as_str() ||
                patterns[index].as_str() != self.watcher_patterns[index].as_str() {
                same = false;
            }
            index += 1u64;
        }
        if same {
            release_strings(&bases);
            release_strings(&patterns);
            return Result<(), IoError>.Ok(());
        }

        let had_registration = self.watchers_registered || self.watcher_pending_id.is_some();
        match self.watcher_pending_id.take() { Some(_) => {}, None => {}, }
        if had_registration { self.send_watcher_unregistration()?; }
        release_strings(&self.watcher_bases);
        release_strings(&self.watcher_patterns);
        self.watcher_bases = bases;
        self.watcher_patterns = patterns;
        self.watchers_registered = false;
        self.watchers_rejected = false;
        if self.watcher_patterns.len() == 0u64 { return Result<(), IoError>.Ok(()); }

        if !self.supports_relative_watchers {
            eprintln("yian-lsp: client lacks relative watcher support; external input roots are not monitored");
        }
        let registrations_array = Vec<Value>.new();
        let watcher_index = 0u64;
        while watcher_index < self.watcher_patterns.len() {
            let watcher = Object.new();
            if self.supports_relative_watchers {
                let glob = Object.new();
                put(&glob, "baseUri", Value.String(String.from(&self.watcher_bases[watcher_index].as_str())));
                put(&glob, "pattern", Value.String(String.from(&self.watcher_patterns[watcher_index].as_str())));
                put(&watcher, "globPattern", Value.Object(glob));
            } else {
                put(&watcher, "globPattern", Value.String(String.from(&self.watcher_patterns[watcher_index].as_str())));
            }
            put(&watcher, "kind", Value.Number(Number.Unsigned(7u64)));
            registrations_array.push(Value.Object(watcher));
            watcher_index += 1u64;
        }
        let options = Object.new();
        put(&options, "watchers", Value.Array(registrations_array));
        let registration = Object.new();
        put(&registration, "id", Value.String(String.from(&"yian-watched-files")));
        put(&registration, "method", Value.String(String.from(&"workspace/didChangeWatchedFiles")));
        put(&registration, "registerOptions", Value.Object(options));
        let registrations = Vec<Value>.new();
        registrations.push(Value.Object(registration));
        let params = Object.new();
        put(&params, "registrations", Value.Array(registrations));
        if self.next_server_request_id >= 9007199254740991i64 {
            return Result<(), IoError>.Err(process_error("server request ID space exhausted"));
        }
        let request_id = self.next_server_request_id;
        self.next_server_request_id += 1i64;
        self.watcher_pending_id = Option<i64>.Some(request_id);
        self.queue_client(Message.Request(RequestId.Signed(request_id),
            String.from(&"client/registerCapability"), Option<Value>.Some(Value.Object(params))))
    }

    static fn request_document_uri(params: Option<Value&>) -> Option<String> {
        let value = match params {
            Some(value) => value,
            None => return Option<String>.None,
        };
        let object = match value.as_object() {
            Some(value) => value,
            None => return Option<String>.None,
        };
        let document = match object.get("textDocument") {
            Some(value) => match value.as_object() {
                Some(value) => value,
                None => return Option<String>.None,
            },
            None => return Option<String>.None,
        };
        match document.get("uri") {
            Some(value) => match value.as_string() {
                Some(uri) => Option<String>.Some(String.from(&uri)),
                None => Option<String>.None,
            },
            None => Option<String>.None,
        }
    }

    fn unit_key_for_params(params: Option<Value&>) -> Option<String> {
        match Self.request_document_uri(params) {
            Some(uri) => {
                let key = self.workspace_units.key_for_uri(uri.as_str());
                uri.drop();
                Option<String>.Some(key)
            },
            None => Option<String>.None,
        }
    }

    fn send_refresh(method: str, supported: bool) -> Result<(), IoError> {
        if !supported { return Result<(), IoError>.Ok(()); }
        // Keep JSON-RPC IDs within JavaScript's exactly representable integer range.
        let request_id = self.next_server_request_id;
        if request_id >= 9007199254740991i64 {
            return Result<(), IoError>.Err(process_error("server request ID space exhausted"));
        }
        self.next_server_request_id += 1i64;
        self.queue_client(Message.Request(RequestId.Signed(request_id), String.from(&method),
            Option<Value>.Some(Value.Null)))
    }

    fn send_semantic_refresh() -> Result<(), IoError> {
        self.send_refresh("workspace/semanticTokens/refresh", self.supports_semantic_refresh)
    }

    fn send_inlay_hint_refresh() -> Result<(), IoError> {
        self.send_refresh("workspace/inlayHint/refresh", self.supports_inlay_hint_refresh)
    }

    static fn client_supports_watchers(params: Option<Value&>) -> bool {
        let root = match params { Some(value) => value.as_object(), None => Option<Object&>.None };
        let capabilities = match root {
            Some(value) => match value.get("capabilities") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let workspace = match capabilities {
            Some(value) => match value.get("workspace") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let watched = match workspace {
            Some(value) => match value.get("didChangeWatchedFiles") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        match watched {
            Some(value) => match value.get("dynamicRegistration") {
                Some(Boolean(supported)) => *supported,
                _ => false,
            },
            None => false,
        }
    }

    static fn client_supports_relative_watchers(params: Option<Value&>) -> bool {
        let root = match params { Some(value) => value.as_object(), None => Option<Object&>.None };
        let capabilities = match root {
            Some(value) => match value.get("capabilities") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let workspace = match capabilities {
            Some(value) => match value.get("workspace") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let watched = match workspace {
            Some(value) => match value.get("didChangeWatchedFiles") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        match watched {
            Some(value) => match value.get("relativePatternSupport") {
                Some(Boolean(supported)) => *supported,
                _ => false,
            },
            None => false,
        }
    }

    static fn client_supports_semantic_refresh(params: Option<Value&>) -> bool {
        let root = match params { Some(value) => value.as_object(), None => Option<Object&>.None };
        let capabilities = match root {
            Some(value) => match value.get("capabilities") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let workspace = match capabilities {
            Some(value) => match value.get("workspace") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let semantic_tokens = match workspace {
            Some(value) => match value.get("semanticTokens") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        match semantic_tokens {
            Some(value) => match value.get("refreshSupport") {
                Some(Boolean(supported)) => *supported,
                _ => false,
            },
            None => false,
        }
    }

    static fn client_supports_inlay_hint_refresh(params: Option<Value&>) -> bool {
        let root = match params { Some(value) => value.as_object(), None => Option<Object&>.None };
        let capabilities = match root {
            Some(value) => match value.get("capabilities") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let workspace = match capabilities {
            Some(value) => match value.get("workspace") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        let inlay_hint = match workspace {
            Some(value) => match value.get("inlayHint") {
                Some(value) => value.as_object(),
                None => Option<Object&>.None,
            },
            None => Option<Object&>.None,
        };
        match inlay_hint {
            Some(value) => match value.get("refreshSupport") {
                Some(Boolean(supported)) => *supported,
                _ => false,
            },
            None => false,
        }
    }

    static fn workspace_root(params: Option<Value&>) -> Option<String> {
        let object = match params {
            Some(value) => match value.as_object() {
                Some(object) => object,
                None => return Option<String>.None,
            },
            None => return Option<String>.None,
        };

        let root = Option<String>.None;
        match object.get("workspaceFolders") {
            Some(value) => match value.as_array() {
                Some(folders) => {
                    for folder in *folders {
                        let folder_object = match folder.as_object() {
                            Some(value) => value,
                            None => continue,
                        };
                        let uri = match folder_object.get("uri") {
                            Some(value) => match value.as_string() {
                                Some(uri) => uri,
                                None => continue,
                            },
                            None => continue,
                        };
                        match uri_to_path(uri) {
                            Ok(path) => { root = Option<String>.Some(path); break; },
                            Err(problem) => { let _ = problem.kind; },
                        }
                    }
                },
                None => {},
            },
            None => {},
        }
        if root.is_some() { return root; }

        match object.get("rootUri") {
            Some(value) => match value.as_string() {
                Some(uri) => return match uri_to_path(uri) {
                    Ok(path) => Option<String>.Some(path),
                    Err(problem) => { let _ = problem.kind; Option<String>.None },
                },
                None => match value {
                    Null => {},
                    _ => return Option<String>.None,
                },
            },
            None => {},
        }

        match object.get("rootPath") {
            Some(value) => match value.as_string() {
                Some(path) if path.as_slice().len() != 0u64 => Option<String>.Some(String.from(&path)),
                _ => Option<String>.None,
            },
            None => Option<String>.None,
        }
    }

    static fn manifest_uri(uri: str) -> bool {
        match uri_to_path(uri) {
            Ok(path) => {
                let result = path.as_str().ends_with("/package.anx") || path.as_str() == "package.anx";
                path.drop();
                result
            },
            Err(problem) => { let _ = problem.kind; false },
        }
    }

    static fn source_path_uri(uri: str) -> bool {
        match uri_to_path(uri) {
            Ok(path) => {
                let result = path.as_str().ends_with(".an");
                path.drop();
                result
            },
            Err(problem) => { let _ = problem.kind; false },
        }
    }

    fn queue_internal(method: str, params: Value, kind: PendingKind, revision: u64,
        topology_revision: u64, unit_key: str, unit_revision: u64)
    -> Result<(), IoError> {
        if self.pending.len() >= 128u64 {
            return Result<(), IoError>.Err(process_error("worker request limit exceeded"));
        }
        let internal_id = self.next_internal_id;
        self.next_internal_id += 1u64;
        let name = String.from(&method);
        let message = Message.Request(
            RequestId.Unsigned(internal_id),
            name,
            Option<Value>.Some(params),
        );
        let frame = make_frame(&message)?;
        defer { message.drop(); frame.drop(); };
        match self.worker_output.enqueue(frame.as_slice()) {
            Ok(_) => {},
            Err(_) => return Result<(), IoError>.Err(process_error("worker output queue limit exceeded")),
        }
        self.pending.push(PendingRequest(
            internal_id=internal_id,
            revision=revision,
            topology_revision=topology_revision,
            unit_key=String.from(&unit_key),
            unit_revision=unit_revision,
            kind=kind,
            client_id=Option<RequestId>.None,
            ));
        Result<(), IoError>.Ok(())
    }

    fn ensure_unit_revisions() {
        self.unit_revisions.ensure("primary");
        let index = 0u64;
        while index < self.documents.len() {
            let uri = self.documents.at(index).uri.as_str();
            let key = self.workspace_units.key_for_uri(uri);
            self.unit_revisions.ensure(key.as_str());
            key.drop();
            if !self.workspace_units.routes_known() {
                let file_key = self.workspace_units.key_for_file_uri(uri);
                self.unit_revisions.ensure(file_key.as_str());
                file_key.drop();
            }
            index += 1u64;
        }
    }

    fn ensure_topology_candidate_revisions() {
        let index = 0u64;
        while index < self.documents.len() {
            let uri = self.documents.at(index).uri.as_str();
            let current_key = self.workspace_units.key_for_uri(uri);
            let file_key = self.workspace_units.key_for_file_uri(uri);
            self.unit_revisions.ensure(current_key.as_str());
            self.unit_revisions.ensure(file_key.as_str());
            current_key.drop();
            file_key.drop();
            index += 1u64;
        }
    }

    fn document_json(index: u64) -> Value {
        let document = self.documents.at(index);
        let item = Object.new();
        put(&item, "uri", Value.String(document.uri.clone()));
        put(&item, "text", Value.String(document.text.clone()));
        match document.version {
            Some(version) => put(&item, "version", Value.Number(Number.Signed(version))),
            None => put(&item, "version", Value.Null),
        }
        Value.Object(item)
    }

    fn sync_documents(unit_key: str, refresh_all: bool) -> Value {
        if refresh_all { return self.documents.to_json(); }
        let result = Vec<Value>.new();
        let index = 0u64;
        while index < self.documents.len() {
            let document = self.documents.at(index);
            let key = self.workspace_units.key_for_uri(document.uri.as_str());
            if key.as_str() == unit_key { result.push(self.document_json(index)); }
            key.drop();
            index += 1u64;
        }
        Value.Array(result)
    }

    fn trace_sync_queued(unit_key: str, unit_revision: u64, refresh_all: bool) {
        let path = match &self.trace_file {
            Some(value) => value.as_str(),
            None => { return; },
        };
        let timestamp = match monotonic_now() {
            Ok(value) => value.nanoseconds(),
            Err(problem) => { problem.drop(); return; },
        };
        let fields = Object.new();
        fields.insert("event", Value.String(String.from(&"server_sync_queued")));
        fields.insert("operation", Value.String(String.from(&"sync")));
        fields.insert("monotonic_ns", Value.Number(Number.Signed(timestamp)));
        fields.insert("revision", Value.Number(Number.Unsigned(self.revision)));
        fields.insert("topology_revision", Value.Number(Number.Unsigned(self.topology_revision)));
        fields.insert("unit_key", Value.String(String.from(&unit_key)));
        fields.insert("unit_revision", Value.Number(Number.Unsigned(unit_revision)));
        fields.insert("refresh_all", Value.Boolean(refresh_all));
        fields.insert("worker_request_id", Value.Number(Number.Unsigned(self.next_internal_id - 1u64)));
        let value = Value.Object(fields);
        let encoded = match stringify(&value) {
            Ok(text) => text,
            Err(_) => { value.drop(); return; },
        };
        value.drop();
        let line = String.from(&encoded.as_str());
        line.push('\n');
        encoded.drop();
        match append(path, line.as_slice()) {
            Ok(_) => {},
            Err(problem) => { problem.drop(); },
        }
        line.drop();
    }

    fn queue_sync(unit_key: str) -> Result<(), IoError> {
        if self.sync_in_flight { return Result<(), IoError>.Ok(()); }
        self.ensure_unit_revisions();
        // Until the first routing result, the worker's topology revision is not
        // authoritative for a partial unit payload. Always send the complete
        // document set in that window.
        let refresh_all = self.topology_pending || !self.workspace_units.routes_known();
        if refresh_all { self.ensure_topology_candidate_revisions(); }
        let unit_revision = self.unit_revisions.revision(unit_key);
        let payload = Object.new();
        put(&payload, "revision", Value.Number(Number.Unsigned(self.revision)));
        put(&payload, "topology_revision", Value.Number(Number.Unsigned(self.topology_revision)));
        put(&payload, "unit_key", Value.String(String.from(&unit_key)));
        put(&payload, "unit_revision", Value.Number(Number.Unsigned(unit_revision)));
        put(&payload, "refresh_all", Value.Boolean(refresh_all));
        match &self.workspace_root {
            Some(value) => put(&payload, "workspace_root", Value.String(value.clone())),
            None => put(&payload, "workspace_root", Value.Null),
        }
        put(&payload, "documents", self.sync_documents(unit_key, refresh_all));
        let unit_revisions = Object.new();
        if refresh_all {
            let index = 0u64;
            while index < self.unit_revisions.count() {
                put(&unit_revisions, self.unit_revisions.key_at(index),
                    Value.Number(Number.Unsigned(self.unit_revisions.revision_at(index))));
                index += 1u64;
            }
        } else {
            put(&unit_revisions, unit_key, Value.Number(Number.Unsigned(unit_revision)));
        }
        put(&payload, "unit_revisions", Value.Object(unit_revisions));
        match self.queue_internal("worker/sync", Value.Object(payload), PendingKind.Synchronize,
            self.revision, self.topology_revision, unit_key, unit_revision) {
            Ok(_) => {
                self.sync_in_flight = true;
                self.trace_sync_queued(unit_key, unit_revision, refresh_all);
                Result<(), IoError>.Ok(())
            },
            Err(problem) => Result<(), IoError>.Err(problem),
        }
    }

    fn queue_current_sync() -> Result<(), IoError> {
        self.queue_sync("primary")
    }

    fn has_current_analysis(unit_key: str) -> bool { self.unit_revisions.is_current(unit_key) }

    fn schedule_due_work() -> Result<(), IoError> {
        if !self.worker_initialized || self.sync_in_flight { return Result<(), IoError>.Ok(()); }
        if self.topology_pending {
            if !self.topology_retry_blocked { self.queue_sync("primary")?; }
            return Result<(), IoError>.Ok(());
        }
        let now = monotonic_now()?.nanoseconds();
        if let Some(key) = self.unit_revisions.take_due(now) {
            let result = self.queue_sync(key.as_str());
            key.drop();
            result?;
        }
        Result<(), IoError>.Ok(())
    }

    fn next_wait_milliseconds() -> Result<u64, IoError> {
        if self.sync_in_flight { return Result<u64, IoError>.Ok(100u64); }
        let now = monotonic_now()?.nanoseconds();
        Result<u64, IoError>.Ok(self.unit_revisions.wait_milliseconds(now, 100u64))
    }

    fn queue_query(id: RequestId, method: String, params: Option<Value>,
        unit_key: str, unit_revision: u64)
    -> Result<(), IoError> {
        let payload = Object.new();
        put(&payload, "method", Value.String(method));
        put(&payload, "unit_key", Value.String(String.from(&unit_key)));
        put(&payload, "unit_revision", Value.Number(Number.Unsigned(unit_revision)));
        match params {
            Some(value) => put(&payload, "params", value),
            None => put(&payload, "params", Value.Null),
        }
        let kind = PendingKind.ClientRequest;
        self.queue_internal("worker/query", Value.Object(payload), kind, self.revision,
            self.topology_revision, unit_key, unit_revision)?;
        let index = self.pending.len() - 1u64;
        self.pending[index].client_id = Option<RequestId>.Some(id);
        Result<(), IoError>.Ok(())
    }

    fn defer_query(id: RequestId, method: String, params: Option<Value>,
        unit_key: str, unit_revision: u64)
    -> Result<(), IoError> {
        if self.pending.len() + self.deferred.len() >= 128u64 {
            let result = self.error(id, -32803i64, "too many pending requests");
            method.drop();
            if let Some(value) = params { value.drop(); }
            return result;
        }
        self.deferred.push(DeferredRequest(
            id=id,
            method=method,
            params=params,
            unit_key=String.from(&unit_key),
            unit_revision=unit_revision,
            route_provisional=!self.workspace_units.routes_known(),
            ));
        Result<(), IoError>.Ok(())
    }

    fn flush_deferred(success: bool, failed_unit_key: str, failed_unit_revision: u64)
    -> Result<(), IoError> {
        let index = 0u64;
        while index < self.deferred.len() {
            let current_key = match self.unit_key_for_params(match &self.deferred[index].params {
                Some(value) => Option<Value&>.Some(value),
                None => Option<Value&>.None,
            }) {
                Some(value) => value,
                None => String.from(&self.deferred[index].unit_key.as_str()),
            };
            if self.deferred[index].route_provisional &&
                current_key.as_str() != self.deferred[index].unit_key.as_str() {
                self.deferred[index].unit_key.drop();
                self.deferred[index].unit_key = String.from(&current_key.as_str());
                self.deferred[index].unit_revision = self.unit_revisions.revision(current_key.as_str());
                self.deferred[index].route_provisional = false;
            } elif current_key.as_str() != self.deferred[index].unit_key.as_str() {
                current_key.drop();
                let request = self.deferred.remove(index);
                self.error(request.id, -32801i64, "document routing changed while request was running")?;
                request.method.drop();
                request.unit_key.drop();
                match request.params { Some(value) => value.drop(), None => {}, }
                continue;
            }
            current_key.drop();
            let key = self.deferred[index].unit_key.as_str();
            let current_revision = self.unit_revisions.revision(key);
            if current_revision != self.deferred[index].unit_revision {
                let request = self.deferred.remove(index);
                self.error(request.id, -32801i64, "document changed while request was running")?;
                request.method.drop();
                request.unit_key.drop();
                match request.params { Some(value) => value.drop(), None => {}, }
            } elif self.unit_revisions.is_current(key) {
                let request = self.deferred.remove(index);
                self.queue_query(request.id, request.method, request.params,
                    request.unit_key.as_str(), request.unit_revision)?;
                request.unit_key.drop();
            } elif !success && (failed_unit_key.as_slice().len() == 0u64 ||
                (self.deferred[index].unit_key.as_str() == failed_unit_key &&
                    self.deferred[index].unit_revision == failed_unit_revision)) {
                let request = self.deferred.remove(index);
                self.error(request.id, -32603i64, "analysis failed before request could run")?;
                request.method.drop();
                request.unit_key.drop();
                match request.params { Some(value) => value.drop(), None => {}, }
            } else {
                index += 1u64;
            }
        }
        Result<(), IoError>.Ok(())
    }

    fn initialize_result() -> Value {
        let capabilities = Object.new();
        let sync = Object.new();
        put(&sync, "openClose", Value.Boolean(true));
        put(&sync, "change", Value.Number(Number.Unsigned(1u64)));
        put(&sync, "save", Value.Boolean(true));
        put(&capabilities, "textDocumentSync", Value.Object(sync));
        put(&capabilities, "positionEncoding", Value.String(String.from(&"utf-16")));
        put(&capabilities, "definitionProvider", Value.Boolean(true));
        put(&capabilities, "hoverProvider", Value.Boolean(true));
        put(&capabilities, "documentSymbolProvider", Value.Boolean(true));
        put(&capabilities, "referencesProvider", Value.Boolean(true));
        put(&capabilities, "documentHighlightProvider", Value.Boolean(true));
        put(&capabilities, "inlayHintProvider", Value.Boolean(true));
        let legend = Object.new();
        let token_types = Vec<Value>.new();
        for token_type in ["type", "struct", "enum", "interface", "typeParameter", "function", "method", "property", "enumMember", "variable", "parameter"] {
            token_types.push(Value.String(String.from(token_type)));
        }
        let token_modifiers = Vec<Value>.new();
        token_modifiers.push(Value.String(String.from(&"declaration")));
        token_modifiers.push(Value.String(String.from(&"defaultLibrary")));
        put(&legend, "tokenTypes", Value.Array(token_types));
        put(&legend, "tokenModifiers", Value.Array(token_modifiers));
        let semantic_provider = Object.new();
        put(&semantic_provider, "legend", Value.Object(legend));
        put(&semantic_provider, "full", Value.Boolean(true));
        put(&capabilities, "semanticTokensProvider", Value.Object(semantic_provider));

        let workspace_folders = Object.new();
        put(&workspace_folders, "supported", Value.Boolean(true));
        put(&workspace_folders, "changeNotifications", Value.Boolean(true));
        let workspace = Object.new();
        put(&workspace, "workspaceFolders", Value.Object(workspace_folders));
        put(&workspace, "fileOperations", empty_object());
        put(&capabilities, "workspace", Value.Object(workspace));

        let server_info = Object.new();
        put(&server_info, "name", Value.String(String.from(&"yian-lsp")));
        put(&server_info, "version", Value.String(String.from(&"0.8.0")));

        let result = Object.new();
        put(&result, "capabilities", Value.Object(capabilities));
        put(&result, "serverInfo", Value.Object(server_info));
        Value.Object(result)
    }

    fn publish_empty_diagnostics(uri: str) -> Result<(), IoError> {
        let payload = Object.new();
        put(&payload, "uri", Value.String(String.from(&uri)));
        put(&payload, "diagnostics", empty_array());
        match self.documents.find(uri) {
            Some(index) => match self.documents.at(index).version {
                Some(version) => put(&payload, "version", Value.Number(Number.Signed(version))),
                None => {},
            },
            None => {},
        }
        self.notification("textDocument/publishDiagnostics", Value.Object(payload))
    }

    fn clear_unit_diagnostics(unit_key: str) -> Result<(), IoError> {
        let index = 0u64;
        while index < self.published_diagnostics.len() {
            if self.published_diagnostics[index].unit_key.as_str() == unit_key {
                let removed = self.published_diagnostics.remove(index);
                self.publish_empty_diagnostics(removed.uri.as_str())?;
                removed.drop();
            } else {
                index += 1u64;
            }
        }
        Result<(), IoError>.Ok(())
    }

    fn invalidate_unit_requests(unit_key: str) -> Result<(), IoError> {
        let index = 0u64;
        while index < self.deferred.len() {
            if self.deferred[index].unit_key.as_str() == unit_key &&
                !self.deferred[index].route_provisional {
                let request = self.deferred.remove(index);
                self.error(request.id, -32801i64, "document changed while request was running")?;
                request.method.drop();
                request.unit_key.drop();
                match request.params { Some(value) => value.drop(), None => {}, }
            } else {
                index += 1u64;
            }
        }
        for pending in self.pending {
            if pending.kind == PendingKind.ClientRequest && pending.unit_key.as_str() == unit_key {
                if let Some(id) = pending.client_id.take() {
                    self.error(id, -32801i64, "document changed while request was running")?;
                }
            }
        }
        self.clear_unit_diagnostics(unit_key)
    }

    fn update_revision(unit_key: str, topology: bool, debounce: bool) -> Result<(), IoError> {
        self.revision += 1u64;
        self.topology_retry_blocked = false;
        if topology {
            self.topology_revision += 1u64;
            self.topology_pending = true;
        }
        self.ensure_unit_revisions();
        let now = monotonic_now()?.nanoseconds();
        let deadline = now + if debounce { 600000000i64 } else { 0i64 };
        self.unit_revisions.mark_changed(unit_key, deadline);
        self.invalidate_unit_requests(unit_key)?;
        if topology && unit_key != "primary" {
            self.unit_revisions.mark_changed("primary", deadline);
            self.invalidate_unit_requests("primary")?;
        }
        Result<(), IoError>.Ok(())
    }

    fn update_all_units(debounce: bool) -> Result<(), IoError> {
        self.revision += 1u64;
        self.topology_retry_blocked = false;
        self.ensure_unit_revisions();
        let now = monotonic_now()?.nanoseconds();
        let deadline = now + if debounce { 600000000i64 } else { 0i64 };
        let index = 0u64;
        while index < self.unit_revisions.count() {
            let key = String.from(&self.unit_revisions.key_at(index));
            self.unit_revisions.mark_changed(key.as_str(), deadline);
            self.invalidate_unit_requests(key.as_str())?;
            key.drop();
            index += 1u64;
        }
        Result<(), IoError>.Ok(())
    }

    fn process_did_open(params: Option<Value>) -> Result<(), IoError> {
        let value = match params {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("didOpen is missing params")),
        };
        let decoded = match DidOpenParams.from_json(&value) {
            Some(value) => value,
            None => { value.drop(); return Result<(), IoError>.Err(process_error("invalid didOpen params")); },
        };
        value.drop();
        let document = decoded.text_document;
        let uri = String.from(&document.uri.as_str());
        self.documents.set(document.uri.as_str(), document.text.as_str(), Option<i64>.Some(document.version));
        document.drop();
        let key = self.workspace_units.key_for_uri(uri.as_str());
        let path = match uri_to_path(uri.as_str()) {
            Ok(value) => value,
            Err(problem) => { let _ = problem.kind; String.new() },
        };
        let discovers_primary_member = self.workspace_units.routes_known() &&
            Self.source_path_uri(uri.as_str()) &&
            self.workspace_units.is_primary_path(path.as_str()) &&
            !self.workspace_units.is_primary_file_uri(uri.as_str());
        path.drop();
        let topology = (!self.workspace_units.routes_known() && Self.source_path_uri(uri.as_str())) ||
            discovers_primary_member ||
            (Self.manifest_uri(uri.as_str()) && self.workspace_units.is_primary_uri(uri.as_str()));
        let route_key = if topology { "primary" } else { key.as_str() };
        let result = self.update_revision(route_key, topology, false);
        key.drop();
        uri.drop();
        match result {
            Ok(_) => self.register_file_watchers(),
            Err(problem) => Result<(), IoError>.Err(problem),
        }
    }

    fn process_did_change(params: Option<Value>) -> Result<(), IoError> {
        let value = match params {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("didChange is missing params")),
        };
        let decoded = match DidChangeParams.from_json(&value) {
            Some(value) => value,
            None => { value.drop(); return Result<(), IoError>.Err(process_error("invalid didChange params")); },
        };
        value.drop();
        let uri = String.from(&decoded.text_document.uri.as_str());
        let text = if decoded.content_changes.len() == 0u64 {
            match self.documents.find(uri.as_str()) {
                Some(index) => String.from(&self.documents.at(index).text.as_str()),
                None => String.new(),
            }
        } else {
            String.from(&decoded.content_changes[decoded.content_changes.len() - 1u64].text.as_str())
        };
        self.documents.set(uri.as_str(), text.as_str(), Option<i64>.Some(decoded.text_document.version));
        let key = self.workspace_units.key_for_uri(uri.as_str());
        uri.drop();
        text.drop();
        decoded.drop();
        let result = self.update_revision(key.as_str(), false, true);
        key.drop();
        result
    }

    fn process_did_close(params: Option<Value>) -> Result<(), IoError> {
        let value = match params {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("didClose is missing params")),
        };
        let decoded = match DidCloseParams.from_json(&value) {
            Some(value) => value,
            None => { value.drop(); return Result<(), IoError>.Err(process_error("invalid didClose params")); },
        };
        value.drop();
        let uri = String.from(&decoded.text_document.uri.as_str());
        let key = self.workspace_units.key_for_uri(uri.as_str());
        self.documents.remove(uri.as_str());
        decoded.drop();
        let clear = Object.new();
        put(&clear, "uri", Value.String(uri.clone()));
        put(&clear, "diagnostics", empty_array());
        self.notification("textDocument/publishDiagnostics", Value.Object(clear))?;
        self.remove_published_diagnostic(uri.as_str());
        let result = self.update_revision(key.as_str(), false, false);
        key.drop();
        uri.drop();
        match result {
            Ok(_) => self.register_file_watchers(),
            Err(problem) => Result<(), IoError>.Err(problem),
        }
    }

    fn remove_published_diagnostic(uri: str) {
        let index = 0u64;
        while index < self.published_diagnostics.len() {
            if self.published_diagnostics[index].uri.as_str() == uri {
                let removed = self.published_diagnostics.remove(index);
                removed.drop();
            } else {
                index += 1u64;
            }
        }
    }

    fn process_did_save(params: Option<Value>) -> Result<(), IoError> {
        let value = match params {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("didSave is missing params")),
        };
        let decoded = match DidSaveParams.from_json(&value) {
            Some(value) => value,
            None => { value.drop(); return Result<(), IoError>.Err(process_error("invalid didSave params")); },
        };
        value.drop();

        let uri = decoded.text_document.uri.as_str();
        if let Some(text) = &decoded.text {
            let version = match self.documents.find(uri) {
                Some(index) => self.documents.at(index).version,
                None => Option<i64>.None,
            };
            self.documents.set(uri, text.as_str(), version);
        }
        let refresh_topology = Self.manifest_uri(uri) && self.workspace_units.is_primary_uri(uri);
        let key = if refresh_topology { String.from(&"primary") }
            else { self.workspace_units.key_for_uri(uri) };
        decoded.drop();
        let result = self.update_revision(key.as_str(), refresh_topology, false);
        key.drop();
        result
    }

    fn process_watched_files(params: Option<Value>) -> Result<(), IoError> {
        let value = match params {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("file watcher notification is missing params")),
        };
        let decoded = match DidChangeWatchedFilesParams.from_json(&value) {
            Some(value) => value,
            None => { value.drop(); return Result<(), IoError>.Err(process_error("invalid file watcher params")); },
        };
        value.drop();

        let standard_library_changed = false;
        for event in decoded.changes {
            let uri = event.uri.as_str();
            let standard_library = self.workspace_units.is_standard_library_uri(uri);
            let primary = self.workspace_units.is_primary_uri(uri);
            let manifest = Self.manifest_uri(uri);
            let source = Self.source_path_uri(uri);
            let open = self.documents.find(uri).is_some();
            if standard_library {
                standard_library_changed = true;
            } elif primary && (manifest || source) {
                let topology = manifest || (source &&
                    (event.kind.value() == 1u64 || event.kind.value() == 3u64));
                let key = String.from(&"primary");
                self.update_revision(key.as_str(), topology, false)?;
                key.drop();
            } elif open && source {
                let key = self.workspace_units.key_for_uri(uri);
                self.update_revision(key.as_str(), false, false)?;
                key.drop();
            }
            event.drop();
        }
        decoded.drop();
        if standard_library_changed { self.update_all_units(false)?; }
        Result<(), IoError>.Ok(())
    }

    fn handle_cancel(params: Option<Value>) -> Result<(), IoError> {
        let value = match params { Some(value) => value, None => return Result<(), IoError>.Ok(()) };
        defer value.drop();
        let object = match value.as_object() { Some(value) => value, None => return Result<(), IoError>.Ok(()) };
        let requested = match object.get("id") { Some(value) => value, None => return Result<(), IoError>.Ok(()) };
        for pending in self.pending {
            match &pending.client_id {
                Some(id) if request_id_matches_json(id, requested) => {
                    if let Some(id) = pending.client_id.take() {
                        self.error(id, -32800i64, "request cancelled")?;
                    }
                    break;
                },
                _ => {},
            }
        }
        let index = 0u64;
        while index < self.deferred.len() {
            if request_id_matches_json(&self.deferred[index].id, requested) {
                let request = self.deferred.remove(index);
                self.error(request.id, -32800i64, "request cancelled")?;
                request.method.drop();
                request.unit_key.drop();
                match request.params { Some(value) => value.drop(), None => {}, }
                break;
            }
            index += 1u64;
        }
        Result<(), IoError>.Ok(())
    }

    fn handle_request(id: RequestId, method: String, params: Option<Value>)
    -> Result<(), IoError> {
        match method.as_str() {
            "initialize" => {
                if self.initialized {
                    return self.error(id, -32600i64, "initialize may only be requested once");
                }
                self.workspace_root = Self.workspace_root(match &params {
                        Some(value) => Option<Value&>.Some(value),
                        None => Option<Value&>.None,
                    });
                self.supports_watchers = match &params {
                    Some(value) => Self.client_supports_watchers(Option<Value&>.Some(value)),
                    None => false,
                };
                self.supports_relative_watchers = match &params {
                    Some(value) => Self.client_supports_relative_watchers(Option<Value&>.Some(value)),
                    None => false,
                };
                self.supports_semantic_refresh = match &params {
                    Some(value) => Self.client_supports_semantic_refresh(Option<Value&>.Some(value)),
                    None => false,
                };
                self.supports_inlay_hint_refresh = match &params {
                    Some(value) => Self.client_supports_inlay_hint_refresh(Option<Value&>.Some(value)),
                    None => false,
                };
                if let Some(value) = params { value.drop(); }
                self.initialized = true;
                self.success(id, self.initialize_result())?;
                if self.worker_initialized { self.queue_current_sync()?; }
                Result<(), IoError>.Ok(())
            },
            "shutdown" => {
                if let Some(value) = params { value.drop(); }
                self.shutdown_received = true;
                self.success(id, Value.Null)
            },
            "textDocument/definition" | "textDocument/hover" | "textDocument/documentSymbol" |
            "textDocument/semanticTokens/full" | "textDocument/references" |
            "textDocument/documentHighlight" | "textDocument/inlayHint" => {
                if !self.initialized { return self.error(id, -32002i64, "server is not initialized"); }
                if self.pending.len() + self.deferred.len() >= 128u64 {
                    return self.error(id, -32803i64, "too many pending requests");
                }
                self.ensure_unit_revisions();
                let unit_key = self.unit_key_for_params(match &params {
                    Some(value) => Option<Value&>.Some(value),
                    None => Option<Value&>.None,
                });
                match unit_key {
                    Some(key) => {
                        let unit_revision = self.unit_revisions.revision(key.as_str());
                        if self.has_current_analysis(key.as_str()) {
                            let result = self.queue_query(id, method, params, key.as_str(), unit_revision);
                            key.drop();
                            result
                        } else {
                            let result = self.defer_query(id, method, params, key.as_str(), unit_revision);
                            key.drop();
                            result
                        }
                    },
                    None => self.queue_query(id, method, params, "", 0u64),
                }
            },
            _ => {
                if let Some(value) = params { value.drop(); }
                self.error(id, -32601i64, "method not found")
            },
        }
    }

    fn handle_notification(method: String, params: Option<Value>) -> Result<(), IoError> {
        match method.as_str() {
            "initialized" => {
                if let Some(value) = params { value.drop(); }
                self.register_file_watchers()
            },
            "textDocument/didOpen" => self.process_did_open(params),
            "textDocument/didChange" => self.process_did_change(params),
            "textDocument/didSave" => self.process_did_save(params),
            "textDocument/didClose" => self.process_did_close(params),
            "workspace/didChangeWatchedFiles" => self.process_watched_files(params),
            "$/cancelRequest" => self.handle_cancel(params),
            "exit" => {
                if let Some(value) = params { value.drop(); }
                self.exiting = true;
                self.exit_status = if self.shutdown_received { 0i32 } else { 1i32 };
                Result<(), IoError>.Ok(())
            },
            _ => {
                if let Some(value) = params { value.drop(); }
                Result<(), IoError>.Ok(())
            },
        }
    }

    fn record_watcher_response(id: RequestId, accepted: bool) {
        let response_id = match &id {
            RequestId.Signed(value) => Option<i64>.Some(*value),
            RequestId.Unsigned(value) if *value <= 9223372036854775807u64 =>
                Option<i64>.Some(i64(*value)),
            _ => Option<i64>.None,
        };
        let matches_pending = match &self.watcher_pending_id {
            Some(expected) => match &response_id {
                Some(actual) => *expected == *actual,
                None => false,
            },
            None => false,
        };
        if matches_pending {
            self.watcher_pending_id = Option<i64>.None;
            self.watchers_registered = accepted;
            self.watchers_rejected = !accepted;
            if !accepted {
                eprintln("yian-lsp: client rejected watched-file registration; external input changes may remain stale until another event or restart");
            }
        }
        id.drop();
    }

    fn handle_client_message(message: Message) -> Result<(), IoError> {
        match message {
            Request(id, method, params) => self.handle_request(id, method, params),
            Notification(method, params) => self.handle_notification(method, params),
            SuccessResponse(id, value) => {
                self.record_watcher_response(id, true);
                value.drop();
                Result<(), IoError>.Ok(())
            },
            ErrorResponse(id, problem) => {
                self.record_watcher_response(id, false);
                problem.drop();
                Result<(), IoError>.Ok(())
            },
        }
    }

    static fn strings_from_json(value: Option<Value&>) -> Vec<String> {
        let result = Vec<String>.new();
        let array = match value {
            Some(value) => match value.as_array() {
                Some(value) => value,
                None => return result,
            },
            None => return result,
        };
        for item in *array {
            match item.as_string() {
                Some(path) => result.push(String.from(&path)),
                None => {},
            }
        }
        result
    }

    fn clear_published_uri(uri: str) -> Result<(), IoError> {
        let found = false;
        let index = 0u64;
        while index < self.published_diagnostics.len() {
            if self.published_diagnostics[index].uri.as_str() == uri {
                let removed = self.published_diagnostics.remove(index);
                removed.drop();
                found = true;
            } else {
                index += 1u64;
            }
        }
        if found { self.publish_empty_diagnostics(uri)?; }
        Result<(), IoError>.Ok(())
    }

    fn replace_routes(object: Object&) -> Result<(), IoError> {
        let old_keys = Vec<String>.with_capacity(self.documents.len());
        let index = 0u64;
        while index < self.documents.len() {
            old_keys.push(self.workspace_units.key_for_uri(self.documents.at(index).uri.as_str()));
            index += 1u64;
        }
        self.workspace_units.set_primary_files(Self.strings_from_json(match object.get("primary_files") {
            Some(value) => Option<Value&>.Some(value),
            None => Option<Value&>.None,
        }));
        self.workspace_units.set_primary_roots(Self.strings_from_json(match object.get("primary_roots") {
            Some(value) => Option<Value&>.Some(value),
            None => Option<Value&>.None,
        }));
        self.workspace_units.set_primary_manifests(Self.strings_from_json(match object.get("primary_manifests") {
            Some(value) => Option<Value&>.Some(value),
            None => Option<Value&>.None,
        }));
        match field_string(object, "standard_library_root") {
            Some(root) => self.workspace_units.set_standard_library_root(root),
            None => {},
        }
        self.workspace_units.set_routes_known();

        let now = monotonic_now()?.nanoseconds();
        let doc_index = 0u64;
        while doc_index < self.documents.len() {
            let old_key = &old_keys[doc_index];
            let uri = self.documents.at(doc_index).uri.as_str();
            let new_key = self.workspace_units.key_for_uri(uri);
            if old_key.as_str() != new_key.as_str() {
                if old_key.as_str() != "primary" {
                    self.unit_revisions.mark_changed(old_key.as_str(), now);
                    self.invalidate_unit_requests(old_key.as_str())?;
                }
                self.clear_published_uri(uri)?;
            }
            self.unit_revisions.ensure(new_key.as_str());
            new_key.drop();
            doc_index += 1u64;
        }
        release_strings(&old_keys);
        self.ensure_unit_revisions();
        Result<(), IoError>.Ok(())
    }

    fn has_pending_unit_work(unit_key: str) -> bool {
        for pending in self.pending {
            if pending.kind == PendingKind.ClientRequest &&
                pending.unit_key.as_str() == unit_key {
                return true;
            }
        }
        for request in self.deferred {
            if request.unit_key.as_str() == unit_key { return true; }
        }
        false
    }

    fn prune_closed_standalone_units() {
        let index = self.unit_revisions.count();
        while index != 0u64 {
            index -= 1u64;
            let key = String.from(&self.unit_revisions.key_at(index));
            if key.as_str().starts_with("file:") {
                let active = false;
                for document in 0u64..self.documents.len() {
                    let document_key = self.workspace_units.key_for_uri(
                        self.documents.at(document).uri.as_str());
                    if document_key.as_str() == key.as_str() { active = true; }
                    document_key.drop();
                    if active { break; }
                }
                if !active && !self.has_pending_unit_work(key.as_str()) {
                    self.unit_revisions.remove(key.as_str());
                }
            }
            key.drop();
        }
    }

    fn publish_unit_diagnostics(unit_key: str, diagnostics: Object&) -> Result<(), IoError> {
        let index = 0u64;
        while index < self.published_diagnostics.len() {
            if self.published_diagnostics[index].unit_key.as_str() == unit_key {
                let uri = String.from(&self.published_diagnostics[index].uri.as_str());
                let should_clear = diagnostics.get(uri.as_str()).is_none();
                let removed = self.published_diagnostics.remove(index);
                if should_clear { self.publish_empty_diagnostics(uri.as_str())?; }
                removed.drop();
                uri.drop();
            } else {
                index += 1u64;
            }
        }
        let iterator = diagnostics.iter();
        while let Some((uri, values)) = iterator.next() {
            let payload = Object.new();
            put(&payload, "uri", Value.String(String.from(&uri)));
            put(&payload, "diagnostics", values.clone());
            match self.documents.find(uri) {
                Some(index) => match self.documents.at(index).version {
                    Some(version) => put(&payload, "version", Value.Number(Number.Signed(version))),
                    None => {},
                },
                None => {},
            }
            self.notification("textDocument/publishDiagnostics", Value.Object(payload))?;
            self.published_diagnostics.push(PublishedDiagnostic(
                uri=String.from(&uri), unit_key=String.from(&unit_key)));
        }
        Result<(), IoError>.Ok(())
    }

    fn publish_sync_result(result: Value, routes_current: bool,
        sync_current: bool) -> Result<(), IoError> {
        defer result.drop();
        let object = match result.as_object() {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("worker sync result is invalid")),
        };
        if !routes_current { return Result<(), IoError>.Ok(()); }
        self.replace_routes(object)?;
        let unit_results = match object.get("unit_results") {
            Some(value) => value.as_array(),
            None => Option<Vec<Value>&>.None,
        };
        let published = false;
        if let Some(results) = unit_results {
            for item in *results {
                let fields = match item.as_object() {
                    Some(value) => value,
                    None => continue,
                };
                let key = match field_string(fields, "key") {
                    Some(value) => value,
                    None => continue,
                };
                let revision = match field_u64(fields, "revision") {
                    Some(value) => value,
                    None => continue,
                };
                if !self.unit_revisions.mark_analyzed(key, revision) { continue; }
                match fields.get("diagnostics") {
                    Some(value) => match value.as_object() {
                        Some(diagnostics) => {
                            self.publish_unit_diagnostics(key, diagnostics)?;
                        },
                        None => {},
                    },
                    None => {},
                }
                published = true;
            }
        }
        if routes_current && sync_current { self.prune_closed_standalone_units(); }
        if published { self.send_semantic_refresh()?; }
        if published { self.send_inlay_hint_refresh()?; }
        Result<(), IoError>.Ok(())
    }

    fn handle_worker_message(message: Message) -> Result<(), IoError> {
        match message {
            Notification(method, params) => {
                if method.as_str() == "worker/ready" { self.worker_ready = true; }
                method.drop();
                if let Some(value) = params { value.drop(); }
                Result<(), IoError>.Ok(())
            },
            SuccessResponse(id, result) => {
                let internal_id = match id {
                    Unsigned(value) => value,
                    Signed(value) if value >= 0i64 => u64(value),
                    _ => { id.drop(); result.drop(); return Result<(), IoError>.Err(process_error("worker returned an invalid response ID")); },
                };
                let pending = if self.pending.len() == 0u64 {
                    result.drop();
                    return Result<(), IoError>.Err(process_error("worker returned an unsolicited response"));
                } else {
                    self.pending.remove(0u64)
                };
                if pending.internal_id != internal_id {
                    pending.drop();
                    result.drop();
                    return Result<(), IoError>.Err(process_error("worker response order is invalid"));
                }
                match pending.kind {
                    Initialize => {
                        self.worker_initialized = true;
                        if self.initialized { self.queue_current_sync()?; }
                    },
                    Synchronize => {
                        self.sync_in_flight = false;
                        let routes_current = pending.topology_revision == self.topology_revision;
                        self.publish_sync_result(result,
                            routes_current,
                            pending.revision == self.revision)?;
                        if routes_current {
                            self.topology_pending = false;
                            self.topology_retry_blocked = false;
                            self.register_file_watchers()?;
                            self.flush_deferred(true, "", 0u64)?;
                        }
                    },
                    ClientRequest => match pending.client_id {
                        Some(client_id) => {
                            if pending.topology_revision == self.topology_revision &&
                                (pending.unit_key.as_str().as_slice().len() == 0u64 ||
                                pending.unit_revision == self.unit_revisions.revision(pending.unit_key.as_str())) {
                                self.success(client_id, result)?;
                            } else {
                                result.drop();
                                self.error(client_id, -32801i64,
                                    "document input or routing changed while request was running")?;
                            }
                        },
                        None => result.drop(),
                    },
                }
                pending.drop();
                Result<(), IoError>.Ok(())
            },
            ErrorResponse(id, problem) => {
                id.drop();
                let message = String.from(&problem.message.as_str());
                let code = problem.code;
                problem.drop();
                if self.pending.len() == 0u64 { message.drop(); return Result<(), IoError>.Err(process_error("worker failed without a pending request")); }
                let pending = self.pending.remove(0u64);
                match pending.kind {
                    Initialize => {
                        self.worker_initialized = false;
                        self.flush_deferred(false, "", 0u64)?;
                    },
                    Synchronize => {
                        self.sync_in_flight = false;
                        if self.unit_revisions.revision(pending.unit_key.as_str()) == pending.unit_revision {
                            self.unit_revisions.set_deadline(pending.unit_key.as_str(), Option<i64>.None);
                        }
                        if pending.unit_key.as_str() == "primary" && self.topology_pending &&
                            pending.topology_revision == self.topology_revision {
                            self.topology_retry_blocked = true;
                        }
                        eprint("[yian-lsp ERROR] worker sync failed: ");
                        eprintln(message.as_str());
                        self.flush_deferred(false, pending.unit_key.as_str(), pending.unit_revision)?;
                    },
                    ClientRequest => match pending.client_id {
                        Some(client_id) => {
                            if pending.topology_revision == self.topology_revision &&
                                (pending.unit_key.as_str().as_slice().len() == 0u64 ||
                                pending.unit_revision == self.unit_revisions.revision(pending.unit_key.as_str())) {
                                self.error(client_id, code, message.as_str())?;
                            } else {
                                self.error(client_id, -32801i64,
                                    "document input or routing changed while request was running")?;
                            }
                        },
                        None => {},
                    },
                }
                pending.drop();
                message.drop();
                Result<(), IoError>.Ok(())
            },
            Request(id, method, params) => {
                id.drop();
                method.drop();
                if let Some(value) = params { value.drop(); }
                Result<(), IoError>.Err(process_error("worker sent a request to the LSP client"))
            },
        }
    }

    fn process_client_frames() -> Result<(), IoError> {
        loop {
            let body = match self.client_decoder.next_body() {
                Ok(Some(value)) => value,
                Ok(None) => return Result<(), IoError>.Ok(()),
                Err(_) => return Result<(), IoError>.Err(process_error("invalid LSP message frame")),
            };
            let text = frame_text(body)?;
            let message = match parse(text.as_str()) {
                Ok(value) => value,
                Err(problem) => {
                    let _ = problem.kind;
                    text.drop();
                    return Result<(), IoError>.Err(process_error("invalid JSON-RPC message"));
                },
            };
            text.drop();
            self.handle_client_message(message)?;
        }
    }

    fn process_worker_frames() -> Result<(), IoError> {
        loop {
            let body = match self.worker_decoder.next_body() {
                Ok(Some(value)) => value,
                Ok(None) => return Result<(), IoError>.Ok(()),
                Err(_) => return Result<(), IoError>.Err(process_error("invalid worker message frame")),
            };
            let text = frame_text(body)?;
            let message = match parse(text.as_str()) {
                Ok(value) => value,
                Err(problem) => {
                    let _ = problem.kind;
                    text.drop();
                    return Result<(), IoError>.Err(process_error("invalid worker JSON-RPC message"));
                },
            };
            text.drop();
            self.handle_worker_message(message)?;
        }
    }

    fn update_write_registrations(output: NonblockingGuard&) -> Result<(), IoError> {
        if self.client_output.pending_bytes() > 0u64 {
            if self.client_output_token.is_none() {
                let source = PollSource.from_nonblocking(output)?;
                self.client_output_token = Option<PollToken>.Some(
                    self.poller.register(source, PollInterests.writable())?);
            }
        } elif let Some(token) = self.client_output_token.take() {
            self.poller.remove(token)?;
        }

        if self.worker_output.pending_bytes() > 0u64 {
            if self.worker_input_token.is_none() {
                let writer = match self.child.stdin() {
                    Some(value) => value,
                    None => return Result<(), IoError>.Err(process_error("worker stdin pipe is closed")),
                };
                let source = PollSource.from_writer(writer)?;
                self.worker_input_token = Option<PollToken>.Some(
                    self.poller.register(source, PollInterests.writable())?);
            }
        } elif let Some(token) = self.worker_input_token.take() {
            self.poller.remove(token)?;
        }
        Result<(), IoError>.Ok(())
    }

    fn read_client() -> Result<(), IoError> {
        let input = Stdin.new();
        let buffer = byte_buffer(8192u64);
        defer buffer.drop();
        loop {
            match input.read(buffer.as_slice()) {
                Ok(count) => {
                    if count == 0u64 {
                        self.input_closed = true;
                        match self.client_decoder.finish() {
                            Ok(_) => {},
                            Err(_) => return Result<(), IoError>.Err(process_error("incomplete LSP frame at EOF")),
                        }
                        self.exiting = true;
                        return Result<(), IoError>.Ok(());
                    }
                    match self.client_decoder.feed(buffer.as_slice()[0u64..count]) {
                        Ok(_) => self.process_client_frames()?,
                        Err(_) => return Result<(), IoError>.Err(process_error("LSP input buffer limit exceeded")),
                    }
                },
                Err(problem) => {
                    if problem.kind() == IoErrorKind.WouldBlock {
                        problem.drop();
                        return Result<(), IoError>.Ok(());
                    }
                    return Result<(), IoError>.Err(problem);
                },
            }
        }
    }

    fn read_worker() -> Result<(), IoError> {
        let reader = match self.child.stdout() {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("worker stdout is closed")),
        };
        let buffer = byte_buffer(8192u64);
        defer buffer.drop();
        loop {
            match reader.read(buffer.as_slice()) {
                Ok(count) => {
                    if count == 0u64 { return Result<(), IoError>.Err(process_error("worker closed stdout")); }
                    match self.worker_decoder.feed(buffer.as_slice()[0u64..count]) {
                        Ok(_) => self.process_worker_frames()?,
                        Err(_) => return Result<(), IoError>.Err(process_error("worker input buffer limit exceeded")),
                    }
                },
                Err(problem) => {
                    if problem.kind() == IoErrorKind.WouldBlock {
                        problem.drop();
                        return Result<(), IoError>.Ok(());
                    }
                    return Result<(), IoError>.Err(problem);
                },
            }
        }
    }

    fn read_worker_error() -> Result<(), IoError> {
        let reader = match self.child.stderr() {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("worker stderr is closed")),
        };
        let buffer = byte_buffer(4096u64);
        defer buffer.drop();
        loop {
            match reader.read(buffer.as_slice()) {
                Ok(count) => {
                    if count == 0u64 { return Result<(), IoError>.Ok(()); }
                    match Stderr.new().write_all(buffer.as_slice()[0u64..count]) {
                        Ok(_) => {},
                        Err(problem) => { problem.drop(); return Result<(), IoError>.Ok(()); },
                    }
                },
                Err(problem) => {
                    if problem.kind() == IoErrorKind.WouldBlock {
                        problem.drop();
                        return Result<(), IoError>.Ok(());
                    }
                    return Result<(), IoError>.Err(problem);
                },
            }
        }
    }

    fn write_client() -> Result<(), IoError> {
        let output = Stdout.new();
        loop {
            let pending = self.client_output.pending();
            if pending.len() == 0u64 { return Result<(), IoError>.Ok(()); }
            match output.write(pending) {
                Ok(count) => {
                    if count == 0u64 { return Result<(), IoError>.Err(IoError.new(IoErrorKind.WriteZero, "stdout write made no progress")); }
                    match self.client_output.advance(count) {
                        Ok(_) => {},
                        Err(_) => return Result<(), IoError>.Err(process_error("invalid stdout write offset")),
                    }
                },
                Err(problem) => {
                    if problem.kind() == IoErrorKind.WouldBlock {
                        problem.drop();
                        return Result<(), IoError>.Ok(());
                    }
                    return Result<(), IoError>.Err(problem);
                },
            }
        }
    }

    fn write_worker() -> Result<(), IoError> {
        let writer = match self.child.stdin() {
            Some(value) => value,
            None => return Result<(), IoError>.Err(process_error("worker stdin is closed")),
        };
        loop {
            let pending = self.worker_output.pending();
            if pending.len() == 0u64 { return Result<(), IoError>.Ok(()); }
            match writer.write(pending) {
                Ok(count) => {
                    if count == 0u64 { return Result<(), IoError>.Err(IoError.new(IoErrorKind.WriteZero, "worker pipe write made no progress")); }
                    match self.worker_output.advance(count) {
                        Ok(_) => {},
                        Err(_) => return Result<(), IoError>.Err(process_error("invalid worker write offset")),
                    }
                },
                Err(problem) => {
                    if problem.kind() == IoErrorKind.WouldBlock {
                        problem.drop();
                        return Result<(), IoError>.Ok(());
                    }
                    return Result<(), IoError>.Err(problem);
                },
            }
        }
    }

    fn handle_event(event: PollEvent) -> Result<(), IoError> {
        let token = event.token();
        if token.same(self.client_input_token) {
            return self.read_client();
        }
        if token.same(self.worker_output_token) {
            return self.read_worker();
        }
        if token.same(self.worker_error_token) {
            return self.read_worker_error();
        }
        match &self.client_output_token {
            Some(expected) if token.same(*expected) => return self.write_client(),
            _ => {},
        }
        match &self.worker_input_token {
            Some(expected) if token.same(*expected) => return self.write_worker(),
            _ => {},
        }
        Result<(), IoError>.Ok(())
    }

    fn run(output_guard: NonblockingGuard&) -> i32 {
        let deadline_ns = self.startup_started_ns + 10000000000i64;
        loop {
            if let Err(problem) = self.schedule_due_work() {
                eprint("yian-lsp: ");
                eprintln(problem.msg());
                problem.drop();
                return 1i32;
            }

            if let Err(problem) = self.update_write_registrations(output_guard) {
                eprint("yian-lsp: ");
                eprintln(problem.msg());
                problem.drop();
                return 1i32;
            }
            let wait_milliseconds = match self.next_wait_milliseconds() {
                Ok(value) => value,
                Err(problem) => { problem.drop(); return 1i32; },
            };
            let deadline = match Instant.after_milliseconds(wait_milliseconds) {
                Ok(value) => value,
                Err(problem) => { problem.drop(); return 1i32; },
            };
            let events = match self.poller.wait(Option<Instant>.Some(deadline)) {
                Ok(value) => value,
                Err(problem) => { eprint("yian-lsp: "); eprintln(problem.msg()); problem.drop(); return 1i32; },
            };
            for event in events {
                if let Err(problem) = self.handle_event(*event) {
                    eprint("yian-lsp: ");
                    eprintln(problem.msg());
                    problem.drop();
                    self.exit_status = 1i32;
                    self.exiting = true;
                    break;
                }
            }
            events.drop();

            if !self.worker_ready {
                match monotonic_now() {
                    Ok(now) => {
                        if now.nanoseconds() >= deadline_ns {
                            eprintln("yian-lsp: worker readiness timed out");
                            return 1i32;
                        }
                    },
                    Err(problem) => { problem.drop(); return 1i32; },
                }
                match self.child.try_wait() {
                    Ok(Some(_)) => { eprintln("yian-lsp: worker exited before readiness"); return 1i32; },
                    Ok(None) => {},
                    Err(problem) => { problem.drop(); return 1i32; },
                }
            } elif !self.worker_initialized {
                if self.pending.len() == 0u64 {
                    if let Err(problem) = self.queue_internal("worker/initialize", empty_object(),
                        PendingKind.Initialize, self.revision, self.topology_revision, "", 0u64) {
                        problem.drop();
                        return 1i32;
                    }
                }
            }

            if self.exiting && self.client_output.pending_bytes() == 0u64 { return self.exit_status; }
        }
    }
}

impl Drop for ServerState {
    pub fn drop() {
        self.client_decoder.drop();
        self.worker_decoder.drop();
        self.client_output.drop();
        self.worker_output.drop();
        for pending in self.pending { pending.drop(); }
        self.pending.drop();
        for request in self.deferred { request.drop(); }
        self.deferred.drop();
        self.documents.drop();
        for diagnostic in self.published_diagnostics { diagnostic.drop(); }
        self.published_diagnostics.drop();
        self.poller.drop();
        self.workspace_units.drop();
        self.unit_revisions.drop();
        release_strings(&self.watcher_bases);
        release_strings(&self.watcher_patterns);
        match &self.workspace_root { Some(value) => value.drop(), None => {}, }
        match &self.trace_file { Some(value) => value.drop(), None => {}, }
        self.child.drop();
    }
}

pub fn run_server(config: Config&) -> i32 {
    let input_guard = match Stdin.new().nonblocking() {
        Ok(value) => value,
        Err(problem) => { eprint("yian-lsp: "); eprintln(problem.msg()); problem.drop(); return 1i32; },
    };
    defer input_guard.drop();
    let output_guard = match Stdout.new().nonblocking() {
        Ok(value) => value,
        Err(problem) => { eprint("yian-lsp: "); eprintln(problem.msg()); problem.drop(); return 1i32; },
    };
    defer output_guard.drop();

    let child = match worker_command(config) {
        Ok(value) => value,
        Err(problem) => { eprint("yian-lsp: "); eprintln(problem.msg()); problem.drop(); return 1i32; },
    };
    let server = match ServerState.new(child, &input_guard, &output_guard, config) {
        Ok(value) => value,
        Err(problem) => { eprint("yian-lsp: "); eprintln(problem.msg()); problem.drop(); return 1i32; },
    };
    let status = server.run(&output_guard);

    let _ = server.child.close();
    server.drop();
    status
}
