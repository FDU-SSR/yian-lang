struct OpenInput {
    path: PathBuf,
    text: String,
    version: Option<i64>,
}

impl Drop for OpenInput {
    pub fn drop() {
        self.path.drop();
        self.text.drop();
    }
}

fn failure(message: str) -> String { String.from(&message) }

fn timing_now_ns() -> i64 {
    match monotonic_now() {
        Ok(value) => value.nanoseconds(),
        Err(problem) => { problem.drop(); -1i64 },
    }
}

fn record_timing(timings: Object&, name: str, started_ns: i64, finished_ns: i64) {
    if started_ns >= 0i64 && finished_ns >= started_ns {
        timings.insert(name, Value.Number(Number.Float(f64(finished_ns - started_ns) / 1000000.0)));
    }
}

fn field_string(object: Object&, key: str) -> Option<str> {
    match object.get(key) {
        Some(value) => value.as_string(),
        None => Option<str>.None,
    }
}

fn field_u64(object: Object&, key: str) -> Option<u64> {
    match object.get(key) {
        Some(value) => match value {
            Number(number) => match number {
                Unsigned(number) => Option<u64>.Some(*number),
                Signed(number) if *number >= 0i64 => Option<u64>.Some(u64(*number)),
                _ => Option<u64>.None,
            },
            _ => Option<u64>.None,
        },
        None => Option<u64>.None,
    }
}

fn json_put(object: Object&, key: str, value: Value) {
    if let Some(previous) = object.insert(key, value) { previous.drop(); }
}

fn empty_object() -> Value { Value.Object(Object.new()) }
fn empty_array() -> Value { Value.Array(Vec<Value>.new()) }

fn empty_semantic_tokens() -> Value {
    let result = Object.new();
    json_put(&result, "data", empty_array());
    Value.Object(result)
}

pub struct WorkerFailure { pub code: i64, pub message: String }

impl WorkerFailure {
    static fn new(code: i64, message: str) -> Self {
        Self(code=code, message=String.from(&message))
    }
}

impl Drop for WorkerFailure {
    pub fn drop() { self.message.drop(); }
}

fn protocol_position(position: Position) -> Value {
    let value = Object.new();
    json_put(&value, "line", Value.Number(Number.Unsigned(position.line)));
    json_put(&value, "character", Value.Number(Number.Unsigned(position.character)));
    Value.Object(value)
}

fn protocol_range(span: Span, text: str) -> Value {
    let index = LineIndex.new(text);
    defer index.drop();
    let start = Position(line=span.start.row,
        character=index.utf16_column(span.start.row, span.start.column));
    let end = Position(line=span.end.row,
        character=index.utf16_column(span.end.row, span.end.column));
    let result = Object.new();
    json_put(&result, "start", protocol_position(start));
    json_put(&result, "end", protocol_position(end));
    Value.Object(result)
}

fn protocol_cursor_range(row: u64, column: u64, text: str) -> Value {
    let index = LineIndex.new(text);
    defer index.drop();
    let start = Position(line=row, character=index.utf16_column(row, column));
    let end = Position(line=row, character=index.utf16_column(row, column + 1u64));
    let result = Object.new();
    json_put(&result, "start", protocol_position(start));
    json_put(&result, "end", protocol_position(end));
    Value.Object(result)
}

fn source_for_path(snapshot: Snapshot&, path: str) -> Option<SourceId> {
    match snapshot.source() {
        Some(index) => index.source_for_path(path),
        None => Option<SourceId>.None,
    }
}

fn query_source(snapshot: Snapshot&, uri: str) -> Result<SourceId, WorkerFailure> {
    let path = match uri_to_path(uri) {
        Ok(value) => value,
        Err(_) => return Result<SourceId, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "text document URI is invalid")),
    };
    defer path.drop();
    let target = match resolve(path.as_str()) {
        Ok(value) => value,
        Err(problem) => { problem.drop(); return Result<SourceId, WorkerFailure>.Err(
            WorkerFailure.new(-32602i64, "text document URI cannot be resolved")); },
    };
    defer target.drop();
    match source_for_path(snapshot, target.as_str()) {
        Some(source) => Result<SourceId, WorkerFailure>.Ok(source),
        None => Result<SourceId, WorkerFailure>.Err(WorkerFailure.new(-32801i64, "document is not part of the current analysis snapshot")),
    }
}

fn position_column(snapshot: Snapshot&, source: SourceId, position: Position) -> u64 {
    let text = match snapshot.text(source) {
        Some(value) => value,
        None => "",
    };
    let index = LineIndex.new(text);
    defer index.drop();
    index.scalar_column(position.line, position.character)
}

fn text_at_path(snapshot: Snapshot&, path: str) -> String {
    match snapshot.text_for_path(path) {
        Some(text) => String.from(&text),
        None => String.new(),
    }
}

fn location_value(snapshot: Snapshot&, source: SourceId, span: Span) -> Value {
    let path = match snapshot.path(source) {
        Some(value) => value,
        None => return Value.Null,
    };
    let uri = match path_to_uri(path) {
        Ok(value) => value,
        Err(_) => return Value.Null,
    };
    defer uri.drop();
    let text = text_at_path(snapshot, path);
    defer text.drop();
    let result = Object.new();
    json_put(&result, "uri", Value.String(String.from(&uri.as_str())));
    json_put(&result, "range", protocol_range(span, text.as_str()));
    Value.Object(result)
}

fn dedup_key(source: SourceId, span: Span) -> String {
    let text = String.new();
    let number = u64(source.index).to_string_radix(10);
    text.push_str(number.as_str());
    number.drop();
    for value in [span.start.row, span.start.column, span.end.row, span.end.column] {
        text.push(':');
        let part = value.to_string_radix(10);
        text.push_str(part.as_str());
        part.drop();
    }
    text
}

fn targets_at(snapshot: Snapshot&, source: SourceId, row: u64, column: u64) -> Vec<u64> {
    let result = Vec<u64>.new();
    let index = match snapshot.source() {
        Some(value) => value,
        None => return result,
    };
    let occurrences = index.occurrences_at(source, row, column);
    defer occurrences.drop();
    for occurrence_id in occurrences {
        let occurrence = &index.occurrences.as_slice()[*occurrence_id];
        match occurrence.target {
            Some(target) => {
                let known = false;
                for previous in result { if *previous == target { known = true; break; } }
                if !known { result.push(target); }
            },
            None => {},
        }
    }
    if result.len() == 0u64 {
        match index.declaration_at(source, row, column) {
            Some(value) => result.push(value),
            None => {},
        }
    }
    result
}

fn target_kind(snapshot: Snapshot&, target: u64) -> DeclKind {
    match snapshot.source() {
        Some(index) => index.decls[target].kind,
        None => DeclKind.Type,
    }
}

fn append_location(dedup: HashMap<String, bool>&, values: Vec<Value>&, snapshot: Snapshot&,
    source: SourceId, span: Span) {
    let key = dedup_key(source, span);
    if dedup.contains(&key) { key.drop(); return; }
    dedup.insert(key, true);
    let value = location_value(snapshot, source, span);
    match value { Value.Null => {}, _ => values.push(value), }
}

fn definition_value(snapshot: Snapshot&, source: SourceId, row: u64, column: u64) -> Value {
    let targets = targets_at(snapshot, source, row, column);
    defer targets.drop();
    let index = match snapshot.source() { Some(value) => value, None => return Value.Null };
    let dedup = HashMap<String, bool>.new();
    defer dedup.drop();
    let values = Vec<Value>.new();
    for target in targets {
        let decl = &index.decls[*target];
        append_location(&dedup, &values, snapshot, decl.source, decl.span.span);
    }
    if values.len() == 0u64 { values.drop(); return Value.Null; }
    if values.len() == 1u64 {
        let single = values.remove(0u64);
        values.drop();
        return single;
    }
    Value.Array(values)
}

fn hover_kind_label(kind: DeclKind) -> str {
    match kind {
        Module => "module", Type => "type", Struct => "struct", Enum => "enum", Trait => "trait",
        TypeParameter => "type parameter", Function => "fn", Method => "fn", Field => "field",
        Variant => "variant", Variable => "let", Parameter => "parameter", Alias => "type",
        Constant => "const",
    }
}

fn symbol_kind_value(kind: DeclKind) -> u64 {
    match kind {
        Function => 12u64,
        Method => 6u64,
        Struct => 23u64,
        Enum => 10u64,
        Trait => 11u64,
        Alias | Type => 5u64,
        Field => 8u64,
        Variant => 22u64,
        Constant => 14u64,
        Module => 2u64,
        _ => 13u64,
    }
}

fn semantic_kind_index(kind: DeclKind) -> u64 {
    match kind {
        Struct => 1u64,
        Enum => 2u64,
        Trait => 3u64,
        TypeParameter => 4u64,
        Function => 5u64,
        Method => 6u64,
        Field => 7u64,
        Variant => 8u64,
        Variable => 9u64,
        Parameter => 10u64,
        _ => 0u64,
    }
}

fn module_name_for_path(snapshot: Snapshot&, path: str) -> Option<String> {
    let package_name = Option<String>.None;
    let package_root = Option<String>.None;
    match snapshot.analysis() {
        Some(analysis) => match analysis.session.package_map() {
            Some(packages) => match packages.package_of(path) {
                Some(package) => {
                    package_name = Option<String>.Some(String.from(&package.name.as_str()));
                    package_root = Option<String>.Some(String.from(&package.source_root.as_str()));
                },
                None => {},
            },
            None => {},
        },
        None => {},
    }

    let file_path = Path.new(path);
    let file_name = match file_path.file_name() {
        Some(value) => value,
        None => { match package_name { Some(value)=>value.drop(), None=>{} } match package_root { Some(value)=>value.drop(), None=>{} } return Option<String>.None; },
    };
    if !file_name.ends_with(".an") {
        match package_name { Some(value)=>value.drop(), None=>{} }
        match package_root { Some(value)=>value.drop(), None=>{} }
        return Option<String>.None;
    }
    let stem = String.from(&file_name);
    let _ = stem.pop();
    let _ = stem.pop();
    let _ = stem.pop();

    let result = String.new();
    match &package_name { Some(name) => { result.push_str(name.as_str()); result.push('.'); }, None => {}, }

    let directories = Vec<String>.new();
    match &package_root {
        Some(root) => {
            let parent = file_path.parent();
            while parent.is_some() {
                let directory = *parent.unwrap();
                if directory.as_str() == root.as_str() { break; }
                match directory.file_name() {
                    Some(name) => directories.push(String.from(&name)),
                    None => { break; },
                }
                parent = directory.parent();
            }
        },
        None => {},
    }

    let directory_index = directories.len();
    while directory_index != 0u64 {
        directory_index -= 1u64;
        result.push_str(directories[directory_index].as_str());
        result.push('.');
    }
    for directory in directories { directory.drop(); }
    directories.drop();
    result.push_str(stem.as_str());
    stem.drop();
    match package_name { Some(value) => value.drop(), None => {}, }
    match package_root { Some(value) => value.drop(), None => {}, }
    Option<String>.Some(result)
}

fn append_hover_origin(snapshot: Snapshot&, contents: String&, source: SourceId) {
    let stdlib = match snapshot.source() {
        Some(index) => index.is_stdlib_source(source),
        None => false,
    };
    if stdlib {
        contents.push_str("\n\n*declared in the standard library*");
        return;
    }
    match snapshot.path(source) {
        Some(path) => match module_name_for_path(snapshot, path) {
            Some(module) => {
                contents.push_str("\n\n*declared in ");
                contents.push_str(module.as_str());
                contents.push('*');
                module.drop();
            },
            None => {},
        },
        None => {},
    }
}

fn hover_value(snapshot: Snapshot&, source: SourceId, row: u64, column: u64) -> Value {
    let targets = targets_at(snapshot, source, row, column);
    defer targets.drop();
    let index = match snapshot.source() { Some(value) => value, None => return Value.Null };
    let contents = String.new();
    let seen = HashMap<String, bool>.new();
    defer seen.drop();
    for target in targets {
        let decl = &index.decls[*target];
        let header = String.new();
        let label = String.from(&hover_kind_label(decl.kind));
        header.push_str(label.as_str());
        label.drop();
        header.push(' ');
        header.push_str(decl.name.as_str());
        match &decl.detail {
            Some(detail) => {
                if decl.kind == DeclKind.Function || decl.kind == DeclKind.Method {
                    header.drop();
                    header.push_str(detail.as_str());
                }
            },
            None => {},
        }
        match &decl.type_text {
            Some(text) => {
                if decl.kind != DeclKind.Function && decl.kind != DeclKind.Method &&
                decl.kind != DeclKind.Struct && decl.kind != DeclKind.Enum && decl.kind != DeclKind.Trait {
                    header.push_str(": ");
                    header.push_str(text.as_str());
                }
            },
            None => {},
        }
        let key = String.from(&header.as_str());
        if !seen.contains(&key) {
            seen.insert(String.from(&header.as_str()), true);
            if contents.as_slice().len() != 0u64 { contents.push_str("\n\n"); }
            contents.push_str("```yian\n\n");
            contents.push_str(header.as_str());
            contents.push_str("\n\n```");
            append_hover_origin(snapshot, &contents, decl.source);
        }
        key.drop();
        header.drop();
    }

    let occurrences = index.occurrences_at(source, row, column);
    defer occurrences.drop();
    for occurrence_id in occurrences {
        let occurrence = &index.occurrences.as_slice()[*occurrence_id];
        let context = match &occurrence.signature {
            Some(value) => Option<String>.Some(String.from(&value.as_str())),
            None => match &occurrence.type_text {
                Some(value) => Option<String>.Some(String.from(&value.as_str())),
                None => Option<String>.None,
            },
        };
        match &context {
            Some(text) => {
                if !seen.contains(text) {
                    seen.insert(String.from(&text.as_str()), true);
                    if contents.as_slice().len() != 0u64 { contents.push_str("\n\n"); }
                    contents.push_str("```yian\n\n");
                    contents.push_str(text.as_str());
                    contents.push_str("\n\n```");
                }
                text.drop();
            },
            None => {},
        }
    }

    if contents.as_slice().len() == 0u64 {
        contents.drop();
        return Value.Null;
    }
    let markup = Object.new();
    json_put(&markup, "kind", Value.String(String.from(&"markdown")));
    json_put(&markup, "value", Value.String(String.from(&contents.as_str())));
    let result = Object.new();
    json_put(&result, "contents", Value.Object(markup));
    let text = match snapshot.text(source) { Some(value) => value, None => "" };
    json_put(&result, "range", protocol_cursor_range(row, column, text));
    contents.drop();
    Value.Object(result)
}

fn references_value(snapshot: Snapshot&, source: SourceId, row: u64, column: u64,
    include_declaration: bool) -> Value {
    let targets = targets_at(snapshot, source, row, column);
    defer targets.drop();
    let index = match snapshot.source() { Some(value) => value, None => return empty_array() };
    let dedup = HashMap<String, bool>.new();
    defer dedup.drop();
    let values = Vec<Value>.new();
    for target in targets {
        let occurrences = index.occurrences_of(*target);
        defer occurrences.drop();
        for occurrence_id in occurrences {
            let occurrence = &index.occurrences.as_slice()[*occurrence_id];
            if !include_declaration && occurrence.is_declaration { continue; }
            append_location(&dedup, &values, snapshot, occurrence.source, occurrence.span.span);
        }
    }
    Value.Array(values)
}

fn highlight_value(snapshot: Snapshot&, source: SourceId, row: u64, column: u64) -> Value {
    let targets = targets_at(snapshot, source, row, column);
    defer targets.drop();
    let index = match snapshot.source() { Some(value) => value, None => return empty_array() };
    let dedup = HashMap<String, bool>.new();
    defer dedup.drop();
    let values = Vec<Value>.new();
    for target in targets {
        let occurrences = index.occurrences_of(*target);
        defer occurrences.drop();
        for occurrence_id in occurrences {
            let occurrence = &index.occurrences.as_slice()[*occurrence_id];
            if occurrence.source != source { continue; }
            let key = dedup_key(source, occurrence.span.span);
            if dedup.contains(&key) { key.drop(); continue; }
            dedup.insert(key, true);
            let text = match snapshot.text(source) { Some(value) => value, None => "" };
            let item = Object.new();
            json_put(&item, "range", protocol_range(occurrence.span.span, text));
            json_put(&item, "kind", Value.Number(Number.Unsigned(if occurrence.is_declaration { 3u64 } else { 2u64 })));
            values.push(Value.Object(item));
        }
    }
    Value.Array(values)
}

fn document_symbols_value(snapshot: Snapshot&, source: SourceId) -> Value {
    let index = match snapshot.source() { Some(value) => value, None => return empty_array() };
    let text = match snapshot.text(source) { Some(value) => value, None => "" };
    let values = Vec<Value>.new();
    let cursor = 0u64;
    while cursor < index.decls.len() {
        let decl = &index.decls[cursor];
        cursor += 1u64;
        if decl.source != source { continue; }
        let include = match decl.kind {
            Function | Method | Struct | Enum | Trait | Alias | Field | Variant | Constant => true,
            _ => false,
        };
        if !include { continue; }
        let rendered = protocol_range(decl.span.span, text);
        let object = Object.new();
        json_put(&object, "name", Value.String(String.from(&decl.name.as_str())));
        json_put(&object, "kind", Value.Number(Number.Unsigned(symbol_kind_value(decl.kind))));
        json_put(&object, "range", rendered.clone());
        json_put(&object, "selectionRange", rendered);
        let detail = match &decl.detail {
            Some(value) => Option<String>.Some(String.from(&value.as_str())),
            None => match &decl.type_text {
                Some(value) => Option<String>.Some(String.from(&value.as_str())),
                None => Option<String>.None,
            },
        };
        match &detail {
            Some(value) => json_put(&object, "detail", Value.String(String.from(&value.as_str()))),
            None => {},
        }
        match detail { Some(value) => value.drop(), None => {}, }
        values.push(Value.Object(object));
    }
    Value.Array(values)
}

fn semantic_tokens_value(snapshot: Snapshot&, source: SourceId) -> Value {
    let index = match snapshot.source() { Some(value) => value, None => return empty_semantic_tokens() };
    let tokens = match index.tokens_of(source) {
        Some(value) => value,
        None => return empty_semantic_tokens(),
    };
    let text = match snapshot.text(source) { Some(value) => value, None => return empty_semantic_tokens() };
    let line_index = LineIndex.new(text);
    defer line_index.drop();

    let declaration_by_start = HashMap<u64, u64>.new();
    defer declaration_by_start.drop();
    let occurrence_cursor = 0u64;
    while occurrence_cursor < index.occurrences.len() {
        let occurrence = &index.occurrences[occurrence_cursor];
        occurrence_cursor += 1u64;
        if occurrence.source != source { continue; }
        let key = occurrence.span.span.start.row * 1000000u64 + occurrence.span.span.start.column;
        match occurrence.target {
            Some(target) => {
                if occurrence.is_declaration {
                    declaration_by_start.insert(key, occurrence_cursor - 1u64);
                } elif declaration_by_start.get(&key).is_none() {
                    declaration_by_start.insert(key, occurrence_cursor - 1u64);
                }
            },
            None => {},
        }
    }

    let data = Vec<Value>.new();
    let previous_line = 0u64;
    let previous_start = 0u64;
    for token in *tokens {
        let span = token.span;
        let kind = match token.kind() {
            Identifier(_) => {
                let key = span.start.row * 1000000u64 + span.start.column;
                match declaration_by_start.get(&key) {
                    Some(occurrence_id) => {
                        let occurrence = &index.occurrences[*occurrence_id];
                        match occurrence.target {
                            Some(target) => {
                                let target_kind = index.decls[target].kind;
                                match target_kind {
                                    Module | Constant | TypeParameter => { continue; },
                                    _ => {},
                                }
                                Option<DeclKind>.Some(target_kind)
                            },
                            None => Option<DeclKind>.None,
                        }
                    },
                    None => Option<DeclKind>.None,
                }
            },
            Keyword(keyword) => {
                let primitive = match keyword {
                    Void | Bool | Char | Str | I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 |
                    F16 | F32 | F64 | Int | Uint | Float => true,
                    _ => false,
                };
                if primitive { Option<DeclKind>.Some(DeclKind.Type) } else { Option<DeclKind>.None }
            },
            _ => Option<DeclKind>.None,
        };
        let resolved = match kind { Some(value) => value, None => continue };
        if span.start.row != span.end.row { continue; }
        let start = line_index.utf16_column(span.start.row, span.start.column);
        let end = line_index.utf16_column(span.end.row, span.end.column);
        let delta_line = span.start.row - previous_line;
        let delta_start = if delta_line == 0u64 { start - previous_start } else { start };
        let declaration = false;
        let default_library = false;
        if let Some(occurrence_id) = declaration_by_start.get(&(span.start.row * 1000000u64 + span.start.column)) {
            let occurrence = &index.occurrences[*occurrence_id];
            declaration = occurrence.is_declaration;
            match occurrence.target {
                Some(target) => default_library = index.is_stdlib_source(index.decls[target].source),
                None => {},
            }
        }
        let modifiers = (if declaration { 1u64 } else { 0u64 }) | (if default_library { 2u64 } else { 0u64 });
        data.push(Value.Number(Number.Unsigned(delta_line)));
        data.push(Value.Number(Number.Unsigned(delta_start)));
        data.push(Value.Number(Number.Unsigned(end - start)));
        data.push(Value.Number(Number.Unsigned(semantic_kind_index(resolved))));
        data.push(Value.Number(Number.Unsigned(modifiers)));
        previous_line = span.start.row;
        previous_start = start;
    }
    let result = Object.new();
    json_put(&result, "data", Value.Array(data));
    Value.Object(result)
}

fn stdlib_path(config: Config&) -> Result<PathBuf, String> {
    match &config.compiler_root {
        Some(root) => {
            let candidate = Path.new(root.as_str()).join("lib/src");
            defer candidate.drop();
            match canonicalize(candidate.as_str()) {
                Ok(path) => Result<PathBuf, String>.Ok(path),
                Err(problem) => {
                    let message = String.from(&"cannot locate standard library: ");
                    message.push_str(problem.msg());
                    problem.drop();
                    Result<PathBuf, String>.Err(message)
                },
            }
        },
        None => match standard_library_root() {
            Ok(path) => Result<PathBuf, String>.Ok(path),
            Err(message) => Result<PathBuf, String>.Err(message),
        },
    }
}

fn parse_open_inputs(value: Value&) -> Result<Vec<OpenInput>, String> {
    let array = match value.as_array() {
        Some(value) => value,
        None => return Result<Vec<OpenInput>, String>.Err(failure("documents must be an array")),
    };
    let inputs = Vec<OpenInput>.new();
    let transferred = false;
    defer { if !transferred { release_open_inputs(&inputs); } };

    for item in *array {
        let object = match item.as_object() {
            Some(value) => value,
            None => return Result<Vec<OpenInput>, String>.Err(failure("document must be an object")),
        };
        let uri = match field_string(object, "uri") {
            Some(value) => value,
            None => return Result<Vec<OpenInput>, String>.Err(failure("document.uri must be a string")),
        };
        let text = match field_string(object, "text") {
            Some(value) => value,
            None => return Result<Vec<OpenInput>, String>.Err(failure("document.text must be a string")),
        };
        let path = match uri_to_path(uri) {
            Ok(value) => value,
            Err(_) => return Result<Vec<OpenInput>, String>.Err(failure("document URI must be a local file URI")),
        };
        defer path.drop();
        let resolved = match resolve(path.as_str()) {
            Ok(value) => value,
            Err(problem) => { problem.drop(); return Result<Vec<OpenInput>, String>.Err(failure("could not resolve document path")); },
        };
        let version = match object.get("version") {
            Some(number) => match number {
                Null => Option<i64>.None,
                Number(value) => match value {
                    Signed(value) => Option<i64>.Some(*value),
                    Unsigned(value) if *value <= 9223372036854775807u64 => Option<i64>.Some(i64(*value)),
                    _ => { resolved.drop(); return Result<Vec<OpenInput>, String>.Err(failure("document.version must be an integer or null")); },
                },
                _ => { resolved.drop(); return Result<Vec<OpenInput>, String>.Err(failure("document.version must be an integer or null")); },
            },
            None => Option<i64>.None,
        };
        inputs.push(OpenInput(path=resolved, text=String.from(&text), version=version));
    }

    transferred = true;
    Result<Vec<OpenInput>, String>.Ok(inputs)
}

fn release_open_inputs(inputs: Vec<OpenInput>&) {
    for input in *inputs { input.drop(); }
    inputs.drop();
}

fn release_paths(paths: Vec<PathBuf>&) {
    for path in *paths { path.drop(); }
    paths.drop();
}

fn release_documents(documents: Vec<SourceDocument>&) {
    for document in *documents { document.drop(); }
    documents.drop();
}

fn overlay_index(inputs: Vec<OpenInput>&, path: str) -> Option<u64> {
    let index = 0u64;
    while index < inputs.len() {
        if inputs[index].path.as_str() == path { return Option<u64>.Some(index); }
        index += 1u64;
    }
    Option<u64>.None
}

fn contains_path(paths: Vec<PathBuf>&, path: str) -> bool {
    let index = 0u64;
    while index < paths.len() {
        let resolved = match resolve(paths[index].as_str()) {
            Ok(value) => value,
            Err(problem) => { problem.drop(); index += 1u64; continue; },
        };
        let equal = resolved.as_str() == path;
        resolved.drop();
        if equal { return true; }
        index += 1u64;
    }
    false
}

fn collect_input_paths(project: Option<Project&>, std_root: str, open: Vec<OpenInput>&)
-> Result<Vec<PathBuf>, String> {
    let paths = match project {
        Some(value) => value.build_files(),
        None => {
            let roots = Vec<String>.new();
            roots.push(String.from(&std_root));
            defer { roots[0].drop(); roots.drop(); };
            let collected = match collect_sources(&roots) {
                Ok(value) => value,
                Err(problem) => {
                    let message = String.from(&"could not collect standard-library sources: ");
                    message.push_str(problem.msg());
                    problem.drop();
                    return Result<Vec<PathBuf>, String>.Err(message);
                },
            };
            let result = Vec<PathBuf>.with_capacity(collected.len());
            for path in collected { result.push(PathBuf.from(path.as_str())); path.drop(); }
            collected.drop();
            result
        },
    };

    for input in *open {
        if input.path.as_str().ends_with(".an") && !contains_path(&paths, input.path.as_str()) {
            paths.push(PathBuf.from(input.path.as_str()));
        }
    }
    Result<Vec<PathBuf>, String>.Ok(paths)
}

fn make_documents(paths: Vec<PathBuf>&, open: Vec<OpenInput>&) -> Result<Vec<SourceDocument>, String> {
    let documents = Vec<SourceDocument>.new();
    let transferred = false;
    defer { if !transferred { release_documents(&documents); } };
    for path in *paths {
        let normalized = match resolve(path.as_str()) {
            Ok(value) => value,
            Err(problem) => { problem.drop(); continue; },
        };
        let overlay = overlay_index(open, normalized.as_str());
        match overlay {
            Some(index) => documents.push(SourceDocument(path=String.from(&normalized.as_str()),
                text=String.from(&open[index].text.as_str()))),
            None => match read_to_string(normalized.as_str()) {
                Ok(text) => {
                    documents.push(SourceDocument(path=String.from(&normalized.as_str()), text=text));
                },
                Err(problem) => problem.drop(),
            },
        }
        normalized.drop();
    }
    transferred = true;
    Result<Vec<SourceDocument>, String>.Ok(documents)
}

fn json_diagnostic(path: String, span: Span, code: str, severity: u64,
    source: str, message: str, text: str) -> Value {
    let uri = match path_to_uri(path.as_str()) {
        Ok(value) => value,
        Err(problem) => { let _ = problem.kind; path.drop(); return Value.Null; },
    };
    defer { uri.drop(); path.drop(); };
    let index = LineIndex.new(text);
    defer index.drop();
    let range = Object.new();
    let start = Object.new();
    json_put(&start, "line", Value.Number(Number.Unsigned(span.start.row)));
    json_put(&start, "character", Value.Number(Number.Unsigned(index.utf16_column(span.start.row, span.start.column))));
    json_put(&range, "start", Value.Object(start));
    let end = Object.new();
    json_put(&end, "line", Value.Number(Number.Unsigned(span.end.row)));
    json_put(&end, "character", Value.Number(Number.Unsigned(index.utf16_column(span.end.row, span.end.column))));
    json_put(&range, "end", Value.Object(end));

    let result = Object.new();
    json_put(&result, "range", Value.Object(range));
    json_put(&result, "severity", Value.Number(Number.Unsigned(severity)));
    json_put(&result, "code", Value.String(String.from(&code)));
    json_put(&result, "source", Value.String(String.from(&source)));
    json_put(&result, "message", Value.String(String.from(&message)));
    Value.Object(result)
}

fn append_grouped(groups: Object&, uri: str, diagnostic: Value) {
    match groups.get(uri) {
        Some(existing) => match existing.as_array() {
            Some(items) => items.push(diagnostic),
            None => diagnostic.drop(),
        },
        None => {
            let values = Vec<Value>.new();
            values.push(diagnostic);
            json_put(groups, uri, Value.Array(values));
        },
    }
}

fn add_analysis_diagnostic(snapshot: Snapshot&, diagnostic: Diagnostic&, groups: Object&) {
    let span = match &diagnostic.location {
        Some(location) => location.span(),
        None => { return; },
    };
    let path = String.new();
    let text = String.new();
    match &diagnostic.location {
        Some(Detached(value, _)) => {
            path.push_str(value.as_str());
            match snapshot.text_for_path(value.as_str()) {
                Some(found) => text.push_str(found),
                None => {},
            }
        },
        Some(Source(value)) => match snapshot.analysis() {
            Some(analysis) => match analysis.session.source(value.source) {
                Some(file) => {
                    path.push_str(file.path());
                    text.push_str(file.text());
                },
                None => {},
            },
            None => {},
        },
        None => {},
    }
    if path.as_slice().len() == 0u64 { path.drop(); text.drop(); return; }
    let severity = match diagnostic.severity {
        Severity.Error => 1u64,
        Severity.Warning => 2u64,
        Severity.Note => 3u64,
    };
    let uri = match path_to_uri(path.as_str()) {
        Ok(value) => value,
        Err(problem) => { let _ = problem.kind; path.drop(); text.drop(); return; },
    };
    let item = json_diagnostic(path, span, diagnostic.code.text(), severity, "yian",
        diagnostic.message.as_str(), text.as_str());
    text.drop();
    if let Value.Null = item { uri.drop(); return; }
    append_grouped(groups, uri.as_str(), item);
    uri.drop();
}

fn snapshot_diagnostics(snapshot: Snapshot&, open: Vec<OpenInput>&, project_diagnostics: Value)
-> Value {
    let groups = Object.new();
    let failure_index = 0u64;
    while failure_index < snapshot.failure_count() {
        match snapshot.failure_diagnostic(failure_index) {
            Some(diagnostic) => add_analysis_diagnostic(snapshot, diagnostic, &groups),
            None => {},
        }
        failure_index += 1u64;
    }
    match snapshot.analysis() {
        Some(analysis) => {
            for warning in analysis.output.warnings {
                add_analysis_diagnostic(snapshot, warning, &groups);
            }
        },
        None => {},
    }
    for document in *open {
        let uri = match path_to_uri(document.path.as_str()) {
            Ok(value) => value,
            Err(problem) => { let _ = problem.kind; continue; },
        };
        if groups.get(uri.as_str()).is_none() { json_put(&groups, uri.as_str(), empty_array()); }
        uri.drop();
    }
    if let Some(project_items) = project_diagnostics.as_array() {
        for record in *project_items {
            if let Some(fields) = record.as_object() {
                match (field_string(fields, "uri"), fields.get("diagnostic")) {
                    (Some(uri), Some(diagnostic)) => append_grouped(&groups, uri, diagnostic.clone()),
                    _ => {},
                }
            }
        }
    }
    let result = Object.new();
    json_put(&result, "diagnostics", Value.Object(groups));
    json_put(&result, "project_diagnostics", project_diagnostics);
    Value.Object(result)
}

pub struct WorkerState {
    std_root: String,
    raw_pointers: bool,
    workspace_root: Option<String>,
    topology_revision: u64,
    project: Option<Project>,
    project_diagnostics: Value,
    snapshot: Option<Snapshot>,
}

impl WorkerState {
    static pub fn new(config: Config&) -> Result<Self, String> {
        let std_root = stdlib_path(config)?;
        let state = Self(
            std_root=String.from(&std_root.as_str()),
            raw_pointers=config.raw_pointers,
            workspace_root=Option<String>.None,
            topology_revision=0u64,
            project=Option<Project>.None,
            project_diagnostics=empty_array(),
            snapshot=Option<Snapshot>.None,
        );
        std_root.drop();
        Result<Self, String>.Ok(state)
    }

    fn reload_project(root: Option<str>) -> Result<(), String> {
        match self.project.take() { Some(value) => value.drop(), None => {}, }
        match &self.workspace_root { Some(value) => value.drop(), None => {}, }
        self.workspace_root = match root { Some(value) => Option<String>.Some(String.from(&value)), None => Option<String>.None };
        self.project_diagnostics.drop();
        self.project_diagnostics = empty_array();

        let root_path = match root {
            Some(value) => value,
            None => return Result<(), String>.Ok(()),
        };
        let found = discover(root_path);
        let project_root = match found {
            Some(value) => value,
            None => return Result<(), String>.Ok(()),
        };
        defer project_root.drop();
        let report = load(project_root.as_str(), self.std_root.as_str());
        let diagnostics = Vec<Value>.new();
        for problem in report.diagnostics() {
            let path = match problem.path() {
                Some(value) => String.from(&value),
                None => String.from(&project_root.as_str()),
            };
            let uri = match path_to_uri(path.as_str()) {
                Ok(value) => value,
                Err(error) => { let _ = error.kind; path.drop(); continue; },
            };
            let range = Object.new();
            let zero = Object.new();
            json_put(&zero, "line", Value.Number(Number.Unsigned(0u64)));
            json_put(&zero, "character", Value.Number(Number.Unsigned(0u64)));
            json_put(&range, "start", Value.Object(zero.clone()));
            json_put(&range, "end", Value.Object(zero));
            let item = Object.new();
            json_put(&item, "range", Value.Object(range));
            json_put(&item, "severity", Value.Number(Number.Unsigned(1u64)));
            json_put(&item, "code", Value.String(String.from(&problem.code())));
            json_put(&item, "source", Value.String(String.from(&"anx")));
            json_put(&item, "message", Value.String(String.from(&problem.message())));
            let record = Object.new();
            json_put(&record, "uri", Value.String(uri));
            json_put(&record, "diagnostic", Value.Object(item));
            diagnostics.push(Value.Object(record));
            path.drop();
        }
        self.project_diagnostics = Value.Array(diagnostics);
        if report.clean() { self.project = report.take_project(); }
        report.drop();
        Result<(), String>.Ok(())
    }

    pub fn synchronize(params: Option<Value>) -> Result<Value, String> {
        let sync_started_ns = timing_now_ns();
        let value = match params {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync is missing params")),
        };
        defer value.drop();
        let object = match value.as_object() {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync params must be an object")),
        };
        let revision = match field_u64(object, "revision") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync revision must be an integer")),
        };
        let topology = match field_u64(object, "topology_revision") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync topology_revision must be an integer")),
        };
        let root = match object.get("workspace_root") {
            Some(value) => match value {
                Null => Option<String>.None,
                String(path) => Option<String>.Some(String.from(&path.as_str())),
                _ => return Result<Value, String>.Err(failure("workspace_root must be a string or null")),
            },
            None => Option<String>.None,
        };
        let root_changed = match &self.workspace_root {
            None => match &root { None => false, Some(_) => true },
            Some(old) => match &root {
                Some(new) => old.as_str() != new.as_str(),
                None => true,
            },
        };
        let project_started_ns = timing_now_ns();
        if root_changed || topology != self.topology_revision {
            let root_text = match &root { Some(path) => Option<str>.Some(path.as_str()), None => Option<str>.None };
            self.reload_project(root_text)?;
            self.topology_revision = topology;
        }
        let project_finished_ns = timing_now_ns();
        match &root { Some(path) => path.drop(), None => {}, }

        let documents_value = match object.get("documents") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync documents are missing")),
        };
        let open = parse_open_inputs(documents_value)?;
        defer release_open_inputs(&open);
        let paths_started_ns = timing_now_ns();
        let paths = collect_input_paths(match &self.project { Some(value) => Option<Project&>.Some(value), None => Option<Project&>.None },
            self.std_root.as_str(), &open)?;
        let paths_finished_ns = timing_now_ns();
        defer release_paths(&paths);
        let documents = make_documents(&paths, &open)?;
        defer release_documents(&documents);
        let freeze_finished_ns = timing_now_ns();
        let trust = match SourceTrust.new(self.std_root.as_str()) {
            Ok(value) => value,
            Err(error) => { error.drop(); return Result<Value, String>.Err(failure("could not classify standard-library sources")); },
        };
        let package_map = match &self.project {
            Some(project) => {
                let encoded = package_map_json(project);
                defer encoded.drop();
                let document = match parse(encoded.as_str()) {
                    Ok(value) => value,
                    Err(_) => return Result<Value, String>.Err(failure("could not encode the package map")),
                };
                defer document.drop();
                match PackageMap.from_document(&document) {
                    Ok(value) => Option<PackageMap>.Some(value),
                    Err(error) => { error.drop(); return Result<Value, String>.Err(failure("could not load the package map")); },
                }
            },
            None => Option<PackageMap>.None,
        };
        let identity = String.new();
        identity.push_str(if self.raw_pointers { "raw" } else { "fat" });
        identity.push(':');
        identity.push_str(self.std_root.as_str());
        let analysis_started_ns = timing_now_ns();
        let next = match Snapshot.analyze(revision, topology, identity.as_str(), &documents,
            trust, package_map, self.raw_pointers, false, self.std_root.as_str()) {
            Ok(value) => value,
            Err(message) => { identity.drop(); return Result<Value, String>.Err(message); },
        };
        identity.drop();
        let analysis_finished_ns = timing_now_ns();
        match self.snapshot.take() { Some(previous) => previous.drop(), None => {}, }
        self.snapshot = Option<Snapshot>.Some(next);
        let snapshot = match &self.snapshot {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("analysis snapshot was not retained")),
        };
        let diagnostics_started_ns = timing_now_ns();
        let mut_result = snapshot_diagnostics(snapshot, &open, self.project_diagnostics.clone());
        let diagnostics_finished_ns = timing_now_ns();
        let output = match mut_result.as_object() {
            Some(result) => {
                json_put(result, "revision", Value.Number(Number.Unsigned(revision)));
                json_put(result, "project_loaded", Value.Boolean(self.project.is_some()));
                json_put(result, "analysis_ready", Value.Boolean(snapshot.ready()));
                let timings = Object.new();
                record_timing(&timings, "project_load_ms", project_started_ns, project_finished_ns);
                record_timing(&timings, "input_path_collection_ms", paths_started_ns, paths_finished_ns);
                record_timing(&timings, "input_freeze_ms", paths_finished_ns, freeze_finished_ns);
                record_timing(&timings, "editor_analyze_ms", analysis_started_ns, analysis_finished_ns);
                record_timing(&timings, "diagnostic_render_ms", diagnostics_started_ns, diagnostics_finished_ns);
                record_timing(&timings, "sync_total_ms", sync_started_ns, diagnostics_finished_ns);
                json_put(result, "analysis_timings", Value.Object(timings));
                mut_result
            },
            None => { mut_result.drop(); return Result<Value, String>.Err(failure("analysis result is invalid")); },
        };
        Result<Value, String>.Ok(output)
    }

    pub fn query(params: Option<Value>) -> Result<Value, WorkerFailure> {
        let payload = match params {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query payload is missing")),
        };
        defer payload.drop();
        let object = match payload.as_object() {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query payload must be an object")),
        };
        let method = match field_string(object, "method") {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query method must be a string")),
        };
        let query_params = match object.get("params") {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query params are missing")),
        };
        let snapshot = match &self.snapshot {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32801i64, "no current analysis snapshot")),
        };
        let ready = snapshot.ready();

        match method {
            "textDocument/definition" => {
                if !ready { return Result<Value, WorkerFailure>.Ok(Value.Null); }
                let position = position_params(snapshot, query_params)?;
                Result<Value, WorkerFailure>.Ok(definition_value(snapshot, position.source, position.row, position.column))
            },
            "textDocument/hover" => {
                if !ready { return Result<Value, WorkerFailure>.Ok(Value.Null); }
                let position = position_params(snapshot, query_params)?;
                Result<Value, WorkerFailure>.Ok(hover_value(snapshot, position.source, position.row, position.column))
            },
            "textDocument/documentSymbol" => {
                if !ready { return Result<Value, WorkerFailure>.Ok(empty_array()); }
                let object = match query_params.as_object() {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "document symbol params must be an object")),
                };
                let document_value = match object.get("textDocument") {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "textDocument is missing")),
                };
                let document = match TextDocumentIdentifier.from_json(document_value) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "textDocument.uri is invalid")),
                };
                defer document.drop();
                let source = query_source(snapshot, document.uri.as_str())?;
                Result<Value, WorkerFailure>.Ok(document_symbols_value(snapshot, source))
            },
            "textDocument/semanticTokens/full" => {
                if !ready { return Result<Value, WorkerFailure>.Ok(empty_semantic_tokens()); }
                let object = match query_params.as_object() {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "semantic token params must be an object")),
                };
                let document_value = match object.get("textDocument") {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "textDocument is missing")),
                };
                let document = match TextDocumentIdentifier.from_json(document_value) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "textDocument.uri is invalid")),
                };
                defer document.drop();
                let source = query_source(snapshot, document.uri.as_str())?;
                Result<Value, WorkerFailure>.Ok(semantic_tokens_value(snapshot, source))
            },
            "textDocument/references" => {
                if !ready { return Result<Value, WorkerFailure>.Ok(empty_array()); }
                let decoded = match ReferenceParams.from_json(query_params) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "invalid reference params")),
                };
                defer decoded.drop();
                let source = query_source(snapshot, decoded.text_document.uri.as_str())?;
                let row = decoded.position.line;
                let column = position_column(snapshot, source, decoded.position);
                Result<Value, WorkerFailure>.Ok(references_value(snapshot, source, row, column,
                    decoded.context.include_declaration))
            },
            "textDocument/documentHighlight" => {
                if !ready { return Result<Value, WorkerFailure>.Ok(empty_array()); }
                let position = position_params(snapshot, query_params)?;
                Result<Value, WorkerFailure>.Ok(highlight_value(snapshot, position.source, position.row, position.column))
            },
            _ => Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32601i64, "unsupported LSP query")),
        }
    }
}

fn position_params(snapshot: Snapshot&, value: Value&) -> Result<QueryPosition, WorkerFailure> {
    let decoded = match TextDocumentPositionParams.from_json(value) {
        Some(value) => value,
        None => return Result<QueryPosition, WorkerFailure>.Err(
            WorkerFailure.new(-32602i64, "invalid text document position params")),
    };
    defer decoded.drop();
    let source = match query_source(snapshot, decoded.text_document.uri.as_str()) {
        Ok(value) => value,
        Err(problem) => return Result<QueryPosition, WorkerFailure>.Err(problem),
    };
    let row = decoded.position.line;
    let column = position_column(snapshot, source, decoded.position);
    Result<QueryPosition, WorkerFailure>.Ok(QueryPosition(source, row, column))
}

struct QueryPosition {
    source: SourceId,
    row: u64,
    column: u64,
}

impl Drop for WorkerState {
    pub fn drop() {
        match self.snapshot.take() { Some(value) => value.drop(), None => {}, }
        match self.project.take() { Some(value) => value.drop(), None => {}, }
        self.std_root.drop();
        match self.workspace_root.take() { Some(value) => value.drop(), None => {}, }
        self.project_diagnostics.drop();
    }
}
