struct OpenInput {
    path: PathBuf,
    text: String,
    version: Option<i64>,
}

struct PreparedRename {
    location: EditorLocation,
    placeholder: String,
}

impl Drop for OpenInput {
    pub fn drop() {
        self.path.drop();
        self.text.drop();
    }
}

fn failure(message: str) -> String { String.from(&message) }

fn timing_now_ns() -> i64 {
    match monotonic_now() {
        Ok(value) => value.nanoseconds(),
        Err(problem) => { problem.drop(); -1i64 },
    }
}

fn record_timing(timings: Object&, name: str, started_ns: i64, finished_ns: i64) {
    if started_ns >= 0i64 && finished_ns >= started_ns {
        timings.insert(name, Value.Number(Number.Float(f64(finished_ns - started_ns) / 1000000.0)));
    }
}

fn field_string(object: Object&, key: str) -> Option<str> {
    match object.get(key) {
        Some(value) => value.as_string(),
        None => Option<str>.None,
    }
}

fn field_u64(object: Object&, key: str) -> Option<u64> {
    match object.get(key) {
        Some(value) => match value {
            Number(number) => match number {
                Unsigned(number) => Option<u64>.Some(*number),
                Signed(number) if *number >= 0i64 => Option<u64>.Some(u64(*number)),
                _ => Option<u64>.None,
            },
            _ => Option<u64>.None,
        },
        None => Option<u64>.None,
    }
}

fn json_put(object: Object&, key: str, value: Value) {
    if let Some(previous) = object.insert(key, value) { previous.drop(); }
}

fn empty_object() -> Value { Value.Object(Object.new()) }
fn empty_array() -> Value { Value.Array(Vec<Value>.new()) }

fn empty_semantic_tokens() -> Value {
    let result = Object.new();
    json_put(&result, "data", empty_array());
    Value.Object(result)
}

pub struct WorkerFailure { pub code: i64, pub message: String }

impl WorkerFailure {
    static fn new(code: i64, message: str) -> Self {
        Self(code=code, message=String.from(&message))
    }
}

impl Drop for WorkerFailure {
    pub fn drop() { self.message.drop(); }
}

fn protocol_position(position: Position) -> Value {
    let value = Object.new();
    json_put(&value, "line", Value.Number(Number.Unsigned(position.line)));
    json_put(&value, "character", Value.Number(Number.Unsigned(position.character)));
    Value.Object(value)
}

fn protocol_range(span: Span, text: str) -> Value {
    let index = LineIndex.new(text);
    defer index.drop();
    let start = Position(line=span.start.row,
        character=index.utf16_column(span.start.row, span.start.column));
    let end = Position(line=span.end.row,
        character=index.utf16_column(span.end.row, span.end.column));
    let result = Object.new();
    json_put(&result, "start", protocol_position(start));
    json_put(&result, "end", protocol_position(end));
    Value.Object(result)
}

fn protocol_cursor_range(row: u64, column: u64, text: str) -> Value {
    let index = LineIndex.new(text);
    defer index.drop();
    let start = Position(line=row, character=index.utf16_column(row, column));
    let end = Position(line=row, character=index.utf16_column(row, column + 1u64));
    let result = Object.new();
    json_put(&result, "start", protocol_position(start));
    json_put(&result, "end", protocol_position(end));
    Value.Object(result)
}

fn source_for_path(snapshot: EditorSnapshot&, path: str) -> Option<SourceId> {
    let target = match resolve(path) {
        Ok(value) => value,
        Err(problem) => { problem.drop(); return Option<SourceId>.None; },
    };
    defer target.drop();
    let manager = snapshot.session().source_manager();
    let index = 0u64;
    while index < manager.len() {
        match manager.get(index) {
            Some(file) if file.canonical_path() == target.as_str() => return Option<SourceId>.Some(SourceId(index)),
            _ => {},
        }
        index += 1u64;
    }
    Option<SourceId>.None
}

fn source_for_canonical_path(snapshot: EditorSnapshot&, path: str) -> Option<SourceId> {
    let manager = snapshot.session().source_manager();
    let index = 0u64;
    while index < manager.len() {
        match manager.get(index) {
            Some(file) if file.canonical_path() == path => return Option<SourceId>.Some(SourceId(index)),
            _ => {},
        }
        index += 1u64;
    }
    Option<SourceId>.None
}

fn query_source(snapshot: EditorSnapshot&, uri: str) -> Result<SourceId, WorkerFailure> {
    let path = match uri_to_path(uri) {
        Ok(value) => value,
        Err(_) => return Result<SourceId, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "text document URI is invalid")),
    };
    defer path.drop();
    match source_for_path(snapshot, path.as_str()) {
        Some(source) => Result<SourceId, WorkerFailure>.Ok(source),
        None => Result<SourceId, WorkerFailure>.Err(WorkerFailure.new(-32801i64, "document is not part of the current analysis snapshot")),
    }
}

fn position_column(snapshot: EditorSnapshot&, source: SourceId, position: Position) -> u64 {
    let text = snapshot.source_text(source).unwrap();
    let index = LineIndex.new(*text);
    defer index.drop();
    index.scalar_column(position.line, position.character)
}

fn text_at_path(snapshot: EditorSnapshot&, path: str) -> String {
    match source_for_path(snapshot, path) {
        Some(source) => match snapshot.source_text(source) {
            Some(text) => String.from(&text),
            None => String.new(),
        },
        None => String.new(),
    }
}

// LSP prepareRename returns a placeholder for any resolved name, even when a later rename is unsafe.
fn prepare_rename_target(snapshot: EditorSnapshot&, source: SourceId, row: u64, column: u64)
-> Option<PreparedRename> {
    match snapshot.resolved_member_at(source, row, column) {
        Some(member) => {
            let path = match snapshot.source_path(member.declaration.source) {
                Some(value) => value,
                None => return Option<PreparedRename>.None,
            };
            let name = String.from(&snapshot.session().names.text(member.name));
            return Option<PreparedRename>.Some(PreparedRename(
                location=EditorLocation(path=String.from(&path), span=member.declaration.span),
                placeholder=name));
        },
        None => {},
    }

    let symbol_id = match snapshot.symbol_at(source, row, column) {
        Some(value) => value,
        None => return Option<PreparedRename>.None,
    };
    let symbol = match snapshot.symbol(symbol_id) {
        Some(value) => value,
        None => return Option<PreparedRename>.None,
    };
    let declaration = match &symbol.span {
        Some(value) => *value,
        None => return Option<PreparedRename>.None,
    };
    let path = match snapshot.source_path(declaration.source) {
        Some(value) => value,
        None => return Option<PreparedRename>.None,
    };
    let name = String.from(&snapshot.session().names.text(symbol.name));
    Option<PreparedRename>.Some(PreparedRename(
        location=EditorLocation(path=String.from(&path), span=declaration.span),
        placeholder=name))
}

fn location_value(snapshot: EditorSnapshot&, location: EditorLocation&) -> Value {
    let uri = match path_to_uri(location.path.as_str()) {
        Ok(value) => value,
        Err(_) => return Value.Null,
    };
    defer uri.drop();
    let text = text_at_path(snapshot, location.path.as_str());
    defer text.drop();
    let result = Object.new();
    json_put(&result, "uri", Value.String(String.from(&uri.as_str())));
    json_put(&result, "range", protocol_range(location.span, text.as_str()));
    Value.Object(result)
}

fn location_text_edit(snapshot: EditorSnapshot&, location: EditorLocation&, new_text: str) -> Value {
    let text = text_at_path(snapshot, location.path.as_str());
    defer text.drop();
    let edit = Object.new();
    json_put(&edit, "range", protocol_range(location.span, text.as_str()));
    json_put(&edit, "newText", Value.String(String.from(&new_text)));
    Value.Object(edit)
}

fn append_location_values(snapshot: EditorSnapshot&, locations: Vec<EditorLocation>,
    output: Vec<Value>&) {
    for location in locations {
        output.push(location_value(snapshot, location));
        location.drop();
    }
    locations.drop();
}

fn code_action_value(snapshot: EditorSnapshot&, fix: EditorImportQuickFix&) -> Value {
    let diagnostic_text = text_at_path(snapshot, fix.diagnostic_location.path.as_str());
    defer diagnostic_text.drop();
    let diagnostic = Object.new();
    json_put(&diagnostic, "range", protocol_range(
        fix.diagnostic_location.span, diagnostic_text.as_str()));
    json_put(&diagnostic, "code", Value.String(String.from(&fix.diagnostic_code.as_str())));
    json_put(&diagnostic, "source", Value.String(String.from(&"yian")));
    json_put(&diagnostic, "message", Value.String(String.from(&fix.diagnostic_message.as_str())));

    let changes = Object.new();
    append_workspace_edit(snapshot, &changes, &fix.edit_location, "");
    let edit = Object.new();
    json_put(&edit, "changes", Value.Object(changes));

    let diagnostics = Vec<Value>.new();
    diagnostics.push(Value.Object(diagnostic));
    let action = Object.new();
    json_put(&action, "title", Value.String(String.from(&fix.title.as_str())));
    json_put(&action, "kind", Value.String(String.from(&"quickfix")));
    json_put(&action, "diagnostics", Value.Array(diagnostics));
    json_put(&action, "edit", Value.Object(edit));
    Value.Object(action)
}

fn document_highlight_value(snapshot: EditorSnapshot&, location: EditorLocation&,
    declaration_path: Option<String>&, declaration_span: Option<Span>) -> Value {
    let text = text_at_path(snapshot, location.path.as_str());
    defer text.drop();
    let highlight = Object.new();
    json_put(&highlight, "range", protocol_range(location.span, text.as_str()));
    let is_declaration = false;
    if let Some(path) = &declaration_path {
        if let Some(span) = declaration_span {
            is_declaration = path.as_str() == location.path.as_str() &&
            span.start.row == location.span.start.row &&
            span.start.column == location.span.start.column &&
            span.end.row == location.span.end.row &&
            span.end.column == location.span.end.column;
        }
    }
    json_put(&highlight, "kind", Value.Number(Number.Unsigned(if is_declaration { 3u64 } else { 2u64 })));
    Value.Object(highlight)
}

fn append_workspace_edit(snapshot: EditorSnapshot&, changes: Object&,
    location: EditorLocation&, new_text: str) {
    let uri = match path_to_uri(location.path.as_str()) {
        Ok(value) => value,
        Err(problem) => { let _ = problem.kind; return; },
    };
    let edit = location_text_edit(snapshot, location, new_text);
    match changes.get(uri.as_str()) {
        Some(existing) => match existing.as_array() {
            Some(edits) => edits.push(edit),
            None => edit.drop(),
        },
        None => {
            let edits = Vec<Value>.new();
            edits.push(edit);
            json_put(changes, uri.as_str(), Value.Array(edits));
        },
    }
    uri.drop();
}

fn semantic_tokens_value(snapshot: EditorSnapshot&, source: SourceId)
-> Result<Value, WorkerFailure> {
    let tokens = match semantic_tokens(snapshot, source) {
        Ok(value) => value,
        Err(error) => {
            error.drop();
            return Result<Value, WorkerFailure>.Err(
                WorkerFailure.new(-32603i64, "semantic token query failed"));
        },
    };
    let text = match snapshot.source_text(source) {
        Some(value) => value,
        None => { tokens.drop(); return Result<Value, WorkerFailure>.Ok(empty_semantic_tokens()); },
    };
    let index = LineIndex.new(text);
    defer index.drop();

    let data = Vec<Value>.with_capacity(tokens.len() * 5u64);
    let previous_line = 0u64;
    let previous_start = 0u64;
    for token in tokens {
        let span = token.location.span;
        if span.start.row != span.end.row { continue; }
        let line = span.start.row;
        let start = index.utf16_column(line, span.start.column);
        let end = index.utf16_column(line, span.end.column);
        let delta_line = line - previous_line;
        let delta_start = if delta_line == 0u64 { start - previous_start } else { start };
        let modifiers = (if token.declaration { 1u64 } else { 0u64 }) |
        (if token.default_library { 2u64 } else { 0u64 });
        data.push(Value.Number(Number.Unsigned(delta_line)));
        data.push(Value.Number(Number.Unsigned(delta_start)));
        data.push(Value.Number(Number.Unsigned(end - start)));
        data.push(Value.Number(Number.Unsigned(semantic_kind_index(token.kind))));
        data.push(Value.Number(Number.Unsigned(modifiers)));
        previous_line = line;
        previous_start = start;
    }
    tokens.drop();
    let result = Object.new();
    json_put(&result, "data", Value.Array(data));
    Result<Value, WorkerFailure>.Ok(Value.Object(result))
}

fn completion_kind_value(kind: EditorCompletionKind) -> u64 {
    match kind {
        EditorCompletionKind.Method => 2u64,
        EditorCompletionKind.Function => 3u64,
        EditorCompletionKind.Field => 5u64,
        EditorCompletionKind.Variable | EditorCompletionKind.Parameter => 6u64,
        EditorCompletionKind.Struct => 22u64,
        EditorCompletionKind.Enum => 13u64,
        EditorCompletionKind.Trait => 8u64,
        EditorCompletionKind.Alias => 7u64,
        EditorCompletionKind.Constant => 21u64,
        EditorCompletionKind.Module | EditorCompletionKind.Package => 9u64,
        EditorCompletionKind.Variant => 20u64,
        EditorCompletionKind.Primitive => 14u64,
        EditorCompletionKind.TypeParameter => 25u64,
        EditorCompletionKind.Text => 1u64,
    }
}

fn symbol_kind_value(kind: EditorDocumentSymbolKind) -> u64 {
    match kind {
        EditorDocumentSymbolKind.Function => 12u64,
        EditorDocumentSymbolKind.Method => 6u64,
        EditorDocumentSymbolKind.Struct => 23u64,
        EditorDocumentSymbolKind.Enum => 10u64,
        EditorDocumentSymbolKind.Trait => 11u64,
        EditorDocumentSymbolKind.Alias => 5u64,
        EditorDocumentSymbolKind.Field => 8u64,
        EditorDocumentSymbolKind.Variant => 22u64,
    }
}

fn semantic_kind_index(kind: EditorSemanticKind) -> u64 {
    match kind {
        EditorSemanticKind.Type => 0u64,
        EditorSemanticKind.Struct => 1u64,
        EditorSemanticKind.Enum => 2u64,
        EditorSemanticKind.Trait => 3u64,
        EditorSemanticKind.TypeParameter => 4u64,
        EditorSemanticKind.Function => 5u64,
        EditorSemanticKind.Method => 6u64,
        EditorSemanticKind.Field => 7u64,
        EditorSemanticKind.Variant => 8u64,
        EditorSemanticKind.Variable => 9u64,
        EditorSemanticKind.Parameter => 10u64,
    }
}

fn symbol_label(kind: EditorMemberKind) -> str {
    match kind { Field => "field", Variant => "variant", Method => "fn" }
}

struct QueryPosition {
    source: SourceId,
    row: u64,
    column: u64,
}

fn position_params(snapshot: EditorSnapshot&, value: Value&) -> Result<QueryPosition, WorkerFailure> {
    let decoded = match TextDocumentPositionParams.from_json(value) {
        Some(value) => value,
        None => return Result<QueryPosition, WorkerFailure>.Err(
            WorkerFailure.new(-32602i64, "invalid text document position params")),
    };
    defer decoded.drop();
    let source = match query_source(snapshot, decoded.text_document.uri.as_str()) {
        Ok(value) => value,
        Err(problem) => return Result<QueryPosition, WorkerFailure>.Err(problem),
    };
    let row = decoded.position.line;
    let column = position_column(snapshot, source, decoded.position);
    Result<QueryPosition, WorkerFailure>.Ok(QueryPosition(source, row, column))
}

fn hover_symbol_kind(kind: SymbolKind) -> str {
    match kind {
        Type => "type",
        Function => "fn",
        Variable => "let",
        Parameter => "parameter",
        Constant => "const",
        Alias => "type",
        Module => "module",
    }
}

fn source_is_stdlib(snapshot: EditorSnapshot&, source: SourceId) -> bool {
    let index = 0u64;
    while index < snapshot.session().len() {
        match snapshot.session().unit(UnitId(index)) {
            Some(unit) if unit.source == source => return unit.is_stdlib,
            _ => {},
        }
        index += 1u64;
    }
    false
}

fn module_name_for_path(snapshot: EditorSnapshot&, path: str) -> Option<String> {
    let package_name = Option<String>.None;
    let package_root = Option<String>.None;

    match snapshot.session().package_map() {
        Some(packages) => match packages.package_of(path) {
            Some(package) => {
                package_name = Option<String>.Some(String.from(&package.name.as_str()));
                package_root = Option<String>.Some(String.from(&package.source_root.as_str()));
            },
            None => {},
        },
        None => {},
    }

    let file_path = Path.new(path);
    let file_name = match file_path.file_name() {
        Some(value) => value,
        None => return Option<String>.None,
    };
    if !file_name.ends_with(".an") { return Option<String>.None; }
    let stem = String.from(&file_name);
    let _ = stem.pop();
    let _ = stem.pop();
    let _ = stem.pop();

    let result = String.new();
    match package_name {
        Some(name) => { result.push_str(name.as_str()); result.push('.'); name.drop(); },
        None => {},
    }

    let directories = Vec<String>.new();
    match &package_root {
        Some(root) => {
            let parent = file_path.parent();
            while parent.is_some() {
                let directory = *parent.unwrap();
                if directory.as_str() == root.as_str() { break; }
                match directory.file_name() {
                    Some(name) => directories.push(String.from(&name)),
                    None => break
                }
                parent = directory.parent();
            }
        },
        None => {},
    }

    let directory_index = directories.len();
    while directory_index != 0u64 {
        directory_index -= 1u64;
        result.push_str(directories[directory_index].as_str());
        result.push('.');
    }
    for directory in directories { directory.drop(); }
    directories.drop();

    result.push_str(stem.as_str());
    stem.drop();
    match package_root {
        Some(root) => root.drop(),
        None => {},
    }
    Option<String>.Some(result)
}

fn append_hover_origin(snapshot: EditorSnapshot&, contents: String&, path: str) {
    match source_for_canonical_path(snapshot, path) {
        Some(source) if source_is_stdlib(snapshot, source) => {
            contents.push_str("\n\n*declared in the standard library*");
        },
        Some(_) => match module_name_for_path(snapshot, path) {
            Some(module) => {
                contents.push_str("\n\n*declared in ");
                contents.push_str(module.as_str());
                contents.push('*');
                module.drop();
            },
            None => {},
        },
        _ => {},
    }
}

fn hover_value(snapshot: EditorSnapshot&, info: EditorHoverInfo, source: SourceId,
    row: u64, column: u64) -> Value {
    let contents = String.new();
    let duplicate_type = false;
    match &info.symbol {
        Some(symbol) => {
            contents.push_str("```yian\n\n");
            contents.push_str(hover_symbol_kind(symbol.kind));
            contents.push(' ');
            contents.push_str(symbol.name.as_str());
            contents.push_str(": ");
            contents.push_str(symbol.type_text.as_str());
            contents.push_str("\n\n```");
            match &symbol.location {
                Some(location) => append_hover_origin(snapshot, &contents, location.path.as_str()),
                None => {},
            }
            duplicate_type = true;
        },
        None => {},
    }
    match &info.member {
        Some(member) => {
            if contents.as_slice().len() != 0u64 { contents.push_str("\n\n"); }
            contents.push_str("```yian\n\n");
            contents.push_str(symbol_label(member.kind));
            contents.push(' ');
            contents.push_str(member.name.as_str());
            contents.push_str(": ");
            contents.push_str(member.type_text.as_str());
            contents.push_str("\n\n```");
            match &member.location {
                Some(location) => append_hover_origin(snapshot, &contents, location.path.as_str()),
                None => {},
            }
            duplicate_type = true;
        },
        None => {},
    }
    match &info.expression_type {
        Some(value) if !duplicate_type => {
            if contents.as_slice().len() != 0u64 { contents.push_str("\n\n"); }
            contents.push('`');
            contents.push_str(value.as_str());
            contents.push('`');
        },
        _ => {},
    }
    if contents.as_slice().len() == 0u64 {
        contents.drop();
        info.drop();
        return Value.Null;
    }
    let markup = Object.new();
    json_put(&markup, "kind", Value.String(String.from(&"markdown")));
    json_put(&markup, "value", Value.String(String.from(&contents.as_str())));
    let result = Object.new();
    json_put(&result, "contents", Value.Object(markup));
    let source_text = snapshot.source_text(source).unwrap();
    let text = String.from(source_text);
    json_put(&result, "range", protocol_cursor_range(row, column, text.as_str()));
    text.drop();
    contents.drop();
    info.drop();
    Value.Object(result)
}

fn document_symbols_value(snapshot: EditorSnapshot&, source: SourceId)
-> Result<Value, WorkerFailure> {
    let symbols = match snapshot.document_symbols(source) {
        Ok(value) => value,
        Err(error) => {
            error.drop();
            return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32603i64, "document symbol query failed"));
        },
    };
    let result = Vec<Value>.with_capacity(symbols.len());
    for symbol in symbols {
        let source_text = snapshot.source_text(source).unwrap();
        let text = String.from(source_text);
        let rendered_range = protocol_range(symbol.location.span, text.as_str());
        text.drop();
        let object = Object.new();
        json_put(&object, "name", Value.String(String.from(&symbol.name.as_str())));
        json_put(&object, "kind", Value.Number(Number.Unsigned(symbol_kind_value(symbol.kind))));
        json_put(&object, "range", rendered_range.clone());
        json_put(&object, "selectionRange", rendered_range);
        match &symbol.detail {
            Some(detail) => json_put(&object, "detail", Value.String(String.from(&detail.as_str()))),
            None => {},
        }
        result.push(Value.Object(object));
        symbol.drop();
    }
    symbols.drop();
    Result<Value, WorkerFailure>.Ok(Value.Array(result))
}

fn completion_value(snapshot: EditorSnapshot&, completion: EditorCompletionResult) -> Value {
    let output = Object.new();
    json_put(&output, "isIncomplete", Value.Boolean(completion.completeness == QueryCompleteness.Partial));
    let items = Vec<Value>.with_capacity(completion.items.len());
    for item in completion.items {
        let inserted = String.from(&item.label.as_str());
        let snippet = item.parameter_labels.len() != 0u64;
        if snippet {
            inserted.push('(');
            let index = 0u64;
            for parameter in item.parameter_labels {
                if index != 0u64 { inserted.push_str(", "); }
                let number = (index + 1u64).to_string();
                inserted.push_str("${");
                inserted.push_str(number.as_str());
                inserted.push(':');
                inserted.push_str(parameter.as_str());
                inserted.push('}');
                index += 1u64;
                number.drop();
            }
            inserted.push(')');
        }
        let object = Object.new();
        json_put(&object, "label", Value.String(String.from(&item.label.as_str())));
        json_put(&object, "kind", Value.Number(Number.Unsigned(completion_kind_value(item.kind))));
        match &item.detail {
            Some(value) => json_put(&object, "detail", Value.String(String.from(&value.as_str()))),
            None => {},
        }
        json_put(&object, "insertText", Value.String(String.from(&inserted.as_str())));
        json_put(&object, "insertTextFormat", Value.Number(Number.Unsigned(if snippet { 2u64 } else { 1u64 })));
        if let Some(location) = &completion.replace {
            let text = text_at_path(snapshot, location.path.as_str());
            let edit = Object.new();
            json_put(&edit, "range", protocol_range(location.span, text.as_str()));
            json_put(&edit, "newText", Value.String(String.from(&inserted.as_str())));
            text.drop();
            json_put(&object, "textEdit", Value.Object(edit));
        }
        items.push(Value.Object(object));
        inserted.drop();
    }
    completion.drop();
    json_put(&output, "items", Value.Array(items));
    Value.Object(output)
}

fn signature_parameter_label(signature_text: str, parameter_name: str, wanted: u64) -> String {
    let bytes: u8[] = signature_text.as_slice();
    let open = 0u64;
    while open < bytes.len() && bytes[open] != b'(' { open += 1u64; }
    if open == bytes.len() { return String.from(&parameter_name); }

    let segment_start = open + 1u64;
    let segment_index = 0u64;
    let segment_end = segment_start;
    let colon = Option<u64>.None;
    let parens = 0u64;
    let angles = 0u64;
    let brackets = 0u64;
    let index = segment_start;
    while index < bytes.len() {
        let byte = bytes[index];
        if byte == b'(' { parens += 1u64; } elif byte == b')' {
            if parens == 0u64 {
                if segment_index == wanted { segment_end = index; break; }
                return String.from(&parameter_name);
            }
            parens -= 1u64;
        } elif byte == b'<' { angles += 1u64; } elif byte == b'>' && angles != 0u64 { angles -= 1u64; } elif byte == b'[' { brackets += 1u64; } elif byte == b']' && brackets != 0u64 { brackets -= 1u64; } elif byte == b':' && parens == 0u64 && angles == 0u64 && brackets == 0u64 {
            colon = Option<u64>.Some(index);
        } elif byte == b',' && parens == 0u64 && angles == 0u64 && brackets == 0u64 {
            if segment_index == wanted { segment_end = index; break; }
            segment_index += 1u64;
            segment_start = index + 1u64;
            colon = Option<u64>.None;
        }
        index += 1u64;
    }

    let result = String.from(&parameter_name);
    match colon {
        Some(separator) if separator < segment_end => {
            let type_start = if separator + 1u64 < segment_end && bytes[separator + 1u64] == b' ' {
                separator + 2u64
            } else {
                separator + 1u64
            };
            result.push_str(": ");
            let type_bytes = Vec<u8>.with_capacity(segment_end - type_start);
            let offset = type_start;
            while offset < segment_end {
                type_bytes.push(bytes[offset]);
                offset += 1u64;
            }
            result.push_str(str.from_slice_unchecked(type_bytes.as_slice()));
            type_bytes.drop();
        },
        _ => {},
    }
    result
}

fn signature_value(help: EditorSignatureHelp) -> Value {
    let parameter_values = Vec<Value>.with_capacity(help.parameter_labels.len());
    let parameter_index = 0u64;
    for label in help.parameter_labels {
        let parameter = Object.new();
        let rendered = signature_parameter_label(help.label.as_str(), label.as_str(), parameter_index);
        json_put(&parameter, "label", Value.String(rendered));
        parameter_values.push(Value.Object(parameter));
        parameter_index += 1u64;
    }
    let signature = Object.new();
    json_put(&signature, "label", Value.String(String.from(&help.label.as_str())));
    json_put(&signature, "activeParameter", Value.Null);
    json_put(&signature, "parameters", Value.Array(parameter_values));
    let signatures = Vec<Value>.new();
    signatures.push(Value.Object(signature));
    let result = Object.new();
    json_put(&result, "signatures", Value.Array(signatures));
    json_put(&result, "activeSignature", Value.Number(Number.Unsigned(0u64)));
    json_put(&result, "activeParameter", Value.Number(Number.Unsigned(help.active_parameter)));
    help.drop();
    Value.Object(result)
}

fn stdlib_path(config: Config&) -> Result<PathBuf, String> {
    match &config.compiler_root {
        Some(root) => {
            let candidate = Path.new(root.as_str()).join("lib/src");
            defer candidate.drop();
            match canonicalize(candidate.as_str()) {
                Ok(path) => Result<PathBuf, String>.Ok(path),
                Err(problem) => {
                    let message = String.from(&"cannot locate standard library: ");
                    message.push_str(problem.msg());
                    problem.drop();
                    Result<PathBuf, String>.Err(message)
                },
            }
        },
        None => match standard_library_root() {
            Ok(path) => Result<PathBuf, String>.Ok(path),
            Err(message) => Result<PathBuf, String>.Err(message),
        },
    }
}

fn parse_open_inputs(value: Value&) -> Result<Vec<OpenInput>, String> {
    let array = match value.as_array() {
        Some(value) => value,
        None => return Result<Vec<OpenInput>, String>.Err(failure("documents must be an array")),
    };
    let inputs = Vec<OpenInput>.new();
    let transferred = false;
    defer { if !transferred { release_open_inputs(&inputs); } };

    for item in *array {
        let object = match item.as_object() {
            Some(value) => value,
            None => return Result<Vec<OpenInput>, String>.Err(failure("document must be an object")),
        };
        let uri = match field_string(object, "uri") {
            Some(value) => value,
            None => return Result<Vec<OpenInput>, String>.Err(failure("document.uri must be a string")),
        };
        let text = match field_string(object, "text") {
            Some(value) => value,
            None => return Result<Vec<OpenInput>, String>.Err(failure("document.text must be a string")),
        };
        let path = match uri_to_path(uri) {
            Ok(value) => value,
            Err(problem) => { let _ = problem.kind; return Result<Vec<OpenInput>, String>.Err(failure("document URI must be a local file URI")); },
        };
        defer path.drop();
        let resolved = match resolve(path.as_str()) {
            Ok(value) => value,
            Err(problem) => {
                problem.drop();
                return Result<Vec<OpenInput>, String>.Err(failure("could not resolve document path"));
            },
        };
        let version = match object.get("version") {
            Some(number) => match number {
                Null => Option<i64>.None,
                Number(value) => match value {
                    Signed(value) => Option<i64>.Some(*value),
                    Unsigned(value) if *value <= 9223372036854775807u64 => Option<i64>.Some(i64(*value)),
                    _ => { resolved.drop(); return Result<Vec<OpenInput>, String>.Err(failure("document.version must be an integer or null")); },
                },
                _ => { resolved.drop(); return Result<Vec<OpenInput>, String>.Err(failure("document.version must be an integer or null")); },
            },
            None => Option<i64>.None,
        };
        inputs.push(OpenInput(path=resolved, text=String.from(&text), version=version));
    }

    transferred = true;
    Result<Vec<OpenInput>, String>.Ok(inputs)
}

fn release_open_inputs(inputs: Vec<OpenInput>&) {
    for input in *inputs { input.drop(); }
    inputs.drop();
}

fn release_paths(paths: Vec<PathBuf>&) {
    for path in *paths { path.drop(); }
    paths.drop();
}

fn overlay_index(inputs: Vec<OpenInput>&, path: str) -> Option<u64> {
    let index = 0u64;
    while index < inputs.len() {
        if inputs[index].path.as_str() == path { return Option<u64>.Some(index); }
        index += 1u64;
    }
    Option<u64>.None
}

fn contains_path(paths: Vec<PathBuf>&, path: str) -> bool {
    let index = 0u64;
    while index < paths.len() {
        let resolved = match resolve(paths[index].as_str()) {
            Ok(value) => value,
            Err(problem) => { problem.drop(); index += 1u64; continue; },
        };
        let equal = resolved.as_str() == path;
        resolved.drop();
        if equal { return true; }
        index += 1u64;
    }
    false
}

fn collect_input_paths(project: Option<Project&>, std_root: str, open: Vec<OpenInput>&)
-> Result<Vec<PathBuf>, String> {
    let paths = match project {
        Some(value) => value.build_files(),
        None => {
            let roots = Vec<String>.new();
            roots.push(String.from(&std_root));
            defer { roots[0].drop(); roots.drop(); };
            let collected = match collect_sources(&roots) {
                Ok(value) => value,
                Err(problem) => {
                    let message = String.from(&"could not collect standard-library sources: ");
                    message.push_str(problem.msg());
                    problem.drop();
                    return Result<Vec<PathBuf>, String>.Err(message);
                },
            };
            let result = Vec<PathBuf>.with_capacity(collected.len());
            for path in collected { result.push(PathBuf.from(path.as_str())); path.drop(); }
            collected.drop();
            result
        },
    };

    for input in *open {
        if input.path.as_str().ends_with(".an") && !contains_path(&paths, input.path.as_str()) {
            paths.push(PathBuf.from(input.path.as_str()));
        }
    }
    Result<Vec<PathBuf>, String>.Ok(paths)
}

fn make_frozen_inputs(paths: Vec<PathBuf>&, open: Vec<OpenInput>&, revision: u64,
    topology_revision: u64, configuration_identity: str) -> Result<FrozenInputs, String> {
    let frozen = FrozenInputs.new(revision, topology_revision, configuration_identity);
    let completed = false;
    defer { if !completed { frozen.drop(); } };

    for path in *paths {
        let normalized = match resolve(path.as_str()) {
            Ok(value) => value,
            Err(problem) => { problem.drop(); continue; },
        };
        let overlay = overlay_index(open, normalized.as_str());
        match overlay {
            Some(index) => frozen.add(normalized.as_str(), open[index].text.as_str(), open[index].version),
            None => match read_to_string(normalized.as_str()) {
                Ok(text) => { frozen.add(normalized.as_str(), text.as_str(), Option<i64>.None); text.drop(); },
                Err(problem) => problem.drop(),
            },
        }
        normalized.drop();
    }
    completed = true;
    Result<FrozenInputs, String>.Ok(frozen)
}

fn json_diagnostic(location: String, span: Span, code: str, severity: u64,
    source: str, message: str, text: str) -> Value {
    let uri = match path_to_uri(location.as_str()) {
        Ok(value) => value,
        Err(problem) => { let _ = problem.kind; location.drop(); return Value.Null; },
    };
    defer { uri.drop(); location.drop(); };
    let index = LineIndex.new(text);
    defer index.drop();
    let range = Object.new();
    let start = Object.new();
    json_put(&start, "line", Value.Number(Number.Unsigned(span.start.row)));
    json_put(&start, "character", Value.Number(Number.Unsigned(index.utf16_column(span.start.row, span.start.column))));
    json_put(&range, "start", Value.Object(start));
    let end = Object.new();
    json_put(&end, "line", Value.Number(Number.Unsigned(span.end.row)));
    json_put(&end, "character", Value.Number(Number.Unsigned(index.utf16_column(span.end.row, span.end.column))));
    json_put(&range, "end", Value.Object(end));

    let result = Object.new();
    json_put(&result, "range", Value.Object(range));
    json_put(&result, "severity", Value.Number(Number.Unsigned(severity)));
    json_put(&result, "code", Value.String(String.from(&code)));
    json_put(&result, "source", Value.String(String.from(&source)));
    json_put(&result, "message", Value.String(String.from(&message)));
    Value.Object(result)
}

fn append_grouped(groups: Object&, uri: str, diagnostic: Value) {
    match groups.get(uri) {
        Some(existing) => match existing.as_array() {
            Some(items) => items.push(diagnostic),
            None => diagnostic.drop(),
        },
        None => {
            let values = Vec<Value>.new();
            values.push(diagnostic);
            json_put(groups, uri, Value.Array(values));
        },
    }
}

fn add_analysis_diagnostic(snapshot: EditorSnapshot&, diagnostic: Diagnostic&, groups: Object&) {
    let span = match &diagnostic.location {
        Some(location) => location.span(),
        None => { return; },
    };
    let path = match &diagnostic.location {
        Some(DiagnosticLocation.Source(value)) => match snapshot.source_path(value.source) {
            Some(value) => String.from(&value),
            None => { return; },
        },
        Some(DiagnosticLocation.Detached(path, _)) => String.from(&path.as_str()),
        None => { return; },
    };
    let text = match &diagnostic.location {
        Some(DiagnosticLocation.Source(value)) => match snapshot.source_text(value.source) {
            Some(value) => String.from(&value),
            None => String.new(),
        },
        _ => String.new(),
    };
    let severity = match diagnostic.severity {
        Severity.Error => 1u64,
        Severity.Warning => 2u64,
        Severity.Note => 3u64,
    };
    let uri = match path_to_uri(path.as_str()) {
        Ok(value) => value,
        Err(problem) => { let _ = problem.kind; path.drop(); text.drop(); return; },
    };
    let item = json_diagnostic(path, span, diagnostic.code.text(), severity, "yian",
        diagnostic.message.as_str(), text.as_str());
    text.drop();
    if let Value.Null = item { uri.drop(); return; }
    append_grouped(groups, uri.as_str(), item);
    uri.drop();
}

fn snapshot_diagnostics(snapshot: EditorSnapshot&, open: Vec<OpenInput>&, project_diagnostics: Value)
-> Value {
    let groups = Object.new();
    let index = 0u64;
    while index < snapshot.diagnostic_count() {
        if let Some(item) = snapshot.diagnostic(index) { add_analysis_diagnostic(snapshot, item, &groups); }
        index += 1u64;
    }
    for document in *open {
        let uri = match path_to_uri(document.path.as_str()) {
            Ok(value) => value,
            Err(problem) => { let _ = problem.kind; continue; },
        };
        if groups.get(uri.as_str()).is_none() { json_put(&groups, uri.as_str(), empty_array()); }
        uri.drop();
    }
    if let Some(project_items) = project_diagnostics.as_array() {
        for record in *project_items {
            if let Some(fields) = record.as_object() {
                match (field_string(fields, "uri"), fields.get("diagnostic")) {
                    (Some(uri), Some(diagnostic)) => append_grouped(&groups, uri, diagnostic.clone()),
                    _ => {},
                }
            }
        }
    }
    let result = Object.new();
    json_put(&result, "diagnostics", Value.Object(groups));
    json_put(&result, "project_diagnostics", project_diagnostics);
    Value.Object(result)
}

pub struct WorkerState {
    std_root: String,
    raw_pointers: bool,
    workspace_root: Option<String>,
    topology_revision: u64,
    project: Option<Project>,
    project_diagnostics: Value,
    snapshot: Option<EditorSnapshot>,
}

impl WorkerState {
    static pub fn new(config: Config&) -> Result<Self, String> {
        let std_root = stdlib_path(config)?;
        let state = Self(
            std_root=String.from(&std_root.as_str()),
            raw_pointers=config.raw_pointers,
            workspace_root=Option<String>.None,
            topology_revision=0u64,
            project=Option<Project>.None,
            project_diagnostics=empty_array(),
            snapshot=Option<EditorSnapshot>.None,
        );
        std_root.drop();
        Result<Self, String>.Ok(state)
    }

    fn reload_project(root: Option<str>) -> Result<(), String> {
        match self.project.take() { Some(value) => value.drop(), None => {}, }
        match &self.workspace_root { Some(value) => value.drop(), None => {}, }
        self.workspace_root = match root { Some(value) => Option<String>.Some(String.from(&value)), None => Option<String>.None };
        self.project_diagnostics.drop();
        self.project_diagnostics = empty_array();

        let root_path = match root {
            Some(value) => value,
            None => return Result<(), String>.Ok(()),
        };
        let found = discover(root_path);
        let project_root = match found {
            Some(value) => value,
            None => return Result<(), String>.Ok(()),
        };
        defer project_root.drop();
        let report = load(project_root.as_str(), self.std_root.as_str());
        let diagnostics = Vec<Value>.new();
        for problem in report.diagnostics() {
            let path = match problem.path() {
                Some(value) => String.from(&value),
                None => String.from(&project_root.as_str()),
            };
            let uri = match path_to_uri(path.as_str()) {
                Ok(value) => value,
                Err(error) => { let _ = error.kind; path.drop(); continue; },
            };
            let range = Object.new();
            let zero = Object.new();
            json_put(&zero, "line", Value.Number(Number.Unsigned(0u64)));
            json_put(&zero, "character", Value.Number(Number.Unsigned(0u64)));
            json_put(&range, "start", Value.Object(zero.clone()));
            json_put(&range, "end", Value.Object(zero));
            let item = Object.new();
            json_put(&item, "range", Value.Object(range));
            json_put(&item, "severity", Value.Number(Number.Unsigned(1u64)));
            json_put(&item, "code", Value.String(String.from(&problem.code())));
            json_put(&item, "source", Value.String(String.from(&"anx")));
            json_put(&item, "message", Value.String(String.from(&problem.message())));
            let record = Object.new();
            json_put(&record, "uri", Value.String(uri));
            json_put(&record, "diagnostic", Value.Object(item));
            diagnostics.push(Value.Object(record));
            path.drop();
        }
        self.project_diagnostics = Value.Array(diagnostics);
        if report.clean() {
            self.project = report.take_project();
        }
        report.drop();
        Result<(), String>.Ok(())
    }

    pub fn syntax(params: Option<Value>) -> Result<Value, String> {
        let value = match params {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/syntax is missing params")),
        };
        defer value.drop();
        let object = match value.as_object() {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/syntax params must be an object")),
        };
        let revision = match field_u64(object, "revision") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/syntax revision must be an integer")),
        };
        let topology = match field_u64(object, "topology_revision") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/syntax topology_revision must be an integer")),
        };
        let uri = match field_string(object, "syntax_uri") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/syntax URI must be a string")),
        };
        let documents = match object.get("documents") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/syntax documents are missing")),
        };
        let open = match parse_open_inputs(documents) {
            Ok(value) => value,
            Err(message) => return Result<Value, String>.Err(message),
        };
        defer release_open_inputs(&open);

        let requested_path = match uri_to_path(uri) {
            Ok(value) => value,
            Err(problem) => { let _ = problem.kind; return Result<Value, String>.Err(failure("syntax URI must be a local file URI")); },
        };
        defer requested_path.drop();
        let normalized_path = match resolve(requested_path.as_str()) {
            Ok(value) => value,
            Err(problem) => { problem.drop(); return Result<Value, String>.Err(failure("could not resolve syntax document path")); },
        };
        defer normalized_path.drop();

        let selected = Option<u64>.None;
        let index = 0u64;
        while index < open.len() {
            if open[index].path.as_str() == normalized_path.as_str() {
                selected = Option<u64>.Some(index);
                break;
            }
            index += 1u64;
        }

        let frozen = FrozenInputs.new(revision, topology, "syntax");
        defer frozen.drop();
        let selected_open = Vec<OpenInput>.new();
        defer release_open_inputs(&selected_open);
        if let Some(selected_index) = selected {
            let document = &open[selected_index];
            frozen.add(document.path.as_str(), document.text.as_str(), document.version);
            selected_open.push(OpenInput(
                path=PathBuf.from(document.path.as_str()),
                text=String.from(&document.text.as_str()),
                version=document.version,
                ));
        }

        let result = if selected.is_none() {
            let groups = Object.new();
            json_put(&groups, uri, empty_array());
            let output = Object.new();
            json_put(&output, "diagnostics", Value.Object(groups));
            json_put(&output, "project_diagnostics", empty_array());
            Value.Object(output)
        } else {
            let trust = match SourceTrust.new(self.std_root.as_str()) {
                Ok(value) => value,
                Err(error) => { error.drop(); return Result<Value, String>.Err(failure("could not classify standard-library sources")); },
            };
            let options = editor_options(trust, Option<PackageMap>.None, EditorMode.Syntax);
            options.raw_pointers = self.raw_pointers;
            let snapshot = match EditorEngine.analyze(&frozen, options) {
                Ok(value) => value,
                Err(problem) => {
                    problem.drop();
                    return Result<Value, String>.Err(failure("syntax analysis failed internally"));
                },
            };
            let output = snapshot_diagnostics(&snapshot, &selected_open, empty_array());
            snapshot.drop();
            output
        };

        let output = match result.as_object() {
            Some(value) => {
                json_put(value, "revision", Value.Number(Number.Unsigned(revision)));
                json_put(value, "syntax_document", Value.String(String.from(&uri)));
                result
            },
            None => { result.drop(); return Result<Value, String>.Err(failure("syntax result is invalid")); },
        };
        Result<Value, String>.Ok(output)
    }

    pub fn synchronize(params: Option<Value>) -> Result<Value, String> {
        let sync_started_ns = timing_now_ns();
        let value = match params {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync is missing params")),
        };
        defer value.drop();
        let object = match value.as_object() {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync params must be an object")),
        };
        let revision = match field_u64(object, "revision") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync revision must be an integer")),
        };
        let topology = match field_u64(object, "topology_revision") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync topology_revision must be an integer")),
        };
        let root = match object.get("workspace_root") {
            Some(value) => match value {
                Null => Option<String>.None,
                String(path) => Option<String>.Some(String.from(&path.as_str())),
                _ => return Result<Value, String>.Err(failure("workspace_root must be a string or null")),
            },
            None => Option<String>.None,
        };
        let root_changed = match &self.workspace_root {
            None => match &root { None => false, Some(_) => true },
            Some(old) => match &root {
                Some(new) => old.as_str() != new.as_str(),
                None => true,
            },
        };
        let project_started_ns = timing_now_ns();
        if root_changed || topology != self.topology_revision {
            let root_text = match &root { Some(path) => Option<str>.Some(path.as_str()), None => Option<str>.None };
            self.reload_project(root_text)?;
            self.topology_revision = topology;
        }
        let project_finished_ns = timing_now_ns();
        match &root { Some(path) => path.drop(), None => {}, }

        let documents_value = match object.get("documents") {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("worker/sync documents are missing")),
        };
        let open = parse_open_inputs(documents_value)?;
        defer release_open_inputs(&open);
        let paths_started_ns = timing_now_ns();
        let paths = collect_input_paths(match &self.project { Some(value) => Option<Project&>.Some(value), None => Option<Project&>.None },
            self.std_root.as_str(), &open)?;
        let paths_finished_ns = timing_now_ns();
        defer release_paths(&paths);
        let mode_text = if self.raw_pointers { "raw" } else { "fat" };
        let freeze_started_ns = timing_now_ns();
        let frozen = make_frozen_inputs(&paths, &open, revision, topology, mode_text)?;
        let freeze_finished_ns = timing_now_ns();
        defer frozen.drop();
        let setup_started_ns = timing_now_ns();
        let trust = match SourceTrust.new(self.std_root.as_str()) {
            Ok(value) => value,
            Err(error) => { error.drop(); return Result<Value, String>.Err(failure("could not classify standard-library sources")); },
        };
        let package_map = match &self.project {
            Some(project) => {
                let encoded = package_map_json(project);
                defer encoded.drop();
                let document = match parse(encoded.as_str()) {
                    Ok(value) => value,
                    Err(_) => return Result<Value, String>.Err(failure("could not encode the package map")),
                };
                defer document.drop();
                let loaded = match PackageMap.from_document(&document) {
                    Ok(value) => value,
                    Err(error) => { error.drop(); return Result<Value, String>.Err(failure("could not load the package map")); },
                };
                Option<PackageMap>.Some(loaded)
            },
            None => Option<PackageMap>.None,
        };
        let options = editor_options(trust, package_map, EditorMode.Full);
        options.raw_pointers = self.raw_pointers;
        let setup_finished_ns = timing_now_ns();
        let analysis_started_ns = timing_now_ns();
        let next = match EditorEngine.analyze(&frozen, options) {
            Ok(snapshot) => snapshot,
            Err(problem) => {
                problem.drop();
                return Result<Value, String>.Err(failure("editor analysis failed internally"));
            },
        };
        let analysis_finished_ns = timing_now_ns();
        match self.snapshot.take() { Some(previous) => previous.drop(), None => {}, }
        self.snapshot = Option<EditorSnapshot>.Some(next);
        let snapshot = match &self.snapshot {
            Some(value) => value,
            None => return Result<Value, String>.Err(failure("analysis snapshot was not retained")),
        };
        let diagnostics_started_ns = timing_now_ns();
        let mut_result = snapshot_diagnostics(snapshot, &open, self.project_diagnostics.clone());
        let diagnostics_finished_ns = timing_now_ns();
        let output = match mut_result.as_object() {
            Some(result) => {
                json_put(result, "revision", Value.Number(Number.Unsigned(revision)));
                json_put(result, "project_loaded", Value.Boolean(self.project.is_some()));
                let timings = Object.new();
                record_timing(&timings, "project_load_ms", project_started_ns, project_finished_ns);
                record_timing(&timings, "input_path_collection_ms", paths_started_ns, paths_finished_ns);
                record_timing(&timings, "input_freeze_ms", freeze_started_ns, freeze_finished_ns);
                record_timing(&timings, "analysis_setup_ms", setup_started_ns, setup_finished_ns);
                record_timing(&timings, "editor_analyze_ms", analysis_started_ns, analysis_finished_ns);
                record_timing(&timings, "diagnostic_render_ms", diagnostics_started_ns, diagnostics_finished_ns);
                record_timing(&timings, "sync_total_ms", sync_started_ns, diagnostics_finished_ns);
                json_put(result, "analysis_timings", Value.Object(timings));
                mut_result
            },
            None => { mut_result.drop(); return Result<Value, String>.Err(failure("analysis result is invalid")); },
        };
        Result<Value, String>.Ok(output)
    }

    pub fn query(params: Option<Value>) -> Result<Value, WorkerFailure> {
        let payload = match params {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query payload is missing")),
        };
        defer payload.drop();
        let object = match payload.as_object() {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query payload must be an object")),
        };
        let method = match field_string(object, "method") {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query method must be a string")),
        };
        let query_params = match object.get("params") {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "query params are missing")),
        };
        let snapshot = match &self.snapshot {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32801i64, "no current analysis snapshot")),
        };

        match method {
            "textDocument/definition" => {
                let position = position_params(snapshot, query_params)?;
                let source = position.source;
                let row = position.row;
                let column = position.column;
                match snapshot.definition_at(source, row, column) {
                    Some(location) => {
                        let result = location_value(snapshot, &location);
                        location.drop();
                        Result<Value, WorkerFailure>.Ok(result)
                    },
                    None => Result<Value, WorkerFailure>.Ok(Value.Null),
                }
            },
            "textDocument/hover" => {
                let position = position_params(snapshot, query_params)?;
                let source = position.source;
                let row = position.row;
                let column = position.column;
                match snapshot.hover_at(source, row, column) {
                    Some(info) => Result<Value, WorkerFailure>.Ok(hover_value(snapshot, info, source, row, column)),
                    None => Result<Value, WorkerFailure>.Ok(Value.Null),
                }
            },
            "textDocument/documentSymbol" => {
                let object = match query_params.as_object() {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "document symbol params must be an object")),
                };
                let document_value = match object.get("textDocument") {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "textDocument is missing")),
                };
                let document = match TextDocumentIdentifier.from_json(document_value) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "textDocument.uri is invalid")),
                };
                defer document.drop();
                let source = query_source(snapshot, document.uri.as_str())?;
                document_symbols_value(snapshot, source)
            },
            "textDocument/completion" => {
                let position = position_params(snapshot, query_params)?;
                let source = position.source;
                let row = position.row;
                let column = position.column;
                match completion_at(snapshot, source, row, column) {
                    Ok(result) => Result<Value, WorkerFailure>.Ok(completion_value(snapshot, result)),
                    Err(error) => {
                        let message = String.from(&"completion query failed: ");
                        message.push_str(error.diagnostic.message.as_str());
                        error.drop();
                        let failure = WorkerFailure.new(-32603i64, message.as_str());
                        message.drop();
                        Result<Value, WorkerFailure>.Err(failure)
                    },
                }
            },
            "textDocument/signatureHelp" => {
                let position = position_params(snapshot, query_params)?;
                let source = position.source;
                let row = position.row;
                let column = position.column;
                match query_signature(snapshot, source, row, column) {
                    Ok(Value(value, _)) => Result<Value, WorkerFailure>.Ok(signature_value(value)),
                    Ok(Unavailable(_)) => Result<Value, WorkerFailure>.Ok(Value.Null),
                    Err(error) => {
                        let failure = WorkerFailure.new(-32603i64, error.diagnostic.message.as_str());
                        error.drop();
                        Result<Value, WorkerFailure>.Err(failure)
                    },
                }
            },
            "textDocument/semanticTokens/full" => {
                let object = match query_params.as_object() {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "semantic token params must be an object")),
                };
                let document_value = match object.get("textDocument") {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "textDocument is missing")),
                };
                let document = match TextDocumentIdentifier.from_json(document_value) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "textDocument.uri is invalid")),
                };
                defer document.drop();
                let source = query_source(snapshot, document.uri.as_str())?;
                semantic_tokens_value(snapshot, source)
            },
            "textDocument/references" => {
                let decoded = match ReferenceParams.from_json(query_params) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "invalid reference params")),
                };
                defer decoded.drop();
                let source = query_source(snapshot, decoded.text_document.uri.as_str())?;
                let row = decoded.position.line;
                let column = position_column(snapshot, source, decoded.position);
                let locations = if snapshot.resolved_member_at(source, row, column).is_some() {
                    snapshot.member_occurrences_at(source, row, column, decoded.context.include_declaration)
                } else {
                    match snapshot.symbol_at(source, row, column) {
                        Some(symbol) => snapshot.occurrences(symbol, decoded.context.include_declaration),
                        None => Vec<EditorLocation>.new(),
                    }
                };
                let values = Vec<Value>.with_capacity(locations.len());
                append_location_values(snapshot, locations, &values);
                Result<Value, WorkerFailure>.Ok(Value.Array(values))
            },
            "textDocument/documentHighlight" => {
                let position = position_params(snapshot, query_params)?;
                let source = position.source;
                let row = position.row;
                let column = position.column;
                let path = match snapshot.source_path(source) {
                    Some(value) => String.from(&value),
                    None => return Result<Value, WorkerFailure>.Ok(empty_array()),
                };
                defer path.drop();
                let declaration_path = Option<String>.None;
                let declaration_span = Option<Span>.None;
                let locations = if let Some(member) = snapshot.resolved_member_at(source, row, column) {
                    match snapshot.source_path(member.declaration.source) {
                        Some(value) => declaration_path = Option<String>.Some(String.from(&value)),
                        None => {},
                    }
                    declaration_span = Option<Span>.Some(member.declaration.span);
                    snapshot.member_occurrences_at(source, row, column, true)
                } else {
                    match snapshot.symbol_at(source, row, column) {
                        Some(symbol_id) => {
                            match snapshot.symbol(symbol_id) {
                                Some(symbol) => match &symbol.span {
                                    Some(span) => {
                                        match snapshot.source_path(span.source) {
                                            Some(value) => declaration_path = Option<String>.Some(String.from(&value)),
                                            None => {},
                                        }
                                        declaration_span = Option<Span>.Some(span.span);
                                    },
                                    None => {},
                                },
                                None => {},
                            }
                            snapshot.highlights(source, symbol_id)
                        },
                        None => Vec<EditorLocation>.new(),
                    }
                };
                let values = Vec<Value>.new();
                for location in locations {
                    if location.path.as_str() == path.as_str() {
                        values.push(document_highlight_value(snapshot, location,
                            &declaration_path, declaration_span));
                    }
                    location.drop();
                }
                locations.drop();
                match declaration_path { Some(value) => value.drop(), None => {}, }
                Result<Value, WorkerFailure>.Ok(Value.Array(values))
            },
            "textDocument/prepareRename" => {
                let position = position_params(snapshot, query_params)?;
                let source = position.source;
                let row = position.row;
                let column = position.column;
                let target = match prepare_rename_target(snapshot, source, row, column) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Ok(Value.Null),
                };
                defer { target.location.drop(); target.placeholder.drop(); };
                let text = text_at_path(snapshot, target.location.path.as_str());
                defer text.drop();
                let result = Object.new();
                json_put(&result, "range", protocol_range(target.location.span, text.as_str()));
                json_put(&result, "placeholder", Value.String(String.from(&target.placeholder.as_str())));
                Result<Value, WorkerFailure>.Ok(Value.Object(result))
            },
            "textDocument/rename" => {
                let decoded = match RenameParams.from_json(query_params) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "invalid rename params")),
                };
                defer decoded.drop();
                let source = query_source(snapshot, decoded.text_document.uri.as_str())?;
                let column = position_column(snapshot, source, decoded.position);
                let renamed = snapshot.rename_at(source, decoded.position.line, column,
                    decoded.new_name.as_str());
                if let Some(reason) = &renamed.refusal {
                    let error = WorkerFailure.new(-32803i64, reason.as_str());
                    renamed.drop();
                    return Result<Value, WorkerFailure>.Err(error);
                }
                let changes = Object.new();
                for edit in renamed.edits {
                    append_workspace_edit(snapshot, &changes, &edit.location, edit.new_text.as_str());
                }
                renamed.drop();
                let workspace_edit = Object.new();
                json_put(&workspace_edit, "changes", Value.Object(changes));
                Result<Value, WorkerFailure>.Ok(Value.Object(workspace_edit))
            },
            "textDocument/codeAction" => {
                let object = match query_params.as_object() {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "code action params must be an object")),
                };
                let document_value = match object.get("textDocument") {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "textDocument is missing")),
                };
                let document = match TextDocumentIdentifier.from_json(document_value) {
                    Some(value) => value,
                    None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(
                        -32602i64, "textDocument.uri is invalid")),
                };
                defer document.drop();
                let source = query_source(snapshot, document.uri.as_str())?;
                let fixes = snapshot.import_quick_fixes(source);
                let actions = Vec<Value>.with_capacity(fixes.len());
                for fix in fixes {
                    actions.push(code_action_value(snapshot, fix));
                    fix.drop();
                }
                fixes.drop();
                Result<Value, WorkerFailure>.Ok(Value.Array(actions))
            },
            _ => Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32601i64, "unsupported LSP query")),
        }
    }

    pub fn format(params: Option<Value>) -> Result<Value, WorkerFailure> {
        let value = match params {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "format params are missing")),
        };
        defer value.drop();
        let object = match value.as_object() {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "format params must be an object")),
        };
        let method_params = match object.get("params") {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "format request params are missing")),
        };
        let decoded = match DocumentFormattingParams.from_json(method_params) {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32602i64, "invalid document formatting params")),
        };
        defer decoded.drop();
        let snapshot = match &self.snapshot {
            Some(value) => value,
            None => return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32801i64, "no current analysis snapshot")),
        };
        let source = query_source(snapshot, decoded.text_document.uri.as_str())?;
        let original = match snapshot.source_text(source) {
            Some(text) => String.from(&text),
            None => return Result<Value, WorkerFailure>.Ok(empty_array()),
        };
        defer original.drop();
        let formatted = match snapshot.format_document(source) {
            Ok(Some(text)) => text,
            Ok(None) => return Result<Value, WorkerFailure>.Ok(empty_array()),
            Err(error) => {
                error.drop();
                return Result<Value, WorkerFailure>.Err(WorkerFailure.new(-32603i64, "formatting failed"));
            },
        };
        if formatted.as_str() == original.as_str() {
            formatted.drop();
            return Result<Value, WorkerFailure>.Ok(empty_array());
        }
        let index = LineIndex.new(original.as_str());
        let last = index.line_count() - 1u64;
        let end = Position(line=last,
            character=index.utf16_column(last, index.scalar_column(last, 18446744073709551615u64)));
        let range = Range(start=Position(line=0u64, character=0u64), end=end).to_json();
        index.drop();
        let edit = Object.new();
        json_put(&edit, "range", range);
        json_put(&edit, "newText", Value.String(formatted));
        let edits = Vec<Value>.new();
        edits.push(Value.Object(edit));
        Result<Value, WorkerFailure>.Ok(Value.Array(edits))
    }
}

impl Drop for WorkerState {
    pub fn drop() {
        match self.snapshot.take() { Some(value) => value.drop(), None => {}, }
        match self.project.take() { Some(value) => value.drop(), None => {}, }
        self.std_root.drop();
        match self.workspace_root.take() { Some(value) => value.drop(), None => {}, }
        self.project_diagnostics.drop();
    }
}
