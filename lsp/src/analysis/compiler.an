from yianc.analysis.session.output import AnalysisOptions, AnalysisOutput;
from yianc.analysis.hir.store import HirStore;
from yianc.analysis.symbol.scope import SymbolStore;
from yianc.common.names import NameInterner;
from yianc.codegen.session import TargetLayout;
from yianc.frontend.driver import FrontendDriver;
from yianc.telemetry.trace import CompilerTrace;
from yianc.analysis.driver import MiddleEndDriver;
from yianc.types.layout import TypeSizeProvider;
from yianc.types.store import TypeStore;
from yianc.diagnostics.model import DiagnosticCode, DiagnosticLocation, UserDiagnostic, DiagnosticReporter;
from yianc.frontend.source import SourceFile, SourceMap, SourceTable;
from yianc.frontend.unit import UnitTable;
from lsp.analysis.inputs import SourceDocument;
from yianc.input_error import InputError;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;
from lsp.analysis.diagnostic import LspDiagnostic;
from std.core.convert import From;
from std.core.fs import resolve;
from std.core.iter import Iterator, IntoIterator;

// Output and HIR IDs refer to these owned tables. Release them before the stable type store.
pub struct CompilerAnalysis {
    pub units: UnitTable,
    pub packages: Option<PackageMap>,
    pub names: NameInterner,
    pub symbols: SymbolStore,
    pub hir: HirStore,
    pub stdlib: Vec<bool>,
    pub output: AnalysisOutput,
    warnings: Option<Vec<LspDiagnostic>>,
    types: TypeStore*,
}

impl CompilerAnalysis {
    pub fn take_warnings() -> Vec<LspDiagnostic> {
        match self.warnings.take() {
            Some(value) => value,
            None => Vec<LspDiagnostic>.new(),
        }
    }
}

fn release_diagnostics(values: Vec<LspDiagnostic>&) {
    for value in *values { value.drop(); }
    values.drop();
}

fn release_files(files: Vec<SourceFile>&) {
    for file in *files { file.drop(); }
    files.drop();
}

impl Drop for CompilerAnalysis {
    pub fn drop() {
        match self.warnings.take() { Some(values) => release_diagnostics(&values), None => {}, }
        self.output.drop();
        self.hir.drop();
        self.symbols.drop();
        self.names.drop();
        self.units.drop();
        self.stdlib.drop();
        match self.packages.take() { Some(value) => value.drop(), None => {}, }
        self.types.drop();
        del self.types;
    }
}

pub struct CompilerFailure {
    diagnostics: Option<Vec<LspDiagnostic>>,
}

impl CompilerFailure {
    static fn single(diagnostic: UserDiagnostic&, sources: SourceMap&) -> Self {
        let diagnostics = Vec<LspDiagnostic>.new();
        diagnostics.push(LspDiagnostic.from_diagnostic(diagnostic, sources));
        Self(Option<Vec<LspDiagnostic>>.Some(diagnostics))
    }

    pub fn take_diagnostics() -> Vec<LspDiagnostic> {
        match self.diagnostics.take() {
            Some(value) => value,
            None => Vec<LspDiagnostic>.new(),
        }
    }
}

impl Drop for CompilerFailure {
    pub fn drop() {
        match self.diagnostics.take() { Some(values) => release_diagnostics(&values), None => {}, }
    }
}

struct LspReporter {
    sources: SourceMap&,
    warnings: Vec<LspDiagnostic>,
}

impl DiagnosticReporter for LspReporter {
    pub fn report(diagnostic: UserDiagnostic&) {
        self.warnings.push(LspDiagnostic.from_diagnostic(diagnostic, self.sources));
    }
}

// Convert all diagnostics while the source table is still owned by the compiler.
pub fn analyze(documents: Vec<SourceDocument>&, trust: SourceTrust, packages: Option<PackageMap>,
    raw_pointers: bool) -> Result<CompilerAnalysis, CompilerFailure> {
    let trace = CompilerTrace.disabled();
    defer trace.drop();
    let trust_transferred = false;
    defer {
        if !trust_transferred { trust.drop(); }
    };
    let analysis_transferred = false;
    defer { if !analysis_transferred { match &packages { Some(value) => value.drop(), None => {}, } } };
    let files = Vec<SourceFile>.new();
    let files_transferred = false;
    defer { if !files_transferred { release_files(&files); } };
    for document in *documents {
        let canonical = match resolve(document.path.as_str()) {
            Ok(value) => value,
            Err(error) => {
                defer error.drop();
                let diagnosis = InputError(DiagnosticCode.Source,
                    DiagnosticLocation.File(String.from(&document.path.as_str())), String.from(&error.msg()));
                defer diagnosis.drop();
                let empty = SourceTable.new();
                defer empty.drop();
                return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(&diagnosis, &empty));
            },
        };
        files.push(SourceFile.new(canonical, String.from(&document.text.as_str())));
    }
    let built = SourceTable.from_files(files);
    files_transferred = true;
    let input_sources = match built {
        Ok(value) => value,
        Err(diagnosis) => {
            defer diagnosis.drop();
            let empty = SourceTable.new();
            defer empty.drop();
            return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(&diagnosis, &empty));
        },
    };
    let sources_moved = false;
    defer { if !sources_moved { input_sources.drop(); } };
    let frontend = FrontendDriver.new(input_sources, false, &trace);
    sources_moved = true;
    defer frontend.drop();
    let units = match frontend.run() {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(&error, frontend.source_table()));
        },
    };
    defer { if !analysis_transferred { units.drop(); } };

    // Each analysis owns these shared tables; the middle end borrows them during the run.
    let types = dyn TypeStore.new();
    defer { if !analysis_transferred { types.drop(); del types; } };
    let names = NameInterner.new();
    let symbols = SymbolStore.new();
    let hir = HirStore.new();
    defer {
        if !analysis_transferred {
            hir.drop();
            symbols.drop();
            names.drop();
        }
    };

    let layout = match TargetLayout.new(&*types, raw_pointers, 0u8, false, Option<CompilerTrace&>.None) {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(&error, &units));
        },
    };
    let layout_live = true;
    defer { if layout_live { layout.drop(); } };

    let reporter = LspReporter(&units, Vec<LspDiagnostic>.new());
    defer { if !analysis_transferred { release_diagnostics(&reporter.warnings); } };
    let options = AnalysisOptions.new();
    options.require_entry = false;
    options.entry_optional = true;
    options.verify_hir = true;
    options.sizes = Option<TypeSizeProvider&>.Some(layout.backend_types());
    let middle = MiddleEndDriver.new(&units, packages.as_ref(), &names, &*types, &symbols, &hir,
        trust, raw_pointers, options, &reporter);
    trust_transferred = true;
    let middle_live = true;
    defer { if middle_live { middle.drop(); } };
    let result = match middle.run() {
        Ok(value) => value,
        Err(error) => {
            defer error.drop();
            return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(&error, &units));
        },
    };
    // Copy source permissions in UnitId order before releasing their middle-end owner.
    let stdlib = Vec<bool>.with_capacity(units.len());
    let source_cursor = 0u64;
    while source_cursor < units.len() {
        stdlib.push(middle.permissions[source_cursor].is_stdlib);
        source_cursor += 1u64;
    }
    middle.drop();
    middle_live = false;

    // The layout's type cache borrows the table; release it before transferring analysis state.
    layout.drop();
    layout_live = false;
    let analysis = CompilerAnalysis(units, packages, names, symbols, hir, stdlib, result,
        Option<Vec<LspDiagnostic>>.Some(reporter.warnings), types);
    analysis_transferred = true;
    Result<CompilerAnalysis, CompilerFailure>.Ok(analysis)
}
