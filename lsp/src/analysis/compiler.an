from yianc.analysis.session.session import AnalysisSession;
from yianc.analysis.session.output import AnalysisOptions, AnalysisOutput;
from yianc.codegen.session import BackendOptions, BackendSession;
from yianc.driver.frontend import FrontendDriver;
from yianc.driver.middle import MiddleEndDriver;
from yianc.analysis.constant.evaluate import TypeSizeProvider;
from yianc.common.location import SourceSpan;
from yianc.diagnostics.model import AnalysisError, Diagnostic, DiagnosticCode, Severity;
from yianc.diagnostics.render import detach;
from yianc.frontend.source import SourceDocument;
from yianc.package.model import PackageMap;
from yianc.package.provenance import SourceTrust;

// The session owns every semantic identity; the output borrows procedure records from it.
pub struct CompilerAnalysis {
    pub session: AnalysisSession,
    pub output: AnalysisOutput,
}

impl Drop for CompilerAnalysis {
    pub fn drop() {
        self.output.drop();
        self.session.drop();
    }
}

// Failure diagnostics are detached from the released session before this value is returned.
pub struct CompilerFailure {
    diagnostics: Option<Vec<Diagnostic>>,
}

impl CompilerFailure {
    static fn single(diagnostic: Diagnostic) -> Self {
        let diagnostics = Vec<Diagnostic>.new();
        diagnostics.push(diagnostic);
        Self(Option<Vec<Diagnostic>>.Some(diagnostics))
    }

    pub fn take_diagnostics() -> Vec<Diagnostic> {
        match self.diagnostics.take() {
            Some(value) => value,
            None => Vec<Diagnostic>.new(),
        }
    }
}

impl Drop for CompilerFailure {
    pub fn drop() {
        match self.diagnostics.take() {
            Some(diagnostics) => {
                for diagnostic in diagnostics { diagnostic.drop(); }
                diagnostics.drop();
            },
            None => {},
        }
    }
}

fn failure_from_error(error: AnalysisError, session: Option<AnalysisSession&>) -> CompilerFailure {
    let copied = error.diagnostic.copy();
    error.drop();
    match session {
        Some(value) => match detach(&copied, value.source_manager()) {
            Ok(_) => CompilerFailure.single(copied),
            Err(problem) => {
                problem.drop();
                copied.drop();
                CompilerFailure.single(Diagnostic.new(
                    DiagnosticCode.Internal, Severity.Error, Option<SourceSpan>.None,
                    "could not detach the analysis diagnostic"))
            },
        },
        None => CompilerFailure.single(copied),
    }
}

// Strict analysis runs once at its normal semantic boundary and never enters CFG or LLVM emission.
pub fn analyze(documents: Vec<SourceDocument>&, trust: SourceTrust, packages: Option<PackageMap>,
    raw_pointers: bool, allow_ffi: bool) -> Result<CompilerAnalysis, CompilerFailure> {
    let frontend = match FrontendDriver.prepare_documents(documents, trust, packages, allow_ffi) {
        Ok(value) => value,
        Err(error) => return Result<CompilerAnalysis, CompilerFailure>.Err(
            failure_from_error(error, Option<AnalysisSession&>.None)),
    };
    let middle = MiddleEndDriver.new(frontend.take_session(), raw_pointers);
    let transferred = false;
    defer { if !transferred { middle.drop(); } };

    let backend_value = match BackendSession.new(middle.analysis_session(), BackendOptions(raw_pointers, 0u8, Option<str>.None)) {
        Ok(value) => value,
        Err(error) => {
            error.drop();
            return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(Diagnostic.new(
                DiagnosticCode.Internal, Severity.Error, Option<SourceSpan>.None,
                "could not create the target layout provider")));
        },
    };
    let backend = Option<BackendSession>.Some(backend_value);
    defer { match backend.take() { Some(value) => value.drop(), None => {}, } };

    let options = AnalysisOptions.new();
    options.require_entry = false;
    options.entry_optional = true;
    options.recover = false;
    options.verify_hir = true;
    options.sizes = Option<TypeSizeProvider&>.Some(match &backend { Some(value) => value.size_provider(), None => @panic("E599: backend session was released") });
    match middle.run(options) {
        Ok(report_value) => {
            if !report_value.ok() {
                let diagnostics = report_value.diagnostics.take();
                for diagnostic in *diagnostics {
                    match detach(diagnostic, middle.analysis_session().source_manager()) {
                        Ok(_) => {},
                        Err(problem) => problem.drop(),
                    }
                }
                report_value.drop();
                match backend.take() { Some(value) => value.drop(), None => {}, }
                return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure(Option<Vec<Diagnostic>>.Some(diagnostics)));
            }
            let output = match report_value.output.take() {
                Some(value) => value,
                None => {
                    report_value.drop();
                    match backend.take() { Some(value) => value.drop(), None => {}, }
                    return Result<CompilerAnalysis, CompilerFailure>.Err(CompilerFailure.single(Diagnostic.new(
                        DiagnosticCode.Internal, Severity.Error, Option<SourceSpan>.None,
                        "strict analysis returned no output")));
                },
            };
            report_value.drop();
            match backend.take() { Some(value) => value.drop(), None => {}, }
            let session = middle.take_session();
            transferred = true;
            Result<CompilerAnalysis, CompilerFailure>.Ok(CompilerAnalysis(session, output))
        },
        Err(error) => {
            match backend.take() { Some(value) => value.drop(), None => {}, }
            Result<CompilerAnalysis, CompilerFailure>.Err(
                failure_from_error(error, Option<AnalysisSession&>.Some(middle.analysis_session())))
        },
    }
}
