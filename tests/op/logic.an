// Test logical operators: and, or, not
//
// Expected output: 0

fn main() -> i32
{
    let a: i32 = 1
    let b: i32 = 2
    let c: i32 = 3
    if a > 0 && b > 0{
        c = c + 1
    }
    assert c == 4: "&& operator failed"

    if a > 0 || b > 0{
        c = c + 1
    }
    assert c == 5: "|| operator failed"

    if !(a > 1) {
        c = c + 1
    }
    assert c == 6: "! operator failed"
    
    return 0
}