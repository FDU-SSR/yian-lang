// Test string concatenation with + operator
//
// Expected output: 0

fn main() -> i32 {
    let a: str = "Hello";
    let b: str = "World";
    let c: String = a.to_string() + b;
    assert c == "HelloWorld": "str concat failed";

    let d: String = a.to_string() + " " + b;
    assert d == "Hello World": "str concat with literal failed";

    return 0;
}
