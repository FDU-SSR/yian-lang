// Test comparison operations: ==, !=, <, <=, >, >=
//
// Expected output: 0

enum Ordering {
    Less
    Equal
    Greater
}

i32 main() {
    i32 a = 5
    i32 b = 10

    assert (a == b) == false: "Equality check failed"
    assert (a != b) == true: "Inequality check failed"
    assert (a < b) == true: "Less than check failed"
    assert (a <= b) == true: "Less than or equal check failed"
    assert (a > b) == false: "Greater than check failed"
    assert (a >= b) == false: "Greater than or equal check failed"

    Ordering less = Ordering.Less
    Ordering equal = Ordering.Equal
    Ordering greater = Ordering.Greater

    assert less == Ordering.Less: "Enum equality check failed"
    assert equal == Ordering.Equal: "Enum equality check failed"
    assert greater == Ordering.Greater: "Enum equality check failed"

    return 0
}