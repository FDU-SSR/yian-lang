// Test arithmetic operations: +, -, *, /, %
//
// Expected output: 0

fn main() -> i32 {
    let a: i32 = 10;
    let b: i32 = 3;

    let sum: i32 = a + b;
    assert sum == 13: "Addition failed";

    let diff: i32 = a - b;
    assert diff == 7: "Subtraction failed";

    let prod: i32 = a * b;
    assert prod == 30: "Multiplication failed";

    let quot: i32 = a / b;
    assert quot == 3: "Division failed";

    let rem: i32 = a % b;
    assert rem == 1: "Modulus failed";

    return 0;
}