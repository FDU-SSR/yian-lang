// Test typeof operator
//
// Expected output:
// It is i32
// It is float
// It is str
// It is bool
// Unknown type

func<T>(T param) {
    if typeof(param, i32) {
        print("It is i32\n")
    } elif typeof(param, float) {
        print("It is float\n")
    } elif typeof(param, str) {
        print("It is str\n")
    } elif typeof(param, bool) {
        print("It is bool\n")
    } else {
        print("Unknown type\n")
    }
}

i32 main() {
    i32 a = 10
    float b = 3.14
    str c = "Hello"
    bool d = true
    i32[1] e = [1]

    func(a)  // Expected: It is i32
    func(b)  // Expected: It is float
    func(c)  // Expected: It is str
    func(d)  // Expected: It is bool
    func(e)  // Expected: Unknown type

    return 0
}