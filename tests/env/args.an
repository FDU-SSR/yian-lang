// Test command-line arguments via std.core.env
//
// Run with CLI args from tests/input/env/args.args:
//   args: hello world test
// Expected output: program name, arg count, and each non-program arg

from std.core.env import args;
from std.core.io import print;

fn main() {
    let argv = args();
    assert argv.len() == 4: "expected 4 args (program name + 3 CLI args)";
    // argv[0] is the program name
    // argv[1..] are the CLI args: hello, world, test
}
