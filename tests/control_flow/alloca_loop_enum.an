// Compiler temporaries created in a loop must not consume stack space on
// every iteration.
//
// Expected output: (empty, exit 0)

enum Mode {
    A,
    B { value: i64 },
    C { value: i64, extra: i64 },
}

fn main() {
    let total: i64 = 0;
    let rounds: u64 = 300000;
    let index: u64 = 0;

    while index < rounds {
        let first: Mode = Mode.B(value = 1);
        let second: Mode = Mode.C(value = 2, extra = 3);

        match first {
            B(value) => total += value,
            _ => total += 100,
        }
        match second {
            C(value, extra) => total += value + extra,
            _ => total += 100,
        }
        index += 1;
    }

    assert total == i64(6) * i64(rounds): "enum result mismatch";
}
