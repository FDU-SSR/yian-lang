// Test continue statement in a while loop
//
// Expected output: 0

fn main() -> i32 {
    let i: i32 = 0;
    while true {
        if i != 5 {
            i += 1
            continue;
        } else {
            break;
        }
    }
    assert i == 5: "Continue while loop failed";
    return 0;
}