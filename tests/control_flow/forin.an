// Test for-in loop control flow.
//
// Expected output: 0

main() -> i32 {
    // add up 1024 elements of an array
    i32[1024] arr
    for i in 0u64..1024 {
        arr[i] = i32(i)
    }

    i32 sum = 0
    for elem in arr {
        sum += elem
    }

    assert sum == 1023 * 1024 / 2: "Expected sum to be 1023 * 1024 / 2"

    return 0
}
