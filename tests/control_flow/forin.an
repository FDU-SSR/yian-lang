// Test for-in loop control flow.
//
// Expected output: 0

fn main() {
    let arr: i32[1024] = [0; 1024];
    for i in 0u64..1024 {
        arr[i] = i32(i);
    }

    let sum: i32 = 0;
    for elem in arr {
        sum += *elem;
    }

    assert sum == 1023 * 1024 / 2: "Expected sum to be 1023 * 1024 / 2";

}
