// Test break statement in a while loop
//
// Expected output: 0

fn main() -> i32 {
    let sum: i32 = 0;
    let n: i32 = 10;
    let i: i32 = 1;
    while true {
        if i < n {
            sum += i
        } else {
            break;
        }
        i += 1
    }
    assert sum == 45: "Break in while loop failed";
    return 0;
}

