// Test for tuple type working with functions, including passing and returning tuples
//
// Expected output: 0

struct Pair {
    pub first: i32,
    pub second: i32,
}

impl Move for Pair {
    fn invalidate(){}
    fn is_valid() -> bool { true }
}

fn create_pair_and_number(a: i32, b: i32, num: i32) -> (Pair, i32) {
    let p: Pair = Pair(a, b);
    let tmp: (Pair, i32) = (p.move(), num)
    return tmp.move();
}

fn sum_tuple(t: (i32, i32)) -> i32 {
    return t[0] + t[1];
}

fn main() {
    let result: (Pair, i32) = create_pair_and_number(5, 10, 15)
    assert result[0].first == 5: "result[0].first should be 5";
    assert result[0].second == 10: "result[0].second should be 10";
    assert result[1] == 15: "result[1] should be 15";

    let num_tuple: (i32, i32) = (20, 30)
    let total: i32 = sum_tuple(num_tuple);
    assert total == 50: "total should be 50";

}