// Test array initialization with function calls and struct instances
//
// Expected output: 0

get_num(i32 a) -> i32 {
    return a
}

struct Person {
    pub i32 age
    pub i64 score
}


main() -> i32 {
    i32[3] arr = [get_num(1), get_num(2), get_num(3)]
    assert arr[1] == 2: "arr[1] should be 2"

    Person[3] p_arr = [
        Person(age=12, score=60),
        Person(age=13, score=70),
        Person(age=14, score=80)
    ]
    assert p_arr[2].score == 80: "p_arr[2].score should be 80"

    return 0
}