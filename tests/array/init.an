// Test array initialization with literal values
//
// Expected output: 0

fn main() -> i32 {
    let array: i32[6] = [10, 7, 8, 9, 1, 5];
    assert array[0] == 10: "array[0] should be 10";

    let float_array: f64[4] = [1.1, 2.2, 3.3, 4.4];
    assert float_array[2] > 2.0 && float_array[2] < 4.0: "float_array[2] should be 3.3";

    let char_array: char[5] = ['a', 'b', 'c', 'd', 'e'];
    assert char_array[4] == 'e': "char_array[4] should be 'e'";

    let bool_array: bool[3] = [true, false, true];
    assert bool_array[1] == false: "bool_array[1] should be false";

    return 0;
}