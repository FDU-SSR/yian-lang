// Test multi-dimensional array access and modification
//
// Expected output: 0

fn main() -> i32 {
    let arr: i32[2][2][2] = [[[1,2], [3, 4]], [[5, 6], [7, 8]]];
    assert arr[0][1][1] == 4: "arr[0][1][1] should be 4";

    arr[0][0][0] = 4
    arr[1][1][1] = 5
    assert arr[0][0][0] == 4: "arr[0][0][0] should be 4";
    assert arr[1][1][1] == 5: "arr[1][1][1] should be 5";

    let a: i32 = arr[0][0][0];
    let b: i32 = arr[1][1][1];
    assert a + b == 9: "a + b should be 9";

    return 0;
}