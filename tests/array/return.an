// Test returning arrays from functions
//
// Expected output: 0

fn get_array2() -> i32[3] {
    let arr: i32[3] = [1, 2, 3];
    return arr;
}

struct Pair {
    pub first: i32,
    pub second: i32,
}

fn get_pairs() -> Pair[3] {
    let p1: Pair = Pair(1, 2);
    let p2: Pair = Pair(2, 3);
    let p3: Pair = Pair(3, 4);
    let arr: Pair[3] = [p1, p2, p3];
    return arr;
}

fn main() -> i32 {
    let array: i32[3] = get_array2();
    assert array[0] + array[1] + array[2] == 6: "Sum of array elements should be 6";

    let pairs: Pair[3] = get_pairs();
    assert pairs[0].second + pairs[1].second + pairs[2].second == 9: "Sum of pairs' second fields should be 9";

    return 0;
}