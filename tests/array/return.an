// Test returning arrays from functions
//
// Expected output: 0

i32[3] get_array2() {
    i32[3] arr = [1, 2, 3]
    return arr
}

struct Pair {
    pub i32 first
    pub i32 second
}

Pair[3] get_pairs() {
    Pair p1 = Pair(1, 2)
    Pair p2 = Pair(2, 3)
    Pair p3 = Pair(3, 4)
    Pair[3] arr
    arr[0] = p1
    arr[1] = p2
    arr[2] = p3
    return arr
}

i32 main() {
    i32[3] array = get_array2()
    assert array[0] + array[1] + array[2] == 6: "Sum of array elements should be 6"

    Pair[3] pairs = get_pairs()
    assert pairs[0].second + pairs[1].second + pairs[2].second == 9: "Sum of pairs' second fields should be 9"

    return 0
}