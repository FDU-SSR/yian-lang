// A unit containing public and private items
// Do not compile this file standalone

pub struct ExportableStruct {
    pub i32 pub_field
    i32 priv_field
}

struct NonExportableStruct {
    pub i32 pub_field
    i32 priv_field
}

impl ExportableStruct {
    static pub new(i32 a, i32 b) -> Self {
        return ExportableStruct(a, b)
    }
}

pub make_non_exportable(i32 a, i32 b) -> NonExportableStruct {
    return NonExportableStruct(a, b)
}

make_exportable(i32 a, i32 b) -> ExportableStruct {
    return ExportableStruct(a, b)
}

pub get_priv_field(ExportableStruct* es) -> i32 {
    return es.priv_field
}