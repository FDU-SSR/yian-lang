// A unit containing public and private items
// Do not compile this file standalone

pub struct ExportableStruct {
    pub i32 pub_field
    i32 priv_field
}

struct NonExportableStruct {
    pub i32 pub_field
    i32 priv_field
}

impl ExportableStruct {
    static pub Self new(i32 a, i32 b) {
        return ExportableStruct(a, b)
    }
}

pub NonExportableStruct make_non_exportable(i32 a, i32 b) {
    return NonExportableStruct(a, b)
}

ExportableStruct make_exportable(i32 a, i32 b) {
    return ExportableStruct(a, b)
}

pub i32 get_priv_field(ExportableStruct* es) {
    return es.priv_field
}