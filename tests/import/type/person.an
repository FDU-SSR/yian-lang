from std.core.io import print

from walkable import Walkable

pub struct Person {
    i32 age
    float height
}

impl Person {
    static pub new(i32 age, float height) -> Person {
        return Self(age, height)
    }

    pub get_age() -> i32 {
        return self.age
    }

    pub get_height() -> float {
        return self.height
    }
}

impl Walkable for Person {
    pub walk() {
        self.age += 1
        self.height += 1.0

        print("Person is walking.\n")
    }
}