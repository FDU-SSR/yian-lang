from std.core.io import print;

from walkable import Walkable;

pub struct Person {
    age: i32,
    height: float,
}

impl Person {
    static pub fn new(age: i32, height: float) -> Person {
        return Self(age, height);
    }

    pub fn get_age() -> i32 {
        return self.age;
    }

    pub fn get_height() -> float {
        return self.height;
    }
}

impl Walkable for Person {
    pub fn walk() {
        self.age += 1
        self.height += 1.0

        print("Person is walking.\n");
    }
}