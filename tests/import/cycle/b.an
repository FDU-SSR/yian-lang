// Test circular import cycle handling
//
// Expected output: 0

from a import Value, lib_unwrap_value

pub unwrap_value<T>(Value<T> v) -> T {
    return v.value
}

main() -> i32 {
    Value<i32> v = Value(42)
    i32 result = lib_unwrap_value(v)
    assert result == 42: "result should be 42"
    return 0
}