pub fn quick_sort<T>(arr: T*, len: u64) {
    if len == 0 {
        return;
    }
    do_quick_sort(arr, 0u64, len - 1);
}

fn do_quick_sort<T>(arr: T*, low: u64, high: u64) {
    if low < high {
        let p: u64 = partition(arr, low, high);

        if p > low {
            do_quick_sort(arr, low, p - 1);
        }
        do_quick_sort(arr, p + 1, high);
    }
}

fn partition<T>(arr: T*, low: u64, high: u64) -> u64 {
    let pivot: T = arr[high];
    let i: u64 = low;

    for j in low..high {
        if arr[j] <= pivot {
            swap(&arr[i], &arr[j]);
            i += 1
        }
    }

    swap(&arr[i], &arr[high]);
    return i;
}

fn swap<T>(a: T*, b: T*) {
    let temp: T = *a;
    *a = *b;
    *b = temp;
}