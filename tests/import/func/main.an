// Test importing functions from other modules
//
// Expected output: 0

from adder import adder
from sort import quick_sort

main() -> i32 {
    i32 res = adder(10, 20)
    assert res == 30

    i32* arr = dyn[5] i32
    arr[0] = 5
    arr[1] = 3
    arr[2] = 8
    arr[3] = 1
    arr[4] = 4
    quick_sort(arr, 5u64)
    assert arr[0] == 1
    assert arr[1] == 3
    assert arr[2] == 4
    assert arr[3] == 5
    assert arr[4] == 8

    return 0
}
