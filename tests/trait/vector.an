// Test for a generic Vector implementation with append and pop methods.
//
// Expected output: 0

from std.core.option import Option

struct Vector<T> {
    T* data
    u64 length
    u64 capacity
}

impl<T> Vector<T> {
    static new() -> Self {
        return Self(
            data=dyn[2] T,
            length=0,
            capacity=2
        )
    }

    static with_capacity(u64 capacity) -> Self {
        return Self(
            data=dyn[capacity] T,
            length=0,
            capacity=capacity
        )
    }

    grow() {
        self.capacity *= 2
        T* new_data = dyn[self.capacity] T
        for i in 0..self.length {
            new_data[i] = self.data[i]
        }
        del self.data
        self.data = new_data
    }

    append(T item) {
        if self.length == self.capacity {
            self.grow()
        }
        self.data[self.length] = item
        self.length += 1
    }

    pop() -> Option<T> {
        if self.length == 0 {
            return Option<T>.None
        }
        self.length -= 1
        return Option<T>.Some(self.data[self.length])
    }

    len() -> u64 {
        return self.length
    }
}

main() -> i32 {
    Vector<i32> v = Vector<i32>.new()
    v.append(1)
    v.append(2)
    v.append(3)
    v.append(4)
    v.append(5)

    i32 sum = 0
    loop {
        Option<i32> item = v.pop()
        match item {
            None {
                break
            }
            Some(val) {
                sum += val
            }
        }
    }

    assert sum == 15: "Sum should be 15"
    
    return 0
}