// Test for a generic Vector implementation with append and pop methods.
//
// Expected output: 0

from std.core.option import Option;

struct Vector<T> {
    data: T*,
    length: u64,
    capacity: u64,
}

impl<T> Vector<T> {
    static fn new() -> Self {
        return Self(
            data=dyn[2] T,
            length=0,
            capacity=2
        )
    }

    static fn with_capacity(capacity: u64) -> Self {
        return Self(
            data=dyn[capacity] T,
            length=0,
            capacity=capacity
        )
    }

    fn grow() {
        self.capacity *= 2
        let new_data: T* = dyn[self.capacity] T;
        for i in 0..self.length {
            new_data[i] = self.data[i]
        }
        del self.data;
        self.data = new_data;
    }

    fn append(item: T) {
        if self.length == self.capacity {
            self.grow();
        }
        self.data[self.length] = item
        self.length += 1
    }

    fn pop() -> Option<T> {
        if self.length == 0 {
            return Option<T>.None;
        }
        self.length -= 1
        return Option<T>.Some(self.data[self.length]);
    }

    fn len() -> u64 {
        return self.length;
    }
}

fn main() -> i32 {
    let v: Vector<i32> = Vector<i32>.new();
    v.append(1);
    v.append(2);
    v.append(3);
    v.append(4);
    v.append(5);

    let sum: i32 = 0;
    loop {
        let item: Option<i32> = v.pop();
        match item {
            None => {
                break
            }
            Some(val) => {
                sum += val
            }
        }
    }

    assert sum == 15: "Sum should be 15";
    
    return 0;
}