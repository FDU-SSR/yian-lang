// Test: non-simple types cannot be directly assigned
//
// Expected: compilation error

struct BigInt {
    value: i64,
}

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

fn main() -> i32 {
    let a: BigInt = BigInt(1);
    let c = a;  // ERROR: BigInt does not support simple assignment
    return 0;
}
