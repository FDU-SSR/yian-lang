// Test: function parameter passing — non-simple without clone/move → error
//
// Expected: compilation error (NOT YET ENFORCED — known bug)

struct BigInt {
    value: i64,
}

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

fn consume(v: BigInt) -> i64 { v.value }

fn main() {
    let x: BigInt = BigInt(42);
    consume(x);  // ERROR: non-simple type, must clone or move
}
