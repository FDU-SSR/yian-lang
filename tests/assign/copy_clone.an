// Aggregate bitwise copy and explicit Clone are independent mechanisms.
struct BigInt { value: i64 }

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

fn main() {
    let a: BigInt = BigInt(42);
    let b = a.clone();
    assert b.value == 42;
    assert a.value == 42;

    let c = a;
    assert c.value == 42;
    assert a.value == 42;
}
