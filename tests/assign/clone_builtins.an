// Built-in aggregate Clone implementations recurse through their elements.
fn main() {
    let source = [String.from(&"one"), String.from(&"two")];
    let copied = source.clone();
    copied[0].push('!');
    assert source[0] == "one";
    assert copied[0] == "one!";

    let pair = (String.from(&"left"), String.from(&"right"));
    let pair_copy = pair.clone();
    pair_copy[0].push('!');
    assert pair[0] == "left";
    assert pair_copy[0] == "left!";

    let option = Option<String>.Some(String.from(&"optional"));
    let option_copy = option.clone();
    option_copy.unwrap().push('!');
    assert option.unwrap().as_str() == "optional";
    assert option_copy.unwrap().as_str() == "optional!";

    let result = Result<String, i32>.Ok(String.from(&"result"));
    let result_copy = result.clone();
    result_copy.unwrap().push('!');
    assert result.unwrap().as_str() == "result";
    assert result_copy.unwrap().as_str() == "result!";

    let range = Range<i32>(start = 3, end = 8);
    let range_copy = range.clone();
    assert range == range_copy;
}
