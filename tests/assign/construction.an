// Test: construction — elements must obey assignment rules
//
// Expected output: 0

struct BigInt {
    value: i64,
}

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

impl Move for BigInt {
    fn invalidate() {}
    fn is_valid() -> bool { true }
}

fn main() -> i32 {
    let a: BigInt = BigInt(1);
    let b: BigInt = BigInt(2);

    let pair = (a.move(), b.move());

    let c: BigInt = BigInt(3);
    let d: BigInt = BigInt(4);
    let pair2 = (c.clone(), d.clone());
    assert c.value == 3: "c still valid after clone in tuple";

    let arr: i32[3] = [1, 2, 3];
    assert arr[0] == 1: "arr[0] should be 1";

    return 0;
}
