// Test: function calls — parameter passing obeys assignment rules
//
// Expected output: 0

struct BigInt {
    value: i64,
}

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

impl Move for BigInt {
    fn invalidate() {}
    fn is_valid() -> bool { true }
}

fn consume(v: BigInt) -> i64 { v.value }

fn read(p: BigInt*) -> i64 { (*p).value }

fn main() {
    let x: BigInt = BigInt(42);
    assert consume(x.move()) == 42: "move then consume";

    let y: BigInt = BigInt(99);
    assert consume(y.clone()) == 99: "clone then consume";
    assert y.value == 99: "y still valid after clone";

    let z: BigInt = BigInt(77);
    assert read(&z) == 77: "read via pointer";

}
