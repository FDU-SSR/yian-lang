// Test: function calls — parameter passing obeys assignment rules
//
// Expected output: 0

struct BigInt {
    value: i64,
}

fn consume(v: BigInt) -> i64 { v.value }

fn read(p: BigInt*) -> i64 { (*p).value }

fn main() {
    let x: BigInt = BigInt(42);
    assert consume(x) == 42: "by-value pass then consume";

    let y: BigInt = BigInt(99);
    assert consume(y) == 99: "by-value pass then consume";
    assert y.value == 99: "y still valid after by-value pass";

    let z: BigInt = BigInt(77);
    assert read(&z) == 77: "read via pointer";

}
