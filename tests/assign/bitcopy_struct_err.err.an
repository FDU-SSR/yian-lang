// Test: @BitCopy struct with non-BitCopy field is rejected
//
// Expected: compilation error

struct Data {
    value: i64,
}

impl Clone for Data {
    pub fn clone() -> Self { Data(self.value) }
}

@BitCopy
struct Bad {
    x: i32,
    d: Data,
}

fn main() -> i32 {
    let b1 = Bad(1, Data(42));
    let b2 = b1;
    return 0;
}
