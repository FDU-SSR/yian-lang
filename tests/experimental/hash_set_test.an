from std.collections.hash import Hasher;
from std.collections.hash import BuildHasher;
from std.collections.hash import Hash;
from std.collections.hash_set import HashSet;
from std.core.ops import PartialEq;

// 简单的可哈希值类型
pub struct MyVal {
    pub value: i64,
}

impl PartialEq<MyVal> for MyVal {
    bool eq(MyVal other) {
        return self.value == other.value;
    }
}

// 简单的可配置哈希器，允许在 hash 方法中直接设置结果
pub struct DummyHasher {
    result: u64,
}

impl DummyHasher {
    pub static DummyHasher new(u64 seed) {
        return DummyHasher(seed);
    }

    // 允许外部直接设置哈希结果，便于测试
    pub fn set_result(v: u64) {
        self.result = v;
    }
}

// BuildHasher 实现，生成 DummyHasher
pub struct DummyBuildHasher {
    seed: u64,
}

impl DummyBuildHasher {
    pub static DummyBuildHasher with_seed(u64 seed) {
        return DummyBuildHasher(seed);
    }
}

impl BuildHasher<DummyHasher> for DummyBuildHasher {
    DummyHasher build_hasher() {
        return DummyHasher.new(self.seed);
    }
}

// Hasher 实现：finish 返回当前 result，write 忽略输入
impl Hasher for DummyHasher {
    u64 finish() {
        return self.result;
    }

    fn write(bytes: u8[]) {
        // 测试哈希器，忽略输入
    }
}

// 为 MyVal 提供 Hash 实现：直接把 value 写入哈希器
impl Hash<DummyHasher> for MyVal {
    fn hash(hasher: DummyHasher) {
        // 将值的无符号表示写入哈希器
        hasher.set_result(u64(self.value));
    }
}

// ---------- 测试开始 ----------
fn main() {
    // 基础构造与容量
    let set1: HashSet<MyVal, DummyHasher, DummyBuildHasher> = HashSet<MyVal, DummyHasher, DummyBuildHasher>.with_capacity_and_hasher(
        0,
        DummyBuildHasher.with_seed(0)
    )
    assert set1.len() == 0: "new() should create empty set"
    assert set1.is_empty(): "new() should be empty"

    let set2: HashSet<MyVal, DummyHasher, DummyBuildHasher> = HashSet<MyVal, DummyHasher, DummyBuildHasher>.with_capacity_and_hasher(
        4,
        DummyBuildHasher.with_seed(0)
    )
    assert set2.len() == 0: "with_capacity should start empty"
    assert set2.is_empty(): "with_capacity should start empty"

    // insert & contains
    let inserted: bool;
    inserted = set2.insert(MyVal(1))
    assert inserted: "first insert should succeed"
    assert set2.len() == 1: "len should be 1 after insert"
    assert set2.contains(MyVal(1)): "contains should find inserted value"

    // duplicate insert should fail
    inserted = set2.insert(MyVal(1))
    assert ! inserted: "duplicate insert should return false"
    assert set2.len() == 1: "len should ! change after duplicate insert"

    // insert more and test remove
    set2.insert(MyVal(2))
    set2.insert(MyVal(3))
    assert set2.len() == 3: "len should reflect inserted items"

    let removed: bool;
    removed = set2.remove(MyVal(2))
    assert removed: "remove should return true for existing item"
    assert set2.len() == 2: "len should decrement after remove"
    assert ! set2.contains(MyVal(2)): "removed item should ! be contained"

    // remove missing
    removed = set2.remove(MyVal(99))
    assert ! removed: "remove should return false for missing item"

    // clear
    set2.clear()
    assert set2.len() == 0: "clear should reset size"
    assert set2.is_empty(): "clear should make set empty"

    // 触发 resize：初始容量4，growth_left=3，插入第4个元素会触发扩容
    let set3: HashSet<MyVal, DummyHasher, DummyBuildHasher> = HashSet<MyVal, DummyHasher, DummyBuildHasher>.with_capacity_and_hasher(
        4,
        DummyBuildHasher.with_seed(0)
    )
    set3.insert(MyVal(10))
    set3.insert(MyVal(20))
    set3.insert(MyVal(30))
    // 此时 growth_left 应为 0，下次插入应触发 resize
    set3.insert(MyVal(40))
    assert set3.len() == 4: "len should be 4 after inserts"
    assert set3.contains(MyVal(10))
    assert set3.contains(MyVal(20))
    assert set3.contains(MyVal(30))
    assert set3.contains(MyVal(40))

    return 0
}

