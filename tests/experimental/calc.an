// A simple calculator for testing the fs module

from std.core.string import String;
from std.core.io import readline, print;
from std.core.option import Option;
from std.core.str import CharIndicesIter;

fn main() -> i32 {
    loop {
        let line: String = readline().trimmed()
        if line == "exit" {
            break
        }
        if line.is_empty() {
            continue
        }

        let op_idx: Option<u64> = Option<u64>.None
        let op: Option<char> = Option<char>.None
        let chars: CharIndicesIter = line.char_indices()

        if line.starts_with_char('-') {
            chars.next()
        }

        for elem in chars {
            let idx: u64 = elem[0]
            let ch: char = elem[1]
            if "+-*/".contains_char(ch) {
                op_idx = Option<u64>.Some(idx)
                op = Option<char>.Some(ch)
                break
            }
        }

        if op_idx.is_none() {
            print("Invalid expression: no operator found")
            continue
        }
        let idx: u64 = op_idx.unwrap()
        let operator: char = op.unwrap()
        let left_str: str = line[0u64..idx].trim()
        let right_str: str = line[idx + 1..line.len()].trim()

        let left_num: i64;
        let right_num: i64;
        match left_str.parse<i64>() {
            let left_num: Ok as ok { = ok.val }
            Err as err {
                print("Invalid expression: unable to parse left operand")
                continue
            }
        }
        match right_str.parse<i64>() {
            let right_num: Ok as ok { = ok.val }
            Err as err {
                print("Invalid expression: unable to parse right operand")
                continue
            }
        }

        let result: i64;
        match operator {
            '+' => { result = left_num + right_num }
            '-' => { result = left_num - right_num }
            '*' => { result = left_num * right_num }
            '/' => { result = left_num / right_num }
            _ => {
                print("Invalid operator")
                continue
            }
        }

        print("Result: ")
        print(result.to_string())
        print("\n")
    }

    return 0
}