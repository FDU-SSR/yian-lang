struct RFX_MESSAGE {
    i32 numTiles
    i32* tiles
}

i32 rfx_allocate_tiles(RFX_MESSAGE* message, i32 count){
    i32* tmpTiles = dyn i32[count]
    i32** tiles_addr = &message.tiles
    *tiles_addr = tmpTiles
    return 0
}
i32 rfx_message_get_tile(RFX_MESSAGE* message, i32 index){
    i32* _vv5 = (*message).tiles;
    i32 _vv4 = _vv5[index]; // Problem: potential null pointer dereference
    return _vv4;
}
i32 main(){
    RFX_MESSAGE message
    i32* tmp1 = &message.numTiles
    *tmp1 = 0
    i32** tmp2 = &message.tiles
    *tmp2 = dyn i32

    rfx_allocate_tiles(&message, message.numTiles)

    tmp1 = &message.numTiles
    *tmp1 = 1

    for i32 i = 0; i < message.numTiles; i += 1 {
        rfx_message_get_tile(&message, i)
    }

    del message.tiles
    return message.numTiles
}