fn main(i32 argc, char** argv) -> i32 {
    // if argc < 2 {
    //     return 1
    // }
    let record: char* = "i"
    let field: char = record[0]
    let rest: char* = record + 2
    let i: i32 = 0
    match field {
    'i': 
        while *rest != '\0' {
            let c: char = *rest
            rest = rest + 1
            i+=1
        }
    'c': 
        while *rest != '\0' {
            let c: char = *rest
            rest = rest + 1
            i+=1
        }
    _:
        assert 1==1: "Invalid field"
    }
    return i
}