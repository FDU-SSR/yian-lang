i32 main(i32 argc, char** argv){
    // if argc < 2 {
    //     return 1
    // }
    char* record = "i"
    char field = record[0]
    char* rest = record + 2
    i32 i = 0
    match field {
    'i': 
        while *rest != '\0' {
            char c = *rest
            rest = rest + 1
            i+=1
        }
    'c': 
        while *rest != '\0' {
            char c = *rest
            rest = rest + 1
            i+=1
        }
    _:
        assert 1==1: "Invalid field"
    }
    return i
}