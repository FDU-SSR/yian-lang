enum Option<T> {
    None,
    Some{T value}
}

let g_ptr: Option<char*> = Option<char*>.None

fn use_g_ptr() {
	match g_ptr {
		Some as some:
			*(some.value) = 'a'
		_: ;
	}
}

fn free_g_ptr() {
	match g_ptr {
		Some as some:
			del some.value
			// some 的作用域必须在此前终结!
			g_ptr = Option<char*>.None
		_: ;
	}
}

fn main() -> i32 {
	g_ptr = Option<char*>.Some(dyn char)
	fn use_g_ptr()
	fn free_g_ptr()
	fn free_g_ptr()
	return 0
}