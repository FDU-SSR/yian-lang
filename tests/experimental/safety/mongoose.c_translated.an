fn decode_variable_length(char* buf, i32* bytes_consumed) -> i32 {
    let value: i32 = 0;
    let multiplier: i32 = 1;
    let offset: i32;
    for offset = 0; offset < 4; offset = offset + 1 {
        let encoded_byte: char = buf[offset]
        _vv1 = u8(encoded_byte)
        _vv2 = i32(_vv1)
        _vv4 = _vv2 * multiplier
        value = value + _vv4;
        multiplier = multiplier * 128;
        _vv5 = _vv2 & 16
        if _vv5 == 0 {
            break
        }
    }
    
    if bytes_consumed != nullptr {
        _vv8 = offset + 1;
        *(bytes_consumed) = _vv8;
    }
    return value;
}
fn main() {
    let buf: char[3] = [u8(26), u8(27), u8(28)]
    let bytes_consumed: i32 = 0
    fn decode_variable_length(buf, &bytes_consumed)
    return 0
}
