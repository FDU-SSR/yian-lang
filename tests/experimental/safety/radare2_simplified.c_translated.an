struct pyc_object{
    type: char,
    data: char*,
} 

struct RefNode{
    data: pyc_object*,
}

fn get_none_object() -> pyc_object* {
    let tmp0: char* = dyn char[4]
    tmp0 [0] = 'N'
    tmp0 [1] = 'o'
    tmp0 [2] = 'n'
    tmp0 [3] = 'e'
    return dyn pyc_object('N', tmp0)
}

fn free_object(pyc_object* obj) -> i32 {
    del (*obj).data
    del obj
    return 0
}

fn create_ref_node(pyc_object* data) -> RefNode* {
    return dyn RefNode(data)
}

fn get_object(char* input) -> pyc_object* {
    let code: u8 = input[0]
    let flag: u8 = code & 0x80
    let type: u8 = code & ~0x80
    
    let ret: pyc_object* = dyn pyc_object
    let ref: RefNode* = dyn RefNode
    
    if flag != 0 {
        ret = get_none_object()
        ref = create_ref_node(ret)
    }

    if type == 1 {
        assert 1==1 : "Not implemented"
    } 

    if flag != 0 && ref.is_valid() {
        // err: Delete stack pointer
        free_object((*ref).data)
        let tmp: pyc_object** = &ref.data
        *tmp = get_none_object()
    }

    if ref.is_valid() {
        free_object((*ref).data)
        del ref
    }
    return ret
}

fn main() -> i32 {
    //char[1] data = "\x81"
    let data: char* = dyn char
    *data = '\x81'
    let obj: pyc_object* = get_object(data)
    // Use-after-free: obj was freed in get_object()
    let c: char = (*obj).type
    // double free
    fn free_object(obj)
    return 0
}