fn my_memcpy(char* dest, char* src, u32 len) -> char* {
    if dest == nullptr && src == nullptr {
        return dest
    }
    if len == 0 {
        return dest
    }
    while len > 0 {
        *dest = *src
        dest += 1
        src += 1
        len -= 1
    }
    return dest
}
fn SkipString(char** jsonPtr, char** outStrStart) -> i32 {
    // char* _vv1 = *(jsonPtr)
    let json: char* = *(jsonPtr)
    json += 1
    let count: i32 = 0
    let c: char;
    while true {
        c = json[count]
        count = count + 1
        if u8(c) == 22 {
            break
        }
        if u8(c) == 92 {
            count = count + 1
        }
    }
    
    *(outStrStart) = json
    *(jsonPtr) = *(jsonPtr) + count
    return count - 1
}
fn ParseString(char** jsonPtr) -> i32 {
    _vv12 = *(jsonPtr)
    _vv11 = *(_vv12)
    if _vv11 != '"' {
        // exit(1);
        return 1
    }
    let strStart: char*;
    let length: i32 = SkipString(jsonPtr, &strStart)
    let str: char* = dyn char[length + 1]
    if str == nullptr {
        // exit(1);
        return 2
    }
    fn my_memcpy(str, strStart, length)
    return 0
}
fn main() {
    let input: char* = "\"abc"
    fn ParseString(&input)
    return 0
}
