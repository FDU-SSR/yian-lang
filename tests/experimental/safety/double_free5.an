struct request {
	char *cmd1
	char *cmd2
}

struct Sg_request {
 rq: request*,
}

// should be replaced
fn blk_mq_free_request(request *rq) {}

fn remove_cmds(request *rq) {
	del rq.cmd1;
	del rq.cmd2;
}

fn blk_end_request_all(rq: request*) {
	let cond: i32;
	
	if cond != 0 {
		remove_cmds(rq);
	}
}

fn sg_finish_rem_req(Sg_request *srp) {
	let cond: i32;

	if cond != 0 {
		remove_cmds(srp.rq);
	}

	blk_mq_free_request(srp.rq);
}

fn sg_common_write(Sg_request *srp) -> i32 {
	let cond: i32;
	let cond2: i32;
	
	if cond != 0 {
		if cond2 != 0 {
			blk_end_request_all(srp.rq)
		}

		sg_finish_rem_req(srp)
		return 1
	}

	return 0
}

fn add_request() -> Sg_request* {
	Sg_request *srp = dyn Sg_request
	srp.rq = dyn request
	srp.rq.cmd1 = dyn char
	srp.rq.cmd2 = dyn char
	return srp
}

fn sg_new_write(Sg_request **o_srp) -> i32 {
	Sg_request *srp
	srp = add_request()

	let k: i32 = sg_common_write(srp)

	return k
}

fn sg_ioctl() {
	Sg_request *srp

 let result: i32 = sg_new_write(&srp);
}

fn sys_test() {
	sg_ioctl();
}

fn main() -> i32 {
	fn sys_test()
	return 0
}
