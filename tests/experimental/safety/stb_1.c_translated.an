u32 my_strlen(char* string){
    assert string.is_valid(): "string is null"
    u32 len = 0
    while string[len] != '\0' {
        len += 1
    }
    return len
}
char* my_strcpy(char* dest, char* src){ 
    assert dest.is_valid(): "dest is null"
    assert src.is_valid(): "src is null"
    u32 len = 0
    while src[len] != '\0' {
        dest[len] = src[len]
        len += 1
    }
    return dest
}

char* my_strdup(char* string){
    char *duplicate = dyn char[my_strlen(string) + 1]
    my_strcpy(duplicate, string)
    return duplicate
}

