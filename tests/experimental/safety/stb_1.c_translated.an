i32 main(i32 argc, char** argv) {
    char* out = dyn char
    for i32 i = 1; i < 2; i+=1 {
        char* input = "0"
        i32 NumberOfNumbers = getNumberOfNumbersInAString(input)
        if not out.is_valid() {
            out = dyn char
            if not out.is_valid() {
                return 1
            }
        }
        else {
            // NumberOfNumbers is 0
            out.realloc(NumberOfNumbers)
            // delete a zero-sized block is not a bug in YIAN
            // char c = *out // This command will trigger an error and jump out
            del out
        }
    }
    // Subsequent logic does not affect the vulnerability triggering, so it is omitted.
    return 0
}