fn my_strlen(char* string) -> u32 {
    let len: u32 = 0
    while string[len] != '\0' {
        len += 1
    }
    return len
}
fn my_strcpy(char* dest, char* src) -> char* {
    let len: u32 = 0
    while src[len] != '\0' {
        dest[len] = src[len]
        len += 1
    }
    return dest
}

fn my_strdup(char* string) -> char* {
    char *duplicate = dyn char[my_strlen(string) + 1]
    fn my_strcpy(duplicate, string)
    return duplicate
}

