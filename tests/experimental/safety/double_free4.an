struct request {
 cmd: u8*,
}

struct Sg_request {
 rq: request*,
}

// should be replaced
fn blk_mq_free_request(rq: request*) {}

fn blk_end_request_all(rq: request*) {
	let cond: i32;
	
	if cond != 0 {
		blk_mq_free_request(rq);
    }
}

fn sg_finish_rem_req(srp: Sg_request*) {
	let cond: i32;

	if cond != 0 {
		del srp.rq.cmd;
    }
	blk_mq_free_request(srp.rq);
}

fn sg_common_write(Sg_request *srp) -> i32 {
	let cond: i32;
    let cond2: i32;
	
	if cond != 0 {
		if cond2 != 0 {
			blk_end_request_all(srp.rq)
        }

		sg_finish_rem_req(srp)
		return 1
	}

	return 0
}

fn sg_add_request() -> Sg_request* {
	return dyn Sg_request
}

fn sg_new_write(Sg_request** o_srp) -> i32 {
	Sg_request *srp
	srp = sg_add_request()

	srp.rq = dyn request
	srp.rq.cmd = dyn u8

	let k: i32 = sg_common_write(srp)

	return k
}

fn sg_ioctl() {
	let srp: Sg_request*;

 let result: i32 = sg_new_write(&srp);
}

fn sys_test() {
	sg_ioctl();
}

fn main() -> i32 {
	fn sys_test()
	return 0
}