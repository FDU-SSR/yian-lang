fn my_strcpy(char* dest, char* src) -> char* {
    assert dest.is_valid(): "dest is null"
    assert src.is_valid(): "src is null"
    let d: char* = dest
    while *src != '\0' {
        *d = *src
        d += 1
        src += 1
    }
    return dest
}
fn tinydir_file_open(char* path) -> i32 {
    let dir_name_buf: char[4096];
    let file_name_buf: char[256];
    let dir_name: char*;
    let base_name: char*;
    let path_len: i32 = 360
    if ! path.is_valid() || path_len == 0 || path_len >= 4096{
        return -1
    } 
    // 缺少strcpy
    fn my_strcpy(dir_name_buf, path)
    fn my_strcpy(file_name_buf, path)
    return 0
}
fn main(i32 argc, char argv) -> i32 {
    let path: char* = ""
    if tinydir_file_open(path) == -1 {
        return 1
    }
    return 0
}