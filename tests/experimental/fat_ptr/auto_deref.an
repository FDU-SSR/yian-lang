struct Person {
    age: i32,
    height: f64,
}

impl Person {
    i32 get_age() {
        return self.age;
    }

    fn set_height(height: f64) {
        self.height = height;
    }
}

fn main() -> i32 {
    let p: Person* = dyn Person(10, 100.0)
    p.set_height(200.0)
    p.age += 1
    let age: i32 = p.get_age()
    let height: f64 = p.height
    assert age == 11: "fail 1"
    assert p.height < 200.1 && p.height > 199.9: "fail 2"
    return 0
}