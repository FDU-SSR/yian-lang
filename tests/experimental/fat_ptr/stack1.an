fn main() -> i32 {
    let arr: i32[10];
    let parr: i32* = arr
    for u64 i = 0; i < 10; i += 1 {
        parr[i] = i32(i)
    }
    let sum: i32 = 0
    for u64 i = 0; i < 10; i += 1 {
        sum += parr[i]
    }
    assert sum == 45: "sum != 45"
    assert arr[9] == 9: "arr[9] != 9"
    return 0
}