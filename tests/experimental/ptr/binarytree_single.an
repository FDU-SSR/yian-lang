from std.core.ptr import RawPtr
from std.core.option import Option
struct treeNode{
    Option<RawPtr<treeNode>> left
    Option<RawPtr<treeNode>> right
}

RawPtr<treeNode> NewTreeNode(Option<RawPtr<treeNode>> left, Option<RawPtr<treeNode>> right) {
    RawPtr<treeNode> node = RawPtr<treeNode>.new_object()
    (*node).left = left
    (*node).right = right
    return node
}

i64 ItemCheck(RawPtr<treeNode> tree)
{
    i64 res = 1
    treeNode tree_item = *tree
    Option<RawPtr<treeNode>> left = tree_item.left
    Option<RawPtr<treeNode>> right = tree_item.right
    match left {
        Some as load { res += ItemCheck(load.val) }
        _ {}
    }
    match right {
        Some as load { res += ItemCheck(load.val) }
        _ {}
    }
    return res
}

RawPtr<treeNode> BottomUpTree(u32 depth)
{
    if depth > 0
    {
        RawPtr<treeNode> left_child = BottomUpTree(depth - 1)
        RawPtr<treeNode> right_child = BottomUpTree(depth - 1)
        return NewTreeNode(Option<RawPtr<treeNode>>.Some(left_child), Option<RawPtr<treeNode>>.Some(right_child))
    }
    else
    {
        return NewTreeNode(Option<RawPtr<treeNode>>.None, Option<RawPtr<treeNode>>.None)
    }
}
DeleteTree(RawPtr<treeNode> tree)
{
    treeNode tree_item = *tree
    Option<RawPtr<treeNode>> left = tree_item.left
    Option<RawPtr<treeNode>> right = tree_item.right
    match left {
        Some as load { DeleteTree(load.val) }
        _ {}
    }
    match right {
        Some as load { DeleteTree(load.val) }
        _ {}
    }
    tree.delete()
}


i32 main()
{
    u32 N = 20
    u32 minDepth = 4
    u32 maxDepth = N
    i64 check = 0

    if (minDepth + 2) > N {
        maxDepth = minDepth + 2
    }
    
    u32 stretchDepth = maxDepth + 1
    RawPtr<treeNode> stretchTree = BottomUpTree(stretchDepth)
    DeleteTree(stretchTree)

    RawPtr<treeNode> longLivedTree = BottomUpTree(maxDepth)

    for u32 depth = minDepth; depth <= maxDepth; depth += 2
    {
        u32 totalDepth = maxDepth - depth + minDepth
        i64 iterations = 1
        for u32 i = 0; i < totalDepth; i+=1 {
            iterations *= 2
        }
        for i64 i = 0; i < iterations; i += 1
        {
            RawPtr<treeNode> tempTree = BottomUpTree(depth)
            check += ItemCheck(tempTree)
            DeleteTree(tempTree)
        }
    }
    DeleteTree(longLivedTree)
    
    assert i32(check % 256) == 176: "fail"
    print("pass")
    return 0
}