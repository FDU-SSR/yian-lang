from std.core.ptr import RawPtr;
from std.core.option import Option;
struct treeNode{
    left: Option<RawPtr<treeNode>>,
    right: Option<RawPtr<treeNode>>,
}

fn NewTreeNode(Option<RawPtr<treeNode>> left, Option<RawPtr<treeNode>> right) -> RawPtr<treeNode> {
    let node: RawPtr<treeNode> = RawPtr<treeNode>.new_object()
    (*node).left = left
    (*node).right = right
    return node
}

fn ItemCheck(RawPtr<treeNode> tree) -> i64 
{
    let res: i64 = 1
    let tree_item: treeNode = *tree
    let left: Option<RawPtr<treeNode>> = tree_item.left
    let right: Option<RawPtr<treeNode>> = tree_item.right
    match left {
        Some as load { res += ItemCheck(load.val) }
        _ => {}
    }
    match right {
        Some as load { res += ItemCheck(load.val) }
        _ => {}
    }
    return res
}

fn BottomUpTree(u32 depth) -> RawPtr<treeNode> 
{
    if depth > 0
    {
        let left_child: RawPtr<treeNode> = BottomUpTree(depth - 1)
        let right_child: RawPtr<treeNode> = BottomUpTree(depth - 1)
        return NewTreeNode(Option<RawPtr<treeNode>>.Some(left_child), Option<RawPtr<treeNode>>.Some(right_child))
    }
    else
    {
        return NewTreeNode(Option<RawPtr<treeNode>>.None, Option<RawPtr<treeNode>>.None)
    }
}
fn DeleteTree(tree: RawPtr<treeNode>)
{
    let tree_item: treeNode = *tree
    let left: Option<RawPtr<treeNode>> = tree_item.left
    let right: Option<RawPtr<treeNode>> = tree_item.right
    match left {
        Some as load { DeleteTree(load.val) }
        _ => {}
    }
    match right {
        Some as load { DeleteTree(load.val) }
        _ => {}
    }
    tree.delete()
}


fn main() -> i32 
{
    let N: u32 = 20
    let minDepth: u32 = 4
    let maxDepth: u32 = N
    let check: i64 = 0

    if (minDepth + 2) > N {
        maxDepth = minDepth + 2
    }
    
    let stretchDepth: u32 = maxDepth + 1
    let stretchTree: RawPtr<treeNode> = BottomUpTree(stretchDepth)
    fn DeleteTree(stretchTree)

    let longLivedTree: RawPtr<treeNode> = BottomUpTree(maxDepth)

    for u32 depth = minDepth; depth <= maxDepth; depth += 2
    {
        let totalDepth: u32 = maxDepth - depth + minDepth
        let iterations: i64 = 1
        for u32 i = 0; i < totalDepth; i+=1 {
            iterations *= 2
        }
        for i64 i = 0; i < iterations; i += 1
        {
            let tempTree: RawPtr<treeNode> = BottomUpTree(depth)
            check += ItemCheck(tempTree)
            DeleteTree(tempTree)
        }
    }
    fn DeleteTree(longLivedTree)
    
    assert i32(check % 256) == 176: "fail"
    fn print("pass")
    return 0
}