// 使用 Murmur3Hasher 的 HashMap 测试，键/值类型为 i64
//
// Expected output: 0

from std.core.hash import Murmur3BuildHasher;
from std.collections.hash_map import HashMap;

fn main() -> i32 {
    // === Test 1: 基础构造 ===
    let map1: HashMap<i64, i64> = HashMap<i64, i64>.with_capacity_and_hasher(
        0,
        Murmur3BuildHasher.with_seed(0)
    )
    assert map1.len() == 0: "new map should have len 0";
    assert map1.is_empty(): "new map should be empty";

    // === Test 2: insert & get ===
    let map2: HashMap<i64, i64> = HashMap<i64, i64>.with_capacity_and_hasher(
        8,
        Murmur3BuildHasher.with_seed(42)
    )

    let k1: i64 = 1;
    let k2: i64 = 2;
    let k3: i64 = 3;
    let val100: i64 = 100;
    let val200: i64 = 200;
    let val300: i64 = 300;

    map2.insert(k1, val100);
    assert map2.len() == 1: "len should be 1";
    assert map2.get(k1).unwrap() == 100: "get(1) should return 100";
    assert map2.contains(k1): "contains(1) should be true";

    map2.insert(k2, val200);
    map2.insert(k3, val300);
    assert map2.len() == 3: "len should be 3";
    assert map2.get(k2).unwrap() == 200: "get(2) should return 200";
    assert map2.get(k3).unwrap() == 300: "get(3) should return 300";

    // === Test 3: 覆盖写入 ===
    let val999: i64 = 999;
    map2.insert(k1, val999);
    assert map2.len() == 3: "len unchanged after overwrite";
    assert map2.get(k1).unwrap() == 999: "get(1) should return updated value";

    // === Test 4: get 不存在的键 ===
    let k99: i64 = 99;
    assert map2.get(k99).is_none(): "get missing key should return None";
    assert ! map2.contains(k99): "contains missing key should be false";

    // === Test 5: remove ===
    map2.remove(k2);
    assert map2.len() == 2: "len should be 2 after remove";
    assert map2.get(k2).is_none(): "removed key should return None";
    assert map2.get(k1).unwrap() == 999: "key 1 still exists";
    assert map2.get(k3).unwrap() == 300: "key 3 still exists";

    // remove 不存在的键
    let k888: i64 = 888;
    map2.remove(k888);
    assert map2.len() == 2: "remove missing should ! change len";

    // === Test 6: clear ===
    map2.clear();
    assert map2.len() == 0: "clear should reset len";
    assert map2.is_empty(): "clear should make map empty";
    assert map2.get(k1).is_none(): "key 1 gone after clear";

    // === Test 7: 大量插入触发 resize ===
    let map3: HashMap<i64, i64> = HashMap<i64, i64>.with_capacity_and_hasher(
        4,
        Murmur3BuildHasher.with_seed(7)
    )
    for i in 0i64..20 {
        map3.insert(i, i * 10);
    }
    assert map3.len() == 20: "should have 20 entries";
    for i in 0i64..20 {
        assert map3.get(i).unwrap() == i * 10: "value should match key * 10";
    }
    let k20: i64 = 20;
    assert map3.get(k20).is_none(): "should ! contain key 20";

    // === Test 8: 不同 seed ===
    let map4: HashMap<i64, i64> = HashMap<i64, i64>.with_capacity_and_hasher(
        8,
        Murmur3BuildHasher.with_seed(123)
    )
    let k100: i64 = 100;
    let k200: i64 = 200;
    let k300: i64 = 300;
    let k400: i64 = 400;
    let v1: i64 = 1;
    let v2: i64 = 2;
    let v3: i64 = 3;
    map4.insert(k100, v1);
    map4.insert(k200, v2);
    map4.insert(k300, v3);
    assert map4.get(k100).unwrap() == 1: "seed 123: get 100";
    assert map4.get(k200).unwrap() == 2: "seed 123: get 200";
    assert map4.get(k300).unwrap() == 3: "seed 123: get 300";
    assert map4.get(k400).is_none(): "seed 123: 400 ! present";

    // === Test 9: 索引访问 ===
    let map5: HashMap<i64, i64> = HashMap<i64, i64>.new()
    map5.insert(k1, val100);
    assert map5[k1] == 100: "index access should return value";
    map5[k1] = val999
    assert map5[k1] == 999: "index assignment should update value";

    return 0;
}
