// Test for ToString implementations on basic types
//
// Expected output: 0

from std.core.fmt import ToString;

fn main() -> i32 {
    // Unsigned integers
    let u8v: u8 = 255u8;
    assert u8v.to_string() == "255": "u8 to_string failed\n";

    let u16v: u16 = 65535u16;
    assert u16v.to_string() == "65535": "u16 to_string failed\n";

    let u32v: u32 = 4294967295u32;
    assert u32v.to_string() == "4294967295": "u32 to_string failed\n";

    let u64v: u64 = 18446744073709551615u64;
    assert u64v.to_string() == "18446744073709551615": "u64 to_string failed\n";

    // Signed integers
    let i8v: i8 = i8(-42);
    assert i8v.to_string() == "-42": "i8 to_string failed\n";

    let i16v: i16 = i16(-1234);
    assert i16v.to_string() == "-1234": "i16 to_string failed\n";

    let i32v: i32 = -123456;
    assert i32v.to_string() == "-123456": "i32 to_string failed\n";

    let i64v: i64 = -1234567890123i64;
    assert i64v.to_string() == "-1234567890123": "i64 to_string failed\n";

    // Floating-point
    let f32v: f32 = 1.25_f32;
    assert f32v.to_string() == "1.25": "f32 to_string failed\n";

    let f64v: f64 = -3.5;
    assert f64v.to_string() == "-3.5": "f64 to_string failed\n";

    let f64int: f64 = 10.0;
    assert f64int.to_string() == "10": "f64 integer-like to_string failed\n";

    // bool
    let b1: bool = true;
    let b2: bool = false;
    assert b1.to_string() == "true": "true to_string failed\n";
    assert b2.to_string() == "false": "false to_string failed\n";

    // char
    let ch: char = 'A';
    assert ch.to_string() == "A": "char to_string failed\n";

    return 0;
}
