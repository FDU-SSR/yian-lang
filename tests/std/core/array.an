// Test standard library array functions
//
// Expected output: 0

fn main() {
    let arr = [0u8, 1, 2, 3, 4];

    // Test as_slice method
    let slice = arr.as_slice();
    assert slice.len() == 5;
    assert slice[0] == 0;
    assert slice[4] == 4;

    // Test to_vec method
    let vec = arr.to_vec();
    assert vec.len() == 5;
    assert vec[0] == 0;
    assert vec[4] == 4;

    // Test indexing
    assert arr[0] == 0;
    assert arr[4] == 4;

    // Test range indexing
    let range = 1u64..4;
    let sub_slice = arr[range];
    assert sub_slice.len() == 3;
    assert sub_slice[0] == 1;
    assert sub_slice[2] == 3;

    let vec_arr = [Vec<u8>.new(), Vec<u8>.new(), Vec<u8>.new()];
    vec_arr[0].push(1);
    vec_arr[1].push(2);
    vec_arr[2].push(3);

    // Test iteration over array
    let sum = 0u8;
    for num in arr {
        sum += *num;
    }
    assert sum == 10;

    // Test deep copy (按位复制下直接拷贝会共享缓冲, 显式 to_vec 深拷贝)
    let cloned_vec_arr = [vec_arr[0].as_slice().to_vec(), vec_arr[1].as_slice().to_vec(), vec_arr[2].as_slice().to_vec()];
    assert cloned_vec_arr[0][0] == 1;
    assert cloned_vec_arr[1][0] == 2;
    assert cloned_vec_arr[2][0] == 3;
    assert &cloned_vec_arr[0][0] != &vec_arr[0][0]; // Ensure deep copy

    // 按位复制: 显式深拷贝副本与原值独立, 原值保持有效
    let copied_vec_arr = [vec_arr[0].as_slice().to_vec(), vec_arr[1].as_slice().to_vec(), vec_arr[2].as_slice().to_vec()];
    assert copied_vec_arr[0][0] == 1;
    assert copied_vec_arr[1][0] == 2;
    assert copied_vec_arr[2][0] == 3;
    assert vec_arr[0][0] == 1: "original vec_arr[0] still valid";
    assert vec_arr[1][0] == 2: "original vec_arr[1] still valid";
    assert vec_arr[2][0] == 3: "original vec_arr[2] still valid";

}