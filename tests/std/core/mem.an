// Test mem functions
//
// Expected output: 0

from std.core.mem import memcpy, memmove;

fn main() {
    let src = [1u8, 2, 3, 4, 5];
    let dest = [0u8; 5];

    // Test memcpy function
    memcpy(dest.ptr(), src.ptr(), 5);
    assert dest[0] == 1;
    assert dest[4] == 5;

    let right = [1u8, 2, 3, 4, 5];
    memmove(right.ptr() + 1, right.ptr(), 4);
    assert right[0] == 1 && right[1] == 1;
    assert right[2] == 2 && right[3] == 3 && right[4] == 4;

    let left = [1u8, 2, 3, 4, 5];
    memmove(left.ptr(), left.ptr() + 1, 4);
    assert left[0] == 2 && left[1] == 3;
    assert left[2] == 4 && left[3] == 5 && left[4] == 5;

}
