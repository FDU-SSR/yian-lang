// Test the Option type and its methods
//
// Expected output: 0

from std.core.option import Option;

fn main() {
    // Create an Option with a value
    let opt1: Option<i32> = Option<i32>.Some(42);
    let opt2: Option<i32> = Option<i32>.None;

    assert opt1.is_some(): "opt1 should be Some";
    assert !opt1.is_none(): "opt1 should ! be None";
    assert !opt2.is_some(): "opt2 should ! be Some";
    assert opt2.is_none(): "opt2 should be None";

    // Unwrap with a default value
    assert *opt1.unwrap_or(&100) == 42: "opt1 should unwrap to 42";
    assert *opt2.unwrap_or(&100) == 100: "opt2 should unwrap to 100";

    // Take the value out of opt1
    let taken: Option<i32> = opt1.take();
    assert taken.is_some(): "taken should be Some";
    assert *taken.unwrap_or(&0) == 42: "taken should unwrap to 42";
    assert opt1.is_none(): "opt1 should now be None";

    // Replace the value in opt2
    let replaced: Option<i32> = opt2.replace(99);
    assert replaced.is_none(): "replaced should be None";
    assert opt2.is_some(): "opt2 should now be Some";
    assert *opt2.unwrap_or(&0) == 99: "opt2 should unwrap to 99";

    // Copy — assignment copies the value (按位复制), original unchanged
    let opt3: Option<i32> = opt2;
    assert opt3.is_some(): "opt3 should be Some";
    assert *opt3.unwrap_or(&0) == 99: "opt3 should unwrap to 99";
    assert *opt2.unwrap_or(&0) == 99: "original should be unchanged after copy";

    // unwrap — returns T*; must dereference to compare value
    let opt4: Option<i32> = Option<i32>.Some(77);
    assert *opt4.unwrap() == 77: "unwrap should return the inner value";

    // Bitcopy semantics: assigning copies the value, original stays valid
    let opt5: Option<i32> = Option<i32>.Some(55);
    let opt6 = opt5;
    assert opt6.is_some(): "opt6 should be Some";
    assert *opt6.unwrap() == 55: "opt6 should unwrap to 55";
    assert opt5.is_some(): "opt5 should remain Some after bitcopy";
    assert *opt5.unwrap() == 55: "opt5 should still unwrap to 55";

}