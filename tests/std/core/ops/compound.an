// Test compound assignment operator overloading
//
// Expected output: 0

from std.core.ops import AddAssign, SubAssign, MulAssign, DivAssign, RemAssign;
from std.core.ops import BitAndAssign, BitOrAssign, BitXorAssign, ShlAssign, ShrAssign;

@BitCopy
struct Value<T> {
    pub value: T,
}

// ---- arithmetic compound ----

impl<T> AddAssign<Value<T>, Value<T>> for Value<T> {
    fn add_assign(rhs: Self) -> Self {
        self.value += rhs.value;
        return Self(self.value);
    }
}

impl<T> SubAssign<Value<T>, Value<T>> for Value<T> {
    fn sub_assign(rhs: Self) -> Self {
        self.value -= rhs.value;
        return Self(self.value);
    }
}

impl<T> MulAssign<Value<T>, Value<T>> for Value<T> {
    fn mul_assign(rhs: Self) -> Self {
        self.value *= rhs.value;
        return Self(self.value);
    }
}

impl<T> DivAssign<Value<T>, Value<T>> for Value<T> {
    fn div_assign(rhs: Self) -> Self {
        self.value /= rhs.value;
        return Self(self.value);
    }
}

impl<T> RemAssign<Value<T>, Value<T>> for Value<T> {
    fn rem_assign(rhs: Self) -> Self {
        self.value %= rhs.value;
        return Self(self.value);
    }
}

// ---- bitwise compound ----

impl<T> BitAndAssign<Value<T>, Value<T>> for Value<T> {
    fn bitand_assign(rhs: Self) -> Self {
        self.value &= rhs.value;
        return Self(self.value);
    }
}

impl<T> BitOrAssign<Value<T>, Value<T>> for Value<T> {
    fn bitor_assign(rhs: Self) -> Self {
        self.value |= rhs.value;
        return Self(self.value);
    }
}

impl<T> BitXorAssign<Value<T>, Value<T>> for Value<T> {
    fn bitxor_assign(rhs: Self) -> Self {
        self.value ^= rhs.value;
        return Self(self.value);
    }
}

// ---- shift compound ----

impl<T> ShlAssign<Value<u64>, Value<T>> for Value<T> {
    fn shl_assign(rhs: Value<u64>) -> Self {
        self.value <<= rhs.value;
        return Self(self.value);
    }
}

impl<T> ShrAssign<Value<u64>, Value<T>> for Value<T> {
    fn shr_assign(rhs: Value<u64>) -> Self {
        self.value >>= rhs.value;
        return Self(self.value);
    }
}

fn main() {
    // ---- arithmetic compound ----

    let a: Value<i32> = Value<i32>(10);
    a += Value<i32>(5);
    assert a.value == 15: "add_assign: 10 + 5 = 15";

    a -= Value<i32>(3);
    assert a.value == 12: "sub_assign: 15 - 3 = 12";

    a *= Value<i32>(2);
    assert a.value == 24: "mul_assign: 12 * 2 = 24";

    a /= Value<i32>(4);
    assert a.value == 6: "div_assign: 24 / 4 = 6";

    a %= Value<i32>(4);
    assert a.value == 2: "rem_assign: 6 % 4 = 2";

    // ---- bitwise compound ----

    let b: Value<i32> = Value<i32>(0x0F); // 00001111
    b &= Value<i32>(0x3C);               // 00111100
    assert b.value == 0x0C: "bitand_assign: 0x0F & 0x3C = 0x0C";

    b |= Value<i32>(0x03);               // 00000011
    assert b.value == 0x0F: "bitor_assign: 0x0C | 0x03 = 0x0F";

    b ^= Value<i32>(0xFF);               // 11111111
    assert b.value == 0xF0: "bitxor_assign: 0x0F ^ 0xFF = 0xF0";

    // ---- shift compound ----

    let c: Value<i32> = Value<i32>(1);
    c <<= Value<u64>(3u64);
    assert c.value == 8: "shl_assign: 1 << 3 = 8";

    c >>= Value<u64>(2u64);
    assert c.value == 2: "shr_assign: 8 >> 2 = 2";

}
