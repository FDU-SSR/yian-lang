// Test for operator overloading: Index operator
//
// Expected output: 0

from std.core.ops import Index;

struct Container<T> {
    items: T*,
    size: u64,
}

impl<T> Container<T> {
    static pub fn new(size: u64, default_value: T) -> Self {
        let items: T* = dyn[size] T;
        for i in 0..size {
            items[i] = default_value.clone();
        }
        Self(items, size)
    }
}

impl<T> Index<u64, T*> for Container<T> {
    fn index(idx: u64*) -> T* {
        return self.items + *idx;
    }
}

fn main() {
    let c: Container<i32> = Container<i32>.new(5, 42);
    assert c[0] == 42: "Expected 42";
    assert c[4] == 42: "Expected 42";

    c[2] = 100;
    assert c[2] == 100: "Expected 100";

}