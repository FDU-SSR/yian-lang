// Vec extension clones before reallocation and handles aliases to itself.
fn main() {
    let values = Vec<String>.new();
    values.push(String.from(&"one"));
    values.push(String.from(&"two"));

    let alias = values;
    values.extend(alias);
    assert values.len() == 4;
    assert values[0] == "one" && values[2] == "one";

    let view = values.as_slice();
    values.extend_from_slice(view);
    assert values.len() == 8;
    assert values[4] == "one" && values[7] == "two";

    let joined = values + values;
    assert joined.len() == 16;
    assert values.len() == 8;
    assert joined[0] == "one" && joined[8] == "one";

    values.drop();
    joined.drop();
}
