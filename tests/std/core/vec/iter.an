// Test Vec iterator functions
//
// Expected output: 0

fn main() {
    let vec = [0u8, 1, 2, 3, 4].to_vec();

    // Test reference iterator
    for x in &vec {
        assert *x == vec[u64(*x)];
    }
    assert vec.len() == 5; // Original remains usable

    // Test moving cloned iterator
    for x in vec.clone() {
        assert *x == vec[u64(*x)];
    }
    assert vec.len() == 5;

    // Iteration receives a copied Vec descriptor and does not invalidate vec.
    for x in vec {
        // nop
    }
    assert vec.len() == 5;

}
