// Test Vec iterator functions
//
// Expected output: 0

fn main() {
    let vec = [0u8, 1, 2, 3, 4].to_vec();

    // Test reference iterator
    for x in &vec {
        assert *x == vec[u64(*x)];
    }

    // Test by-value iterator (按位复制: 迭代不消费原值)
    for x in vec {
        assert *x == vec[u64(*x)];
    }
    assert vec.len() == 5: "original vec remains valid after by-value iteration";

}