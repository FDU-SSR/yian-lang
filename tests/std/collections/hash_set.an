// HashSet regression test: insertion, duplicate handling, lookup, removal
// and resize.

from std.core.hash import Murmur3BuildHasher;
from std.collections.hash_set import HashSet;

fn main() {
    let set1: HashSet<i64> = HashSet<i64>.with_capacity_and_hasher(
        0,
        Murmur3BuildHasher.with_seed(0)
    )
    assert set1.len() == 0;
    assert set1.is_empty();

    let set2: HashSet<i64> = HashSet<i64>.with_capacity_and_hasher(
        8,
        Murmur3BuildHasher.with_seed(42)
    )
    assert set2.insert(10);
    assert set2.insert(20);
    assert set2.insert(30);
    assert set2.len() == 3;
    assert set2.contains(&10i64);
    assert !set2.insert(10i64);
    assert set2.len() == 3;
    assert !set2.contains(&99i64);

    assert set2.remove(&20i64);
    assert set2.len() == 2;
    assert !set2.contains(&20i64);
    assert !set2.remove(&999i64);

    set2.clear();
    assert set2.len() == 0;
    assert set2.is_empty();

    let set3: HashSet<i64> = HashSet<i64>.with_capacity_and_hasher(
        4,
        Murmur3BuildHasher.with_seed(7)
    )
    for i in 0i64..20 {
        set3.insert(i);
    }
    assert set3.len() == 20;
    for i in 0i64..20 {
        assert set3.contains(&i);
    }
    assert !set3.contains(&20i64);
}
