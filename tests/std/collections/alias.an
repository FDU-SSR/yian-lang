// Plain assignment shallow-copies descriptors. The size fields are separate,
// while the underlying table is shared until one descriptor releases it.
from std.collections.hash_map import HashMap;
from std.collections.hash_set import HashSet;
from std.core.drop import Drop;

fn main() {
    let map1 = HashMap<i64, i64>.with_capacity(16);
    let map2 = map1;
    map2.insert(7, 70);
    assert map2.len() == 1 && map1.len() == 0;
    assert **map1.get(&7).unwrap() == 70;
    assert map1.contains(&7) && map2.contains(&7);

    let map3 = HashMap<i64, i64>.with_capacity(16);
    map3.insert(1, 10);
    let map4 = map3;
    map4.insert(2, 20);
    map4.insert(3, 30);
    assert map3.len() == 1 && map4.len() == 3;
    assert **map3.get(&3).unwrap() == 30;
    map4.drop();

    let set1 = HashSet<i64>.with_capacity(16);
    let set2 = set1;
    set2.insert(7);
    assert set2.len() == 1 && set1.len() == 0;
    assert set1.contains(&7);
    set2.drop();
}
