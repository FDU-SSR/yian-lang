// Plain assignment shallow-copies map/set descriptors: the copies share one
// bucket table (inserts through either descriptor are visible to both) while
// size fields stay independent. Drop one descriptor only — the other aliases
// the same freed buffers and must not be cleaned separately.
from std.collections.hash_map import HashMap;
from std.collections.hash_set import HashSet;
from std.core.drop import Drop;

fn main() {
    // HashMap: with_capacity(16) leaves growth_left 12, so the inserts below
    // never resize — the shared table stays valid for both descriptors.
    let m1 = HashMap<i64, i64>.with_capacity(16);
    let m2 = m1;
    m2.insert(7, 70);
    assert m2.len() == 1 && m1.len() == 0: "size fields are independent copies";
    assert **m1.get(&7).unwrap() == 70: "copies share the bucket table";
    assert m1.contains(&7) && m2.contains(&7);

    let m3 = HashMap<i64, i64>.with_capacity(16);
    m3.insert(1, 10);
    let m4 = m3;
    m4.insert(2, 20);
    m4.insert(3, 30);
    assert m3.len() == 1 && m4.len() == 3;
    assert **m3.get(&3).unwrap() == 30: "inserts through one copy are visible to the other";
    m4.drop();
    // m3 aliases the freed table: do not touch it again.

    // HashSet behaves the same through its backing map.
    let s1 = HashSet<i64>.with_capacity(16);
    let s2 = s1;
    s2.insert(7);
    assert s2.len() == 1 && s1.len() == 0;
    assert s1.contains(&7): "set copies share the backing table";
    s2.drop();
}
