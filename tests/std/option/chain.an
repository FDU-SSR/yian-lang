// Test Option chained operations
//
// Expected output: 0

from std.core.option import Option;

fn main() -> i32 {
    // Chain: Some -> take -> is_none
    let opt1: Option<i32> = Option<i32>.Some(42);
    let taken: Option<i32> = opt1.take();
    assert taken.is_some(): "taken should be Some";
    assert taken.unwrap_or(0) == 42: "taken should be 42";
    assert opt1.is_none(): "original should be None after take";

    // Chain: None -> replace -> is_some
    let opt2: Option<i32> = Option<i32>.None;
    let replaced: Option<i32> = opt2.replace(99);
    assert replaced.is_none(): "replaced should be None";
    assert opt2.is_some(): "opt2 should now be Some";
    assert opt2.unwrap_or(0) == 99: "opt2 should be 99";

    // Chain: clone -> both same
    let opt3: Option<i32> = Option<i32>.Some(77);
    let cloned: Option<i32> = opt3.clone();
    assert cloned.is_some(): "cloned should be Some";
    assert cloned.unwrap_or(0) == 77: "cloned should be 77";
    assert opt3.unwrap_or(0) == 77: "original should still be 77";

    return 0;
}
