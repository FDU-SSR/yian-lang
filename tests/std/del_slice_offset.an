// del-view 负例(d,std):from_raw_parts 偏移视图 del → trap。`from_raw_parts(p+1, n)`
// 产生 data = lock_ptr+8+4 ≠ lock_ptr+8 的 T[] 视图:CheckDelete 的 is_raw data
// 分量(data==lock_ptr+8)失败(SliceType 无 index 分量,偏移直接体现在 data)
// → llvm.trap → SIGILL → Exit code -4。仅整块视图(lo=0)可 del。
//
// 注:本用例仅 fat 态运行(负例不接 RAW_TESTS;raw 态无检查语义不同)。
//
// Expected exit code: -4

from std.core.slice import from_raw_parts;

fn main() {
    let p: i32* = dyn[4] i32;
    let s: i32[] = from_raw_parts(p + 1, 3);
    del s;
}
