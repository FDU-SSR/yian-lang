// Test slice functionality
//
// Expected output: 0

from std.core.option import Option;
from std.core.vec import Vec;

fn main() -> i32 {
    let arr: i32[5] = [1, 2, 3, 4, 5];
    let slice: i32[] = arr[1u64..4] // This should be a slice containing [2, 3, 4];

    // Test length of the slice
    assert slice.len() == 3: "Expected slice length to be 3";

    // Test getting elements from the slice
    let elem0: Option<i32> = slice.get(0);
    assert elem0.is_some() && elem0.unwrap_or(0) == 2: "Expected first element to be 2";
    let elem1: Option<i32> = slice.get(3) // Out of bounds;
    assert elem1.is_none(): "Expected out of bounds access to return None";

    // Test first and last elements
    let first: Option<i32> = slice.first();
    assert first.is_some() && first.unwrap_or(0) == 2: "Expected first element to be 2";
    let last: Option<i32> = slice.last();
    assert last.is_some() && last.unwrap_or(0) == 4: "Expected last element to be 4";

    // Test converting slice to Vec
    let vec: Vec<i32> = slice.to_vec();
    assert vec.len() == 3: "Expected Vec length to be 3";
    assert vec[0] == 2 && vec[1] == 3 && vec[2] == 4: "Expected Vec elements to be [2, 3, 4]";

    // Test iterating over the slice
    for i in slice {
        assert i >= 2 && i <= 4: "Expected slice elements to be between 2 && 4";
    }

    return 0;
}