// M8.1: Vec<ZST> — push, is_empty, and Drop.
// The element type is zero-sized so allocations are phantom,
// but push logic must still count correctly.
//
// Expected output: 0

fn unit() -> void { return; }

fn main() {
    let v: Vec<void> = Vec<void>.new();
    assert v.is_empty(): "initial empty";

    v.push(unit());
    assert !v.is_empty(): "not empty after push";

    v.push(unit());
    // still not empty after second push — Drop at end must not panic
}
