// Test for 'dyn' statement with struct type dynamic memory allocation
//
// Expected output: Charlie

struct Person{
    i32 age
    str name
}

impl Person{
    static pub Self new(i32 age, str name){
        return Self(age, name)
    }

    pub i32 get_age(){
        return self.age
    }

    pub str get_name(){
        return self.name
    }
}


i32 main() {
    Person* p1 = dyn Person
    *p1 = Person.new(25, "Alice")
    assert p1.get_age() == 25

    Person* p2 = dyn Person(30, "Bob")
    assert p2.get_age() == 30

    Person* p3 = dyn Person[2]
    p3[0] = Person.new(22, "Charlie")
    p3[1] = Person.new(28, "Diana")
    assert p3[0].get_age() == 22
    assert p3[1].get_age() == 28

    print(p3[0].get_name())

    return 0
}
