// Dynamic allocation and deletion of ZST values preserve their zero-sized behavior.
//
// Expected output: 0

struct Empty {}
fn unit() -> void { return; }

fn main() {
    // Repeated allocation of ZST values does not require backing storage.
    let p: void* = dyn[5] void;
    let q: Empty* = dyn[3] Empty;

    // del on ZST pointer: must not crash
    del p;
    del q;

    // read through pointer (no-op load)
    let p2: void* = dyn[1] void;
    let v: void = *p2;

}
