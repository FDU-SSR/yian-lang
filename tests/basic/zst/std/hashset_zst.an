// M8.4: HashSet<ZST> — ZST keys are all indistinguishable,
// so there is at most one logical entry.
//
// Expected output: 0

from std.collections.hash_set import HashSet;

fn unit() -> void { return; }

fn main() {
    let s: HashSet<void> = HashSet<void>.new();

    // insert and check count
    assert s.is_empty(): "initial empty";

    let ok: bool = s.insert(unit());
    assert ok: "first insert succeeds";
    assert s.len() == 1: "size 1 after insert";

    // insert "another" ZST — should be same entry, return false
    let ok2: bool = s.insert(unit());
    assert !ok2: "second insert returns false (already exists)";
    assert s.len() == 1: "size still 1";

}
