// T& follows the pointer layout policy, while references to ZSTs erase to
// zero-sized values and still cross function boundaries.

struct Value { x: i32 }
struct Empty {}

fn pass_value(value: Value&) -> Value& {
    return value;
}

fn pass_empty(value: Empty&) -> Empty& {
    return value;
}

fn main() {
    let value: Value = Value(7);
    let value_ref: Value& = &value;
    let returned: Value& = pass_value(value_ref);
    assert returned.x == 7: "non-ZST T& call and field access";

    let empty: Empty;
    let empty_ref: Empty& = &empty;
    let empty_returned: Empty& = pass_empty(empty_ref);
    assert sizeof(Empty&) == 0: "ZST T& layout";

    let expected_ref_size: u64 = comptime if IS_RAW_MODE { 8u64 } else { 24u64 };
    assert sizeof(Value&) == expected_ref_size: "T& ABI layout";
}
