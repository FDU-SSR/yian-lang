// Deleting a T& that refers to the first element of a heap allocation releases
// the complete allocation.

fn main() {
    let p: i32* = dyn[1] 0i32;
    p[0] = 7;
    let r: i32& = &p[0];
    assert *r == 7: "reads through heap reference";
    del r;

    let q: i32* = dyn[3] 0i32;
    q[0] = 1;
    q[2] = 3;
    assert q[0] + q[2] == 4: "heap stable after del ref";
    del q;
}
