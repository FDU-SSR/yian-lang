// HashMap.clone() copies the table buffers the map itself manages; resources
// owned by keys/values stay shared with the original. Insert/remove/index-writes
// in one map never affect the other's table, and element cleanup stays with the
// caller (a shared buffer is released exactly once).
from std.collections.hash_map import HashMap;
from std.core.clone import Clone;
from std.core.drop import Drop;
from std.core.hash import Hash, Murmur3Hasher;
from std.core.ops import PartialEq;
from std.core.string import String;
from std.core.vec import Vec;

struct SKey {
    tag: String,
    drops: i32*,
}

impl Drop for SKey {
    fn drop() {
        *self.drops += 1;
        self.tag.drop();
    }
}

impl Hash<Murmur3Hasher> for SKey {
    fn hash(hasher: Murmur3Hasher) {
        hasher.write(self.tag.as_slice());
    }
}

impl PartialEq<SKey> for SKey {
    fn eq(other: SKey&) -> bool {
        self.tag.as_str() == other.tag.as_str()
    }
}

impl Clone for SKey {
    fn clone() -> Self {
        SKey(tag=self.tag.clone(), drops=self.drops)
    }
}

fn main() {
    // === 1: plain i64 map: clone starts equal and diverges independently ===
    let m = HashMap<i64, i64>.new();
    for i in 0i64..5 {
        m.insert(i, i * 10);
    }
    let c = m.clone();
    assert m.len() == 5 && c.len() == 5;
    for i in 0i64..5 {
        assert **m.get(&i).unwrap() == i * 10;
        assert **c.get(&i).unwrap() == i * 10: "clone holds a copy of every entry";
    }
    c.insert(99, 999);
    assert m.get(&99).is_none(): "inserting into the clone must not reach the original";
    assert c.remove(&2) && m.contains(&2): "removing from the clone must not reach the original";
    c[1] = 777;
    assert c[1] == 777 && m[1] == 10: "index writes on the clone stay local";
    m.drop();
    c.drop();

    // === 2: nested containers: the clone copies the map's own buffers, while the
    // Vec/String buffers the elements own stay shared ===
    let m2 = HashMap<i64, Vec<String>>.new();
    let v1 = Vec<String>.new();
    v1.push(String.from(&"one"));
    m2.insert(1, v1);
    m2.insert(2, Vec<String>.new());
    let c2 = m2.clone();
    c2[1].push(String.from(&"extra"));
    assert m2[1].len() == 1 && c2[1].len() == 2: "clone descriptors are independent";
    assert c2[1][0] == "one" && c2[1][1] == "extra";

    // 元素缓冲区与原件共享, 每个缓冲区只释放一次(选任意一侧), 再释放表存储。
    m2[1][0].drop();
    c2[1][1].drop();
    m2[1].drop();
    m2[2].drop();
    m2.drop();
    c2.drop();

    // === 3: heap-backed keys: deep-copied, explicitly cleaned while reachable ===
    let key_drops: i32 = 0;
    let m3 = HashMap<SKey, i32>.with_capacity(4);
    m3.insert(SKey(tag=String.from(&"k1"), drops=&key_drops), 10);
    m3.insert(SKey(tag=String.from(&"k2"), drops=&key_drops), 20);
    assert key_drops == 0 && m3.len() == 2;

    let c3 = m3.clone();
    assert key_drops == 0: "cloning must not drop the original keys";
    assert c3.len() == 2;

    // 键的 String 缓冲区与原件共享: 两侧看到同一批键, 但不能再通过克隆改写键
    // (扩容会释放共享缓冲区, 让原件悬空)。
    let probe1 = SKey(tag=String.from(&"k1"), drops=&key_drops);
    let probe2 = SKey(tag=String.from(&"k2"), drops=&key_drops);
    assert m3.contains(&probe1) && c3.contains(&probe1): "clone shares key storage";

    assert m3.remove(&probe1);
    assert key_drops == 0: "remove must not clean the original's stored key";

    // Removed keys are no longer reachable through the map and are therefore not
    // cleaned by the container. Explicitly clean the remaining keys and lookup
    // values; c3 与 m3 的键共享缓冲区, 所以每个键只清一次。
    probe1.drop();
    probe2.drop();
    for key in c3 {
        key.drop();
    }
    assert key_drops == 4: "reachable keys are cleaned only by explicit drop";
    c3.drop();
    assert key_drops == 4: "clone drop releases storage without dropping keys";
    m3.drop();
    assert key_drops == 4: "map drop releases storage without dropping keys";
}
