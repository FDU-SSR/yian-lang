// Resource-bearing elements survive growth; container operations never drop
// elements, while callers can explicitly clean elements that remain reachable.
from std.core.drop import Drop;

struct Guard {
    value: i32,
    drops: i32*,
}

impl Drop for Guard {
    fn drop() { *self.drops += 1; }
}

fn main() {
    let drops: i32 = 0;
    let values = Vec<Guard>.new();
    for i in 0i32..10 {
        values.push(Guard(i, &drops));
    }
    assert values.len() == 10 && values[9].value == 9;
    assert drops == 0: "growth must not drop copied elements";

    let popped = *values.pop().unwrap();
    assert popped.value == 9 && drops == 0;
    popped.drop();
    assert drops == 1;

    let removed = values.remove(2);
    assert removed.value == 2 && drops == 1;
    removed.drop();
    assert drops == 2: "explicitly dropping a returned element takes effect";

    values.truncate(3);
    assert drops == 2: "truncate must not drop forgotten elements";
    for i in 0u64..3u64 {
        values[i].drop();
    }
    assert drops == 5: "callers can explicitly drop reachable elements";
    values.drop();
    assert drops == 5: "vec drop releases storage without dropping elements";

    let strings = Vec<String>.new();
    strings.push(String.from(&"one"));
    strings.push(String.from(&"two"));
    strings.push(String.from(&"three"));
    strings.push(String.from(&"four"));
    strings.push(String.from(&"five"));
    assert strings[0] == "one" && strings[4] == "five";

    let cloned = strings.clone();
    cloned[0].push('!');
    assert strings[0] == "one";
    assert cloned[0] == "one!";

    // Vec.drop() only releases its backing allocation.  Clean the reachable
    // String values explicitly before releasing each container's storage.
    for i in 0..strings.len() {
        strings[i].drop();
    }
    for i in 0..cloned.len() {
        cloned[i].drop();
    }
    strings.drop();
    cloned.drop();
}
