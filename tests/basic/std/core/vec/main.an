// Test Vec construction, capacity management, and basic queries
//
// Expected output: 0

fn case_vec_construction_and_capacity() {
    // ---- construction ----

    let v1: Vec<i32> = Vec<i32>.new();
    assert v1.len() == 0: "new() should create empty vector";
    assert v1.is_empty(): "new() should create empty vector";

    let v2: Vec<i32> = Vec<i32>.with_capacity(10);
    assert v2.capacity() == 10: "with_capacity should set capacity";
    assert v2.len() == 0: "with_capacity should not affect len";
    assert v2.is_empty(): "with_capacity should create empty vector";

    // ---- capacity management ----

    let v3: Vec<i32> = Vec<i32>.new();
    v3.reserve(100);
    assert v3.capacity() >= 100: "reserve should increase capacity";

    let v4: Vec<i32> = Vec<i32>.new();
    v4.reserve(50);
    v4.push(1);
    v4.push(2);
    v4.shrink_to_fit();
    assert v4.capacity() == 2: "shrink_to_fit should reduce capacity to len";

}

fn case_vec_element_mutations() {
    // ---- push / pop ----

    let v1: Vec<i32> = Vec<i32>.new();
    v1.push(1);
    v1.push(2);
    v1.push(3);
    assert v1.len() == 3: "push should increase size";
    assert !v1.is_empty(): "vector with elements should not be empty";

    let pop_opt: Option<i32> = v1.pop();
    assert *pop_opt.unwrap() == 3: "pop should return last element";
    assert v1.len() == 2: "pop should decrease size";

    // pop on empty
    let v_empty: Vec<i32> = Vec<i32>.new();
    assert v_empty.pop().is_none(): "pop on empty should return None";

    // ---- insert / remove ----

    let v2: Vec<i32> = Vec<i32>.new();
    v2.push(10);
    v2.push(30);
    v2.insert(1, 20);
    assert v2.len() == 3: "insert should increase size";
    assert v2[0] == 10: "insert should not affect earlier elements";
    assert v2[1] == 20: "insert should place element at index";
    assert v2[2] == 30: "insert should shift later elements";

    let removed: i32 = v2.remove(0);
    assert removed == 10: "remove should return removed element";
    assert v2.len() == 2: "remove should decrease size";
    assert v2[0] == 20: "remove should shift remaining elements left";

    // ---- swap_remove ----

    let v3: Vec<i32> = Vec<i32>.new();
    v3.push(100);
    v3.push(200);
    v3.push(300);
    let sw_removed: i32 = v3.swap_remove(0);
    assert sw_removed == 100: "swap_remove should return removed element";
    assert v3.len() == 2: "swap_remove should decrease size";
    assert v3[0] == 300: "swap_remove should move last element to removed spot";

    // ---- truncate / clear ----

    let v4: Vec<i32> = Vec<i32>.new();
    v4.push(1);
    v4.push(2);
    v4.push(3);
    v4.push(4);
    v4.truncate(2);
    assert v4.len() == 2: "truncate should reduce size";
    assert v4[0] == 1 && v4[1] == 2: "truncate should keep first N elements";

    v4.clear();
    assert v4.len() == 0: "clear should set size to 0";
    assert v4.is_empty(): "clear should make vector empty";

    // clear + reuse
    v4.push(42);
    assert v4.len() == 1: "should be reusable after clear";
    assert v4[0] == 42: "reused vec should hold new value";

}

fn case_vec_operators_and_traits() {
    // ---- extend (clone elements and preserve source) ----

    let v1: Vec<i32> = Vec<i32>.new();
    v1.push(10);
    v1.push(20);

    let v2: Vec<i32> = Vec<i32>.new();
    v2.push(30);
    v2.push(40);

    v1.extend(&v2);
    assert v1.len() == 4: "extend should append all elements";
    assert v1[2] == 30: "extend should append correctly";
    assert v2.len() == 2 && v2[0] == 30: "extend should preserve source";

    v1.extend(&v1);
    assert v1.len() == 8: "self-extension should be safe";
    assert v1[4] == 10 && v1[7] == 40;

    // ---- Add trait ----

    let v3: Vec<i32> = Vec<i32>.new();
    v3.push(1);
    v3.push(2);

    let v4: Vec<i32> = Vec<i32>.new();
    v4.push(3);
    v4.push(4);

    let v5: Vec<i32> = v3 + v4;
    assert v5.len() == 4: "add should concatenate vectors";
    assert v5[0] == 1 && v5[3] == 4: "add should preserve element order";

    // ---- Clone ----

    let v6: Vec<i32> = Vec<i32>.new();
    v6.push(100);
    v6.push(200);

    let v7: Vec<i32> = v6.clone();
    assert v7.len() == 2: "clone should copy size";
    assert v7 == v6: "clone should create equal vector";

    // modify original — clone should be independent
    v6.push(300);
    assert v7.len() == 2: "clone should be independent of original";

    // ---- PartialEq ----

    let v8: Vec<i32> = Vec<i32>.new();
    v8.push(1);
    v8.push(2);

    let v9: Vec<i32> = Vec<i32>.new();
    v9.push(1);
    v9.push(2);

    assert v8 == v9: "equal vectors should be equal";
    assert !(v8 != v9): "equal vectors should not be unequal";

    let v10: Vec<i32> = Vec<i32>.new();
    v10.push(1);
    v10.push(3);

    assert v8 != v10: "different vectors should not be equal";
    assert !(v8 == v10): "different vectors should not compare equal";

    // ---- From<T[]> for Vec<T> ----

    let arr: i32[3] = [40, 50, 60];
    let v11: Vec<i32> = Vec<i32>.from(&arr[0u64..3]);
    assert v11.len() == 3: "Vec.from(slice) should create Vec";
    assert v11[0] == 40 && v11[1] == 50 && v11[2] == 60: "Vec.from should copy elements";

}

fn main() {
    case_vec_construction_and_capacity();
    case_vec_element_mutations();
    case_vec_operators_and_traits();
}
