// Plain assignment shallow-copies a Vec descriptor, so both copies initially
// share one buffer. Growing either copy may resize that allocation in place or
// move it; the other descriptor is not used to access or release the buffer.
// Only the descriptor still in use is dropped, exactly once.
from std.core.vec import Vec;
from std.core.drop import Drop;

fn main() {
    let v1 = Vec<i32>.new();
    v1.push(10);
    v1.push(20);
    v1.push(30);
    v1.push(40);

    let v2 = v1;
    assert v1.len() == 4 && v2.len() == 4;
    assert &v1.as_slice()[0] == &v2.as_slice()[0]: "copies share the element buffer";
    assert v1[0] == 10 && v2[3] == 40;

    // Growth preserves v2's elements. The allocator may resize the buffer in
    // place, so the other descriptor's pointer value is not inspected.
    v2.push(50);
    assert v1.len() == 4 && v2.len() == 5: "descriptor fields are independent";
    assert v2[4] == 50;

    v2.drop();
}
