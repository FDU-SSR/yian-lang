// Test low-level open/close/sys_write/sys_read builtins
//
// Expected output: 0

fn main() {
    // O_WRONLY | O_CREAT | O_TRUNC = 577
    let wfd: i32 = @open("/tmp/yian_test_low.txt", 577);
    // sys_write returns void; a successful write means the builtins are wired correctly
    @sys_write(wfd, "low-level builtin test");
    // Empty views remain valid external-operation arguments.
    @sys_write(wfd, "");
    let c: i32 = @close(wfd);
    // close should return 0 on success
    assert c == 0: "close failed";

    // Read back (O_RDONLY = 0) using heap buffer
    let rfd: i32 = @open("/tmp/yian_test_low.txt", 0);
    assert rfd >= 0: "open for read failed";
    let buf = dyn[64] 0u8;
    // @sys_read returns a str whose length is the number of bytes actually read;
    // do not validate the whole uninitialized capacity as UTF-8.
    let view: u8[] = @slice_from_parts(buf, 64u64);
    let result: str = @sys_read(rfd, view);
    @close(rfd);
    let n = result.as_slice().len();
    del buf;

    // "low-level builtin test" is 22 bytes
    assert n == 22u64: "read length mismatch";
}
