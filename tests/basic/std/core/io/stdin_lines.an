// BufReader handles UTF-8, CRLF, empty lines, and an unterminated final line.
from std.core.io import Stdin, BufReader;

fn main() {
    let input = Stdin.new();
    input.drop();
    let reader = BufReader<Stdin>.with_capacity(2u64, &input); defer reader.drop();
    let first = *reader.read_line().unwrap().unwrap(); defer first.drop();
    let second = *reader.read_line().unwrap().unwrap(); defer second.drop();
    let last = *reader.read_line().unwrap().unwrap(); defer last.drop();
    assert first.as_str() == "中😀\r\n": "stdin UTF-8 and CRLF";
    assert second.as_str() == "\n": "stdin empty line";
    assert last.as_str() == "last": "stdin final unterminated line";
    assert reader.read_line().unwrap().is_none(): "stdin EOF";
}
