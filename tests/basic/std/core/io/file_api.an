// Test File API: open, read/write, read_to_string, drop
//
// Expected output: 0

from std.core.io import File, OpenMode;

fn main() {
    let path = "/tmp/yian_test_file_api.txt";

    // Write with File API
    let f = File.open(path, OpenMode.Write).unwrap();
    f.write("Hello, File API!\n").unwrap();
    f.drop();

    // Read back
    let f2 = File.open(path, OpenMode.Read).unwrap();
    let content = f2.read_to_string().unwrap();
    f2.drop();

    assert content.as_str() == "Hello, File API!\n": "read_to_string should match";

    // Append mode
    let f3 = File.open(path, OpenMode.Append).unwrap();
    f3.write("second line\n").unwrap();
    f3.write_all("third line\n").unwrap();
    f3.drop();

    let f4 = File.open(path, OpenMode.Read).unwrap();
    let content2 = f4.read_to_string().unwrap();
    f4.drop();

    assert content2.as_str() == "Hello, File API!\nsecond line\nthird line\n": "append should add";

    // Bounded read API
    let f5 = File.open(path, OpenMode.Read).unwrap();
    let read_buf: u8* = dyn[128] 0u8;
    let read_count: u64 = *f5.read(read_buf[0u64..128]).unwrap();
    assert read_count == content2.as_slice().len(): "read should report bytes read";
    f5.drop();
    del read_buf;

    // fd() accessor
    let f6 = File.open(path, OpenMode.Read).unwrap();
    let raw_fd: i32 = f6.fd();
    assert raw_fd >= 0: "fd should be valid";
    f6.drop();

}
