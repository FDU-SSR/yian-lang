// Test file read/write interfaces, convenience helpers, and File errors.
//
// Expected output: 0

from std.core.io import File, OpenMode;
from std.core.fs import read_to_string, write_string, append;

fn case_file_read_write_api() {
    let path = "/tmp/yian_test_file_api.txt";

    // Write with File API
    let f = File.open(path, OpenMode.Write).unwrap();
    f.write_str("Hello, File API!\n").unwrap();
    f.drop();

    // Read back
    let f2 = File.open(path, OpenMode.Read).unwrap();
    let content = f2.read_to_string().unwrap();
    f2.drop();

    assert content.as_str() == "Hello, File API!\n": "read_to_string should match";

    // Append mode
    let f3 = File.open(path, OpenMode.Append).unwrap();
    f3.write_str("second line\n").unwrap();
    f3.write_str("third line\n").unwrap();
    f3.drop();

    let f4 = File.open(path, OpenMode.Read).unwrap();
    let content2 = f4.read_to_string().unwrap();
    f4.drop();

    assert content2.as_str() == "Hello, File API!\nsecond line\nthird line\n": "append should add";

    // Bounded read API
    let f5 = File.open(path, OpenMode.Read).unwrap();
    let read_buf: u8* = dyn[128] 0u8;
    let read_count: u64 = *f5.read(read_buf[0u64..128]).unwrap();
    assert read_count == content2.as_slice().len(): "read should report bytes read";
    f5.drop();
    del read_buf;

    // fd() accessor
    let f6 = File.open(path, OpenMode.Read).unwrap();
    let raw_fd: i32 = f6.fd();
    assert raw_fd >= 0: "fd should be valid";
    f6.drop();

}

fn case_filesystem_convenience() {
    let path = "/tmp/yian_test_conv.txt";

    // write_string + read_to_string
    write_string(path, "convenience test\n").unwrap();
    let s = *read_to_string(path).unwrap();
    assert s.as_str() == "convenience test\n": "write_string then read_to_string";

    // write_string overwrites
    write_string(path, "overwritten\n").unwrap();
    let s2 = *read_to_string(path).unwrap();
    assert s2.as_str() == "overwritten\n": "write_string should overwrite";

    // append
    write_string(path, "first\n").unwrap();
    append(path, "second\n".as_slice()).unwrap();
    let s3 = *read_to_string(path).unwrap();
    assert s3.as_str() == "first\nsecond\n": "append should append";
}

fn case_file_open_errors() {
    // Open a non-existent file — should return Err
    let r = File.open("/tmp/_nonexistent_yian_test_file_.txt", OpenMode.Read);
    assert r.is_err(): "opening missing file should be Err";

    // Open should succeed for a valid write
    let r2 = File.open("/tmp/yian_test_err_handling.txt", OpenMode.Write);
    assert r2.is_ok(): "opening for write should be Ok";
    r2.unwrap().drop();

    // Re-open for reading should work
    let r3 = File.open("/tmp/yian_test_err_handling.txt", OpenMode.Read);
    assert r3.is_ok(): "re-opening should be Ok";
    r3.unwrap().drop();
}

fn main() {
    case_filesystem_convenience();
    case_file_read_write_api();
    case_file_open_errors();
}
