// Test Stdout / Stderr static methods
//
// Expected output:
// stdout write
// stdout write_all
// stderr line 1
// stderr line 2

from std.core.io import Stdout, Stderr;

fn main() {
    Stdout.write("stdout write\n").unwrap();
    Stdout.write_all("stdout write_all\n").unwrap();

    Stderr.write("stderr line 1\n").unwrap();
    Stderr.write_all("stderr line 2\n").unwrap();

}
