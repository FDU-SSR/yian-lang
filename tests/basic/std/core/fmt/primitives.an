// Test ToString on primitive, integer, and floating-point types.
//
// Expected output: 0

from std.core.fmt import ToString;

fn case_primitive_formatting() {
    // bool
    let b1: bool = true;
    assert b1.to_string() == "true": "true";

    let b2: bool = false;
    assert b2.to_string() == "false": "false";

    // char
    let ch: char = 'A';
    assert ch.to_string() == "A": "char";

}

fn case_integer_formatting() {
    // -- unsigned -------------------------------------------------------
    let u8v: u8 = 255u8;
    assert u8v.to_string() == "255": "u8";

    let u16v: u16 = 65535u16;
    assert u16v.to_string() == "65535": "u16";

    let u32v: u32 = 4294967295u32;
    assert u32v.to_string() == "4294967295": "u32";

    let u64v: u64 = 18446744073709551615u64;
    assert u64v.to_string() == "18446744073709551615": "u64";

    let u8z: u8 = 0u8;
    assert u8z.to_string() == "0": "u8 zero";

    // -- signed ---------------------------------------------------------
    let i8v: i8 = i8(-42);
    assert i8v.to_string() == "-42": "i8";

    let i16v: i16 = i16(-1234);
    assert i16v.to_string() == "-1234": "i16";

    let i32v: i32 = -123456;
    assert i32v.to_string() == "-123456": "i32";

    let i64v: i64 = -1234567890123i64;
    assert i64v.to_string() == "-1234567890123": "i64";

    let i8z: i8 = i8(0);
    assert i8z.to_string() == "0": "i8 zero";

    let i8p: i8 = i8(100);
    assert i8p.to_string() == "100": "i8 positive";
}

fn case_float_formatting() {
    // f32
    let f32v: f32 = 1.25_f32;
    assert f32v.to_string() == "1.25": "f32";

    // f64 — fractional
    let f64v: f64 = -3.5;
    assert f64v.to_string() == "-3.5": "f64 negative";

    // f64 — integer-like
    let f64_int: f64 = 10.0;
    assert f64_int.to_string() == "10": "f64 integer-like";

    // f64 — zero
    let f64z: f64 = 0.0;
    assert f64z.to_string() == "0": "f64 zero";
}

// Template formatting shares the direct-write float layer with the owning conversion.
fn case_float_templates() {
    let tenth: f16 = 0.1;
    assert f"{tenth}" == "0.1": "f16 0.1";
    assert tenth.to_string() == "0.1": "f16 0.1 conversion";

    // Re-reading the printed decimal as a half literal recovers the same bit pattern.
    let small: f16 = 5.960464477539063e-8;
    assert f"{small}" == "6e-8": "f16 minimum subnormal";
    let small_roundtrip: f16 = 6e-8;
    assert small_roundtrip == small: "f16 subnormal roundtrip";

    let normal: f16 = 6.103515625e-5;
    assert f"{normal}" == "0.00006104": "f16 minimum normal";
    let normal_roundtrip: f16 = 0.00006104;
    assert normal_roundtrip == normal: "f16 normal roundtrip";

    let maximum: f16 = 65504.0;
    assert f"{maximum}" == "65500": "f16 maximum finite";
    let maximum_roundtrip: f16 = 65500.0;
    assert maximum_roundtrip == maximum: "f16 maximum roundtrip";
    assert f"{maximum}" == maximum.to_string(): "f16 conversion agrees";

    assert f"{-0.0_f16}" == "-0": "f16 negative zero";
    assert f"{1.0_f16 / 0.0_f16}" == "inf": "f16 infinity";
    assert f"{-1.0_f16 / 0.0_f16}" == "-inf": "f16 negative infinity";
    assert f"{0.0_f16 / 0.0_f16}" == "NaN": "f16 NaN";

    assert f"{0.3_f32}" == "0.3": "f32 default spelling";
    assert f"{0.3_f32}" == 0.3_f32.to_string(): "f32 conversion agrees";
    assert f"{1.2345678901234567}" == "1.2345678901234567": "f64 high precision";
    assert f"{0.000001}" == "0.000001": "f64 lower scientific threshold";
    assert f"{0.0000001}" == "1e-7": "f64 scientific threshold";
}

fn main() {
    case_primitive_formatting();
    case_integer_formatting();
    case_float_formatting();
    case_float_templates();
}
