// Test ToString on primitive, integer, and floating-point types, and the shared
// value/specification protocol through a forwarding wrapper.
//
// Expected output: none.

from std.core.fmt import Alignment, Format, FormatSpec, Formatter, ToString;
from std.core.string import String;
from std.core.io import IoError;
from std.core.option import Option;
from std.core.result import Result;
from std.num.f64 import from_bits;

// The wrapper receives the formatter and forwards its own specification, so the protocol is exercised
// without relying on template specification syntax.
struct Spec<T> { value: T, shape: FormatSpec }

impl<T> Format for Spec<T> if T: Format {
    fn fmt(out: Formatter&, spec: FormatSpec&) -> Result<(), IoError> {
        spec.require_default()?;
        out.write_value(&self.value, &self.shape)
    }
}

fn fixed_spec(width: u64, precision: u64, zero_pad: bool) -> FormatSpec {
    let spec = FormatSpec.new();
    spec.width = width;
    spec.zero_pad = zero_pad;
    spec.precision = Option<u64>.Some(val=precision);
    return spec;
}

fn check_fixed(name: str, value: f64, precision: u64, expected: str) {
    let wrapped = Spec(value=value, shape=fixed_spec(0u64, precision, false));
    assert f"{wrapped}" == expected: name;
}

fn case_primitive_formatting() {
    // bool
    let b1: bool = true;
    assert b1.to_string() == "true": "true";

    let b2: bool = false;
    assert b2.to_string() == "false": "false";

    // char
    let ch: char = 'A';
    assert ch.to_string() == "A": "char";

}

fn case_integer_formatting() {
    // -- unsigned -------------------------------------------------------
    let u8v: u8 = 255u8;
    assert u8v.to_string() == "255": "u8";

    let u16v: u16 = 65535u16;
    assert u16v.to_string() == "65535": "u16";

    let u32v: u32 = 4294967295u32;
    assert u32v.to_string() == "4294967295": "u32";

    let u64v: u64 = 18446744073709551615u64;
    assert u64v.to_string() == "18446744073709551615": "u64";

    let u8z: u8 = 0u8;
    assert u8z.to_string() == "0": "u8 zero";

    // -- signed ---------------------------------------------------------
    let i8v: i8 = i8(-42);
    assert i8v.to_string() == "-42": "i8";

    let i16v: i16 = i16(-1234);
    assert i16v.to_string() == "-1234": "i16";

    let i32v: i32 = -123456;
    assert i32v.to_string() == "-123456": "i32";

    let i64v: i64 = -1234567890123i64;
    assert i64v.to_string() == "-1234567890123": "i64";

    let i8z: i8 = i8(0);
    assert i8z.to_string() == "0": "i8 zero";

    let i8p: i8 = i8(100);
    assert i8p.to_string() == "100": "i8 positive";
}

fn case_float_formatting() {
    // f32
    let f32v: f32 = 1.25_f32;
    assert f32v.to_string() == "1.25": "f32";

    // f64 — fractional
    let f64v: f64 = -3.5;
    assert f64v.to_string() == "-3.5": "f64 negative";

    // f64 — integer-like
    let f64_int: f64 = 10.0;
    assert f64_int.to_string() == "10": "f64 integer-like";

    // f64 — zero
    let f64z: f64 = 0.0;
    assert f64z.to_string() == "0": "f64 zero";
}

// Template formatting shares the direct-write float layer with the owning conversion.
fn case_float_templates() {
    let tenth: f16 = 0.1;
    assert f"{tenth}" == "0.1": "f16 0.1";
    assert tenth.to_string() == "0.1": "f16 0.1 conversion";

    // Re-reading the printed decimal as a half literal recovers the same bit pattern.
    let small: f16 = 5.960464477539063e-8;
    assert f"{small}" == "6e-8": "f16 minimum subnormal";
    let small_roundtrip: f16 = 6e-8;
    assert small_roundtrip == small: "f16 subnormal roundtrip";

    let normal: f16 = 6.103515625e-5;
    assert f"{normal}" == "0.00006104": "f16 minimum normal";
    let normal_roundtrip: f16 = 0.00006104;
    assert normal_roundtrip == normal: "f16 normal roundtrip";

    let maximum: f16 = 65504.0;
    assert f"{maximum}" == "65500": "f16 maximum finite";
    let maximum_roundtrip: f16 = 65500.0;
    assert maximum_roundtrip == maximum: "f16 maximum roundtrip";
    assert f"{maximum}" == maximum.to_string(): "f16 conversion agrees";

    assert f"{-0.0_f16}" == "-0": "f16 negative zero";
    assert f"{1.0_f16 / 0.0_f16}" == "inf": "f16 infinity";
    assert f"{-1.0_f16 / 0.0_f16}" == "-inf": "f16 negative infinity";
    assert f"{0.0_f16 / 0.0_f16}" == "NaN": "f16 NaN";

    assert f"{0.3_f32}" == "0.3": "f32 default spelling";
    assert f"{0.3_f32}" == 0.3_f32.to_string(): "f32 conversion agrees";
    assert f"{1.2345678901234567}" == "1.2345678901234567": "f64 high precision";
    assert f"{0.000001}" == "0.000001": "f64 lower scientific threshold";
    assert f"{0.0000001}" == "1e-7": "f64 scientific threshold";
}

// Fixed-point output follows the exact binary value with ties to even.
fn case_fixed_formatting() {
    check_fixed("fixed 2.5 ties even", 2.5, 0u64, "2");
    check_fixed("fixed 3.5 ties even", 3.5, 0u64, "4");
    check_fixed("fixed -2.5 ties even", -2.5, 0u64, "-2");
    check_fixed("fixed carry", 9.99609375, 2u64, "10.00");
    check_fixed("fixed negative zero", -0.0, 2u64, "-0.00");
    check_fixed("fixed default digits", 2.0, 6u64, "2.000000");
    check_fixed("fixed f32 widening", f64(0.3_f32), 9u64, "0.300000012");
    check_fixed("fixed f16 widening", f64(0.1_f16), 4u64, "0.1000");

    // The minimum subnormal expands to 5^1074 / 10^1074; the equally distant neighbours select the
    // even retained digit. The complete expectation comes from that integer identity, not from a printf.
    check_fixed("fixed minimum subnormal", from_bits(1u64), 1024u64,
        "0.");

    let maximum = from_bits(0x7FEFFFFFFFFFFFFFu64);
    check_fixed("fixed maximum integer", maximum, 0u64,
        "");

    // The same integer with 1024 fractional digits: the exact value is an integer, so every digit is zero.
    let zeros = String.with_capacity(1024u64);
    let index: u64 = 0u64;
    while index < 1024u64 {
        zeros.push('0');
        index += 1u64;
    }
    let expected = String.with_capacity(1334u64);
    expected.push_str("");
    expected.push('.');
    expected.push_str(zeros.as_str());
    check_fixed("fixed maximum precision", maximum, 1024u64, expected.as_str());
    expected.drop();
    zeros.drop();
}

fn case_special_values() {
    let nan = from_bits(0x7FF8000000000000u64);
    let infinity = from_bits(0x7FF0000000000000u64);
    let negative_infinity = from_bits(0xFFF0000000000000u64);
    let nan_spec = fixed_spec(8u64, 2u64, true);
    let wrapped_nan = Spec(value=nan, shape=nan_spec);
    assert f"{wrapped_nan}" == "     NaN": "NaN keeps space padding";
    let wrapped_infinity = Spec(value=infinity, shape=nan_spec);
    assert f"{wrapped_infinity}" == "     inf": "infinity keeps space padding";
    let wrapped_negative = Spec(value=negative_infinity, shape=nan_spec);
    assert f"{wrapped_negative}" == "    -inf": "negative infinity spelling";
}

fn main() {
    case_primitive_formatting();
    case_integer_formatting();
    case_float_formatting();
    case_float_templates();
    case_fixed_formatting();
    case_special_values();
}
