// Test f64 From<str> and libm-backed math wrappers.
from std.num.f64 import sqrt, sin, cos;

fn main() {
    let p1: f64 = f64.from(&"1.5");
    assert p1 == 1.5: "parse '1.5'";

    let p2: f64 = f64.from(&"0.0");
    assert p2 == 0.0: "parse '0.0'";

    let p3: f64 = f64.from(&"3.14");
    assert p3 == 3.14: "parse '3.14'";

    let p4: f64 = f64.from(&"123.456");
    assert p4 == 123.456: "parse '123.456'";

    assert sqrt(9.0) == 3.0: "sqrt";
    assert sin(0.0) == 0.0: "sin";
    assert cos(0.0) == 1.0: "cos";
}
