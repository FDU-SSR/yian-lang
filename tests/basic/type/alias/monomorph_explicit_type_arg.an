// Consolidated basic type and diagnostics scenarios.



// Named scenario: case_explicit_alias_type_argument
// typedef: explicit type arguments spelled with an alias share one instance.
// Equivalent type aliases and their target share a canonical function instance.

typedef Code = u64;

fn ident<T>(v: T) -> T { return v; }

fn case_explicit_alias_type_argument() {
    let a: Code = ident<Code>(1u64);
    let b: u64 = ident<u64>(2u64);
    assert a + b == 3u64;
}

// Named scenario: case_inferred_alias_type_argument
// typedef: inferred type arguments spelled with an alias share one instance.

typedef InferredCode = u64;

struct Box<T> { pub v: T }

impl<T> Box<T> {
    pub fn get() -> T { return self.v; }
}

fn unwrap<T>(b: Box<T>) -> T { return b.v; }

fn case_inferred_alias_type_argument() {
    let a: Box<InferredCode> = Box<InferredCode>(v=1u64);
    let b: Box<u64> = Box<u64>(v=2u64);
    assert a.get() == 1u64;
    assert b.get() == 2u64;
    assert unwrap(a) == 1u64;
    assert unwrap(b) == 2u64;
}



fn main() {

    case_explicit_alias_type_argument();
    case_inferred_alias_type_argument();

}
