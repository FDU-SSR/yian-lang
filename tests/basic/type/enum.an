// Test enum type with associated data && match statement
//
// Expected output: 0

enum DivResult<T> {
    Ok { value: T, },
    DivByZero,
}

fn safe_div(a: i32, b: i32) -> DivResult<i32> {
    if b == 0 {
        return DivResult<i32>.DivByZero;
    } else {
        return DivResult<i32>.Ok(a / b);
    }
}

fn main() {
    let res1: DivResult<i32> = safe_div(10, 2);
    let res2: DivResult<i32> = safe_div(10, 0);

    let val1: i32;
    match res1 {
        Ok(data) => {
            val1 = data;
        }
        DivByZero => {
            panic("Division by zero in res1")
        }
    }

    match res2 {
        Ok => {
            panic("Expected division by zero in res2")
        }
        _ => {}
    }

    assert val1 == 5: "safe_div(10, 2) should be 5";
}