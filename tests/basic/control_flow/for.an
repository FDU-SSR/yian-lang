// Test classic for loop control flow.
//
// Expected output: 0

fn case_indexed_range_loop() {
    let arr: i32[1024] = [0;
        1024];
    for i in 0u64..1024 {
        arr[i] = i32(i);
    }

    let sum: i32 = 0;
    for i in 0u64..1024 {
        sum += arr[i];
    }

    assert sum == 1023 * 1024 / 2: "Expected sum to be 1023 * 1024 / 2";

}

fn case_range_loop() {
    let arr: i32[1024] = [0;
        1024];
    for i in 0u64..1024 {
        arr[i] = i32(i);
    }

    let sum: i32 = 0;
    for i in 0u64..1024 {
        sum += arr[i];
    }

    assert sum == 1023 * 1024 / 2: "Expected sum to be 1023 * 1024 / 2";
}

fn case_for_in_iteration() {
    let arr: i32[1024] = [0;
        1024];
    for i in 0u64..1024 {
        arr[i] = i32(i);
    }

    let sum: i32 = 0;
    for elem in arr {
        sum += *elem;
    }

    assert sum == 1023 * 1024 / 2: "Expected sum to be 1023 * 1024 / 2";
}

fn main() {
    case_range_loop();
    case_indexed_range_loop();
    case_for_in_iteration();
}
