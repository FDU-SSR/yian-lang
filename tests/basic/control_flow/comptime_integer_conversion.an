// Implicit literal typing and explicit casts have different evaluation boundaries.
fn main() {
    let narrowed: u8 = 256;
    assert narrowed == 0u8;

    let fixed = comptime if ((1 << 64) >> 64) == 0u64 { 1 } else { 0 };
    assert fixed == 1;
    let explicit = comptime if u64((1 << 64) >> 64) == 1u64 { 1 } else { 0 };
    assert explicit == 1;

    let huge_shift = comptime if (1 << 4294967296) == 0u64 { 1 } else { 0 };
    assert huge_shift == 1;
}
