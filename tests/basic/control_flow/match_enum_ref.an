// Matching an enum reference binds references to its payload fields.
//
// Payload field bindings refer to the original fields, not copies.

enum E {
    A { n: i32 },
    B { n: i64 },
}

fn main() {
    let e: E = E.A(42);

    match &e {
        A(n) => {
            let field: i32& = n;
            assert *field == 42;
        },
        B(n) => {
            assert false;
        },
    }

}
