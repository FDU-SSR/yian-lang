// Test match statement with enum type, including multi-variant patterns
//
// Expected output:
// BLUE
// GREEN
// GREEN
// payload

from std.core.io import print;

enum Color {
    BLUE, RED, YELLOW, GREEN, BLACK,
    LOOK {
        who: i32,
        direction: i32,
    },
    MOVE {
        who: i32,
        direction: i32,
    },
}

fn match_enum(c: Color) -> i32 {
    match c {
        YELLOW => { return 3; },
        GREEN => { return 4; },
        BLACK => { return 5; },
        LOOK(who, direction) => { return who + direction; },
        MOVE(who, direction) => { return who + direction; },
        _ => { return 0; },
    }
}

fn match_multi(c: Color) -> str {
    match c {
        BLUE | RED => { return "BLUE\n"; },
        GREEN | BLACK => { return "GREEN\n"; },
        _ => { return "OTHER\n"; },
    }
}

fn main() {
    let c3: Color = Color.LOOK(who = 1, direction = 2);
    let c4: Color = Color.MOVE(who = 1, direction = 2);

    // Test multi-variant patterns
    assert match_multi(Color.BLUE) == "BLUE\n": "multi-variant BLUE failed";
    assert match_multi(Color.RED) == "BLUE\n": "multi-variant RED failed";
    assert match_multi(Color.GREEN) == "GREEN\n": "multi-variant GREEN failed";
    assert match_multi(Color.BLACK) == "GREEN\n": "multi-variant BLACK failed";
    assert match_multi(Color.YELLOW) == "OTHER\n": "multi-variant fallback failed";

    // Test single-variant and payload patterns
    assert match_enum(Color.BLUE) == 0: "Match enum failed on BLUE";
    assert match_enum(c3) == 3: "Match enum failed on LOOK";
    assert match_enum(c4) == 3: "Match enum failed on MOVE";

    print(match_multi(Color.BLUE));
    print(match_multi(Color.GREEN));
    print(match_multi(Color.BLACK));
    print("payload\n");
}
