// Array indexing, mutation, multidimensional access, and inline GEP cases.

from std.core.io import print;

fn case_array_access() {
    let arr: i32[4] = [0, 0, 0, 0];
    arr[0] = 3;
    arr[1] = 4;
    arr[2] = arr[0] + arr[1]; // arr[2] = 3 + 4 = 7
    arr[3] = arr[2] + arr[0]; // arr[3] = 7 + 3 = 10

    assert arr[0] == 3: "arr[0] should be 3";
    assert arr[1] == 4: "arr[1] should be 4";
    assert arr[2] == 7: "arr[2] should be 7";
    assert arr[3] == 10: "arr[3] should be 10";

}

fn case_multidimensional_access() {
    let arr: i32[2][2][2] = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
    assert arr[0][1][1] == 4: "arr[0][1][1] should be 4";

    arr[0][0][0] = 4
    arr[1][1][1] = 5
    assert arr[0][0][0] == 4: "arr[0][0][0] should be 4";
    assert arr[1][1][1] == 5: "arr[1][1][1] should be 5";

    let a: i32 = arr[0][0][0];
    let b: i32 = arr[1][1][1];
    assert a + b == 9: "a + b should be 9";
}

fn case_inline_index() {
    let a: i32[4] = [10, 20, 30, 40];
    let i: u64 = 1;
    assert a[i] == 20: "read a[i] failed";
    assert a[3] == 40: "read a[3] failed";

    a[i] = 99;
    assert a[1] == 99: "write a[i] failed";
    a[0] = 7;
    assert a[0] == 7: "write a[0] failed";

    let p: i32* = &a[2];
    assert *p == 30: "address a[i] failed";
    *p = 55;
    assert a[2] == 55: "write through address failed";

    let sum: i64 = 0;
    let k: u64 = 0;
    while k < 4 {
        sum += i64(a[k]);
        k += 1
    }
    assert sum == 7 + 99 + 55 + 40: "loop indexing failed";

    let m: i32[2][2] = [[1, 2], [3, 4]];
    assert m[1][0] == 3: "nested read failed";
    m[1][1] = 42;
    assert m[1][1] == 42: "nested write failed";
    let q: i32* = &m[0][1];
    assert *q == 2: "nested address failed";

    let range = 1u64..3;
    let sub: i32[] = a[range];
    assert sub.len() == 2: "range slice length failed";
    assert sub[0] == 99: "range slice first element failed";
    assert sub[1] == 55: "range slice second element failed";

    print("inline-index pass\n");
}

fn main() {
    case_array_access();
    case_multidimensional_access();
    case_inline_index();
}
