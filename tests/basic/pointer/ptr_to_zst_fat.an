// A pointer to a zero-sized type is itself a ZST; its operations are erased
// during code generation.
//
// Expected output: 0

struct Empty {}

fn main() {
    // @sizeof<ptr-to-ZST> == 0  (pointer itself is ZST)
    assert @sizeof<void*> == 0: "@sizeof<*void> == 0";
    assert @sizeof<Empty*> == 0: "@sizeof<*Empty> == 0";

    // ZST pointers created by dyn; equality always true (indistinguishable)
    let p: void* = dyn[1] void;
    let q: void* = dyn[1] void;
    assert p == q: "ZST ptr equality always true";

}
