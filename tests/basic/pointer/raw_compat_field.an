// raw_compat_field.an: raw-pointer struct fields and reads/writes through field pointers.
//
// Read/write a heap struct and access its fields indirectly through an outer struct's pointer field.
// This valid program must exit zero in both fat and raw modes.
//
// Expected output: 0

struct Point {
    x: i32,
    y: i32,
}

struct Wrap {
    p: Point*,
}

fn main() {
    let pt: Point* = dyn Point(1, 2);
    assert pt.x == 1: "pt.x == 1";
    assert pt.y == 2: "pt.y == 2";

    // Write fields.
    pt.x = 10;
    pt.y = 20;
    assert pt.x == 10: "pt.x == 10 after write";
    assert pt.y == 20: "pt.y == 20 after write";

    // Dereference Wrap.p to read/write the pointed-to struct.
    let w: Wrap* = dyn Wrap(pt);
    assert w.p.x == 10: "w.p.x == 10 via field pointer";
    w.p.y = 21;
    assert pt.y == 21: "write via w.p.y visible at pt.y";

    // Extract the pointer field for independent use.
    let inner: Point* = w.p;
    assert inner.x + inner.y == 31: "inner.x + inner.y == 31";
    inner.x = 100;
    assert pt.x == 100: "write via inner visible at pt.x";

    del w;
    del pt;
}
