// Match results can be assigned to Option<T&> fields.
// Match patterns use bare variant names; constructors use qualified enum names.
struct Node { val: i32, next: Option<Node&> }
fn main() {
    let n0: Node& = dyn Node(0, Option<Node&>.None);
    let n1: Node& = dyn Node(1, Option<Node&>.Some(n0)); // Seed for the Some path.
    let n2: Node& = dyn Node(-1, Option<Node&>.None); // Smaller than d.val: execute Some, mirroring push_disk placing a small disk on a large one.
    // Mirror push_disk: match reads a slot, then assigns the field in raw mode.
    n2.next = match n1.next {
        Some(d) => { if n2.val >= d.val { Option<Node&>.None } else { Option<Node&>.Some(d) } },
        None => Option<Node&>.None,
    }
    // Exercise the Some branch and verify that its payload reaches the field.
    assert n2.next.is_some(): "match assign some flows through";
    assert n2.next.unwrap().val == 0: "some payload preserved";
    del n0;
    del n1;
    del n2;
}
