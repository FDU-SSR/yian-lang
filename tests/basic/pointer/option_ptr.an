// Consolidated basic pointer and allocation scenarios.

// Pointer array: its element width follows the active pointer representation.
//

fn case_pointer_array() {
    let expected_ptr_size: u64 = comptime if IS_RAW_MODE {
        8u64
    } else {
        24u64
    };
    assert @sizeof<i32*> == expected_ptr_size: "pointer ABI size"
    assert @sizeof<i32*[3]> == @sizeof<i32*> * 3: "ptr-array size"

    // Stack array of Option pointers; each element points to a heap-allocated
    // scalar, and None represents an empty slot.
    let arr: Option<i32*>[4] = [
        Option<i32*>.None, Option<i32*>.None, Option<i32*>.None, Option<i32*>.None]
    arr[0] = Option<i32*>.Some(dyn i32(1))
    arr[1] = Option<i32*>.Some(dyn i32(2))
    arr[2] = Option<i32*>.Some(dyn i32(3))
    arr[3] = Option<i32*>.Some(dyn i32(4))

    let e0: i32* = *arr[0].unwrap()
    assert e0[0] == 1: "arr[0][0] == 1"
    let e3: i32* = *arr[3].unwrap()
    assert e3[0] == 4: "arr[3][0] == 4"

    // Write through an element pointer, visible via the array.
    let e1: i32* = *arr[1].unwrap()
    e1[0] = 22
    assert (*arr[1].unwrap())[0] == 22: "arr[1][0] == 22 after write"

    // Heap array of pointers (i32**).
    let h: i32** = dyn[2] e0
    h[0] = dyn i32(7)
    h[1] = dyn i32(8)
    assert h[0][0] == 7: "h[0][0] == 7"
    assert h[1][0] == 8: "h[1][0] == 8"
}

// Match results can be assigned to Option<T&> fields.
// Match patterns use bare variant names; constructors use qualified enum names.
struct MatchAssignOptionNode { val: i32, next: Option<MatchAssignOptionNode&> }
fn case_match_assign_option_reference() {
    let n0: MatchAssignOptionNode& = dyn MatchAssignOptionNode(0, Option<MatchAssignOptionNode&>.None);
    let n1: MatchAssignOptionNode& = dyn MatchAssignOptionNode(1, Option<MatchAssignOptionNode&>.Some(n0)); // Seed for the Some path.
    let n2: MatchAssignOptionNode& = dyn MatchAssignOptionNode(-1, Option<MatchAssignOptionNode&>.None); // Smaller than d.val: execute Some, mirroring push_disk placing a small disk on a large one.
    // Mirror push_disk: match reads a slot, then assigns the field in raw mode.
    n2.next = match n1.next {
        Some(d) => { if n2.val >= d.val { Option<MatchAssignOptionNode&>.None } else { Option<MatchAssignOptionNode&>.Some(d) } },
        None => Option<MatchAssignOptionNode&>.None,
    }
    // Exercise the Some branch and verify that its payload reaches the field.
    assert n2.next.is_some(): "match assign some flows through";
    assert n2.next.unwrap().val == 0: "some payload preserved";
    del n0;
    del n1;
    del n2;
}

// Optional pointers are represented explicitly by Option<T*>.


struct OptionalPointerNode {
    value: i32,
    next: Option<OptionalPointerNode*>,
}

fn case_option_pointer() {
    let node = OptionalPointerNode(value=42, next=Option<OptionalPointerNode*>.None);
    assert node.next.is_none(): "empty optional pointer";

    let next = OptionalPointerNode(value=7, next=Option<OptionalPointerNode*>.None);
    let linked = OptionalPointerNode(value=42, next=Option<OptionalPointerNode*>.Some(&next));
    assert linked.next.is_some(): "present optional pointer";
    assert (*linked.next.unwrap()).value == 7: "optional pointer payload";
}



fn main() {

    case_pointer_array();
    case_match_assign_option_reference();
    case_option_pointer();

}
