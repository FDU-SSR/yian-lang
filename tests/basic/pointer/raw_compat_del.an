// raw_compat_del.an: raw-pointer allocation, release, and reallocation.
//
// Verify the heap remains usable after del: a fresh block can be read/written independently
// of released pointers. Three allocation/release rounds verify stable heap state.
// A valid program without UAF/OOB must exit zero in both fat and raw modes.
//
// Expected output: 0

fn main() {
    let p: i32* = dyn[4] 0i32;
    p[0] = 7;
    p[3] = 9;
    assert p[0] + p[3] == 16: "values before del";

    del p;

    // Reallocate after release; the fresh block is independently usable.
    let q: i32* = dyn[4] 0i32;
    q[1] = 5;
    q[2] = 6;
    assert q[1] == 5: "q[1] after realloc";
    assert q[1] + q[2] == 11: "q[1]+q[2] == 11";
    del q;

    // Allocate again to verify heap state.
    let r: i32* = dyn[2] 0i32;
    r[0] = 1;
    r[1] = 2;
    assert r[0] + r[1] == 3: "third alloc reads";
    del r;
}
