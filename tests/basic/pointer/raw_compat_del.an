// raw_compat_del.an — 裸指针兼容:分配 + 释放 + 重分配
//
// 覆盖 del 正常路径后堆仍可用:del 释放一块,随后重分配的新块可
// 正常读写(不依赖已释放指针),连续三轮分配/释放验证堆状态稳定。
// 正确程序(无 UAF/OOB),fat 与 raw 双模式都必须 exit 0。
//
// Expected output: 0

fn main() {
    let p: i32* = dyn[4] i32;
    p[0] = 7;
    p[3] = 9;
    assert p[0] + p[3] == 16: "values before del";

    del p;

    // 释放后重分配:新块独立可用
    let q: i32* = dyn[4] i32;
    q[1] = 5;
    q[2] = 6;
    assert q[1] == 5: "q[1] after realloc";
    assert q[1] + q[2] == 11: "q[1]+q[2] == 11";
    del q;

    // 再次分配确认堆状态正常
    let r: i32* = dyn[2] i32;
    r[0] = 1;
    r[1] = 2;
    assert r[0] + r[1] == 3: "third alloc reads";
    del r;
}
