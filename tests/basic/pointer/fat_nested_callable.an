// Consolidated basic pointer and allocation scenarios.

// Combined expected output: payload

from std.core.io import Stdout;



// Result-level coverage for nested fat metadata and callable values.
// The same aggregate is copied through tuples, arrays, and an enum, while a
// closure is stored in a generic struct, passed through a generic function,
// returned through identity, and invoked through a receiver method.


struct Payload {
    ptr: i32*,
    reference: i32&,
    view: i32[],
    text: str,
    callback: fn(i32) -> i32,
}

enum Envelope {
    Empty,
    Full { payload: Payload },
}

struct ClosureBox<F> {
    payload: Payload,
    call: F,
}

impl<F> ClosureBox<F> {
    fn run(value: i32) -> i32 {
        (self.call)(value)
    }
}

fn add_bias(value: i32) -> i32 {
    value + 7
}

fn choose_callback() -> fn(i32) -> i32 {
    &add_bias
}

fn apply<F>(callable: F, value: i32) -> i32 {
    callable(value)
}

fn identity<F>(callable: F) -> F {
    callable
}

fn pass_payload(value: Payload) -> Payload {
    value
}

fn case_nested_fat_metadata_and_closures() {
    let values: i32[3] = [10, 20, 30];
    let storage: i32* = dyn[3] 0i32;
    storage[0] = 10;
    storage[1] = 20;
    storage[2] = 30;
    let anchor: i32 = 4;
    let payload = Payload(storage, &anchor, storage[0u64..3], "payload", choose_callback());

    // Repeated projections preserve the source pointer/slice metadata.
    assert values[1] == 20: "fixed array element projection";
    assert payload.ptr[2] == 30: "pointer field projection";
    assert *payload.reference == 4: "reference field projection";
    assert payload.view[1] == 20: "slice field projection";
    assert payload.text.as_slice()[0] == 112u8: "str field projection";
    assert (payload.callback)(5) == 12: "function pointer field call";
    let roundtrip: Payload = pass_payload(payload);
    assert roundtrip.view[2] == 30: "aggregate return projection";

    let tuple: (Payload, Envelope, fn(i32) -> i32) =
    (payload, Envelope.Full(payload), choose_callback());
    let copies: Payload[2] = [payload, tuple[0]];
    assert tuple[0].view[2] == 30: "tuple nested projection";
    assert copies[1].ptr[0] == 10: "array nested projection";

    let from_enum: i32 = match tuple[1] {
        Full(value) => value.view[1],
        Empty => -1,
    };
    assert from_enum == 20: "enum nested projection";
    assert (tuple[2])(3) == 10: "function pointer tuple call";

    let closure = |base = &anchor| (delta: i32) -> i32 {
        *base + delta
    };
    let boxed = ClosureBox(payload=payload, call=closure);
    assert boxed.payload.view[0] == 10: "closure box aggregate field";
    assert boxed.run(2) == 6: "closure receiver call";
    assert apply(closure, 3) == 7: "closure parameter call";
    let returned = identity(closure);
    assert returned(5) == 9: "closure returned through identity";

    let next: i32* = payload.ptr + 1;
    assert next - payload.ptr == 1: "nested pointer difference";
    assert next > payload.ptr: "nested pointer comparison";
    next[0] = 21;
    assert payload.view[1] == 21: "nested pointer/slice write";
    Stdout.new().write_str(payload.text).unwrap();
    del payload.ptr;
}

// Test for function pointers
//

struct Person {
    pub age: i32,
    pub score: i32,
}

impl Person {
    pub fn get_age() -> i32 {
        return self.age;
    }

    pub fn get_score() -> i32 {
        return self.score;
    }
}

fn add(a: i32, b: i32) -> i32
{
    return a + b
}

fn sub(a: i32, b: i32) -> i32 {
    return a - b;
}

fn make_person(x: i32, y: i32) -> Person {
    return Person(x, y);
}

fn accumulate(a: i32, b: i32, func: fn(i32, i32) -> i32) -> i32 {
    let c: i32 = func(a, b);
    return c;
}
struct Table {
    Add_pointer: fn(i32, i32) -> i32,
    Sub_pointer: fn(i32, i32) -> i32,
}

fn case_function_pointer_table()
{
    let add_func: fn(i32, i32) -> i32 = &add
    let per_func: fn(i32, i32) -> Person = &make_person
    let sub_func: fn(i32, i32) -> i32 = &sub

    let tb: Table = Table(add_func, sub_func)

    let tb2: Table* = &tb
    let i: i32 = (tb2.Add_pointer)(10, 2)

    let res: i32 = (tb.Add_pointer)(10, 2)
    let res2: i32 = (tb.Sub_pointer)(3, 2)

    let p: Person = per_func(2, 3)
    let age: i32 = p.get_age()
    let score: i32 = p.get_score()

    let res3: i32 = age + score
    let res4: i32 = add_func(1, 2) //dsfgsdfgdsaf
    let d: i32 = p.age + p.score
    let g: i32 = accumulate(5, 9, add_func)
    let h: i32 = sub_func(5, 1)

    let checksum: i32 = res + res2 + res3 + res4 + d + g + h

    assert checksum == 44: "fail"
}



fn main() {

    case_nested_fat_metadata_and_closures();
    case_function_pointer_table();

}
