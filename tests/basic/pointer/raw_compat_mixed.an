// raw_compat_mixed.an: allocation, arithmetic, field access, and release.
//
// Combine linked-list construction/traversal/release with stack-array arithmetic, differences, and ordering,
// using dyn, struct fields, and del in a valid program.
// Both fat and raw modes must exit zero.
//
// Expected output: 0

struct Node {
    value: i32,
    next: Option<Node*>,
}

fn main() {
    // Build and traverse the linked list.
    let n3: Node* = dyn Node(3, Option<Node*>.None);
    let n2: Node* = dyn Node(2, Option<Node*>.Some(n3));
    let n1: Node* = dyn Node(1, Option<Node*>.Some(n2));

    let sum: i32 = 0;
    let cur: Option<Node*> = Option<Node*>.Some(n1);
    while cur.is_some() {
        let cn: Node* = *cur.unwrap();
        sum = sum + cn.value;
        if cn.next.is_some() {
            cur = Option<Node*>.Some(*cn.next.unwrap());
        } else {
            cur = Option<Node*>.None;
        };
    }
    assert sum == 6: "list sum == 6";

    // Stack-array pointer arithmetic, differences, and ordering.
    let arr: i32[5] = [1, 2, 3, 4, 5];
    let p: i32* = &arr[0];
    assert *(p + 3) == 4: "*(p+3) == 4";
    let diff: i64 = (p + 4) - p;
    assert diff == 4: "ptr diff == 4";
    assert p + 4 > p + 3: "p+4 > p+3";

    // Release the whole chain, saving next before del.
    let d: Option<Node*> = Option<Node*>.Some(n1);
    let count: i32 = 0;
    while d.is_some() {
        let dn: Node* = *d.unwrap();
        let nx: Option<Node*>;
        if dn.next.is_some() {
            nx = Option<Node*>.Some(*dn.next.unwrap());
        } else {
            nx = Option<Node*>.None;
        };
        del dn;
        d = nx;
        count += 1;
    }
    assert count == 3: "deleted 3 nodes";
}
