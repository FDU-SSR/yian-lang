// Consolidated basic pointer and allocation scenarios.



// Test pointer operations on dynamic allocation
//

struct Person {
    name: str,
    age: i32,
}

fn case_dynamic_struct_and_array_pointer()
{
    let p: Person* = dyn Person("Alice", 30)
    assert p.age == 30: "Expected age to be 30"

    p.age = 31
    assert p.age == 31: "Expected age to be 31 after modification"

    let arr: i32* = dyn[3] 0i32
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    assert arr[1] == 20: "Expected arr[1] to be 20"

    arr += 1
    assert *arr == 20: "Expected *arr to be 20 after pointer arithmetic"

}

// Fat pointer: field read/write through a heap-allocated struct pointer.
//

struct Inner {
    v: i32,
}

struct Node {
    inner: Inner,
    next: Option<i32*>,
}

fn case_heap_field_access() {
    // Heap-allocate a Node (fat pointer, 5-field representation).
    let p: Node* = dyn Node(Inner(10), Option<i32*>.None)
    assert p.inner.v == 10: "Expected p.inner.v to be 10"

    // Field write through the fat pointer.
    p.inner.v = 11
    assert p.inner.v == 11: "Expected p.inner.v to be 11 after write"

    // Pointer field is a sub-pointer that can be re-dereferenced.
    let arr: i32* = dyn[2] 0i32
    arr[0] = 5
    p.next = Option<i32*>.Some(arr)
    let q: i32* = *p.next.unwrap()
    assert q[0] == 5: "Expected q[0] to be 5 via p.next"

    // Write through the re-fetched sub-pointer, visible via all paths.
    q[0] = 6
    assert arr[0] == 6: "Expected arr[0] to be 6 after write via q"
    assert (*p.next.unwrap())[0] == 6: "Expected p.next[0] to be 6"
}

// Test pointer operations on struct fields
//

struct MyStruct {
    a: i32,
    b: bool,
    c: char,
    d: f64,
    e: i32*,
}

fn case_struct_field_addresses() {
    let f: i32 = 100;
    let my_struct: MyStruct = MyStruct(
        5,
        true,
        'c',
        1.1,
        &f
    )
    let pa: i32* = &my_struct.a;
    let pb: bool* = &my_struct.b;
    let pc: char* = &my_struct.c;
    let pd: f64* = &my_struct.d;
    let pe: i32** = &my_struct.e;

    assert *pa == 5: "Expected *pa to be 5";
    assert *pb == true: "Expected *pb to be true";
    assert *pc == 'c': "Expected *pc to be 'c'";
    assert *pd == 1.1: "Expected *pd to be 1.1";
    assert *pe == &f: "Expected *pe to be address of f";

    *(my_struct.e) = 5
    assert f == 5: "Expected f to be 5 after modification through pointer";

}



fn main() {

    case_dynamic_struct_and_array_pointer();
    case_heap_field_access();
    case_struct_field_addresses();

}
