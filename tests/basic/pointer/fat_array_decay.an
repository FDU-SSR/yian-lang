// Consolidated basic pointer and allocation scenarios.

from std.core.vec import Vec;



// Test for pointer usage with arrays
//

fn case_array_pointer_traversal() {
    let arr: i32[10] = [0;
        10];
    for i in 0..10u64 {
        arr[i] = i32(i);
    }

    let p: i32* = &arr[0];
    for i in 0..10u64 {
        p[i] += 66;
    }
    assert arr[0] == 66: "Expected 66";

    let begin: i32* = &arr[0];
    let end: i32* = begin + 10;
    while begin < end {
        *begin += 1;
        begin += 1;
    }
    assert arr[9] == 76: "Expected 76";

}

// Fat pointer: array decay T[N]→T* and re-anchor T[N]*→T*.
//

fn case_array_decay() {
    let arr: i32[4] = [1, 2, 3, 4]

    // T[N] → T* (array decay)
    let p: i32* = arr
    assert p[0] == 1: "Expected p[0] to be 1"
    assert p[3] == 4: "Expected p[3] to be 4"

    // Write through the decayed pointer, visible on the array.
    p[3] = 40
    assert arr[3] == 40: "Expected arr[3] to be 40 after write via p"

    // T[N]* → T* (re-anchor on &arr)
    let p2: i32* = &arr
    assert p2[1] == 2: "Expected p2[1] to be 2"
    assert p2[3] == 40: "Expected p2[3] to be 40"

    // Both pointers traverse the whole array.
    for i in 0..4u64 {
        p[i] += 1
    }
    assert arr[0] == 2: "Expected arr[0] to be 2 after loop"
    assert p2[3] == 41: "Expected p2[3] to be 41 after loop"
}

// Fat-pointer semantic composite: slice views via stdlib public APIs
// (a) Vec::as_slice() returns a fat slice view; (b) plain range syntax
// p[lo..hi] on a pointer yields a bounded slice view. Assert length and
// element values through the views (no restricted @slice_* primitives).
//


fn case_slice_views() {
    // (a) slice view from Vec::as_slice() — stdlib public API
    let v: Vec<i32> = Vec<i32>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    v.push(40);
    let s: i32[] = v.as_slice();
    assert s.len() == 4: "as_slice length";
    assert s[0] == 10: "as_slice s[0]";
    assert s[2] == 30: "as_slice s[2]";
    assert s[3] == 40: "as_slice s[3]";

    // (b) slice view from pointer range syntax (plain syntax path)
    let arr = [1i32, 2, 3, 4, 5];
    let p = arr.ptr();
    let sub: i32[] = p[1u64..4];
    assert sub.len() == 3: "range slice length";
    assert sub[0] == 2: "range slice sub[0]";
    assert sub[2] == 4: "range slice sub[2]";

    // (c) write through the slice view reaches the backing array
    sub[0] = 99;
    assert arr[1] == 99: "write through slice view";
}



fn main() {

    case_array_pointer_traversal();
    case_array_decay();
    case_slice_views();

}
