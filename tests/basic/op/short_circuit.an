// Test short circuit mechanism for logical operators
//
// Expected output:
// Short circuit works correctly

from std.core.io import print;

fn false_func() -> bool {
    print("false_func called\n");
    return false;
}

fn true_func() -> bool {
    panic("true_func should ! be called\n");
}

fn main() {
    if false && false_func() {
        panic("This should ! be printed\n");
    }

    if true || true_func() {
        print("Short circuit works correctly\n");
    }

    let a: bool;
    a = true || true_func();

}