from std.core.io import print;

fn source(ok: bool) -> Result<i32, i32> {
    if ok { Result<i32, i32>.Ok(7) } else { Result<i32, i32>.Err(3) }
}

fn cleanup(ok: bool, calls: i32&) -> Result<i32, i32> {
    defer { *calls += 1; print("outer\n"); };
    {
        defer { *calls += 1; print("inner\n"); };
        let value = source(ok)?;
        Result<i32, i32>.Ok(value)
    }
}

fn closure_body() -> i32 {
    let run = || () -> Result<i32, i32> {
        defer print("closure\n");
        Result<i32, i32>.Ok(source(false)?)
    };
    assert *run().unwrap_err() == 3;
    11
}

fn capture(ok: bool) -> Result<bool, i32> {
    let run = |value = source(ok)?| () -> i32 { value + 1 };
    Result<bool, i32>.Ok(run() == 8)
}

fn main() {
    let calls: i32 = 0;
    assert *cleanup(false, &calls).unwrap_err() == 3;
    assert calls == 2;
    assert *cleanup(true, &calls).unwrap() == 7;
    assert calls == 4;
    assert closure_body() == 11;
    assert *capture(true).unwrap();
    assert *capture(false).unwrap_err() == 3;
    defer {
        let run = || () -> Option<i32> { Option<i32>.Some(Option<i32>.None?) };
        assert run().is_none();
        print("deferred closure\n");
    };
}
