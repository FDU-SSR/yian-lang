trait Number {
    fn number() -> i32;
}

impl Number for i32 {
    fn number() -> i32 {
        return *self;
    }
}

struct Wrapper<T> {
    value: T,
}

impl<T> Number for Wrapper<T> if T: Number {
    fn number() -> i32 {
        return self.value.number();
    }
}

fn generic_object<T>(value: T*) -> Number& {
    return value;
}

fn main() {
    let value: Wrapper<i32> = Wrapper(value=42);
    let object: Number& = generic_object(&value);
    assert object.number() == 42;
}
