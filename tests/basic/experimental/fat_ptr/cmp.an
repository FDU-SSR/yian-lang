fn main() {
    let p0: i32* = dyn i32[10]
    p1 = p0 + 1
    _p1 = p0 + 1
    p2 = p0 + 2
    p3 = p0 + 3
    assert p0 < p1: "p0 < p1 fail"
    assert p0 <= p0: "p0 <= p0 fail"
    assert p3 > p0: "p3 > p0 fail"
    assert p2 >= p1: "p2 >= p1 fail"
    assert p1 == _p1: "p1 == _p1 fail"
    assert p2 != p1: "p2 != p1 fail"
    return 0
}