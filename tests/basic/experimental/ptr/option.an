// Definition of the Option type and its methods
//
// The Option type is an enum that can either be None or Some value of type T.
// It is used to represent an optional value that may or may not be present.
pub enum Option<T> {
    None,
    Some{T val}
}

impl<T> Option<T> {
    pub bool is_some() {
        match *self {
            None => { return false }
            Some => { return true }
        }
    }

    pub bool is_none() {
        return ! self.is_some();
    }

    pub T unwrap() {
        match *self {
            None => { panic("Call unwrap() on None") }
            Some as load { return load.val }
        }
    }

    pub T unwrap_or(T default) {
        match *self {
            None => { return default }
            Some as load { return load.val }
        }
    }

    pub Option<T> take() {
        match *self {
            None => { return None }
            Some as load {
                let ret: T = load.val
                *self = Option<T>.None
                return Option<T>.Some(ret)
            }
        }
    }
}
