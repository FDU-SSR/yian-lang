// Test literal in generic inference
//
// Expected output: 0

struct Value<T> {
    pub val: T,
}

impl<T> Value<T> {
    pub static fn new_array(default_value: T, size: u64) -> Self* {
        let arr: Self* = dyn[size] Self;
        for i in 0..size {
            arr[i] = Self(val=default_value)
        }
        return arr;
    }
}

fn main() {
    let int_values: Value<i32>* = Value<i32>.new_array(42, 5);
    let float_values: Value<f64>* = Value<f64>.new_array(3.14, 5);

    let int_sum: i32 = 0;
    for i in 0..5u64 {
        int_sum += int_values[i].val
    }

    let float_sum: f64 = 0.0;
    for i in 0..5u64 {
        float_sum += float_values[i].val
    }

    assert int_sum == 210: "Integer sum should be 210";
    assert float_sum > 15.7 && float_sum < 15.8: "Float sum should be approximately 15.7";

}