// Store a function item in a tuple alongside a normal value and call it via
// index access.
//
// Expected output: 0

fn add1(x: i32) -> i32 { return x + 1; }

fn main() {
    let t = (add1, 5);
    assert t[0](41) == 42: "call function item from a tuple element";
    assert t[1] == 5: "normal tuple element survives the ZST element";
}
