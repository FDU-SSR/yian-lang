// Test function pointer assignment and invocation
//
// Expected output: 0

struct Person{
    pub age: i32,
    pub score: i32,
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn make_person(x: i32, y: i32) -> Person {
    return Person(x, y);
}

fn main() {
    let add_func: fn(i32, i32) -> i32 = &add;
    let person_func: fn(i32, i32) -> Person = &make_person;

    let p: Person = person_func(2, 3);
    assert p.age == 2 && p.score == 3: "person_func should return Person(2, 3)";
    
    assert add_func(1, 2) == 3: "add_func should return 3";
    
}
