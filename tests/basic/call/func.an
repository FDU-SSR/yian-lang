// Test function calls
//
// Expected output: 0

fn add(a: i8, b: i8) -> i8{
    return a + b;
}

fn sub(a: i8, b: i8) -> i8{
    return a - b;
}

fn main(){
    let one: i8 = 1;
    let two: i8 = 2;
    let three: i8 = add(one, two);

    assert three == 3: "Addition function failed";
    assert sub(three, one) == two: "Subtraction function failed";
    assert sub(three, two) == one: "Subtraction function failed";

}