enum Command {
    Start, Stop,
    Move {
        is_forward: bool,
        distance: i32,
    },
    Speak {
        message: str,
    },
}

fn main() {
    let c1: Command = Command.Start;
    let c3: Command = Command.Move(is_forward = true, distance = 5);
    let c4: Command = Command.Speak(message = "hello");
}
