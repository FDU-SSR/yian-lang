// Test: enums with aggregate payloads can be copied

struct Data {
    value: i64,
}

impl Clone for Data {
    pub fn clone() -> Self { Data(self.value) }
}

enum BadEnum {
    A { val: i32 },
    B { val: Data },
}

fn main() {
    let e1 = BadEnum.A(val = 1);
    let e2 = e1;
    match e1 { A(val) => assert val == 1, _ => panic("source changed") }
    match e2 { A(val) => assert val == 1, _ => panic("copy changed") }
}
