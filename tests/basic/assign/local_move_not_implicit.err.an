// A user-defined Move trait is not implicitly satisfied for scalar values.
trait Move {
    fn move() -> Self;
}

struct Wrapper<T> {
    value: T,
}

impl<T> Move for Wrapper<T> if T: Move {
    fn move() -> Self {
        Wrapper(self.value)
    }
}

fn main() {
    let value: Wrapper<i32> = Wrapper(1);
    value.move();
}
