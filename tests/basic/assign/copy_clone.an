// Test: aggregate bitwise copy and explicit Clone are independent mechanisms
//
// Expected output: 0

struct BigInt {
    value: i64,
}

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

fn main() {
    let a: BigInt = BigInt(42);
    assert a.value == 42: "a.value should be 42";

    let b = a.clone();
    assert b.value == 42: "b.value should be 42";
    assert a.value == 42: "a should still be valid after clone";

    let c = a;
    assert c.value == 42: "c.value should be 42";
    assert a.value == 42: "ordinary copy does not invalidate source";

    let d: BigInt = BigInt(10);
    assert d.value == 10: "d.value should be 10";

}
