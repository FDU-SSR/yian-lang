// Test: generic structs support ordinary assignment
//
// Expected output: 0

struct Pair<A, B> {
    first: A,
    second: B,
}

fn main() {
    let p1: Pair<i32, bool> = Pair<i32, bool>(first = 1, second = true);
    let p2 = p1;
    assert p2.first == 1: "first should be 1";
    assert p2.second: "second should be true";
}
