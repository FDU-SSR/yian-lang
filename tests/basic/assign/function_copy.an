// Test: function parameters receive ordinary copies

struct BigInt {
    value: i64,
}

impl Clone for BigInt {
    pub fn clone() -> Self { BigInt(self.value) }
}

fn consume(v: BigInt) -> i64 { v.value }

fn main() {
    let x: BigInt = BigInt(42);
    assert consume(x) == 42;
    assert x.value == 42;
}
