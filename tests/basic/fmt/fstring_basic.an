// Test formatted-string templates and the shared formatting targets.

from std.core.fmt import Format, Formatter, FormatSpec;
from std.core.io import Write, IoError;

struct Point { x: i32, y: i32 }

impl Format for Point {
    fn fmt(out: Formatter&, spec: FormatSpec&) -> Result<(), IoError> {
        spec.require_default()?;
        let inner = FormatSpec.new();
        out.write_str("Point(")?;
        out.write_value(&self.x, &inner)?;
        out.write_str(", ")?;
        out.write_value(&self.y, &inner)?;
        out.write_str(")")
    }
}

// An inherent method with the trait's name must not intercept trait dispatch.
struct Sneaky { value: i32 }
impl Sneaky {
    fn fmt() -> str { "inherent" }
}
impl Format for Sneaky {
    fn fmt(out: Formatter&, spec: FormatSpec&) -> Result<(), IoError> {
        spec.require_default()?;
        out.write_str("trait")
    }
}

struct Counter {
    first_calls: u64,
    first_formats: u64,
    second_calls: u64,
    second_formats: u64,
    order_ok: bool,
}

struct Mark { counter: Counter&, first: bool }

impl Format for Mark {
    fn fmt(out: Formatter&, spec: FormatSpec&) -> Result<(), IoError> {
        spec.require_default()?;
        if self.first { self.counter.first_formats += 1; } else { self.counter.second_formats += 1; }
        out.write_str("M")
    }
}

impl Counter {
    static fn new() -> Self {
        Self(first_calls=0, first_formats=0, second_calls=0, second_formats=0, order_ok=false)
    }
    fn first() -> Mark {
        self.first_calls += 1;
        Mark(counter=self, first=true)
    }
    fn second() -> Mark {
        self.second_calls += 1;
        if self.first_formats == 1 { self.order_ok = true; }
        Mark(counter=self, first=false)
    }
}

// A recording target accepts partial writes and counts flushes.
struct Recorder { text: String, flushes: u64 }
impl Recorder {
    static fn new() -> Self { Self(text=String.new(), flushes=0) }
}
impl Write for Recorder {
    fn write(data: u8[]) -> Result<u64, IoError> {
        let count: u64 = 2;
        if count > data.len() { count = data.len(); }
        self.text.push_str(str.from_slice_unchecked(data[0u64..count]));
        Result<u64, IoError>.Ok(val=count)
    }
    fn flush() -> Result<(), IoError> {
        self.flushes += 1;
        Result<(), IoError>.Ok(val=())
    }
}

fn case_fstring_basic() {
    let name = "Yian";
    let ver = 1;
    let msg = f"Welcome to {name} v{ver}!";
    @print(f"{msg.as_str()}");
    @print("\n");
}

fn case_fstring_empty() {
    let e = f"";
    @print(f"empty: [{e}]\n");
}

// Escaped braces must stay literal while embedded expressions are formatted.
fn case_fstring_escaped_braces() {
    let s = f"\{not an expr\}";
    @print(f"{s.as_str()}");
    @print("\n");

    let x = 3;
    let t = f"\{ {x} \}";
    @print(f"{t.as_str()}");
    @print("\n");
}

fn case_fstring_expressions() {
    let a = 10;
    let b = 20;
    let msg = f"{a} + {b} = {a + b}";
    @print(f"{msg.as_str()}");
    @print("\n");
}

fn case_fstring_nested_expression() {
    let x = 5;
    let s = f"if: {if x > 0 { "pos" } else { "neg" }}!";
    @print(f"{s.as_str()}");
    @print("\n");
}

fn case_three_targets() {
    let point = Point(x=1, y=2);
    let text = f"point={point}";
    assert text.as_str() == "point=Point(1, 2)";

    let conversion = point.to_string();
    assert conversion.as_str() == "Point(1, 2)";
    conversion.drop();

    let buffer = String.with_capacity(64u64);
    let capacity = buffer.capacity();
    buffer.push_str("pre:");
    @append(&buffer, f"p={point}");
    assert buffer.as_str() == "pre:p=Point(1, 2)";
    assert buffer.capacity() == capacity;
    @print(f"{buffer.as_str()}\n");
    buffer.drop();
    text.drop();

    let sneaky = Sneaky(value=4);
    let formatted = f"{sneaky}";
    assert formatted.as_str() == "trait";
    formatted.drop();
    assert sneaky.fmt() == "inherent";

    let counter = Counter.new();
    let recorder = Recorder.new();
    let result = @write(&recorder, f"A{counter.first()}B{counter.second()}");
    assert result.is_ok();
    assert recorder.text.as_str() == "AMBM";
    assert recorder.flushes == 0u64;
    assert counter.first_calls == 1u64;
    assert counter.first_formats == 1u64;
    assert counter.second_calls == 1u64;
    assert counter.second_formats == 1u64;
    assert counter.order_ok;
    recorder.text.drop();
    @println("three targets ok");
}

// A specification selects fixed width/precision while unspecialized fields keep their representation.
fn case_format_specs() {
    let negative = -12;
    assert f"{negative:05}" == "-0012": "integer sign before zero fill";

    let value = 1.25;
    assert f"{value:08.2f}" == "00001.25": "float zero fill and precision";
    assert f"{value:.2f}" == "1.25": "precision without width";
    assert f"{value:8.2f}" == "    1.25": "width with precision";
    let wide: u64 = 8u64;
    let digits: u64 = 2u64;
    assert f"{value:{wide}.{digits}f}" == f"{value:8.2f}": "dynamic parameters equal literals";

    let middle: char = '中';
    assert f"{middle:>3}" == "  中": "character width counts scalars";
    let text = "ab";
    assert f"[{text:5}]" == "[ab   ]": "text defaults to left alignment";
    let empty = "";
    let padding: u64 = 3u64;
    assert f"[{empty:{padding}}]" == "[   ]": "empty text with dynamic width";
    let whole: f64 = 2.0;
    assert f"{whole:f}" == "2.000000": "bare fixed marker uses six digits";
    assert f"{whole}" == "2": "no specification keeps the shortest form";
}

// Plain integers record evaluation order without a custom Format implementation.
struct Sequence { first_calls: u64, second_calls: u64, order_ok: bool }

impl Sequence {
    static fn new() -> Self { Self(first_calls=0u64, second_calls=0u64, order_ok=false) }
    fn first() -> i32 { self.first_calls += 1; 11 }
    fn second() -> i32 {
        self.second_calls += 1;
        if self.first_calls == 1u64 { self.order_ok = true; }
        22
    }
}

struct Steps { log: String }

impl Steps {
    static fn new() -> Self { Self(log=String.new()) }
    fn value() -> f64 { self.log.push('v'); 1.5 }
    fn width() -> u64 { self.log.push('w'); 6u64 }
    fn precision() -> u64 { self.log.push('p'); 2u64 }
}

// Each parameter is evaluated exactly once, in value, width, precision order.
fn case_parameter_order() {
    let steps = Steps.new();
    let text = f"[{steps.value():{steps.width()}.{steps.precision()}f}]";
    assert text.as_str() == "[  1.50]": "evaluated field";
    assert steps.log.as_str() == "vwp": "parameter order";
    steps.log.drop();
    text.drop();

    let sequence = Sequence.new();
    let counted = f"A{sequence.first():5}B{sequence.second()}";
    assert counted.as_str() == "A   11B22": "specified and default fields";
    assert sequence.first_calls == 1u64: "first evaluated once";
    assert sequence.second_calls == 1u64: "second evaluated once";
    assert sequence.order_ok: "fields evaluated in order";
    counted.drop();
}

// Every entry point accepts a specification and shares one target writer.
fn case_targets_with_specs() {
    let value = 1.25;

    let owned = f"[{value:6.2f}]";
    assert owned.as_str() == "[  1.25]": "owned string";
    owned.drop();

    let buffer = String.with_capacity(32u64);
    @append(&buffer, f"a={value:.1f}");
    assert buffer.as_str() == "a=1.2": "append target";
    buffer.drop();

    let recorder = Recorder.new();
    let result = @write(&recorder, f"v={value:6.2f}");
    assert result.is_ok(): "write target";
    assert recorder.text.as_str() == "v=  1.25": "write bytes";
    recorder.text.drop();

    @print(f"print[{value:6.2f}]\n");
    @println(f"println[{"ab":>4}]");
    @eprint(f"eprint[{value:.1f}]\n");
    @eprintln(f"eprintln[{value:05.1f}]");
}

fn main() {
    // Keep this order aligned with the combined output oracle.
    case_fstring_basic();
    case_fstring_empty();
    case_fstring_escaped_braces();
    case_fstring_expressions();
    case_fstring_nested_expression();
    case_three_targets();
    case_format_specs();
    case_parameter_order();
    case_targets_with_specs();
}
