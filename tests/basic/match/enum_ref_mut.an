// Matching an enum reference permits mutation through payload references.
//
// Payload field references refer to the original value.

enum E {
    A { n: i32 },
    B { n: i32 },
}

fn main() {
    let e: E = E.A(42);

    // The binding refers to the original payload field.
    match &e {
        A(n) => {
            let field: i32& = n;
            *field = 99;
        },
        _ => {
            assert false;
        },
    }

    // Verify the original was mutated
    match e {
        A(n) => {
            assert n == 99;
        },
        _ => {
            assert false;
        },
    }

}
