// 正常大分配对照:t1 malloc 溢出修复的正例。
//
// dyn[2^30] u8 → 2^30 × 1B = 1GB,远小于 2^64,不应被 i128 溢出检测误伤。
// 写末元素(2^30 - 1)并回读验证物理分配完整。

fn main() {
    let p: u8* = dyn[1073741824] u8;  // 2^30 元素 × 1B = 1GB
    p[1073741823] = 42;               // 写末元素
    assert p[1073741823] == 42: "large alloc ok";
    del p;
}
