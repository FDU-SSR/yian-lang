// Multi-level pointer chain: &v → p1 (i32*) → p2 (i32**) → p3 (i32***).
// Dereference through all levels, pointer equality across levels, and a write
// through the chain. Complementary to multiple.an (which only reads ***f).
//
// Expected output: 0

fn main() {
    let v: i32 = 7;
    let p1: i32* = &v;
    let p2: i32** = &p1;
    let p3: i32*** = &p2;

    // deref through all levels
    assert ***p3 == 7: "***p3 == 7";

    // pointer equality across levels
    assert **p3 == &v: "**p3 == &v";
    assert **p3 == p1: "**p3 == p1";
    assert *p3 == &p1: "*p3 == &p1";
    assert *p3 == p2: "*p3 == p2";
    assert p1 == &v: "p1 == &v";

    // write through the chain
    ***p3 = 8;
    assert v == 8: "write through ***p3 updates v";
    assert ***p3 == 8: "read back ***p3 == 8";
}
