// raw_compat_mixed.an — 裸指针兼容:混合操作(分配 + 算术 + 字段 + 释放)
//
// 组合用例:链表构建/遍历/释放 + 栈数组指针算术与差、序比较,
// 混合 dyn 分配、struct 字段访问、del。正确程序,
// fat 与 raw 双模式都必须 exit 0。
// (NULL 迁移:链表尾哨兵以 Option<Node*>.None 表达)
//
// Expected output: 0

struct Node {
    value: i32,
    next: Option<Node*>,
}

fn main() {
    // 链表构建 + 遍历
    let n3: Node* = dyn Node(3, Option<Node*>.None);
    let n2: Node* = dyn Node(2, Option<Node*>.Some(n3));
    let n1: Node* = dyn Node(1, Option<Node*>.Some(n2));

    let sum: i32 = 0;
    let cur: Option<Node*> = Option<Node*>.Some(n1);
    while cur.is_some() {
        let cn: Node* = cur.unwrap()[0];
        sum = sum + cn.value;
        if cn.next.is_some() {
            cur = Option<Node*>.Some(cn.next.unwrap()[0]);
        } else {
            cur = Option<Node*>.None;
        };
    }
    assert sum == 6: "list sum == 6";

    // 栈数组指针算术 + 差 + 序比较
    let arr: i32[5] = [1, 2, 3, 4, 5];
    let p: i32* = &arr[0];
    assert *(p + 3) == 4: "*(p+3) == 4";
    let diff: i64 = (p + 4) - p;
    assert diff == 4: "ptr diff == 4";
    assert p + 4 > p + 3: "p+4 > p+3";

    // 释放整条链(先存 next 再 del)
    let d: Option<Node*> = Option<Node*>.Some(n1);
    let count: i32 = 0;
    while d.is_some() {
        let dn: Node* = d.unwrap()[0];
        let nx: Option<Node*>;
        if dn.next.is_some() {
            nx = Option<Node*>.Some(dn.next.unwrap()[0]);
        } else {
            nx = Option<Node*>.None;
        };
        del dn;
        d = nx;
        count += 1;
    }
    assert count == 3: "deleted 3 nodes";
}
