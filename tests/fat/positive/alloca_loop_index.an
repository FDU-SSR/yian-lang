// 循环内栈泄漏回归(第 3 个代码生成缺陷)
// 循环内字面量下标 block[0]/block[31] → 隐式取址 alloca 发到循环块
// → llvmlite 动态栈分配 rsp 单调 -32B/迭代 → 大迭代 SIGSEGV
// 修复前: SIGSEGV(exit 139);修复后: exit 0
fn main() {
    let checksum: i64 = 0;
    let rounds: u64 = 300000;
    let r: u64 = 0;
    while r < rounds {
        let block: i32* = dyn[32] i32;
        let k: u64 = 0;
        while k < 32 { block[k] = i32(k); k += 1; }
        checksum += i64(block[0]) + i64(block[31]);   // 读路径:字面量下标
        del block;
        r += 1;
    }
    assert checksum == i64(31) * i64(rounds): "mismatch";
}
