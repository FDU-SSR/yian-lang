// 同族回归:循环内枚举构造(construct_enum_variant 临时 alloca)
// 修复前:临时 alloca 发到循环块 → llvmlite 动态栈分配 → 大迭代栈泄漏 SIGSEGV
// 修复后:entry 块提升 → exit 0
enum Mode {
    A,
    B { v: i64 },
    C { v: i64, w: i64 },
}

fn main() {
    let acc: i64 = 0;
    let rounds: u64 = 300000;
    let r: u64 = 0;
    while r < rounds {
        let m: Mode = Mode.B(v = 1);
        let n: Mode = Mode.C(v = 2, w = 3);
        match m {
            B(v) => acc += v,
            _ => acc += 100,
        }
        match n {
            C(v, w) => acc += v + w,
            _ => acc += 100,
        }
        r += 1;
    }
    assert acc == i64(6) * i64(rounds): "enum mismatch";
}
