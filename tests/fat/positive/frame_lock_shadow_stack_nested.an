// Stable frame-lock shadow-stack regression.
//
// Every active address-taking invocation must own a distinct arena slot.
// Returning from the child pops only its slot, so the parent's pointer remains
// live until the parent returns.  Repeated recursion also exercises slot reuse.

fn nested(depth: i32) -> i32 {
    let value: i32 = depth + 40;
    let ptr: i32* = &value;
    if depth > 0 {
        assert nested(depth - 1) == depth + 39: "child result";
    }
    assert *ptr == depth + 40: "parent frame lock survives child return";
    return *ptr;
}

fn main() {
    assert nested(32) == 72: "nested stable frame locks";
    assert nested(32) == 72: "arena slots are reusable";
}
