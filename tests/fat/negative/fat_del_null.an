// Fat-pointer delete of null — 放行例(成功测试,期望 exit 0)
//
// 实现选择(2026-08, docs/security-code.md §7.1 Delete):delete(null) 放行而非
// 确定性 trap —— CheckDelete 以 `is_null ∨ 四前提` OR 放行;stdlib 空容器 Drop
// (RawVec 空态 del self.data)依赖 free(NULL) no-op、C 语义安全。
// 无 .ans 文件:成功测试(exit 0,无输出)。

fn main() {
    let p: i32* = nullptr;
    del p  // CheckDelete null 快路径放行,free(NULL) no-op → 不 trap
}
