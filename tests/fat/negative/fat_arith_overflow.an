// Fat-pointer arithmetic overflow negative test (胖指针表示, 规则 3.3.1-3.3.2)
//
// CheckElementArith(定义 13):0 ≤ index + offset ≤ size。
// p + 5:index 0 + 5 > size 4 → 良构失败 → llvm.trap → Exit code -4。
// 注意:p + 4(one-past-end,index == size)是良构的,不会 trap;p + 5 越界才 trap。

fn main() {
    let p: i32* = dyn[4] i32;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    let q: i32* = p + 5;  // index 0 + 5 > size 4 → CheckElementArith 失败 → trap
    assert false: "unreachable"
}
