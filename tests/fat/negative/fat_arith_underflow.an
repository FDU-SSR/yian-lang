// Fat-pointer arithmetic underflow (negative direction) negative test (t6, 规则 3.3.1-3.3.2)
//
// CheckElementArith(定义 13):0 ≤ index + offset ≤ size。
// p - 1:offset = -1 → index 0 + (-1) < 0 → 良构失败 → llvm.trap → Exit code -4。

fn main() {
    let p: i32* = dyn[4] i32;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    let q: i32* = p - 1;  // index 0 + (-1) < 0 → CheckElementArith 失败 → trap
    assert q != nullptr: "unreachable"
}
