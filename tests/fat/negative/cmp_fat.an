// Fat-pointer comparison field-based semantics (t10, 规则 3.4.1-3.4.2, §7.6 风险 3)
//
// 1. Cross-object == is ALLOWED — equality compares the (data, index) pair
// 2. Same-object ordered comparison — compares by index after data-equal check
// 3. Cross-object < TRAPS — data unequal fails the 规则 3.4.1 prerequisite
//
// Expected runtime trap: Exit code -4

fn main() {
    // -- assertion 1: cross-object == / != are allowed, compared by (data, index) --
    let a1: i32 = 1;
    let b1: i32 = 2;
    let pa: i32* = &a1;
    let pb: i32* = &b1;
    assert pa != pb: "cross-object pointers should not be equal";
    let qa: i32* = &a1;
    assert pa == qa: "same-object same-index pointers should be equal";
    assert pa == &a1: "same address == same address";

    // -- assertion 2: same-object ordered comparison compares by index --
    let arr: i32[4] = [10, 20, 30, 40];
    let base: i32* = &arr[0];
    let p1: i32* = base + 1;
    let p2: i32* = base + 3;
    assert base < p1: "base < p1";
    assert p1 < p2: "p1 < p2";
    assert p1 > base: "p1 > base";
    assert p1 <= p1: "p1 <= p1";
    assert p2 >= p1: "p2 >= p1";
    assert !(p2 < p1): "p2 < p1 should be false";

    // -- assertion 3: cross-object < traps (data unequal → 规则 3.4.1 前提失败) --
    let c1: i32 = 5;
    let c2: i32 = 6;
    let pc1: i32* = &c1;
    let pc2: i32* = &c2;
    assert pc1 < pc2: "cross-object < traps (data unequal)";
}
