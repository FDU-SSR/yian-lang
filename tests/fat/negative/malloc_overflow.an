// 分配字节回绕负例(t1:malloc 分配字节溢出缺口)
//
// dyn[2^62+1] u64 → 8×(2^62+1) = 2^65 字节 → 64 位回绕
// 修复前:malloc 的 n×|T| 在 64 位乘法回绕成小值,物理分配过小;胖指针 size 字段
//   = 2^62+1(元素数,无回绕),in_bounds 全部通过 → 访问越过物理分配,检查失效。
// 修复后:分配时 i128 宽算检测 total ≥ 2^64 → llvm.trap → Exit code -4。

fn main() {
    let p: u64* = dyn[4611686018427387905] u64;
    p[0] = 1;  // 修复前:写越界不 trap;修复后:分配即 trap
}
