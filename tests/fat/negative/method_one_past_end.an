// Fat-pointer one-past-end METHOD CALL negative test (F2 安全语义固化)
//
// p + 4 是良构的 one-past-end 指针(index == size,定义 13 允许);对其调用方法
// (impl i32 的 get_val 内 *self)等价于解引用 one-past-end 指针 → 触发
// receiver 折算前插入的 CheckInBounds(p,1)(规则 3.2.1/3.5.2):index + 1 > size
// → 失败 → trap(期望 Exit code -4)。
//
// 背景:方法签名 receiver 折算为 T&(24B)后,方法体内 self 访问仅剩 CheckRefAccess
// (live),in_bounds 语义随 index/size 字段折算删除而丢失(t4→F2 修复前此处
// 不 trap,可越界读);F2 修复在调用侧折算前对 T* receiver 恢复 CheckInBounds。

impl i32 {
    pub fn get_val() -> i32 {
        return *self;
    }
}

fn main() {
    let p: i32* = dyn[4] i32;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    let end: i32* = p + 4;   // one-past-end: index == size,算术良构
    let v: i32 = end.get_val();  // one-past-end 方法调用 → CheckInBounds 失败 → trap
    assert v == 5: "unreachable"
}
