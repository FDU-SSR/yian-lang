// Test for multiple levels of pointers
//
// Expected output: 0

fn main() -> i32 {
    let a: i32 = 66;
    let b: i32* = &a;
    let c: i32** = &b;
    let d: i32*** = &c;
    let e: i32**** = &d;
    let f: i32***** = &e;

    assert *****f == 66: "Expected *****f to be 66";
    
    return 0;
}