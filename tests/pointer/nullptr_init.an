// Test nullptr in various initialization contexts
//
// Expected output: 0

struct Node {
    data: i32,
    next: Node*,
}

fn main() -> i32 {
    // Struct field initialization
    let n: Node;
    n.data = 42;
    n.next = nullptr;

    assert n.data == 42: "n.data should be 42";

    // Direct assignment
    let p: Node* = n.next;
    // p is nullptr, so p.data would crash — don't dereference

    return 0;
}
