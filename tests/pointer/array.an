// Test for pointer usage with arrays
//
// Expected output: 0

i32 main() {
    i32[10] arr
    for u64 i = 0; i < 10; i += 1 {
        arr[i] = i32(i)
    }

    i32* p = &arr[0]
    for u64 i = 0; i < 10; i += 1 {
        p[i] += 66
    }
    assert arr[0] == 66: "Expected 66"

    i32* begin = &arr[0]
    i32* end = begin + 10
    for i32* it = begin; it < end; it += 1 {
        *it += 1
    }
    assert arr[9] == 76: "Expected 76"

    return 0
}