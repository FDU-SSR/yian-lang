// Test for function pointers
//
// Expected output: 0

struct Person{
    pub i32 age
    pub i32 score
}

impl Person {
    pub i32 get_age() {
        return self.age
    }

    pub i32 get_score() {
        return self.score
    }
}


i32 add(i32 a, i32 b)
{
    return a + b
}

i32 sub(i32 a, i32 b){
    return a - b
}



Person make_person(i32 x, i32 y){
    return Person(x, y)
}

i32 accumulate(i32 a, i32 b, fn<i32(i32, i32)> func){
    i32 c = func(a, b)
    return c
}
struct table{
    fn<i32(i32, i32)> Add_pointer
    fn<i32(i32, i32)> Sub_pointer
}

i32 main()
{
    fn<i32(i32, i32)> add_func = &add
    fn<Person(i32, i32)> per_func = &make_person
    fn<i32(i32, i32)> sub_func = &sub

    table tb = table(add_func, sub_func)

    table* tb2 = &tb
    i32 i = (tb2.Add_pointer)(10, 2)

    i32 res = (tb.Add_pointer)(10, 2)
    i32 res2 = (tb.Sub_pointer)(3, 2)
    

    Person p = per_func(2, 3)
    i32 age = p.get_age()
    i32 score = p.get_score()

    i32 res3 = age + score
    i32 res4 = add_func(1, 2) //dsfgsdfgdsaf
    i32 d = p.age + p.score
    i32 g = accumulate(5, 9, add_func)
    i32 h = sub_func(5, 1)
    

    i32 checksum = res + res2 + res3 + res4 + d + g + h

    assert checksum == 44 : "fail"
    return 0
}
