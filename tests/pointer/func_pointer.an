// Test for function pointers
//
// Expected output: 0

struct Person{
    pub i32 age
    pub i32 score
}

impl Person {
    pub get_age() -> i32 {
        return self.age
    }

    pub get_score() -> i32 {
        return self.score
    }
}


add(i32 a, i32 b) -> i32
{
    return a + b
}

sub(i32 a, i32 b) -> i32{
    return a - b
}



make_person(i32 x, i32 y) -> Person {
    return Person(x, y)
}

accumulate(i32 a, i32 b, fn(i32, i32) -> i32 func) -> i32 {
    i32 c = func(a, b)
    return c
}
struct Table{
    fn(i32, i32) -> i32 Add_pointer
    fn(i32, i32) -> i32 Sub_pointer
}

main() -> i32
{
    fn(i32, i32) -> i32 add_func = &add
    fn(i32, i32) -> Person per_func = &make_person
    fn(i32, i32) -> i32 sub_func = &sub

    Table tb = Table(add_func, sub_func)

    Table* tb2 = &tb
    i32 i = (tb2.Add_pointer)(10, 2)

    i32 res = (tb.Add_pointer)(10, 2)
    i32 res2 = (tb.Sub_pointer)(3, 2)
    

    Person p = per_func(2, 3)
    i32 age = p.get_age()
    i32 score = p.get_score()

    i32 res3 = age + score
    i32 res4 = add_func(1, 2) //dsfgsdfgdsaf
    i32 d = p.age + p.score
    i32 g = accumulate(5, 9, add_func)
    i32 h = sub_func(5, 1)
    

    i32 checksum = res + res2 + res3 + res4 + d + g + h

    assert checksum == 44 : "fail"
    return 0
}
