// Test integer literal
//
// Expected output: 0

fn main() {
    let dec: i32 = 42;
    let hex: i32 = 0x2A;
    assert dec == hex: "dec != hex";
    let oct: i32 = 0o52;
    assert dec == oct: "dec != oct";
    let bin: i32 = 0b101010;
    assert dec == bin: "dec != bin";
    let byte: u8 = b'A';
    assert byte == 65: "byte != 65";
    let hex_byte: u8 = b'\x41';
    assert byte == hex_byte: "byte != hex_byte";

    let suffix: u32 = 0x2A_u32;
    assert suffix == u32(dec): "suffix != dec as u32";
    let underline: u64 = 1_000_000;
    assert underline == 1000000: "underline != 1000000";

}