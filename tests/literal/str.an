// Test string literal
//
// Expected output:
// Hello, World!
// 你好，世界！
// Line1
// Line2	Tabbed

from std.core.io import print;

fn main() -> i32 {
    let hello: str = "Hello, World!";
    print(hello);
    let chinese: str = "你好，世界！";
    print(chinese);
    let escape: str = "Line1\nLine2\tTabbed";
    print(escape);
    return 0;
}
