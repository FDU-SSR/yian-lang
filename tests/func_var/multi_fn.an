// Two distinct function variables, each carrying its own unique function type.
//
// Expected output: 0

fn add1(x: i32) -> i32 { return x + 1; }
fn dbl(x: i32) -> i32 { return x * 2; }

fn main() -> i32 {
    let f = add1;
    let g = dbl;
    assert f(10) == 11: "f dispatches to add1";
    assert g(10) == 20: "g dispatches to dbl";
    return 0;
}
