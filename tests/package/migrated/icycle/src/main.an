// Test circular import cycle handling
//
// ``a`` and ``b`` import from each other; the entry only imports ``a``,
// because an entry module can never be imported (AX014).
//
// Expected output: 0

from cyctest.a import Value, lib_unwrap_value;

fn main() {
    let v: Value<i32> = Value(42);
    let result: i32 = lib_unwrap_value(v);
    assert result == 42: "result should be 42";
}
