// Test string comparison operations
//
// Expected output: 0

fn main() -> i32 {
    let s1: str = "apple";
    let s2: str = "banana";
    let s3: str = "apple";

    assert s1 == s3: "s1 should be equal to s3";
    assert s1 != s2: "s1 should ! be equal to s2";
    assert s2 == "banana": "s2 should be equal to 'banana'";

    return 0;
}