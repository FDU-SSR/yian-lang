// Test string comparison operations
//
// Expected output: 0

main() -> i32 {
    str s1 = "apple"
    str s2 = "banana"
    str s3 = "apple"

    assert s1 == s3: "s1 should be equal to s3"
    assert s1 != s2: "s1 should not be equal to s2"
    assert s2 == "banana": "s2 should be equal to 'banana'"

    return 0
}