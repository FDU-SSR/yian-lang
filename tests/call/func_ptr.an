// Test function pointer assignment and invocation
//
// Expected output: 0

struct Person{
    pub i32 age
    pub i32 score
}

add(i32 a, i32 b) -> i32 {
    return a + b
}

make_person(i32 x, i32 y) -> Person {
    return Person(x, y)
}

main() -> i32 {
    fn(i32, i32) -> i32 add_func = &add
    fn(i32, i32) -> Person person_func = &make_person

    Person p = person_func(2, 3)
    assert p.age == 2 and p.score == 3: "person_func should return Person(2, 3)"
    
    assert add_func(1, 2) == 3: "add_func should return 3"
    
    return 0
}
