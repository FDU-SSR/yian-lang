// Test variant construction and pattern matching
//
// Expected output:
// Command is Start
// Hello

from std.core.io import print

enum Command {
    Start
    Stop
    Move {
        bool is_forward
        i32 distance
    }
    Speak {
        str message
    }
}

main() -> i32 {
    Command cmd1 = Command.Start
    Command cmd2 = Command.Move(true, 10)
    Command cmd3 = Command.Speak("Hello\n")

    match cmd1 {
        Start { print("Command is Start\n") }
        _ { panic("cmd1 should be Start") }
    }

    match cmd2 {
        Move(is_forward, distance) {
            assert is_forward == true: "Move is_forward should be true"
            assert distance == 10: "Move distance should be 10"
        }
        _ { panic("cmd2 should be Move") }
    }

    match cmd3 {
        Speak(message) { print(message) }
        _ { panic("cmd3 should be Speak") }
    }

    return 0
}