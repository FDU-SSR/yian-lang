// Test method calls
//
// Expected output: 0

struct Person {
    pub age: i32,
    pub weight: float,
}

impl Person {
    static pub fn new(age: i32, weight: float) -> Person {
        return Person(age, weight);
    }

    pub fn get_age() -> i32 {
        return self.age;
    }

    pub fn weight_gt(weight: float) -> bool {
        return self.weight > weight;
    }
}

fn main() -> i32 {
    let p: Person = Person.new(20, 65.5);
    assert p.age == 20 && p.weight > 65.0: "Person.new failed";

    let age: i32 = p.get_age();
    assert age == 20: "get_age method failed";

    if p.weight_gt(70.0) {
        panic("Weight comparison failed");
    }

    return 0;
}