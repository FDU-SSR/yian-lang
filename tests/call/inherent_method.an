// Test method calls
//
// Expected output: 0

struct Person {
    pub i32 age
    pub float weight
}

impl Person {
    static pub new(i32 age, float weight) -> Person {
        return Person(age, weight)
    }

    pub get_age() -> i32 {
        return self.age
    }

    pub weight_gt(float weight) -> bool {
        return self.weight > weight
    }
}

main() -> i32 {
    Person p = Person.new(20, 65.5)
    assert p.age == 20 and p.weight > 65.0: "Person.new failed"

    i32 age = p.get_age()
    assert age == 20: "get_age method failed"

    if p.weight_gt(70.0) {
        panic("Weight comparison failed")
    }

    return 0
}