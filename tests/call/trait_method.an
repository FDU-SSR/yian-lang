// Test trait method definitions and implementations
//
// Expected output: 0

trait Walkable {
    static pub walk_info() -> i32

    pub walk(i32 distance) -> i32
}

struct Dog {
    pub i32 age
}

impl Walkable for Dog {
    static pub walk_info() -> i32 {
        return 10
    }

    pub walk(i32 distance) -> i32 {
        return distance + self.age
    }
}

main() -> i32 {
    Dog d = Dog(5)

    assert Dog.walk_info() == 10: "Dog walk_info method failed"

    i32 total_distance = d.walk(10)
    assert total_distance == 15: "Dog walk method failed"

    return 0
}