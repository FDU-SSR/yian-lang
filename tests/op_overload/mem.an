// Test for operator overloading: Dereference operator
//
// Expected output: 0

from std.core.ops import Deref

struct Ptr<T> {
    pub T* ptr
}

impl<T> Deref<T> for Ptr<T> {
    deref() -> T* {
        return self.ptr
    }
}

main() -> i32 {
    i32 value = 42
    Ptr<i32> p = Ptr(&value)
    i32 p_val = *p

    assert p_val == 42: "Dereference failed"

    *p = 100
    assert value == 100: "Assignment through dereference failed"

    return 0
}