// Test comparison operator overload
//
// Expected output: 0

from std.core.ops import PartialEq, PartialOrd, Ordering

struct Value<T> {
    pub T value
}

impl<T> PartialEq<Value<T>> for Value<T> {
    bool eq(Self rhs) {
        return self.value == rhs.value
    }
}

impl<T> PartialOrd<Value<T>> for Value<T> {
    Ordering partial_cmp(Self rhs) {
        if self.value < rhs.value {
            return Ordering.Less
        } elif self.value > rhs.value {
            return Ordering.Greater
        } else {
            return Ordering.Equal
        }
    }
}

i32 main() {
    Value<i32> a = Value<i32>(5)
    Value<i32> b = Value<i32>(10)
    Value<i32> c = Value<i32>(5)

    // Test PartialEq
    assert a == c: "Expected a == c"
    assert a != b: "Expected a != b"

    // Test PartialOrd
    assert a < b: "Expected a < b"
    assert a <= c: "Expected a <= c"
    assert b > a: "Expected b > a"
    assert b >= c: "Expected b >= c"

    return 0
}