// Test arithmetic operator overloading
//
// Expected output: 0

from std.core.ops import Add, Sub, Mul, Div, Rem, Neg

struct Value<T> {
    pub T value
}

impl<T> Add<Value<T>, Value<T>> for Value<T> {
    Self add(Self rhs) {
        return Self(self.value + rhs.value)
    }
}

impl<T> Sub<Value<T>, Value<T>> for Value<T> {
    Self sub(Self rhs) {
        return Self(self.value - rhs.value)
    }
}

impl<T> Mul<Value<T>, Value<T>> for Value<T> {
    Self mul(Self rhs) {
        return Self(self.value * rhs.value)
    }
}

impl<T> Div<Value<T>, Value<T>> for Value<T> {
    Self div(Self rhs) {
        return Self(self.value / rhs.value)
    }
}

impl<T> Rem<Value<T>, Value<T>> for Value<T> {
    Self rem(Self rhs) {
        return Self(self.value % rhs.value)
    }
}

impl<T> Neg<Value<T>> for Value<T> {
    Self neg() {
        return Self(-self.value)
    }
}


i32 main() {
    Value<i32> a = Value<i32>(10)
    Value<i32> b = Value<i32>(20)

    assert (a + b).value == 30: "Expected 30"
    assert (b - a).value == 10: "Expected 10"
    assert (a * b).value == 200: "Expected 200"
    assert (b / a).value == 2: "Expected 2"
    assert (b % a).value == 0: "Expected 0"
    assert (-a).value == -10: "Expected -10"

    return 0
}