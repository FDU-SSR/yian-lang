from std.core.str import CharIter;
from std.core.option import Option;

fn main() -> i32 {
    // 1. Test from() and as_slice()
    // 'A', 'B', 'C' -> 65, 66, 67
    let arr: u8[3] = [65, 66, 67];
    let s: str = str.from(arr[0u64..3]);
    
    let s_slice: u8[] = s.as_slice();
    assert s_slice.len() == 3;
    assert s_slice[0] == 65;
    assert s_slice[1] == 66;
    assert s_slice[2] == 67;

    // 2. Test chars() iterator (ASCII)
    let iter: CharIter = s.chars();
    assert iter.next().unwrap() == 'A';
    assert iter.next().unwrap() == 'B';
    assert iter.next().unwrap() == 'C';
    assert iter.next().is_none();

    // 3. Test multi-byte chars (if supported by implementation)
    // UTF-8 for "中" (Chinese character for 'middle') is E4 B8 AD (228, 184, 173)
    let zhong_arr: u8[3] = [228, 184, 173];
    let s_zhong: str = str.from(zhong_arr[0u64..3]);
    let iter_zhong: CharIter = s_zhong.chars();
    
    // Assuming char type can hold unicode codepoint
    // '中' is U+4E2D (20013)
    // If str implementation supports it:
    let c_zhong: Option<char> = iter_zhong.next();
    assert c_zhong.is_some();
    // assert c_zhong.unwrap() == '中' // '中' literal might not work based on compiler support, prefer codepoint check if char is integer-like
    // or just rely on single char
    
    assert iter_zhong.next().is_none();

    // 4. Test slicing on UTF-8 character boundaries
    let nihao_arr: u8[6] = [228, 189, 160, 229, 165, 189];
    let s_nihao: str = str.from(nihao_arr[0u64..6]);
    let ni: str = s_nihao[0u64..3];
    let hao: str = s_nihao[3u64..6];

    assert ni.as_slice() == nihao_arr[0u64..3];
    assert hao.as_slice() == nihao_arr[3u64..6];
    assert s_nihao[0u64..6].as_slice() == nihao_arr[0u64..6];
    
    return 0;
}
