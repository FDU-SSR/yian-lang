// Test the Result type and its methods
//
// Expected output: 0

from std.core.result import Result
from std.core.option import Option

typedef ErrorCode = u64

main() -> i32 {
    // Create a Result with a value
    Result<i32, ErrorCode> res1 = Result<i32, ErrorCode>.Ok(42)
    Result<i32, ErrorCode> res2 = Result<i32, ErrorCode>.Err(1)
    assert res1.is_ok(): "res1 should be Ok"
    assert not res1.is_err(): "res1 should not be Err"
    assert not res2.is_ok(): "res2 should not be Ok"
    assert res2.is_err(): "res2 should be Err"

    // Unwrap with a default value
    assert res1.unwrap_or(100) == 42: "res1 should unwrap to 42"
    assert res2.unwrap_or(100) == 100: "res2 should unwrap to 100"

    // Unwrap the error code with a default value
    assert res1.unwrap_or_err(999) == 999: "res1 should unwrap to default error code 999"
    assert res2.unwrap_or_err(999) == 1: "res2 should unwrap to error code 1"

    // Convert to Option
    Option<i32> opt1 = res1.ok()
    Option<ErrorCode> opt2 = res2.err()
    assert opt1.is_some(): "opt1 should be Some"
    assert opt1.unwrap_or(0) == 42: "opt1 should unwrap to 42"
    assert opt2.is_some(): "opt2 should be Some"
    assert opt2.unwrap_or(0) == 1: "opt2 should unwrap to 1"

    // Clone res1
    Result<i32, ErrorCode> res3 = res1.clone()
    assert res3.is_ok(): "res3 should be Ok"
    assert res3.unwrap_or(0) == 42: "res3 should unwrap to 42"

    // Clone res2
    Result<i32, ErrorCode> res4 = res2.clone()
    assert res4.is_err(): "res4 should be Err"
    assert res4.unwrap_or_err(0) == 1: "res4 should unwrap to error code 1"

    return 0
}