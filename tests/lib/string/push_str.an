from std.core.string import String;
from std.core.io import print;

fn main() -> i32 {
    let s: String = String.from("Hello");
    s.push_str(", World!");
    assert s == "Hello, World!": "s should be 'Hello, World!'";

    s += " How are you?"
    assert s == "Hello, World! How are you?": "s should be 'Hello, World! How are you?'";

    return 0;
}