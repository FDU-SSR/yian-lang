// Test slice functionality
//
// Expected output: 0

from std.core.option import Option
from std.core.vec import Vec

main() -> i32 {
    i32[5] arr = [1, 2, 3, 4, 5]
    i32[] slice = arr[1u64..4] // This should be a slice containing [2, 3, 4]

    // Test length of the slice
    assert slice.len() == 3: "Expected slice length to be 3"

    // Test getting elements from the slice
    Option<i32> elem0 = slice.get(0)
    assert elem0.is_some() and elem0.unwrap_or(0) == 2: "Expected first element to be 2"
    Option<i32> elem1 = slice.get(3) // Out of bounds
    assert elem1.is_none(): "Expected out of bounds access to return None"

    // Test first and last elements
    Option<i32> first = slice.first()
    assert first.is_some() and first.unwrap_or(0) == 2: "Expected first element to be 2"
    Option<i32> last = slice.last()
    assert last.is_some() and last.unwrap_or(0) == 4: "Expected last element to be 4"

    // Test converting slice to Vec
    Vec<i32> vec = slice.to_vec()
    assert vec.len() == 3: "Expected Vec length to be 3"
    assert vec[0] == 2 and vec[1] == 3 and vec[2] == 4: "Expected Vec elements to be [2, 3, 4]"

    // Test iterating over the slice
    for i in slice {
        assert i >= 2 and i <= 4: "Expected slice elements to be between 2 and 4"
    }

    return 0
}