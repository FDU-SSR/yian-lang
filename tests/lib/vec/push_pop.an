// Test for Vec push and pop operations
//
// Expected output: 0

from std.core.vec import Vec;

fn main() -> i32 {
    let v: Vec<i32> = Vec<i32>.with_capacity(10);
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);

    let sum: i32 = 0;
    while v.len() > 0 {
        sum += v.pop().unwrap()
    }

    assert sum == 15: "Expected sum to be 15";

    return 0;
}