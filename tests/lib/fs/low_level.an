// Test low-level open/write/read/close
//
// Expected output: 0

fn main() -> i32 {
    // O_WRONLY | O_CREAT | O_TRUNC = 577
    let wfd: i32 = open("/tmp/yian_test_low.txt", 577);
    write(wfd, "low-level test");
    close(wfd);

    // Read it back with low-level read (O_RDONLY = 0)
    let rfd: i32 = open("/tmp/yian_test_low.txt", 0);
    let buf: u8[32];
    for i in 0u64..32 {
        buf[i] = 0
    }
    let result: str = read(rfd, buf);
    close(rfd);

    assert result == "low-level test": "low-level read should match low-level write";

    return 0;
}
