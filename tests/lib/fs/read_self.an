// Test read_file reading its own source
//
// Expected output: 0

from std.core.io import read_file;

fn main() -> i32 {
    let self_content: str = read_file("tests/lib/fs/read_self.an");
    assert self_content.starts_with("// Test read_file reading its own source"): "File content should start with expected string";

    return 0;
}
