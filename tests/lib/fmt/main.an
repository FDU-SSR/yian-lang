// Test for ToString implementations on basic types
//
// Expected output: 0

from std.core.fmt import ToString

i32 main() {
    // Unsigned integers
    u8 u8v = 255u8
    assert u8v.to_string() == "255": "u8 to_string failed"

    u16 u16v = 65535u16
    assert u16v.to_string() == "65535": "u16 to_string failed"

    u32 u32v = 4294967295u32
    assert u32v.to_string() == "4294967295": "u32 to_string failed"

    u64 u64v = 18446744073709551615u64
    assert u64v.to_string() == "18446744073709551615": "u64 to_string failed"

    // Signed integers
    i8 i8v = i8(-42)
    assert i8v.to_string() == "-42": "i8 to_string failed"

    i16 i16v = i16(-1234)
    assert i16v.to_string() == "-1234": "i16 to_string failed"

    i32 i32v = -123456
    assert i32v.to_string() == "-123456": "i32 to_string failed"

    i64 i64v = -1234567890123i64
    assert i64v.to_string() == "-1234567890123": "i64 to_string failed"

    // Floating-point
    f32 f32v = 1.25_f32
    assert f32v.to_string() == "1.25": "f32 to_string failed"

    f64 f64v = -3.5
    assert f64v.to_string() == "-3.5": "f64 to_string failed"

    f64 f64int = 10.0
    assert f64int.to_string() == "10": "f64 integer-like to_string failed"

    // bool
    bool b1 = true
    bool b2 = false
    assert b1.to_string() == "true": "true to_string failed"
    assert b2.to_string() == "false": "false to_string failed"

    // char
    char ch = 'A'
    assert ch.to_string() == "A": "char to_string failed"

    return 0
}
