// Test for basic enum and method functionality
//
// Expected output:
// Command: Start
// Command: Pause

from std.core.io import print

enum Command {
    Start
    Stop
    Pause {i32 duration}
}

impl Command {
    static pub new_start() -> Command {
        return Command.Start
    }

    static pub new_stop() -> Command {
        return Command.Stop
    }

    static pub new_pause(i32 duration) -> Command {
        return Command.Pause(duration)
    }

    pub execute() {
        match *self {
            Start { print("Command: Start\n") }
            Stop { print("Command: Stop\n") }
            Pause { print("Command: Pause\n") }
        }
    }
}

main() -> i32 {
    Command cmd1 = Command.new_start()
    Command cmd2 = Command.new_pause(10)

    cmd1.execute()
    cmd2.execute()

    return 0
}