// Test for basic enum and method functionality
//
// Expected output:
// Command: Start
// Command: Pause

from std.core.io import print;

enum Command {
    Start,
    Stop,
    Pause {
        duration: i32,
    },
}

impl Command {
    static pub fn new_start() -> Command {
        return Command.Start;
    }

    static pub fn new_stop() -> Command {
        return Command.Stop;
    }

    static pub fn new_pause(duration: i32) -> Command {
        return Command.Pause(duration);
    }

    pub fn execute() {
        match *self {
            Start => { print("Command: Start\n"); },
            Stop => { print("Command: Stop\n"); },
            Pause => { print("Command: Pause\n"); },
        }
    }
}

fn main() {
    let cmd1: Command = Command.new_start();
    let cmd2: Command = Command.new_pause(10);

    cmd1.execute();
    cmd2.execute();

}
