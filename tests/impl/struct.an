// Test for basic struct and method functionality
//
// Expected output: 0

struct Pair{
    a: i32,
    b: i32,
}

impl Pair{
    pub static fn new(a: i32, b: i32) -> Self {
        return Self(a = a, b = b);
    }

    pub fn sum() -> i32 {
        return self.a + self.b;
    }
}

fn main() {
    let p: Pair = Pair.new(3, 4);
    assert p.sum() == 7;
}