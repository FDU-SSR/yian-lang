// Test for basic struct and method functionality
//
// Expected output: 0

struct Pair{
    i32 a
    i32 b
}

impl Pair{
    pub static new(i32 a, i32 b) -> Self {
        return Self(a = a, b = b)
    }

    pub sum() -> i32 {
        return self.a + self.b
    }
}

main() -> i32 {
    Pair p = Pair.new(3, 4)
    assert p.sum() == 7
    return 0
}