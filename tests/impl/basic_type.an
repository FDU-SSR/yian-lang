// Test for general types (e.g., i32) and method functionality
//
// Expected output:
// Hello, Yian!

from std.core.io import print;

impl i32 {
    pub fn inc() {
        *self += 1
    }

    pub fn abs() -> i32 {
        if *self < 0 {
            return -*self;
        } else {
            return *self;
        }
    }
}

impl bool {
    pub fn toggle() -> bool {
        return ! *self;
    }
}

impl str {
    pub fn println() {
        print(*self);
        print("\n");
    }
}


fn main() {
    let a: i32 = -5;
    a.inc();
    assert a == -4;
    assert a.abs() == 4;

    let b: bool = true;
    b = b.toggle();
    assert b == false;

    let msg: str = "Hello, Yian!";
    msg.println();

}