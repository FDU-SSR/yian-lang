// Test for general types (e.g., i32) and method functionality
//
// Expected output: Hello, Yian!

impl i32 {
    pub inc() {
        *self += 1
    }

    pub i32 abs() {
        if *self < 0 {
            return -*self
        } else {
            return *self
        }
    }
}

impl bool {
    pub bool toggle() {
        return not *self
    }
}

impl str {
    pub println() {
        print(*self)
        print("\n")
    }
}


i32 main() {
    i32 a = -5
    a.inc()
    assert a == -4
    assert a.abs() == 4

    bool b = true
    b = b.toggle()
    assert b == false

    str msg = "Hello, Yian!"
    msg.println()

    return 0
}