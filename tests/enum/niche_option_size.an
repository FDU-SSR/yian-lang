// niche 优化布局尺寸断言:Option<指针族> 省略 i32 tag,布局 = payload 类型。
//
// 规则:enum 恰有 2 变体(1 无 payload + 1 指针族 payload,payload 穿透匿名
// 单字段 struct)时,全零编码 = None,尺寸等于 payload 类型本身。
//
// Expected output: (empty, exit 0)

fn main() {
    assert sizeof(Option<i32*>) == 40: "Option<i32*> = fat pointer 40B (was 44B with tag)";
    assert sizeof(Option<i32&>) == 24: "Option<i32&> = ref 24B (was 28B with tag)";
    assert sizeof(Option<i32[]>) == 32: "Option<i32[]> = slice 32B";
    assert sizeof(Option<str>) == 32: "Option<str> = str 32B";
    assert sizeof(Option<fn(i32) -> bool>) == 8: "Option<fnptr> = fn pointer 8B";
}
