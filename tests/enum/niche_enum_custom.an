// 自定义 niche enum(unit + 指针 payload)布局与行为,含声明顺序反向。
//
// 规则只要求「2 变体:1 unit + 1 指针族 payload」,与声明顺序无关:
// unit 变体编码为全零,payload 变体编码为 payload 值本身。
//
// Expected output: (empty, exit 0)

enum Link {
    Nil,
    Node { p: i32* },
}

// 声明顺序反向(unit 在后):仍命中 niche
enum Marker {
    Mark { p: i32* },
    Empty,
}

// slice payload 同样是指针族
enum Bytes {
    Missing,
    Present { s: u8[] },
}

fn main() {
    assert sizeof(Link) == 40: "Link = payload i32* 40B (no tag)";
    assert sizeof(Marker) == 40: "Marker = payload i32* 40B (unit declared second)";
    assert sizeof(Bytes) == 32: "Bytes = payload u8[] 32B";

    let arr = [3i32, 4];
    let p = arr.ptr();

    let node: Link = Link.Node(p);
    let nil: Link = Link.Nil;
    let v1: i32 = match node {
        Node(q) => q[0],
        Nil => -1,
    };
    assert v1 == 3: "Link.Node match";
    let v2: i32 = match nil {
        Node(q) => q[0],
        Nil => -2,
    };
    assert v2 == -2: "Link.Nil match (all-zero encoding)";

    // 反向声明:Mark(payload 在前)/Empty(unit 在后)
    let m: Marker = Marker.Mark(p);
    let e: Marker = Marker.Empty;
    let v3: i32 = match m {
        Mark(q) => q[0],
        Empty => -3,
    };
    assert v3 == 3: "Marker.Mark match";
    let v4: i32 = match e {
        Mark(q) => q[0],
        Empty => -4,
    };
    assert v4 == -4: "Marker.Empty match (unit encoded as zero)";

    // slice payload
    let sarr = [1u8, 2, 3];
    let s = sarr[0u64..3];
    let b: Bytes = Bytes.Present(s);
    let bm: Bytes = Bytes.Missing;
    let l1: u64 = match b {
        Present(sv) => sv.len(),
        Missing => 0,
    };
    assert l1 == 3: "Bytes.Present match";
    let l2: u64 = match bm {
        Present(sv) => sv.len(),
        Missing => 0,
    };
    assert l2 == 0: "Bytes.Missing match";
}
