// 未取址左值(普通变量赋值/读取/复合赋值)走裸指针路径。
//
// Expected output: 0

fn main() {
    let x: i32 = 1;
    x = x + 1;
    assert x == 2: "x should be 2 after assign";
    x += 10;
    assert x == 12: "x should be 12 after += 10";
    x -= 2;
    assert x == 10: "x should be 10 after -= 2";
    x *= 3;
    assert x == 30: "x should be 30 after *= 3";
    x /= 5;
    assert x == 6: "x should be 6 after /= 5";
    x %= 4;
    assert x == 2: "x should be 2 after %= 4";

    let y: u64 = 0;
    for i in 0..5u64 {
        y = y + i;
    }
    assert y == 10: "y should be 10 after loop reads/assigns";

    let b: bool = true;
    b = false;
    assert !b: "b should be false after raw assign";
}
