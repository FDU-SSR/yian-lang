// 裸数组 arr[i] 读写(含复合赋值与多维)+ 越界检查。
//
// Expected output: 0

fn main() {
    let arr: i32[3] = [1, 2, 3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    assert arr[0] == 10: "arr[0] should be 10";
    assert arr[1] == 20: "arr[1] should be 20";
    assert arr[2] == 30: "arr[2] should be 30";

    arr[0] += 5;
    assert arr[0] == 15: "arr[0] should be 15 after +=";
    arr[1] *= 2;
    assert arr[1] == 40: "arr[1] should be 40 after *=";

    let m: i32[2][2] = [[1, 2], [3, 4]];
    m[1][1] = 99;
    assert m[1][1] == 99: "m[1][1] should be 99";
    assert m[0][1] == 2: "m[0][1] should be 2";
    assert m[1][0] == 3: "m[1][0] should be 3";

    let t: i32 = arr[2];
    assert t == 30: "read bare element into var";
}
