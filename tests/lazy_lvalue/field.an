// lazy-lvalue-fat:结构体字段未取址左值(读写/复合赋值)走裸指针路径。
//
// Expected output: 0

struct Point {
    x: i32,
    y: i32,
}

fn main() {
    let p: Point = Point(1, 2);
    assert p.x == 1: "p.x should be 1";
    assert p.y == 2: "p.y should be 2";

    p.x = 10;
    assert p.x == 10: "p.x should be 10 after raw assign";
    p.x += 5;
    assert p.x == 15: "p.x should be 15 after +=";
    p.y = p.x + 1;
    assert p.y == 16: "p.y should be 16 after read-assign";

    p.y *= 2;
    assert p.y == 32: "p.y should be 32 after *=";
}
