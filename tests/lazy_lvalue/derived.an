// 胖派生左值(p.a、*p、胖基址 arr[i])保持胖指针 + 检查。
//
// Expected output: 0

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    pub fn sum() -> i32 {
        return self.x + self.y;
    }
}

fn main() {
    let p: Point = Point(1, 2);
    let pp: Point* = &p;

    pp.x = 10;
    assert p.x == 10: "pp.x = 10 should update p";
    pp.y += 5;
    assert p.y == 7: "p.y should be 7 after pp.y += 5";
    (*pp).x = 20;
    assert p.x == 20: "(*pp).x = 20 should update p";
    assert pp.sum() == 27: "method on fat-derived receiver";

    let q: i32 = 3;
    let pq: i32* = &q;
    *pq = 99;
    assert q == 99: "*pq write should update q";
    assert *pq == 99: "fat-derived read";

    let arr: i32[3] = [1, 2, 3];
    let base: i32* = &arr[0];
    base[1] = 50;
    assert arr[1] == 50: "arr[1] should be 50 after fat-base index write";
}
