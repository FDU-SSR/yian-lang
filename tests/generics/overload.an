// Test method overloading based on generics
//
// Expected output: 0

struct Value<T> {
    pub data: T,
}

trait Clone {
    fn clone() -> Self;
}

impl<T> Clone for Value<T> {
    fn clone() -> Self {
        return Self(data=self.data);
    }
}

fn main() -> i32 {
    let v1: Value<i32> = Value<i32>(data=42);
    let v2: Value<i32> = v1.clone();
    assert v2.data == 42: "Cloned value does ! match";

    let v3: Value<f64> = Value<f64>(data=3.14);
    let v4: Value<f64> = v3.clone();
    assert v4.data > 3.13 && v4.data < 3.15: "Cloned value does ! match";

    return 0;
}