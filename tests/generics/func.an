// Test generic functions
//
// Expected output: 0

T add<T>(T a, T b) {
    return a + b
}

T abs<T>(T a) {
    if (a < 0) {
        return -a
    }
    return a
}

i32 main() {
    // 1) explicit type arguments
    i32 x = add<i32>(10, 20)
    assert x == 30: "Expected 30"
    i32 y = abs<i32>(-5)
    assert y == 5: "Expected 5"

    // 2) type inference
    f64 m = add(1.5, 2.5)
    assert m > 3.9 and m < 4.1: "Expected 4.0"
    f64 n = abs(-3.2)
    assert n > 3.1 and n < 3.3: "Expected 3.2"

    return 0
}