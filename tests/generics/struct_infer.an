// Test struct generic type inference in various constructor forms
//
// Expected output: 0

struct Pair<T, U> {
    pub first: T,
    pub second: U,
}

fn main() {
    let a: i32 = 1;
    let b: i64 = 2;
    let p1: Pair<i32, i64> = Pair<i32, i64>(first=a, second=b)
    assert p1.first == 1 && p1.second == 2: "Expected Pair(1, 2)";

    let p2: Pair<i32, i64> = Pair<i32, i64>(a, b)
    assert p2.first == 1 && p2.second == 2: "Expected Pair(1, 2)";

    let p3: Pair<i32, i64> = Pair(a, b)
    assert p3.first == 1 && p3.second == 2: "Expected Pair(1, 2)";

}