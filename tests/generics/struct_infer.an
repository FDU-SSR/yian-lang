// Test struct generic type inference in various constructor forms
//
// Expected output: 0

struct Pair<T, U> {
    pub T first
    pub U second
}

main() -> i32 {
    i32 a = 1
    i64 b = 2
    Pair<i32, i64> p1 = Pair<i32, i64>(first=a, second=b)
    assert p1.first == 1 and p1.second == 2: "Expected Pair(1, 2)"

    Pair<i32, i64> p2 = Pair<i32, i64>(a, b)
    assert p2.first == 1 and p2.second == 2: "Expected Pair(1, 2)"

    Pair<i32, i64> p3 = Pair(a, b)
    assert p3.first == 1 and p3.second == 2: "Expected Pair(1, 2)"

    return 0
}