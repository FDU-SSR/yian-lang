// Test call chain with generics
//
// Expected output: 0

fn times_ten<T>(a: T) -> T {
    return times_five(a) + times_five(a);
}

fn times_five<T>(a: T) -> T {
    return times_two(a) + times_two(a) + a;
}

fn times_two<T>(a: T) -> T {
    return a + a;
}

fn main() {
    // 1) explicit type arguments
    let x: i32 = times_ten<i32>(3);
    assert x == 30: "Expected 30";
    let y: f64 = times_five<f64>(2.0);
    assert y > 9.9 && y < 10.1: "Expected 10.0";

    // 2) type inference
    let m: i32 = times_two(7);
    assert m == 14: "Expected 14";
    let n: f64 = times_ten(1.5);
    assert n > 14.9 && n < 15.1: "Expected 15.0";

}