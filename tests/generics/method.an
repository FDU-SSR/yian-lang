// Test methods with their own generic type parameters
//
// Expected output: 0

impl i32 {
    pub fn casted_add<U>(other: U) -> i32 {
        return *self + i32(other);
    }
}

trait CastedSubtract<T> {
    fn casted_subtract<U>(other: U) -> T;
}

impl CastedSubtract<i32> for i32 {
    fn casted_subtract<U>(other: U) -> i32 {
        return *self - i32(other);
    }
}


fn main() -> i32 {
    let a: i32 = 50;
    let b: i32 = a.casted_add<f64>(25.5);
    assert b == 75: "Expected casted_add result 75";
    let c: i32 = a.casted_add(20.5);
    assert c == 70: "Expected casted_add result 70";

    let d: i32 = a.casted_subtract<f64>(15.5);
    assert d == 35: "Expected casted_subtract result 35";
    let e: i32 = a.casted_subtract(10.5);
    assert e == 40: "Expected casted_subtract result 40";

    return 0;
}