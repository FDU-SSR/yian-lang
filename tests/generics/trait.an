// Test generic traits
//
// Expected output: 0

trait Summable<T> {
    sum(T other) -> T
    static zero() -> T
    zero_sum() -> T {
        return self.sum(Self.zero())
    }
}

struct Value<T> {
    pub T data
}

impl Summable<i32> for i32 {
    sum(i32 other) -> i32 {
        return *self + other
    }
    static zero() -> i32 {
        return 0
    }
}

impl Summable<f64> for f64 {
    sum(f64 other) -> f64 {
        return *self + other
    }
    static zero() -> f64 {
        return 0.0
    }
}

impl<T> Summable<Value<T>> for Value<T> {
    sum(Value<T> other) -> Value<T> {
        return Value<T>(data=self.data + other.data)
    }
    static zero() -> Value<T> {
        return Value<T>(data=T(0))
    }
}

main() -> i32 {
    i32 a = 10
    i32 b = 20
    i32 c = a.sum(b)
    assert c == 30: "Expected sum 30"
    assert i32.zero() == 0: "Expected zero 0"
    assert a.zero_sum() == 10: "Expected zero_sum 10"

    f64 x = 5.5
    f64 y = 2.2
    f64 z = x.sum(y)
    assert z > 7.6 and z < 7.8: "Expected sum ~7.7"
    assert f64.zero() > -0.1 and f64.zero() < 0.1: "Expected zero ~0.0"
    assert x.zero_sum() > 5.4 and x.zero_sum() < 5.6: "Expected zero_sum ~5.5"

    Value<i32> v = Value(data=15)
    Value<i32> w = v.sum(Value<i32>(data=25))
    assert w.data == 40: "Expected sum 40"
    assert Value<i32>.zero().data == 0: "Expected zero 0"
    assert v.zero_sum().data == 15: "Expected zero_sum 15"

    return 0
}