// Test for pointer circular dependencies between structs, this is allowed
//
// Expected output: 0

struct Node {
    i32 data
    Node* next
}

i32 main() {
    Node n
    n.data = 10
    n.next = &n

    assert n.data == 10: "n.data should be 10"
    assert n.next.data == 10: "n.next.data should be 10"

    return 0
}