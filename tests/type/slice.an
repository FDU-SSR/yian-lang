// Test slice types and their interactions.
//
// Expected output: 0

main() -> i32 {
    // create a slice from array/pointer
    i32[5] arr = [1, 2, 3, 4, 5]
    i32[] array_slice = arr[1u64..4]
    i32* heap_arr = dyn[5] i32
    heap_arr[0] = 10
    heap_arr[1] = 20
    heap_arr[2] = 30
    heap_arr[3] = 40
    heap_arr[4] = 50
    i32[] pointer_slice = heap_arr[0u64..3]

    // verify slice contents
    assert array_slice[0] == 2: "array_slice[0] should be 2"
    assert array_slice[1] == 3: "array_slice[1] should be 3"
    assert array_slice[2] == 4: "array_slice[2] should be 4"
    assert pointer_slice[0] == 10: "pointer_slice[0] should be 10"
    assert pointer_slice[1] == 20: "pointer_slice[1] should be 20"
    assert pointer_slice[2] == 30: "pointer_slice[2] should be 30"

    // create a slice from another slice
    i32[] sub_slice = array_slice[0u64..2]
    assert sub_slice[0] == 2: "sub_slice[0] should be 2"
    assert sub_slice[1] == 3: "sub_slice[1] should be 3"

    return 0
}