// typedef: alias to a named type — construct, field access, sizeof.
// Regression control for the typedef fix work.
// Expected output: (exit 0)

struct Vec2 { x: i32, y: i32 }
typedef Point = Vec2;
typedef Int = i64;

fn main() {
    let p: Point = Point(3, 4)
    assert p.x == 3: "alias-to-struct: construct + field access"
    let n: Int = 5
    assert sizeof(Int) == sizeof(i64): "alias-to-named: sizeof"
}
