// Test call chains across multiple structs and methods
//
// Expected output: 0

struct makef1 {}
struct makef2 {}

makef1 f() {
    return makef1()
}

impl makef1 {
    makef2 f1() {
        return makef2()
    }
}

impl makef2 {
    i32 f2() {
        return 5
    }
}

i32 main() {
    assert f().f1().f2() == 5: "call chain works"

    return 0
}