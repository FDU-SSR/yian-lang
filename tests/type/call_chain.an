// Test call chains across multiple structs and methods
//
// Expected output: 0

struct makef1 { a: i32 }
struct makef2 { b: i32 }

fn f() -> makef1 {
    return makef1(1);
}

impl makef1 {
    fn f1() -> makef2 {
        return makef2(2);
    }
}

impl makef2 {
    fn f2() -> i32 {
        return 5;
    }
}

fn main() {
    assert f().f1().f2() == 5: "call chain works";

}
