// Test call chains across multiple structs and methods
//
// Expected output: 0

struct makef1 {}
struct makef2 {}

f() -> makef1 {
    return makef1()
}

impl makef1 {
    f1() -> makef2 {
        return makef2()
    }
}

impl makef2 {
    f2() -> i32 {
        return 5
    }
}

main() -> i32 {
    assert f().f1().f2() == 5: "call chain works"

    return 0
}