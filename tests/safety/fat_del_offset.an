// Fat-pointer delete of an offset pointer — negative test
//
// delete 前提 is_raw(p):index 分量必须 p.index = 0(规则 3.6.2)。
// p + 1 产生的 q 携带 index = 1 → is_raw 拒 → llvm.trap → SIGILL → Exit code -4。

fn main() {
    let p: i32* = dyn[3] i32;
    let q: i32* = p + 1;
    del q  // is_raw 拒: index != 0 → trap
}
