// Fat-pointer double-free negative test (时序机制 建立的负例)
//
// 第二次 delete p 的四前提检查失败:首次 delete 已写锁槽 SENTINEL,live 键比较
// 失败 → fail-stop → Exit code 1(LLVM 层 运行期 safety error 语义)。

fn main() {
    let p: i32* = dyn[2] 0i32;
    del p;
    del p // double free: lock slot = SENTINEL → live 失败 → safety error
}
