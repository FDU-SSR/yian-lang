// Tiered-pointer 分级指针 (T[] 真锁): a slice view whose backing is freed traps
// on access. The slice carries the real heap lock of the `dyn` backing
// (表示层 真锁, not lit-lock); after `del p` the block-header lock slot is
// SENTINEL (规则 3.6.2 动作①). `s[0]` derives a T* (lock-inherited) and the
// deref live check fails → llvm.trap → SIGILL → Exit code -4.
//
// Expected exit code: -4

fn main() {
    let p: i32* = dyn[3] i32;
    p[0] = 1;
    let s: i32[] = p[0u64..3];  // slice view, 真锁继承
    del p;                      // backing freed → lock slot SENTINEL
    s[0] = 99                   // slice element access → live 失败 → trap
}
