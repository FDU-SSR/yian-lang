// Fat-pointer arithmetic underflow on a sub-slice (negative test, 指针算术检查优化, Metis H2)
//
// CheckElementArith(定义 13):0 ≤ index + offset ≤ size,u64 同型化(回绕检测
// + 上界比较)。子切片 q = p + 2(base.index = 2)再 q - 1:offset = u64(-1) =
// 2^64-1 ≥ 2^63(下溢偏移 = 极大无符号下标)→ u64 回绕检测 sum = 2 + (2^64-1)
// = 1 < index 2 → no_wrap 失败 → llvm.trap → Exit code -4。
// (旧 i128 sext 形式把 offset 误解为 -1,index 2 + (-1) = 1 ≥ 0 且 ≤ size 会
// 放行——本用例锁定 u64 索引语义的收紧修正。)

fn main() {
    let p: i32* = dyn[4] i32;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    let q: i32* = p + 2;   // 子切片:base.index = 2
    let r: i32* = q - 1;   // 下溢偏移:offset = u64(-1) ≥ 2^63 → 回绕 → trap
    assert false: "unreachable"
}
