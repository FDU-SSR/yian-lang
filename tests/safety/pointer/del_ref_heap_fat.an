// Deletion-view positive (b): single-element heap T&. let r:i32&=&p[0], where p=dyn[1] 0i32,
// gives data=lock_ptr+8. CheckDelete requires is_heap,
// live, and is_raw (RefType has no index; only data==lock_ptr+8 is checked), all satisfied,
// so del r releases the whole block. Reallocate afterward to verify heap stability.
//
// Expected output: 0

fn main() {
    let p: i32* = dyn[1] 0i32;
    p[0] = 7;
    let r: i32& = &p[0];
    assert *r == 7: "reads through heap reference";
    del r;

    // Reallocate after del; the new block is independently usable.
    let q: i32* = dyn[3] 0i32;
    q[0] = 1;
    q[2] = 3;
    assert q[0] + q[2] == 4: "heap stable after del ref";
    del q;
}
