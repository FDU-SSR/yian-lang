// del-view 正例(a):整块 T[] 切片放行。`let arr: i32[] = dyn[4] i32` 经
// T*→T[] 降级产生覆盖整个堆块的视图(data = lock_ptr+8,lo=0):CheckDelete
// 四前提 is_heap(p) ∧ live(p) ∧ is_raw(p) 全部满足(SliceType 无 index 分量,
// index==0 检查退化为恒真,仅查 data==lock_ptr+8)→ del arr 整块交还,
// 动作①锁槽写 SENTINEL + 动作②free(lock_ptr 寻址)。del 后重分配验证堆稳定。
//
// Expected output: 0

fn main() {
    let arr: i32[] = dyn[4] i32;
    assert arr.len() == 4: "whole-block view preserves element count";
    del arr;

    // del 后重分配:新块独立可用
    let q: i32* = dyn[2] i32;
    q[0] = 9;
    q[1] = 8;
    assert q[0] + q[1] == 17: "heap stable after del slice";
    del q;
}
