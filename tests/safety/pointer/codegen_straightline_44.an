// Regression for defect B: LLVM block-name runaway length.
//
// Each `t[i] = v` fat write inlines a guarded live check plus a safe-access
// check, each splitting the current LLVM block.  When the split base name is
// the (ever-growing) current block name, ~44 consecutive direct writes push a
// single label past 1024 chars, and llvmlite's asm parser (parse_assembly)
// truncates it — collapsing all subsequent blocks into one and failing
// verification with "Terminator found in the middle of a basic block!".
//
// 48 straight-line direct writes exercise that threshold with margin.
//
// Expected output: 0

fn main()
{
    let t: u64* = dyn[64] u64
    t[0] = 0
    t[1] = 1
    t[2] = 2
    t[3] = 3
    t[4] = 4
    t[5] = 5
    t[6] = 6
    t[7] = 7
    t[8] = 8
    t[9] = 9
    t[10] = 10
    t[11] = 11
    t[12] = 12
    t[13] = 13
    t[14] = 14
    t[15] = 15
    t[16] = 16
    t[17] = 17
    t[18] = 18
    t[19] = 19
    t[20] = 20
    t[21] = 21
    t[22] = 22
    t[23] = 23
    t[24] = 24
    t[25] = 25
    t[26] = 26
    t[27] = 27
    t[28] = 28
    t[29] = 29
    t[30] = 30
    t[31] = 31
    t[32] = 32
    t[33] = 33
    t[34] = 34
    t[35] = 35
    t[36] = 36
    t[37] = 37
    t[38] = 38
    t[39] = 39
    t[40] = 40
    t[41] = 41
    t[42] = 42
    t[43] = 43
    t[44] = 44
    t[45] = 45
    t[46] = 46
    t[47] = 47

    assert t[0] == 0: "Expected t[0] to be 0"
    assert t[23] == 23: "Expected t[23] to be 23"
    assert t[47] == 47: "Expected t[47] to be 47"
}
