// A callee returns a reference to its own logical frame.  Inlining must keep
// the independent frame exit so the later access still reports S003.
// The caller stays large enough for the bounded inliner to select this callee.

fn escape() -> i32& {
    let value: i32 = 7;
    return &value;
}

fn main() {
    let a0: i32 = 1;
    let a1: i32 = a0 + 2;
    let a2: i32 = a1 + 3;
    let a3: i32 = a2 + 4;
    let a4: i32 = a3 + 5;
    let a5: i32 = a4 + 6;
    let a6: i32 = a5 + 7;
    let a7: i32 = a6 + 8;
    let a8: i32 = a7 + 9;
    let a9: i32 = a8 + 10;
    let r: i32& = escape();
    let x: i32 = *r;
    assert x == 7: "escaped local reference must fail";
    assert a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 > 0: "keep";
}
