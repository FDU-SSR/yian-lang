// Reassigning the range-loop index does not bypass the four-element slice
// bounds check; the out-of-range write triggers a runtime safety error.

fn main() {
    let p: i32* = dyn[4] 0i32;
    p[0] = 0;
    p[1] = 0;
    p[2] = 0;
    p[3] = 0;
    let s: i32[] = p[0u64..4];
    let total: i32 = 0;
    for i in 0..4u64 {
        i = 1000;
        s[i] = 42; // Out-of-range write; runtime safety error.
        total += 0;
    }
    assert total == 0: "unreachable";
}
