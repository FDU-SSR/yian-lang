// A released block may be reused, but the old view must still fail its
// lock/key check at the public print boundary.

from std.core.io import print;

fn main() {
    let old: u8* = dyn[4] 0u8;
    old[0] = 65u8;
    old[1] = 66u8;
    old[2] = 67u8;
    old[3] = 10u8;
    let stale: str = str.from(&old[0u64..4]);
    del old;

    let replacement: u8* = dyn[4] 0u8;
    replacement[0] = 88u8;
    print(stale);
}
