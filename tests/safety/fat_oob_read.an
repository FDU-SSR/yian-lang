// Fat-pointer out-of-bounds READ negative test (胖指针表示, 规则 3.2.1)
//
// 读方向越界:r[4] 对 size 4 的缓冲,index 4 + 1 > size 4 → safe_access(p,1)
// 的 in_bounds 子条件失败 → llvm.trap → SIGILL → Exit code -4。
// (对照既有 safety_oob_ptr.an 的写方向 r[4] = 99。)

fn main() {
    let r: i32* = dyn[4] i32;
    r[0] = 1;
    r[1] = 2;
    r[2] = 3;
    r[3] = 4;

    let v: i32 = r[4];  // OOB read: index 4 + 1 > size 4 → in_bounds 失败 → trap
    assert v == 5: "unreachable"
}
