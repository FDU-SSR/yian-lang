// File.write must validate a stale str before entering the write syscall.

from std.core.io import File, OpenMode;

fn main() {
    let file = File.open("/tmp/yian_stale_file_write.txt", OpenMode.Write).unwrap();
    let bytes: u8* = dyn[4] u8;
    bytes[0] = 65u8;
    bytes[1] = 66u8;
    bytes[2] = 67u8;
    bytes[3] = 10u8;
    let stale: str = str.from(&bytes[0u64..4]);
    del bytes;
    file.write(stale);
}
