// Multi-return callee: every return edge merges into one continuation value.
// The caller is large enough for the bounded inliner to clone the callee.

fn choose(x: i32) -> i32 {
    if x > 0 {
        return x + 1;
    }
    return x - 1;
}

fn main() {
    let a0: i32 = 1;
    let a1: i32 = a0 + 2;
    let a2: i32 = a1 + 3;
    let a3: i32 = a2 + 4;
    let a4: i32 = a3 + 5;
    let a5: i32 = a4 + 6;
    let a6: i32 = a5 + 7;
    let a7: i32 = a6 + 8;
    let a8: i32 = a7 + 9;
    let a9: i32 = a8 + 10;
    assert choose(3) == 4: "positive branch";
    assert choose(0) == -1: "zero branch";
    assert choose(-3) == -4: "negative branch";
    assert a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 > 0: "keep";
    @print("inline-control pass\n");
}
