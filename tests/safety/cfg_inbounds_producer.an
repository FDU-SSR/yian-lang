// Producer chains prove field bounds without a retained InBounds check.
// The loaded pointer at the end must keep its own check.

struct Node {
    value: i32,
    next: Option<Node*>,
}

fn main() {
    assert (dyn Node(3, Option<Node*>.None)).value == 3: "direct alloc field"

    let a: Node* = dyn Node(7, Option<Node*>.None)
    assert a.value == 7: "alloc field"

    let b: Node = Node(9, Option<Node*>.Some(a))
    let p: Node* = &b
    assert p.value == 9: "cast field"
    assert p.next.unwrap().value == 7: "loaded field"

    let arr: Node[2] = [Node(1, Option<Node*>.None), Node(2, Option<Node*>.None)]
    let e: Node* = &arr[1]
    assert e.value == 2: "index field"

    let q: Node* = *p.next.unwrap()
    assert q.value == 7: "loaded pointer"
    @print("inbounds-producer pass\n");
}
