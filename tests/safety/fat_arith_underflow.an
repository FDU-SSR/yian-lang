// Fat-pointer arithmetic underflow negative test.
//
// CheckElementArith:0 ≤ index + offset ≤ size。
// p-1: offset -1 makes index negative, violating arithmetic validity and exiting with code 1.

fn main() {
    let p: i32* = dyn[4] 0i32;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    let q: i32* = p - 1; // Index zero minus one is negative, failing CheckElementArith with a safety error.
    assert false: "unreachable"
}
