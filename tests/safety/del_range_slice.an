// Deletion-view negative (c): range views with lo!=0 fail. del p[1u64..4] creates
// an i32[] view of p[1..3], with data=lock_ptr+8+4,lo=1; the delete root check
// requires data==lock_ptr+8. SliceType has no index, so the offset is encoded in
// data, causing termination with exit code 1. Root-start views may be deleted at
// any extent; offset views fail.
//
// Expected exit code: 1

fn main() {
    let p: i32* = dyn[4] 0i32;
    del p[1u64..4];
}
