// File.read must validate a stale slice before entering the read syscall.

from std.core.io import File, OpenMode;

fn main() {
    let file = File.open("/dev/null", OpenMode.Read).unwrap();
    let bytes: u8* = dyn[4] u8;
    let stale: u8[] = bytes[0u64..4];
    del bytes;
    file.read(stale);
}
