fn strcat(char* dest, char* src) -> char* {
  let p: char* = dest
  while *p != '\0' {
    p += 1
  }
  while *src != '\0' {
    *p = *src
    p += 1
    src += 1
  }
  *p = '\0'
  return dest
}

fn ec_glob(char* pattern) -> i32 {
  let c: char*;
  let pcre_str: char* = dyn char[80]
  *pcre_str = '^'
  let p_pcre: char*;
  let pcre_str_end: char*;
  p_pcre = pcre_str + 1
  pcre_str_end = pcre_str + 80
  let offset: u32 = 0
  for c = pattern; *c != '\0'; c += 1 {
    match *c {
    '?':
        let string_len: u32 = 4
        if offset + string_len >= 80 {
            return 0
        }
        strcat((p_pcre + offset), "[^/]")
        offset += string_len
    _:
      *(p_pcre + offset) = *c // Problem: copy of pattern characters into pcre_str without bound checking leads to overflow of pcre_str buffer
      offset += 1
    }
  }
  return i32(offset)
}

fn main() {
  return ec_glob("???????????????????aaaaaaaaaaa")
}