struct iovec {
    iov_len: i32,
}
fn vq_getchain(iovec* iov) -> i32 {
    let i: i32 = 0
    for ; i < 32; i+=1 {
        // i32 iov_len = rand() % 10
        let iov_len: i32 = 9
        if iov_len == 9 {
            return -1
        }
        iov[i].iov_len = iov_len
    }
    return i
}
fn iovec_pull(iovec** iov, i32 iov_len, i32* result) -> i32 {
    *result = 0
    while iov_len != 0{
        *result += (*iov)[0].iov_len
        iov_len -= 1
        *iov = *iov + 1
    }
    return 0
}
fn main() {
    i32 iov_len, result
    let iov_array: iovec[32];
    iovec *iov = iov_array
    iov_len = vq_getchain(iov)
    fn iovec_pull(&iov, iov_len, &result)
    return 0
}