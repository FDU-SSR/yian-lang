// Fat-pointer multi-element out-of-bounds access negative test.
//
// Pair contains two fields; dyn[2] Pair admits indices zero and one.
// First fill p[1].y in bounds; p[2].y accesses beyond the two-element allocation,
// where index 2+1>size 2 fails in_bounds with a safety error.
// Expect exit code 1.

struct Pair {
    x: i32,
    y: i32,
}

fn main() {
    let p: Pair* = dyn[2] Pair(0, 0);
    p[0].x = 1;
    p[0].y = 2;
    p[1].x = 3;
    p[1].y = 4;

    let ok: i32 = p[1].y; // In bounds: index 1+1==size 2 passes.
    assert ok == 4: "expected p[1].y == 4";

    let v: i32 = p[2].y; // Past the end: index 2+1>size 2 fails in_bounds with a safety error.
    assert v == 0: "unreachable"
}
