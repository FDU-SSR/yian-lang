// read_file must retain the common open boundary for a stale path.

from std.core.io import read_file;

fn main() {
    let bytes: u8* = dyn[4] u8;
    bytes[0] = 47u8;
    bytes[1] = 116u8;
    bytes[2] = 109u8;
    bytes[3] = 112u8;
    let path: str = str.from(&bytes[0u64..4]);
    del bytes;
    read_file(path);
}
