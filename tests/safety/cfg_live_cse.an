// Stable reads reuse one live fact; a pure allocation does not invalidate it.
// Reading a different index uses the same word but keeps its own bounds check.

fn main() {
    let p: i32* = dyn[4] 0i32;
    p[0] = 1;
    p[1] = 2;
    p[2] = 3;
    p[3] = 4;

    let q: i32* = p;
    let a: i32 = *q;
    let b: i32 = *q;
    let spare: i32* = dyn[2] 9i32;
    let c: i32 = p[2];
    let d: i32 = *q;
    assert a + b + c + d == 1 + 1 + 3 + 1: "stable reads";

    del p;
    let s: i32* = dyn[2] 5i32;
    let e: i32 = *s;
    assert e == 5: "new allocation after release";
    assert spare[1] == 9: "independent allocation";
    @print("live-cse pass\n");
}
