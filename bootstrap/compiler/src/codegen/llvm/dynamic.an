from compiler.codegen.llvm.module import LlvmLowering, FunctionLowering;
from compiler.codegen.cfg.ids import ValueId;
from compiler.codegen.error import CodegenError;
from compiler.analysis.ty.callable import store_signature;
from compiler.analysis.ty.trait_object import store_object_methods;
from compiler.common.ids import TypeId;
from compiler.codegen.abi.runtime import ENV_WORD;
from llvm.object import Function;
from llvm.ir import IrValue;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.hash import Hash, Murmur3Hasher;
from std.core.fmt import ToString;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index, PartialEq;
from std.core.option import Option;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;

pub struct ThunkKey {
    pub implementation: TypeId,
    pub object: TypeId,
}

impl PartialEq<ThunkKey> for ThunkKey {
    pub fn eq(other: ThunkKey&) -> bool {
        self.implementation == other.implementation && self.object == other.object
    }
}

impl Hash<Murmur3Hasher> for ThunkKey {
    pub fn hash(hasher: Murmur3Hasher&) {
        self.implementation.hash(hasher);
        self.object.hash(hasher);
    }
}

impl LlvmLowering {
    // One thunk adapts the uniform object receiver to the implementation's concrete reference ABI.
    pub fn object_thunk(object_type: TypeId, implementation: TypeId) -> Result<Function, CodegenError> {
        let key = ThunkKey(implementation, object_type);
        match self.thunks.get(&key) { Some(value) => return Result<Function, CodegenError>.Ok(*value), None => {}, }
        let builder = self.module.builder();
        let original = builder.insertion_block();
        let name = String.from(&"yian.thunk.");
        defer name.drop();
        let method_number = implementation.index.to_string();
        defer method_number.drop();
        let object_number = object_type.index.to_string();
        defer object_number.drop();
        name.push_str(method_number.as_str());
        name.push('.');
        name.push_str(object_number.as_str());
        let signature = self.types.dynamic_signature(object_type, implementation)?;
        let thunk = self.module.add_function(name.as_str(), signature);
        thunk.set_internal_linkage();
        self.thunks.insert(key, thunk);
        builder.position_at_end(thunk.append_block("entry"));
        defer builder.position_at_end(original);
        let callable = self.types.signature(implementation)?;

        let arguments = Vec<IrValue>.new();
        defer arguments.drop();
        let receiver = match callable.receiver {
            Some(value) => value,
            None => return Result<Function, CodegenError>.Err(CodegenError.invalid("dynamic implementation has no receiver")),
        };
        if !self.types.is_zst(receiver)? {
            let data = builder.extract_value(thunk.param(0u32), 0u32, "");
            let reference = data;
            if !self.types.raw_pointers() {
                let reference_type = self.session.types.reference(receiver);
                reference = builder.insert_value(self.module.undef_value(self.types.value_type(reference_type)?), data, 0u32, "");
                reference = builder.insert_value(reference, builder.extract_value(thunk.param(0u32), 1u32, ""), 1u32, "");
            }
            arguments.push(reference);
        }
        let parameter = 1u32;
        for value in callable.parameters {
            if !self.types.is_zst(value.type_id)? {
                arguments.push(thunk.param(parameter));
                parameter += 1u32;
            }
        }
        let result = builder.call(self.types.function_type(implementation)?, self.declare(implementation)?.value(), arguments.as_slice(), "");
        if self.types.is_zst(callable.result)? { builder.ret_void(); } else { builder.ret(result); }
        Result<Function, CodegenError>.Ok(thunk)
    }
}

impl FunctionLowering {
    pub fn trait_object(type_id: TypeId, source: ValueId, methods: Vec<TypeId>&) -> Result<IrValue, CodegenError> {
        let module = self.owner.module;
        let slots = Vec<IrValue>.new();
        defer slots.drop();
        for method in *methods { slots.push(self.owner.object_thunk(type_id, *method)?.value()); }
        let table_type = module.array_type(module.pointer_type(0u32), slots.len());
        let table = module.add_global("", table_type);
        table.set_initializer(module.const_array(module.pointer_type(0u32), slots.as_slice()));
        table.set_constant(true);
        table.set_private_linkage();
        let data = if self.owner.types.is_zst(self.cfg.value(source)?.type_id)? {
            module.const_null(module.pointer_type(0u32))
        } else { self.memory_address(self.cfg.value(source)?.type_id, self.get(source)?)? };
        let object = self.builder.insert_value(module.undef_value(self.owner.types.value_type(type_id)?), data, 0u32, "");
        let table_index = 1u32;
        if !self.owner.types.raw_pointers() {
            let word = if self.owner.types.is_zst(self.cfg.value(source)?.type_id)? { self.integer(ENV_WORD) } else { self.pointer_word(self.cfg.value(source)?.type_id, self.get(source)?)? };
            object = self.builder.insert_value(object, word, 1u32, "");
            table_index = 2u32;
        }
        Result<IrValue, CodegenError>.Ok(self.builder.insert_value(object, table.value(), table_index, ""))
    }

    pub fn dynamic_call(type_id: TypeId, receiver: ValueId, method: TypeId, slot: u64, args: Vec<ValueId>&)
    -> Result<IrValue, CodegenError> {
        let module = self.owner.module;
        let object_type = self.cfg.value(receiver)?.type_id;
        let trait_type = match self.owner.session.types.require(object_type)? {
            TraitObject(trait_type) => *trait_type,
            _ => return Result<IrValue, CodegenError>.Err(CodegenError.invalid("dynamic call has no trait identity")),
        };
        let methods = store_object_methods(&self.owner.session.types, trait_type)?;
        defer methods.drop();
        if slot >= methods.len() || methods[slot] != method {
            return Result<IrValue, CodegenError>.Err(CodegenError.invalid("dynamic call slot has an inconsistent signature"));
        }
        let object = self.get(receiver)?;
        if !self.owner.types.raw_pointers() {
            self.checked(self.live(self.builder.extract_value(object, 1u32, ""), "S003")?, "S003")?;
        }
        let table = self.builder.extract_value(object, if self.owner.types.raw_pointers() { 1u32 } else { 2u32 }, "");
        let indices = [module.const_int(module.int_type(64u32), slot)];
        let pointer = self.builder.gep(module.pointer_type(0u32), table, indices.as_slice(), false, "");
        let called = self.builder.load(module.pointer_type(0u32), pointer, "");
        let arguments = Vec<IrValue>.new();
        defer arguments.drop();
        arguments.push(object);
        for argument in *args {
            if !self.owner.types.is_zst(self.cfg.value(*argument)?.type_id)? { arguments.push(self.get(*argument)?); }
        }
        let result = self.builder.call(self.owner.types.dynamic_signature(object_type, method)?, called, arguments.as_slice(), "");
        Result<IrValue, CodegenError>.Ok(if self.owner.types.is_zst(type_id)? {
                module.const_null(self.owner.types.value_type(type_id)?)
            } else { result })
    }
}
