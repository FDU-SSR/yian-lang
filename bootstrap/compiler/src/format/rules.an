from compiler.frontend.lex.token import Token, PunctuatorKind, KeywordKind;
from std.core.ops import Index;
from std.core.vec import Vec;

pub fn operand_keyword(token: Token&) -> bool {
    match token.kind() {
        Keyword(kind) => match kind { Return | Let | In | Assert | Defer | If | Elif | While | Else | Match => true, _ => false, },
        _ => false,
    }
}

pub fn word(token: Token&) -> bool {
    match token.kind() { Punctuator(_) | EndOfFile | FStrExprBegin | FStrExprEnd => false, _ => true, }
}

pub fn closer(token: Token&) -> bool {
    match token.kind() { Punctuator(kind) => match kind { RParen | RBracket | RBrace | RAngle | Question => true, _ => false, }, _ => false, }
}

pub fn ends_operand(token: Token&) -> bool {
    if token.is_keyword_token() { return !operand_keyword(token) && !token.is_keyword(KeywordKind.Dyn); }
    word(token) || closer(token)
}

pub fn prefix(token: Token&, tokens: Vec<Token>&, index: u64) -> bool {
    let operator = match token.kind() {
        Punctuator(kind) => match kind { Star | Ampersand | Minus | Plus | Exclamation | Tilde => true, _ => false, },
        _ => false,
    };
    if !operator || index == 0 { return operator; }
    let previous = &tokens[index - 1];
    if previous.is_keyword_token() { return operand_keyword(previous); }
    !word(previous) && !closer(previous)
}

pub fn closes_type(tokens: Vec<Token>&, index: u64, count: u64) -> bool {
    let probe = index;
    while probe < count && (tokens[probe].is_punct(PunctuatorKind.Star) || tokens[probe].is_punct(PunctuatorKind.Ampersand)) { probe += 1; }
    if probe == count { return true; }
    match tokens[probe].kind() {
        Punctuator(kind) => match kind { Comma | RParen | RBracket | RBrace | Equal | Semicolon | LBrace | LBracket | Colon | RAngle => true, _ => false, },
        _ => false,
    }
}

pub fn hug_before(token: Token&) -> bool {
    match token.kind() { Punctuator(kind) => match kind { Comma | Semicolon | RParen | RBracket | Dot | Colon | Question => true, _ => false, }, _ => false, }
}

pub fn hug_after(token: Token&) -> bool {
    match token.kind() { Punctuator(kind) => match kind { LParen | LBracket | Dot | At | Tilde => true, _ => false, }, _ => false, }
}

pub fn binary(token: Token&) -> bool {
    match token.kind() {
        Punctuator(kind) => match kind {
            Equal | EqualEqual | NotEqual | Less | Greater | LessEqual | GreaterEqual | Slash | Percent | Caret |
            AmpersandAmpersand | PipePipe | Pipe | PlusEqual | MinusEqual | StarEqual | SlashEqual | PercentEqual |
            CaretEqual | AmpersandEqual | PipeEqual | LessLess | GreaterGreater | LessLessEqual | GreaterGreaterEqual | Arrow | FatArrow => true,
            _ => false,
        },
        _ => false,
    }
}

pub fn paren_space(token: Token&) -> bool {
    match token.kind() { Keyword(kind) => match kind { If | Elif | While | For | Return | Assert | Defer | In | Match | Else => true, _ => false, }, _ => false, }
}

pub fn bracket_hugs(token: Token&, postfix: bool) -> bool {
    if postfix { return true; }
    if token.is_keyword_token() { return !operand_keyword(token); }
    if word(token) { return true; }
    match token.kind() { Punctuator(kind) => match kind { Exclamation | Question | RParen | RBracket | RBrace | RAngle | LParen | LBracket => true, _ => false, }, _ => false, }
}
