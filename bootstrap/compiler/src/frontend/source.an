from std.core.convert import From;
from std.core.drop import Drop;
from std.core.fs import Directory, DirEntryKind, metadata, read_to_string;
from std.core.io import IoError, IoErrorKind;
from std.core.ops import Add, AddAssign, Index;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;
from json.write import Writer;

pub struct Position {
    pub row: u64,
    pub column: u64,
}

pub struct Span {
    pub start: Position,
    pub end: Position,
}

impl Span {
    // Writes source coordinates as fields in an open JSON object.
    pub fn write_json(output: Writer&) {
        output.key("start"); output.begin_array();
        output.write_u64(self.start.row); output.write_u64(self.start.column);
        output.end_array();
        output.key("end"); output.begin_array();
        output.write_u64(self.end.row); output.write_u64(self.end.column);
        output.end_array();
    }
}

impl Add<Span, Span> for Span {
    pub fn add(other: Span) -> Span {
        let start = self.start;
        if other.start.row < start.row ||
            (other.start.row == start.row && other.start.column < start.column) {
            start = other.start;
        }
        let end = self.end;
        if other.end.row > end.row ||
            (other.end.row == end.row && other.end.column > end.column) {
            end = other.end;
        }
        return Span(start=start, end=end);
    }
}

impl AddAssign<Span, Span> for Span {
    pub fn add_assign(other: Span) -> Span {
        let merged = *self + other;
        self.start = merged.start;
        self.end = merged.end;
        return *self;
    }
}

pub struct SourceFile {
    path: String,
    text: String,
}

impl SourceFile {
    pub fn path() -> str { return self.path.as_str(); }
    pub fn text() -> str { return self.text.as_str(); }
}

impl Drop for SourceFile {
    pub fn drop() {
        self.path.drop();
        self.text.drop();
    }
}

pub struct SourceManager {
    files: Vec<SourceFile>,
}

impl SourceManager {
    static pub fn new() -> Self { return Self(files=Vec<SourceFile>.new()); }

    pub fn len() -> u64 { return self.files.len(); }
    pub fn file(id: u64) -> SourceFile& { return &self.files[id]; }

    pub fn load(path: str) -> Result<u64, IoError> {
        let text = read_to_string(path)?;
        let id = self.files.len();
        self.files.push(SourceFile(path=String.from(&path), text=text));
        Result<u64, IoError>.Ok(val=id)
    }
}

impl Drop for SourceManager {
    pub fn drop() {
        let index: u64 = 0u64;
        while index < self.files.len() {
            self.files[index].drop();
            index += 1u64;
        }
        self.files.drop();
    }
}

fn less(left: str, right: str) -> bool {
    let a = left.as_slice();
    let b = right.as_slice();
    let limit = a.len();
    if b.len() < limit { limit = b.len(); }
    let index: u64 = 0u64;
    while index < limit {
        if a[index] < b[index] { return true; }
        if a[index] > b[index] { return false; }
        index += 1u64;
    }
    return a.len() < b.len();
}

fn sort_paths(paths: Vec<String>&, start: u64) {
    let index = start + 1u64;
    while index < paths.len() {
        let current = paths[index];
        let before = index;
        while before > start && less(current.as_str(), paths[before - 1u64].as_str()) {
            paths[before] = paths[before - 1u64];
            before -= 1u64;
        }
        paths[before] = current;
        index += 1u64;
    }
}

fn collect_dir(path: str, paths: Vec<String>&) -> Result<(), IoError> {
    let directory = Directory.open(path)?;
    defer directory.drop();
    loop {
        let entry = match directory.next()? {
            Some(value) => value,
            None => { break; },
        };
        defer entry.drop();
        let child = entry.path().as_str();
        let kind = entry.kind();
        if kind == DirEntryKind.Directory {
            collect_dir(child, paths)?;
        } elif kind == DirEntryKind.File {
            if entry.name().ends_with(".an") { paths.push(String.from(&child)); }
        } elif kind == DirEntryKind.Link {
            let info = entry.metadata()?;
            if info.is_file() && entry.name().ends_with(".an") { paths.push(String.from(&child)); }
        }
    }
    Result<(), IoError>.Ok(val=())
}

fn release_paths(paths: Vec<String>&) {
    let index = 0u64;
    while index < paths.len() { paths[index].drop(); index += 1u64; }
    paths.drop();
}

// Roots retain command-line order; files within each directory are sorted.
pub fn collect_sources(inputs: Vec<String>&) -> Result<Vec<String>, IoError> {
    let paths = Vec<String>.new();
    let transferred = false;
    defer { if !transferred { release_paths(&paths); } };
    let index = 0u64;
    while index < inputs.len() {
        let root = inputs[index].as_str();
        let info = metadata(root)?;
        if info.is_dir() {
            let start = paths.len();
            collect_dir(root, &paths)?;
            sort_paths(&paths, start);
        } elif info.is_file() {
            if root.ends_with(".an") { paths.push(String.from(&root)); }
        } else {
            let error = IoError.new(IoErrorKind.InvalidInput, "source path is not a file or directory");
            let contextual = error.with_path(root);
            error.drop();
            return Result<Vec<String>, IoError>.Err(msg=contextual);
        }
        index += 1u64;
    }
    transferred = true;
    Result<Vec<String>, IoError>.Ok(val=paths)
}
