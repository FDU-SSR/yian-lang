from compiler.frontend.ast.arena import AstArena, AstTree;
from compiler.frontend.ast.node import Identifier, IdentifierData, Expr, ExprData, Block, BlockData, Pattern, PatternData, PatternLet, PatternLetData, Parameter, VarInfoData, TypeSyntax, TypeData, Condition, ElifBranch, MatchArm, MatchArmData, PatternArguments, Argument, ArgumentData, StrLiteralData, Literal, Item, MethodDef;
from compiler.frontend.ast.operator import BinaryOperator, UnaryOperator;
from compiler.frontend.ast.atoms import BuiltinKind, MatchArmOrigin;
from compiler.frontend.ast.traversal import AstVisitor, AstRewriter, walk_program, rewrite_expr_children;
from compiler.frontend.source import Span, Position;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.ops import Index;
from std.core.option import Option;
from std.core.string import String;
from std.core.vec import Vec;

fn identifier(arena: AstArena&, span: Span, name: str, synthetic: bool) -> Identifier& {
    arena.alloc_identifier(IdentifierData(name=String.from(&name), synthetic=synthetic), span)
}
fn name_expr(arena: AstArena&, name: Identifier&) -> Expr& { arena.alloc_expr(ExprData.Identifier(name=name), name.span) }
fn block(arena: AstArena&, span: Span, stmts: Vec<Expr&>) -> Block& {
    arena.alloc_block(BlockData(stmts=stmts, end=Option<Position>.None, parameter_bindings=Vec<PatternLet&>.new()), span)
}
fn block_expr(arena: AstArena&, body: Block&) -> Expr& { arena.alloc_expr(ExprData.Block(block=body), body.span) }
fn one_block(arena: AstArena&, span: Span, value: Expr&) -> Block& {
    let stmts = Vec<Expr&>.new();
    stmts.push(value);
    block(arena, span, stmts)
}
fn break_block(arena: AstArena&, span: Span) -> Block& {
    one_block(arena, span, arena.alloc_expr(ExprData.Break(expr=Option<Expr&>.None), span))
}
fn unary_not(arena: AstArena&, value: Expr&) -> Expr& {
    arena.alloc_expr(ExprData.Unary(op=UnaryOperator.LogicalNot, operand=value), value.span)
}
fn arm(arena: AstArena&, pattern: Pattern&, body: Block&, origin: MatchArmOrigin) -> MatchArm& {
    arena.alloc_match_arm(MatchArmData(pattern=pattern, guard=Option<Expr&>.None, body=body, origin=origin), pattern.span)
}
fn match_expr(arena: AstArena&, span: Span, value: Expr&, arms: Vec<MatchArm&>) -> Expr& {
    arena.alloc_expr(ExprData.Match(expr=value, arms=arms), span)
}
fn conditional(arena: AstArena&, span: Span, condition: Condition, yes: Block&, no: Option<Block&>) -> Expr& {
    match condition {
        Expression(value) => arena.alloc_expr(ExprData.If(condition=condition, then_branch=yes, elif_branches=Vec<ElifBranch&>.new(), else_branch=no), span),
        Let(value) => {
            let fallback = if no.is_some() { *no.unwrap() } else { block(arena, span, Vec<Expr&>.new()) };
            let arms = Vec<MatchArm&>.new();
            arms.push(arm(arena, value.data.pattern, yes, MatchArmOrigin.Condition));
            let wildcard = arena.alloc_pattern(PatternData.WildcardPattern, span);
            arms.push(arm(arena, wildcard, fallback, MatchArmOrigin.Synthetic));
            match_expr(arena, span, value.data.value, arms)
        },
    }
}
fn method_call(arena: AstArena&, span: Span, receiver: Expr&, name: str, args: Vec<Argument&>) -> Expr& {
    arena.alloc_expr(ExprData.MethodCall(receiver=receiver, method_name=identifier(arena, span, name, true), generics=Vec<TypeSyntax&>.new(), args=args), span)
}
fn argument(arena: AstArena&, value: Expr&) -> Argument& {
    arena.alloc_argument(ArgumentData(name=Option<Identifier&>.None, value=value), value.span)
}

struct ParameterNormalizer { arena: AstArena& }
impl ParameterNormalizer {
    fn normalize(params: Vec<Parameter>&, body: Block&) {
        let i: u64 = 0;
        while i < params.len() {
            let parameter = params[i];
            match parameter {
                Pattern(value) => {
                    let label = String.from(&"%arg_");
                    let digits = i.to_string_radix(10);
                    label.push_str(digits.as_str());
                    digits.drop();
                    let hidden = identifier(self.arena, value.span, label.as_str(), true);
                    label.drop();
                    let info = self.arena.alloc_var_info(VarInfoData(name=hidden, var_type=value.data.var_type), value.span);
                    params[i] = Parameter.Named(value=info);
                    let init = name_expr(self.arena, hidden);
                    let binding = self.arena.alloc_pattern_let(PatternLetData(pattern=value.data.pattern, var_type=value.data.var_type,
                        init_expr=init, else_branch=Option<Block&>.None, is_parameter=true), value.span);
                    body.data.parameter_bindings.push(binding);
                },
                Named(_) => {},
            }
            i += 1;
        }
    }
}
impl AstVisitor for ParameterNormalizer {
    pub fn enter_item(node: Item&) -> bool {
        match &node.data { FuncDef(_, _, _, params, _, body) => self.normalize(params, *body), _ => {} }
        true
    }
    pub fn enter_expr(node: Expr&) -> bool {
        match &node.data { ClosureExpr(_, params, _, body) => self.normalize(params, *body), _ => {} }
        true
    }
    pub fn enter_method_def(node: MethodDef&) -> bool {
        self.normalize(&node.data.decl.data.params, node.data.body);
        true
    }
}

fn append_decimal(output: String&, value: u64) { let text = value.to_string_radix(10); output.push_str(text.as_str()); text.drop(); }
fn assertion_message(path: str, span: Span) -> String {
    let text = String.from(&"assertion failed at ");
    text.push_str(path);
    text.push('(');
    append_decimal(&text, span.start.row);
    text.push(':');
    append_decimal(&text, span.start.column);
    text.push_str(" - ");
    append_decimal(&text, span.end.row);
    text.push(':');
    append_decimal(&text, span.end.column);
    text.push(')');
    text
}
struct ControlLowerer { arena: AstArena&, path: str }
impl AstRewriter for ControlLowerer {
    pub fn rewrite_expr(node: Expr&) -> Expr& {
        rewrite_expr_children(node, self);
        let span = node.span;
        match &node.data {
            If(cond, yes, branches, no) => {
                let fallback = *no;
                let i = branches.len();
                while i > 0 {
                    i -= 1;
                    let branch = (*branches)[i];
                    let nested = conditional(self.arena, branch.data.body.span, branch.data.condition, branch.data.body, fallback);
                    fallback = Option<Block&>.Some(val=one_block(self.arena, branch.data.body.span, nested));
                }
                return conditional(self.arena, span, *cond, *yes, fallback);
            },
            While(cond, body) => {
                let stmts = Vec<Expr&>.new();
                match *cond {
                    Let(value) => {
                        let arms = Vec<MatchArm&>.new();
                        arms.push(arm(self.arena, value.data.pattern, *body, MatchArmOrigin.Condition));
                        let wildcard = self.arena.alloc_pattern(PatternData.WildcardPattern, span);
                        arms.push(arm(self.arena, wildcard, break_block(self.arena, span), MatchArmOrigin.Synthetic));
                        stmts.push(match_expr(self.arena, span, value.data.value, arms));
                    },
                    Expression(value) => {
                        let cond = Condition.Expression(value=unary_not(self.arena, value));
                        stmts.push(conditional(self.arena, span, cond, break_block(self.arena, span), Option<Block&>.None));
                        stmts.push(block_expr(self.arena, *body));
                    },
                }
                return self.arena.alloc_expr(ExprData.Loop(body=block(self.arena, body.span, stmts)), span);
            },
            For(pattern, iterable, body) => {
                let name = identifier(self.arena, span, "%iter", true);
                let init = method_call(self.arena, iterable.span, *iterable, "into_iter", Vec<Argument&>.new());
                let ty = self.arena.alloc_type_syntax(TypeData.DeducedType, span);
                let decl = self.arena.alloc_expr(ExprData.VarDecl(name=name, var_type=ty, init_expr=Option<Expr&>.Some(val=init)), span);
                let receiver = name_expr(self.arena, identifier(self.arena, span, "%iter", true));
                let next = method_call(self.arena, span, receiver, "next", Vec<Argument&>.new());
                let positional = Vec<Pattern&>.new();
                positional.push(*pattern);
                let some = self.arena.alloc_pattern(PatternData.ConstructPattern(name=identifier(self.arena, pattern.span, "Some", true),
                    qualifier=Option<TypeSyntax&>.None, arguments=PatternArguments.Positional(values=positional), rest=false), pattern.span);
                let none = self.arena.alloc_pattern(PatternData.NamePattern(name=identifier(self.arena, span, "None", true)), span);
                let arms = Vec<MatchArm&>.new();
                arms.push(arm(self.arena, some, *body, MatchArmOrigin.ForItem));
                arms.push(arm(self.arena, none, break_block(self.arena, span), MatchArmOrigin.Synthetic));
                let inner = match_expr(self.arena, span, next, arms);
                let loop_body = one_block(self.arena, body.span, inner);
                let repeat = self.arena.alloc_expr(ExprData.Loop(body=loop_body), span);
                let stmts = Vec<Expr&>.new();
                stmts.push(decl);
                stmts.push(repeat);
                return block_expr(self.arena, block(self.arena, span, stmts));
            },
            Assert(cond, message) => {
                let value = if message.is_some() { *message.unwrap() } else {
                    let text = assertion_message(self.path, span);
                    let literal = self.arena.alloc_str_literal(StrLiteralData(value=text), span);
                    self.arena.alloc_expr(ExprData.Literal(literal=Literal.StringLiteral(value=literal)), span)
                };
                let args = Vec<Argument&>.new();
                args.push(argument(self.arena, value));
                let panic_call = self.arena.alloc_expr(ExprData.Builtin(kind=BuiltinKind.Panic, type_args=Vec<TypeSyntax&>.new(), args=args), span);
                return conditional(self.arena, span, Condition.Expression(value=unary_not(self.arena, *cond)), one_block(self.arena, span, panic_call), Option<Block&>.None);
            },
            _ => {},
        }
        node
    }
}
struct ExpressionLowerer { arena: AstArena& }
impl AstRewriter for ExpressionLowerer {
    pub fn rewrite_expr(node: Expr&) -> Expr& {
        rewrite_expr_children(node, self);
        match &node.data {
            Binary(op, left, right) => {
                if *op == BinaryOperator.Range {
                    let args = Vec<Argument&>.new();
                    args.push(argument(self.arena, *left));
                    args.push(argument(self.arena, *right));
                    let callee = name_expr(self.arena, identifier(self.arena, node.span, "Range", false));
                    return self.arena.alloc_expr(ExprData.Call(callee=callee, args=args), node.span);
                }
                if *op == BinaryOperator.In {
                    let args = Vec<Argument&>.new();
                    args.push(argument(self.arena, *left));
                    return method_call(self.arena, node.span, *right, "contains", args);
                }
            },
            _ => {},
        }
        node
    }
}
pub fn desugar(tree: AstTree&, path: str) {
    let parameters = ParameterNormalizer(arena=&tree.arena);
    walk_program(tree.root, &parameters);
    let control = ControlLowerer(arena=&tree.arena, path=path);
    tree.root = control.rewrite_program(tree.root);
    let expressions = ExpressionLowerer(arena=&tree.arena);
    tree.root = expressions.rewrite_program(tree.root);
}
