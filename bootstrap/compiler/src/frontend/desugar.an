from compiler.frontend.ast.arena import AstTree;
from compiler.frontend.desugar.error import DesugarError;
from compiler.frontend.desugar.parameters import normalize_parameters;
from compiler.frontend.desugar.control import lower_control;
from compiler.frontend.desugar.expressions import lower_expressions;
from compiler.frontend.desugar.propagation import validate_propagation, lower_propagation;
from std.core.result import Result;

// 校验失败时不修改 AST；成功时所有语法糖节点由普通控制流和调用表示。
pub fn desugar(tree: AstTree&, path: str) -> Result<void, DesugarError> {
    validate_propagation(tree.root)?;
    normalize_parameters(tree);
    lower_control(tree, path);
    lower_expressions(tree);
    lower_propagation(tree);
    Result<void, DesugarError>.Ok({})
}
