from compiler.frontend.parse.ast import AstValue, NodeId;
from compiler.frontend.parse.state import AstTree;
from compiler.frontend.source import Span;
from std.core.drop import Drop;
from std.core.ops import Index;
from std.core.string import String;
from std.core.vec import Vec;

fn identifier(tree: AstTree&, span: Span, name: str, synthetic: bool) -> NodeId {
    let id = tree.alloc("Identifier", span);
    tree.text(id, "name", name);
    tree.flag(id, "synthetic", synthetic);
    return id;
}

fn block(tree: AstTree&, span: Span, statements: Vec<NodeId>) -> NodeId {
    let id = tree.alloc("Block", span);
    tree.children(id, "stmts", statements);
    tree.missing(id, "end");
    tree.children(id, "parameter_bindings", Vec<NodeId>.new());
    return id;
}

fn break_expr(tree: AstTree&, span: Span) -> NodeId {
    let id = tree.alloc("Break", span);
    tree.missing(id, "expr");
    return id;
}

fn break_block(tree: AstTree&, span: Span) -> NodeId {
    let statements = Vec<NodeId>.new();
    statements.push(break_expr(tree, span));
    return block(tree, span, statements);
}

fn unary_not(tree: AstTree&, expression: NodeId) -> NodeId {
    let id = tree.alloc("Unary", tree.node(expression).span());
    tree.text(id, "op", "!");
    tree.child(id, "operand", expression);
    return id;
}

fn if_expr(tree: AstTree&, span: Span, condition: NodeId, yes: NodeId, no: NodeId) -> NodeId {
    let id = tree.alloc("If", span);
    tree.child(id, "condition", condition);
    tree.child(id, "then_branch", yes);
    tree.children(id, "elif_branches", Vec<NodeId>.new());
    if no.is_valid() { tree.child(id, "else_branch", no); }
    else { tree.missing(id, "else_branch"); }
    return id;
}

fn loop_expr(tree: AstTree&, span: Span, body: NodeId) -> NodeId {
    let id = tree.alloc("Loop", span);
    tree.child(id, "body", body);
    return id;
}

fn arm(tree: AstTree&, span: Span, pattern: NodeId, body: NodeId, origin: str) -> NodeId {
    let id = tree.alloc("MatchArm", span);
    tree.child(id, "pattern", pattern);
    tree.missing(id, "guard");
    tree.child(id, "body", body);
    tree.text(id, "origin", origin);
    return id;
}

fn match_expr(tree: AstTree&, span: Span, value: NodeId, arms: Vec<NodeId>) -> NodeId {
    let id = tree.alloc("Match", span);
    tree.child(id, "expr", value);
    tree.children(id, "arms", arms);
    return id;
}

fn wildcard(tree: AstTree&, span: Span) -> NodeId { return tree.alloc("WildcardPattern", span); }

fn method_call(tree: AstTree&, span: Span, receiver: NodeId, name: str) -> NodeId {
    let id = tree.alloc("MethodCall", span);
    tree.child(id, "receiver", receiver);
    tree.child(id, "method_name", identifier(tree, span, name, true));
    tree.children(id, "generics", Vec<NodeId>.new());
    tree.children(id, "args", Vec<NodeId>.new());
    return id;
}

fn append_decimal(output: String&, value: u64) {
    let digits = value.to_string_radix(10u64);
    output.push_str(digits.as_str());
    digits.drop();
}

fn assertion_message(path: str, span: Span) -> String {
    let text = String.from(&"assertion failed at ");
    text.push_str(path);
    text.push('(');
    append_decimal(&text, span.start.row);
    text.push(':');
    append_decimal(&text, span.start.column);
    text.push_str(" - ");
    append_decimal(&text, span.end.row);
    text.push(':');
    append_decimal(&text, span.end.column);
    text.push(')');
    return text;
}

fn normalize_params(tree: AstTree&, owner: NodeId, body_id: NodeId) {
    let fields = tree.node(owner).fields();
    let field_index: u64 = 0u64;
    while field_index < fields.len() {
        if fields[field_index].name() == "params" {
            match fields[field_index].value() {
                Children(params) => {
                    let index: u64 = 0u64;
                    while index < params.len() {
                        let parameter = params[index];
                        if tree.node(parameter).tag() == "PatternParam" {
                            let span = tree.node(parameter).span();
                            let label = String.from(&"%arg_");
                            let number = index.to_string_radix(10u64);
                            label.push_str(number.as_str());
                            number.drop();
                            let hidden = identifier(tree, span, label.as_str(), true);
                            label.drop();
                            let pattern = tree.node(parameter).child_field("pattern");
                            let type_id = tree.node(parameter).child_field("var_type");
                            let info = tree.alloc("VarInfo", span);
                            tree.child(info, "name", hidden);
                            tree.child(info, "var_type", type_id);
                            params[index] = info;
                            let binding = tree.alloc("PatternLet", span);
                            tree.child(binding, "pattern", pattern);
                            tree.child(binding, "var_type", type_id);
                            tree.child(binding, "init_expr", hidden);
                            tree.missing(binding, "else_branch");
                            tree.flag(binding, "is_parameter", true);
                            tree.node(body_id).push_child("parameter_bindings", binding);
                        }
                        index += 1u64;
                    }
                },
                _ => {},
            }
        }
        field_index += 1u64;
    }
}

fn normalize_walk(tree: AstTree&, id: NodeId) {
    let tag = tree.node(id).tag();
    if tag == "FuncDef" || tag == "ClosureExpr" {
        normalize_params(tree, id, tree.node(id).child_field("body"));
    } elif tag == "MethodDef" {
        normalize_params(tree, tree.node(id).child_field("decl"), tree.node(id).child_field("body"));
    }
    let fields = tree.node(id).fields();
    let index: u64 = 0u64;
    while index < fields.len() {
        match fields[index].value() {
            Child(value) => { if value.is_valid() { normalize_walk(tree, *value); } },
            Children(values) => {
                let child_index: u64 = 0u64;
                while child_index < values.len() {
                    normalize_walk(tree, values[child_index]);
                    child_index += 1u64;
                }
            },
            _ => {},
        }
        index += 1u64;
    }
}

fn control_transform(tree: AstTree&, id: NodeId, path: str) -> NodeId {
    let tag = tree.node(id).tag();
    let span = tree.node(id).span();
    if tag == "If" {
        let branches = tree.node(id).fields();
        let index: u64 = 0u64;
        while index < branches.len() {
            if branches[index].name() == "elif_branches" {
                match branches[index].value() {
                    Children(values) => {
                        if values.len() > 0u64 {
                            let fallback = tree.node(id).child_field("else_branch");
                            let next = values.len();
                            while next > 0u64 {
                                next -= 1u64;
                                let branch = values[next];
                                let condition = tree.node(branch).child_field("condition");
                                let body = tree.node(branch).child_field("body");
                                let body_span = tree.node(body).span();
                                let nested = if_expr(tree, body_span, condition, body, fallback);
                                let statements = Vec<NodeId>.new();
                                statements.push(nested);
                                fallback = block(tree, body_span, statements);
                            }
                            return rewrite_control(tree, if_expr(tree, span,
                                tree.node(id).child_field("condition"),
                                tree.node(id).child_field("then_branch"), fallback), path);
                        }
                    },
                    _ => {},
                }
            }
            index += 1u64;
        }
        let condition = tree.node(id).child_field("condition");
        if tree.node(condition).tag() == "LetCondition" {
            let fallback = tree.node(id).child_field("else_branch");
            if !fallback.is_valid() { fallback = block(tree, span, Vec<NodeId>.new()); }
            let pattern = tree.node(condition).child_field("pattern");
            let arms = Vec<NodeId>.new();
            arms.push(arm(tree, tree.node(pattern).span(), pattern,
                tree.node(id).child_field("then_branch"), "condition"));
            let fallback_span = tree.node(fallback).span();
            arms.push(arm(tree, fallback_span, wildcard(tree, fallback_span), fallback, "synthetic"));
            return match_expr(tree, span, tree.node(condition).child_field("value"), arms);
        }
    } elif tag == "While" {
        let condition = tree.node(id).child_field("condition");
        let body = tree.node(id).child_field("body");
        let body_span = tree.node(body).span();
        if tree.node(condition).tag() == "LetCondition" {
            let pattern = tree.node(condition).child_field("pattern");
            let arms = Vec<NodeId>.new();
            arms.push(arm(tree, tree.node(pattern).span(), pattern, body, "condition"));
            arms.push(arm(tree, span, wildcard(tree, span), break_block(tree, span), "synthetic"));
            let statements = Vec<NodeId>.new();
            statements.push(match_expr(tree, tree.node(condition).span(),
                tree.node(condition).child_field("value"), arms));
            return loop_expr(tree, span, block(tree, body_span, statements));
        }
        let break_if = if_expr(tree, span, unary_not(tree, condition), break_block(tree, span), NodeId.invalid());
        let statements = Vec<NodeId>.new();
        statements.push(break_if);
        statements.push(body);
        return loop_expr(tree, span, block(tree, body_span, statements));
    } elif tag == "For" {
        let pattern = tree.node(id).child_field("pattern");
        let iterable = tree.node(id).child_field("iterable");
        let body = tree.node(id).child_field("body");
        let iterable_span = tree.node(iterable).span();
        let pattern_span = tree.node(pattern).span();
        let body_span = tree.node(body).span();
        let iter_name = identifier(tree, span, "%iter", true);
        let iter_init = method_call(tree, iterable_span, iterable, "into_iter");
        let iter_type = tree.alloc("DeducedType", span);
        let iter_decl = tree.alloc("VarDecl", span);
        tree.child(iter_decl, "name", iter_name);
        tree.child(iter_decl, "var_type", iter_type);
        tree.child(iter_decl, "init_expr", iter_init);

        let next_receiver = identifier(tree, span, "%iter", true);
        let next_call = method_call(tree, span, next_receiver, "next");
        let some_pattern = tree.alloc("ConstructPattern", pattern_span);
        tree.child(some_pattern, "name", identifier(tree, pattern_span, "Some", true));
        tree.missing(some_pattern, "qualifier");
        let positional = Vec<NodeId>.new();
        positional.push(pattern);
        tree.children(some_pattern, "positional", positional);
        tree.missing(some_pattern, "named");
        tree.flag(some_pattern, "rest", false);
        let none_pattern = tree.alloc("NamePattern", span);
        tree.child(none_pattern, "name", identifier(tree, span, "None", true));
        let arms = Vec<NodeId>.new();
        arms.push(arm(tree, pattern_span, some_pattern, body, "for_item"));
        arms.push(arm(tree, span, none_pattern, break_block(tree, span), "synthetic"));
        let inner_statements = Vec<NodeId>.new();
        inner_statements.push(match_expr(tree, span, next_call, arms));
        let loop_body = block(tree, body_span, inner_statements);
        let outer_statements = Vec<NodeId>.new();
        outer_statements.push(iter_decl);
        outer_statements.push(loop_expr(tree, span, loop_body));
        return block(tree, span, outer_statements);
    } elif tag == "Assert" {
        let condition = tree.node(id).child_field("condition");
        let message = tree.node(id).child_field("message");
        if !message.is_valid() {
            let value = assertion_message(path, span);
            let raw = String.from(&"\"");
            raw.push_str(value.as_str());
            raw.push('"');
            let literal = tree.alloc("StrLiteral", span);
            tree.text(literal, "raw", raw.as_str());
            tree.text(literal, "value", value.as_str());
            message = tree.alloc("Literal", span);
            tree.child(message, "literal", literal);
            raw.drop();
            value.drop();
        }
        let arg = tree.alloc("Arg", tree.node(message).span());
        tree.missing(arg, "name");
        tree.child(arg, "value", message);
        let args = Vec<NodeId>.new();
        args.push(arg);
        let panic_call = tree.alloc("Builtin", span);
        tree.text(panic_call, "kind", "panic");
        tree.children(panic_call, "type_args", Vec<NodeId>.new());
        tree.children(panic_call, "args", args);
        let statements = Vec<NodeId>.new();
        statements.push(panic_call);
        return if_expr(tree, span, unary_not(tree, condition), block(tree, span, statements), NodeId.invalid());
    }
    return id;
}

fn rewrite_control(tree: AstTree&, id: NodeId, path: str) -> NodeId {
    let fields = tree.node(id).fields();
    let index: u64 = 0u64;
    while index < fields.len() {
        match fields[index].value() {
            Child(value) => { if value.is_valid() { *value = rewrite_control(tree, *value, path); } },
            Children(values) => {
                let child_index: u64 = 0u64;
                while child_index < values.len() {
                    values[child_index] = rewrite_control(tree, values[child_index], path);
                    child_index += 1u64;
                }
            },
            _ => {},
        }
        index += 1u64;
    }
    return control_transform(tree, id, path);
}

fn arg(tree: AstTree&, value: NodeId) -> NodeId {
    let id = tree.alloc("Arg", tree.node(value).span());
    tree.missing(id, "name");
    tree.child(id, "value", value);
    return id;
}

fn rewrite_expr(tree: AstTree&, id: NodeId) -> NodeId {
    let fields = tree.node(id).fields();
    let index: u64 = 0u64;
    while index < fields.len() {
        match fields[index].value() {
            Child(value) => { if value.is_valid() { *value = rewrite_expr(tree, *value); } },
            Children(values) => {
                let child_index: u64 = 0u64;
                while child_index < values.len() {
                    values[child_index] = rewrite_expr(tree, values[child_index]);
                    child_index += 1u64;
                }
            },
            _ => {},
        }
        index += 1u64;
    }
    if tree.node(id).tag() != "Binary" { return id; }
    let op = tree.node(id).text_field("op");
    let span = tree.node(id).span();
    let left = tree.node(id).child_field("left");
    let right = tree.node(id).child_field("right");
    if op == ".." {
        let args = Vec<NodeId>.new();
        args.push(arg(tree, left));
        args.push(arg(tree, right));
        let call = tree.alloc("Call", span);
        tree.child(call, "callee", identifier(tree, span, "Range", false));
        tree.children(call, "args", args);
        return call;
    }
    if op == "in" {
        let call = method_call(tree, span, right, "contains");
        tree.node(call).push_child("args", arg(tree, left));
        return call;
    }
    return id;
}

pub fn desugar(tree: AstTree&, path: str) {
    normalize_walk(tree, tree.root());
    rewrite_control(tree, tree.root(), path);
    rewrite_expr(tree, tree.root());
}
