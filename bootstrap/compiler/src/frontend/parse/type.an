from compiler.frontend.parse.ast_kinds import AstTag, AstFieldName;
from compiler.frontend.parse.operator import BinaryOperator, UnaryOperator;
from compiler.frontend.lex.token import KeywordKind, PunctuatorKind;
from compiler.frontend.parse.ast import NodeId;
from compiler.frontend.parse.state import Parser;
from compiler.frontend.source import Span;
from std.core.ops import Index;
from std.core.vec import Vec;

fn primitive(parser: Parser&, name: KeywordKind, span: Span) -> NodeId {
    let tag = AstTag.IntType;
    let width = 4u64;
    let signed = true;
    if name == KeywordKind.I8 || name == KeywordKind.U8 { width = 1u64; }
    elif name == KeywordKind.I16 || name == KeywordKind.U16 { width = 2u64; }
    elif name == KeywordKind.I64 || name == KeywordKind.U64 { width = 8u64; }
    if name == KeywordKind.U8 || name == KeywordKind.U16 || name == KeywordKind.U32 ||
        name == KeywordKind.U64 || name == KeywordKind.Uint {
        signed = false;
    }
    if name == KeywordKind.F16 || name == KeywordKind.F32 || name == KeywordKind.F64 ||
        name == KeywordKind.Float {
        tag = AstTag.FloatType;
        if name == KeywordKind.F16 { width = 2u64; }
        elif name == KeywordKind.F32 { width = 4u64; }
        else { width = 8u64; }
    } elif name == KeywordKind.Bool { tag = AstTag.BoolType; }
    elif name == KeywordKind.Str { tag = AstTag.StrType; }
    elif name == KeywordKind.Char { tag = AstTag.CharType; }
    elif name == KeywordKind.Void { tag = AstTag.VoidType; }
    let node = parser.alloc(tag, span);
    if tag == AstTag.IntType {
        parser.flag(node, AstFieldName.Signed, signed);
        parser.integer(node, AstFieldName.Width, width, false);
    } elif tag == AstTag.FloatType {
        parser.integer(node, AstFieldName.Width, width, false);
    }
    return node;
}

fn is_primitive(name: KeywordKind) -> bool {
    match name {
        I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 | Int | Uint |
            F16 | F32 | F64 | Float | Bool | Str | Char | Void => true,
        _ => false,
    }
}

fn parse_type_base(parser: Parser&) -> NodeId {
    if parser.failed() { return NodeId.invalid(); }
    let token = parser.peek();
    let span = token.span;
    let spelling = token.value();
    match token.kind() {
        Keyword(kind) => {
            if is_primitive(*kind) {
                parser.advance();
                return primitive(parser, *kind, span);
            }
        },
        _ => {},
    }
    if parser.at_punct(PunctuatorKind.Exclamation) {
        parser.advance();
        return parser.alloc(AstTag.NeverType, span);
    }
    if parser.at_keyword(KeywordKind.Fn) {
        parser.advance();
        parser.take_punct(PunctuatorKind.LParen);
        let params = Vec<NodeId>.new();
        while !parser.failed() && !parser.at_punct(PunctuatorKind.RParen) {
            let param = parse_type(parser);
            if parser.failed() { break; }
            params.push(param);
            if parser.at_punct(PunctuatorKind.Comma) { parser.advance(); }
            else { break; }
        }
        parser.take_punct(PunctuatorKind.RParen);
        let result = NodeId.invalid();
        if parser.at_punct(PunctuatorKind.Arrow) {
            parser.advance();
            result = parse_type(parser);
        } else { result = parser.alloc(AstTag.VoidType, span); }
        if parser.failed() { params.drop(); return NodeId.invalid(); }
        let node = parser.alloc(AstTag.FunctionType, span);
        parser.children(node, AstFieldName.ParamTypes, params);
        parser.child(node, AstFieldName.ReturnType, result);
        return node;
    }
    if token.is_identifier() {
        let name = parser.identifier();
        if parser.failed() { return NodeId.invalid(); }
        if spelling == "c_int" || spelling == "c_uint" || spelling == "c_size" || spelling == "c_char" {
            let node = parser.alloc(AstTag.CScalarType, span);
            parser.text(node, AstFieldName.Name, spelling);
            return node;
        }
        let node = parser.alloc(AstTag.NamedType, span);
        parser.child(node, AstFieldName.Name, name);
        return node;
    }
    if parser.at_punct(PunctuatorKind.LParen) {
        parser.advance();
        let members = Vec<NodeId>.new();
        if parser.at_punct(PunctuatorKind.RParen) {
            parser.advance();
            let node = parser.alloc(AstTag.TupleType, span);
            parser.children(node, AstFieldName.ElementTypes, members);
            return node;
        }
        let first = parse_type(parser);
        if parser.at_punct(PunctuatorKind.RParen) {
            parser.advance();
            members.drop();
            return first;
        }
        parser.take_punct(PunctuatorKind.Comma);
        if parser.failed() { members.drop(); return NodeId.invalid(); }
        members.push(first);
        while !parser.failed() && !parser.at_punct(PunctuatorKind.RParen) {
            members.push(parse_type(parser));
            if parser.at_punct(PunctuatorKind.Comma) { parser.advance(); }
            else { break; }
        }
        parser.take_punct(PunctuatorKind.RParen);
        if parser.failed() { members.drop(); return NodeId.invalid(); }
        let node = parser.alloc(AstTag.TupleType, span);
        parser.children(node, AstFieldName.ElementTypes, members);
        return node;
    }
    parser.error("Expected type", span);
    return NodeId.invalid();
}

pub fn parse_type(parser: Parser&) -> NodeId {
    let base = parse_type_base(parser);
    while !parser.failed() {
        let span = parser.node(base).span();
        if parser.at_punct(PunctuatorKind.LAngle) {
            parser.advance();
            let args = Vec<NodeId>.new();
            while !parser.failed() && !parser.at_punct(PunctuatorKind.RAngle) {
                args.push(parse_generic_arg(parser));
                if parser.at_punct(PunctuatorKind.Comma) { parser.advance(); }
                else { break; }
            }
            parser.take_punct(PunctuatorKind.RAngle);
            if parser.failed() { args.drop(); return NodeId.invalid(); }
            let name = "";
            if parser.node(base).tag() == AstTag.NamedType {
                let ident = parser.node(base).child_field(AstFieldName.Name);
                name = parser.node(ident).text_field(AstFieldName.Name);
            }
            if name == "cptr" {
                if args.len() != 1u64 {
                    parser.error("cptr requires exactly one type argument", span);
                    args.drop();
                    return NodeId.invalid();
                }
                let arg_tag = parser.node(args[0u64]).tag();
                if arg_tag == AstTag.LiteralConstExpr || arg_tag == AstTag.GenericConstExpr ||
                    arg_tag == AstTag.UnaryConstExpr || arg_tag == AstTag.BinaryConstExpr {
                    parser.error("cptr requires exactly one type argument", span);
                    args.drop();
                    return NodeId.invalid();
                }
                let node = parser.alloc(AstTag.CPtrType, span);
                parser.child(node, AstFieldName.PointeeType, args[0u64]);
                args.drop();
                base = node;
            } else {
                let node = parser.alloc(AstTag.InstanceType, span);
                parser.child(node, AstFieldName.Base, base);
                parser.children(node, AstFieldName.GenericArgs, args);
                base = node;
            }
            continue;
        }
        if parser.at_punct(PunctuatorKind.Star) {
            parser.advance();
            let node = parser.alloc(AstTag.PointerType, span);
            parser.child(node, AstFieldName.PointeeType, base);
            base = node;
            continue;
        }
        if parser.at_punct(PunctuatorKind.Ampersand) {
            parser.advance();
            let node = parser.alloc(AstTag.RefType, span);
            parser.child(node, AstFieldName.PointeeType, base);
            base = node;
            continue;
        }
        if parser.at_punct(PunctuatorKind.LBracket) {
            parser.advance();
            if parser.at_punct(PunctuatorKind.RBracket) {
                parser.advance();
                let node = parser.alloc(AstTag.SliceType, span);
                parser.child(node, AstFieldName.ElementType, base);
                base = node;
            } else {
                let size = parse_const_expr(parser);
                parser.take_punct(PunctuatorKind.RBracket);
                if parser.failed() { return NodeId.invalid(); }
                let node = parser.alloc(AstTag.ArrayType, span);
                parser.child(node, AstFieldName.ElementType, base);
                parser.child(node, AstFieldName.Size, size);
                base = node;
            }
            continue;
        }
        break;
    }
    return base;
}

fn const_binding(op: BinaryOperator) -> i32 {
    match op {
        BitOr | BitXor | BitAnd | Shl | Shr | Add | Sub | Mul | Div | Mod => op.lbp(),
        _ => 0,
    }
}

fn const_expr_bp(parser: Parser&, min_bp: i32) -> NodeId {
    if parser.failed() { return NodeId.invalid(); }
    let token = parser.peek();
    let span = token.span;
    let lhs = NodeId.invalid();
    if parser.at_punct(PunctuatorKind.Minus) || parser.at_punct(PunctuatorKind.Tilde) {
        let op = *UnaryOperator.from_token(token).unwrap();
        parser.advance();
        let operand = const_expr_bp(parser, 13);
        if parser.failed() { return NodeId.invalid(); }
        lhs = parser.alloc(AstTag.UnaryConstExpr, span + parser.node(operand).span());
        parser.unary_op(lhs, op);
        parser.child(lhs, AstFieldName.Operand, operand);
    } elif parser.at_punct(PunctuatorKind.LParen) {
        parser.advance();
        lhs = const_expr_bp(parser, 1);
        parser.take_punct(PunctuatorKind.RParen);
    } elif token.is_integer() {
        let literal = parser.alloc(AstTag.IntLiteral, span);
        parser.integer(literal, AstFieldName.Value, token.integer_value(), false);
        parser.text(literal, AstFieldName.Suffix, token.suffix());
        parser.advance();
        lhs = parser.alloc(AstTag.LiteralConstExpr, span);
        parser.child(lhs, AstFieldName.Literal, literal);
    } elif token.is_identifier() || parser.keyword_token() {
        let ident = parser.identifier();
        if parser.failed() { return NodeId.invalid(); }
        lhs = parser.alloc(AstTag.GenericConstExpr, span);
        parser.child(lhs, AstFieldName.Name, ident);
    } else {
        parser.error("Expected integer constant expression", span);
        return NodeId.invalid();
    }
    while !parser.failed() {
        let candidate = BinaryOperator.from_token(parser.peek());
        let lbp = match candidate { Some(op) => const_binding(op), None => 0 };
        if lbp == 0 || lbp < min_bp { break; }
        let op = *candidate.unwrap();
        parser.advance();
        let rhs = const_expr_bp(parser, lbp + 1);
        if parser.failed() { return NodeId.invalid(); }
        let node = parser.alloc(AstTag.BinaryConstExpr, parser.node(lhs).span() + parser.node(rhs).span());
        parser.binary_op(node, op);
        parser.child(node, AstFieldName.Left, lhs);
        parser.child(node, AstFieldName.Right, rhs);
        lhs = node;
    }
    return lhs;
}

pub fn parse_const_expr(parser: Parser&) -> NodeId { return const_expr_bp(parser, 1); }

pub fn parse_generic_arg(parser: Parser&) -> NodeId {
    let token = parser.peek();
    if token.is_integer() || token.is_punct(PunctuatorKind.Minus) || token.is_punct(PunctuatorKind.Tilde) {
        return parse_const_expr(parser);
    }
    let mark = parser.mark();
    let ty = parse_type(parser);
    if parser.failed() {
        parser.clear_error();
        parser.reset(mark);
        return parse_const_expr(parser);
    }
    let candidate = BinaryOperator.from_token(parser.peek());
    if candidate.is_some() && const_binding(*candidate.unwrap()) != 0 {
        parser.reset(mark);
        return parse_const_expr(parser);
    }
    return ty;
}
