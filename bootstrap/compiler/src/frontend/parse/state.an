from compiler.frontend.ast.arena import AstArena, AstTree;
from compiler.frontend.ast.node import Identifier, IdentifierData, Program;
from compiler.frontend.lex.token import Token, KeywordKind, PunctuatorKind;
from compiler.frontend.source import Position, Span;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.ops import Index;
from std.core.option import Option;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;

pub struct ParseError { message: String, span: Span }
impl ParseError {
    pub fn message() -> str { self.message.as_str() }
    pub fn span() -> Span { self.span }
}
impl Drop for ParseError { pub fn drop() { self.message.drop(); } }

pub struct Parser {
    tokens: Vec<Token>&,
    index: u64,
    pub arena: AstArena,
    failed: bool,
    problem: ParseError,
}

impl Parser {
    static pub fn new(tokens: Vec<Token>&) -> Self {
        let zero = Position(row=0, column=0);
        Self(tokens=tokens, index=0, arena=AstArena.new(), failed=false,
            problem=ParseError(message=String.new(), span=Span(start=zero, end=zero)))
    }
    pub fn peek() -> Token& { &self.tokens[self.index] }
    pub fn peek_at(ahead: u64) -> Token& {
        let position = self.index + ahead;
        if position >= self.tokens.len() { position = self.tokens.len() - 1; }
        return &self.tokens[position];
    }
    pub fn at_end() -> bool { self.peek().is_eof() }
    pub fn previous_span() -> Span { self.tokens[self.index - 1].span }
    pub fn failed() -> bool { self.failed }
    pub fn mark() -> u64 { self.index }
    pub fn reset(mark: u64) { self.index = mark; }
    pub fn ready() -> Option<bool> {
        if self.failed { Option<bool>.None } else { Option<bool>.Some(val=true) }
    }
    pub fn clear_error() {
        self.problem.drop();
        self.problem.message = String.new();
        self.failed = false;
    }
    pub fn error(message: str, span: Span) {
        if self.failed { return; }
        self.problem.message.drop();
        self.problem.message = String.from(&message);
        self.problem.span = span;
        self.failed = true;
    }
    pub fn advance() {
        if self.failed { return; }
        if self.at_end() { self.error("End of token stream reached", self.peek().span); return; }
        self.index += 1;
    }
    pub fn at_punct(symbol: PunctuatorKind) -> bool { self.peek().is_punct(symbol) }
    pub fn at_keyword(word: KeywordKind) -> bool { self.peek().is_keyword(word) }
    pub fn take_punct(symbol: PunctuatorKind) -> Span {
        let span = self.peek().span;
        if !self.failed {
            if self.at_punct(symbol) { self.advance(); } else {
                let message = String.from(&"Expected punctuator 'PunctuatorKind.");
                message.push_str(symbol.name());
                message.push_str("' but got '");
                message.push_str(self.peek().value());
                message.push('\'');
                self.error(message.as_str(), span);
                message.drop();
            }
        }
        return span;
    }
    pub fn take_keyword(word: KeywordKind) -> Span {
        let span = self.peek().span;
        if !self.failed {
            if self.at_keyword(word) { self.advance(); } else { self.error("Expected keyword", span); }
        }
        return span;
    }
    pub fn named_identifier(span: Span, name: str, synthetic: bool) -> Identifier& {
        self.arena.alloc_identifier(IdentifierData(name=String.from(&name), synthetic=synthetic), span)
    }
    pub fn identifier() -> Option<Identifier&> {
        self.ready()?;
        let token = self.peek();
        if token.is_keyword(KeywordKind.IsRawMode) {
            self.error("'IS_RAW_MODE' is a reserved compile-time configuration", token.span);
            return Option<Identifier&>.None;
        }
        if token.is_keyword(KeywordKind.Defer) {
            self.error("'defer' is a reserved keyword", token.span);
            return Option<Identifier&>.None;
        }
        if !token.is_identifier() {
            let reserved = token.is_keyword(KeywordKind.True_) || token.is_keyword(KeywordKind.False_) ||
            token.is_keyword(KeywordKind.Fn) || token.is_keyword(KeywordKind.Struct) ||
            token.is_keyword(KeywordKind.U64) || token.is_keyword(KeywordKind.Void);
            if !reserved && !self.keyword_token() {
                self.error("Expected identifier or keyword", token.span);
                return Option<Identifier&>.None;
            }
        }
        let node = self.named_identifier(token.span, token.value(), false);
        self.advance();
        return Option<Identifier&>.Some(val=node);
    }
    pub fn keyword_token() -> bool { self.peek().is_keyword_token() }
    pub fn finish(root: Option<Program&>) -> Result<AstTree, ParseError> {
        match &root {
            Some(value) => {
                let arena = self.arena;
                self.arena = AstArena.new();
                self.problem.drop();
                self.problem.message = String.new();
                return Result<AstTree, ParseError>.Ok(val=AstTree(arena=arena, root=*value));
            },
            None => {
                self.arena.drop();
                let problem = self.problem;
                self.problem.message = String.new();
                return Result<AstTree, ParseError>.Err(msg=problem);
            },
        }
    }
}
