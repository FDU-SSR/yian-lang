            Continue => match *other { Continue => true, _ => false },
            DeducedType => match *other { DeducedType => true, _ => false },
            Defer => match *other { Defer => true, _ => false },
            Delete => match *other { Delete => true, _ => false },
            DynBuffer => match *other { DynBuffer => true, _ => false },
            DynValue => match *other { DynValue => true, _ => false },
            ElifBranch => match *other { ElifBranch => true, _ => false },
            EnumDef => match *other { EnumDef => true, _ => false },
            ExternBlock => match *other { ExternBlock => true, _ => false },
            ExternFuncDecl => match *other { ExternFuncDecl => true, _ => false },
            FieldAccess => match *other { FieldAccess => true, _ => false },
            FieldInfo => match *other { FieldInfo => true, _ => false },
            FieldPattern => match *other { FieldPattern => true, _ => false },
            FloatLiteral => match *other { FloatLiteral => true, _ => false },
            FloatType => match *other { FloatType => true, _ => false },
            For => match *other { For => true, _ => false },
            FuncDef => match *other { FuncDef => true, _ => false },
            FunctionType => match *other { FunctionType => true, _ => false },
            GenericConstExpr => match *other { GenericConstExpr => true, _ => false },
            Identifier => match *other { Identifier => true, _ => false },
            If => match *other { If => true, _ => false },
            Impl => match *other { Impl => true, _ => false },
            ImplCondition => match *other { ImplCondition => true, _ => false },
            Import => match *other { Import => true, _ => false },
            InstanceType => match *other { InstanceType => true, _ => false },
            IntLiteral => match *other { IntLiteral => true, _ => false },
            IntType => match *other { IntType => true, _ => false },
            LetCondition => match *other { LetCondition => true, _ => false },
            Literal => match *other { Literal => true, _ => false },
