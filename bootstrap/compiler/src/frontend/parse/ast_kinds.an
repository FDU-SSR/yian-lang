impl PartialEq<AstTag> for AstTag {
    fn eq(other: AstTag&) -> bool {
        match *self {
            Alias => match *other { Alias => true, _ => false },
            Arg => match *other { Arg => true, _ => false },
            Array => match *other { Array => true, _ => false },
            ArrayRepeat => match *other { ArrayRepeat => true, _ => false },
