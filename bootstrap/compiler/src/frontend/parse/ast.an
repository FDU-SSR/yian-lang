from compiler.frontend.source import Position, Span;
from compiler.frontend.parse.ast_kinds import AstTag, AstFieldName;
from compiler.frontend.parse.operator import BinaryOperator, UnaryOperator;
from compiler.frontend.parse.ast_atoms import AttrKind, BuiltinKind, MatchArmOrigin;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.ops import Index;
from std.core.string import String;
from std.core.vec import Vec;

// A node ID is an index into one compilation unit's append-only arena.
pub struct NodeId {
    value: u64,
}

impl NodeId {
    pub fn index() -> u64 { return self.value; }
    static pub fn invalid() -> Self { return Self(value=u64.max()); }
    pub fn is_valid() -> bool { return self.value != u64.max(); }
}

pub enum AstValue {
    Missing,
    Text { value: String },
    Integer { value: u64, negative: bool },
    Float { value: f64 },
    BinaryOp { value: BinaryOperator },
    UnaryOp { value: UnaryOperator },
    AttrKind { value: AttrKind },
    BuiltinKind { value: BuiltinKind },
    ArmOrigin { value: MatchArmOrigin },
    Flag { value: bool },
    Location { value: Position },
    Child { value: NodeId },
    Children { value: Vec<NodeId> },
}

pub struct AstField {
    name: AstFieldName,
    value: AstValue,
}

impl AstField {
    pub fn name() -> AstFieldName { return self.name; }
    pub fn value() -> AstValue& { return &self.value; }
}

impl Drop for AstField {
    pub fn drop() {
        match self.value {
            Text(value) => value.drop(),
            Children(value) => value.drop(),
            _ => {},
        }
    }
}

pub struct AstNode {
    tag: AstTag,
    span: Span,
    fields: Vec<AstField>,
}

impl AstNode {
    pub fn tag() -> AstTag { return self.tag; }
    pub fn span() -> Span { return self.span; }
    pub fn fields() -> AstField[] { return self.fields.as_slice(); }
    pub fn text_field(name: AstFieldName) -> str {
        let index: u64 = 0u64;
        while index < self.fields.len() {
            let field = &self.fields[index];
            if field.name() == name {
                match field.value() {
                    Text(value) => return value.as_str(),
                    _ => {},
                }
            }
            index += 1u64;
        }
        return "";
    }

    pub fn child_field(name: AstFieldName) -> NodeId {
        let index: u64 = 0u64;
        while index < self.fields.len() {
            let field = &self.fields[index];
            if field.name() == name {
                match field.value() {
                    Child(value) => return *value,
                    _ => {},
                }
            }
            index += 1u64;
        }
        return NodeId.invalid();
    }

    pub fn binary_op_field() -> BinaryOperator {
        let index: u64 = 0u64;
        while index < self.fields.len() {
            if self.fields[index].name() == AstFieldName.Op {
                match self.fields[index].value() {
                    BinaryOp(value) => return *value,
                    _ => {},
                }
            }
            index += 1u64;
        }
        @panic("AST node has no binary operator");
    }

    pub fn push_child(name: AstFieldName, child: NodeId) {
        let index: u64 = 0u64;
        while index < self.fields.len() {
            if self.fields[index].name() == name {
                match self.fields[index].value() {
                    Children(values) => values.push(child),
                    _ => {},
                }
                return;
            }
            index += 1u64;
        }
    }

}

impl Drop for AstNode {
    pub fn drop() {
        let index: u64 = 0u64;
        while index < self.fields.len() {
            self.fields[index].drop();
            index += 1u64;
        }
        self.fields.drop();
    }
}

pub struct AstArena {
    nodes: Vec<AstNode>,
}

impl AstArena {
    static pub fn new() -> Self { return Self(nodes=Vec<AstNode>.new()); }

    pub fn len() -> u64 { return self.nodes.len(); }

    pub fn alloc(tag: AstTag, span: Span) -> NodeId {
        let id = NodeId(value=self.nodes.len());
        self.nodes.push(AstNode(tag=tag, span=span, fields=Vec<AstField>.new()));
        return id;
    }

    pub fn node(id: NodeId) -> AstNode& { return &self.nodes[id.index()]; }

    pub fn text(id: NodeId, name: AstFieldName, value: str) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Text(value=String.from(&value))
        ));
    }

    pub fn integer(id: NodeId, name: AstFieldName, value: u64, negative: bool) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Integer(value=value, negative=negative)
        ));
    }

    pub fn floating(id: NodeId, name: AstFieldName, value: f64) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Float(value=value)
        ));
    }

    pub fn binary_op(id: NodeId, value: BinaryOperator) {
        self.nodes[id.index()].fields.push(AstField(
            name=AstFieldName.Op, value=AstValue.BinaryOp(value=value)
        ));
    }

    pub fn unary_op(id: NodeId, value: UnaryOperator) {
        self.nodes[id.index()].fields.push(AstField(
            name=AstFieldName.Op, value=AstValue.UnaryOp(value=value)
        ));
    }

    pub fn attr_kind(id: NodeId, value: AttrKind) {
        self.nodes[id.index()].fields.push(AstField(
            name=AstFieldName.Kind, value=AstValue.AttrKind(value=value)
        ));
    }

    pub fn builtin_kind(id: NodeId, value: BuiltinKind) {
        self.nodes[id.index()].fields.push(AstField(
            name=AstFieldName.Kind, value=AstValue.BuiltinKind(value=value)
        ));
    }

    pub fn arm_origin(id: NodeId, value: MatchArmOrigin) {
        self.nodes[id.index()].fields.push(AstField(
            name=AstFieldName.Origin, value=AstValue.ArmOrigin(value=value)
        ));
    }

    pub fn flag(id: NodeId, name: AstFieldName, value: bool) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Flag(value=value)
        ));
    }

    pub fn location(id: NodeId, name: AstFieldName, value: Position) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Location(value=value)
        ));
    }

    pub fn child(id: NodeId, name: AstFieldName, value: NodeId) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Child(value=value)
        ));
    }

    pub fn children(id: NodeId, name: AstFieldName, values: Vec<NodeId>) {
        self.nodes[id.index()].fields.push(AstField(
            name=name, value=AstValue.Children(value=values)
        ));
    }

    pub fn missing(id: NodeId, name: AstFieldName) {
        self.nodes[id.index()].fields.push(AstField(name=name, value=AstValue.Missing));
    }
}

impl Drop for AstArena {
    pub fn drop() {
        let index: u64 = 0u64;
        while index < self.nodes.len() {
            self.nodes[index].drop();
            index += 1u64;
        }
        self.nodes.drop();
    }
}
