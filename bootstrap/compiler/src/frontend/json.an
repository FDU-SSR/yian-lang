from compiler.frontend.source import Span;
from json.write import Writer;

// Source spans are compiler-specific fields in an open JSON object.
pub fn append_span(output: Writer&, span: Span) {
    output.key("start"); output.begin_array();
    output.write_u64(span.start.row); output.write_u64(span.start.column);
    output.end_array();
    output.key("end"); output.begin_array();
    output.write_u64(span.end.row); output.write_u64(span.end.column);
    output.end_array();
}
