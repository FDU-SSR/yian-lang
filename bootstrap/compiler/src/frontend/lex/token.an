            "pub" => Option<Self>.Some(val=Self.Pub),
            "ffi" => Option<Self>.Some(val=Self.Ffi),
            "extern" => Option<Self>.Some(val=Self.Extern),
            "opaque" => Option<Self>.Some(val=Self.Opaque),
            "type" => Option<Self>.Some(val=Self.Type),
            "static" => Option<Self>.Some(val=Self.Static),
            "const" => Option<Self>.Some(val=Self.Const),
            "comptime" => Option<Self>.Some(val=Self.Comptime),
            "inline" => Option<Self>.Some(val=Self.Inline),
            "intrinsic" => Option<Self>.Some(val=Self.Intrinsic),
            "if" => Option<Self>.Some(val=Self.If),
            "elif" => Option<Self>.Some(val=Self.Elif),
            "else" => Option<Self>.Some(val=Self.Else),
            "match" => Option<Self>.Some(val=Self.Match),
            "for" => Option<Self>.Some(val=Self.For),
            "while" => Option<Self>.Some(val=Self.While),
            "loop" => Option<Self>.Some(val=Self.Loop),
            "break" => Option<Self>.Some(val=Self.Break),
            "continue" => Option<Self>.Some(val=Self.Continue),
            "return" => Option<Self>.Some(val=Self.Return),
            "defer" => Option<Self>.Some(val=Self.Defer),
            "assert" => Option<Self>.Some(val=Self.Assert),
            "in" => Option<Self>.Some(val=Self.In),
            "typeof" => Option<Self>.Some(val=Self.Typeof),
            "del" => Option<Self>.Some(val=Self.Del),
            "true" => Option<Self>.Some(val=Self.True_),
            "false" => Option<Self>.Some(val=Self.False_),
            "IS_RAW_MODE" => Option<Self>.Some(val=Self.IsRawMode),
            "_" => Option<Self>.Some(val=Self.Underscore),
            "void" => Option<Self>.Some(val=Self.Void),
            "bool" => Option<Self>.Some(val=Self.Bool),
            "char" => Option<Self>.Some(val=Self.Char),
            "str" => Option<Self>.Some(val=Self.Str),
            "i8" => Option<Self>.Some(val=Self.I8),
            "i16" => Option<Self>.Some(val=Self.I16),
            "i32" => Option<Self>.Some(val=Self.I32),
            "i64" => Option<Self>.Some(val=Self.I64),
            "u8" => Option<Self>.Some(val=Self.U8),
            "u16" => Option<Self>.Some(val=Self.U16),
            "u32" => Option<Self>.Some(val=Self.U32),
            "u64" => Option<Self>.Some(val=Self.U64),
            "f16" => Option<Self>.Some(val=Self.F16),
            "f32" => Option<Self>.Some(val=Self.F32),
            "f64" => Option<Self>.Some(val=Self.F64),
