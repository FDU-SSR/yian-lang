from std.core.string import String;
from std.core.vec import Vec;

pub enum KeywordKind {
    Import,
    From,
    As,
    Let,
    Typedef,
    Struct,
    Enum,
    Trait,
    Impl,
    Fn,
    Dyn,
    Pub,
    Ffi,
    Extern,
    Opaque,
    Type,
    Static,
    Const,
    Comptime,
    Inline,
    Intrinsic,
    If,
    Elif,
    Else,
    Match,
    For,
    While,
    Loop,
    Break,
    Continue,
    Return,
    Defer,
    Assert,
    In,
    Typeof,
    Del,
    True_,
    False_,
    IsRawMode,
    Underscore,
    Void,
    Bool,
    Char,
    Str,
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    F16,
    F32,
    F64,
    Int,
    Uint,
    Float,
}

impl KeywordKind {
    pub fn spelling() -> str {
        match self {
            Import => "import",
            From => "from",
            As => "as",
            Let => "let",
            Typedef => "typedef",
            Struct => "struct",
            Enum => "enum",
            Trait => "trait",
            Impl => "impl",
            Fn => "fn",
            Dyn => "dyn",
            Pub => "pub",
            Ffi => "ffi",
            Extern => "extern",
            Opaque => "opaque",
            Type => "type",
            Static => "static",
            Const => "const",
            Comptime => "comptime",
            Inline => "inline",
            Intrinsic => "intrinsic",
            If => "if",
            Elif => "elif",
            Else => "else",
            Match => "match",
            For => "for",
            While => "while",
            Loop => "loop",
            Break => "break",
            Continue => "continue",
            Return => "return",
            Defer => "defer",
            Assert => "assert",
            In => "in",
            Typeof => "typeof",
            Del => "del",
            True_ => "true",
            False_ => "false",
            IsRawMode => "IS_RAW_MODE",
            Underscore => "_",
            Void => "void",
            Bool => "bool",
