pub enum PunctuatorKind {
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Colon,
    Semicolon,
    Dot,
    Arrow,
    FatArrow,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Caret,
    Ampersand,
    AmpersandAmpersand,
    Pipe,
    PipePipe,
    Tilde,
    Exclamation,
    Equal,
    Less,
    Greater,
    LAngle,
    RAngle,
    PlusEqual,
    MinusEqual,
    StarEqual,
    SlashEqual,
    PercentEqual,
    CaretEqual,
    AmpersandEqual,
    PipeEqual,
    EqualEqual,
    NotEqual,
    LessEqual,
    GreaterEqual,
    LessLess,
    LessLessEqual,
    GreaterGreater,
    GreaterGreaterEqual,
    DotDot,
    At,
    EOF,
}

impl PunctuatorKind {
    pub fn name() -> str {
        match self {
            LParen => "LParen",
            RParen => "RParen",
            LBrace => "LBrace",
            RBrace => "RBrace",
            LBracket => "LBracket",
            RBracket => "RBracket",
            Comma => "Comma",
            Colon => "Colon",
            Semicolon => "Semicolon",
            Dot => "Dot",
            Arrow => "Arrow",
            FatArrow => "FatArrow",
            Plus => "Plus",
            Minus => "Minus",
            Star => "Star",
            Slash => "Slash",
            Percent => "Percent",
            Caret => "Caret",
            Ampersand => "Ampersand",
            AmpersandAmpersand => "AmpersandAmpersand",
            Pipe => "Pipe",
            PipePipe => "PipePipe",
            Tilde => "Tilde",
            Exclamation => "Exclamation",
            Equal => "Equal",
            Less => "Less",
            Greater => "Greater",
            LAngle => "LAngle",
            RAngle => "RAngle",
            PlusEqual => "PlusEqual",
            MinusEqual => "MinusEqual",
            StarEqual => "StarEqual",
            SlashEqual => "SlashEqual",
            PercentEqual => "PercentEqual",
            CaretEqual => "CaretEqual",
            AmpersandEqual => "AmpersandEqual",
            PipeEqual => "PipeEqual",
            EqualEqual => "EqualEqual",
            NotEqual => "NotEqual",
            LessEqual => "LessEqual",
            GreaterEqual => "GreaterEqual",
            LessLess => "LessLess",
            LessLessEqual => "LessLessEqual",
            GreaterGreater => "GreaterGreater",
            GreaterGreaterEqual => "GreaterGreaterEqual",
            DotDot => "DotDot",
            At => "At",
            EOF => "EOF",
        }
    }

    pub fn spelling() -> str {
        match self {
            LParen => "(",
            RParen => ")",
            LBrace => "{",
            RBrace => "}",
            LBracket => "[",
            RBracket => "]",
            Comma => ",",
            Colon => ":",
            Semicolon => ";",
            Dot => ".",
            Arrow => "->",
            FatArrow => "=>",
            Plus => "+",
            Minus => "-",
            Star => "*",
            Slash => "/",
            Percent => "%",
            Caret => "^",
            Ampersand => "&",
            AmpersandAmpersand => "&&",
            Pipe => "|",
            PipePipe => "||",
            Tilde => "~",
            Exclamation => "!",
            Equal => "=",
            Less => "<",
            Greater => ">",
            LAngle => "<angle>",
            RAngle => ">angle>",
            PlusEqual => "+=",
            MinusEqual => "-=",
            StarEqual => "*=",
            SlashEqual => "/=",
            PercentEqual => "%=",
            CaretEqual => "^=",
            AmpersandEqual => "&=",
            PipeEqual => "|=",
            EqualEqual => "==",
            NotEqual => "!=",
            LessEqual => "<=",
            GreaterEqual => ">=",
            LessLess => "<<",
            LessLessEqual => "<<=",
            GreaterGreater => ">>",
            GreaterGreaterEqual => ">>=",
            DotDot => "..",
            At => "@",
            EOF => "<eof>",
        }
    }

    static pub fn from_text(text: str) -> Option<Self> {
        return match text {
            "(" => Option<Self>.Some(val=Self.LParen),
            ")" => Option<Self>.Some(val=Self.RParen),
            "{" => Option<Self>.Some(val=Self.LBrace),
            "}" => Option<Self>.Some(val=Self.RBrace),
            "[" => Option<Self>.Some(val=Self.LBracket),
            "]" => Option<Self>.Some(val=Self.RBracket),
            "," => Option<Self>.Some(val=Self.Comma),
            ":" => Option<Self>.Some(val=Self.Colon),
            ";" => Option<Self>.Some(val=Self.Semicolon),
            "." => Option<Self>.Some(val=Self.Dot),
            "->" => Option<Self>.Some(val=Self.Arrow),
            "=>" => Option<Self>.Some(val=Self.FatArrow),
            "+" => Option<Self>.Some(val=Self.Plus),
            "-" => Option<Self>.Some(val=Self.Minus),
            "*" => Option<Self>.Some(val=Self.Star),
            "/" => Option<Self>.Some(val=Self.Slash),
            "%" => Option<Self>.Some(val=Self.Percent),
            "^" => Option<Self>.Some(val=Self.Caret),
            "&" => Option<Self>.Some(val=Self.Ampersand),
            "&&" => Option<Self>.Some(val=Self.AmpersandAmpersand),
            "|" => Option<Self>.Some(val=Self.Pipe),
            "||" => Option<Self>.Some(val=Self.PipePipe),
            "~" => Option<Self>.Some(val=Self.Tilde),
            "!" => Option<Self>.Some(val=Self.Exclamation),
            "=" => Option<Self>.Some(val=Self.Equal),
            "<" => Option<Self>.Some(val=Self.Less),
            ">" => Option<Self>.Some(val=Self.Greater),
            "<angle>" => Option<Self>.Some(val=Self.LAngle),
            ">angle>" => Option<Self>.Some(val=Self.RAngle),
            "+=" => Option<Self>.Some(val=Self.PlusEqual),
            "-=" => Option<Self>.Some(val=Self.MinusEqual),
            "*=" => Option<Self>.Some(val=Self.StarEqual),
            "/=" => Option<Self>.Some(val=Self.SlashEqual),
            "%=" => Option<Self>.Some(val=Self.PercentEqual),
            "^=" => Option<Self>.Some(val=Self.CaretEqual),
            "&=" => Option<Self>.Some(val=Self.AmpersandEqual),
            "|=" => Option<Self>.Some(val=Self.PipeEqual),
            "==" => Option<Self>.Some(val=Self.EqualEqual),
            "!=" => Option<Self>.Some(val=Self.NotEqual),
            "<=" => Option<Self>.Some(val=Self.LessEqual),
            ">=" => Option<Self>.Some(val=Self.GreaterEqual),
            "<<" => Option<Self>.Some(val=Self.LessLess),
            "<<=" => Option<Self>.Some(val=Self.LessLessEqual),
            ">>" => Option<Self>.Some(val=Self.GreaterGreater),
            ">>=" => Option<Self>.Some(val=Self.GreaterGreaterEqual),
            ".." => Option<Self>.Some(val=Self.DotDot),
            "@" => Option<Self>.Some(val=Self.At),
            "<eof>" => Option<Self>.Some(val=Self.EOF),
            _ => Option<Self>.None,
        };
    }
}

pub enum IntSuffix {
    Unsuffixed,
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    Int,
    Uint,
}

impl IntSuffix {
    pub fn spelling() -> str {
        match self {
            Unsuffixed => "",
            I8 => "i8",
            I16 => "i16",
            I32 => "i32",
            I64 => "i64",
            U8 => "u8",
            U16 => "u16",
            U32 => "u32",
            U64 => "u64",
            Int => "int",
            Uint => "uint",
        }
    }

    static pub fn from_text(text: str) -> Option<Self> {
        return match text {
            "" => Option<Self>.Some(val=Self.Unsuffixed),
            "i8" => Option<Self>.Some(val=Self.I8),
            "i16" => Option<Self>.Some(val=Self.I16),
            "i32" => Option<Self>.Some(val=Self.I32),
            "i64" => Option<Self>.Some(val=Self.I64),
            "u8" => Option<Self>.Some(val=Self.U8),
            "u16" => Option<Self>.Some(val=Self.U16),
            "u32" => Option<Self>.Some(val=Self.U32),
            "u64" => Option<Self>.Some(val=Self.U64),
            "int" => Option<Self>.Some(val=Self.Int),
            "uint" => Option<Self>.Some(val=Self.Uint),
            _ => Option<Self>.None,
        };
    }
}

pub enum FloatSuffix {
    Unsuffixed,
    F16,
    F32,
    F64,
    Float,
}

impl FloatSuffix {
    pub fn spelling() -> str {
        match self {
            Unsuffixed => "",
            F16 => "f16",
            F32 => "f32",
            F64 => "f64",
            Float => "float",
        }
    }

    static pub fn from_text(text: str) -> Option<Self> {
        return match text {
            "" => Option<Self>.Some(val=Self.Unsuffixed),
            "f16" => Option<Self>.Some(val=Self.F16),
            "f32" => Option<Self>.Some(val=Self.F32),
            "f64" => Option<Self>.Some(val=Self.F64),
            "float" => Option<Self>.Some(val=Self.Float),
            _ => Option<Self>.None,
        };
    }
}

pub enum TokenPayload {
    Keyword { value: KeywordKind },
    Identifier { value: String },
    Punctuator { value: PunctuatorKind },
    Integer { value: u64, suffix: IntSuffix },
    Float { value: f64, suffix: FloatSuffix },
    Character { value: String },
    StringLiteral { value: String },
    FStrStart,
    FStrLiteral { value: String },
    FStrExprBegin,
    FStrExprEnd,
    FStrEnd,
    EndOfFile,
}

impl Drop for TokenPayload {
    pub fn drop() {
        match self {
            Identifier(value) | Character(value) | StringLiteral(value) |
            FStrLiteral(value) => value.drop(),
            _ => {},
        }
    }
}

pub struct Token {
    payload: TokenPayload,
    span: Span,
}

impl Token {
    static pub fn new(payload: TokenPayload, span: Span) -> Self {
        return Self(payload=payload, span=span);
    }

    pub fn kind() -> TokenPayload& { return &self.payload; }
    pub fn is_keyword_token() -> bool {
        match self.payload { Keyword(_) => true, _ => false }
    }
    pub fn is_punctuator() -> bool {
        match self.payload { Punctuator(_) => true, _ => false }
    }
    pub fn value() -> str {
        match self.payload {
            Keyword(value) => value.spelling(),
            Punctuator(value) => value.spelling(),
            Identifier(value) | Character(value) | StringLiteral(value) |
            FStrLiteral(value) => value.as_str(),
            Integer(_, _) => "<integer>",
            Float(_, _) => "<float>",
            FStrStart => "f\"",
            FStrExprBegin => "{",
            FStrExprEnd => "}",
            FStrEnd => "\"",
            EndOfFile => "<eof>",
        }
    }
    pub fn suffix() -> str {
        match self.payload {
            Integer(_, suffix) => suffix.spelling(),
            Float(_, suffix) => suffix.spelling(),
            _ => "",
        }
    }
    pub fn integer_value() -> u64 {
        match self.payload {
            Integer(value, _) => return value,
            _ => @panic("token is not an integer literal"),
        }
    }
    pub fn float_value() -> f64 {
        match self.payload {
            Float(value, _) => return value,
            _ => @panic("token is not a float literal"),
        }
    }
    pub fn span() -> Span { return self.span; }
    pub fn is_eof() -> bool {
        match self.payload {
            EndOfFile => true,
            _ => false,
        }
    }
    pub fn is_keyword(word: KeywordKind) -> bool {
        match self.payload {
            Keyword(value) => value == word,
            _ => false,
        }
    }
    pub fn is_punct(word: PunctuatorKind) -> bool {
        match self.payload {
            Punctuator(value) => value == word,
            _ => false,
        }
    }
    pub fn is_identifier() -> bool {
        match self.payload {
            Identifier => true,
            _ => false,
        }
    }
    pub fn is_integer() -> bool {
        match self.payload {
            Integer => true,
            _ => false,
        }
    }
}

impl Drop for Token {
    pub fn drop() {
        self.payload.drop();
    }
}

pub fn drop_tokens(tokens: Vec<Token>&) {
    let index: u64 = 0u64;
    while index < tokens.len() {
        tokens[index].drop();
        index += 1u64;
    }
    tokens.drop();
}
