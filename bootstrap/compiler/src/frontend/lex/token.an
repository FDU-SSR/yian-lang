            "as" => Option<Self>.Some(val=Self.As),
            "let" => Option<Self>.Some(val=Self.Let),
            "typedef" => Option<Self>.Some(val=Self.Typedef),
            "struct" => Option<Self>.Some(val=Self.Struct),
            "enum" => Option<Self>.Some(val=Self.Enum),
            "trait" => Option<Self>.Some(val=Self.Trait),
