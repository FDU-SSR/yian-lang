from compiler.frontend.lex.token import Token, TokenPayload, KeywordKind, PunctuatorKind, IntSuffix, FloatSuffix;
from compiler.frontend.source import Position, Span;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.iter import Iterator, IteratorExt, Peekable;
from std.core.ops import Index;
from std.core.option import Option;
from std.core.result import Result;
from std.core.str import CharIter;
from std.core.string import String;
from std.core.vec import Vec;
from std.num.parse_error import ParseNumberError;

pub struct LexError {
    message: String,
    span: Span,
}

impl LexError {
    pub fn message() -> str { return self.message.as_str(); }
    pub fn span() -> Span { return self.span; }
}

impl Drop for LexError {
    pub fn drop() { self.message.drop(); }
}

fn decimal_digit(code: u32) -> bool {
    return code >= u32('0') && code <= u32('9');
}

fn ascii_letter(code: u32) -> bool {
    return (code >= u32('A') && code <= u32('Z')) ||
        (code >= u32('a') && code <= u32('z'));
}

fn ident_start(code: u32) -> bool {
    return code == u32('_') || ascii_letter(code);
}

fn ident_part(code: u32) -> bool {
    return ident_start(code) || decimal_digit(code);
}

fn hexadecimal_literal(raw: str) -> bool {
    return raw.starts_with("0x") || raw.starts_with("0X");
}

fn is_float_literal(raw: str) -> bool {
    let hexadecimal = hexadecimal_literal(raw);
    for current in raw.chars() {
        if current == '.' || current == 'p' || current == 'P' ||
            (!hexadecimal && (current == 'e' || current == 'E')) {
            return true;
        }
    }
    return false;
}

fn number_part(raw: str, code: u32) -> bool {
    if code == u32('+') || code == u32('-') {
        let bytes = raw.as_slice();
        let last = bytes[bytes.len() - 1u64];
        if last == b'p' || last == b'P' { return true; }
        return (last == b'e' || last == b'E') && !hexadecimal_literal(raw);
    }
    return decimal_digit(code) || code == u32('_') || ascii_letter(code);
}

fn integer_suffix(raw: str) -> IntSuffix {
    for suffix in [IntSuffix.I8, IntSuffix.I16, IntSuffix.I32, IntSuffix.I64,
        IntSuffix.U8, IntSuffix.U16, IntSuffix.U32, IntSuffix.U64,
        IntSuffix.Uint, IntSuffix.Int] {
        if raw.ends_with(suffix.spelling()) { return *suffix; }
    }
    return IntSuffix.Unsuffixed;
}

fn float_suffix(raw: str) -> FloatSuffix {
    for suffix in [FloatSuffix.F16, FloatSuffix.F32, FloatSuffix.F64, FloatSuffix.Float] {
        if raw.ends_with(suffix.spelling()) { return *suffix; }
    }
    return FloatSuffix.Unsuffixed;
}

fn numeric_body(raw: str, suffix: str) -> str {
    let bytes = raw.as_slice();
    let suffix_len = suffix.as_slice().len();
    let end = bytes.len() - suffix_len;
    if suffix_len != 0u64 && end != 0u64 && bytes[end - 1u64] == b'_' {
        end -= 1u64;
    }
    return str.from_slice_unchecked(bytes[0u64..end]);
}

fn suffix_max(suffix: IntSuffix) -> u64 {
    return match suffix {
        I8 => 127u64,
        I16 => 32767u64,
        I32 | Int => 2147483647u64,
        I64 => 9223372036854775807u64,
        U8 => 255u64,
        U16 => 65535u64,
        U32 | Uint => 4294967295u64,
        U64 | Unsuffixed => u64.max(),
    };
}

fn number_error_message(problem: ParseNumberError) -> str {
    return match problem {
        Empty => "empty numeric literal",
        MissingDigits => "missing numeric digits",
        InvalidDigit => "invalid numeric digit",
        InvalidSeparator => "invalid numeric separator",
        InvalidFormat => "invalid numeric format",
        InvalidExponent => "invalid numeric exponent",
        UnsupportedRadix => "unsupported floating-point radix",
        Overflow => "numeric literal exceeds its representation range",
    };
}

fn whitespace(code: u32) -> bool {
    if (code >= 9u32 && code <= 13u32) || (code >= 28u32 && code <= 32u32) {
        return true;
    }
    if code == 0x85u32 || code == 0xA0u32 || code == 0x1680u32 ||
    code == 0x202Fu32 || code == 0x205Fu32 || code == 0x3000u32 {
        return true;
    }
    return (code >= 0x2000u32 && code <= 0x200Au32) ||
    (code >= 0x2028u32 && code <= 0x2029u32);
}

fn hex_digit(code: u32) -> i32 {
    if decimal_digit(code) { return i32(code - u32('0')); }
    if code >= u32('A') && code <= u32('F') { return i32(code - u32('A')) + 10; }
    if code >= u32('a') && code <= u32('f') { return i32(code - u32('a')) + 10; }
    return -1;
}

fn simple_escape(code: char) -> Option<char> {
    return match code {
        'n' => Option<char>.Some('\n'),
        't' => Option<char>.Some('\t'),
        'r' => Option<char>.Some('\r'),
        '\\' => Option<char>.Some('\\'),
        '\'' => Option<char>.Some('\''),
        '"' => Option<char>.Some('"'),
        '0' => Option<char>.Some('\0'),
        _ => Option<char>.None,
    };
}

pub struct Lexer {
    cursor: Peekable<CharIter, char>,
    row: u64,
    column: u64,
    tokens: Vec<Token>,
}

impl Lexer {
    static pub fn new(source: str) -> Self {
        return Self(cursor=source.chars().peekable(),
            row=0u64, column=0u64, tokens=Vec<Token>.new());
    }

    fn position() -> Position {
        return Position(row=self.row, column=self.column);
    }

    fn at_end() -> bool { return self.cursor.peek().is_none(); }

    fn peek() -> u32 {
        match self.cursor.peek() {
            Some(value) => u32(*value),
            None => 0xffffffffu32,
        }
    }

    fn peek_next() -> u32 {
        match self.cursor.peek_next() {
            Some(value) => u32(*value),
            None => 0xffffffffu32,
        }
    }

    fn has_pair(first: char, second: char) -> bool {
        return self.peek() == u32(first) && self.peek_next() == u32(second);
    }

    fn advance() -> u32 {
        let current = self.cursor.next();
        let code = u32(*current.unwrap());
        if code == u32('\n') {
            self.row += 1u64;
            self.column = 0u64;
        } else {
            self.column += 1u64;
        }
        return code;
    }

    fn token(payload: TokenPayload, start: Position) -> Token {
        return Token.new(payload, Span(start=start, end=self.position()));
    }

    fn integer_token(start: Position, value: u64, suffix: IntSuffix) -> Token {
        return self.token(TokenPayload.Integer(value=value, suffix=suffix), start);
    }

    fn float_token(start: Position, value: f64, suffix: FloatSuffix) -> Token {
        return self.token(TokenPayload.Float(value=value, suffix=suffix), start);
    }

    fn fail(message: str, start: Position) -> LexError {
        return LexError(message=String.from(&message), span=Span(start=start, end=self.position()));
    }

    fn skip_ignored() -> Result<bool, LexError> {
        let skipped = false;
        loop {
            if self.at_end() { break; }
            if whitespace(self.peek()) {
                skipped = true;
                self.advance();
                continue;
            }
            if self.has_pair('/', '/') {
                skipped = true;
                self.advance();
                self.advance();
                while !self.at_end() && self.peek() != u32('\n') { self.advance(); }
                if !self.at_end() { self.advance(); } else { self.row += 1u64; self.column = 0u64; }
                continue;
            }
            if self.has_pair('/', '*') {
                skipped = true;
                self.advance();
                self.advance();
                loop {
                    if self.at_end() {
                        let at = self.position();
                        return Result<bool, LexError>.Err(msg=self.fail("Unterminated block comment", at));
                    }
                    if self.has_pair('*', '/') {
                        self.advance();
                        self.advance();
                        break;
                    }
                    self.advance();
                }
                continue;
            }
            break;
        }
        return Result<bool, LexError>.Ok(val=skipped);
    }

    fn escape(start: Position) -> Result<char, LexError> {
        if self.at_end() {
            return Result<char, LexError>.Err(msg=self.fail("Invalid escape sequence at end of literal", start));
        }
        let next = char(self.advance());
        match simple_escape(next) {
            Some(value) => return Result<char, LexError>.Ok(val=value),
            None => {},
        }
        if next == 'x' || next == 'X' {
            let code: u32 = 0u32;
            let index: u64 = 0u64;
            while index < 2u64 {
                let d = hex_digit(self.peek());
                if d < 0 {
                    return Result<char, LexError>.Err(msg=self.fail("invalid hexadecimal escape", start));
                }
                code = code * 16u32 + u32(d);
                self.advance();
                index += 1u64;
            }
            return Result<char, LexError>.Ok(val=char(code));
        }
        if next == 'u' || next == 'U' {
            if self.peek() != u32('{') {
                return Result<char, LexError>.Err(msg=self.fail("missing opening brace in Unicode escape", start));
            }
            self.advance();
            let code: u32 = 0u32;
            while !self.at_end() && self.peek() != u32('}') {
                let d = hex_digit(self.peek());
                if d < 0 || code > 0x10ffffu32 / 16u32 {
                    return Result<char, LexError>.Err(msg=self.fail("invalid Unicode escape", start));
                }
                code = code * 16u32 + u32(d);
                self.advance();
            }
            if self.at_end() || code > 0x10ffffu32 ||
            (code >= 0xd800u32 && code <= 0xdfffu32) {
                return Result<char, LexError>.Err(msg=self.fail("invalid Unicode escape", start));
            }
            self.advance();
            return Result<char, LexError>.Ok(val=char(code));
        }
        return Result<char, LexError>.Err(msg=self.fail("invalid escape sequence", start));
    }

    fn quoted(start: Position, quote: u32, byte_literal: bool) -> Result<Token, LexError> {
        let decoded = String.new();
        let transferred = false;
        defer { if !transferred { decoded.drop(); } };
        let count: u64 = 0u64;
        while !self.at_end() && self.peek() != quote {
            let code = self.advance();
            if code == u32('\\') {
                decoded.push(self.escape(start)?);
            } else {
                decoded.push(char(code));
            }
            count += 1u64;
        }
        if self.at_end() {
            return Result<Token, LexError>.Err(msg=self.fail("Unterminated literal", start));
        }
        self.advance();
        if quote == u32('"') {
            transferred = true;
            return Result<Token, LexError>.Ok(val=self.token(TokenPayload.StringLiteral(value=decoded), start));
        }
        if count != 1u64 {
            return Result<Token, LexError>.Err(msg=self.fail("character literal must contain one character", start));
        }
        if byte_literal {
            let first = decoded.chars().next();
            let code = u32(*first.unwrap());
            if code > 255u32 {
                return Result<Token, LexError>.Err(msg=self.fail("byte literal exceeds 255", start));
            }
            return Result<Token, LexError>.Ok(val=self.integer_token(start,
                u64(code), IntSuffix.U8));
        }
        transferred = true;
        return Result<Token, LexError>.Ok(val=self.token(TokenPayload.Character(value=decoded), start));
    }

    fn marker(payload: TokenPayload, position: Position) -> Token {
        return Token.new(payload, Span(start=position, end=position));
    }

    fn fstring() -> Result<bool, LexError> {
        let start = self.position();
        self.advance();
        self.advance();
        self.tokens.push(self.token(TokenPayload.FStrStart, start));
        while !self.at_end() {
            if self.peek() == u32('"') {
                self.advance();
                self.tokens.push(self.marker(TokenPayload.FStrEnd, self.position()));
                return Result<bool, LexError>.Ok(val=true);
            }
            if self.peek() == u32('}') {
                return Result<bool, LexError>.Err(msg=self.fail("unexpected closing brace in f-string", self.position()));
            }
            if self.peek() == u32('{') {
                self.advance();
                self.tokens.push(self.marker(TokenPayload.FStrExprBegin, self.position()));
                let depth: u64 = 1u64;
                loop {
                    let skipped = self.skip_ignored()?;
                    if self.at_end() {
                        return Result<bool, LexError>.Err(msg=self.fail("unterminated f-string expression", self.position()));
                    }
                    if self.has_pair('f', '"') {
                        self.fstring()?;
                        continue;
                    }
                    if self.peek() == u32('}') && depth == 1u64 {
                        let brace_start = self.position();
                        self.advance();
                        self.tokens.push(self.token(TokenPayload.FStrExprEnd, brace_start));
                        break;
                    }
                    let current = self.peek();
                    let next = self.one(skipped)?;
                    if current == u32('{') { depth += 1u64; }
                    if current == u32('}') { depth -= 1u64; }
                    self.tokens.push(next);
                }
                continue;
            }

            let segment_start = self.position();
            let literal = String.new();
            let transferred = false;
            defer { if !transferred { literal.drop(); } };
            while !self.at_end() && self.peek() != u32('"') && self.peek() != u32('{') {
                if self.peek() == u32('}') {
                    return Result<bool, LexError>.Err(msg=self.fail("unexpected closing brace in f-string", self.position()));
                }
                let current = self.advance();
                if current != u32('\\') {
                    literal.push(char(current));
                    continue;
                }
                if self.at_end() {
                    return Result<bool, LexError>.Err(msg=self.fail("unterminated f-string escape", self.position()));
                }
                let escaped = char(self.advance());
                match simple_escape(escaped) {
                    Some(value) => literal.push(value),
                    None => {
                        if escaped != '{' && escaped != '}' { literal.push('\\'); }
                        literal.push(escaped);
                    },
                }
            }
            if !literal.is_empty() {
                self.tokens.push(self.token(TokenPayload.FStrLiteral(value=literal), segment_start));
                transferred = true;
            }
        }
        return Result<bool, LexError>.Ok(val=true);
    }

    fn identifier(start: Position, code: u32) -> Token {
        let raw = String.new();
        raw.push(char(code));
        while !self.at_end() && ident_part(self.peek()) { raw.push(char(self.advance())); }
        match KeywordKind.from_text(raw.as_str()) {
            Some(kind) => {
                raw.drop();
                return self.token(TokenPayload.Keyword(value=kind), start);
            },
            None => return self.token(TokenPayload.Identifier(value=raw), start),
        }
    }

    fn parse_number<T>(body: str, start: Position) -> Result<T, LexError> {
        return match T.parse(body) {
            Ok(value) => Result<T, LexError>.Ok(value),
            Err(error) => Result<T, LexError>.Err(self.fail(number_error_message(error), start)),
        };
    }

    fn number(start: Position, code: u32) -> Result<Token, LexError> {
        let raw = String.new();
        defer raw.drop();
        raw.push(char(code));
        while !self.at_end() && number_part(raw.as_str(), self.peek()) { raw.push(char(self.advance())); }
        if self.peek() == u32('.') && decimal_digit(self.peek_next()) {
            raw.push(char(self.advance()));
            raw.push(char(self.advance()));
            while !self.at_end() && number_part(raw.as_str(), self.peek()) { raw.push(char(self.advance())); }
        }
        if is_float_literal(raw.as_str()) {
            let suffix = float_suffix(raw.as_str());
            let body = numeric_body(raw.as_str(), suffix.spelling());
            let value = self.parse_number<f64>(body, start)?;
            return Result<Token, LexError>.Ok(self.float_token(start, value, suffix));
        }
        let suffix = integer_suffix(raw.as_str());
        let body = numeric_body(raw.as_str(), suffix.spelling());
        let value = self.parse_number<u64>(body, start)?;
        if value > suffix_max(suffix) {
            let message = String.from(&"Integer literal exceeds maximum value for type ");
            defer message.drop();
            message.push_str(suffix.spelling());
            return Result<Token, LexError>.Err(self.fail(message.as_str(), start));
        }
        return Result<Token, LexError>.Ok(self.integer_token(start, value, suffix));
    }

    fn punctuator(start: Position, code: u32, previous_whitespace: bool) -> Result<Token, LexError> {
        if (code == u32('<') || code == u32('>')) && !previous_whitespace {
            let kind = if code == u32('<') { PunctuatorKind.LAngle } else { PunctuatorKind.RAngle };
            return Result<Token, LexError>.Ok(val=self.token(TokenPayload.Punctuator(value=kind), start));
        }
        let raw = String.new();
        defer raw.drop();
        raw.push(char(code));
        while !self.at_end() && self.peek() < 128u32 {
            raw.push(char(self.peek()));
            if PunctuatorKind.from_text(raw.as_str()).is_none() {
                raw.pop();
                break;
            }
            self.advance();
        }
        let kind = match PunctuatorKind.from_text(raw.as_str()) {
            Some(value) => value,
            None => return Result<Token, LexError>.Err(msg=self.fail("invalid punctuator", start)),
        };
        return Result<Token, LexError>.Ok(val=self.token(TokenPayload.Punctuator(value=kind), start));
    }

    fn one(previous_whitespace: bool) -> Result<Token, LexError> {
        let start = self.position();
        if self.at_end() {
            return Result<Token, LexError>.Ok(self.token(TokenPayload.EndOfFile, start));
        }
        let code = self.advance();
        if code == u32('"') || code == u32('\'') { return self.quoted(start, code, false); }
        if code == u32('b') && self.peek() == u32('\'') {
            self.advance();
            return self.quoted(start, u32('\''), true);
        }
        if ident_start(code) { return Result<Token, LexError>.Ok(self.identifier(start, code)); }
        if decimal_digit(code) { return self.number(start, code); }
        return self.punctuator(start, code, previous_whitespace);
    }

    pub fn run() -> Result<Vec<Token>, LexError> {
        defer self.drop();
        loop {
            let skipped = self.skip_ignored()?;
            if self.has_pair('f', '"') {
                self.fstring()?;
                continue;
            }
            let next = self.one(skipped)?;
            let done = next.is_eof();
            self.tokens.push(next);
            if done {
                let output = self.tokens;
                self.tokens = Vec<Token>.new();
                return Result<Vec<Token>, LexError>.Ok(val=output);
            }
        }
    }
}

impl Drop for Lexer {
    pub fn drop() {
        let index: u64 = 0u64;
        while index < self.tokens.len() {
            self.tokens[index].drop();
            index += 1u64;
        }
        self.tokens.drop();
    }
}
