from compiler.frontend.lex.number import parse_number;
from compiler.frontend.source import Position, Span;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.iter import Iterator;
from std.core.ops import Index;
from std.core.range import Range;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;

pub enum TokenKind {
    Keyword,
    Identifier,
    Punctuator,
    Integer,
    Float,
    Character,
    StringLiteral,
    Boolean,
    FStrStart,
    FStrLiteral,
    FStrExprBegin,
    FStrExprEnd,
    FStrEnd,
    EndOfFile,
}

pub struct Token {
    kind: TokenKind,
    raw: String,
    value: String,
    suffix: String,
    bits: u64,
    span: Span,
}

impl Token {
    pub fn kind() -> TokenKind { return self.kind; }
    pub fn raw() -> str { return self.raw.as_str(); }
    pub fn value() -> str { return self.value.as_str(); }
    pub fn suffix() -> str { return self.suffix.as_str(); }
    pub fn bits() -> u64 { return self.bits; }
    pub fn span() -> Span { return self.span; }
    pub fn is_eof() -> bool {
        match self.kind {
            EndOfFile => true,
            _ => false,
        }
    }
    pub fn is_keyword(word: str) -> bool {
        match self.kind {
            Keyword => self.value.as_str() == word,
            _ => false,
        }
    }
    pub fn is_punct(word: str) -> bool {
        match self.kind {
            Punctuator => self.value.as_str() == word,
            _ => false,
        }
    }
    pub fn is_identifier() -> bool {
        match self.kind {
            Identifier => true,
            _ => false,
        }
    }
    pub fn is_integer() -> bool {
        match self.kind {
            Integer => true,
            _ => false,
        }
    }
}

impl Drop for Token {
    pub fn drop() {
        self.raw.drop();
        self.value.drop();
        self.suffix.drop();
    }
}

pub struct LexError {
    message: String,
    span: Span,
}

impl LexError {
    pub fn message() -> str { return self.message.as_str(); }
    pub fn span() -> Span { return self.span; }
}

impl Drop for LexError {
    pub fn drop() { self.message.drop(); }
}

fn keyword(word: str) -> bool {
    return word == "import" || word == "from" || word == "as" || word == "let" ||
        word == "typedef" || word == "struct" || word == "enum" || word == "trait" ||
        word == "impl" || word == "fn" || word == "dyn" || word == "pub" ||
        word == "ffi" || word == "extern" || word == "opaque" || word == "type" ||
        word == "static" || word == "const" || word == "comptime" || word == "inline" ||
        word == "intrinsic" || word == "if" || word == "elif" || word == "else" ||
        word == "match" || word == "for" || word == "while" || word == "loop" ||
        word == "break" || word == "continue" || word == "return" || word == "defer" ||
        word == "assert" || word == "in" || word == "typeof" || word == "del" ||
        word == "true" || word == "false" || word == "IS_RAW_MODE" || word == "_" ||
        word == "void" || word == "bool" || word == "char" || word == "str" ||
        word == "i8" || word == "i16" || word == "i32" || word == "i64" ||
        word == "u8" || word == "u16" || word == "u32" || word == "u64" ||
        word == "f16" || word == "f32" || word == "f64" || word == "int" ||
        word == "uint" || word == "float";
}

fn punctuator(word: str) -> bool {
    return word == "(" || word == ")" || word == "{" || word == "}" ||
        word == "[" || word == "]" || word == "," || word == ":" ||
        word == ";" || word == "." || word == "->" || word == "=>" ||
        word == "+" || word == "-" || word == "*" || word == "/" ||
        word == "%" || word == "^" || word == "&" || word == "&&" ||
        word == "|" || word == "||" || word == "~" || word == "!" ||
        word == "=" || word == "<" || word == ">" || word == "+=" ||
        word == "-=" || word == "*=" || word == "/=" || word == "%=" ||
        word == "^=" || word == "&=" || word == "|=" || word == "==" ||
        word == "!=" || word == "<=" || word == ">=" || word == "<<" ||
        word == "<<=" || word == ">>" || word == ">>=" || word == ".." ||
        word == "@";
}

fn ident_start(code: u32) -> bool {
    return code == 95u32 || (code >= 65u32 && code <= 90u32) ||
        (code >= 97u32 && code <= 122u32);
}

fn ident_part(code: u32) -> bool {
    return ident_start(code) || (code >= 48u32 && code <= 57u32);
}

fn number_part(code: u32) -> bool {
    return (code >= 48u32 && code <= 57u32) || code == 95u32 ||
        code == 43u32 || code == 45u32 ||
        (code >= 97u32 && code <= 102u32) ||
        (code >= 65u32 && code <= 70u32) ||
        code == 120u32 || code == 88u32 || code == 98u32 || code == 66u32 ||
        code == 111u32 || code == 79u32 || code == 112u32 || code == 80u32 ||
        code == 105u32 || code == 117u32;
}

fn whitespace(code: u32) -> bool {
    if (code >= 9u32 && code <= 13u32) || (code >= 28u32 && code <= 32u32) {
        return true;
    }
    if code == 0x85u32 || code == 0xA0u32 || code == 0x1680u32 ||
        code == 0x202Fu32 || code == 0x205Fu32 || code == 0x3000u32 {
        return true;
    }
    return (code >= 0x2000u32 && code <= 0x200Au32) ||
        (code >= 0x2028u32 && code <= 0x2029u32);
}

fn hex_digit(code: u32) -> i32 {
    if code >= 48u32 && code <= 57u32 { return i32(code - 48u32); }
    if code >= 65u32 && code <= 70u32 { return i32(code - 65u32) + 10; }
    if code >= 97u32 && code <= 102u32 { return i32(code - 97u32) + 10; }
    return -1;
}

pub struct Lexer {
    source: str,
    offset: u64,
    row: u64,
    column: u64,
    tokens: Vec<Token>,
}

impl Lexer {
    static pub fn new(source: str) -> Self {
        return Self(source=source, offset=0u64, row=0u64, column=0u64, tokens=Vec<Token>.new());
    }

    fn position() -> Position {
        return Position(row=self.row, column=self.column, byte=self.offset);
    }

    fn at_end() -> bool { return self.offset >= self.source.as_slice().len(); }

    fn peek_byte(ahead: u64) -> u8 {
        let bytes = self.source.as_slice();
        if self.offset + ahead >= bytes.len() { return 0u8; }
        return bytes[self.offset + ahead];
    }

    fn width() -> u64 {
        let byte = self.peek_byte(0u64);
        if byte < 128u8 { return 1u64; }
        if byte < 224u8 { return 2u64; }
        if byte < 240u8 { return 3u64; }
        return 4u64;
    }

    fn peek() -> u32 {
        if self.at_end() { return 0xffffffffu32; }
        let first = u32(self.peek_byte(0u64));
        if first < 128u32 { return first; }
        if first < 224u32 {
            return ((first & 31u32) << 6u32) | (u32(self.peek_byte(1u64)) & 63u32);
        }
        if first < 240u32 {
            return ((first & 15u32) << 12u32) |
                ((u32(self.peek_byte(1u64)) & 63u32) << 6u32) |
                (u32(self.peek_byte(2u64)) & 63u32);
        }
        return ((first & 7u32) << 18u32) |
            ((u32(self.peek_byte(1u64)) & 63u32) << 12u32) |
            ((u32(self.peek_byte(2u64)) & 63u32) << 6u32) |
            (u32(self.peek_byte(3u64)) & 63u32);
    }

    fn advance() -> u32 {
        let code = self.peek();
        self.offset += self.width();
        if code == 10u32 {
            self.row += 1u64;
            self.column = 0u64;
        } else {
            self.column += 1u64;
        }
        return code;
    }

    fn slice(start: u64, end: u64) -> str {
        return str.from_slice_unchecked(self.source.as_slice()[start..end]);
    }

    fn token(kind: TokenKind, start: Position, value: String, suffix: String, bits: u64) -> Token {
        return Token(kind=kind, raw=String.from(&self.slice(start.byte, self.offset)),
            value=value, suffix=suffix, bits=bits, span=Span(start=start, end=self.position()));
    }

    fn fail(message: str, start: Position) -> LexError {
        return LexError(message=String.from(&message), span=Span(start=start, end=self.position()));
    }

    fn skip_ignored() -> Result<bool, LexError> {
        let skipped = false;
        loop {
            if self.at_end() { break; }
            if whitespace(self.peek()) {
                skipped = true;
                self.advance();
                continue;
            }
            if self.peek_byte(0u64) == b'/' && self.peek_byte(1u64) == b'/' {
                skipped = true;
                self.advance(); self.advance();
                while !self.at_end() && self.peek() != 10u32 { self.advance(); }
                if !self.at_end() { self.advance(); }
                else { self.row += 1u64; self.column = 0u64; }
                continue;
            }
            if self.peek_byte(0u64) == b'/' && self.peek_byte(1u64) == b'*' {
                skipped = true;
                self.advance(); self.advance();
                loop {
                    if self.at_end() {
                        let at = self.position();
                        return Result<bool, LexError>.Err(msg=self.fail("Unterminated block comment", at));
                    }
                    if self.peek_byte(0u64) == b'*' && self.peek_byte(1u64) == b'/' {
                        self.advance(); self.advance();
                        break;
                    }
                    self.advance();
                }
                continue;
            }
            break;
        }
        return Result<bool, LexError>.Ok(val=skipped);
    }

    fn escape(start: Position) -> Result<char, LexError> {
        if self.at_end() {
            return Result<char, LexError>.Err(msg=self.fail("Invalid escape sequence at end of literal", start));
        }
        let next = self.advance();
        if next == 110u32 { return Result<char, LexError>.Ok(val='\n'); }
        if next == 116u32 { return Result<char, LexError>.Ok(val='\t'); }
        if next == 114u32 { return Result<char, LexError>.Ok(val='\r'); }
        if next == 92u32 { return Result<char, LexError>.Ok(val='\\'); }
        if next == 39u32 { return Result<char, LexError>.Ok(val='\''); }
        if next == 34u32 { return Result<char, LexError>.Ok(val='"'); }
        if next == 48u32 { return Result<char, LexError>.Ok(val='\0'); }
        if next == 120u32 || next == 88u32 {
            let code: u32 = 0u32;
            let index: u64 = 0u64;
            while index < 2u64 {
                let d = hex_digit(self.peek());
                if d < 0 {
                    return Result<char, LexError>.Err(msg=self.fail("invalid hexadecimal escape", start));
                }
                code = code * 16u32 + u32(d);
                self.advance();
                index += 1u64;
            }
            return Result<char, LexError>.Ok(val=char(code));
        }
        if next == 117u32 || next == 85u32 {
            if self.peek() != 123u32 {
                return Result<char, LexError>.Err(msg=self.fail("missing opening brace in Unicode escape", start));
            }
            self.advance();
            let code: u32 = 0u32;
            while !self.at_end() && self.peek() != 125u32 {
                let d = hex_digit(self.peek());
                if d < 0 || code > 0x10ffffu32 / 16u32 {
                    return Result<char, LexError>.Err(msg=self.fail("invalid Unicode escape", start));
                }
                code = code * 16u32 + u32(d);
                self.advance();
            }
            if self.at_end() || code > 0x10ffffu32 ||
                (code >= 0xd800u32 && code <= 0xdfffu32) {
                return Result<char, LexError>.Err(msg=self.fail("invalid Unicode escape", start));
            }
            self.advance();
            return Result<char, LexError>.Ok(val=char(code));
        }
        return Result<char, LexError>.Err(msg=self.fail("invalid escape sequence", start));
    }

    fn quoted(start: Position, quote: u32, byte_literal: bool) -> Result<Token, LexError> {
        let decoded = String.new();
        let count: u64 = 0u64;
        while !self.at_end() && self.peek() != quote {
            let code = self.advance();
            if code == 92u32 {
                let escaped = self.escape(start);
                match escaped {
                    Ok(value) => decoded.push(value),
                    Err(problem) => { decoded.drop(); return Result<Token, LexError>.Err(msg=problem); },
                }
            } else {
                decoded.push(char(code));
            }
            count += 1u64;
        }
        if self.at_end() {
            decoded.drop();
            return Result<Token, LexError>.Err(msg=self.fail("Unterminated literal", start));
        }
        self.advance();
        if quote == 34u32 {
            return Result<Token, LexError>.Ok(val=self.token(TokenKind.StringLiteral, start, decoded, String.new(), 0u64));
        }
        if count != 1u64 {
            decoded.drop();
            return Result<Token, LexError>.Err(msg=self.fail("character literal must contain one character", start));
        }
        if byte_literal {
            let first = decoded.chars().next();
            let code = u32(*first.unwrap());
            decoded.drop();
            if code > 255u32 {
                return Result<Token, LexError>.Err(msg=self.fail("byte literal exceeds 255", start));
            }
            let integer = u64(code).to_string_radix(10u64);
            return Result<Token, LexError>.Ok(val=self.token(TokenKind.Integer, start, integer, String.from(&"u8"), 0u64));
        }
        return Result<Token, LexError>.Ok(val=self.token(TokenKind.Character, start, decoded, String.new(), 0u64));
    }

    fn marker(kind: TokenKind, position: Position, raw: str, value: str) -> Token {
        return Token(kind=kind, raw=String.from(&raw), value=String.from(&value),
            suffix=String.new(), bits=0u64, span=Span(start=position, end=position));
    }

    fn fstring() -> Result<bool, LexError> {
        let start = self.position();
        self.advance(); self.advance();
        self.tokens.push(self.token(TokenKind.FStrStart, start, String.from(&"f\""), String.new(), 0u64));
        while !self.at_end() {
            if self.peek() == 34u32 {
                self.advance();
                self.tokens.push(self.marker(TokenKind.FStrEnd, self.position(), "\"", ""));
                return Result<bool, LexError>.Ok(val=true);
            }
            if self.peek() == 125u32 {
                return Result<bool, LexError>.Err(msg=self.fail("unexpected closing brace in f-string", self.position()));
            }
            if self.peek() == 123u32 {
                self.advance();
                self.tokens.push(self.marker(TokenKind.FStrExprBegin, self.position(), "{", ""));
                let depth: u64 = 1u64;
                loop {
                    let skipped = match self.skip_ignored() {
                        Ok(value) => value,
                        Err(problem) => return Result<bool, LexError>.Err(msg=problem),
                    };
                    if self.at_end() {
                        return Result<bool, LexError>.Err(msg=self.fail("unterminated f-string expression", self.position()));
                    }
                    if self.peek_byte(0u64) == b'f' && self.peek_byte(1u64) == b'"' {
                        let nested = self.fstring();
                        if nested.is_err() { return nested; }
                        continue;
                    }
                    if self.peek() == 125u32 && depth == 1u64 {
                        let brace_start = self.position();
                        self.advance();
                        self.tokens.push(self.token(TokenKind.FStrExprEnd, brace_start, String.new(), String.new(), 0u64));
                        break;
                    }
                    let current = self.peek();
                    let next = match self.one(skipped) {
                        Ok(value) => value,
                        Err(problem) => return Result<bool, LexError>.Err(msg=problem),
                    };
                    if current == 123u32 { depth += 1u64; }
                    if current == 125u32 { depth -= 1u64; }
                    self.tokens.push(next);
                }
                continue;
            }

            let segment_start = self.position();
            let literal = String.new();
            while !self.at_end() && self.peek() != 34u32 && self.peek() != 123u32 {
                if self.peek() == 125u32 {
                    literal.drop();
                    return Result<bool, LexError>.Err(msg=self.fail("unexpected closing brace in f-string", self.position()));
                }
                let current = self.advance();
                if current != 92u32 {
                    literal.push(char(current));
                    continue;
                }
                if self.at_end() {
                    literal.drop();
                    return Result<bool, LexError>.Err(msg=self.fail("unterminated f-string escape", self.position()));
                }
                let escaped = self.advance();
                if escaped == 110u32 { literal.push('\n'); }
                elif escaped == 116u32 { literal.push('\t'); }
                elif escaped == 114u32 { literal.push('\r'); }
                elif escaped == 48u32 { literal.push('\0'); }
                elif escaped == 92u32 { literal.push('\\'); }
                elif escaped == 39u32 { literal.push('\''); }
                elif escaped == 34u32 { literal.push('"'); }
                elif escaped == 123u32 { literal.push('{'); }
                elif escaped == 125u32 { literal.push('}'); }
                else { literal.push('\\'); literal.push(char(escaped)); }
            }
            if literal.len() != 0u64 {
                self.tokens.push(self.token(TokenKind.FStrLiteral, segment_start, literal, String.new(), 0u64));
            } else {
                literal.drop();
            }
        }
        return Result<bool, LexError>.Ok(val=true);
    }

    fn one(previous_whitespace: bool) -> Result<Token, LexError> {
        let start = self.position();
        if self.at_end() {
            return Result<Token, LexError>.Ok(val=self.token(TokenKind.EndOfFile, start, String.from(&"<eof>"), String.new(), 0u64));
        }
        let code = self.advance();
        if code == 34u32 { return self.quoted(start, code, false); }
        if code == 39u32 { return self.quoted(start, code, false); }
        if code == 98u32 && self.peek() == 39u32 {
            self.advance();
            return self.quoted(start, 39u32, true);
        }
        if ident_start(code) {
            while !self.at_end() && ident_part(self.peek()) { self.advance(); }
            let raw = self.slice(start.byte, self.offset);
            if keyword(raw) {
                return Result<Token, LexError>.Ok(val=self.token(TokenKind.Keyword, start, String.from(&raw), String.new(), 0u64));
            }
            return Result<Token, LexError>.Ok(val=self.token(TokenKind.Identifier, start, String.from(&raw), String.new(), 0u64));
        }
        if code >= 48u32 && code <= 57u32 {
            while !self.at_end() && number_part(self.peek()) { self.advance(); }
            if self.peek_byte(0u64) == b'.' &&
                self.peek_byte(1u64) >= b'0' && self.peek_byte(1u64) <= b'9' {
                self.advance(); self.advance();
                while !self.at_end() && number_part(self.peek()) { self.advance(); }
            }
            let raw = self.slice(start.byte, self.offset);
            let parsed = match parse_number(raw) {
                Ok(value) => value,
                Err(message) => {
                    let problem = self.fail(message.as_str(), start);
                    message.drop();
                    return Result<Token, LexError>.Err(msg=problem);
                },
            };
            let kind = TokenKind.Integer;
            if parsed.is_float() { kind = TokenKind.Float; }
            let token = self.token(kind, start, String.from(&parsed.integer()),
                String.from(&parsed.suffix()), parsed.float_bits());
            parsed.drop();
            return Result<Token, LexError>.Ok(val=token);
        }

        if (code == 60u32 || code == 62u32) && !previous_whitespace {
            let label = "<angle>";
            if code == 62u32 { label = ">angle>"; }
            return Result<Token, LexError>.Ok(val=self.token(TokenKind.Punctuator, start,
                String.from(&label), String.new(), 0u64));
        }
        while !self.at_end() && self.peek() < 128u32 {
            let candidate = self.slice(start.byte, self.offset + 1u64);
            if !punctuator(candidate) { break; }
            self.advance();
        }
        let raw = self.slice(start.byte, self.offset);
        if !punctuator(raw) {
            return Result<Token, LexError>.Err(msg=self.fail("invalid punctuator", start));
        }
        return Result<Token, LexError>.Ok(val=self.token(TokenKind.Punctuator, start,
            String.from(&raw), String.new(), 0u64));
    }

    pub fn run() -> Result<Vec<Token>, LexError> {
        loop {
            let skipped = match self.skip_ignored() {
                Ok(value) => value,
                Err(problem) => { self.drop(); return Result<Vec<Token>, LexError>.Err(msg=problem); },
            };
            if self.peek_byte(0u64) == b'f' && self.peek_byte(1u64) == b'"' {
                let result = self.fstring();
                match result {
                    Ok(_) => continue,
                    Err(problem) => { self.drop(); return Result<Vec<Token>, LexError>.Err(msg=problem); },
                }
            }
            let next = match self.one(skipped) {
                Ok(value) => value,
                Err(problem) => { self.drop(); return Result<Vec<Token>, LexError>.Err(msg=problem); },
            };
            let done = next.is_eof();
            self.tokens.push(next);
            if done {
                let output = self.tokens;
                self.tokens = Vec<Token>.new();
                return Result<Vec<Token>, LexError>.Ok(val=output);
            }
        }
    }
}

pub fn drop_tokens(tokens: Vec<Token>&) {
    let index: u64 = 0u64;
    while index < tokens.len() {
        tokens[index].drop();
        index += 1u64;
    }
    tokens.drop();
}

impl Drop for Lexer {
    pub fn drop() {
        let index: u64 = 0u64;
        while index < self.tokens.len() {
            self.tokens[index].drop();
            index += 1u64;
        }
        self.tokens.drop();
    }
}
