from std.core.ops import Index;

pub fn literal_base(raw: str) -> u32 {
    if raw.starts_with("0x") || raw.starts_with("0X") { return 16u32; }
    if raw.starts_with("0b") || raw.starts_with("0B") { return 2u32; }
    if raw.starts_with("0o") || raw.starts_with("0O") { return 8u32; }
    return 10u32;
}

pub fn prefix_len(raw: str) -> u64 {
    if literal_base(raw) != 10u32 { return 2u64; }
    return 0u64;
}

pub fn digit(byte: u8) -> i32 {
    if byte >= b'0' && byte <= b'9' { return i32(byte - b'0'); }
    if byte >= b'a' && byte <= b'f' { return i32(byte - b'a') + 10; }
    if byte >= b'A' && byte <= b'F' { return i32(byte - b'A') + 10; }
    return -1;
}

pub fn is_float_literal(raw: str) -> bool {
    let base = literal_base(raw);
    let bytes = raw.as_slice();
    let index: u64 = 0u64;
    while index < bytes.len() {
        let current = bytes[index];
        if current == b'.' || current == b'p' || current == b'P' ||
            (base != 16u32 && (current == b'e' || current == b'E')) {
            return true;
        }
        index += 1u64;
    }
    return false;
}
