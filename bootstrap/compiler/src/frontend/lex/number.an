from compiler.frontend.lex.big_uint import BigUInt;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.ops import Index;
from std.core.range import Range;
from std.core.result import Result;
from std.core.string import String;

pub struct NumberValue {
    is_float: bool,
    integer: String,
    float_bits: u64,
    suffix: String,
}

impl NumberValue {
    pub fn is_float() -> bool { return self.is_float; }
    pub fn integer() -> str { return self.integer.as_str(); }
    pub fn float_bits() -> u64 { return self.float_bits; }
    pub fn suffix() -> str { return self.suffix.as_str(); }
}

impl Drop for NumberValue {
    pub fn drop() {
        self.integer.drop();
        self.suffix.drop();
    }
}

fn digit(byte: u8) -> i32 {
    if byte >= b'0' && byte <= b'9' { return i32(byte - b'0'); }
    if byte >= b'a' && byte <= b'f' { return i32(byte - b'a') + 10; }
    if byte >= b'A' && byte <= b'F' { return i32(byte - b'A') + 10; }
    return -1;
}

fn error(message: str) -> Result<NumberValue, String> {
    return Result<NumberValue, String>.Err(msg=String.from(&message));
}

fn suffix_max(suffix: str) -> u64 {
    if suffix == "i8" { return 127u64; }
    if suffix == "i16" { return 32767u64; }
    if suffix == "i32" || suffix == "int" { return 2147483647u64; }
    if suffix == "i64" { return 9223372036854775807u64; }
    if suffix == "u8" { return 255u64; }
    if suffix == "u16" { return 65535u64; }
    if suffix == "u32" || suffix == "uint" { return 4294967295u64; }
    return u64.max();
}

fn div_rounded(numerator: BigUInt&, denominator: BigUInt&) -> u64 {
    let remainder = numerator.copy();
    defer remainder.drop();
    let quotient: u64 = 0u64;
    if remainder.compare(denominator) >= 0 {
        let shift = remainder.bit_length() - denominator.bit_length();
        if shift >= 64u64 {
            @panic("floating-point quotient exceeds binary64 precision");
        }
        loop {
            let part = denominator.shifted(shift);
            if remainder.compare(&part) >= 0 {
                remainder.sub(&part);
                quotient |= 1u64 << shift;
            }
            part.drop();
            if shift == 0u64 { break; }
            shift -= 1u64;
        }
    }
    let twice = remainder.shifted(1u64);
    let comparison = twice.compare(denominator);
    twice.drop();
    if comparison > 0 || (comparison == 0 && (quotient & 1u64) != 0u64) {
        quotient += 1u64;
    }
    return quotient;
}

fn rational_bits(numerator: BigUInt&, denominator: BigUInt&) -> u64 {
    if numerator.is_zero() { return 0u64; }
    let exponent = i64(numerator.bit_length()) - i64(denominator.bit_length());
    if exponent >= 0i64 {
        let scaled = denominator.shifted(u64(exponent));
        if numerator.compare(&scaled) < 0 { exponent -= 1i64; }
        scaled.drop();
    } else {
        let scaled = numerator.shifted(u64(-exponent));
        if scaled.compare(denominator) < 0 { exponent -= 1i64; }
        scaled.drop();
    }
    if exponent > 1023i64 { return 0x7ff0000000000000u64; }
    if exponent < -1075i64 { return 0u64; }

    let scale: i64 = 1074i64;
    if exponent >= -1022i64 { scale = 52i64 - exponent; }
    let left = numerator.copy();
    let right = denominator.copy();
    if scale >= 0i64 {
        let shifted = left.shifted(u64(scale));
        left.drop();
        left = shifted;
    } else {
        let shifted = right.shifted(u64(-scale));
        right.drop();
        right = shifted;
    }
    let rounded = div_rounded(&left, &right);
    left.drop();
    right.drop();

    if exponent < -1022i64 {
        if rounded == (1u64 << 52u64) { return 1u64 << 52u64; }
        return rounded;
    }
    if rounded == (1u64 << 53u64) {
        exponent += 1i64;
        if exponent > 1023i64 { return 0x7ff0000000000000u64; }
        return (u64(exponent + 1023i64) << 52u64);
    }
    return (u64(exponent + 1023i64) << 52u64) | (rounded - (1u64 << 52u64));
}

fn parse_exponent(bytes: u8[], start: u64) -> Result<i64, String> {
    let position = start;
    let negative = false;
    if position < bytes.len() && (bytes[position] == b'+' || bytes[position] == b'-') {
        negative = bytes[position] == b'-';
        position += 1u64;
    }
    if position == bytes.len() {
        return Result<i64, String>.Err(msg=String.from(&"missing exponent digits"));
    }
    let value: i64 = 0i64;
    let saw_digit = false;
    while position < bytes.len() {
        let next = bytes[position];
        position += 1u64;
        if next == b'_' { continue; }
        let d = digit(next);
        if d < 0 || d > 9 {
            return Result<i64, String>.Err(msg=String.from(&"invalid exponent digit"));
        }
        saw_digit = true;
        if value < 1000000i64 {
            value = value * 10i64 + i64(d);
        }
    }
    if !saw_digit {
        return Result<i64, String>.Err(msg=String.from(&"missing exponent digits"));
    }
    if negative { value = -value; }
    return Result<i64, String>.Ok(val=value);
}

// Return a positive literal's exact value; unary minus belongs to the parser.
pub fn parse_number(raw: str) -> Result<NumberValue, String> {
    let base: u32 = 10u32;
    let body_start: u64 = 0u64;
    if raw.starts_with("0x") || raw.starts_with("0X") {
        base = 16u32;
        body_start = 2u64;
    } elif raw.starts_with("0b") || raw.starts_with("0B") {
        base = 2u32;
        body_start = 2u64;
    } elif raw.starts_with("0o") || raw.starts_with("0O") {
        base = 8u32;
        body_start = 2u64;
    }
    let bytes = raw.as_slice();
    let is_float = false;
    let position: u64 = 0u64;
    while position < bytes.len() {
        let current = bytes[position];
        if current == b'.' || current == b'p' || current == b'P' ||
            (base != 16u32 && (current == b'e' || current == b'E')) {
            is_float = true;
        }
        position += 1u64;
    }
    if is_float && (base == 2u32 || base == 8u32) {
        return error("binary and octal float literals are not supported");
    }

    let suffix = String.new();
    let body_end = bytes.len();
    if is_float {
        if raw.ends_with("f16") { suffix.push_str("f16"); body_end -= 3u64; }
        elif raw.ends_with("f32") { suffix.push_str("f32"); body_end -= 3u64; }
        elif raw.ends_with("f64") { suffix.push_str("f64"); body_end -= 3u64; }
        elif raw.ends_with("float") { suffix.push_str("float"); body_end -= 5u64; }
    } else {
        if raw.ends_with("i8") { suffix.push_str("i8"); body_end -= 2u64; }
        elif raw.ends_with("i16") { suffix.push_str("i16"); body_end -= 3u64; }
        elif raw.ends_with("i32") { suffix.push_str("i32"); body_end -= 3u64; }
        elif raw.ends_with("i64") { suffix.push_str("i64"); body_end -= 3u64; }
        elif raw.ends_with("u8") { suffix.push_str("u8"); body_end -= 2u64; }
        elif raw.ends_with("u16") { suffix.push_str("u16"); body_end -= 3u64; }
        elif raw.ends_with("u32") { suffix.push_str("u32"); body_end -= 3u64; }
        elif raw.ends_with("u64") { suffix.push_str("u64"); body_end -= 3u64; }
        elif raw.ends_with("int") { suffix.push_str("int"); body_end -= 3u64; }
        elif raw.ends_with("uint") { suffix.push_str("uint"); body_end -= 4u64; }
    }
    if body_end <= body_start {
        suffix.drop();
        return error("missing numeric digits");
    }

    let significand = BigUInt.zero();
    let fractional_digits: u64 = 0u64;
    let digits: u64 = 0u64;
    let saw_dot = false;
    let exponent: i64 = 0i64;
    position = body_start;
    while position < body_end {
        let current = bytes[position];
        if is_float && current == b'.' {
            if saw_dot { significand.drop(); suffix.drop(); return error("multiple decimal points"); }
            saw_dot = true;
            position += 1u64;
            continue;
        }
        if is_float && (current == b'p' || current == b'P' ||
            (base == 10u32 && (current == b'e' || current == b'E'))) {
            let parsed = parse_exponent(bytes[0u64..body_end], position + 1u64);
            exponent = match parsed {
                Ok(value) => value,
                Err(message) => {
                    significand.drop(); suffix.drop();
                    return Result<NumberValue, String>.Err(msg=message);
                },
            };
            position = body_end;
            break;
        }
        if current == b'_' { position += 1u64; continue; }
        let d = digit(current);
        if d < 0 || u32(d) >= base {
            significand.drop(); suffix.drop();
            return error("invalid numeric digit");
        }
        significand.mul_small(base);
        significand.add_small(u32(d));
        digits += 1u64;
        if saw_dot { fractional_digits += 1u64; }
        position += 1u64;
    }
    if digits == 0u64 {
        significand.drop(); suffix.drop();
        return error("missing numeric digits");
    }
    if !is_float {
        if suffix.len() != 0u64 {
            let maximum = BigUInt.from_u64(suffix_max(suffix.as_str()));
            let out_of_range = significand.compare(&maximum) > 0;
            maximum.drop();
            if out_of_range {
                let decimal_text = String.new();
                let digit_index = body_start;
                while digit_index < body_end {
                    if bytes[digit_index] != b'_' { decimal_text.push(char(bytes[digit_index])); }
                    digit_index += 1u64;
                }
                let message = String.from(&"Integer literal ");
                message.push_str(decimal_text.as_str());
                message.push_str(" exceeds maximum value for type ");
                message.push_str(suffix.as_str());
                decimal_text.drop();
                significand.drop(); suffix.drop();
                return Result<NumberValue, String>.Err(msg=message);
            }
        }
        let decimal = significand.decimal();
        significand.drop();
        return Result<NumberValue, String>.Ok(
            val=NumberValue(is_float=false, integer=decimal, float_bits=0u64, suffix=suffix)
        );
    }

    let bits: u64 = 0u64;
    if !significand.is_zero() {
        if base == 16u32 {
            let binary_exponent = exponent - i64(fractional_digits * 4u64);
            let magnitude = i64(significand.bit_length()) + binary_exponent;
            if magnitude > 1200i64 {
                bits = 0x7ff0000000000000u64;
            } elif magnitude >= -1200i64 {
                let numerator = significand.copy();
                let denominator = BigUInt.from_u64(1u64);
                if binary_exponent >= 0i64 {
                    let shifted = numerator.shifted(u64(binary_exponent));
                    numerator.drop(); numerator = shifted;
                } else {
                    let shifted = denominator.shifted(u64(-binary_exponent));
                    denominator.drop(); denominator = shifted;
                }
                bits = rational_bits(&numerator, &denominator);
                numerator.drop(); denominator.drop();
            }
        } else {
            let decimal_exponent = exponent - i64(fractional_digits);
            let magnitude = i64(digits) - 1i64 + decimal_exponent;
            if magnitude > 400i64 {
                bits = 0x7ff0000000000000u64;
            } elif magnitude >= -400i64 {
                let numerator = significand.copy();
                let denominator = BigUInt.from_u64(1u64);
                if decimal_exponent >= 0i64 {
                    let index: i64 = 0i64;
                    while index < decimal_exponent {
                        numerator.mul_small(10u32);
                        index += 1i64;
                    }
                } else {
                    let index: i64 = 0i64;
                    while index < -decimal_exponent {
                        denominator.mul_small(10u32);
                        index += 1i64;
                    }
                }
                bits = rational_bits(&numerator, &denominator);
                numerator.drop(); denominator.drop();
            }
        }
    }
    significand.drop();
    if base == 16u32 && bits == 0x7ff0000000000000u64 {
        suffix.drop();
        return error("hexadecimal float literal overflows binary64");
    }
    return Result<NumberValue, String>.Ok(
        val=NumberValue(is_float=true, integer=String.new(), float_bits=bits, suffix=suffix)
    );
}
