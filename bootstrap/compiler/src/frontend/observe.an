from compiler.frontend.lex.token import Token;
from compiler.frontend.json import append_string, append_span, append_u64;
from std.core.drop import Drop;
from std.core.fmt import ToString;
from std.core.ops import Index;
from std.core.string import String;
from std.core.vec import Vec;

fn token_kind(token: Token&) -> str {
    match token.kind() {
        Keyword(_) => "Keyword",
        Identifier(_) => "Identifier",
        Punctuator(_) => "Punctuator",
        Integer(_, _) => "Integer",
        Float(_, _) => "Float",
        Character(_) => "Character",
        StringLiteral(_) => "StringLiteral",
        FStrStart => "FStrStart",
        FStrLiteral(_) => "FStrLiteral",
        FStrExprBegin => "FStrExprBegin",
        FStrExprEnd => "FStrExprEnd",
        FStrEnd => "FStrEnd",
        EndOfFile => "EndOfFile",
    }
}

pub fn lex_code(message: str) -> str {
    if message.contains("Unterminated block comment") { return "E101"; }
    if message.contains("Unterminated string literal") ||
    message.contains("Unterminated character literal") ||
    message.contains("Unterminated byte literal") { return "E105"; }
    if message.contains("f-string") { return "E102"; }
    if message.contains("unterminated") && message.contains("escape") { return "E103"; }
    return "E199";
}

pub fn parse_code(message: str) -> str {
    if message.starts_with("End of token stream reached") || message.contains("end of file") ||
    message.contains("<eof>") { return "E201"; }
    if message.starts_with("Expected") { return "E202"; }
    if message.starts_with("Unexpected") { return "E203"; }
    if message.contains("reserved") { return "E204"; }
    return "E299";
}

fn append_token(output: String&, token: Token&) {
    output.push_str("{\"kind\":");
    append_string(output, token_kind(token));
    output.push_str(",\"value\":");
    match token.kind() {
        Integer(_, _) => {
            let value = token.integer_value().to_string_radix(10u64);
            append_string(output, value.as_str());
            value.drop();
        },
        Float(_, _) => {
            let value = token.float_value().to_string();
            append_string(output, value.as_str());
            value.drop();
        },
        _ => append_string(output, token.value()),
    }
    output.push_str(",\"suffix\":");
    append_string(output, token.suffix());
    output.push(',');
    append_span(output, token.span);
    output.push('}');
}

pub fn append_token_file(output: String&, path: str, tokens: Vec<Token>&) {
    output.push_str("{\"path\":");
    append_string(output, path);
    output.push_str(",\"tokens\":[");
    let index: u64 = 0u64;
    while index < tokens.len() {
        if index != 0u64 { output.push(','); }
        append_token(output, &tokens[index]);
        index += 1u64;
    }
    output.push_str("]}");
}
