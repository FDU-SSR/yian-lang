    fn append_literal_ref(node: LiteralRef&) {
        match node {
            Integer(value) => {
                self.append_int_literal(*value);
            },
            Float(value) => {
                self.append_float_literal(*value);
            },
            Character(value) => {
                self.append_char_literal(*value);
            },
            StringLiteral(value) => {
                self.append_str_literal(*value);
            },
            Boolean(value) => {
                self.append_bool_literal(*value);
            },
        }
    }

    fn append_range_bounds(node: RangeBounds&) {
        match node {
            Integer(lower, upper) => {
                self.output.push('{');
                self.append_field_name("lower", false);
                self.append_int_literal(*lower);
                self.append_field_name("upper", true);
                self.append_int_literal(*upper);
                self.output.push('}');
            },
            Character(lower, upper) => {
                self.output.push('{');
                self.append_field_name("lower", false);
                self.append_char_literal(*lower);
                self.append_field_name("upper", true);
                self.append_char_literal(*upper);
                self.output.push('}');
            },
        }
    }

    fn append_condition(node: Condition&) {
        match node {
            Expression(value) => {
                self.append_expr(*value);
            },
            Let(value) => {
                self.append_let_condition(*value);
            },
        }
    }

    fn append_generic_argument(node: GenericArgument&) {
        match node {
            Type(value) => {
                self.append_type_syntax(*value);
            },
            Constant(value) => {
                self.append_const_expr(*value);
            },
        }
    }

    fn append_generic_param(node: GenericParam&) {
        match node {
            Type(value) => {
                self.append_type_generic_param(*value);
            },
            Constant(value) => {
                self.append_const_generic_param(*value);
            },
        }
    }

    fn append_parameter(node: Parameter&) {
        match node {
            Named(value) => {
                self.append_var_info(*value);
            },
            Pattern(value) => {
                self.append_pattern_param(*value);
            },
        }
    }

    fn append_trait_member(node: TraitMember&) {
        match node {
            Declaration(value) => {
                self.append_method_decl(*value);
            },
            Definition(value) => {
                self.append_method_def(*value);
            },
        }
    }

    fn append_pattern_arguments(node: PatternArguments&) {
        match node {
            None => {
                self.output.push_str("null");
            },
            Positional(values) => {
                {
                    self.output.push('[');
                    let index: u64 = 0;
                    while index < (*values).len() {
                        if index != 0 { self.output.push(','); }
                        self.append_pattern((*values)[index]);
                        index += 1;
                    }
                    self.output.push(']');
                }
            },
            Named(values) => {
                {
                    self.output.push('[');
                    let index: u64 = 0;
                    while index < (*values).len() {
                        if index != 0 { self.output.push(','); }
                        self.append_field_pattern((*values)[index]);
                        index += 1;
                    }
                    self.output.push(']');
                }
            },
        }
    }
}
