                    }
                    self.output.push(']');
                }
                self.append_field_name("conditions", true);
                {
                    self.output.push('[');
                    let index: u64 = 0;
                    while index < (*conditions).len() {
                        if index != 0 { self.output.push(','); }
                        self.append_impl_condition((*conditions)[index]);
                        index += 1;
                    }
                    self.output.push(']');
                }
                self.output.push_str("}}");
