from compiler.frontend.ast.node import Identifier, IntLiteral, FloatLiteral, CharLiteral, StrLiteral, BoolLiteral, Program, Block, Argument, VarInfo, PatternParam, PatternLet, LetCondition, ElifBranch, MatchArm, Attr, TypeGenericParam, ConstGenericParam, FieldInfo, VariantInfo, MethodDecl, MethodDef, ExternFuncDecl, ImplCondition, CaptureItem, FieldPattern, Expr, TypeSyntax, ConstExpr, Pattern, Item, Literal, RangeBounds, Condition, GenericArgument, GenericParam, Parameter, TraitMember, PatternArguments;
from std.core.ops import Index;

// Traversal follows child edges; shared nodes are visited once per incoming edge.
// Binding inputs precede their patterns; block parameter bindings precede statements.
pub trait AstVisitor {
    fn enter_identifier(node: Identifier&) -> bool { true }
    fn leave_identifier(node: Identifier&) {}
    fn enter_int_literal(node: IntLiteral&) -> bool { true }
    fn leave_int_literal(node: IntLiteral&) {}
    fn enter_float_literal(node: FloatLiteral&) -> bool { true }
    fn leave_float_literal(node: FloatLiteral&) {}
    fn enter_char_literal(node: CharLiteral&) -> bool { true }
    fn leave_char_literal(node: CharLiteral&) {}
    fn enter_str_literal(node: StrLiteral&) -> bool { true }
    fn leave_str_literal(node: StrLiteral&) {}
    fn enter_bool_literal(node: BoolLiteral&) -> bool { true }
    fn leave_bool_literal(node: BoolLiteral&) {}
    fn enter_program(node: Program&) -> bool { true }
    fn leave_program(node: Program&) {}
    fn enter_block(node: Block&) -> bool { true }
    fn leave_block(node: Block&) {}
    fn enter_argument(node: Argument&) -> bool { true }
    fn leave_argument(node: Argument&) {}
    fn enter_var_info(node: VarInfo&) -> bool { true }
    fn leave_var_info(node: VarInfo&) {}
    fn enter_pattern_param(node: PatternParam&) -> bool { true }
    fn leave_pattern_param(node: PatternParam&) {}
    fn enter_pattern_let(node: PatternLet&) -> bool { true }
    fn leave_pattern_let(node: PatternLet&) {}
    fn enter_let_condition(node: LetCondition&) -> bool { true }
    fn leave_let_condition(node: LetCondition&) {}
    fn enter_elif_branch(node: ElifBranch&) -> bool { true }
    fn leave_elif_branch(node: ElifBranch&) {}
    fn enter_match_arm(node: MatchArm&) -> bool { true }
    fn leave_match_arm(node: MatchArm&) {}
    fn enter_attr(node: Attr&) -> bool { true }
    fn leave_attr(node: Attr&) {}
    fn enter_type_generic_param(node: TypeGenericParam&) -> bool { true }
    fn leave_type_generic_param(node: TypeGenericParam&) {}
    fn enter_const_generic_param(node: ConstGenericParam&) -> bool { true }
    fn leave_const_generic_param(node: ConstGenericParam&) {}
    fn enter_field_info(node: FieldInfo&) -> bool { true }
    fn leave_field_info(node: FieldInfo&) {}
    fn enter_variant_info(node: VariantInfo&) -> bool { true }
    fn leave_variant_info(node: VariantInfo&) {}
    fn enter_method_decl(node: MethodDecl&) -> bool { true }
    fn leave_method_decl(node: MethodDecl&) {}
    fn enter_method_def(node: MethodDef&) -> bool { true }
    fn leave_method_def(node: MethodDef&) {}
    fn enter_extern_func_decl(node: ExternFuncDecl&) -> bool { true }
    fn leave_extern_func_decl(node: ExternFuncDecl&) {}
    fn enter_impl_condition(node: ImplCondition&) -> bool { true }
    fn leave_impl_condition(node: ImplCondition&) {}
    fn enter_capture_item(node: CaptureItem&) -> bool { true }
    fn leave_capture_item(node: CaptureItem&) {}
    fn enter_field_pattern(node: FieldPattern&) -> bool { true }
    fn leave_field_pattern(node: FieldPattern&) {}
    fn enter_expr(node: Expr&) -> bool { true }
    fn leave_expr(node: Expr&) {}
    fn enter_type_syntax(node: TypeSyntax&) -> bool { true }
    fn leave_type_syntax(node: TypeSyntax&) {}
    fn enter_const_expr(node: ConstExpr&) -> bool { true }
    fn leave_const_expr(node: ConstExpr&) {}
    fn enter_pattern(node: Pattern&) -> bool { true }
    fn leave_pattern(node: Pattern&) {}
    fn enter_item(node: Item&) -> bool { true }
    fn leave_item(node: Item&) {}
}

// Default methods rewrite children before returning the node; overrides control recursion and replacement.
// Child helpers never replace their root. Replacements are revisited only when an override requests it.
pub trait AstRewriter {
    fn rewrite_identifier(node: Identifier&) -> Identifier& { node }
    fn rewrite_int_literal(node: IntLiteral&) -> IntLiteral& { node }
    fn rewrite_float_literal(node: FloatLiteral&) -> FloatLiteral& { node }
    fn rewrite_char_literal(node: CharLiteral&) -> CharLiteral& { node }
    fn rewrite_str_literal(node: StrLiteral&) -> StrLiteral& { node }
    fn rewrite_bool_literal(node: BoolLiteral&) -> BoolLiteral& { node }
    fn rewrite_program(node: Program&) -> Program& {
        rewrite_program_children(node, self);
        node
    }
    fn rewrite_block(node: Block&) -> Block& {
        rewrite_block_children(node, self);
        node
    }
    fn rewrite_argument(node: Argument&) -> Argument& {
        rewrite_argument_children(node, self);
        node
    }
    fn rewrite_var_info(node: VarInfo&) -> VarInfo& {
        rewrite_var_info_children(node, self);
        node
    }
    fn rewrite_pattern_param(node: PatternParam&) -> PatternParam& {
        rewrite_pattern_param_children(node, self);
        node
    }
    fn rewrite_pattern_let(node: PatternLet&) -> PatternLet& {
        rewrite_pattern_let_children(node, self);
        node
    }
    fn rewrite_let_condition(node: LetCondition&) -> LetCondition& {
        rewrite_let_condition_children(node, self);
        node
    }
    fn rewrite_elif_branch(node: ElifBranch&) -> ElifBranch& {
        rewrite_elif_branch_children(node, self);
        node
    }
    fn rewrite_match_arm(node: MatchArm&) -> MatchArm& {
        rewrite_match_arm_children(node, self);
        node
    }
    fn rewrite_attr(node: Attr&) -> Attr& { node }
    fn rewrite_type_generic_param(node: TypeGenericParam&) -> TypeGenericParam& {
        rewrite_type_generic_param_children(node, self);
        node
    }
    fn rewrite_const_generic_param(node: ConstGenericParam&) -> ConstGenericParam& {
        rewrite_const_generic_param_children(node, self);
        node
    }
    fn rewrite_field_info(node: FieldInfo&) -> FieldInfo& {
        rewrite_field_info_children(node, self);
        node
    }
    fn rewrite_variant_info(node: VariantInfo&) -> VariantInfo& {
        rewrite_variant_info_children(node, self);
        node
    }
    fn rewrite_method_decl(node: MethodDecl&) -> MethodDecl& {
        rewrite_method_decl_children(node, self);
        node
    }
    fn rewrite_method_def(node: MethodDef&) -> MethodDef& {
        rewrite_method_def_children(node, self);
        node
    }
    fn rewrite_extern_func_decl(node: ExternFuncDecl&) -> ExternFuncDecl& {
        rewrite_extern_func_decl_children(node, self);
        node
    }
    fn rewrite_impl_condition(node: ImplCondition&) -> ImplCondition& {
        rewrite_impl_condition_children(node, self);
        node
    }
    fn rewrite_capture_item(node: CaptureItem&) -> CaptureItem& {
        rewrite_capture_item_children(node, self);
        node
    }
    fn rewrite_field_pattern(node: FieldPattern&) -> FieldPattern& {
        rewrite_field_pattern_children(node, self);
        node
    }
    fn rewrite_expr(node: Expr&) -> Expr& {
        rewrite_expr_children(node, self);
        node
    }
    fn rewrite_type_syntax(node: TypeSyntax&) -> TypeSyntax& {
        rewrite_type_syntax_children(node, self);
        node
    }
    fn rewrite_const_expr(node: ConstExpr&) -> ConstExpr& {
        rewrite_const_expr_children(node, self);
        node
    }
    fn rewrite_pattern(node: Pattern&) -> Pattern& {
        rewrite_pattern_children(node, self);
        node
    }
    fn rewrite_item(node: Item&) -> Item& {
        rewrite_item_children(node, self);
        node
    }
}

pub fn walk_identifier(node: Identifier&, visitor: AstVisitor&) {
    if !visitor.enter_identifier(node) { return; }
    visitor.leave_identifier(node);
}

pub fn walk_int_literal(node: IntLiteral&, visitor: AstVisitor&) {
    if !visitor.enter_int_literal(node) { return; }
    visitor.leave_int_literal(node);
}

pub fn walk_float_literal(node: FloatLiteral&, visitor: AstVisitor&) {
    if !visitor.enter_float_literal(node) { return; }
    visitor.leave_float_literal(node);
}

pub fn walk_char_literal(node: CharLiteral&, visitor: AstVisitor&) {
    if !visitor.enter_char_literal(node) { return; }
    visitor.leave_char_literal(node);
}

pub fn walk_str_literal(node: StrLiteral&, visitor: AstVisitor&) {
    if !visitor.enter_str_literal(node) { return; }
    visitor.leave_str_literal(node);
}

pub fn walk_bool_literal(node: BoolLiteral&, visitor: AstVisitor&) {
    if !visitor.enter_bool_literal(node) { return; }
    visitor.leave_bool_literal(node);
}

pub fn walk_program(node: Program&, visitor: AstVisitor&) {
    if !visitor.enter_program(node) { return; }
    {
        let index: u64 = 0;
        while index < (node.data.items).len() {
            walk_item((node.data.items)[index], visitor);
            index += 1;
        }
    };
    visitor.leave_program(node);
}

pub fn walk_block(node: Block&, visitor: AstVisitor&) {
    if !visitor.enter_block(node) { return; }
    {
        let index: u64 = 0;
        while index < (node.data.parameter_bindings).len() {
            walk_pattern_let((node.data.parameter_bindings)[index], visitor);
            index += 1;
        }
    };
    {
        let index: u64 = 0;
        while index < (node.data.stmts).len() {
            walk_expr((node.data.stmts)[index], visitor);
            index += 1;
        }
    };
    visitor.leave_block(node);
}

pub fn walk_argument(node: Argument&, visitor: AstVisitor&) {
    if !visitor.enter_argument(node) { return; }
    match &(node.data.name) {
        Some(value) => {
            walk_identifier(*value, visitor);
        },
        None => {},
    };
    walk_expr(node.data.value, visitor);
    visitor.leave_argument(node);
}

pub fn walk_var_info(node: VarInfo&, visitor: AstVisitor&) {
    if !visitor.enter_var_info(node) { return; }
    walk_identifier(node.data.name, visitor);
    walk_type_syntax(node.data.var_type, visitor);
    visitor.leave_var_info(node);
}

pub fn walk_pattern_param(node: PatternParam&, visitor: AstVisitor&) {
    if !visitor.enter_pattern_param(node) { return; }
    walk_pattern(node.data.pattern, visitor);
    walk_type_syntax(node.data.var_type, visitor);
    visitor.leave_pattern_param(node);
}

pub fn walk_pattern_let(node: PatternLet&, visitor: AstVisitor&) {
    if !visitor.enter_pattern_let(node) { return; }
    walk_expr(node.data.init_expr, visitor);
    walk_type_syntax(node.data.var_type, visitor);
    walk_pattern(node.data.pattern, visitor);
    match &(node.data.else_branch) {
        Some(value) => {
            walk_block(*value, visitor);
        },
        None => {},
    };
    visitor.leave_pattern_let(node);
}

pub fn walk_let_condition(node: LetCondition&, visitor: AstVisitor&) {
    if !visitor.enter_let_condition(node) { return; }
    walk_expr(node.data.value, visitor);
    walk_pattern(node.data.pattern, visitor);
    visitor.leave_let_condition(node);
}

pub fn walk_elif_branch(node: ElifBranch&, visitor: AstVisitor&) {
    if !visitor.enter_elif_branch(node) { return; }
    walk_condition(&(node.data.condition), visitor);
    walk_block(node.data.body, visitor);
    visitor.leave_elif_branch(node);
}

pub fn walk_match_arm(node: MatchArm&, visitor: AstVisitor&) {
    if !visitor.enter_match_arm(node) { return; }
    walk_pattern(node.data.pattern, visitor);
    match &(node.data.guard) {
        Some(value) => {
            walk_expr(*value, visitor);
        },
        None => {},
    };
    walk_block(node.data.body, visitor);
    visitor.leave_match_arm(node);
}

pub fn walk_attr(node: Attr&, visitor: AstVisitor&) {
    if !visitor.enter_attr(node) { return; }
    visitor.leave_attr(node);
}

pub fn walk_type_generic_param(node: TypeGenericParam&, visitor: AstVisitor&) {
    if !visitor.enter_type_generic_param(node) { return; }
    walk_identifier(node.data.name, visitor);
    visitor.leave_type_generic_param(node);
}

pub fn walk_const_generic_param(node: ConstGenericParam&, visitor: AstVisitor&) {
    if !visitor.enter_const_generic_param(node) { return; }
    walk_identifier(node.data.name, visitor);
    walk_type_syntax(node.data.const_type, visitor);
    visitor.leave_const_generic_param(node);
}

pub fn walk_field_info(node: FieldInfo&, visitor: AstVisitor&) {
    if !visitor.enter_field_info(node) { return; }
    {
        let index: u64 = 0;
        while index < (node.data.attrs).len() {
            walk_attr((node.data.attrs)[index], visitor);
            index += 1;
        }
    };
    walk_identifier(node.data.name, visitor);
    walk_type_syntax(node.data.field_type, visitor);
    visitor.leave_field_info(node);
}

pub fn walk_variant_info(node: VariantInfo&, visitor: AstVisitor&) {
    if !visitor.enter_variant_info(node) { return; }
    walk_identifier(node.data.name, visitor);
    {
        let index: u64 = 0;
        while index < (node.data.fields).len() {
            walk_var_info((node.data.fields)[index], visitor);
            index += 1;
        }
    };
    visitor.leave_variant_info(node);
}

pub fn walk_method_decl(node: MethodDecl&, visitor: AstVisitor&) {
    if !visitor.enter_method_decl(node) { return; }
    {
        let index: u64 = 0;
        while index < (node.data.attrs).len() {
            walk_attr((node.data.attrs)[index], visitor);
            index += 1;
        }
    };
    walk_identifier(node.data.name, visitor);
    {
        let index: u64 = 0;
        while index < (node.data.generics).len() {
            walk_generic_param(&((node.data.generics)[index]), visitor);
            index += 1;
        }
    };
    {
        let index: u64 = 0;
        while index < (node.data.params).len() {
            walk_parameter(&((node.data.params)[index]), visitor);
            index += 1;
        }
    };
    match &(node.data.ret_type) {
        Some(value) => {
            walk_type_syntax(*value, visitor);
        },
        None => {},
    };
    visitor.leave_method_decl(node);
}

pub fn walk_method_def(node: MethodDef&, visitor: AstVisitor&) {
    if !visitor.enter_method_def(node) { return; }
    walk_method_decl(node.data.decl, visitor);
    walk_block(node.data.body, visitor);
    visitor.leave_method_def(node);
}

pub fn walk_extern_func_decl(node: ExternFuncDecl&, visitor: AstVisitor&) {
    if !visitor.enter_extern_func_decl(node) { return; }
    walk_identifier(node.data.name, visitor);
    {
        let index: u64 = 0;
        while index < (node.data.params).len() {
            walk_var_info((node.data.params)[index], visitor);
            index += 1;
        }
    };
    match &(node.data.ret_type) {
        Some(value) => {
            walk_type_syntax(*value, visitor);
        },
        None => {},
    };
    visitor.leave_extern_func_decl(node);
}

pub fn walk_impl_condition(node: ImplCondition&, visitor: AstVisitor&) {
    if !visitor.enter_impl_condition(node) { return; }
    walk_identifier(node.data.name, visitor);
    {
        let index: u64 = 0;
        while index < (node.data.traits).len() {
            walk_type_syntax((node.data.traits)[index], visitor);
            index += 1;
        }
    };
    visitor.leave_impl_condition(node);
}

pub fn walk_capture_item(node: CaptureItem&, visitor: AstVisitor&) {
    if !visitor.enter_capture_item(node) { return; }
    walk_identifier(node.data.name, visitor);
    walk_expr(node.data.expr, visitor);
    visitor.leave_capture_item(node);
}

pub fn walk_field_pattern(node: FieldPattern&, visitor: AstVisitor&) {
    if !visitor.enter_field_pattern(node) { return; }
    walk_identifier(node.data.name, visitor);
    walk_pattern(node.data.pattern, visitor);
    visitor.leave_field_pattern(node);
}

pub fn walk_expr(node: Expr&, visitor: AstVisitor&) {
    if !visitor.enter_expr(node) { return; }
    match &node.data {
        Identifier(name) => {
            walk_identifier(*name, visitor);
        },
        Literal(literal) => {
            walk_literal(&(*literal), visitor);
        },
        Binary(op, left, right) => {
            walk_expr(*left, visitor);
            walk_expr(*right, visitor);
        },
        Unary(op, operand) => {
            walk_expr(*operand, visitor);
        },
        TryExpr(operand) => {
            walk_expr(*operand, visitor);
        },
        Call(callee, args) => {
            walk_expr(*callee, visitor);
            {
                let index: u64 = 0;
                while index < (*args).len() {
                    walk_argument((*args)[index], visitor);
                    index += 1;
                }
            };
        },
        MethodCall(receiver, method_name, generics, args) => {
            walk_expr(*receiver, visitor);
            walk_identifier(*method_name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_type_syntax((*generics)[index], visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*args).len() {
                    walk_argument((*args)[index], visitor);
                    index += 1;
                }
            };
        },
        FieldAccess(receiver, field_name) => {
            walk_expr(*receiver, visitor);
            walk_identifier(*field_name, visitor);
        },
        Builtin(kind, type_args, args) => {
            {
                let index: u64 = 0;
                while index < (*type_args).len() {
                    walk_type_syntax((*type_args)[index], visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*args).len() {
                    walk_argument((*args)[index], visitor);
                    index += 1;
                }
            };
        },
        TypeItem(name, generics) => {
            walk_identifier(*name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_argument(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
        },
        Block(block) => {
            walk_block(*block, visitor);
        },
        Tuple(elements) => {
            {
                let index: u64 = 0;
                while index < (*elements).len() {
                    walk_expr((*elements)[index], visitor);
                    index += 1;
                }
            };
        },
        Array(elements) => {
            {
                let index: u64 = 0;
                while index < (*elements).len() {
                    walk_expr((*elements)[index], visitor);
                    index += 1;
                }
            };
        },
        ArrayRepeat(element, count) => {
            walk_expr(*element, visitor);
            walk_expr(*count, visitor);
        },
        DynValue(value) => {
            walk_expr(*value, visitor);
        },
        DynBuffer(size, element) => {
            walk_expr(*size, visitor);
            walk_expr(*element, visitor);
        },
        VarDecl(name, var_type, init_expr) => {
            walk_identifier(*name, visitor);
            walk_type_syntax(*var_type, visitor);
            match &(*init_expr) {
                Some(value) => {
                    walk_expr(*value, visitor);
                },
                None => {},
            };
        },
        PatternLet(binding) => {
            walk_pattern_let(*binding, visitor);
        },
        If(condition, then_branch, elif_branches, else_branch) => {
            walk_condition(&(*condition), visitor);
            walk_block(*then_branch, visitor);
            {
                let index: u64 = 0;
                while index < (*elif_branches).len() {
                    walk_elif_branch((*elif_branches)[index], visitor);
                    index += 1;
                }
            };
            match &(*else_branch) {
                Some(value) => {
                    walk_block(*value, visitor);
                },
                None => {},
            };
        },
        ComptimeIf(condition, then_branch, else_branch) => {
            walk_expr(*condition, visitor);
            walk_block(*then_branch, visitor);
            walk_block(*else_branch, visitor);
        },
        For(pattern, iterable, body) => {
            walk_expr(*iterable, visitor);
            walk_pattern(*pattern, visitor);
            walk_block(*body, visitor);
        },
        While(condition, body) => {
            walk_condition(&(*condition), visitor);
            walk_block(*body, visitor);
        },
        Loop(body) => {
            walk_block(*body, visitor);
        },
        Match(expr, arms) => {
            walk_expr(*expr, visitor);
            {
                let index: u64 = 0;
                while index < (*arms).len() {
                    walk_match_arm((*arms)[index], visitor);
                    index += 1;
                }
            };
        },
        Return(expr) => {
            match &(*expr) {
                Some(value) => {
                    walk_expr(*value, visitor);
                },
                None => {},
            };
        },
        Break(expr) => {
            match &(*expr) {
                Some(value) => {
                    walk_expr(*value, visitor);
                },
                None => {},
            };
        },
        Continue => {
        },
        Defer(action) => {
            walk_expr(*action, visitor);
        },
        Assert(condition, message) => {
            walk_expr(*condition, visitor);
            match &(*message) {
                Some(value) => {
                    walk_expr(*value, visitor);
                },
                None => {},
            };
        },
        Delete(target) => {
            walk_expr(*target, visitor);
        },
        Semi(expr) => {
            walk_expr(*expr, visitor);
        },
        ClosureExpr(captures, params, return_type, body) => {
            {
                let index: u64 = 0;
                while index < (*captures).len() {
                    walk_capture_item((*captures)[index], visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*params).len() {
                    walk_parameter(&((*params)[index]), visitor);
                    index += 1;
                }
            };
            match &(*return_type) {
                Some(value) => {
                    walk_type_syntax(*value, visitor);
                },
                None => {},
            };
            walk_block(*body, visitor);
        },
        CompileConfig(name) => {
        },
    };
    visitor.leave_expr(node);
}

pub fn walk_type_syntax(node: TypeSyntax&, visitor: AstVisitor&) {
    if !visitor.enter_type_syntax(node) { return; }
    match &node.data {
        IntType(signed, width) => {
        },
        FloatType(width) => {
        },
        BoolType => {
        },
        StrType => {
        },
        CharType => {
        },
        VoidType => {
        },
        NeverType => {
        },
        DeducedType => {
        },
        CScalarType(name) => {
        },
        CPtrType(pointee_type) => {
            walk_type_syntax(*pointee_type, visitor);
        },
        NamedType(name) => {
            walk_identifier(*name, visitor);
        },
        ArrayType(element_type, size) => {
            walk_type_syntax(*element_type, visitor);
            walk_const_expr(*size, visitor);
        },
        TupleType(element_types) => {
            {
                let index: u64 = 0;
                while index < (*element_types).len() {
                    walk_type_syntax((*element_types)[index], visitor);
                    index += 1;
                }
            };
        },
        PointerType(pointee_type) => {
            walk_type_syntax(*pointee_type, visitor);
        },
        RefType(pointee_type) => {
            walk_type_syntax(*pointee_type, visitor);
        },
        SliceType(element_type) => {
            walk_type_syntax(*element_type, visitor);
        },
        InstanceType(base, generic_args) => {
            walk_type_syntax(*base, visitor);
            {
                let index: u64 = 0;
                while index < (*generic_args).len() {
                    walk_generic_argument(&((*generic_args)[index]), visitor);
                    index += 1;
                }
            };
        },
        FunctionType(param_types, return_type) => {
            {
                let index: u64 = 0;
                while index < (*param_types).len() {
                    walk_type_syntax((*param_types)[index], visitor);
                    index += 1;
                }
            };
            walk_type_syntax(*return_type, visitor);
        },
    };
    visitor.leave_type_syntax(node);
}

pub fn walk_const_expr(node: ConstExpr&, visitor: AstVisitor&) {
    if !visitor.enter_const_expr(node) { return; }
    match &node.data {
        LiteralConstExpr(literal) => {
            walk_int_literal(*literal, visitor);
        },
        GenericConstExpr(name) => {
            walk_identifier(*name, visitor);
        },
        UnaryConstExpr(op, operand) => {
            walk_const_expr(*operand, visitor);
        },
        BinaryConstExpr(op, left, right) => {
            walk_const_expr(*left, visitor);
            walk_const_expr(*right, visitor);
        },
    };
    visitor.leave_const_expr(node);
}

pub fn walk_pattern(node: Pattern&, visitor: AstVisitor&) {
    if !visitor.enter_pattern(node) { return; }
    match &node.data {
        WildcardPattern => {
        },
        LiteralPattern(literal) => {
            walk_literal(&(*literal), visitor);
        },
        RangePattern(bounds) => {
            walk_range_bounds(&(*bounds), visitor);
        },
        NamePattern(name) => {
            walk_identifier(*name, visitor);
        },
        BindPattern(name, inner) => {
            walk_identifier(*name, visitor);
            walk_pattern(*inner, visitor);
        },
        OrPattern(alternatives) => {
            {
                let index: u64 = 0;
                while index < (*alternatives).len() {
                    walk_pattern((*alternatives)[index], visitor);
                    index += 1;
                }
            };
        },
        ConstructPattern(name, qualifier, arguments, rest) => {
            walk_identifier(*name, visitor);
            match &(*qualifier) {
                Some(value) => {
                    walk_type_syntax(*value, visitor);
                },
                None => {},
            };
            walk_pattern_arguments(&(*arguments), visitor);
        },
        TuplePattern(elements) => {
            {
                let index: u64 = 0;
                while index < (*elements).len() {
                    walk_pattern((*elements)[index], visitor);
                    index += 1;
                }
            };
        },
        SequencePattern(prefix, suffix, rest) => {
            {
                let index: u64 = 0;
                while index < (*prefix).len() {
                    walk_pattern((*prefix)[index], visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*suffix).len() {
                    walk_pattern((*suffix)[index], visitor);
                    index += 1;
                }
            };
        },
    };
    visitor.leave_pattern(node);
}

pub fn walk_item(node: Item&, visitor: AstVisitor&) {
    if !visitor.enter_item(node) { return; }
    match &node.data {
        Import(paths, target, alias, end) => {
            {
                let index: u64 = 0;
                while index < (*paths).len() {
                    walk_identifier((*paths)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*target, visitor);
            match &(*alias) {
                Some(value) => {
                    walk_identifier(*value, visitor);
                },
                None => {},
            };
        },
        Alias(attrs, name, generics, target) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_param(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
            walk_type_syntax(*target, visitor);
        },
        FuncDef(attrs, name, generics, params, ret_type, body) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_param(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*params).len() {
                    walk_parameter(&((*params)[index]), visitor);
                    index += 1;
                }
            };
            match &(*ret_type) {
                Some(value) => {
                    walk_type_syntax(*value, visitor);
                },
                None => {},
            };
            walk_block(*body, visitor);
        },
        ConstDef(attrs, name, const_type, value) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
            walk_type_syntax(*const_type, visitor);
            walk_expr(*value, visitor);
        },
        OpaqueTypeDef(attrs, name) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
        },
        ExternBlock(attrs, abi, functions) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*functions).len() {
                    walk_extern_func_decl((*functions)[index], visitor);
                    index += 1;
                }
            };
        },
        StructDef(attrs, name, generics, fields) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_param(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*fields).len() {
                    walk_field_info((*fields)[index], visitor);
                    index += 1;
                }
            };
        },
        EnumDef(attrs, name, generics, variants) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_param(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*variants).len() {
                    walk_variant_info((*variants)[index], visitor);
                    index += 1;
                }
            };
        },
        TraitDef(attrs, name, generics, items) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    walk_attr((*attrs)[index], visitor);
                    index += 1;
                }
            };
            walk_identifier(*name, visitor);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_param(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*items).len() {
                    walk_trait_member(&((*items)[index]), visitor);
                    index += 1;
                }
            };
        },
        Impl(generics, target, trait_type, items, conditions) => {
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    walk_generic_param(&((*generics)[index]), visitor);
                    index += 1;
                }
            };
            walk_type_syntax(*target, visitor);
            match &(*trait_type) {
                Some(value) => {
                    walk_type_syntax(*value, visitor);
                },
                None => {},
            };
            {
                let index: u64 = 0;
                while index < (*items).len() {
                    walk_method_def((*items)[index], visitor);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*conditions).len() {
                    walk_impl_condition((*conditions)[index], visitor);
                    index += 1;
                }
            };
        },
    };
    visitor.leave_item(node);
}

pub fn walk_literal(node: Literal&, visitor: AstVisitor&) {
    match node {
        Integer(value) => {
            walk_int_literal(*value, visitor);
        },
        Float(value) => {
            walk_float_literal(*value, visitor);
        },
        Character(value) => {
            walk_char_literal(*value, visitor);
        },
        StringLiteral(value) => {
            walk_str_literal(*value, visitor);
        },
        Boolean(value) => {
            walk_bool_literal(*value, visitor);
        },
    };
}

pub fn walk_range_bounds(node: RangeBounds&, visitor: AstVisitor&) {
    match node {
        Integer(lower, upper) => {
            walk_int_literal(*lower, visitor);
            walk_int_literal(*upper, visitor);
        },
        Character(lower, upper) => {
            walk_char_literal(*lower, visitor);
            walk_char_literal(*upper, visitor);
        },
    };
}

pub fn walk_condition(node: Condition&, visitor: AstVisitor&) {
    match node {
        Expression(value) => {
            walk_expr(*value, visitor);
        },
        Let(value) => {
            walk_let_condition(*value, visitor);
        },
    };
}

pub fn walk_generic_argument(node: GenericArgument&, visitor: AstVisitor&) {
    match node {
        Type(value) => {
            walk_type_syntax(*value, visitor);
        },
        Constant(value) => {
            walk_const_expr(*value, visitor);
        },
    };
}

pub fn walk_generic_param(node: GenericParam&, visitor: AstVisitor&) {
    match node {
        Type(value) => {
            walk_type_generic_param(*value, visitor);
        },
        Constant(value) => {
            walk_const_generic_param(*value, visitor);
        },
    };
}

pub fn walk_parameter(node: Parameter&, visitor: AstVisitor&) {
    match node {
        Named(value) => {
            walk_var_info(*value, visitor);
        },
        Pattern(value) => {
            walk_pattern_param(*value, visitor);
        },
    };
}

pub fn walk_trait_member(node: TraitMember&, visitor: AstVisitor&) {
    match node {
        Declaration(value) => {
            walk_method_decl(*value, visitor);
        },
        Definition(value) => {
            walk_method_def(*value, visitor);
        },
    };
}

pub fn walk_pattern_arguments(node: PatternArguments&, visitor: AstVisitor&) {
    match node {
        None => {
        },
        Positional(values) => {
            {
                let index: u64 = 0;
                while index < (*values).len() {
                    walk_pattern((*values)[index], visitor);
                    index += 1;
                }
            };
        },
        Named(values) => {
            {
                let index: u64 = 0;
                while index < (*values).len() {
                    walk_field_pattern((*values)[index], visitor);
                    index += 1;
                }
            };
        },
    };
}

pub fn rewrite_program_children(node: Program&, rewriter: AstRewriter&) {
    {
        let index: u64 = 0;
        while index < (node.data.items).len() {
            (node.data.items)[index] = rewriter.rewrite_item((node.data.items)[index]);
            index += 1;
        }
    };
}

pub fn rewrite_block_children(node: Block&, rewriter: AstRewriter&) {
    {
        let index: u64 = 0;
        while index < (node.data.parameter_bindings).len() {
            (node.data.parameter_bindings)[index] = rewriter.rewrite_pattern_let((node.data.parameter_bindings)[index]);
            index += 1;
        }
    };
    {
        let index: u64 = 0;
        while index < (node.data.stmts).len() {
            (node.data.stmts)[index] = rewriter.rewrite_expr((node.data.stmts)[index]);
            index += 1;
        }
    };
}

pub fn rewrite_argument_children(node: Argument&, rewriter: AstRewriter&) {
    match &(node.data.name) {
        Some(value) => {
            *value = rewriter.rewrite_identifier(*value);
        },
        None => {},
    };
    node.data.value = rewriter.rewrite_expr(node.data.value);
}

pub fn rewrite_var_info_children(node: VarInfo&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    node.data.var_type = rewriter.rewrite_type_syntax(node.data.var_type);
}

pub fn rewrite_pattern_param_children(node: PatternParam&, rewriter: AstRewriter&) {
    node.data.pattern = rewriter.rewrite_pattern(node.data.pattern);
    node.data.var_type = rewriter.rewrite_type_syntax(node.data.var_type);
}

pub fn rewrite_pattern_let_children(node: PatternLet&, rewriter: AstRewriter&) {
    node.data.init_expr = rewriter.rewrite_expr(node.data.init_expr);
    node.data.var_type = rewriter.rewrite_type_syntax(node.data.var_type);
    node.data.pattern = rewriter.rewrite_pattern(node.data.pattern);
    match &(node.data.else_branch) {
        Some(value) => {
            *value = rewriter.rewrite_block(*value);
        },
        None => {},
    };
}

pub fn rewrite_let_condition_children(node: LetCondition&, rewriter: AstRewriter&) {
    node.data.value = rewriter.rewrite_expr(node.data.value);
    node.data.pattern = rewriter.rewrite_pattern(node.data.pattern);
}

pub fn rewrite_elif_branch_children(node: ElifBranch&, rewriter: AstRewriter&) {
    rewrite_condition(&(node.data.condition), rewriter);
    node.data.body = rewriter.rewrite_block(node.data.body);
}

pub fn rewrite_match_arm_children(node: MatchArm&, rewriter: AstRewriter&) {
    node.data.pattern = rewriter.rewrite_pattern(node.data.pattern);
    match &(node.data.guard) {
        Some(value) => {
            *value = rewriter.rewrite_expr(*value);
        },
        None => {},
    };
    node.data.body = rewriter.rewrite_block(node.data.body);
}

pub fn rewrite_type_generic_param_children(node: TypeGenericParam&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
}

pub fn rewrite_const_generic_param_children(node: ConstGenericParam&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    node.data.const_type = rewriter.rewrite_type_syntax(node.data.const_type);
}

pub fn rewrite_field_info_children(node: FieldInfo&, rewriter: AstRewriter&) {
    {
        let index: u64 = 0;
        while index < (node.data.attrs).len() {
            (node.data.attrs)[index] = rewriter.rewrite_attr((node.data.attrs)[index]);
            index += 1;
        }
    };
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    node.data.field_type = rewriter.rewrite_type_syntax(node.data.field_type);
}

pub fn rewrite_variant_info_children(node: VariantInfo&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    {
        let index: u64 = 0;
        while index < (node.data.fields).len() {
            (node.data.fields)[index] = rewriter.rewrite_var_info((node.data.fields)[index]);
            index += 1;
        }
    };
}

pub fn rewrite_method_decl_children(node: MethodDecl&, rewriter: AstRewriter&) {
    {
        let index: u64 = 0;
        while index < (node.data.attrs).len() {
            (node.data.attrs)[index] = rewriter.rewrite_attr((node.data.attrs)[index]);
            index += 1;
        }
    };
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    {
        let index: u64 = 0;
        while index < (node.data.generics).len() {
            rewrite_generic_param(&((node.data.generics)[index]), rewriter);
            index += 1;
        }
    };
    {
        let index: u64 = 0;
        while index < (node.data.params).len() {
            rewrite_parameter(&((node.data.params)[index]), rewriter);
            index += 1;
        }
    };
    match &(node.data.ret_type) {
        Some(value) => {
            *value = rewriter.rewrite_type_syntax(*value);
        },
        None => {},
    };
}

pub fn rewrite_method_def_children(node: MethodDef&, rewriter: AstRewriter&) {
    node.data.decl = rewriter.rewrite_method_decl(node.data.decl);
    node.data.body = rewriter.rewrite_block(node.data.body);
}

pub fn rewrite_extern_func_decl_children(node: ExternFuncDecl&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    {
        let index: u64 = 0;
        while index < (node.data.params).len() {
            (node.data.params)[index] = rewriter.rewrite_var_info((node.data.params)[index]);
            index += 1;
        }
    };
    match &(node.data.ret_type) {
        Some(value) => {
            *value = rewriter.rewrite_type_syntax(*value);
        },
        None => {},
    };
}

pub fn rewrite_impl_condition_children(node: ImplCondition&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    {
        let index: u64 = 0;
        while index < (node.data.traits).len() {
            (node.data.traits)[index] = rewriter.rewrite_type_syntax((node.data.traits)[index]);
            index += 1;
        }
    };
}

pub fn rewrite_capture_item_children(node: CaptureItem&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    node.data.expr = rewriter.rewrite_expr(node.data.expr);
}

pub fn rewrite_field_pattern_children(node: FieldPattern&, rewriter: AstRewriter&) {
    node.data.name = rewriter.rewrite_identifier(node.data.name);
    node.data.pattern = rewriter.rewrite_pattern(node.data.pattern);
}

pub fn rewrite_expr_children(node: Expr&, rewriter: AstRewriter&) {
    match &node.data {
        Identifier(name) => {
            *name = rewriter.rewrite_identifier(*name);
        },
        Literal(literal) => {
            rewrite_literal(&(*literal), rewriter);
        },
        Binary(op, left, right) => {
            *left = rewriter.rewrite_expr(*left);
            *right = rewriter.rewrite_expr(*right);
        },
        Unary(op, operand) => {
            *operand = rewriter.rewrite_expr(*operand);
        },
        TryExpr(operand) => {
            *operand = rewriter.rewrite_expr(*operand);
        },
        Call(callee, args) => {
            *callee = rewriter.rewrite_expr(*callee);
            {
                let index: u64 = 0;
                while index < (*args).len() {
                    (*args)[index] = rewriter.rewrite_argument((*args)[index]);
                    index += 1;
                }
            };
        },
        MethodCall(receiver, method_name, generics, args) => {
            *receiver = rewriter.rewrite_expr(*receiver);
            *method_name = rewriter.rewrite_identifier(*method_name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    (*generics)[index] = rewriter.rewrite_type_syntax((*generics)[index]);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*args).len() {
                    (*args)[index] = rewriter.rewrite_argument((*args)[index]);
                    index += 1;
                }
            };
        },
        FieldAccess(receiver, field_name) => {
            *receiver = rewriter.rewrite_expr(*receiver);
            *field_name = rewriter.rewrite_identifier(*field_name);
        },
        Builtin(kind, type_args, args) => {
            {
                let index: u64 = 0;
                while index < (*type_args).len() {
                    (*type_args)[index] = rewriter.rewrite_type_syntax((*type_args)[index]);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*args).len() {
                    (*args)[index] = rewriter.rewrite_argument((*args)[index]);
                    index += 1;
                }
            };
        },
        TypeItem(name, generics) => {
            *name = rewriter.rewrite_identifier(*name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_argument(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
        },
        Block(block) => {
            *block = rewriter.rewrite_block(*block);
        },
        Tuple(elements) => {
            {
                let index: u64 = 0;
                while index < (*elements).len() {
                    (*elements)[index] = rewriter.rewrite_expr((*elements)[index]);
                    index += 1;
                }
            };
        },
        Array(elements) => {
            {
                let index: u64 = 0;
                while index < (*elements).len() {
                    (*elements)[index] = rewriter.rewrite_expr((*elements)[index]);
                    index += 1;
                }
            };
        },
        ArrayRepeat(element, count) => {
            *element = rewriter.rewrite_expr(*element);
            *count = rewriter.rewrite_expr(*count);
        },
        DynValue(value) => {
            *value = rewriter.rewrite_expr(*value);
        },
        DynBuffer(size, element) => {
            *size = rewriter.rewrite_expr(*size);
            *element = rewriter.rewrite_expr(*element);
        },
        VarDecl(name, var_type, init_expr) => {
            *name = rewriter.rewrite_identifier(*name);
            *var_type = rewriter.rewrite_type_syntax(*var_type);
            match &(*init_expr) {
                Some(value) => {
                    *value = rewriter.rewrite_expr(*value);
                },
                None => {},
            };
        },
        PatternLet(binding) => {
            *binding = rewriter.rewrite_pattern_let(*binding);
        },
        If(condition, then_branch, elif_branches, else_branch) => {
            rewrite_condition(&(*condition), rewriter);
            *then_branch = rewriter.rewrite_block(*then_branch);
            {
                let index: u64 = 0;
                while index < (*elif_branches).len() {
                    (*elif_branches)[index] = rewriter.rewrite_elif_branch((*elif_branches)[index]);
                    index += 1;
                }
            };
            match &(*else_branch) {
                Some(value) => {
                    *value = rewriter.rewrite_block(*value);
                },
                None => {},
            };
        },
        ComptimeIf(condition, then_branch, else_branch) => {
            *condition = rewriter.rewrite_expr(*condition);
            *then_branch = rewriter.rewrite_block(*then_branch);
            *else_branch = rewriter.rewrite_block(*else_branch);
        },
        For(pattern, iterable, body) => {
            *iterable = rewriter.rewrite_expr(*iterable);
            *pattern = rewriter.rewrite_pattern(*pattern);
            *body = rewriter.rewrite_block(*body);
        },
        While(condition, body) => {
            rewrite_condition(&(*condition), rewriter);
            *body = rewriter.rewrite_block(*body);
        },
        Loop(body) => {
            *body = rewriter.rewrite_block(*body);
        },
        Match(expr, arms) => {
            *expr = rewriter.rewrite_expr(*expr);
            {
                let index: u64 = 0;
                while index < (*arms).len() {
                    (*arms)[index] = rewriter.rewrite_match_arm((*arms)[index]);
                    index += 1;
                }
            };
        },
        Return(expr) => {
            match &(*expr) {
                Some(value) => {
                    *value = rewriter.rewrite_expr(*value);
                },
                None => {},
            };
        },
        Break(expr) => {
            match &(*expr) {
                Some(value) => {
                    *value = rewriter.rewrite_expr(*value);
                },
                None => {},
            };
        },
        Continue => {
        },
        Defer(action) => {
            *action = rewriter.rewrite_expr(*action);
        },
        Assert(condition, message) => {
            *condition = rewriter.rewrite_expr(*condition);
            match &(*message) {
                Some(value) => {
                    *value = rewriter.rewrite_expr(*value);
                },
                None => {},
            };
        },
        Delete(target) => {
            *target = rewriter.rewrite_expr(*target);
        },
        Semi(expr) => {
            *expr = rewriter.rewrite_expr(*expr);
        },
        ClosureExpr(captures, params, return_type, body) => {
            {
                let index: u64 = 0;
                while index < (*captures).len() {
                    (*captures)[index] = rewriter.rewrite_capture_item((*captures)[index]);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*params).len() {
                    rewrite_parameter(&((*params)[index]), rewriter);
                    index += 1;
                }
            };
            match &(*return_type) {
                Some(value) => {
                    *value = rewriter.rewrite_type_syntax(*value);
                },
                None => {},
            };
            *body = rewriter.rewrite_block(*body);
        },
        CompileConfig(name) => {
        },
    };
}

pub fn rewrite_type_syntax_children(node: TypeSyntax&, rewriter: AstRewriter&) {
    match &node.data {
        IntType(signed, width) => {
        },
        FloatType(width) => {
        },
        BoolType => {
        },
        StrType => {
        },
        CharType => {
        },
        VoidType => {
        },
        NeverType => {
        },
        DeducedType => {
        },
        CScalarType(name) => {
        },
        CPtrType(pointee_type) => {
            *pointee_type = rewriter.rewrite_type_syntax(*pointee_type);
        },
        NamedType(name) => {
            *name = rewriter.rewrite_identifier(*name);
        },
        ArrayType(element_type, size) => {
            *element_type = rewriter.rewrite_type_syntax(*element_type);
            *size = rewriter.rewrite_const_expr(*size);
        },
        TupleType(element_types) => {
            {
                let index: u64 = 0;
                while index < (*element_types).len() {
                    (*element_types)[index] = rewriter.rewrite_type_syntax((*element_types)[index]);
                    index += 1;
                }
            };
        },
        PointerType(pointee_type) => {
            *pointee_type = rewriter.rewrite_type_syntax(*pointee_type);
        },
        RefType(pointee_type) => {
            *pointee_type = rewriter.rewrite_type_syntax(*pointee_type);
        },
        SliceType(element_type) => {
            *element_type = rewriter.rewrite_type_syntax(*element_type);
        },
        InstanceType(base, generic_args) => {
            *base = rewriter.rewrite_type_syntax(*base);
            {
                let index: u64 = 0;
                while index < (*generic_args).len() {
                    rewrite_generic_argument(&((*generic_args)[index]), rewriter);
                    index += 1;
                }
            };
        },
        FunctionType(param_types, return_type) => {
            {
                let index: u64 = 0;
                while index < (*param_types).len() {
                    (*param_types)[index] = rewriter.rewrite_type_syntax((*param_types)[index]);
                    index += 1;
                }
            };
            *return_type = rewriter.rewrite_type_syntax(*return_type);
        },
    };
}

pub fn rewrite_const_expr_children(node: ConstExpr&, rewriter: AstRewriter&) {
    match &node.data {
        LiteralConstExpr(literal) => {
            *literal = rewriter.rewrite_int_literal(*literal);
        },
        GenericConstExpr(name) => {
            *name = rewriter.rewrite_identifier(*name);
        },
        UnaryConstExpr(op, operand) => {
            *operand = rewriter.rewrite_const_expr(*operand);
        },
        BinaryConstExpr(op, left, right) => {
            *left = rewriter.rewrite_const_expr(*left);
            *right = rewriter.rewrite_const_expr(*right);
        },
    };
}

pub fn rewrite_pattern_children(node: Pattern&, rewriter: AstRewriter&) {
    match &node.data {
        WildcardPattern => {
        },
        LiteralPattern(literal) => {
            rewrite_literal(&(*literal), rewriter);
        },
        RangePattern(bounds) => {
            rewrite_range_bounds(&(*bounds), rewriter);
        },
        NamePattern(name) => {
            *name = rewriter.rewrite_identifier(*name);
        },
        BindPattern(name, inner) => {
            *name = rewriter.rewrite_identifier(*name);
            *inner = rewriter.rewrite_pattern(*inner);
        },
        OrPattern(alternatives) => {
            {
                let index: u64 = 0;
                while index < (*alternatives).len() {
                    (*alternatives)[index] = rewriter.rewrite_pattern((*alternatives)[index]);
                    index += 1;
                }
            };
        },
        ConstructPattern(name, qualifier, arguments, rest) => {
            *name = rewriter.rewrite_identifier(*name);
            match &(*qualifier) {
                Some(value) => {
                    *value = rewriter.rewrite_type_syntax(*value);
                },
                None => {},
            };
            rewrite_pattern_arguments(&(*arguments), rewriter);
        },
        TuplePattern(elements) => {
            {
                let index: u64 = 0;
                while index < (*elements).len() {
                    (*elements)[index] = rewriter.rewrite_pattern((*elements)[index]);
                    index += 1;
                }
            };
        },
        SequencePattern(prefix, suffix, rest) => {
            {
                let index: u64 = 0;
                while index < (*prefix).len() {
                    (*prefix)[index] = rewriter.rewrite_pattern((*prefix)[index]);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*suffix).len() {
                    (*suffix)[index] = rewriter.rewrite_pattern((*suffix)[index]);
                    index += 1;
                }
            };
        },
    };
}

pub fn rewrite_item_children(node: Item&, rewriter: AstRewriter&) {
    match &node.data {
        Import(paths, target, alias, end) => {
            {
                let index: u64 = 0;
                while index < (*paths).len() {
                    (*paths)[index] = rewriter.rewrite_identifier((*paths)[index]);
                    index += 1;
                }
            };
            *target = rewriter.rewrite_identifier(*target);
            match &(*alias) {
                Some(value) => {
                    *value = rewriter.rewrite_identifier(*value);
                },
                None => {},
            };
        },
        Alias(attrs, name, generics, target) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_param(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
            *target = rewriter.rewrite_type_syntax(*target);
        },
        FuncDef(attrs, name, generics, params, ret_type, body) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_param(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*params).len() {
                    rewrite_parameter(&((*params)[index]), rewriter);
                    index += 1;
                }
            };
            match &(*ret_type) {
                Some(value) => {
                    *value = rewriter.rewrite_type_syntax(*value);
                },
                None => {},
            };
            *body = rewriter.rewrite_block(*body);
        },
        ConstDef(attrs, name, const_type, value) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
            *const_type = rewriter.rewrite_type_syntax(*const_type);
            *value = rewriter.rewrite_expr(*value);
        },
        OpaqueTypeDef(attrs, name) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
        },
        ExternBlock(attrs, abi, functions) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*functions).len() {
                    (*functions)[index] = rewriter.rewrite_extern_func_decl((*functions)[index]);
                    index += 1;
                }
            };
        },
        StructDef(attrs, name, generics, fields) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_param(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*fields).len() {
                    (*fields)[index] = rewriter.rewrite_field_info((*fields)[index]);
                    index += 1;
                }
            };
        },
        EnumDef(attrs, name, generics, variants) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_param(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*variants).len() {
                    (*variants)[index] = rewriter.rewrite_variant_info((*variants)[index]);
                    index += 1;
                }
            };
        },
        TraitDef(attrs, name, generics, items) => {
            {
                let index: u64 = 0;
                while index < (*attrs).len() {
                    (*attrs)[index] = rewriter.rewrite_attr((*attrs)[index]);
                    index += 1;
                }
            };
            *name = rewriter.rewrite_identifier(*name);
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_param(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*items).len() {
                    rewrite_trait_member(&((*items)[index]), rewriter);
                    index += 1;
                }
            };
        },
        Impl(generics, target, trait_type, items, conditions) => {
            {
                let index: u64 = 0;
                while index < (*generics).len() {
                    rewrite_generic_param(&((*generics)[index]), rewriter);
                    index += 1;
                }
            };
            *target = rewriter.rewrite_type_syntax(*target);
            match &(*trait_type) {
                Some(value) => {
                    *value = rewriter.rewrite_type_syntax(*value);
                },
                None => {},
            };
            {
                let index: u64 = 0;
                while index < (*items).len() {
                    (*items)[index] = rewriter.rewrite_method_def((*items)[index]);
                    index += 1;
                }
            };
            {
                let index: u64 = 0;
                while index < (*conditions).len() {
                    (*conditions)[index] = rewriter.rewrite_impl_condition((*conditions)[index]);
                    index += 1;
                }
            };
        },
    };
}

pub fn rewrite_literal(node: Literal&, rewriter: AstRewriter&) {
    match node {
        Integer(value) => {
            *value = rewriter.rewrite_int_literal(*value);
        },
        Float(value) => {
            *value = rewriter.rewrite_float_literal(*value);
        },
        Character(value) => {
            *value = rewriter.rewrite_char_literal(*value);
        },
        StringLiteral(value) => {
            *value = rewriter.rewrite_str_literal(*value);
        },
        Boolean(value) => {
            *value = rewriter.rewrite_bool_literal(*value);
        },
    };
}

pub fn rewrite_range_bounds(node: RangeBounds&, rewriter: AstRewriter&) {
    match node {
        Integer(lower, upper) => {
            *lower = rewriter.rewrite_int_literal(*lower);
            *upper = rewriter.rewrite_int_literal(*upper);
        },
        Character(lower, upper) => {
            *lower = rewriter.rewrite_char_literal(*lower);
            *upper = rewriter.rewrite_char_literal(*upper);
        },
    };
}

pub fn rewrite_condition(node: Condition&, rewriter: AstRewriter&) {
    match node {
        Expression(value) => {
            *value = rewriter.rewrite_expr(*value);
        },
        Let(value) => {
            *value = rewriter.rewrite_let_condition(*value);
        },
    };
}

pub fn rewrite_generic_argument(node: GenericArgument&, rewriter: AstRewriter&) {
    match node {
        Type(value) => {
            *value = rewriter.rewrite_type_syntax(*value);
        },
        Constant(value) => {
            *value = rewriter.rewrite_const_expr(*value);
        },
    };
}

pub fn rewrite_generic_param(node: GenericParam&, rewriter: AstRewriter&) {
    match node {
        Type(value) => {
            *value = rewriter.rewrite_type_generic_param(*value);
        },
        Constant(value) => {
            *value = rewriter.rewrite_const_generic_param(*value);
        },
    };
}

pub fn rewrite_parameter(node: Parameter&, rewriter: AstRewriter&) {
    match node {
        Named(value) => {
            *value = rewriter.rewrite_var_info(*value);
        },
        Pattern(value) => {
            *value = rewriter.rewrite_pattern_param(*value);
        },
    };
}

pub fn rewrite_trait_member(node: TraitMember&, rewriter: AstRewriter&) {
    match node {
        Declaration(value) => {
            *value = rewriter.rewrite_method_decl(*value);
        },
        Definition(value) => {
            *value = rewriter.rewrite_method_def(*value);
        },
    };
}

pub fn rewrite_pattern_arguments(node: PatternArguments&, rewriter: AstRewriter&) {
    match node {
        None => {
        },
        Positional(values) => {
            {
                let index: u64 = 0;
                while index < (*values).len() {
                    (*values)[index] = rewriter.rewrite_pattern((*values)[index]);
                    index += 1;
                }
            };
        },
        Named(values) => {
            {
                let index: u64 = 0;
                while index < (*values).len() {
                    (*values)[index] = rewriter.rewrite_field_pattern((*values)[index]);
                    index += 1;
                }
            };
        },
    };
}
