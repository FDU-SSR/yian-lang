from std.core.drop import Drop;
from std.core.env import args, exit;
from std.core.io import Stderr, Stdout;
from std.core.string import String;
from std.core.vec import Vec;
from compiler.frontend.source import SourceManager, collect_sources;
from compiler.frontend.lex.lexer import Lexer;
from compiler.frontend.lex.token import drop_tokens;
from json.write import Writer;
from compiler.frontend.observe import append_token_file, lex_code, parse_code;
from compiler.frontend.ast.format import AstFormatter;
from compiler.frontend.parse.state import Parser;
from compiler.frontend.parse.items import parse_program;
from compiler.frontend.desugar import desugar;

fn release_arguments(arguments: Vec<String>&) {
    let index: u64 = 0u64;
    while index < arguments.len() {
        arguments[index].drop();
        index += 1u64;
    }
    arguments.drop();
}

fn release_paths(paths: Vec<String>&) {
    let index: u64 = 0u64;
    while index < paths.len() {
        paths[index].drop();
        index += 1u64;
    }
    paths.drop();
}

fn write_output(text: str) -> bool {
    return match Stdout.write_all(text) {
        Ok(_) => true,
        Err(problem) => { problem.drop(); false },
    };
}

fn emit_json(writer: Writer&) -> bool {
    return match writer.finish() {
        Ok(text) => { defer text.drop(); write_output(text.as_str()) && write_output("\n") },
        Err(_) => false,
    };
}

fn diagnostic_start(writer: Writer&, stage: str, path: str) {
    writer.end_array(); writer.key("diagnostic"); writer.begin_object();
    writer.key("stage"); writer.write_string(stage);
    writer.key("path"); writer.write_string(path);
}

fn diagnostic_end(writer: Writer&) {
    writer.end_object(); writer.end_object(); emit_json(writer);
}

fn frontend(arguments: Vec<String>&) -> bool {
    let phase = arguments[2u64].as_str();
    let roots = Vec<String>.new();
    defer roots.drop();
    let index: u64 = 3u64;
    while index < arguments.len() {
        roots.push(arguments[index]);
        index += 1u64;
    }
    let paths = match collect_sources(&roots) {
        Ok(value) => value,
        Err(problem) => {
            problem.drop();
            let writer = Writer.new(); defer writer.drop();
            writer.begin_object(); writer.key("version"); writer.write_u64(1);
            writer.key("files"); writer.begin_array(); writer.end_array();
            writer.key("diagnostic"); writer.begin_object();
            writer.key("stage"); writer.write_string("io");
            diagnostic_end(&writer);
            return false;
        },
    };
    defer release_paths(&paths);
    let sources = SourceManager.new();
    defer sources.drop();
    let output = Writer.with_max_depth(512u64);
    output.begin_object(); output.key("version"); output.write_u64(1);
    output.key("phase"); output.write_string(phase);
    output.key("files"); output.begin_array();
    defer output.drop();
    index = 0u64;
    while index < paths.len() {
        let id = match sources.load(paths[index].as_str()) {
            Ok(value) => value,
            Err(problem) => {
                problem.drop();
                diagnostic_start(&output, "io", paths[index].as_str());
                diagnostic_end(&output);
                return false;
            },
        };
        let source = sources.file(id);
        let lexer = Lexer.new(source.text());
        let tokens = match lexer.run() {
            Ok(value) => value,
            Err(problem) => {
                diagnostic_start(&output, "lex", source.path());
                output.key("code"); output.write_string(lex_code(problem.message()));
                output.key("severity"); output.write_string("error");
                output.key("message"); output.write_string(problem.message());
                problem.span().write_json(&output);
                diagnostic_end(&output);
                problem.drop();
                return false;
            },
        };
        if phase == "tokens" {
            append_token_file(&output, source.path(), &tokens);
        } else {
            let parser = Parser.new(&tokens);
            let tree = match parse_program(&parser) {
                Ok(value) => value,
                Err(problem) => {
                    diagnostic_start(&output, "parse", source.path());
                    output.key("code"); output.write_string(parse_code(problem.message()));
                    output.key("severity"); output.write_string("error");
                    output.key("message"); output.write_string(problem.message());
                    problem.span().write_json(&output);
                    diagnostic_end(&output);
                    problem.drop();
                    drop_tokens(&tokens);
                    return false;
                },
            };
            if phase == "desugared" { desugar(&tree, source.path()); }
            output.begin_object(); output.key("path");
            output.write_string(source.path()); output.key("ast");
            let formatter = AstFormatter.new(&output);
            formatter.append_program(tree.root);
            output.end_object();
            tree.drop();
        }
        drop_tokens(&tokens);
        index += 1u64;
    }
    output.end_array(); output.key("diagnostic"); output.write_null(); output.end_object();
    return emit_json(&output);
}

fn main() {
    let arguments = args();
    if arguments.len() >= 4u64 && arguments[1u64].as_str() == "--frontend-json" &&
    (arguments[2u64].as_str() == "tokens" || arguments[2u64].as_str() == "ast" ||
        arguments[2u64].as_str() == "desugared") {
        let success = frontend(&arguments);
        release_arguments(&arguments);
        if !success { exit(1i32); }
        return;
    }
    match Stderr.write_all("usage: compiler --frontend-json {tokens,ast,desugared} INPUT...\n") {
        Ok(_) => {},
        Err(problem) => problem.drop(),
    };
    release_arguments(&arguments);
    exit(2i32);
}
