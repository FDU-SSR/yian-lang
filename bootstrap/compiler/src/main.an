from compiler.frontend.diagnostics import lex_code, parse_code;
from compiler.frontend.prepare import prepare_file, PreparationStage;
from compiler.common.ids import SourceId;
from std.core.drop import Drop;
from std.core.env import exit;
from std.core.io import IoError, Stderr, Stdout;
from std.core.string import String;
from std.core.vec import Vec;
from compiler.config import FrontendPhase, parse_args;
from compiler.analysis.cli import analyze_cli;
from compiler.driver.compile import compile_cli;
from compiler.frontend.source import SourceManager, collect_sources, Span;
from json.write import Writer;
from compiler.frontend.observe import append_token_file;
from compiler.frontend.ast.format import AstFormatter;

fn release_paths(paths: Vec<String>&) {
    let index: u64 = 0u64;

    while index < paths.len() {
        paths[index].drop();
        index += 1u64;
    }

    paths.drop();
}

fn write_output(text: str) -> bool {
    return match Stdout.new().write_str(text) {
        Ok(_) => true,
        Err(problem) => {
            problem.drop();
            false
        },
    };
}

fn emit_json(writer: Writer&) -> bool {
    return match writer.finish() {
        Ok(text) => {
            defer text.drop();
            write_output(text.as_str()) && write_output("\n")
        },
        Err(_) => false,
    };
}

// The files array is open on entry; close it and open the sibling diagnostic object.
fn diagnostic_start(writer: Writer&, stage: str, path: str) {
    writer.end_array();

    writer.key("diagnostic");
    writer.begin_object();
    writer.key("stage");
    writer.write_string(stage);

    writer.key("path");
    writer.write_string(path);
}

// Close the diagnostic and outer response objects, then write the complete JSON response.
fn diagnostic_end(writer: Writer&) {
    writer.end_object();
    writer.end_object();
    emit_json(writer);
}

// I/O diagnostics retain the message and include the raw system error code when available.
fn io_error_fields(writer: Writer&, problem: IoError&) {
    writer.key("message");
    writer.write_string(problem.msg());

    match problem.raw_os_error() {
        Some(code) => {
            writer.key("osError");
            writer.write_i64(i64(code));
        },
        None => {},
    }
}

// Path-collection failures have no file observations; output empty files and an I/O diagnostic.
fn collection_diagnostic(problem: IoError&) {
    let writer = Writer.new();
    defer writer.drop();

    writer.begin_object();
    writer.key("version");
    writer.write_u64(1);

    writer.key("files");
    writer.begin_array();
    writer.end_array();

    writer.key("diagnostic");
    writer.begin_object();
    writer.key("stage");
    writer.write_string("io");
    io_error_fields(&writer, problem);
    diagnostic_end(&writer);
}

fn source_diagnostic(output: Writer&, stage: str, path: str, message: str, span: Span) {
    diagnostic_start(output, stage, path);

    output.key("code");
    output.write_string(if stage == "lex" {
            lex_code(message).text()
        } else {
            parse_code(message).text()
        });

    output.key("severity");
    output.write_string("error");

    output.key("message");
    output.write_string(message);
    span.write_json(output);
    diagnostic_end(output);
}

// Local scopes release per-file resources on success, parse failure, and desugaring failure.
fn observe_file(output: Writer&, phase: FrontendPhase, id: SourceId, path: str, source: str) -> bool {
    let prepared = match prepare_file(id, path, source, phase) {
        Ok(value) => value,
        Err(problem) => {
            defer problem.drop();
            source_diagnostic(output, if problem.stage == PreparationStage.Lex {
                    "lex"
                } else {
                    "parse"
                }, path, problem.message.as_str(), problem.span);
            return false;
        },
    };
    defer prepared.drop();

    if phase == FrontendPhase.Tokens {
        append_token_file(output, path, &prepared.tokens);
        return true;
    }

    let tree = prepared.tree.unwrap();

    output.begin_object();
    output.key("path");
    output.write_string(path);

    output.key("ast");
    AstFormatter.new(output).append_program(tree.root);
    output.end_object();
    true
}

// Observe input files sequentially; the first failure ends observation and outputs a diagnostic with completed files.
fn frontend(phase: FrontendPhase, inputs: Vec<String>&) -> bool {
    let paths = match collect_sources(inputs) {
        Ok(value) => value,
        Err(problem) => {
            defer problem.drop();
            collection_diagnostic(&problem);
            return false;
        },
    };
    defer release_paths(&paths);

    let sources = SourceManager.new();
    defer sources.drop();
    let output = Writer.with_max_depth(512u64);
    output.begin_object();
    output.key("version");
    output.write_u64(1);

    output.key("phase");
    output.write_string(phase.name());

    output.key("files");
    output.begin_array();
    defer output.drop();

    let index = 0u64;

    while index < paths.len() {
        let id = match sources.load(paths[index].as_str()) {
            Ok(value) => value,
            Err(problem) => {
                defer problem.drop();
                diagnostic_start(&output, "io", paths[index].as_str());
                io_error_fields(&output, &problem);
                diagnostic_end(&output);
                return false;
            },
        };

        let source = sources.file(id);

        if !observe_file(&output, phase, SourceId(id), source.path(), source.text()) {
            return false;
        }

        index += 1u64;
    }

    output.end_array();

    output.key("diagnostic");
    output.write_null();
    output.end_object();
    return emit_json(&output);
}

fn write_error(text: str) {
    match Stderr.new().write_str(text) {
        Ok(_) => {}, Err(problem) => problem.drop(),
    }
}

fn main() {
    let status = match parse_args() {
        Ok(config) => {
            defer config.drop();

            match &config.action {
                Help(text) => if write_output(text.as_str()) {
                    0i32
                } else {
                    1i32
                },
                FrontendJson(phase) => if frontend(*phase, &config.inputs) {
                    0i32
                } else {
                    1i32
                },
                Analyze(json) => if analyze_cli(&config, *json) {
                    0i32
                } else {
                    1i32
                },
                Compile => if compile_cli(&config) { 0i32 } else { 1i32 },
            }
        },
        Err(message) => {
            defer message.drop();
            write_error(message.as_str());
            2i32
        },
    };

    if status != 0i32 {
        exit(status);
    }
}
