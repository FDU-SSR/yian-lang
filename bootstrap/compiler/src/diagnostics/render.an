from compiler.diagnostics.model import Diagnostic, DiagnosticLocation, AnalysisError;
from compiler.frontend.source import SourceManager, read_source;
from compiler.frontend.source import Span, Position;
from std.core.convert import From;
from std.core.drop import Drop;
from std.core.fmt import ToString;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.string import String;
from std.core.fs import current_dir, canonicalize;
from json.write import Writer;

// Resolve every location before the source owner is released, including related files.
pub fn detach(diagnostic: Diagnostic&, sources: SourceManager&) -> Result<(), AnalysisError> {
    match &diagnostic.location {
        Some(location) => {
            detach_location(location, sources)?;
        },
        None => {},
    }

    for related in diagnostic.related {
        detach_location(&related.location, sources)?;
    }

    Result<(), AnalysisError>.Ok(())
}

fn detach_location(location: DiagnosticLocation&, sources: SourceManager&) -> Result<(), AnalysisError> {
    match location {
        Source(value) => {
            let file = match sources.get(value.source.index) {
                Some(file) => file,
                None => return Result<(), AnalysisError>.Err(AnalysisError.internal("invalid diagnostic source ID")),
            };

            let detached = DiagnosticLocation.Detached(String.from(&file.path()), value.span);
            *location = detached;
        },
        Detached(_, _) => {},
    }

    Result<(), AnalysisError>.Ok(())
}

fn location_path(location: DiagnosticLocation&, sources: Option<SourceManager&>) -> Result<str, AnalysisError> {
    match location {
        Detached(path, _) => Result<str, AnalysisError>.Ok(path.as_str()),
        Source(value) => {
            let manager = match sources {
                Some(manager) => manager,
                None => return Result<str, AnalysisError>.Err(AnalysisError.internal("diagnostic requires its source manager")),
            };

            match manager.get(value.source.index) {
                Some(file) => Result<str, AnalysisError>.Ok(file.path()),
                None => Result<str, AnalysisError>.Err(AnalysisError.internal("invalid diagnostic source ID")),
            }
        },
    }
}

pub fn write_json(diagnostic: Diagnostic&, output: Writer&, sources: Option<SourceManager&>) -> Result<(), AnalysisError> {
    output.begin_object();
    output.key("code");
    output.write_string(diagnostic.code.text());
    output.key("severity");
    output.write_string(match diagnostic.severity {
            Error => "error",
            Warning => "warning",
            Note => "information"
        });
    output.key("message");
    output.write_string(diagnostic.message.as_str());
    let path = match &diagnostic.location {
        Some(location) => String.from(&location_path(location, sources)?),
        None => match current_dir() {
            Ok(value) => { defer value.drop(); String.from(&value.as_str()) },
            Err(problem) => { problem.drop(); String.from(&".") },
        },
    };
    defer path.drop();
    let uri = file_uri(path.as_str());
    defer uri.drop();
    output.key("uri");
    output.write_string(uri.as_str());
    output.key("range");
    let span = match &diagnostic.location {
        Some(location) => location.span(),
        None => Span(Position(0, 0), Position(0, 0)),
    };
    let text = diagnostic_text(&diagnostic.location, sources);
    defer text.drop();
    output.begin_object();
    output.key("start");
    write_position(span.start.row, span.start.column, text.as_str(), output);
    output.key("end");
    write_position(span.end.row, span.end.column, text.as_str(), output);
    output.end_object();
    output.key("recovered");
    output.write_bool(diagnostic.recovered);
    output.end_object();
    Result<(), AnalysisError>.Ok(())
}

fn diagnostic_text(location: Option<DiagnosticLocation>&, sources: Option<SourceManager&>) -> String {
    match location {
        Some(value) => {
            match (value, sources) {
                (Source(span), Some(manager)) => return String.from(&manager.file(span.source.index).text()),
                _ => {},
            }
            match location_path(value, sources) {
                Ok(path) => match read_source(path) { Ok(text) => return text, Err(problem) => problem.drop(), },
                Err(problem) => problem.drop(),
            }
        },
        None => {},
    }
    String.new()
}

fn file_uri(path: str) -> String {
    let canonical = match canonicalize(path) {
        Ok(value) => { defer value.drop(); String.from(&value.as_str()) },
        Err(problem) => { problem.drop(); String.from(&path) },
    };
    defer canonical.drop();
    let uri = String.from(&"file://");
    let digits = "0123456789ABCDEF".as_slice();
    for byte in canonical.as_slice() {
        let ch = *byte;
        if (ch >= b'a' && ch <= b'z') || (ch >= b'A' && ch <= b'Z') || (ch >= b'0' && ch <= b'9') || ch == b'/' || ch == b'-' || ch == b'_' || ch == b'.' || ch == b'~' {
            uri.push(char(ch));
        } else {
            uri.push('%');
            uri.push(char(digits[u64(ch >> 4u32)]));
            uri.push(char(digits[u64(ch & 15u8)]));
        }
    }
    uri
}

// Internal columns count Unicode scalars; protocol columns count UTF-16 code units.
fn write_position(row: u64, column: u64, text: str, output: Writer&) {
    let current_row = 0u64;
    let current_column = 0u64;
    let units = 0u64;
    for ch in text.chars() {
        if current_row == row {
            if current_column >= column || ch == '\n' || ch == '\r' { break; }
            units += if u32(ch) > 0xFFFFu32 { 2u64 } else { 1u64 };
            current_column += 1;
        } elif ch == '\n' { current_row += 1; }
    }
    output.begin_object();
    output.key("line");
    output.write_u64(row);
    output.key("character");
    output.write_u64(units);
    output.end_object();
}

pub fn render(diagnostic: Diagnostic&, sources: Option<SourceManager&>) -> Result<String, AnalysisError> {
    let text = String.new();
    let transferred = false;
    defer {
        if !transferred {
            text.drop();
        }
    };

    text.push_str(match diagnostic.severity { Error => "error[", Warning => "warning[", Note => "note[", });
    text.push_str(diagnostic.code.text());
    text.push_str("]: ");
    text.push_str(diagnostic.message.as_str());

    match &diagnostic.location {
        Some(location) => {
            append_location(&text, location, sources)?;
        },
        None => {},
    }

    for related in diagnostic.related {
        text.push_str("\n  ");
        text.push_str(related.message.as_str());
        append_location(&text, &related.location, sources)?;
    }

    transferred = true;
    Result<String, AnalysisError>.Ok(text)
}

fn append_location(text: String&, location: DiagnosticLocation&, sources: Option<SourceManager&>) -> Result<(), AnalysisError> {
    text.push_str(" at ");
    text.push_str(location_path(location, sources)?);
    let span = location.span();
    let row = (span.start.row + 1).to_string();
    defer row.drop();
    let column = (span.start.column + 1).to_string();
    defer column.drop();
    text.push_str(":");
    text.push_str(row.as_str());
    text.push_str(":");
    text.push_str(column.as_str());
    Result<(), AnalysisError>.Ok(())
}
