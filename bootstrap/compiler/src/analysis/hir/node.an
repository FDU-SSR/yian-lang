from compiler.common.ids import HirId, PatternId, TypeId, SymbolId, NameId;
from compiler.common.location import SourceSpan;
from compiler.analysis.constant.value import IntegerValue;
from compiler.analysis.ty.model import EnumVariant, StructField;
from compiler.frontend.ast.atoms import BuiltinKind, MatchArmOrigin;
from compiler.frontend.ast.operator import BinaryOperator, UnaryOperator;
from std.core.drop import Drop;
from std.core.option import Option;
from std.core.vec import Vec;

pub struct Block {
    pub stmts: Vec<HirId>,
}

impl Drop for Block {
    pub fn drop() {
        self.stmts.drop();
    }
}

pub struct If {
    pub cond: HirId,
    pub then_branch: HirId,
    pub else_branch: Option<HirId>,
}

pub struct Let {
    pub init: Option<HirId>,
    pub symbol_id: Option<SymbolId>,
}

pub struct PatternLet {
    pub value: HirId,
    pub pattern: PatternId,
    pub else_branch: Option<HirId>,
    pub is_parameter: bool,
}

pub struct Match {
    pub value: HirId,
    pub arms: Vec<MatchArm>,
    pub is_ref: bool,
}

impl Drop for Match {
    pub fn drop() {
        self.arms.drop();
    }
}

pub struct Binary {
    pub op: BinaryOperator,
    pub left: HirId,
    pub right: HirId,
}

pub struct Unary {
    pub op: UnaryOperator,
    pub operand: HirId,
}

pub struct Call {
    pub func: TypeId,
    pub args: Vec<HirId>,
}

impl Drop for Call {
    pub fn drop() {
        self.args.drop();
    }
}

pub struct StructConstruct {
    pub struct_id: TypeId,
    pub field_values: Vec<(NameId, HirId)>,
}

impl Drop for StructConstruct {
    pub fn drop() {
        self.field_values.drop();
    }
}

pub struct Invoke {
    pub callable: HirId,
    pub args: Vec<HirId>,
}

impl Drop for Invoke {
    pub fn drop() {
        self.args.drop();
    }
}

pub struct Cast {
    pub value: HirId,
    pub target_type: TypeId,
}

pub struct BitCast {
    pub value: HirId,
    pub target_type: TypeId,
}

pub struct TraitObjectCoerce {
    pub value: HirId,
    pub concrete_type_id: TypeId,
    pub trait_type_id: TypeId,
    pub method_ids: Vec<TypeId>,
}

impl Drop for TraitObjectCoerce {
    pub fn drop() {
        self.method_ids.drop();
    }
}

pub struct MethodCall {
    pub receiver: HirId,
    pub method_id: TypeId,
    pub args: Vec<HirId>,
}

impl Drop for MethodCall {
    pub fn drop() {
        self.args.drop();
    }
}

pub struct TraitObjectMethodCall {
    pub receiver: HirId,
    pub trait_type_id: TypeId,
    pub method_id: TypeId,
    pub slot_index: u64,
    pub args: Vec<HirId>,
}

impl Drop for TraitObjectMethodCall {
    pub fn drop() {
        self.args.drop();
    }
}

pub struct VariantConstruct {
    pub enum_id: TypeId,
    pub variant: EnumVariant,
    pub args: Option<Vec<(NameId, HirId)>>,
}

impl Drop for VariantConstruct {
    pub fn drop() {
        match &self.args {
            Some(value) => value.drop(),
            None => {}
        };
    }
}

pub struct FieldAccess {
    pub receiver: HirId,
    pub field: StructField,
}

pub struct TupleAccess {
    pub receiver: HirId,
    pub index: u64,
}

pub struct ArrayAccess {
    pub array: HirId,
    pub index: HirId,
    pub element_type: TypeId,
    pub length: u64,
}

pub struct SliceAccess {
    pub slice: HirId,
    pub index: HirId,
    pub element_type: TypeId,
}

pub struct DynBuffer {
    pub element_type: TypeId,
    pub length: HirId,
    pub element: Option<HirId>,
}

pub struct Builtin {
    pub kind: BuiltinKind,
    pub type_args: Vec<TypeId>,
    pub args: Vec<HirId>,
}

impl Drop for Builtin {
    pub fn drop() {
        self.type_args.drop();
        self.args.drop();
    }
}

pub struct Tuple {
    pub field_values: Vec<HirId>,
}

impl Drop for Tuple {
    pub fn drop() {
        self.field_values.drop();
    }
}

pub struct Array {
    pub element_type: TypeId,
    pub elements: Vec<HirId>,
}

impl Drop for Array {
    pub fn drop() {
        self.elements.drop();
    }
}

pub struct ArrayRepeat {
    pub element_type: TypeId,
    pub element: HirId,
}

pub struct Closure {
    pub captures: Vec<(NameId, HirId)>,
}

impl Drop for Closure {
    pub fn drop() {
        self.captures.drop();
    }
}

pub struct MatchArm {
    pub span: SourceSpan,
    pub pattern: PatternId,
    pub guard: Option<HirId>,
    pub body: HirId,
    pub origin: MatchArmOrigin,
}

pub enum HirKind {
    Block {
        value: Block
    },
    Return {
        value: Option<HirId>
    },
    If {
        value: If
    },
    Loop {
        body: HirId
    },
    Break {
        value: Option<HirId>
    },
    Continue,
    Defer {
        action: HirId
    },
    Delete {
        target: HirId
    },
    Semi {
        expr: HirId
    },
    Let {
        value: Let
    },
    PatternLet {
        value: PatternLet
    },
    Match {
        value: Match
    },
    Binary {
        value: Binary
    },
    Unary {
        value: Unary
    },
    Call {
        value: Call
    },
    StructConstruct {
        value: StructConstruct
    },
    Invoke {
        value: Invoke
    },
    Cast {
        value: Cast
    },
    BitCast {
        value: BitCast
    },
    TraitObjectCoerce {
        value: TraitObjectCoerce
    },
    MethodCall {
        value: MethodCall
    },
    TraitObjectMethodCall {
        value: TraitObjectMethodCall
    },
    VariantConstruct {
        value: VariantConstruct
    },
    FieldAccess {
        value: FieldAccess
    },
    TupleAccess {
        value: TupleAccess
    },
    ArrayAccess {
        value: ArrayAccess
    },
    SliceAccess {
        value: SliceAccess
    },
    DynValue {
        value: HirId
    },
    DynBuffer {
        value: DynBuffer
    },
    Builtin {
        value: Builtin
    },
    Tuple {
        value: Tuple
    },
    Array {
        value: Array
    },
    ArrayRepeat {
        value: ArrayRepeat
    },
    Var {
        symbol_id: SymbolId
    },
    IntLiteral {
        value: IntegerValue
    },
    FloatLiteral {
        value: f64
    },
    CharLiteral {
        value: u32
    },
    StrLiteral {
        value: NameId
    },
    BoolLiteral {
        value: bool
    },
    Ty,
    Closure {
        value: Closure
    },
}

// The store owns payload buffers; ID edges never own their target nodes.
impl HirKind {
    pub fn name() -> str {
        match self {
            Block(_) => "Block",
            Return(_) => "Return",
            If(_) => "If",
            Loop(_) => "Loop",
            Break(_) => "Break",
            Continue => "Continue",
            Defer(_) => "Defer",
            Delete(_) => "Delete",
            Semi(_) => "Semi",
            Let(_) => "Let",
            PatternLet(_) => "PatternLet",
            Match(_) => "Match",
            Binary(_) => "Binary",
            Unary(_) => "Unary",
            Call(_) => "Call",
            StructConstruct(_) => "StructConstruct",
            Invoke(_) => "Invoke",
            Cast(_) => "Cast",
            BitCast(_) => "BitCast",
            TraitObjectCoerce(_) => "TraitObjectCoerce",
            MethodCall(_) => "MethodCall",
            TraitObjectMethodCall(_) => "TraitObjectMethodCall",
            VariantConstruct(_) => "VariantConstruct",
            FieldAccess(_) => "FieldAccess",
            TupleAccess(_) => "TupleAccess",
            ArrayAccess(_) => "ArrayAccess",
            SliceAccess(_) => "SliceAccess",
            DynValue(_) => "DynValue",
            DynBuffer(_) => "DynBuffer",
            Builtin(_) => "Builtin",
            Tuple(_) => "Tuple",
            Array(_) => "Array",
            ArrayRepeat(_) => "ArrayRepeat",
            Var(_) => "Var",
            IntLiteral(_) => "IntLiteral",
            FloatLiteral(_) => "FloatLiteral",
            CharLiteral(_) => "CharLiteral",
            StrLiteral(_) => "StrLiteral",
            BoolLiteral(_) => "BoolLiteral",
            Ty => "Ty",
            Closure(_) => "Closure",
        }
    }
}

pub struct HirNode {
    pub span: SourceSpan,
    pub type_id: TypeId,
    pub is_place: bool,
    pub kind: HirKind,
}

impl Drop for HirNode {
    pub fn drop() {
        match &self.kind {
            Block(value) => value.drop(),
            Match(value) => value.drop(),
            Call(value) => value.drop(),
            StructConstruct(value) => value.drop(),
            Invoke(value) => value.drop(),
            TraitObjectCoerce(value) => value.drop(),
            MethodCall(value) => value.drop(),
            TraitObjectMethodCall(value) => value.drop(),
            VariantConstruct(value) => value.drop(),
            Builtin(value) => value.drop(),
            Tuple(value) => value.drop(),
            Array(value) => value.drop(),
            Closure(value) => value.drop(),
            _ => {},
        }
    }
}
