from compiler.common.ids import UnitId, DefId, ScopeId, SymbolId;
from compiler.analysis.session.session import AnalysisSession;
from std.core.drop import Drop;
from std.core.vec import Vec;

// Local state borrows the session; copied stacks own independent container storage.
pub struct DefinitionState {
    pub session: AnalysisSession&,
    pub definition: DefId,
    pub unit: UnitId,
    pub scope: ScopeId,
    pub locals: Vec<SymbolId>,
    pub loop_depth: u64,
    pub defer_depth: u64,
}

impl DefinitionState {
    static pub fn new(session: AnalysisSession&, definition: DefId, unit: UnitId, scope: ScopeId) -> Self {
        Self(session, definition, unit, scope, Vec<SymbolId>.new(), 0, 0)
    }
}

impl Drop for DefinitionState {
    pub fn drop() {
        self.locals.drop();
    }
}
