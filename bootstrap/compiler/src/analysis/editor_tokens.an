from compiler.analysis.editor import EditorSnapshot;
from compiler.analysis.editor_facts import EditorMemberKind;
from compiler.analysis.session.session import CompilationUnit;
from compiler.analysis.symbol.model import SymbolKind;
from compiler.analysis.ty.model import TypeData, NominalKind;
from compiler.common.ids import SourceId, UnitId, SymbolId;
from compiler.common.location import SourceSpan;
from compiler.diagnostics.model import AnalysisError;
from compiler.frontend.lex.token import TokenPayload, KeywordKind;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

pub enum EditorSemanticKind {
    Type, Struct, Enum, Trait, TypeParameter, Function, Method,
    Field, Variant, Variable, Parameter,
}

pub struct EditorSemanticToken {
    pub location: SourceSpan,
    pub kind: EditorSemanticKind,
    pub declaration: bool,
    pub default_library: bool,
}

fn stdlib_source(snapshot: EditorSnapshot&, source: SourceId) -> bool {
    let index = 0u64;
    while index < snapshot.session().len() {
        match snapshot.session().unit(UnitId(index)) {
            Some(unit) if unit.source == source => return unit.is_stdlib,
            _ => {},
        }
        index += 1u64;
    }
    false
}

fn unit_for_source(snapshot: EditorSnapshot&, source: SourceId) -> Option<CompilationUnit&> {
    let index = 0u64;
    while index < snapshot.session().len() {
        match snapshot.session().unit(UnitId(index)) {
            Some(unit) if unit.source == source => return Option<CompilationUnit&>.Some(unit),
            _ => {},
        }
        index += 1u64;
    }
    Option<CompilationUnit&>.None
}

fn primitive_type_keyword(kind: KeywordKind) -> bool {
    match kind {
        Void | Bool | Char | Str | I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 |
        F16 | F32 | F64 | Int | Uint | Float => true,
        _ => false,
    }
}

fn symbol_kind(snapshot: EditorSnapshot&, symbol_id: SymbolId)
-> Result<Option<EditorSemanticKind>, AnalysisError> {
    let symbol = match snapshot.symbol(symbol_id) {
        Some(value) => value,
        None => return Result<Option<EditorSemanticKind>, AnalysisError>.Err(
            AnalysisError.internal("invalid symbol in editor semantic-token index")),
    };

    match symbol.kind {
        Function => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
            Option<EditorSemanticKind>.Some(EditorSemanticKind.Function)),
        Variable => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
            Option<EditorSemanticKind>.Some(EditorSemanticKind.Variable)),
        Parameter => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
            Option<EditorSemanticKind>.Some(EditorSemanticKind.Parameter)),
        Alias => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
            Option<EditorSemanticKind>.Some(EditorSemanticKind.Type)),
        Type => match snapshot.session().types.require(symbol.type_id)? {
            Generic(_) | ConstGeneric(_, _) => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
                Option<EditorSemanticKind>.Some(EditorSemanticKind.TypeParameter)),
            Nominal(definition, _) => {
                let record = match snapshot.session().types.definition(*definition) {
                    Some(value) => value,
                    None => return Result<Option<EditorSemanticKind>, AnalysisError>.Err(
                        AnalysisError.internal("nominal semantic-token symbol has no definition")),
                };
                let kind = match record.header().kind {
                    Struct => EditorSemanticKind.Struct,
                    Enum => EditorSemanticKind.Enum,
                    Trait => EditorSemanticKind.Trait,
                    _ => EditorSemanticKind.Type,
                };
                Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
                    Option<EditorSemanticKind>.Some(kind))
            },
            _ => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
                Option<EditorSemanticKind>.Some(EditorSemanticKind.Type)),
        },
        Constant | Module => Result<Option<EditorSemanticKind>, AnalysisError>.Ok(
            Option<EditorSemanticKind>.None),
    }
}

fn member_kind(kind: EditorMemberKind) -> EditorSemanticKind {
    match kind {
        Field => EditorSemanticKind.Field,
        Variant => EditorSemanticKind.Variant,
        Method => EditorSemanticKind.Method,
    }
}

fn classify_identifier(snapshot: EditorSnapshot&, source: SourceId, row: u64, column: u64,
    location: SourceSpan) -> Result<Option<EditorSemanticToken>, AnalysisError> {
    if snapshot.session().editor_facts.is_parameter_declaration(source, row, column) {
        return Result<Option<EditorSemanticToken>, AnalysisError>.Ok(
            Option<EditorSemanticToken>.Some(EditorSemanticToken(
            location, EditorSemanticKind.Parameter, true, stdlib_source(snapshot, source))));
    }

    match snapshot.resolved_member_at(source, row, column) {
        Some(member) => return Result<Option<EditorSemanticToken>, AnalysisError>.Ok(
            Option<EditorSemanticToken>.Some(EditorSemanticToken(
            location, member_kind(member.kind), member.is_declaration,
            stdlib_source(snapshot, member.declaration.source)))),
        None => {},
    }

    let declaration = snapshot.session().editor_facts.declaration_at(source, row, column);
    let symbol_id = match declaration {
        Some(value) => value,
        None => match snapshot.resolved_name_at(source, row, column) {
            Some(reference) => reference.symbol,
            None => return Result<Option<EditorSemanticToken>, AnalysisError>.Ok(
                Option<EditorSemanticToken>.None),
        },
    };

    let symbol_semantic_kind = match symbol_kind(snapshot, symbol_id)? {
        Some(value) => value,
        None => return Result<Option<EditorSemanticToken>, AnalysisError>.Ok(
            Option<EditorSemanticToken>.None),
    };
    let token_kind = match (declaration, symbol_semantic_kind) {
        (None, EditorSemanticKind.Parameter) => EditorSemanticKind.Variable,
        _ => symbol_semantic_kind,
    };
    let symbol = snapshot.symbol(symbol_id).unwrap();
    Result<Option<EditorSemanticToken>, AnalysisError>.Ok(Option<EditorSemanticToken>.Some(
        EditorSemanticToken(location, token_kind, declaration.is_some(),
        stdlib_source(snapshot, snapshot.session().unit(symbol.unit).unwrap().source))))
}

// Semantic classification uses only resolved snapshot facts; it never guesses from spelling.
pub fn semantic_tokens(snapshot: EditorSnapshot&, source: SourceId)
-> Result<Vec<EditorSemanticToken>, AnalysisError> {
    let result = Vec<EditorSemanticToken>.new();

    let unit = match unit_for_source(snapshot, source) {
        Some(value) => value,
        None => return Result<Vec<EditorSemanticToken>, AnalysisError>.Ok(result),
    };

    for token in unit.prepared.tokens {
        match token.kind() {
            Identifier(_) => match classify_identifier(snapshot, source,
                token.span.start.row, token.span.start.column, SourceSpan(source, token.span))? {
                Some(value) => result.push(value),
                None => {},
            },
            Keyword(kind) if primitive_type_keyword(*kind) => result.push(EditorSemanticToken(
                SourceSpan(source, token.span), EditorSemanticKind.Type, false, false)),
            _ => {},
        }
    }

    Result<Vec<EditorSemanticToken>, AnalysisError>.Ok(result)
}
