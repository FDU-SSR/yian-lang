from compiler.analysis.lowering.checker import ExprChecker;
from compiler.analysis.hir.node import HirKind, Tuple as HirTuple, Array as HirArray, ArrayRepeat as HirArrayRepeat;
from compiler.analysis.ty.relations import default_type, compatible;
from compiler.analysis.constant.evaluate import ConstantEvaluator;
from compiler.analysis.ty.properties import is_zst;
from compiler.analysis.hir.node import DynBuffer;
from compiler.common.ids import TypeId, HirId;
from compiler.frontend.ast.node import Expr;
from compiler.frontend.source import Span;
from compiler.diagnostics.model import AnalysisError;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.result import Result;
from std.core.option import Option;
from std.core.vec import Vec;

impl ExprChecker {
    pub fn dynamic_buffer(span: Span, size: Expr&, element: Expr&) -> Result<HirId, AnalysisError> {
        let value = self.expression(element)?;
        let element_type = default_type(self.ctx, self.type_of(value));
        let count = self.expression(size)?;
        count = self.coerce(count, self.ctx.primitives.unsigned)?;
        let initializer = match &self.ctx.session.hir.require(value)?.kind {
            Ty => {
                if !is_zst(self.ctx, element_type)? {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "uninitialized dynamic allocation requires a restricted allocation builtin"));
                }

                Option<HirId>.None
            },
            _ => Option<HirId>.Some(self.coerce(value, element_type)?),
        };
        Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.session.types.pointer(element_type), false, HirKind.DynBuffer(DynBuffer(element_type, count, initializer))))
    }

    pub fn tuple(span: Span, elements: Vec<Expr&>&) -> Result<HirId, AnalysisError> {
        let values = Vec<HirId>.new();
        let types = Vec<TypeId>.new();
        defer types.drop();
        let accepted = false;
        defer {
            if !accepted {
                values.drop();
            }
        };

        for element in *elements {
            let value = self.expression(*element)?;
            let type_id = self.type_of(value);
            values.push(value);
            types.push(type_id);
        }

        let type_id = self.ctx.session.types.tuple(&types);
        accepted = true;
        Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Tuple(HirTuple(values))))
    }

    pub fn array(span: Span, elements: Vec<Expr&>&) -> Result<HirId, AnalysisError> {
        if elements.len() == 0 {
            return Result<HirId, AnalysisError>.Err(self.error(span, "empty array literal has no element type"));
        }

        let values = Vec<HirId>.new();
        let accepted = false;
        defer {
            if !accepted {
                values.drop();
            }
        };
        let element_type = self.ctx.primitives.never;

        for element in *elements {
            let value = self.expression(*element)?;
            let type_id = self.type_of(value);

            if element_type == self.ctx.primitives.never {
                element_type = type_id;
            } elif !compatible(self.ctx, type_id, element_type) {
                if compatible(self.ctx, element_type, type_id) {
                    element_type = type_id;
                } else {
                    return Result<HirId, AnalysisError>.Err(self.error(element.span, "array elements have incompatible types"));
                }
            }

            values.push(value);
        }

        let index = 0u64;

        while index < values.len() {
            values[index] = self.coerce(values[index], element_type)?;
            index += 1;
        }

        let length = self.ctx.session.types.literal(values.len(), false, self.ctx.primitives.unsigned);
        let type_id = self.ctx.session.types.array(element_type, length);
        accepted = true;
        Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Array(HirArray(element_type, values))))
    }

    pub fn repeated_array(span: Span, element: Expr&, count: Expr&) -> Result<HirId, AnalysisError> {
        let value = self.expression(element)?;
        let element_type = self.type_of(value);
        let count_id = self.expression(count)?;
        let evaluator = ConstantEvaluator.new(&self.ctx.session.types, &self.ctx.session.hir, self.sizes);
        let constant = evaluator.evaluate(count_id)?;
        let length = match &constant.value {
            Integer(value) => {
                if value.is_negative() {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "array length must be nonnegative"));
                }

                value.raw_bits()
            },
            _ => return Result<HirId, AnalysisError>.Err(self.error(span, "array length requires an integer constant")),
        };
        let length_type = self.ctx.session.types.literal(length, false, self.ctx.primitives.unsigned);
        let type_id = self.ctx.session.types.array(element_type, length_type);
        Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.ArrayRepeat(HirArrayRepeat(element_type, value))))
    }
}
