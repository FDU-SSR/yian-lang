from compiler.analysis.lowering.checker import ExprChecker;
from compiler.analysis.hir.node import HirNode, HirKind;
from compiler.analysis.hir.traversal import HirVisitor, walk_expr;
from compiler.common.ids import HirId, TypeId;
from compiler.common.traversal import WalkControl;
from compiler.frontend.source import Span;
from compiler.diagnostics.model import AnalysisError;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

struct ExitCollector {
    exits: Vec<HirId>,
}

impl HirVisitor for ExitCollector {
    pub fn enter_expr(id: HirId, node: HirNode&) -> Result<WalkControl, AnalysisError> {
        match &node.kind {
            // Nested loops own their exits. Closure bodies have separate procedure roots.
            Loop(_) => return Result<WalkControl, AnalysisError>.Ok(WalkControl.Skip),
            Break(_) => { self.exits.push(id); },
            _ => {},
        }
        Result<WalkControl, AnalysisError>.Ok(WalkControl.Continue)
    }
}

impl ExprChecker {
    // This runs during HIR construction, before any analysis result exposes the body.
    // Child links are finalized after the read-only walk has released its traversal state.
    fn typed_loop(span: Span, body: HirId, expected: TypeId) -> Result<HirId, AnalysisError> {
        let collector = ExitCollector(Vec<HirId>.new());
        defer collector.exits.drop();
        walk_expr(&self.ctx.session.hir, body, &collector)?;

        for id in collector.exits {
            match &self.ctx.session.hir.require(*id)?.kind {
                Break(value) => match value {
                    Some(inner) => { *value = Option<HirId>.Some(self.coerce(*inner, expected)?); },
                    None => {},
                },
                _ => return Result<HirId, AnalysisError>.Err(AnalysisError.internal("collected loop exit is not a break")),
            }
        }
        Result<HirId, AnalysisError>.Ok(self.node(span, expected, false, HirKind.Loop(body)))
    }
}
