from compiler.analysis.lowering.checker import ExprChecker, LoopContext;
from compiler.analysis.resolution.types import resolve_type, apply_arguments, builtin_constructor;
from compiler.analysis.ty.substitution import has_generic;
from compiler.analysis.ty.relations import compatible, default_type;
from compiler.analysis.ty.validation import contains_ffi, validate_value;
from compiler.analysis.ty.model import NominalKind;
from compiler.analysis.symbol.model import SymbolKind;
from compiler.analysis.hir.node import HirKind, Block as HirBlock, Let as HirLet, If as HirIf, Match as HirMatch, MatchArm as HirMatchArm, FieldAccess, Builtin as HirBuiltin;
from compiler.analysis.constant.evaluate import ConstantEvaluator;
from compiler.common.ids import ScopeId, HirId, SymbolId, TypeId;
from compiler.frontend.ast.node import Expr, Block, Literal, Condition;
from compiler.frontend.ast.operator import UnaryOperator;
from compiler.frontend.ast.atoms import BuiltinKind;
from compiler.diagnostics.model import DiagnosticCode, AnalysisError, AnalysisErrorKind;
from std.core.drop import Drop;
from std.core.clone import Clone;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;
from compiler.common.location import SourceSpan;
from std.core.string import String;
from std.core.convert import From;

impl ExprChecker {
    fn condition(condition: Condition&) -> Result<HirId, AnalysisError> {
        match condition {
            Expression(value) => {
                let expression = self.expression(*value)?;
                self.coerce(expression, self.ctx.primitives.boolean)
            },
            Let(value) => Result<HirId, AnalysisError>.Err(AnalysisError.internal("pattern conditions must be desugared before lowering")),
        }
    }

    pub fn expression(expr: Expr&) -> Result<HirId, AnalysisError> {
        if self.ctx.session.editor_recovery && expr.syntax_recovered {
            match &expr.data {
                Call(callee, arguments) => {
                    self.expression(*callee)?;
                    for argument in *arguments { self.expression(argument.data.value)?; }
                },
                MethodCall(receiver, _, _, arguments) => {
                    self.expression(*receiver)?;
                    for argument in *arguments { self.expression(argument.data.value)?; }
                },
                Binary(_, left, right) => { self.expression(*left)?; self.expression(*right)?; },
                Array(elements) | Tuple(elements) | Recovery(elements, _) => { for element in *elements { self.expression(*element)?; } },
                ArrayRepeat(element, count) => { self.expression(*element)?; self.expression(*count)?; },
                _ => {},
            }
            let error = self.error(expr.span, "Incomplete editor expression");
            error.kind = AnalysisErrorKind.EditorIncomplete;
            return Result<HirId, AnalysisError>.Err(error);
        }
        match self.lower_expression(expr) {
            Ok(value) => {
                if self.ctx.session.editor_recovery {
                    match self.ctx.session.types.require(self.type_of(value))? {
                        Nominal(id, _) if !self.ctx.session.types.definition(*id).unwrap().is_complete() => {
                            let error = self.error(expr.span, "Unresolved editor declaration");
                            error.kind = AnalysisErrorKind.EditorIncomplete;
                            return Result<HirId, AnalysisError>.Err(error);
                        },
                        _ => {},
                    }
                }
                if self.ctx.session.editor_recovery && expr.syntax_span.is_some() {
                    let node = self.ctx.session.hir.require(value)?;
                    let span = match expr.syntax_span { Some(extent) => extent, None => expr.span };
                    let is_static = match &node.kind { Ty => true, _ => false };
                    self.ctx.session.editor_facts.record_expression(self.ctx.span(self.unit, span),
                        node.type_id, node.is_place, is_static);
                }
                Result<HirId, AnalysisError>.Ok(value)
            },
            Err(problem) => Result<HirId, AnalysisError>.Err(problem.with_location(self.ctx.span(self.unit, expr.span))),
        }
    }

    fn lower_expression(expr: Expr&) -> Result<HirId, AnalysisError> {
        let span = expr.span;

        match &expr.data {
            Recovery(children, bindings) => {
                for child in *children { self.expression(*child)?; }
                let error = self.error(span, "Incomplete editor expression");
                error.kind = AnalysisErrorKind.EditorIncomplete;
                Result<HirId, AnalysisError>.Err(error)
            },
            Literal(value) => self.literal(span, value),
            Tuple(elements) => self.tuple(span, elements),
            Array(elements) => self.array(span, elements),
            ArrayRepeat(element, count) => self.repeated_array(span, *element, *count),
            ClosureExpr(captures, parameters, result, body) => self.closure(span, captures, parameters, result, *body),
            Identifier(name) => self.identifier(span, name.data.name.as_str(), name.data.synthetic),
            TypeItem(name, generics) => {
                if !self.ffi_allowed {
                    for argument in *generics {
                        match argument {
                            Type(value) => {
                                if self.ffi_syntax(*value)? {
                                    return Result<HirId, AnalysisError>.Err(self.error(span, "C ABI type argument requires an ffi function"));
                                }
                            },
                            Constant(_) => {},
                        }
                    }
                }

                match builtin_constructor(self.ctx, self.unit, self.scope, name.data.name.as_str(), generics, span)? {
                    Some(type_id) => return Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty)),
                    None => {},
                }

                if generics.len() == 0 {
                    return self.identifier(span, name.data.name.as_str(), name.data.synthetic);
                }

                let interned = self.ctx.session.names.intern(name.data.name.as_str());
                let symbol = match self.ctx.session.symbols.lookup(self.scope, interned) {
                    Some(value) => value,
                    None => return Result<HirId, AnalysisError>.Err(AnalysisError.named(DiagnosticCode.Type,
                        Option<SourceSpan>.Some(self.ctx.span(self.unit, name.span)), "Unknown type '", name.data.name.as_str(), "'")),
                };
                let kind = self.ctx.session.symbols.get(symbol).unwrap().kind;
                if kind != SymbolKind.Type && kind != SymbolKind.Function && kind != SymbolKind.Alias {
                    return Result<HirId, AnalysisError>.Err(AnalysisError.named(DiagnosticCode.Type,
                        Option<SourceSpan>.Some(self.ctx.span(self.unit, name.span)), "Unknown type '", name.data.name.as_str(), "'"));
                }

                let type_id = apply_arguments(self.ctx, self.unit, self.scope, symbol, generics, span)?;
                if !name.data.synthetic {
                    self.ctx.session.editor_facts.record(symbol, self.ctx.span(self.unit, name.span), type_id);
                }
                Result<HirId, AnalysisError>.Ok(self.node(span, type_id, false, HirKind.Ty))
            },
            CompileConfig(name) => {
                if name.as_str() != "IS_RAW_MODE" {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "unknown compile-time configuration"));
                }

                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.boolean, false, HirKind.BoolLiteral(self.ctx.session.raw_pointers)))
            },
            Block(value) => self.block(*value),
            Semi(value) => {
                let lowered = self.expression(*value)?;
                let concrete = default_type(self.ctx, self.type_of(lowered));
                lowered = self.coerce(lowered, concrete)?;
                let result = if self.type_of(lowered) == self.ctx.primitives.never {
                    self.ctx.primitives.never
                } else {
                    self.ctx.primitives.void
                };
                Result<HirId, AnalysisError>.Ok(self.node(span, result, false, HirKind.Semi(lowered)))
            },
            VarDecl(name, syntax, init) => {
                let annotation = self.local_type(*syntax)?;
                let value = match init {
                    Some(value) => Option<HirId>.Some(self.expression(*value)?),
                    None => Option<HirId>.None,
                };
                let type_id = if annotation == self.ctx.primitives.error {
                    match value {
                        Some(id) => default_type(self.ctx, self.type_of(id)),
                        None => return Result<HirId, AnalysisError>.Err(self.error(span, "uninitialized binding requires a type")),
                    }
                } else {
                    annotation
                };

                match self.ctx.session.types.require(type_id)? {
                    Nominal(definition, arguments) => {
                        let header = self.ctx.session.types.definition(*definition).unwrap().header();

                        if header.kind == NominalKind.Function || header.kind == NominalKind.Method {
                            for argument in *arguments {
                                if has_generic(&self.ctx.session.types, *argument) {
                                    return Result<HirId, AnalysisError>.Err(AnalysisError.named(DiagnosticCode.Type,
                                        Option<SourceSpan>.Some(self.ctx.span(self.unit, (*init.unwrap()).span)), "cannot use generic function '",
                                        self.ctx.session.names.text(header.name), "' as a value; a function variable must bind a concrete function"));
                                }
                            }
                        }
                    },
                    _ => {},
                }

                let converted = match value {
                    Some(id) => Option<HirId>.Some(self.coerce(id, type_id)?),
                    None => Option<HirId>.None,
                };
                let symbol = self.bind(name.data.name.as_str(), type_id, name.span, SymbolKind.Variable)?;
                validate_value(self.ctx, type_id, self.ctx.span(self.unit, span))?;

                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.void, false, HirKind.Let(HirLet(converted, Option<SymbolId>.Some(symbol)))))
            },
            Unary(op, operand) => self.unary(span, *op, *operand),
            Binary(op, left, right) => self.binary(span, *op, *left, *right),
            Call(callee, args) => self.call(span, *callee, args),
            TraitCall(trait_expr, self_type, trait_args, method_name, args) => self.trait_call(span, *trait_expr, self_type, trait_args, method_name.data.name.as_str(), args),
            FieldAccess(receiver, name) => {
                let value = self.expression(*receiver)?;
                self.field(span, name.span, value, name.data.name.as_str())
            },
            PatternLet(binding) => self.pattern_binding(*binding),
            Match(value, arms) => {
                let target = self.expression(*value)?;
                let target_type = default_type(self.ctx, self.type_of(target));

                match &self.ctx.session.hir.require(target)?.kind {
                    Unary(address) => {
                        if address.op == UnaryOperator.AddrOf {
                            match self.ctx.session.types.require(target_type)? {
                                Pointer(inner) => {
                                    target_type = self.ctx.session.types.reference(*inner);
                                }, _ => {}
                            }
                        }
                    },
                    _ => {},
                }

                target = self.coerce(target, target_type)?;
                match self.ctx.session.types.require(target_type)? {
                    Pointer(_) => return Result<HirId, AnalysisError>.Err(self.error((*value).span, "match does not accept pointer scrutinees; use '&value' or a reference")),
                    _ => {},
                }

                let values = Vec<HirMatchArm>.new();
                let accepted = false;
                defer {
                    if !accepted {
                        values.drop();
                    }
                };
                let previous = self.scope;
                defer self.scope = previous;
                let result_type = self.ctx.primitives.never;

                for arm in *arms {
                    self.scope = self.ctx.session.symbols.create_scope(Option<ScopeId>.Some(previous))?;
                    self.ctx.session.editor_facts.record_scope(self.ctx.span(self.unit, arm.span), self.scope);
                    let pattern = self.test_pattern(arm.data.pattern, target_type)?;
                    let guard = match &arm.data.guard {
                        Some(condition) => {
                            let value = self.expression(*condition)?;
                            Option<HirId>.Some(self.coerce(value, self.ctx.primitives.boolean)?)
                        },
                        None => Option<HirId>.None,
                    };
                    let body = self.block(arm.data.body)?;
                    let type_id = self.type_of(body);

                    if result_type == self.ctx.primitives.never {
                        result_type = type_id;
                    } elif !compatible(self.ctx, type_id, result_type) {
                        if compatible(self.ctx, result_type, type_id) {
                            result_type = type_id;
                        } else {
                            return Result<HirId, AnalysisError>.Err(self.error(arm.span, "match arm types differ"));
                        }
                    }

                    values.push(HirMatchArm(self.ctx.span(self.unit, arm.span), pattern, guard, body, arm.data.origin));
                }

                for arm in values {
                    arm.body = self.coerce(arm.body, result_type)?;
                }

                accepted = true;
                let by_ref = match self.ctx.session.types.require(target_type)? {
                    Reference(_) => true, _ => false
                };
                Result<HirId, AnalysisError>.Ok(self.node(span, result_type, false, HirKind.Match(HirMatch(target, values, by_ref))))
            },
            MethodCall(receiver, method_name, generics, args) => self.method(
                span, method_name.span, *receiver, method_name.data.name.as_str(), generics, args),
            Return(value) => {
                if self.deferred != 0 {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "'return' is not allowed inside a deferred action"));
                }

                let result = match value {
                    Some(value) => {
                        if self.return_type == self.ctx.primitives.void {
                            return Result<HirId, AnalysisError>.Err(self.error(value.span, "void function cannot return a value"));
                        }

                        let lowered = self.expression(*value)?;
                        Option<HirId>.Some(self.coerce(lowered, self.return_type)?)
                    },
                    None => {
                        if self.return_type != self.ctx.primitives.void {
                            return Result<HirId, AnalysisError>.Err(self.error(span, "return value is required"));
                        }

                        Option<HirId>.None
                    },
                };
                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.never, false, HirKind.Return(result)))
            },
            If(condition, then_branch, elif_branches, else_branch) => {
                let cond = self.condition(condition)?;
                let then_id = self.block(*then_branch)?;
                let otherwise = match else_branch {
                    Some(value) => Option<HirId>.Some(self.block(*value)?),
                    None => Option<HirId>.None,
                };
                let count = elif_branches.len();

                while count > 0 {
                    count -= 1;
                    let branch = elif_branches[count];
                    let cond = self.condition(&branch.data.condition)?;
                    let body = self.block(branch.data.body)?;
                    otherwise = Option<HirId>.Some(self.branch(branch.span, cond, body, otherwise)?);
                }

                self.branch(span, cond, then_id, otherwise)
            },
            ComptimeIf(condition, then_branch, else_branch) => {
                let lowered_condition = self.expression(*condition)?;
                let boolean_condition = self.coerce(lowered_condition, self.ctx.primitives.boolean)?;
                let evaluator = ConstantEvaluator.new(&self.ctx.session.types, &self.ctx.session.hir, self.sizes);
                let constant = match evaluator.evaluate(boolean_condition) {
                    Ok(value) => value,
                    Err(problem) => {
                        if problem.kind == AnalysisErrorKind.NotConstant {
                            problem.kind = AnalysisErrorKind.User;
                            let message = String.from(&"comptime if condition is not compile-time evaluable: ");
                            defer message.drop();
                            message.push_str(if problem.diagnostic.message.as_str() == "expression is not compile-time evaluable" {
                                    "condition depends on runtime state or has side effects"
                                } else { problem.diagnostic.message.as_str() });
                            return Result<HirId, AnalysisError>.Err(problem.with_message(message.as_str()));
                        }
                        if problem.diagnostic.code != DiagnosticCode.Constant {
                            return Result<HirId, AnalysisError>.Err(problem);
                        }

                        let message = String.from(&"comptime if condition evaluation failed: ");
                        defer message.drop();
                        message.push_str(problem.diagnostic.message.as_str());
                        return Result<HirId, AnalysisError>.Err(problem.with_message(message.as_str()));
                    },
                };

                defer constant.drop();
                match &constant.value {
                    Bool(value) => if *value {
                        self.block(*then_branch)
                    } else {
                        self.block(*else_branch)
                    },
                    _ => Result<HirId, AnalysisError>.Err(self.error(span, "compile-time condition requires a boolean")),
                }
            },
            Loop(body) => {
                self.loops.push(LoopContext.new(true));
                defer {
                    let frame = *self.loops.pop().unwrap();
                    frame.drop();
                };
                let body = self.block(*body)?;
                let result = self.loop_result(span)?;
                Result<HirId, AnalysisError>.Ok(self.node(span, result, false, HirKind.Loop(body)))
            },
            While(condition, body) => {
                self.loops.push(LoopContext.new(false));
                defer {
                    let frame = *self.loops.pop().unwrap();
                    frame.drop();
                };
                let cond = self.condition(condition)?;
                let body = self.block(*body)?;
                let exit = self.node(span, self.ctx.primitives.never, false, HirKind.Break(Option<HirId>.None));
                let branch = self.node(span, self.ctx.primitives.void, false, HirKind.If(HirIf(cond, body, Option<HirId>.Some(exit))));
                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.void, false, HirKind.Loop(branch)))
            },
            Break(value) => {
                if self.deferred != 0 {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "'break' is not allowed inside a deferred action"));
                }

                if self.loops.len() == 0 {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "'break' is only allowed inside a loop"));
                }

                let frame = self.loops.len() - 1;

                if value.is_some() && !self.loops[frame].accepts_value() {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "while does not accept a break value"));
                }

                let lowered = match value {
                    Some(expr) => Option<HirId>.Some(self.expression(*expr)?), None => Option<HirId>.None
                };
                let id = self.node(span, self.ctx.primitives.never, false, HirKind.Break(lowered));
                self.loops[frame].add_break(id);
                Result<HirId, AnalysisError>.Ok(id)
            },
            Continue => {
                if self.deferred != 0 {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "'continue' is not allowed inside a deferred action"));
                }

                if self.loops.len() == 0 {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "'continue' is only allowed inside a loop"));
                }

                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.never, false, HirKind.Continue))
            },
            Defer(action) => {
                if self.deferred != 0 {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "nested defer is not allowed inside a deferred action"));
                }

                self.deferred += 1;
                defer self.deferred -= 1;
                let action = self.expression(*action)?;
                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.void, false, HirKind.Defer(action)))
            },
            Assert(condition, message) => {
                let condition_id = self.expression(*condition)?;
                condition_id = self.coerce(condition_id, self.ctx.primitives.boolean)?;
                let message_id = match message {
                    Some(value) => {
                        let lowered = self.expression(*value)?;
                        self.coerce(lowered, self.ctx.primitives.string)?
                    },
                    None => {
                        let interned = self.ctx.session.names.intern("assertion failed");
                        self.node(span, self.ctx.primitives.string, false, HirKind.StrLiteral(interned))
                    },
                };
                let args = Vec<HirId>.new();
                args.push(message_id);
                let failure = self.node(span, self.ctx.primitives.never, false, HirKind.Builtin(HirBuiltin(BuiltinKind.Panic, Vec<TypeId>.new(), args)));
                let success = self.node(span, self.ctx.primitives.void, false, HirKind.Block(HirBlock(Vec<HirId>.new())));
                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.void, false, HirKind.If(HirIf(condition_id, success, Option<HirId>.Some(failure)))))
            },
            Builtin(kind, type_args, args) => {
                self.builtin(span, *kind, type_args, args)
            },
            DynValue(value) => {
                let lowered = self.expression(*value)?;
                let type_id = default_type(self.ctx, self.type_of(lowered));
                lowered = self.coerce(lowered, type_id)?;
                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.session.types.pointer(type_id), false, HirKind.DynValue(lowered)))
            },
            DynBuffer(size, element) => self.dynamic_buffer(span, *size, *element),
            Delete(target) => {
                let value = self.expression(*target)?;
                let allowed = match self.ctx.session.types.require(self.type_of(value))? {
                    Pointer(_) => true, Slice(_) => true, Reference(_) => true, _ => false
                };

                if !allowed {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "delete requires a pointer, slice, or reference"));
                }

                Result<HirId, AnalysisError>.Ok(self.node(span, self.ctx.primitives.void, false, HirKind.Delete(value)))
            },
            For(_, _, _) => Result<HirId, AnalysisError>.Err(AnalysisError.internal("for must be desugared before lowering")),
            TryExpr(_) => Result<HirId, AnalysisError>.Err(AnalysisError.internal("propagation must be desugared before lowering")),
        }
    }
}
