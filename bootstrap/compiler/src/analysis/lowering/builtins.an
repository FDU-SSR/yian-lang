from compiler.analysis.lowering.checker import ExprChecker;
from compiler.analysis.resolution.types import resolve_type;
from compiler.analysis.hir.node import HirKind, Builtin;
from compiler.analysis.ty.model import TypeData;
from compiler.analysis.ty.validation import validate_value;
from compiler.common.ids import TypeId, HirId;
from compiler.frontend.ast.node import TypeSyntax, Argument;
from compiler.frontend.ast.atoms import BuiltinKind;
from compiler.frontend.source import Span;
from compiler.diagnostics.model import AnalysisError, DiagnosticCode;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.result import Result;
from std.core.vec import Vec;
from std.core.string import String;
from std.core.convert import From;
from std.core.fmt import ToString;

fn arity(kind: BuiltinKind) -> (u64, u64) {
    match &kind {
        SizeOf => (1u64, 0u64), Undef => (1u64, 0u64), Dangling => (1u64, 0u64),
        BitCast => (1u64, 1u64), Alloc => (1u64, 1u64), Realloc => (1u64, 2u64),
        Panic => (0u64, 1u64), RuntimeFail => (0u64, 1u64), AssumeInit => (0u64, 1u64),
        MemCopy => (0u64, 3u64), SliceFromParts => (0u64, 2u64),
        SliceGetPtr => (0u64, 1u64), SliceGetLen => (0u64, 1u64),
        StrFromParts => (0u64, 2u64), StrGetPtr => (0u64, 1u64), StrGetLen => (0u64, 1u64),
        SysRead => (0u64, 2u64), SysReadBytes => (0u64, 2u64), SysWrite => (0u64, 2u64), SysWriteBytes => (0u64, 2u64),
        Open => (0u64, 2u64), Close => (0u64, 1u64), Sqrt => (0u64, 1u64), Sin => (0u64, 1u64), Cos => (0u64, 1u64),
        Argc => (0u64, 0u64), ArgBytes => (0u64, 1u64), Exit => (0u64, 1u64),
        FfiAddr => (0u64, 1u64), FfiParts => (0u64, 1u64), FfiNull => (1u64, 0u64),
        FfiPtrCast => (1u64, 1u64), FfiCopyFrom => (0u64, 3u64), FfiCopyTo => (0u64, 3u64),
    }
}

impl ExprChecker {
    fn c_element(span: Span, type_id: TypeId, incomplete: bool) -> Result<(), AnalysisError> {
        let legal = match self.ctx.session.types.require(type_id)? {
            Integer(_, _) => true,
            CScalar(_, _, _) => true,
            Float(bits) => *bits == 32 || *bits == 64,
            Opaque(_, _) => incomplete,
            CPointer(inner) => {
                self.c_element(span, *inner, true)?;
                true
            },
            _ => false,
        };

        if !legal {
            return Result<(), AnalysisError>.Err(self.error(span, "FFI pointer element must be C compatible"));
        }

        Result<(), AnalysisError>.Ok(())
    }

    pub fn builtin(span: Span, kind: BuiltinKind, type_args: Vec<TypeSyntax&>&, args: Vec<Argument&>&) -> Result<HirId, AnalysisError> {
        let counts = arity(kind);

        if type_args.len() != counts[0] || args.len() != counts[1] {
            let generic = type_args.len() != counts[0];
            let expected = if generic { counts[0] } else { counts[1] };
            let actual = if generic { type_args.len() } else { args.len() };
            let message = String.from(&"'@");
            defer message.drop();
            message.push_str(kind.spelling());
            message.push_str("' expects exactly ");
            let count = expected.to_string();
            defer count.drop();
            let provided = actual.to_string();
            defer provided.drop();
            message.push_str(count.as_str());
            message.push_str(if generic { " type argument" } else { " argument" });
            if expected != 1 { message.push_str("s"); }
            message.push_str(", got ");
            message.push_str(provided.as_str());
            let code = if !generic && expected != 1 { DiagnosticCode.GenericArguments } else { DiagnosticCode.Type };
            return Result<HirId, AnalysisError>.Err(self.ctx.error(self.unit, span, code, message.as_str()));
        }

        let ffi = kind == BuiltinKind.FfiAddr || kind == BuiltinKind.FfiParts || kind == BuiltinKind.FfiNull || kind == BuiltinKind.FfiPtrCast || kind == BuiltinKind.FfiCopyFrom || kind == BuiltinKind.FfiCopyTo;

        if ffi && !self.ffi_allowed {
            return Result<HirId, AnalysisError>.Err(self.error(span, "FFI builtin requires an ffi fn"));
        }

        let types = Vec<TypeId>.new();
        let values = Vec<HirId>.new();
        let accepted = false;
        defer {
            if !accepted {
                types.drop();
                values.drop();
            }
        };

        for syntax in *type_args {
            let type_id = self.local_type(*syntax)?;

            if kind != BuiltinKind.FfiNull && kind != BuiltinKind.FfiPtrCast {
                validate_value(self.ctx, type_id, self.ctx.span(self.unit, syntax.span))?;
            }

            types.push(type_id);
        }

        for arg in *args {
            if arg.data.name.is_some() {
                return Result<HirId, AnalysisError>.Err(self.error(span, "builtin arguments cannot be named"));
            }

            values.push(self.expression(arg.data.value)?);
        }

        let byte = self.ctx.session.types.primitive(TypeData.Integer(8, false))?;
        let bytes = self.ctx.session.types.slice(byte);
        let pointer = self.ctx.session.types.pointer(byte);
        let c_pointer = self.ctx.session.types.c_pointer(byte);
        let integer = self.ctx.primitives.integer;
        let unsigned = self.ctx.primitives.unsigned;
        let result = match &kind {
            SizeOf => unsigned,
            Undef => types[0],
            Dangling => self.ctx.session.types.pointer(types[0]),
            Alloc => {
                values[0] = self.coerce(values[0], unsigned)?;
                self.ctx.session.types.pointer(types[0])
            },
            Realloc => {
                let expected = self.ctx.session.types.pointer(types[0]);
                values[0] = self.coerce(values[0], expected)?;
                values[1] = self.coerce(values[1], unsigned)?;
                expected
            },
            BitCast => {
                let source_ok = match self.ctx.session.types.require(self.type_of(values[0]))? {
                    Pointer(_) => true, Reference(_) => true, _ => false
                };
                let target_ok = match self.ctx.session.types.require(types[0])? {
                    Pointer(_) => true, _ => false
                };

                if !source_ok || !target_ok {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "bitcast requires a pointer source and pointer target"));
                }

                types[0]
            },
            Panic => {
                values[0] = self.coerce(values[0], self.ctx.primitives.string)?;
                self.ctx.primitives.never
            },
            RuntimeFail => {
                let code = match &args[0].data.value.data {
                    Literal(literal) => match literal {
                        StringLiteral(value) => value.data.value.as_str(), _ => ""
                    },
                    _ => "",
                };

                if code != "S001" && code != "S002" && code != "S003" && code != "S004" && code != "S005" && code != "S006" && code != "S007" && code != "R001" && code != "R002" && code != "R003" {
                    return Result<HirId, AnalysisError>.Err(self.error(span, "runtime_fail requires a known runtime error code literal"));
                }

                self.ctx.primitives.never
            },
            AssumeInit => self.type_of(values[0]),
            MemCopy => {
                let index = 0u64;

                while index < 2 {
                    match self.ctx.session.types.require(self.type_of(values[index]))? {
                        Pointer(_) => {},
                        _ => return Result<HirId, AnalysisError>.Err(self.error(span, "memcpy requires pointers")),
                    }

                    index += 1;
                }

                values[2] = self.coerce(values[2], unsigned)?;
                self.ctx.primitives.void
            },
            SliceFromParts => {
                let element = match self.ctx.session.types.require(self.type_of(values[0]))? {
                    Pointer(value) => *value,
                    _ => return Result<HirId, AnalysisError>.Err(self.error(span, "slice_from_parts requires a pointer")),
                };
                values[1] = self.coerce(values[1], unsigned)?;
                self.ctx.session.types.slice(element)
            },
            SliceGetPtr => match self.ctx.session.types.require(self.type_of(values[0]))? {
                Slice(element) => self.ctx.session.types.pointer(*element),
                _ => return Result<HirId, AnalysisError>.Err(self.error(span, "slice_get_ptr requires a slice")),
            },
            SliceGetLen => {
                match self.ctx.session.types.require(self.type_of(values[0]))? {
                    Slice(_) => {}, _ => return Result<HirId, AnalysisError>.Err(self.error(span, "slice_get_len requires a slice"))
                }

                unsigned
            },
            StrFromParts => {
                values[0] = self.coerce(values[0], pointer)?;
                values[1] = self.coerce(values[1], unsigned)?;
                self.ctx.primitives.string
            },
            StrGetPtr => {
                values[0] = self.coerce(values[0], self.ctx.primitives.string)?;
                pointer
            },
            StrGetLen => {
                values[0] = self.coerce(values[0], self.ctx.primitives.string)?;
                unsigned
            },
            SysRead => {
                values[0] = self.coerce(values[0], integer)?;
                self.ctx.primitives.string
            },
            SysReadBytes => {
                values[0] = self.coerce(values[0], integer)?;
                values[1] = self.coerce(values[1], bytes)?;
                self.ctx.session.types.primitive(TypeData.Integer(64, true))?
            },
            SysWrite => {
                values[0] = self.coerce(values[0], integer)?;
                values[1] = self.coerce(values[1], self.ctx.primitives.string)?;
                self.ctx.primitives.void
            },
            SysWriteBytes => {
                values[0] = self.coerce(values[0], integer)?;
                values[1] = self.coerce(values[1], bytes)?;
                self.ctx.session.types.primitive(TypeData.Integer(64, true))?
            },
            Open => {
                values[0] = self.coerce(values[0], self.ctx.primitives.string)?;
                values[1] = self.coerce(values[1], integer)?;
                integer
            },
            Close => {
                values[0] = self.coerce(values[0], integer)?;
                integer
            },
            Sqrt => {
                values[0] = self.coerce(values[0], self.ctx.primitives.float)?;
                self.ctx.primitives.float
            },
            Sin => {
                values[0] = self.coerce(values[0], self.ctx.primitives.float)?;
                self.ctx.primitives.float
            },
            Cos => {
                values[0] = self.coerce(values[0], self.ctx.primitives.float)?;
                self.ctx.primitives.float
            },
            Argc => unsigned,
            ArgBytes => {
                values[0] = self.coerce(values[0], unsigned)?;
                bytes
            },
            Exit => {
                values[0] = self.coerce(values[0], integer)?;
                self.ctx.primitives.never
            },
            FfiAddr => {
                let element = match self.ctx.session.types.require(self.type_of(values[0]))? {
                    Reference(value) => *value,
                    Pointer(value) => *value,
                    _ => return Result<HirId, AnalysisError>.Err(self.error(span, "ffi_addr requires a reference")),
                };
                self.c_element(span, element, false)?;
                self.ctx.session.types.c_pointer(element)
            },
            FfiParts => {
                let element = match self.ctx.session.types.require(self.type_of(values[0]))? {
                    Slice(value) => *value,
                    Str => byte,
                    _ => return Result<HirId, AnalysisError>.Err(self.error(span, "ffi_parts requires a slice or str")),
                };
                self.c_element(span, element, false)?;
                let fields = Vec<TypeId>.new();
                defer fields.drop();
                fields.push(self.ctx.session.types.c_pointer(element));
                fields.push(unsigned);
                self.ctx.session.types.tuple(&fields)
            },
            FfiNull => {
                self.c_element(span, types[0], true)?;
                self.ctx.session.types.c_pointer(types[0])
            },
            FfiPtrCast => {
                match self.ctx.session.types.require(self.type_of(values[0]))? {
                    CPointer(_) => {}, _ => return Result<HirId, AnalysisError>.Err(self.error(span, "ffi_ptr_cast requires cptr"))
                }

                self.c_element(span, types[0], true)?;
                self.ctx.session.types.c_pointer(types[0])
            },
            FfiCopyFrom => {
                values[0] = self.coerce(values[0], bytes)?;
                values[1] = self.coerce(values[1], c_pointer)?;
                values[2] = self.coerce(values[2], unsigned)?;
                self.ctx.primitives.void
            },
            FfiCopyTo => {
                values[0] = self.coerce(values[0], c_pointer)?;
                values[1] = self.coerce(values[1], bytes)?;
                values[2] = self.coerce(values[2], unsigned)?;
                self.ctx.primitives.void
            },
        };
        accepted = true;
        Result<HirId, AnalysisError>.Ok(self.node(span, result, false, HirKind.Builtin(Builtin(kind, types, values))))
    }
}
