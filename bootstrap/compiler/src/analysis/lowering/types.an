from compiler.analysis.lowering.checker import ExprChecker;
from compiler.analysis.resolution.types import resolve_type, resolve_alias;
from compiler.analysis.ty.validation import contains_ffi;
from compiler.analysis.ty.substitution import has_generic;
from compiler.analysis.symbol.model import SymbolKind;
from compiler.common.ids import TypeId;
from compiler.frontend.ast.node import TypeSyntax;
from compiler.diagnostics.model import AnalysisError;
from std.core.iter import Iterator, IntoIterator;
from std.core.result import Result;

impl ExprChecker {
    // Concrete generic bindings retain the permissions of their declaration.
    // Explicit C syntax and aliases exposing C types require an FFI function.
    pub fn local_type(syntax: TypeSyntax&) -> Result<TypeId, AnalysisError> {
        let type_id = resolve_type(self.ctx, self.unit, self.scope, syntax)?;
        if has_generic(&self.ctx.session.types, type_id) {
            return Result<TypeId, AnalysisError>.Err(self.error(syntax.span, "type requires concrete generic arguments"));
        }

        if !self.ffi_allowed && self.ffi_syntax(syntax)? {
            return Result<TypeId, AnalysisError>.Err(self.error(syntax.span, "C ABI type syntax requires an ffi function"));
        }
        Result<TypeId, AnalysisError>.Ok(type_id)
    }

    fn ffi_syntax(syntax: TypeSyntax&) -> Result<bool, AnalysisError> {
        match &syntax.data {
            CScalarType(_) | CPtrType(_) => Result<bool, AnalysisError>.Ok(true),
            PointerType(inner) | RefType(inner) | SliceType(inner) => self.ffi_syntax(*inner),
            ArrayType(inner, _) => self.ffi_syntax(*inner),
            TupleType(elements) => {
                for element in *elements {
                    if self.ffi_syntax(*element)? { return Result<bool, AnalysisError>.Ok(true); }
                }
                Result<bool, AnalysisError>.Ok(false)
            },
            FunctionType(parameters, result) => {
                for parameter in *parameters {
                    if self.ffi_syntax(*parameter)? { return Result<bool, AnalysisError>.Ok(true); }
                }
                self.ffi_syntax(*result)
            },
            NamedType(name) => {
                let interned = self.ctx.session.names.intern(name.data.name.as_str());
                match self.ctx.session.symbols.lookup(self.scope, interned) {
                    Some(symbol) => {
                        let record = *self.ctx.session.symbols.get(symbol).unwrap();
                        if record.kind == SymbolKind.Alias {
                            let resolved = resolve_alias(self.ctx, symbol)?;
                            return Result<bool, AnalysisError>.Ok(contains_ffi(&self.ctx.session.types, resolved, false));
                        }
                    },
                    None => {},
                }
                Result<bool, AnalysisError>.Ok(false)
            },
            InstanceType(base, arguments) => {
                if self.ffi_syntax(*base)? { return Result<bool, AnalysisError>.Ok(true); }
                for argument in *arguments {
                    match argument {
                        Type(value) => { if self.ffi_syntax(*value)? { return Result<bool, AnalysisError>.Ok(true); } },
                        Constant(_) => {},
                    }
                }
                Result<bool, AnalysisError>.Ok(false)
            },
            _ => Result<bool, AnalysisError>.Ok(false),
        }
    }
}
