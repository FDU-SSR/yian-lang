// Build success is separate from the dependencies of an individual editor query.
from compiler.frontend.source import Span, Position;
from std.core.vec import Vec;
from std.core.option import Option;
from std.core.drop import Drop;
pub enum QueryCompleteness { Complete, Partial }
pub enum UnavailableReason { Syntax, Declaration, Type, ConflictingInstances }
pub enum QueryResult<T> {
    Value { value: T, completeness: QueryCompleteness },
    Unavailable { reason: UnavailableReason },
}

pub struct DocumentState {
    pub lexical_complete: bool,
    pub syntax_complete: bool,
    pub declarations_available: bool,
    pub recovery_regions: Vec<Span>,
    pub lexical_stop: Option<Position>,
}

impl Drop for DocumentState {
    pub fn drop() { self.recovery_regions.drop(); }
}

pub enum BodyState { Complete, Failed, Unreached, Uninstantiated }
pub struct DefinitionState { pub signature_available: bool, pub body: BodyState }
