from std.core.convert import From;
from std.core.drop import Drop;
from compiler.analysis.editor import EditorSnapshot, EditorLocation;
from compiler.diagnostics.model import AnalysisError;
from compiler.common.ids import SourceId;
from std.core.option import Option;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;

from compiler.analysis.editor.query_model import CompletionContext, EditorCompletionItem, EditorCompletionResult;
from compiler.analysis.editor.availability import QueryCompleteness, QueryResult, UnavailableReason;
from compiler.analysis.editor.position import unit_for_source, completion_position;
from compiler.analysis.editor.candidates import lexical_completion_result, append_symbol_candidates, append_primitive_candidates;
from compiler.analysis.editor.members import append_member_completions;
from compiler.analysis.editor.imports import append_import_path_candidates, append_import_name_candidates;

fn release_completion_items(items: Vec<EditorCompletionItem>&) {
    for item in *items { item.drop(); }
    items.drop();
}

// Completion results own all labels, details, parameter names and replacement paths.
fn build_completion(
    snapshot: EditorSnapshot&,
    source: SourceId,
    row: u64,
    column: u64,
) -> Result<EditorCompletionResult, AnalysisError> {
    let unit = match unit_for_source(snapshot, source) {
        Some(value) => value,
        // A source without a usable unit permits lexical candidates only at ordinary name positions.
        None => return Result<EditorCompletionResult, AnalysisError>.Ok(
            lexical_completion_result(snapshot, source, row, column)),
    };
    let position = completion_position(snapshot, source, &unit.prepared.tokens, row, column);
    let items = Vec<EditorCompletionItem>.new();
    let accepted = false;
    defer {
        if !accepted {
            release_completion_items(&items);
            position.drop();
        }
    };

    {
        match position.context {
            Member => { append_member_completions(snapshot, unit, &items, &position)?; },
            ImportPath => { append_import_path_candidates(snapshot, &items, position.prefix.as_str()); },
            ImportName => { append_import_name_candidates(snapshot, unit, &items, position.prefix.as_str(), row, column); },
            Type => {
                append_symbol_candidates(snapshot, &items, source, row, column,
                    position.prefix.as_str(), true)?;
                append_primitive_candidates(&items, position.prefix.as_str());
            },
            Value => {
                append_symbol_candidates(snapshot, &items, source, row, column,
                    position.prefix.as_str(), false)?;
                append_primitive_candidates(&items, position.prefix.as_str());
            },
        }
    }

    let replace = match &position.replace {
        Some(location) => Option<EditorLocation>.Some(EditorLocation(
            path=String.from(&location.path.as_str()), span=location.span)),
        None => Option<EditorLocation>.None,
    };
    let completeness = QueryCompleteness.Partial;
    if position.context == CompletionContext.Member {
        completeness = QueryCompleteness.Complete;
    } elif let Some(state) = snapshot.document_state(source) {
        if state.lexical_complete && state.syntax_complete && state.declarations_available {
            completeness = QueryCompleteness.Complete;
        }
    }
    let result = EditorCompletionResult(items, replace, completeness);
    position.drop();
    accepted = true;
    Result<EditorCompletionResult, AnalysisError>.Ok(result)
}

// Query reliability is local to the receiver or declaration environment.
pub fn query_completion(snapshot: EditorSnapshot&, source: SourceId, row: u64, column: u64)
-> Result<QueryResult<EditorCompletionResult>, AnalysisError> {
    if let Some(state) = snapshot.document_state(source) {
        if let Some(stop) = state.lexical_stop {
            if row > stop.row || (row == stop.row && column >= stop.column) {
                return Result<QueryResult<EditorCompletionResult>, AnalysisError>.Ok(
                    QueryResult<EditorCompletionResult>.Unavailable(UnavailableReason.Syntax));
            }
        }
    }

    match unit_for_source(snapshot, source) {
        Some(unit) => {
            let position = completion_position(snapshot, source, &unit.prepared.tokens, row, column);
            defer position.drop();
            if position.context == CompletionContext.Member {
                match position.receiver_end {
                    Some(end) if snapshot.session().editor_facts.expression_ending_at(source, end.row, end.column).is_some() => {},
                    _ => return Result<QueryResult<EditorCompletionResult>, AnalysisError>.Ok(
                        QueryResult<EditorCompletionResult>.Unavailable(UnavailableReason.Type)),
                }
            }
        },
        None => {},
    }
    let value = build_completion(snapshot, source, row, column)?;
    Result<QueryResult<EditorCompletionResult>, AnalysisError>.Ok(
        QueryResult<EditorCompletionResult>.Value(value, value.completeness))
}

pub fn completion_at(snapshot: EditorSnapshot&, source: SourceId, row: u64, column: u64)
-> Result<EditorCompletionResult, AnalysisError> {
    match query_completion(snapshot, source, row, column)? {
        Value(value, _) => Result<EditorCompletionResult, AnalysisError>.Ok(value),
        Unavailable(_) => Result<EditorCompletionResult, AnalysisError>.Ok(EditorCompletionResult(
            Vec<EditorCompletionItem>.new(), Option<EditorLocation>.None, QueryCompleteness.Partial)),
    }
}
