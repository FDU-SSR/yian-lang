from std.core.convert import From;
from std.core.drop import Drop;
from compiler.analysis.editor import EditorSnapshot, EditorLocation;
from compiler.analysis.ty.model import Parameter, TypeData;
from compiler.analysis.ty.display import stored_type_text;
from compiler.analysis.symbol.model import Symbol, SymbolKind;
from compiler.diagnostics.model import AnalysisError;
from compiler.common.ids import SourceId, SymbolId;
from compiler.frontend.source import Span;
from compiler.frontend.lex.lexer import Lexer;
from compiler.frontend.lex.token import Token;
from compiler.frontend.lex.token import drop_tokens;
from std.core.text import LineIndex, TextPosition;
from std.core.option import Option;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;

from compiler.analysis.editor.query_model import CompletionContext, EditorCompletionKind, EditorCompletionItem, EditorCompletionResult;
from compiler.analysis.editor.availability import QueryCompleteness;
from compiler.analysis.editor.position import completion_position;
from compiler.analysis.editor.signatures import signature_for_type;

pub fn push_completion(items: Vec<EditorCompletionItem>&, item: EditorCompletionItem) {
    for current in *items {
        if current.label.as_str() == item.label.as_str() {
            item.drop();
            return;
        }
    }

    items.push(item);
}

pub fn append_completion(
    items: Vec<EditorCompletionItem>&,
    label: str,
    kind: EditorCompletionKind,
    detail: Option<String>,
    parameter_labels: Vec<String>,
) {
    push_completion(items, EditorCompletionItem(
        label=String.from(&label),
        kind=kind,
        detail=detail,
        parameter_labels=parameter_labels,
        ));
}

fn completion_kind(snapshot: EditorSnapshot&, symbol_id: SymbolId) -> EditorCompletionKind {
    let symbol = match snapshot.session().symbols.get(symbol_id) {
        Some(value) => value,
        None => return EditorCompletionKind.Variable,
    };
    match symbol.kind {
        SymbolKind.Function => EditorCompletionKind.Function,
        SymbolKind.Variable => EditorCompletionKind.Variable,
        SymbolKind.Parameter => EditorCompletionKind.Parameter,
        SymbolKind.Constant => EditorCompletionKind.Constant,
        SymbolKind.Alias => EditorCompletionKind.Alias,
        SymbolKind.Module => EditorCompletionKind.Module,
        SymbolKind.Type => match snapshot.session().types.get(symbol.type_id) {
            Some(Generic(_)) => EditorCompletionKind.TypeParameter,
            Some(ConstGeneric(_, _)) => EditorCompletionKind.Constant,
            Some(Nominal(definition, _)) => match snapshot.session().types.definition(*definition) {
                Some(record) => match record.header().kind {
                    Struct => EditorCompletionKind.Struct,
                    Enum => EditorCompletionKind.Enum,
                    Trait => EditorCompletionKind.Trait,
                    _ => EditorCompletionKind.Struct,
                },
                None => EditorCompletionKind.Struct,
            },
            _ => EditorCompletionKind.Primitive,
        },
    }
}

fn source_text_for_span(snapshot: EditorSnapshot&, source: SourceId, span: Span) -> String {
    let text = match snapshot.source_text(source) {
        Some(value) => value,
        None => return String.new(),
    };
    let index = LineIndex.new(text);
    defer index.drop();
    let start = index.byte_offset(TextPosition(row=span.start.row, column=span.start.column));
    let end = index.byte_offset(TextPosition(row=span.end.row, column=span.end.column));
    let bytes = text.as_slice();
    String.from(&str.from_slice_unchecked(bytes[start..end]))
}

// Alias completion follows the declaration signature rather than exposing only its expanded type.
fn alias_completion_detail(snapshot: EditorSnapshot&, symbol: Symbol&) -> String {
    let fallback = stored_type_text(&snapshot.session().types, &snapshot.session().names, symbol.type_id);
    let unit = match snapshot.session().unit(symbol.unit) {
        Some(value) => value,
        None => return fallback,
    };
    let tree = match &unit.prepared.tree {
        Some(value) => value,
        None => return fallback,
    };
    let alias_name = snapshot.session().names.text(symbol.name);

    for item in tree.root.data.items {
        match &item.data {
            Alias(_, name, generics, _) if name.data.name.as_str() == alias_name => {
                let detail = String.new();
                detail.push_str("typedef ");
                detail.push_str(alias_name);
                if generics.len() != 0u64 {
                    detail.push('<');
                    let index = 0u64;
                    for generic in generics {
                        if index != 0u64 { detail.push_str(", "); }
                        match generic {
                            Type(value) => detail.push_str(value.data.name.data.name.as_str()),
                            Constant(value) => {
                                detail.push_str("const ");
                                detail.push_str(value.data.name.data.name.as_str());
                                detail.push_str(": ");
                                let annotation = source_text_for_span(snapshot, unit.source,
                                    value.data.const_type.span);
                                detail.push_str(annotation.as_str());
                                annotation.drop();
                            },
                        }
                        index += 1u64;
                    }
                    detail.push('>');
                }
                detail.push_str(" = ");
                detail.push_str(fallback.as_str());
                detail.push(';');
                fallback.drop();
                return detail;
            },
            _ => {},
        }
    }

    fallback
}

pub fn symbol_completion(
    snapshot: EditorSnapshot&,
    symbol_id: SymbolId,
    prefix: str,
) -> Option<EditorCompletionItem> {
    let symbol = match snapshot.session().symbols.get(symbol_id) {
        Some(value) => value,
        None => return Option<EditorCompletionItem>.None,
    };
    let name = snapshot.session().names.text(symbol.name);
    if !name.starts_with(prefix) {
        return Option<EditorCompletionItem>.None;
    }

    let kind = completion_kind(snapshot, symbol_id);
    let parameter_labels = Vec<String>.new();
    let reliable_type = match snapshot.session().types.get(symbol.type_id) {
        Some(Nominal(id, _)) => snapshot.session().types.definition(*id).unwrap().is_complete(),
        Some(value) => match *value { TypeData.Error => false, _ => true, },
        None => false,
    };
    if !reliable_type {
        return Option<EditorCompletionItem>.Some(EditorCompletionItem(
            String.from(&name), kind, Option<String>.None, parameter_labels));
    }
    let detail = if kind == EditorCompletionKind.Alias {
        Option<String>.Some(alias_completion_detail(snapshot, symbol))
    } else {
        match signature_for_type(snapshot, symbol.type_id, name, 0u64) {
            Some(signature) => {
                let value = String.from(&signature.label.as_str());
                for parameter in signature.parameter_labels {
                    parameter_labels.push(String.from(&parameter.as_str()));
                }
                signature.drop();
                match kind {
                    Function | Method => Option<String>.Some(value),
                    _ => {
                        value.drop();
                        Option<String>.Some(stored_type_text(&snapshot.session().types,
                            &snapshot.session().names, symbol.type_id))
                    },
                }
            },
            None => match kind {
                Function | Method => Option<String>.None,
                _ => Option<String>.Some(stored_type_text(&snapshot.session().types,
                    &snapshot.session().names, symbol.type_id)),
            },
        }
    };

    Option<EditorCompletionItem>.Some(EditorCompletionItem(
        label=String.from(&name), kind=kind, detail=detail,
        parameter_labels=parameter_labels))
}

pub fn append_symbol_candidates(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    source: SourceId,
    row: u64,
    column: u64,
    prefix: str,
    type_only: bool,
) -> Result<(), AnalysisError> {
    let symbols = snapshot.visible_symbols_with_metadata_at(source, row, column)?;
    defer symbols.drop();

    for visible in symbols {
        let symbol = match snapshot.session().symbols.get(visible.id) {
            Some(value) => value,
            None => continue,
        };
        if type_only && symbol.kind != SymbolKind.Type && symbol.kind != SymbolKind.Alias {
            continue;
        }

        match symbol_completion(snapshot, visible.id, prefix) {
            Some(item) => {
                if visible.is_local {
                    match &item.detail {
                        Some(value) => value.drop(),
                        None => {},
                    }
                    item.detail = Option<String>.None;
                }
                push_completion(items, item);
            },
            None => {},
        }
    }

    Result<(), AnalysisError>.Ok(())
}

pub fn append_primitive_candidates(items: Vec<EditorCompletionItem>&, prefix: str) {
    for name in ["void", "bool", "char", "str", "i8", "i16", "i32", "i64",
        "u8", "u16", "u32", "u64", "f16", "f32", "f64", "int", "uint", "float"] {
        if (*name).starts_with(prefix) {
            let detail = String.new();
            detail.push_str("type");
            append_completion(items, *name, EditorCompletionKind.Primitive,
                Option<String>.Some(detail), Vec<String>.new());
        }
    }
}

fn lexical_completions(
    items: Vec<EditorCompletionItem>&,
    tokens: Vec<Token>&,
    prefix: str,
    editing: Option<Span>,
) {
    for token in *tokens {
        match editing {
            Some(span) if token.span.start.row == span.start.row && token.span.start.column == span.start.column => { continue; },
            _ => {},
        }
        match token.kind() {
            Identifier(name) if name.as_str().starts_with(prefix) =>
            append_completion(items, name.as_str(), EditorCompletionKind.Text,
                Option<String>.None, Vec<String>.new()),
            _ => {},
        }
    }
}

pub fn lexical_completion_result(
    snapshot: EditorSnapshot&,
    source: SourceId,
    row: u64,
    column: u64,
) -> EditorCompletionResult {
    let text = match snapshot.source_text(source) {
        Some(value) => value,
        None => return EditorCompletionResult(
            Vec<EditorCompletionItem>.new(), Option<EditorLocation>.None, QueryCompleteness.Partial),
    };
    let tokens = match Lexer.new(text).run() {
        Ok(value) => value,
        Err(error) => {
            error.drop();
            return EditorCompletionResult(
                Vec<EditorCompletionItem>.new(), Option<EditorLocation>.None, QueryCompleteness.Partial);
        },
    };
    defer drop_tokens(&tokens);

    let position = completion_position(snapshot, source, &tokens, row, column);
    defer position.drop();
    let items = Vec<EditorCompletionItem>.new();
    let editing = match &position.replace { Some(location) => Option<Span>.Some(location.span), None => Option<Span>.None };
    if position.context == CompletionContext.Value { lexical_completions(&items, &tokens, position.prefix.as_str(), editing); }

    let replace = match &position.replace {
        Some(location) => Option<EditorLocation>.Some(EditorLocation(
            path=String.from(&location.path.as_str()), span=location.span)),
        None => Option<EditorLocation>.None,
    };
    EditorCompletionResult(items, replace, QueryCompleteness.Partial)
}
