from compiler.common.ids import TypeId, UnitId, DefId;
from compiler.diagnostics.model import AnalysisError;
from compiler.frontend.ast.node import Block;
from std.collections.arena import Arena;
from std.collections.hash_map import HashMap;
from std.core.drop import Drop;
from std.core.option import Option;
from std.core.result import Result;

pub enum DefinitionKind {
    Function,
    Method,
    Closure,
}

pub struct Procedure {
    pub definition: DefId,
    pub type_id: TypeId,
    pub unit: UnitId,
    pub body: Block&,
    pub kind: DefinitionKind
}

// Procedures borrow AST bodies owned by their compilation units.
pub struct DefinitionRegistry {
    records: Arena<Procedure>,
    index: HashMap<TypeId, u64>,
}

impl DefinitionRegistry {
    pub fn len() -> u64 {
        self.records.len()
    }

    pub fn at(index: u64) -> Option<Procedure&> {
        self.records.get(index)
    }

    static pub fn new() -> Self {
        Self(Arena<Procedure>.new(), HashMap<TypeId, u64>.new())
    }

    pub fn register(procedure: Procedure) -> Result<(), AnalysisError> {
        if self.index.contains(&procedure.type_id) {
            return Result<(), AnalysisError>.Err(AnalysisError.internal("duplicate procedure registration"));
        }

        let index = self.records.len();
        self.records.alloc(procedure);
        self.index.insert(procedure.type_id, index);
        Result<(), AnalysisError>.Ok(())
    }

    pub fn get(type_id: TypeId) -> Option<Procedure&> {
        match self.index.get(&type_id) {
            Some(index) => self.records.get(*index),
            None => Option<Procedure&>.None,
        }
    }
}

impl Drop for DefinitionRegistry {
    pub fn drop() {
        self.index.drop();
        self.records.drop();
    }
}
