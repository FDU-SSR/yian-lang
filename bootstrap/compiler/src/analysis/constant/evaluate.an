from compiler.common.ids import TypeId, HirId;
from compiler.common.location import SourceSpan;
from compiler.analysis.constant.floating import round_float, float_binary, integer_float, float_integer, is_nan;
from compiler.analysis.constant.integer import normalized, cast_integer, integer_unary, integer_binary, compare;
from compiler.analysis.constant.value import ConstValue, IntegerValue, IntegerWidth, ConstEvalError;
from compiler.analysis.constant.big_integer import BigInteger;
from compiler.analysis.hir.node import HirNode, Builtin, Binary;
from compiler.analysis.hir.store import HirStore;
from compiler.analysis.ty.store import TypeStore;
from compiler.diagnostics.model import DiagnosticCode, AnalysisError, AnalysisErrorKind;
from compiler.frontend.ast.atoms import BuiltinKind;
from compiler.frontend.ast.operator import BinaryOperator, UnaryOperator;
from std.core.ops import Index;
from std.core.clone import Clone;
from std.core.drop import Drop;
from std.core.option import Option;
from std.core.result import Result;

pub trait TypeSizeProvider {
    fn size_of(type_id: TypeId) -> Result<u64, AnalysisError>;
}

pub struct TypedConstant {
    pub value: ConstValue,
    pub type_id: TypeId
}

impl Drop for TypedConstant {
    pub fn drop() { self.value.drop(); }
}

// The evaluator borrows immutable stores and an optional target-specific service.
pub struct ConstantEvaluator {
    types: TypeStore&,
    hir: HirStore&,
    sizes: Option<TypeSizeProvider&>
}

impl ConstantEvaluator {
    static pub fn new(types: TypeStore&, hir: HirStore&, sizes: Option<TypeSizeProvider&>) -> Self {
        Self(types, hir, sizes)
    }

    // Dispatch determines evaluation order; arithmetic helpers never walk HIR.
    pub fn evaluate(id: HirId) -> Result<TypedConstant, AnalysisError> {
        let node = self.hir.require(id)?;
        let location = node.span;
        let type_id = node.type_id;
        let value = match &node.kind {
            Builtin(builtin) => self.sizeof_value(builtin, type_id, location)?,
            Cast(cast) => self.convert(self.evaluate(cast.value)?.value, cast.target_type, location)?,
            Block(block) => {
                if block.stmts.len() != 1 {
                    return Result<TypedConstant, AnalysisError>.Err(failed(ConstEvalError.NotConstant, location));
                }

                return self.evaluate(block.stmts[0]);
            },
            Unary(unary) => {
                let operand = self.evaluate(unary.operand)?.value;
                self.unary(unary.op, operand, type_id, location)?
            },
            Binary(binary) => self.evaluate_binary(binary, type_id, location)?,
            _ => return self.literal(node),
        };

        Result<TypedConstant, AnalysisError>.Ok(TypedConstant(value, type_id))
    }

    fn literal(node: HirNode&) -> Result<TypedConstant, AnalysisError> {
        let location = node.span;
        let type_id = node.type_id;
        let value = match &node.kind {
            BoolLiteral(value) => ConstValue.Bool(*value),
            IntLiteral(value) => self.convert(ConstValue.Integer(*value), type_id, location)?,
            FloatLiteral(value) => ConstValue.Float(round_float(*value, self.float_width(type_id)?)),
            CharLiteral(value) => ConstValue.Char(*value),
            StrLiteral(value) => ConstValue.String(*value),
            Ty => return self.type_literal(type_id, location),
            _ => return Result<TypedConstant, AnalysisError>.Err(failed(ConstEvalError.NotConstant, location)),
        };

        Result<TypedConstant, AnalysisError>.Ok(TypedConstant(value, type_id))
    }

    fn type_literal(type_id: TypeId, location: SourceSpan) -> Result<TypedConstant, AnalysisError> {
        match self.types.require(type_id)? {
            LiteralValue(bits, negative, value_type) => {
                let literal_type = self.types.require(*value_type)?;
                let result = match literal_type {
                    Bool => ConstValue.Bool(*bits != 0),
                    _ => self.convert(ConstValue.Integer(IntegerValue.untyped(*bits, *negative)), *value_type, location)?,
                };

                Result<TypedConstant, AnalysisError>.Ok(TypedConstant(result, *value_type))
            },
            _ => Result<TypedConstant, AnalysisError>.Err(failed(ConstEvalError.NotConstant, location)),
        }
    }

    // The provider is required only when execution reaches a sizeof node.
    fn sizeof_value(builtin: Builtin&, type_id: TypeId, location: SourceSpan) -> Result<ConstValue, AnalysisError> {
        if builtin.kind != BuiltinKind.SizeOf || builtin.type_args.len() != 1 {
            return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.NotConstant, location));
        }

        let size = match self.sizes {
            Some(provider) => provider.size_of(builtin.type_args[0])?,
            None => return Result<ConstValue, AnalysisError>.Err(AnalysisError.unsupported(
                Option<SourceSpan>.Some(location), "compile-time sizeof requires a target size provider")),
        };

        self.convert(ConstValue.Integer(IntegerValue.untyped(size, false)), type_id, location)
    }

    // Arithmetic entry points consume numeric payloads on both success and failure.
    pub fn unary(op: UnaryOperator, operand: ConstValue, type_id: TypeId, location: SourceSpan) -> Result<ConstValue, AnalysisError> {
        defer operand.drop();
        let value = match &operand {
            LargeInteger(integer) => {
                let result = match op {
                    Neg => integer.negated(),
                    BitNot => integer.inverted(),
                    _ => return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location)),
                };
                return self.convert(ConstValue.LargeInteger(result), type_id, location);
            },
            Integer(integer) => {
                let result = match integer_unary(op, *integer) {
                    Ok(value) => value,
                    Err(error) => return Result<ConstValue, AnalysisError>.Err(failed(error, location)),
                };

                ConstValue.Integer(result)
            },
            Bool(boolean) => {
                if op != UnaryOperator.LogicalNot && op != UnaryOperator.BitNot {
                    return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location));
                }

                ConstValue.Bool(!*boolean)
            },
            Float(number) => {
                if op != UnaryOperator.Neg {
                    return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location));
                }

                ConstValue.Float(round_float(-*number, self.float_width(type_id)?))
            },
            _ => return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location)),
        };

        Result<ConstValue, AnalysisError>.Ok(value)
    }

    fn evaluate_binary(binary: Binary&, type_id: TypeId, location: SourceSpan) -> Result<ConstValue, AnalysisError> {
        let left = self.evaluate(binary.left)?.value;
        let transferred = false;
        defer { if !transferred { left.drop(); } };

        if binary.op == BinaryOperator.LogicalAnd || binary.op == BinaryOperator.LogicalOr {
            transferred = true;
            return self.logical(binary.op, left, binary.right, location);
        }

        let right = self.evaluate(binary.right)?.value;
        let right_transferred = false;
        defer { if !right_transferred { right.drop(); } };
        if binary.op == BinaryOperator.Eq || binary.op == BinaryOperator.Neq {
            match self.types.require(self.hir.require(binary.left)?.type_id)? {
                FloatLiteral => {
                    let problem = failed(ConstEvalError.NotConstant, location);
                    return Result<ConstValue, AnalysisError>.Err(problem.with_message("comparison operands are not compile-time values"));
                },
                _ => {},
            }
        }
        transferred = true;
        right_transferred = true;
        self.binary(binary.op, left, right, type_id, location)
    }

    // Do not evaluate the right operand until the left operand requires it.
    fn logical(op: BinaryOperator, left: ConstValue, right: HirId, location: SourceSpan) -> Result<ConstValue, AnalysisError> {
        defer left.drop();
        let boolean = match &left {
            Bool(value) => *value,
            _ => return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location)),
        };

        if (op == BinaryOperator.LogicalAnd && !boolean) || (op == BinaryOperator.LogicalOr && boolean) {
            return Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(boolean));
        }

        let value = self.evaluate(right)?.value;

        match &value {
            Bool(_) => Result<ConstValue, AnalysisError>.Ok(value),
            _ => { value.drop(); Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location)) },
        }
    }

    fn float_width(type_id: TypeId) -> Result<u32, AnalysisError> {
        let ty = self.types.require(type_id)?;

        match ty {
            Float(bits) => Result<u32, AnalysisError>.Ok(*bits),
            FloatLiteral => Result<u32, AnalysisError>.Ok(64),
            _ => Result<u32, AnalysisError>.Err(AnalysisError.internal("expected float type"))
        }
    }

    // Conversion transfers ownership; the result never aliases an input's arbitrary-precision digits.
    pub fn convert(value: ConstValue, target: TypeId, location: SourceSpan) -> Result<ConstValue, AnalysisError> {
        defer value.drop();
        let ty = self.types.require(target)?;

        match ty {
            Integer(bits, signed) | CScalar(bits, signed, _) => {
                let width = match IntegerWidth.from_bits(*bits) {
                    Ok(value) => value,
                    Err(error) => return Result<ConstValue, AnalysisError>.Err(failed(error, location))
                };

                let integer: IntegerValue;

                match &value {
                    Integer(v) => integer = cast_integer(*v, width, *signed),
                    LargeInteger(v) => integer = normalized(v.low_bits(), width, *signed),
                    Char(v) => integer = normalized(u64(*v), width, *signed),
                    Bool(_) => return Result<ConstValue, AnalysisError>.Err(not_constant(location, "cannot convert bool to an integer")),
                    Float(v) => integer = match float_integer(*v, width, *signed) {
                        Ok(value) => value,
                        Err(_) => return Result<ConstValue, AnalysisError>.Err(not_constant(location, "non-finite float cannot be cast to an integer"))
                    },
                    _ => return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidCast, location)),
                }

                Result<ConstValue, AnalysisError>.Ok(ConstValue.Integer(integer))
            },
            IntLiteral => match &value {
                Integer(v) => Result<ConstValue, AnalysisError>.Ok(ConstValue.LargeInteger(BigInteger.from_small(*v))),
                LargeInteger(v) => Result<ConstValue, AnalysisError>.Ok(ConstValue.LargeInteger(v.clone())),
                _ => Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidCast, location))
            },
            Float(_) | FloatLiteral => {
                let number = match &value {
                    Float(v) => *v,
                    Integer(v) => integer_float(*v),
                    LargeInteger(v) => v.to_float(),
                    _ => return Result<ConstValue, AnalysisError>.Err(not_constant(location, "float cast requires a numeric value"))
                };

                Result<ConstValue, AnalysisError>.Ok(ConstValue.Float(round_float(number, self.float_width(target)?)))
            },
            Bool => match &value {
                Bool(v) => Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(*v)),
                _ => Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidCast, location))
            },
            Char => {
                let code = match &value {
                    Integer(v) => u32(cast_integer(*v, IntegerWidth.W32, false).raw_bits()),
                    LargeInteger(v) => u32(v.low_bits()),
                    Char(v) => *v,
                    Bool(v) => if *v { 1u32 } else { 0u32 },
                    _ => return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidCast, location))
                };

                if code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
                    return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidCast, location));
                }

                Result<ConstValue, AnalysisError>.Ok(ConstValue.Char(code))
            },
            _ => Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidCast, location)),
        }
    }

    pub fn binary(op: BinaryOperator, left: ConstValue, right: ConstValue, type_id: TypeId, location: SourceSpan) -> Result<ConstValue, AnalysisError> {
        defer left.drop();
        defer right.drop();
        let ordered = op == BinaryOperator.Eq || op == BinaryOperator.Neq || op == BinaryOperator.Lt || op == BinaryOperator.Gt || op == BinaryOperator.Leq || op == BinaryOperator.Geq;
        if is_integer_value(&left) && is_integer_value(&right) && (is_large(&left) || is_large(&right)) {
            let a = large_copy(&left);
            defer a.drop();
            let b = large_copy(&right);
            defer b.drop();
            if ordered { return Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(compare_result(op, a.compare(&b)))); }
            let result = match a.binary(op, &b) {
                Ok(value) => value,
                Err(error) => return Result<ConstValue, AnalysisError>.Err(failed(error, location)),
            };
            return self.convert(ConstValue.LargeInteger(result), type_id, location);
        }
        let operands = (left, right);

        match &operands {
            (Integer(a),
                Integer(b)) => {
                if ordered {
                    return Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(compare_result(op, compare(*a, *b))));
                }

                let value = match integer_binary(op, *a, *b) {
                    Ok(value) => value,
                    Err(error) => return Result<ConstValue, AnalysisError>.Err(failed(error, location))
                };

                self.convert(ConstValue.Integer(value), type_id, location)
            },
            (Float(a),
                Float(b)) => {
                if ordered {
                    let result = match op {
                        Eq => *a == *b,
                        Neq => is_nan(*a) || is_nan(*b) || *a != *b,
                        Lt => *a < *b,
                        Gt => *a > *b,
                        Leq => *a <= *b,
                        Geq => *a >= *b,
                        _ => false
                    };

                    return Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(result));
                }

                match float_binary(op, *a, *b, self.float_width(type_id)?) {
                    Ok(value) => Result<ConstValue, AnalysisError>.Ok(ConstValue.Float(value)),
                    Err(error) => Result<ConstValue, AnalysisError>.Err(failed(error, location))
                }
            },
            (Bool(a),
                Bool(b)) => {
                let result = match op {
                    Eq => *a == *b,
                    Neq => *a != *b,
                    BitAnd => *a && *b,
                    BitOr => *a || *b,
                    BitXor => *a != *b,
                    _ => return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location))
                };

                Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(result))
            },
            (Char(a),
                Char(b)) => {
                if op != BinaryOperator.Eq && op != BinaryOperator.Neq {
                    return Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location));
                }

                Result<ConstValue, AnalysisError>.Ok(ConstValue.Bool(if op == BinaryOperator.Eq {
                        *a == *b
                    } else {
                        *a != *b
                    }))
            },
            _ => Result<ConstValue, AnalysisError>.Err(failed(ConstEvalError.InvalidOperator, location)),
        }
    }
}

fn is_integer_value(value: ConstValue&) -> bool {
    match value { Integer(_) | LargeInteger(_) => true, _ => false, }
}

fn is_large(value: ConstValue&) -> bool {
    match value { LargeInteger(_) => true, _ => false, }
}

fn large_copy(value: ConstValue&) -> BigInteger {
    match value {
        LargeInteger(integer) => integer.clone(),
        Integer(integer) => BigInteger.from_small(*integer),
        _ => @panic("constant operand is not an integer"),
    }
}

fn compare_result(op: BinaryOperator, relation: i32) -> bool {
    match op {
        Eq => relation == 0,
        Neq => relation != 0,
        Lt => relation < 0,
        Gt => relation > 0,
        Leq => relation <= 0,
        Geq => relation >= 0,
        _ => false
    }
}

fn failed(error: ConstEvalError, location: SourceSpan) -> AnalysisError {
    let problem = AnalysisError.user(DiagnosticCode.Constant, Option<SourceSpan>.Some(location), error.message());
    if error == ConstEvalError.NotConstant { problem.kind = AnalysisErrorKind.NotConstant; }
    problem
}

fn not_constant(location: SourceSpan, message: str) -> AnalysisError {
    failed(ConstEvalError.NotConstant, location).with_message(message)
}
