from compiler.analysis.resolution.context import ResolutionContext;
from compiler.analysis.ty.substitution import substitute;
from compiler.common.ids import ImplId, TypeId;
from compiler.common.location import SourceSpan;
from compiler.diagnostics.model import AnalysisError, DiagnosticCode;
from std.collections.hash_map import HashMap;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

// Trait signatures are checked against each impl before any body is scheduled.
pub fn check_impls(ctx: ResolutionContext&) -> Result<(), AnalysisError> {
    let index = 0u64;

    while index < ctx.session.impls.len() {
        let record = *ctx.session.impls.get(ImplId(index)).unwrap();

        match &record.trait_id {
            Some(trait_id) => {
                let trait_definition = match ctx.session.types.require(*trait_id)? {
                    Nominal(definition, _) => *definition,
                    _ => return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "impl target is not a trait")),
                };
                let trait_body = match ctx.session.types.complete_definition(trait_definition)? {
                    Trait(value) => value,
                    _ => return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "impl requires a trait definition")),
                };

                for entry in trait_body.entries() {
                    let required = *entry[1];
                    let required_id = match ctx.session.types.require(required)? {
                        Nominal(definition, _) => *definition,
                        _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("trait method has invalid identity")),
                    };
                    let required_header = *ctx.session.types.definition(required_id).unwrap();
                    let required_body = match ctx.session.types.complete_definition(required_id)? {
                        Method(value) => value,
                        _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("trait member is not a method")),
                    };
                    let substitutions = HashMap<TypeId, TypeId>.new();
                    defer substitutions.drop();
                    let trait_header = *ctx.session.types.definition(trait_definition).unwrap();

                    match ctx.session.types.require(*trait_id)? {
                        Nominal(_, arguments) => {
                            let generic = 0u64;

                            while generic < arguments.len() {
                                substitutions.insert(*trait_header.generic(generic).unwrap(), arguments[generic]);
                                generic += 1;
                            }
                        },
                        _ => {},
                    }

                    let self_generic = *required_header.generic(trait_header.generic_count()).unwrap();
                    substitutions.insert(self_generic, record.target);
                    let actual = match record.methods.get(entry[0]) {
                        Some(value) => *value,
                        None => {
                            if required_body.is_header {
                                return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "impl is missing a required trait method"));
                            }

                            let default_method = substitute(&ctx.session.types, required, &substitutions)?;
                            record.methods.insert(*entry[0], default_method);
                            continue;
                        },
                    };
                    let actual_id = match ctx.session.types.require(actual)? {
                        Nominal(definition, _) => *definition,
                        _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("impl method has invalid identity")),
                    };
                    let actual_header = *ctx.session.types.definition(actual_id).unwrap();
                    let required_own = required_header.generic_count() - trait_header.generic_count() - 1;
                    let actual_own = actual_header.generic_count() - record.generics.len();

                    if required_own != actual_own {
                        return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(record.span), "trait method generic count mismatch"));
                    }

                    let generic = 0u64;

                    while generic < required_own {
                        substitutions.insert(*required_header.generic(trait_header.generic_count() + 1 + generic).unwrap(),
                            *actual_header.generic(record.generics.len() + generic).unwrap());
                        generic += 1;
                    }

                    let actual_body = match ctx.session.types.complete_definition(actual_id)? {
                        Method(value) => value,
                        _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("impl member is not a method")),
                    };

                    if actual_body.parameters.len() != required_body.parameters.len() || actual_body.is_static != required_body.is_static {
                        return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "trait method signature mismatch"));
                    }

                    let parameter = 0u64;

                    while parameter < actual_body.parameters.len() {
                        let expected = substitute(&ctx.session.types, required_body.parameters[parameter].type_id, &substitutions)?;

                        if expected != actual_body.parameters[parameter].type_id {
                            return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "trait method parameter type mismatch"));
                        }

                        parameter += 1;
                    }

                    if substitute(&ctx.session.types, required_body.result, &substitutions)? != actual_body.result {
                        return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "trait method return type mismatch"));
                    }
                }

                for entry in record.methods.entries() {
                    if !trait_body.contains(entry[0]) {
                        return Result<(), AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(record.span), "impl declares a method absent from its trait"));
                    }
                }
            },
            None => {},
        }

        index += 1;
    }

    Result<(), AnalysisError>.Ok(())
}
