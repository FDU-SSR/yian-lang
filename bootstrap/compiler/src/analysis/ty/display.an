from compiler.analysis.resolution.context import ResolutionContext;
from compiler.common.ids import TypeId;
from std.core.string import String;
from std.core.iter import Iterator, IntoIterator;
from std.core.drop import Drop;

fn append(ctx: ResolutionContext&, id: TypeId, text: String&, depth: u64) {
    if depth > 64 {
        text.push_str("...");
        return;
    }

    match *ctx.session.types.get(id).unwrap() {
        Reference(inner) => {
            append(ctx, *inner, text, depth + 1);
            text.push_str("&");
        },
        Pointer(inner) => {
            append(ctx, *inner, text, depth + 1);
            text.push_str("*");
        },
        CPointer(inner) => {
            text.push_str("cptr<");
            append(ctx, *inner, text, depth + 1);
            text.push_str(">");
        },
        Slice(inner) => {
            append(ctx, *inner, text, depth + 1);
            text.push_str("[]");
        },
        Array(inner, length) => {
            append(ctx, *inner, text, depth + 1);
            text.push_str("[");
            append(ctx, *length, text, depth + 1);
            text.push_str("]");
        },
        Nominal(definition, arguments) => {
            text.push_str(ctx.session.names.text(ctx.session.types.definition(*definition).unwrap().header().name));

            if arguments.len() != 0 {
                text.push_str("<");
                let index = 0u64;

                for argument in *arguments {
                    if index != 0 {
                        text.push_str(", ");
                    }

                    append(ctx, *argument, text, depth + 1);
                    index += 1;
                }

                text.push_str(">");
            }
        },
        Generic(name) => text.push_str(ctx.session.names.text(*name)),
        ConstGeneric(name, _) => text.push_str(ctx.session.names.text(*name)),
        LiteralValue(bits, negative, _) => {
            if *negative {
                text.push_str("-");
            }

            let number = bits.to_string_radix(10);
            defer number.drop();
            text.push_str(number.as_str());
        },
        Integer(bits, signed) => {
            text.push_str(if *signed {
                    "i"
                } else {
                    "u"
                });
            let number = u64(*bits).to_string_radix(10);
            defer number.drop();
            text.push_str(number.as_str());
        },
        Float(bits) => {
            text.push_str("f");
            let number = u64(*bits).to_string_radix(10);
            defer number.drop();
            text.push_str(number.as_str());
        },
        Bool => text.push_str("bool"), Char => text.push_str("char"), Str => text.push_str("str"), Void => text.push_str("void"), Never => text.push_str("!"), IntLiteral => text.push_str("integer literal"), FloatLiteral => text.push_str("float literal"),
        TraitObject(inner) => {
            append(ctx, *inner, text, depth + 1);
            text.push_str("&");
        },
        SelfType(_) => text.push_str("Self"),
        _ => text.push_str("composite type"),
    }
}

// The caller owns the resulting message buffer; it borrows no type-store text.
pub fn type_text(ctx: ResolutionContext&, id: TypeId) -> String {
    let text = String.new();
    append(ctx, id, &text, 0);
    text
}
