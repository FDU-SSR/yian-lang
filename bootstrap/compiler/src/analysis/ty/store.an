from compiler.common.ids import TypeId, DefId, NameId;
from compiler.common.location import SourceSpan;
from compiler.analysis.ty.key import TypeKey;
from compiler.analysis.ty.model import TypeData, TypeDefinition, DefinitionHeader, DefinitionBody, CapturedVar, Parameter;
from compiler.diagnostics.model import DiagnosticCode, AnalysisError;
from compiler.frontend.ast.operator import UnaryOperator, BinaryOperator;
from compiler.analysis.constant.value import IntegerValue;
from compiler.analysis.constant.integer import integer_fits;
from std.collections.arena import Arena;
from std.collections.hash_map import HashMap;
from std.core.clone import Clone;
from std.core.drop import Drop;
from std.core.hash import Hash;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index, PartialEq;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

pub struct TypeStore {
    values: Arena<TypeData>,
    definitions: Arena<TypeDefinition>,
    index: HashMap<TypeKey, TypeId>
}

impl TypeStore {
    static pub fn new() -> Self {
        Self(Arena<TypeData>.new(), Arena<TypeDefinition>.new(), HashMap<TypeKey, TypeId>.new())
    }

    pub fn len() -> u64 {
        self.values.len()
    }

    // References survive allocation. Treat interned records as immutable, including their buffers.
    pub fn get(id: TypeId) -> Option<TypeData&> {
        self.values.get(id.index)
    }

    pub fn require(id: TypeId) -> Result<TypeData&, AnalysisError> {
        match self.get(id) {
            Some(value) => Result<TypeData&, AnalysisError>.Ok(value),
            None => Result<TypeData&, AnalysisError>.Err(AnalysisError.internal("invalid type ID"))
        }
    }

    fn add(data: TypeData) -> TypeId {
        let id = TypeId(self.values.len());
        self.values.alloc(data);
        id
    }

    // The primitive input is consumed on both success and failure.
    pub fn primitive(data: TypeData) -> Result<TypeId, AnalysisError> {
        let key = match &data {
            Void => TypeKey.Void,
            Never => TypeKey.Never,
            Error => TypeKey.Error,
            Bool => TypeKey.Bool,
            Char => TypeKey.Char,
            Str => TypeKey.Str,
            IntLiteral => TypeKey.IntLiteral,
            FloatLiteral => TypeKey.FloatLiteral,
            Integer(bits, signed) => {
                if *bits != 8 && *bits != 16 && *bits != 32 && *bits != 64 {
                    data.drop();
                    return Result<TypeId, AnalysisError>.Err(AnalysisError.internal("unsupported scalar width"));
                }

                TypeKey.Integer(*bits, *signed)
            },
            CScalar(bits, signed, name) => {
                if *bits != 8 && *bits != 16 && *bits != 32 && *bits != 64 {
                    data.drop();
                    return Result<TypeId, AnalysisError>.Err(AnalysisError.internal("unsupported scalar width"));
                }

                TypeKey.CScalar(*bits, *signed, *name)
            },
            Float(bits) => {
                if *bits != 16 && *bits != 32 && *bits != 64 {
                    data.drop();
                    return Result<TypeId, AnalysisError>.Err(AnalysisError.internal("unsupported scalar width"));
                }

                TypeKey.Float(*bits)
            },
            _ => {
                data.drop();
                return Result<TypeId, AnalysisError>.Err(AnalysisError.internal("expected primitive type"));
            },
        };

        Result<TypeId, AnalysisError>.Ok(self.intern(key, data))
    }

    fn intern(key: TypeKey, data: TypeData) -> TypeId {
        match self.index.get(&key) {
            Some(id) => {
                let result = *id;
                key.drop();
                data.drop();
                return result;
            },
            None => {},
        }

        let id = self.add(data);
        self.index.insert(key, id);
        id
    }

    pub fn pointer(pointee: TypeId) -> TypeId {
        self.intern(TypeKey.Pointer(pointee), TypeData.Pointer(pointee))
    }

    pub fn c_pointer(pointee: TypeId) -> TypeId {
        self.intern(TypeKey.CPointer(pointee), TypeData.CPointer(pointee))
    }

    pub fn reference(pointee: TypeId) -> TypeId {
        self.intern(TypeKey.Reference(pointee), TypeData.Reference(pointee))
    }

    pub fn trait_object(trait_id: TypeId) -> TypeId {
        self.intern(TypeKey.TraitObject(trait_id), TypeData.TraitObject(trait_id))
    }

    pub fn slice(element: TypeId) -> TypeId {
        self.intern(TypeKey.Slice(element), TypeData.Slice(element))
    }

    pub fn self_type(trait_id: TypeId) -> TypeId {
        self.intern(TypeKey.SelfType(trait_id), TypeData.SelfType(trait_id))
    }

    pub fn array(element: TypeId, length: TypeId) -> TypeId {
        // Array counts have one identity regardless of a const parameter's declared width.

        match self.require(length).unwrap() {
            LiteralValue(bits, negative, _) => {
                let unsigned = *self.primitive(TypeData.Integer(64, false)).unwrap();
                length = self.literal(*bits, *negative, unsigned);
            },
            _ => {},
        }

        self.intern(TypeKey.Array(element, length), TypeData.Array(element, length))
    }

    pub fn tuple(elements: Vec<TypeId>&) -> TypeId {
        self.intern(TypeKey.Tuple(elements.clone()), TypeData.Tuple(elements.clone()))
    }

    pub fn function_pointer(parameters: Vec<TypeId>&, result: TypeId) -> TypeId {
        self.intern(TypeKey.FunctionPointer(parameters.clone(), result), TypeData.FunctionPointer(parameters.clone(), result))
    }

    pub fn instance(id: DefId, arguments: Vec<TypeId>&) -> Result<TypeId, AnalysisError> {
        let definition = match self.definition(id) {
            Some(value) => value,
            None => return Result<TypeId, AnalysisError>.Err(AnalysisError.internal("invalid definition ID")),
        };

        if arguments.len() != definition.generic_count() {
            return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "generic argument count mismatch"));
        }

        let normalized = arguments.clone();
        defer normalized.drop();
        let index = 0u64;

        while index < normalized.len() {
            let generic = *definition.generic(index).unwrap();
            let argument = normalized[index];

            if generic != argument {
                match self.require(generic)? {
                    ConstGeneric(_, value_type) => {
                        match self.require(argument)? {
                            LiteralValue(bits, negative, provided_type) => {
                                match self.require(*value_type)? {
                                    Integer(width, signed) => {
                                        if !integer_fits(IntegerValue.untyped(*bits, *negative), *width, *signed) {
                                            return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "constant argument is out of range"));
                                        }

                                        normalized[index] = self.literal(*bits, *negative, *value_type);
                                    },
                                    Error => {},
                                    Bool => {
                                        let boolean = match self.require(*provided_type)? {
                                            Bool => true, _ => false
                                        };

                                        if *bits > 1 || *negative || !boolean {
                                            return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "boolean argument requires a boolean constant"));
                                        }

                                        normalized[index] = self.literal(*bits, false, *value_type);
                                    },
                                    _ => return Result<TypeId, AnalysisError>.Err(AnalysisError.internal("constant parameter is not integer typed")),
                                }
                            },
                            ConstGeneric(_, _) => {},
                            ConstUnary(_, _) => {},
                            ConstBinary(_, _, _) => {},
                            _ => return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "constant parameter requires a constant argument")),
                        }
                    },
                    _ => {
                        match self.require(argument)? {
                            LiteralValue(_, _, _) => return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "type parameter requires a type argument")),
                            ConstGeneric(_, _) => return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "type parameter requires a type argument")),
                            ConstUnary(_, _) => return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "type parameter requires a type argument")),
                            ConstBinary(_, _, _) => return Result<TypeId, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.GenericArguments, Option<SourceSpan>.Some(definition.header().span), "type parameter requires a type argument")),
                            _ => {},
                        }
                    },
                }
            }

            index += 1;
        }

        Result<TypeId, AnalysisError>.Ok(self.intern(TypeKey.Nominal(id, normalized.clone()), TypeData.Nominal(id, normalized.clone())))
    }

    pub fn literal(bits: u64, negative: bool, value_type: TypeId) -> TypeId {
        self.intern(TypeKey.LiteralValue(bits, negative, value_type), TypeData.LiteralValue(bits, negative, value_type))
    }

    pub fn const_unary(op: UnaryOperator, operand: TypeId) -> TypeId {
        self.intern(TypeKey.ConstUnary(op, operand), TypeData.ConstUnary(op, operand))
    }

    pub fn const_binary(op: BinaryOperator, left: TypeId, right: TypeId) -> TypeId {
        self.intern(TypeKey.ConstBinary(op, left, right), TypeData.ConstBinary(op, left, right))
    }

    // Each declaration has a distinct identity, even when its spelling is shared.
    pub fn generic(name: NameId) -> TypeId {
        self.add(TypeData.Generic(name))
    }

    pub fn const_generic(name: NameId, value_type: TypeId) -> TypeId {
        self.add(TypeData.ConstGeneric(name, value_type))
    }

    pub fn opaque(name: NameId, span: SourceSpan) -> TypeId {
        self.add(TypeData.Opaque(name, span))
    }

    pub fn closure(captures: Vec<CapturedVar>, parameters: Vec<Parameter>, result: TypeId, span: SourceSpan, environment: Option<TypeId>, call_method: Option<TypeId>) -> TypeId {
        self.add(TypeData.Closure(captures, parameters, result, span, environment, call_method))
    }

    pub fn register(header: DefinitionHeader, generics: Vec<TypeId>) -> DefId {
        let id = DefId(self.definitions.len());
        self.definitions.alloc(TypeDefinition.new(header, generics));
        id
    }

    pub fn definition(id: DefId) -> Option<TypeDefinition&> {
        self.definitions.get(id.index)
    }

    // The body is consumed here; invalid IDs do not leak its owned buffers.
    pub fn finish_definition(id: DefId, body: DefinitionBody) -> Result<(), AnalysisError> {
        match self.definition(id) {
            Some(definition) => definition.complete(body),
            None => {
                body.drop();
                Result<(), AnalysisError>.Err(AnalysisError.internal("invalid definition ID"))
            },
        }
    }

    pub fn complete_definition(id: DefId) -> Result<DefinitionBody&, AnalysisError> {
        match self.definition(id) {
            Some(definition) => definition.body(),
            None => Result<DefinitionBody&, AnalysisError>.Err(AnalysisError.internal("invalid definition ID")),
        }
    }
}

impl Drop for TypeStore {
    pub fn drop() {
        for entry in self.index.entries() {
            entry[0].drop();
        }

        self.index.drop();

        for value in self.values {
            value.drop();
        }

        for definition in self.definitions {
            definition.drop();
        }

        self.values.drop();
        self.definitions.drop();
    }
}
