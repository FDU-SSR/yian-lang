from compiler.analysis.resolution.context import ResolutionContext;
from compiler.analysis.ty.callable import instance_substitutions, signature;
from compiler.analysis.ty.substitution import substitute;
from compiler.common.ids import TypeId;
from compiler.common.location import SourceSpan;
from compiler.diagnostics.model import AnalysisError, DiagnosticCode;
from std.collections.sort import sort_by;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

fn before(left: TypeId&, right: TypeId&) -> bool {
    left.index < right.index
}

fn mentions(ctx: ResolutionContext&, type_id: TypeId, self_type: TypeId) -> Result<bool, AnalysisError> {
    if type_id == self_type {
        return Result<bool, AnalysisError>.Ok(true);
    }

    match ctx.session.types.require(type_id)? {
        Pointer(inner) => mentions(ctx, *inner, self_type),
        Reference(inner) => mentions(ctx, *inner, self_type),
        Slice(inner) => mentions(ctx, *inner, self_type),
        TraitObject(inner) => mentions(ctx, *inner, self_type),
        Array(inner, _) => mentions(ctx, *inner, self_type),
        Tuple(elements) => {
            for element in *elements {
                if mentions(ctx, *element, self_type)? {
                    return Result<bool, AnalysisError>.Ok(true);
                }
            }

            Result<bool, AnalysisError>.Ok(false)
        },
        Nominal(_, arguments) => {
            for argument in *arguments {
                if mentions(ctx, *argument, self_type)? {
                    return Result<bool, AnalysisError>.Ok(true);
                }
            }

            Result<bool, AnalysisError>.Ok(false)
        },
        FunctionPointer(parameters, result) => {
            for parameter in *parameters {
                if mentions(ctx, *parameter, self_type)? {
                    return Result<bool, AnalysisError>.Ok(true);
                }
            }

            mentions(ctx, *result, self_type)
        },
        _ => Result<bool, AnalysisError>.Ok(false),
    }
}

// Declaration IDs give dynamic slots a deterministic order independent of hash buckets.
// Static methods have no dynamic slot. Instance signatures cannot depend on concrete Self.
pub fn object_methods(ctx: ResolutionContext&, trait_id: TypeId) -> Result<Vec<TypeId>, AnalysisError> {
    let definition = match ctx.session.types.require(trait_id)? {
        Nominal(id, _) => *id, _ => return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.internal("trait object has invalid trait identity"))
    };
    let methods = match ctx.session.types.complete_definition(definition)? {
        Trait(methods) => methods, _ => return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.internal("trait object target is not a trait"))
    };
    let result = Vec<TypeId>.new();
    let transferred = false;
    defer {
        if !transferred {
            result.drop();
        }
    };
    let substitutions = instance_substitutions(ctx, trait_id)?;
    defer substitutions.drop();
    let trait_header = *ctx.session.types.definition(definition).unwrap();
    let templates = Vec<TypeId>.new();
    defer templates.drop();

    for method in methods.values() {
        templates.push(*method);
    }

    sort_by(templates.as_slice(), before);

    for method in templates {
        let id = match ctx.session.types.require(*method)? {
            Nominal(id, _) => *id, _ => return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.internal("trait member has invalid identity"))
        };
        let header = *ctx.session.types.definition(id).unwrap();
        let callable = signature(ctx, *method)?;
        defer callable.drop();

        if callable.is_static {
            continue;
        }

        if header.generic_count() != trait_header.generic_count() + 1 {
            return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(header.header().span), "generic instance methods cannot be used through trait objects"));
        }

        let self_type = *header.generic(trait_header.generic_count()).unwrap();

        if mentions(ctx, callable.result, self_type)? {
            return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(header.header().span), "trait object method returns concrete Self"));
        }

        for parameter in callable.parameters {
            if mentions(ctx, parameter.type_id, self_type)? {
                return Result<Vec<TypeId>, AnalysisError>.Err(AnalysisError.user(DiagnosticCode.TypeMismatch, Option<SourceSpan>.Some(header.header().span), "trait object method parameter uses concrete Self"));
            }
        }

        substitutions.insert(self_type, ctx.session.types.trait_object(trait_id));
        result.push(substitute(&ctx.session.types, *method, &substitutions)?);
    }

    transferred = true;
    Result<Vec<TypeId>, AnalysisError>.Ok(result)
}
