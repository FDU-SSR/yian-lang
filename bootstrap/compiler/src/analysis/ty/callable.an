from compiler.analysis.resolution.context import ResolutionContext;
from compiler.analysis.ty.model import Parameter, TypeData;
from compiler.analysis.ty.substitution import substitute;
from compiler.analysis.definition.registry import Procedure;
from compiler.common.ids import TypeId, DefId;
from compiler.diagnostics.model import AnalysisError;
from std.collections.hash_map import HashMap;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

pub struct CallableSignature {
    pub definition: DefId,
    pub parameters: Vec<Parameter>,
    pub result: TypeId,
    pub receiver: Option<TypeId>,
    pub is_static: bool,
    pub is_header: bool,
    pub is_ffi: bool,
}

impl Drop for CallableSignature {
    pub fn drop() {
        self.parameters.drop();
    }
}

pub fn instance_substitutions(ctx: ResolutionContext&, type_id: TypeId) -> Result<HashMap<TypeId, TypeId>, AnalysisError> {
    let map = HashMap<TypeId, TypeId>.new();
    let accepted = false;
    defer {
        if !accepted {
            map.drop();
        }
    };

    match ctx.session.types.require(type_id)? {
        Nominal(id, arguments) => {
            let definition = *ctx.session.types.definition(*id).unwrap();
            let index = 0u64;

            while index < arguments.len() {
                let generic = *definition.generic(index).unwrap();

                if generic != arguments[index] {
                    map.insert(generic, arguments[index]);
                }

                index += 1;
            }
        },
        _ => return Result<HashMap<TypeId, TypeId>, AnalysisError>.Err(AnalysisError.internal("callable instance is not nominal")),
    }

    accepted = true;
    Result<HashMap<TypeId, TypeId>, AnalysisError>.Ok(map)
}

pub fn signature(ctx: ResolutionContext&, type_id: TypeId) -> Result<CallableSignature, AnalysisError> {
    let substitutions = instance_substitutions(ctx, type_id)?;
    defer substitutions.drop();
    let id = match ctx.session.types.require(type_id)? {
        Nominal(id, _) => *id,
        _ => return Result<CallableSignature, AnalysisError>.Err(AnalysisError.internal("invalid callable identity")),
    };
    let body = match ctx.session.types.complete_definition(id)? {
        Function(value) => value,
        Method(value) => value,
        _ => return Result<CallableSignature, AnalysisError>.Err(AnalysisError.internal("definition is not callable")),
    };
    let parameters = Vec<Parameter>.new();
    let accepted = false;
    defer {
        if !accepted {
            parameters.drop();
        }
    };

    for parameter in body.parameters {
        parameters.push(Parameter(parameter.name, substitute(&ctx.session.types, parameter.type_id, &substitutions)?, parameter.span));
    }

    let result = substitute(&ctx.session.types, body.result, &substitutions)?;
    let receiver = match &body.receiver {
        Some(value) => Option<TypeId>.Some(substitute(&ctx.session.types, *value, &substitutions)?),
        None => Option<TypeId>.None,
    };

    accepted = true;
    Result<CallableSignature, AnalysisError>.Ok(CallableSignature(id, parameters, result, receiver, body.is_static, body.is_header, body.is_ffi))
}

// An instance borrows the template's AST body; registration does not duplicate syntax ownership.
pub fn schedule(ctx: ResolutionContext&, type_id: TypeId) -> Result<(), AnalysisError> {
    if ctx.session.definitions.get(type_id).is_none() {
        let definition = match ctx.session.types.require(type_id)? {
            Nominal(id, _) => *id,
            _ => return Result<(), AnalysisError>.Err(AnalysisError.internal("invalid scheduled type")),
        };
        let header = *ctx.session.types.definition(definition).unwrap();
        let arguments = Vec<TypeId>.new();
        defer arguments.drop();
        let index = 0u64;

        while index < header.generic_count() {
            arguments.push(*header.generic(index).unwrap());
            index += 1;
        }

        let template_id = ctx.session.types.instance(definition, &arguments)?;
        let template = match ctx.session.definitions.get(template_id) {
            Some(value) => value,
            None => return Result<(), AnalysisError>.Err(AnalysisError.internal("callable template has no body")),
        };
        ctx.session.definitions.register(Procedure(definition, type_id, template.unit, template.body, template.kind))?;
    }

    ctx.session.worklist.enqueue(type_id);
    Result<(), AnalysisError>.Ok(())
}
