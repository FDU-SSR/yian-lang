from compiler.common.ids import TypeId, DefId, NameId, UnitId;
from compiler.common.location import SourceSpan;
from compiler.diagnostics.model import AnalysisError;
from compiler.frontend.ast.operator import UnaryOperator, BinaryOperator;
from std.collections.hash_map import HashMap;
from std.core.drop import Drop;
from std.core.hash import Hash;
from std.core.ops import PartialEq;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

pub enum AccessMode {
    Private,
    Public,
}

pub enum NominalKind {
    Struct,
    Enum,
    Trait,
    Function,
    Method,
}

pub struct StructField {
    pub name: NameId,
    pub type_id: TypeId,
    pub access: AccessMode,
    pub index: u64,
    pub span: Option<SourceSpan>
}

pub struct EnumVariant {
    pub name: NameId,
    pub payload: Option<TypeId>,
    pub discriminant: u64,
    pub span: Option<SourceSpan>
}

pub struct Parameter {
    pub name: NameId,
    pub type_id: TypeId,
    pub span: Option<SourceSpan>
}

pub struct CapturedVar {
    pub name: NameId,
    pub type_id: TypeId
}

// Definitions own their generic list and exactly one completed payload.
pub struct DefinitionHeader {
    pub kind: NominalKind,
    pub name: NameId,
    pub span: SourceSpan,
    pub unit: UnitId,
}

pub struct AggregateDefinition {
    pub fields: Vec<StructField>,
    pub methods: HashMap<NameId, TypeId>,
}

impl Drop for AggregateDefinition {
    pub fn drop() {
        self.fields.drop();
        self.methods.drop();
    }
}

pub struct EnumDefinition {
    pub variants: Vec<EnumVariant>,
    pub methods: HashMap<NameId, TypeId>,
}

impl Drop for EnumDefinition {
    pub fn drop() {
        self.variants.drop();
        self.methods.drop();
    }
}

pub struct CallableDefinition {
    pub parameters: Vec<Parameter>,
    pub result: TypeId,
    pub receiver: Option<TypeId>,
    pub is_static: bool,
    pub is_header: bool,
    pub is_ffi: bool,
    pub is_extern: bool,
    pub ffi_only: bool,
    pub is_public: bool,
    // Only parameters after this prefix belong to the method's explicit argument list.
    pub inherited_generics: u64,
}

impl Drop for CallableDefinition {
    pub fn drop() {
        self.parameters.drop();
    }
}

pub enum DefinitionBody {
    Struct {
        value: AggregateDefinition
    },
    Enum {
        value: EnumDefinition
    },
    Trait {
        methods: HashMap<NameId, TypeId>
    },
    Function {
        value: CallableDefinition
    },
    Method {
        value: CallableDefinition
    },
}

impl DefinitionBody {
    pub fn kind() -> NominalKind {
        match self {
            Struct(_) => NominalKind.Struct,
            Enum(_) => NominalKind.Enum,
            Trait(_) => NominalKind.Trait,
            Function(_) => NominalKind.Function,
            Method(_) => NominalKind.Method,
        }
    }
}

impl Drop for DefinitionBody {
    pub fn drop() {
        match self {
            Struct(value) => value.drop(),
            Enum(value) => value.drop(),
            Trait(methods) => methods.drop(),
            Function(value) => value.drop(),
            Method(value) => value.drop(),
        }
    }
}

enum DefinitionStatus {
    Declared, Complete {
        body: DefinitionBody
    }
}

pub struct TypeDefinition {
    header: DefinitionHeader,
    generics: Vec<TypeId>,
    status: DefinitionStatus,
}

impl TypeDefinition {
    static pub fn new(header: DefinitionHeader, generics: Vec<TypeId>) -> Self {
        Self(header, generics, DefinitionStatus.Declared)
    }

    pub fn header() -> DefinitionHeader {
        self.header
    }

    pub fn generic_count() -> u64 {
        self.generics.len()
    }

    pub fn generic(index: u64) -> Option<TypeId> {
        match self.generics.as_slice().get(index) {
            Some(id) => Option<TypeId>.Some(*id),
            None => Option<TypeId>.None,
        }
    }

    pub fn is_complete() -> bool {
        match &self.status {
            Declared => false,
            Complete(_) => true
        }
    }

    // Ownership transfers even on failure; a completed definition cannot be replaced.
    pub fn complete(body: DefinitionBody) -> Result<(), AnalysisError> {
        if self.is_complete() || body.kind() != self.header.kind {
            body.drop();
            return Result<(), AnalysisError>.Err(AnalysisError.internal("invalid definition completion"));
        }

        let valid_prefix = match &body {
            Method(value) => value.inherited_generics <= self.generics.len(),
            Function(value) => value.inherited_generics == 0,
            _ => true,
        };

        if !valid_prefix {
            body.drop();
            return Result<(), AnalysisError>.Err(AnalysisError.internal("invalid callable generic prefix"));
        }

        self.status = DefinitionStatus.Complete(body);
        Result<(), AnalysisError>.Ok(())
    }

    // The returned payload is borrowed and must be treated as immutable.
    pub fn body() -> Result<DefinitionBody&, AnalysisError> {
        match &self.status {
            Declared => Result<DefinitionBody&, AnalysisError>.Err(AnalysisError.internal("type definition is incomplete")),
            Complete(body) => Result<DefinitionBody&, AnalysisError>.Ok(body),
        }
    }
}

impl Drop for TypeDefinition {
    pub fn drop() {
        match &self.status {
            Declared => {},
            Complete(body) => body.drop()
        }

        self.generics.drop();
    }
}

pub enum TypeData {
    Void, Never, Error, Bool, Char, Str, IntLiteral, FloatLiteral,
    Integer {
        bits: u32,
        signed: bool
    }, CScalar {
        bits: u32,
        signed: bool,
        name: NameId
    }, Float {
        bits: u32
    },
    Generic {
        name: NameId
    }, SelfType {
        trait_id: TypeId
    },
    ConstGeneric {
        name: NameId,
        value_type: TypeId
    },
    LiteralValue {
        bits: u64,
        negative: bool,
        value_type: TypeId
    },
    ConstUnary {
        op: UnaryOperator, operand: TypeId
    },
    ConstBinary {
        op: BinaryOperator, left: TypeId, right: TypeId
    },
    Pointer {
        pointee: TypeId
    }, CPointer {
        pointee: TypeId
    }, Reference {
        pointee: TypeId
    },
    TraitObject {
        trait_id: TypeId
    }, Slice {
        element: TypeId
    }, Array {
        element: TypeId,
        length: TypeId
    },
    Tuple {
        elements: Vec<TypeId>
    }, FunctionPointer {
        parameters: Vec<TypeId>,
        result: TypeId
    },
    Opaque {
        name: NameId,
        span: SourceSpan
    },
    Nominal {
        definition: DefId,
        arguments: Vec<TypeId>
    },
    Closure {
        captures: Vec<CapturedVar>,
        parameters: Vec<Parameter>,
        result: TypeId,
        span: SourceSpan,
        environment: Option<TypeId>,
        call_method: Option<TypeId>
    },
}

impl Drop for TypeData {
    pub fn drop() {
        match self {
            Tuple(elements) => elements.drop(),
            FunctionPointer(parameters, _) => parameters.drop(),
            Nominal(_, arguments) => arguments.drop(),
            Closure(captures, parameters, _, _, _, _) => {
                captures.drop();
                parameters.drop();
            },
            _ => {},
        }
    }
}
