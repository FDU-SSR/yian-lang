from compiler.analysis.resolution.context import ResolutionContext;
from compiler.analysis.ty.callable import instance_substitutions;
from compiler.analysis.ty.substitution import substitute;
from compiler.common.ids import TypeId;
from compiler.diagnostics.model import AnalysisError;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.result import Result;
from std.collections.hash_set import HashSet;

// Finalization rejects storage cycles before these structural queries run.
pub fn is_zst(ctx: ResolutionContext&, type_id: TypeId) -> Result<bool, AnalysisError> {
    let visiting = HashSet<TypeId>.new();
    defer visiting.drop();
    zst_inner(ctx, type_id, &visiting)
}

fn zst_inner(ctx: ResolutionContext&, type_id: TypeId, visiting: HashSet<TypeId>&) -> Result<bool, AnalysisError> {
    // Reference cycles carry an address; they do not make an aggregate a ZST.

    if !visiting.insert(type_id) {
        return Result<bool, AnalysisError>.Ok(false);
    }

    defer visiting.remove(&type_id);

    match ctx.session.types.require(type_id)? {
        Void => Result<bool, AnalysisError>.Ok(true),
        Never => Result<bool, AnalysisError>.Ok(true),
        Pointer(inner) => zst_inner(ctx, *inner, visiting),
        Reference(inner) => zst_inner(ctx, *inner, visiting),
        Tuple(elements) => {
            for element in *elements {
                if !zst_inner(ctx, *element, visiting)? {
                    return Result<bool, AnalysisError>.Ok(false);
                }
            }

            Result<bool, AnalysisError>.Ok(true)
        },
        Array(element, length) => {
            let empty = match ctx.session.types.require(*length)? {
                LiteralValue(bits, _, _) => *bits == 0, _ => false
            };
            Result<bool, AnalysisError>.Ok(empty || zst_inner(ctx, *element, visiting)?)
        },
        Nominal(id, _) => {
            let substitutions = instance_substitutions(ctx, type_id)?;
            defer substitutions.drop();

            match ctx.session.types.complete_definition(*id)? {
                Struct(body) => {
                    for field in body.fields {
                        if !zst_inner(ctx, substitute(&ctx.session.types, field.type_id, &substitutions)?, visiting)? {
                            return Result<bool, AnalysisError>.Ok(false);
                        }
                    }

                    Result<bool, AnalysisError>.Ok(true)
                },
                Enum(body) => {
                    if body.variants.len() == 0 {
                        return Result<bool, AnalysisError>.Ok(true);
                    }

                    if body.variants.len() != 1 {
                        return Result<bool, AnalysisError>.Ok(false);
                    }

                    match body.variants[0].payload {
                        Some(payload) => zst_inner(ctx, substitute(&ctx.session.types, payload, &substitutions)?, visiting),
                        None => Result<bool, AnalysisError>.Ok(true),
                    }
                },
                Function(_) => Result<bool, AnalysisError>.Ok(true),
                Method(_) => Result<bool, AnalysisError>.Ok(true),
                _ => Result<bool, AnalysisError>.Ok(false),
            }
        },
        _ => Result<bool, AnalysisError>.Ok(false),
    }
}
