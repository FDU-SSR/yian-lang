// Semantic member enumeration borrows session records; returned IDs are snapshot-local.
from compiler.analysis.session.session import AnalysisSession;
from compiler.analysis.ty.callable import store_substitutions, store_signature;
from compiler.analysis.ty.substitution import infer, substitute;
from compiler.analysis.ty.method_lookup import impl_conditions;
from compiler.common.ids import NameId, TypeId, ImplId;
from compiler.diagnostics.model import AnalysisError, AnalysisErrorKind;
from std.collections.hash_map import HashMap;
from std.core.drop import Drop;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

pub struct MemberMethod { pub name: NameId, pub type_id: TypeId, pub rank: u32 }

fn append_method(session: AnalysisSession&, items: Vec<MemberMethod>&, name: NameId,
    type_id: TypeId, substitutions: HashMap<TypeId, TypeId>&, rank: u32, static_receiver: bool)
-> Result<(), AnalysisError> {
    let concrete = substitute(&session.types, type_id, substitutions)?;
    match session.types.require(concrete)? {
        Nominal(id, _) => {
            let definition = session.types.definition(*id).unwrap();
            if !definition.is_complete() { return Result<(), AnalysisError>.Ok(()); }
            match definition.body()? {
                Method(body) if body.is_static == static_receiver => { items.push(MemberMethod(name, concrete, rank)); },
                _ => {},
            }
        },
        _ => {},
    }
    Result<(), AnalysisError>.Ok(())
}

fn query_methods(session: AnalysisSession&, target: TypeId, static_receiver: bool, required: Option<TypeId>)
-> Result<Vec<MemberMethod>, AnalysisError> {
    let items = Vec<MemberMethod>.new();
    let accepted = false;
    defer { if !accepted { items.drop(); } };
    let nominal = match session.types.require(target)? { TraitObject(value) | SelfType(value) => *value, _ => target };
    match session.types.require(nominal)? {
        Nominal(id, _) => {
            let definition = session.types.definition(*id).unwrap();
            if required.is_none() && definition.is_complete() {
                let substitutions = store_substitutions(&session.types, nominal)?;
                defer substitutions.drop();
                let methods = match definition.body()? {
                    Struct(body) => Option<HashMap<NameId, TypeId>&>.Some(&body.methods),
                    Enum(body) => Option<HashMap<NameId, TypeId>&>.Some(&body.methods),
                    Trait(body) => Option<HashMap<NameId, TypeId>&>.Some(body),
                    _ => Option<HashMap<NameId, TypeId>&>.None,
                };
                if let Some(values) = methods {
                    for entry in values.entries() { append_method(session, &items, *entry[0], *entry[1], &substitutions, 2, static_receiver)?; }
                }
            }
        },
        _ => {},
    }
    let index = 0u64;
    while index < session.impls.len() {
        let id = ImplId(index);
        let record = session.impls.get(id).unwrap();
        index += 1;
        let substitutions = HashMap<TypeId, TypeId>.new();
        defer substitutions.drop();
        if !infer(&session.types, record.target, target, &substitutions) { continue; }
        if let Some(trait_id) = required {
            let expected = match session.types.require(trait_id)? { Nominal(id, _) => *id, _ => { continue; } };
            let actual = match record.trait_id { Some(value) => value, None => { continue; } };
            match session.types.require(actual)? { Nominal(id, _) if *id == expected => {}, _ => { continue; } };
        }
        let eligible = match impl_conditions(session, id, &substitutions, record.span) {
            Ok(value) => value,
            Err(error) => {
                if error.kind == AnalysisErrorKind.Internal { return Result<Vec<MemberMethod>, AnalysisError>.Err(error); }
                error.drop();
                continue;
            },
        };
        if !eligible { continue; }
        let rank = if record.trait_id.is_none() { 2u32 } elif record.automatic { 0u32 } else { 1u32 };
        for entry in record.methods.entries() {
            append_method(session, &items, *entry[0], *entry[1], &substitutions, rank, static_receiver)?;
        }
    }
    accepted = true;
    Result<Vec<MemberMethod>, AnalysisError>.Ok(items)
}

pub fn member_methods(session: AnalysisSession&, target: TypeId, static_receiver: bool)
-> Result<Vec<MemberMethod>, AnalysisError> {
    query_methods(session, target, static_receiver, Option<TypeId>.None)
}

// A receiver-only signature is reliable only when the best candidates agree.
pub fn unique_method(session: AnalysisSession&, target: TypeId, static_receiver: bool, name: NameId)
-> Result<Option<TypeId>, AnalysisError> {
    let methods = member_methods(session, target, static_receiver)?;
    defer methods.drop();
    Result<Option<TypeId>, AnalysisError>.Ok(select_unique(&methods, name))
}

fn select_unique(methods: Vec<MemberMethod>&, name: NameId) -> Option<TypeId> {
    let selected = Option<TypeId>.None;
    let rank = 0u32;
    let conflict = false;
    for method in *methods {
        if method.name != name { continue; }
        if selected.is_none() || method.rank > rank {
            selected = Option<TypeId>.Some(method.type_id);
            rank = method.rank;
            conflict = false;
        } elif method.rank == rank && *selected.unwrap() != method.type_id { conflict = true; }
    }
    if conflict { Option<TypeId>.None } else { selected }
}

// Dereference adaptation shares impl inference, constraints and candidate ranking.
pub fn receiver_types(session: AnalysisSession&, initial: TypeId) -> Result<Vec<TypeId>, AnalysisError> {
    let result = Vec<TypeId>.new();
    let accepted = false;
    defer { if !accepted { result.drop(); } };
    let current = initial;
    let budget = session.types.len();
    while result.len() <= budget {
        let repeated = false;
        for previous in result { if *previous == current { repeated = true; break; } }
        if repeated { break; }
        result.push(current);
        match session.types.require(current)? {
            Reference(inner) | Pointer(inner) => { current = *inner; continue; },
            _ => {},
        }
        let deref = match session.intrinsic_type("Deref") { Some(value) => value, None => { break; } };
        let methods = query_methods(session, current, false, Option<TypeId>.Some(deref))?;
        defer methods.drop();
        let name = session.names.intern("deref");
        let method = match select_unique(&methods, name) { Some(value) => value, None => { break; } };
        let signature = store_signature(&session.types, method)?;
        defer signature.drop();
        current = match session.types.require(signature.result)? { Reference(inner) | Pointer(inner) => *inner, _ => { break; } };
    }
    accepted = true;
    Result<Vec<TypeId>, AnalysisError>.Ok(result)
}
