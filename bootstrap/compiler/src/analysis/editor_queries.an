from compiler.analysis.editor import EditorSnapshot, EditorLocation;
from compiler.analysis.session.session import CompilationUnit;
from compiler.analysis.ty.model import TypeData, DefinitionBody, Parameter, StructField, EnumVariant, AccessMode, NominalKind;
from compiler.analysis.ty.callable import store_signature, store_substitutions;
from compiler.analysis.ty.queries import struct_fields, enum_variants;
from compiler.analysis.ty.display import stored_type_text;
from compiler.analysis.symbol.model import Symbol, SymbolKind;
from compiler.analysis.ty.substitution import infer, substitute;
from compiler.diagnostics.model import AnalysisError;
from compiler.frontend.ast.node import GenericParam, ItemData;
from compiler.common.ids import SourceId, TypeId, UnitId, SymbolId, ImplId, NameId;
from compiler.frontend.source import Position, Span;
from compiler.frontend.lex.lexer import Lexer;
from compiler.frontend.lex.token import Token, TokenPayload, PunctuatorKind, KeywordKind;
from compiler.frontend.lex.token import drop_tokens;
from std.collections.hash_map import HashMap;
from std.core.convert import From;
from std.core.text import LineIndex, TextPosition;
from std.core.drop import Drop;
from std.core.option import Option;
from std.core.result import Result;
from std.core.string import String;
from std.core.vec import Vec;

struct CallFrame {
    open_token: u64,
    active_parameter: u64,
    brackets: u64,
    braces: u64,
    angles: u64,
}

enum CompletionContext {
    Value,
    Type,
    Member,
    ImportPath,
    ImportName,
}

pub struct EditorSignatureHelp {
    pub label: String,
    pub parameter_labels: Vec<String>,
    pub active_parameter: u64,
}

impl Drop for EditorSignatureHelp {
    pub fn drop() {
        self.label.drop();
        for label in self.parameter_labels { label.drop(); }
        self.parameter_labels.drop();
    }
}

pub enum EditorCompletionKind {
    Function, Method, Field, Variant, Struct, Enum, Trait, Alias,
    Constant, Variable, Parameter, Module, Package, Primitive, Text,
}

pub struct EditorCompletionItem {
    pub label: String,
    pub kind: EditorCompletionKind,
    pub detail: Option<String>,
    pub parameter_labels: Vec<String>,
}

impl Drop for EditorCompletionItem {
    pub fn drop() {
        self.label.drop();
        match &self.detail { Some(value) => value.drop(), None => {}, }
        for parameter in self.parameter_labels { parameter.drop(); }
        self.parameter_labels.drop();
    }
}

pub struct EditorCompletionResult {
    pub items: Vec<EditorCompletionItem>,
    pub replace: Option<EditorLocation>,
}

impl Drop for EditorCompletionResult {
    pub fn drop() {
        for item in self.items { item.drop(); }
        self.items.drop();
        match &self.replace { Some(value) => value.drop(), None => {}, }
    }
}

struct CompletionPosition {
    prefix: String,
    replace: Option<EditorLocation>,
    receiver_token: Option<u64>,
    context: CompletionContext,
}

impl Drop for CompletionPosition {
    pub fn drop() {
        self.prefix.drop();
        match &self.replace { Some(value) => value.drop(), None => {}, }
    }
}

fn unit_for_source(snapshot: EditorSnapshot&, source: SourceId) -> Option<CompilationUnit&> {
    let index = 0u64;
    while index < snapshot.session().len() {
        match snapshot.session().unit(UnitId(index)) {
            Some(unit) if unit.source == source => return Option<CompilationUnit&>.Some(unit),
            _ => {},
        }
        index += 1u64;
    }
    Option<CompilationUnit&>.None
}

fn is_punctuator(token: Token&, expected: PunctuatorKind) -> bool {
    match token.kind() {
        Punctuator(value) => *value == expected,
        _ => false,
    }
}

fn completion_position(
    snapshot: EditorSnapshot&,
    source: SourceId,
    tokens: Vec<Token>&,
    row: u64,
    column: u64,
) -> CompletionPosition {
    let prefix = String.new();
    let replace = Option<EditorLocation>.None;
    let prefix_token = Option<u64>.None;
    let last_before = Option<u64>.None;
    let text = match snapshot.source_text(source) {
        Some(value) => value,
        None => return CompletionPosition(prefix, replace, Option<u64>.None, CompletionContext.Value),
    };
    let line_index = LineIndex.new(text);
    defer line_index.drop();

    let index = 0u64;
    while index < tokens.len() {
        let token = &tokens[index];
        let is_before = token.span.start.row < row ||
        (token.span.start.row == row && token.span.start.column < column);
        if is_before { last_before = Option<u64>.Some(index); }

        if token.span.start.row == row && token.span.end.row == row &&
        token.span.start.column < column && column <= token.span.end.column {
            match token.kind() {
                Identifier(_) => {
                    let begin = line_index.byte_offset(TextPosition(row=row, column=token.span.start.column));
                    let end = line_index.byte_offset(TextPosition(row=row, column=column));
                    let typed = str.from_slice(text.as_slice()[begin..end]).unwrap();
                    prefix.push_str(*typed);
                    prefix_token = Option<u64>.Some(index);

                    let path = snapshot.source_path(source).unwrap();
                    let span = Span(start=token.span.start, end=Position(row=row, column=column));
                    replace = Option<EditorLocation>.Some(EditorLocation(
                        path=String.from(path), span=span));
                },
                _ => {},
            }
        }

        index += 1u64;
    }

    let anchor = match prefix_token {
        Some(value) => value,
        None => match last_before {
            Some(value) => value + 1u64,
            None => 0u64,
        },
    };

    let statement_start = 0u64;
    let statement_index = anchor;
    while statement_index != 0u64 {
        statement_index -= 1u64;
        if is_punctuator(&tokens[statement_index], PunctuatorKind.Semicolon) {
            statement_start = statement_index + 1u64;
            break;
        }
    }

    let from_index = Option<u64>.None;
    let import_index = Option<u64>.None;
    let scan = statement_start;
    while scan < anchor {
        match tokens[scan].kind() {
            Keyword(value) => {
                if *value == KeywordKind.From { from_index = Option<u64>.Some(scan); }
                if *value == KeywordKind.Import { import_index = Option<u64>.Some(scan); }
            },
            _ => {},
        }
        scan += 1u64;
    }

    let context = match import_index {
        Some(index) => match from_index {
            Some(_) if anchor > index => CompletionContext.ImportName,
            _ => CompletionContext.ImportPath,
        },
        None => match from_index {
            Some(_) => CompletionContext.ImportPath,
            None => {
                let previous = match anchor {
                    0u64 => Option<u64>.None,
                    _ => Option<u64>.Some(anchor - 1u64),
                };
                match previous {
                    Some(index) if is_punctuator(&tokens[index], PunctuatorKind.Dot) =>
                    CompletionContext.Member,
                    Some(index) if is_type_introducer(&tokens[index]) => CompletionContext.Type,
                    _ => CompletionContext.Value,
                }
            },
        },
    };

    let receiver_token = Option<u64>.None;
    if context == CompletionContext.Member && anchor != 0u64 {
        let index = anchor - 1u64;
        let nested = 0u64;
        while index != 0u64 {
            index -= 1u64;
            let token = &tokens[index];
            match token.kind() {
                Punctuator(kind) => match *kind {
                    RParen | RBracket | RAngle => { nested += 1u64; },
                    LParen | LBracket | LAngle => { if nested != 0u64 { nested -= 1u64; } },
                    _ => {
                        if nested == 0u64 && is_expression_boundary(*kind) { break; }
                    },
                },
                Identifier(_) => {
                    if nested == 0u64 {
                        receiver_token = Option<u64>.Some(index);
                        break;
                    }
                },
                _ => {},
            }
        }
    }

    CompletionPosition(prefix, replace, receiver_token, context)
}

fn is_type_introducer(token: Token&) -> bool {
    match token.kind() {
        Punctuator(kind) => *kind == PunctuatorKind.Colon ||
        *kind == PunctuatorKind.Arrow || *kind == PunctuatorKind.LAngle,
        _ => false,
    }
}

fn is_expression_boundary(kind: PunctuatorKind) -> bool {
    match kind {
        Equal | LParen | Comma | Semicolon | LBrace | RBrace | Colon | FatArrow |
        Plus | Minus | Star | Slash => true,
        _ => false,
    }
}

fn push_completion(items: Vec<EditorCompletionItem>&, item: EditorCompletionItem) {
    for current in *items {
        if current.label.as_str() == item.label.as_str() {
            item.drop();
            return;
        }
    }

    items.push(item);
}

fn append_completion(
    items: Vec<EditorCompletionItem>&,
    label: str,
    kind: EditorCompletionKind,
    detail: Option<String>,
    parameter_labels: Vec<String>,
) {
    push_completion(items, EditorCompletionItem(
        label=String.from(&label),
        kind=kind,
        detail=detail,
        parameter_labels=parameter_labels,
        ));
}

fn completion_kind(snapshot: EditorSnapshot&, symbol_id: SymbolId) -> EditorCompletionKind {
    let symbol = match snapshot.session().symbols.get(symbol_id) {
        Some(value) => value,
        None => return EditorCompletionKind.Variable,
    };
    match symbol.kind {
        SymbolKind.Function => EditorCompletionKind.Function,
        SymbolKind.Variable => EditorCompletionKind.Variable,
        SymbolKind.Parameter => EditorCompletionKind.Parameter,
        SymbolKind.Constant => EditorCompletionKind.Constant,
        SymbolKind.Alias => EditorCompletionKind.Alias,
        SymbolKind.Module => EditorCompletionKind.Module,
        SymbolKind.Type => match snapshot.session().types.get(symbol.type_id) {
            Some(Nominal(definition, _)) => match snapshot.session().types.definition(*definition) {
                Some(record) => match record.header().kind {
                    Struct => EditorCompletionKind.Struct,
                    Enum => EditorCompletionKind.Enum,
                    Trait => EditorCompletionKind.Trait,
                    _ => EditorCompletionKind.Struct,
                },
                None => EditorCompletionKind.Struct,
            },
            _ => EditorCompletionKind.Struct,
        },
    }
}

fn source_text_for_span(snapshot: EditorSnapshot&, source: SourceId, span: Span) -> String {
    let text = match snapshot.source_text(source) {
        Some(value) => value,
        None => return String.new(),
    };
    let index = LineIndex.new(text);
    defer index.drop();
    let start = index.byte_offset(TextPosition(row=span.start.row, column=span.start.column));
    let end = index.byte_offset(TextPosition(row=span.end.row, column=span.end.column));
    let bytes = text.as_slice();
    String.from(&str.from_slice_unchecked(bytes[start..end]))
}

// Alias completion follows the declaration signature rather than exposing only its expanded type.
fn alias_completion_detail(snapshot: EditorSnapshot&, symbol: Symbol&) -> String {
    let fallback = stored_type_text(&snapshot.session().types, &snapshot.session().names, symbol.type_id);
    let unit = match snapshot.session().unit(symbol.unit) {
        Some(value) => value,
        None => return fallback,
    };
    let tree = match &unit.prepared.tree {
        Some(value) => value,
        None => return fallback,
    };
    let alias_name = snapshot.session().names.text(symbol.name);

    for item in tree.root.data.items {
        match &item.data {
            Alias(_, name, generics, _) if name.data.name.as_str() == alias_name => {
                let detail = String.new();
                detail.push_str("typedef ");
                detail.push_str(alias_name);
                if generics.len() != 0u64 {
                    detail.push('<');
                    let index = 0u64;
                    for generic in generics {
                        if index != 0u64 { detail.push_str(", "); }
                        match generic {
                            Type(value) => detail.push_str(value.data.name.data.name.as_str()),
                            Constant(value) => {
                                detail.push_str("const ");
                                detail.push_str(value.data.name.data.name.as_str());
                                detail.push_str(": ");
                                let annotation = source_text_for_span(snapshot, unit.source,
                                    value.data.const_type.span);
                                detail.push_str(annotation.as_str());
                                annotation.drop();
                            },
                        }
                        index += 1u64;
                    }
                    detail.push('>');
                }
                detail.push_str(" = ");
                detail.push_str(fallback.as_str());
                detail.push(';');
                fallback.drop();
                return detail;
            },
            _ => {},
        }
    }

    fallback
}

fn symbol_completion(
    snapshot: EditorSnapshot&,
    symbol_id: SymbolId,
    prefix: str,
) -> Option<EditorCompletionItem> {
    let symbol = match snapshot.session().symbols.get(symbol_id) {
        Some(value) => value,
        None => return Option<EditorCompletionItem>.None,
    };
    let name = snapshot.session().names.text(symbol.name);
    if !name.starts_with(prefix) {
        return Option<EditorCompletionItem>.None;
    }

    let kind = completion_kind(snapshot, symbol_id);
    let parameter_labels = Vec<String>.new();
    let detail = if kind == EditorCompletionKind.Alias {
        Option<String>.Some(alias_completion_detail(snapshot, symbol))
    } else {
        match signature_for_type(snapshot, symbol.type_id, name, 0u64) {
            Some(signature) => {
                let value = String.from(&signature.label.as_str());
                for parameter in signature.parameter_labels {
                    parameter_labels.push(String.from(&parameter.as_str()));
                }
                signature.drop();
                match kind {
                    Function | Method => Option<String>.Some(value),
                    _ => {
                        value.drop();
                        Option<String>.Some(stored_type_text(&snapshot.session().types,
                            &snapshot.session().names, symbol.type_id))
                    },
                }
            },
            None => Option<String>.Some(stored_type_text(&snapshot.session().types,
                &snapshot.session().names, symbol.type_id)),
        }
    };

    Option<EditorCompletionItem>.Some(EditorCompletionItem(
        label=String.from(&name), kind=kind, detail=detail,
        parameter_labels=parameter_labels))
}

fn append_symbol_candidates(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    source: SourceId,
    row: u64,
    column: u64,
    prefix: str,
    type_only: bool,
) -> Result<(), AnalysisError> {
    let symbols = snapshot.visible_symbols_with_metadata_at(source, row, column)?;
    defer symbols.drop();

    for visible in symbols {
        let symbol = match snapshot.session().symbols.get(visible.id) {
            Some(value) => value,
            None => continue,
        };
        if type_only && symbol.kind != SymbolKind.Type && symbol.kind != SymbolKind.Alias {
            continue;
        }

        match symbol_completion(snapshot, visible.id, prefix) {
            Some(item) => {
                if visible.is_local {
                    match &item.detail {
                        Some(value) => value.drop(),
                        None => {},
                    }
                    item.detail = Option<String>.None;
                }
                push_completion(items, item);
            },
            None => {},
        }
    }

    Result<(), AnalysisError>.Ok(())
}

fn append_primitive_candidates(items: Vec<EditorCompletionItem>&, prefix: str) {
    for name in ["void", "bool", "char", "str", "i8", "i16", "i32", "i64",
        "u8", "u16", "u32", "u64", "f16", "f32", "f64", "int", "uint", "float"] {
        if (*name).starts_with(prefix) {
            let detail = String.new();
            detail.push_str("type");
            append_completion(items, *name, EditorCompletionKind.Primitive,
                Option<String>.Some(detail), Vec<String>.new());
        }
    }
}

fn lexical_completions(
    items: Vec<EditorCompletionItem>&,
    tokens: Vec<Token>&,
    prefix: str,
) {
    for token in *tokens {
        match token.kind() {
            Identifier(name) if name.as_str().starts_with(prefix) =>
            append_completion(items, name.as_str(), EditorCompletionKind.Text,
                Option<String>.None, Vec<String>.new()),
            _ => {},
        }
    }
}

fn lexical_completion_result(
    snapshot: EditorSnapshot&,
    source: SourceId,
    row: u64,
    column: u64,
) -> EditorCompletionResult {
    let text = match snapshot.source_text(source) {
        Some(value) => value,
        None => return EditorCompletionResult(
            Vec<EditorCompletionItem>.new(), Option<EditorLocation>.None),
    };
    let tokens = match Lexer.new(text).run() {
        Ok(value) => value,
        Err(error) => {
            error.drop();
            return EditorCompletionResult(
                Vec<EditorCompletionItem>.new(), Option<EditorLocation>.None);
        },
    };
    defer drop_tokens(&tokens);

    let position = completion_position(snapshot, source, &tokens, row, column);
    defer position.drop();
    let items = Vec<EditorCompletionItem>.new();
    lexical_completions(&items, &tokens, position.prefix.as_str());

    let replace = match &position.replace {
        Some(location) => Option<EditorLocation>.Some(EditorLocation(
            path=String.from(&location.path.as_str()), span=location.span)),
        None => Option<EditorLocation>.None,
    };
    EditorCompletionResult(items, replace)
}

fn method_is_static(snapshot: EditorSnapshot&, method: TypeId) -> bool {
    match snapshot.session().types.get(method) {
        Some(Nominal(definition, _)) => match snapshot.session().types.complete_definition(*definition) {
            Ok(Method(callable)) => callable.is_static,
            Err(error) => { error.drop(); false },
            _ => false,
        },
        _ => false,
    }
}

fn append_method(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    name_id: NameId,
    method: TypeId,
    static_receiver: bool,
    prefix: str,
) {
    let name = snapshot.session().names.text(name_id);
    if !name.starts_with(prefix) || method_is_static(snapshot, method) != static_receiver {
        return;
    }

    let parameter_labels = Vec<String>.new();
    let detail = match signature_for_type(snapshot, method, name, 0u64) {
        Some(signature) => {
            let text = String.from(&signature.label.as_str());
            for parameter in signature.parameter_labels {
                parameter_labels.push(String.from(&parameter.as_str()));
            }
            signature.drop();
            Option<String>.Some(text)
        },
        None => Option<String>.Some(stored_type_text(&snapshot.session().types,
            &snapshot.session().names, method)),
    };
    append_completion(items, name, EditorCompletionKind.Method, detail, parameter_labels);
}

fn append_method_map(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    methods: HashMap<NameId, TypeId>&,
    substitutions: HashMap<TypeId, TypeId>&,
    static_receiver: bool,
    prefix: str,
) -> Result<(), AnalysisError> {
    for entry in methods.entries() {
        let method_type = substitute(&snapshot.session().types, *entry[1], substitutions)?;
        append_method(snapshot, items, *entry[0], method_type, static_receiver, prefix);
    }

    Result<(), AnalysisError>.Ok(())
}

fn append_definition_methods(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    target: TypeId,
    static_receiver: bool,
    prefix: str,
) -> Result<(), AnalysisError> {
    let nominal = match snapshot.session().types.require(target)? {
        Nominal(definition, _) => target,
        TraitObject(trait_type) => *trait_type,
        _ => return Result<(), AnalysisError>.Ok(()),
    };
    let definition = match snapshot.session().types.require(nominal)? {
        Nominal(id, _) => *id,
        _ => return Result<(), AnalysisError>.Ok(()),
    };
    let substitutions = store_substitutions(&snapshot.session().types, nominal)?;
    defer substitutions.drop();

    match snapshot.session().types.complete_definition(definition)? {
        Struct(value) => {
            append_method_map(snapshot, items, &value.methods,
                &substitutions, static_receiver, prefix)?;
        },
        Enum(value) => {
            append_method_map(snapshot, items, &value.methods,
                &substitutions, static_receiver, prefix)?;
        },
        Trait(methods) => {
            append_method_map(snapshot, items, methods,
                &substitutions, static_receiver, prefix)?;
        },
        _ => {},
    }

    Result<(), AnalysisError>.Ok(())
}

fn append_impl_methods(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    target: TypeId,
    static_receiver: bool,
    prefix: str,
) -> Result<(), AnalysisError> {
    let index = 0u64;
    while index < snapshot.session().impls.len() {
        append_impl_methods_for_record(snapshot, items, ImplId(index), target,
            static_receiver, prefix)?;
        index += 1u64;
    }

    Result<(), AnalysisError>.Ok(())
}

fn append_impl_methods_for_record(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    id: ImplId,
    target: TypeId,
    static_receiver: bool,
    prefix: str,
) -> Result<(), AnalysisError> {
    let record = match snapshot.session().impls.get(id) {
        Some(value) => value,
        None => return Result<(), AnalysisError>.Ok(()),
    };
    let substitutions = HashMap<TypeId, TypeId>.new();
    defer substitutions.drop();

    if infer(&snapshot.session().types, record.target, target, &substitutions) {
        for entry in record.methods.entries() {
            let method_type = substitute(&snapshot.session().types, *entry[1], &substitutions)?;
            append_method(snapshot, items, *entry[0], method_type, static_receiver, prefix);
        }
    }

    Result<(), AnalysisError>.Ok(())
}

fn append_member_completions(
    snapshot: EditorSnapshot&,
    unit: CompilationUnit&,
    items: Vec<EditorCompletionItem>&,
    position: CompletionPosition&,
) -> Result<(), AnalysisError> {
    let receiver_index = match position.receiver_token {
        Some(value) => value,
        None => return Result<(), AnalysisError>.Ok(()),
    };
    let receiver = &unit.prepared.tokens[receiver_index];
    let resolved = match snapshot.resolved_name_at(unit.source,
        receiver.span.start.row, receiver.span.start.column) {
        Some(value) => value,
        None => return Result<(), AnalysisError>.Ok(()),
    };
    let symbol = match snapshot.session().symbols.get(resolved.symbol) {
        Some(value) => value,
        None => return Result<(), AnalysisError>.Ok(()),
    };
    let static_receiver = symbol.kind == SymbolKind.Type || symbol.kind == SymbolKind.Alias;
    let target = resolved.type_id;

    if !static_receiver {
        target = match snapshot.session().types.require(target)? {
            Pointer(inner) | CPointer(inner) | Reference(inner) => *inner,
            _ => target,
        };
    }

    if !static_receiver {
        match snapshot.session().types.get(target) {
            Some(Nominal(definition, _)) => match snapshot.session().types.definition(*definition) {
                Some(record) if record.header().kind == NominalKind.Struct => {
                    let fields = struct_fields(&snapshot.session().types, target)?;
                    defer fields.drop();
                    for field in fields {
                        if field.access == AccessMode.Private && match &field.span {
                            Some(location) => location.source != unit.source,
                            None => true,
                        }
                        {
                            continue;
                        }
                        let name = snapshot.session().names.text(field.name);
                        if !name.starts_with(position.prefix.as_str()) { continue; }
                        let detail = stored_type_text(&snapshot.session().types,
                            &snapshot.session().names, field.type_id);
                        append_completion(items, name, EditorCompletionKind.Field,
                            Option<String>.Some(detail), Vec<String>.new());
                    }
                },
                _ => {},
            },
            _ => {},
        }
    }

    append_definition_methods(snapshot, items, target, static_receiver, position.prefix.as_str())?;
    append_impl_methods(snapshot, items, target, static_receiver, position.prefix.as_str())?;

    if static_receiver && match snapshot.session().types.get(target) {
        Some(Nominal(definition, _)) => match snapshot.session().types.definition(*definition) {
            Some(record) => record.header().kind == NominalKind.Enum,
            None => false,
        },
        _ => false,
    }
    {
        let variants = enum_variants(&snapshot.session().types, target)?;
        defer variants.drop();
        for variant in variants {
            let name = snapshot.session().names.text(variant.name);
            if !name.starts_with(position.prefix.as_str()) { continue; }
            let detail = match variant.payload {
                Some(type_id) => Option<String>.Some(stored_type_text(&snapshot.session().types,
                    &snapshot.session().names, type_id)),
                None => Option<String>.None,
            };
            append_completion(items, name, EditorCompletionKind.Variant, detail, Vec<String>.new());
        }
    }

    Result<(), AnalysisError>.Ok(())
}

fn module_name(snapshot: EditorSnapshot&, source: SourceId) -> Option<String> {
    let path = match snapshot.source_path(source) {
        Some(value) => value,
        None => return Option<String>.None,
    };
    let package_name = Option<str>.None;
    let relative_start = 0u64;

    match snapshot.session().package_map() {
        Some(packages) => match packages.package_of(path) {
            Some(package) => {
                package_name = Option<str>.Some(package.name.as_str());
                relative_start = package.source_root.as_str().as_slice().len() + 1u64;
            },
            None => {},
        },
        None => {},
    }

    let bytes = path.as_slice();
    let file_start = relative_start;
    let scan = file_start;
    if package_name.is_none() {
        while scan < bytes.len() {
            if bytes[scan] == b'/' { file_start = scan + 1u64; }
            scan += 1u64;
        }
    }

    let end = bytes.len();
    if end < file_start || end - file_start < 3u64 ||
    str.from_slice_unchecked(bytes[(end - 3u64)..end]) != ".an" {
        return Option<String>.None;
    }
    end -= 3u64;

    let result = String.new();
    match package_name {
        Some(name) => { result.push_str(name); result.push('.'); },
        None => {},
    }

    let segment_start = file_start;
    let index = file_start;
    while index < end {
        if bytes[index] == b'/' {
            result.push_str(str.from_slice_unchecked(bytes[segment_start..index]));
            result.push('.');
            segment_start = index + 1u64;
        }
        index += 1u64;
    }
    result.push_str(str.from_slice_unchecked(bytes[segment_start..end]));
    Option<String>.Some(result)
}

fn append_import_path_candidates(
    snapshot: EditorSnapshot&,
    items: Vec<EditorCompletionItem>&,
    prefix: str,
) {
    match snapshot.session().package_map() {
        Some(packages) => {
            let index = 0u64;
            while index < packages.len() {
                match packages.at(index) {
                    Some(package) if package.name.as_str().starts_with(prefix) =>
                    append_completion(items, package.name.as_str(), EditorCompletionKind.Package,
                        Option<String>.None, Vec<String>.new()),
                    _ => {},
                }
                index += 1u64;
            }
        },
        None => {},
    }

    let index = 0u64;
    while index < snapshot.session().len() {
        match snapshot.session().unit(UnitId(index)) {
            Some(unit) => match module_name(snapshot, unit.source) {
                Some(name) => {
                    if name.as_str().starts_with(prefix) {
                        append_completion(items, name.as_str(), EditorCompletionKind.Module,
                            Option<String>.None, Vec<String>.new());
                    }
                    name.drop();
                },
                None => {},
            },
            None => {},
        }
        index += 1u64;
    }
}

fn import_target_unit(snapshot: EditorSnapshot&, unit: CompilationUnit&) -> Option<UnitId> {
    let from = Option<u64>.None;
    let import = Option<u64>.None;
    let index = 0u64;
    while index < unit.prepared.tokens.len() {
        match unit.prepared.tokens[index].kind() {
            Keyword(value) => {
                if *value == KeywordKind.From { from = Option<u64>.Some(index); }
                if *value == KeywordKind.Import { import = Option<u64>.Some(index); }
            },
            _ => {},
        }
        index += 1u64;
    }

    let from_index = match from {
        Some(value) => value,
        None => return Option<UnitId>.None,
    };
    let import_index = match import {
        Some(value) => value,
        None => return Option<UnitId>.None,
    };
    let requested = String.new();
    index = from_index + 1u64;
    while index < import_index {
        let token = &unit.prepared.tokens[index];
        match token.kind() {
            Identifier(name) => requested.push_str(name.as_str()),
            Punctuator(kind) if *kind == PunctuatorKind.Dot => requested.push('.'),
            _ => {},
        }
        index += 1u64;
    }

    let unit_index = 0u64;
    while unit_index < snapshot.session().len() {
        match snapshot.session().unit(UnitId(unit_index)) {
            Some(candidate) => match module_name(snapshot, candidate.source) {
                Some(name) => {
                    let matches = name.as_str() == requested.as_str();
                    name.drop();
                    if matches {
                        requested.drop();
                        return Option<UnitId>.Some(candidate.id);
                    }
                },
                None => {},
            },
            None => {},
        }
        unit_index += 1u64;
    }

    requested.drop();
    Option<UnitId>.None
}

fn importable_symbol(snapshot: EditorSnapshot&, symbol_id: SymbolId, unit: UnitId, prefix: str)
-> Option<EditorCompletionItem> {
    let symbol = match snapshot.session().symbols.get(symbol_id) {
        Some(value) => value,
        None => return Option<EditorCompletionItem>.None,
    };
    if symbol.unit != unit || !symbol.is_public ||
    (symbol.kind != SymbolKind.Function && symbol.kind != SymbolKind.Constant &&
        symbol.kind != SymbolKind.Alias && symbol.kind != SymbolKind.Type) {
        return Option<EditorCompletionItem>.None;
    }

    symbol_completion(snapshot, symbol_id, prefix)
}

fn append_import_name_candidates(
    snapshot: EditorSnapshot&,
    unit: CompilationUnit&,
    items: Vec<EditorCompletionItem>&,
    prefix: str,
) {
    let target = match import_target_unit(snapshot, unit) {
        Some(value) => value,
        None => { return; },
    };

    let index = 0u64;
    while index < snapshot.session().symbols.symbol_count() {
        match importable_symbol(snapshot, SymbolId(index), target, prefix) {
            Some(item) => push_completion(items, item),
            None => {},
        }
        index += 1u64;
    }
}

fn release_completion_items(items: Vec<EditorCompletionItem>&) {
    for item in *items { item.drop(); }
    items.drop();
}

// Completion results own all labels, details, parameter names and replacement paths.
pub fn completion_at(
    snapshot: EditorSnapshot&,
    source: SourceId,
    row: u64,
    column: u64,
) -> Result<EditorCompletionResult, AnalysisError> {
    let unit = match unit_for_source(snapshot, source) {
        Some(value) => value,
        // Recovered syntax errors keep the source but omit its parsed compilation unit.
        None => return Result<EditorCompletionResult, AnalysisError>.Ok(
            lexical_completion_result(snapshot, source, row, column)),
    };
    let position = completion_position(snapshot, source, &unit.prepared.tokens, row, column);
    let items = Vec<EditorCompletionItem>.new();
    let accepted = false;
    defer {
        if !accepted {
            release_completion_items(&items);
            position.drop();
        }
    };

    if !snapshot.semantic_complete() {
        lexical_completions(&items, &unit.prepared.tokens, position.prefix.as_str());
    } else {
        match position.context {
            Member => { append_member_completions(snapshot, unit, &items, &position)?; },
            ImportPath => { append_import_path_candidates(snapshot, &items, position.prefix.as_str()); },
            ImportName => { append_import_name_candidates(snapshot, unit, &items, position.prefix.as_str()); },
            Type => {
                append_symbol_candidates(snapshot, &items, source, row, column,
                    position.prefix.as_str(), true)?;
                append_primitive_candidates(&items, position.prefix.as_str());
            },
            Value => {
                append_symbol_candidates(snapshot, &items, source, row, column,
                    position.prefix.as_str(), false)?;
                append_primitive_candidates(&items, position.prefix.as_str());
            },
        }
    }

    let replace = match &position.replace {
        Some(location) => Option<EditorLocation>.Some(EditorLocation(
            path=String.from(&location.path.as_str()), span=location.span)),
        None => Option<EditorLocation>.None,
    };
    let result = EditorCompletionResult(items, replace);
    position.drop();
    accepted = true;
    Result<EditorCompletionResult, AnalysisError>.Ok(result)
}

fn call_frames(tokens: Vec<Token>&, row: u64, column: u64) -> Vec<CallFrame> {
    let frames = Vec<CallFrame>.new();
    let index = 0u64;

    while index < tokens.len() {
        let token = &tokens[index];
        if token.span.start.row > row ||
        (token.span.start.row == row && token.span.start.column >= column) {
            break;
        }

        match token.kind() {
            Punctuator(kind) => match *kind {
                LParen => frames.push(CallFrame(open_token=index, active_parameter=0u64,
                    brackets=0u64, braces=0u64, angles=0u64)),
                RParen => {
                    if frames.len() != 0u64 { frames.pop(); }
                },
                LBracket => {
                    if frames.len() != 0u64 { frames[frames.len() - 1u64].brackets += 1u64; }
                },
                RBracket => {
                    if frames.len() != 0u64 && frames[frames.len() - 1u64].brackets != 0u64 {
                        frames[frames.len() - 1u64].brackets -= 1u64;
                    }
                },
                LBrace => {
                    if frames.len() != 0u64 { frames[frames.len() - 1u64].braces += 1u64; }
                },
                RBrace => {
                    if frames.len() != 0u64 && frames[frames.len() - 1u64].braces != 0u64 {
                        frames[frames.len() - 1u64].braces -= 1u64;
                    }
                },
                LAngle => {
                    if frames.len() != 0u64 { frames[frames.len() - 1u64].angles += 1u64; }
                },
                RAngle => {
                    if frames.len() != 0u64 && frames[frames.len() - 1u64].angles != 0u64 {
                        frames[frames.len() - 1u64].angles -= 1u64;
                    }
                },
                Comma => {
                    if frames.len() != 0u64 {
                        let frame = frames.len() - 1u64;
                        if frames[frame].brackets == 0u64 && frames[frame].braces == 0u64 &&
                        frames[frame].angles == 0u64 {
                            frames[frame].active_parameter += 1u64;
                        }
                    }
                },
                _ => {},
            },
            _ => {},
        }

        index += 1u64;
    }

    frames
}

fn callee_token(tokens: Vec<Token>&, open_token: u64) -> Option<u64> {
    if open_token == 0u64 { return Option<u64>.None; }

    let index = open_token - 1u64;
    match tokens[index].kind() {
        Identifier(_) => return Option<u64>.Some(index),
        Punctuator(kind) if *kind == PunctuatorKind.RAngle => {
            let depth = 1u64;
            while index != 0u64 {
                index -= 1u64;
                match tokens[index].kind() {
                    Punctuator(value) => {
                        if *value == PunctuatorKind.RAngle {
                            depth += 1u64;
                        } elif *value == PunctuatorKind.LAngle {
                            depth -= 1u64;
                            if depth == 0u64 && index != 0u64 {
                                let name_index = index - 1u64;
                                match tokens[name_index].kind() {
                                    Identifier(_) => return Option<u64>.Some(name_index),
                                    _ => return Option<u64>.None,
                                }
                            }
                        }
                    },
                    _ => {},
                }
            }
            Option<u64>.None
        },
        _ => Option<u64>.None,
    }
}

fn append_parameter(
    snapshot: EditorSnapshot&,
    parameters: Vec<String>&,
    label: String&,
    parameter: Parameter&,
    index: u64,
) {
    let name = snapshot.session().names.text(parameter.name);
    let type_text = stored_type_text(&snapshot.session().types, &snapshot.session().names, parameter.type_id);

    if index != 0u64 {
        label.push_str(", ");
    }
    label.push_str(name);
    label.push_str(": ");
    label.push_str(type_text.as_str());

    let parameter_label = String.from(&name);
    parameters.push(parameter_label);
    type_text.drop();
}

fn signature_for_type(
    snapshot: EditorSnapshot&,
    type_id: TypeId,
    symbol_name: str,
    active_parameter: u64,
) -> Option<EditorSignatureHelp> {
    let label = String.new();
    let parameter_labels = Vec<String>.new();
    let result_type = Option<TypeId>.None;
    let parameter_count = 0u64;
    let valid = false;

    match snapshot.session().types.get(type_id) {
        Some(Nominal(definition, _)) => {
            let record = match snapshot.session().types.definition(*definition) {
                Some(value) => value,
                None => { label.drop(); parameter_labels.drop(); return Option<EditorSignatureHelp>.None; },
            };
            let body = match record.body() {
                Ok(value) => value,
                Err(error) => { error.drop(); label.drop(); parameter_labels.drop(); return Option<EditorSignatureHelp>.None; },
            };

            match body {
                Function(callable) | Method(callable) => {
                    result_type = Option<TypeId>.Some(callable.result);
                    parameter_count = callable.parameters.len();
                    valid = true;
                    label.push_str("fn ");
                    label.push_str(snapshot.session().names.text(record.header().name));
                    label.push('(');
                    let index = 0u64;
                    for parameter in callable.parameters {
                        append_parameter(snapshot, &parameter_labels, &label, parameter, index);
                        index += 1u64;
                    }
                    label.push_str(") -> ");
                },
                _ => {},
            }
        },
        Some(FunctionPointer(parameter_types, result)) => {
            result_type = Option<TypeId>.Some(*result);
            parameter_count = parameter_types.len();
            valid = true;
            label.push_str("fn ");
            label.push_str(symbol_name);
            label.push('(');
            let index = 0u64;
            for parameter_type in *parameter_types {
                if index != 0u64 { label.push_str(", "); }
                let type_text = stored_type_text(&snapshot.session().types,
                    &snapshot.session().names, *parameter_type);
                label.push_str(type_text.as_str());
                parameter_labels.push(String.from(&"_"));
                type_text.drop();
                index += 1u64;
            }
            label.push_str(") -> ");
        },
        Some(Closure(_, parameters, result, _, _, _)) => {
            result_type = Option<TypeId>.Some(*result);
            parameter_count = parameters.len();
            valid = true;
            label.push_str("fn ");
            label.push_str(symbol_name);
            label.push('(');
            let index = 0u64;
            for parameter in *parameters {
                append_parameter(snapshot, &parameter_labels, &label, parameter, index);
                index += 1u64;
            }
            label.push_str(") -> ");
        },
        _ => {},
    }

    if !valid {
        label.drop();
        parameter_labels.drop();
        return Option<EditorSignatureHelp>.None;
    }

    let result_id = match result_type {
        Some(value) => value,
        None => {
            label.drop();
            for item in parameter_labels { item.drop(); }
            parameter_labels.drop();
            return Option<EditorSignatureHelp>.None;
        },
    };
    let result_text = stored_type_text(&snapshot.session().types, &snapshot.session().names, result_id);
    label.push_str(result_text.as_str());
    result_text.drop();

    if parameter_count == 0u64 {
        active_parameter = 0u64;
    } elif active_parameter >= parameter_count {
        active_parameter = parameter_count - 1u64;
    }

    Option<EditorSignatureHelp>.Some(EditorSignatureHelp(
        label=label,
        parameter_labels=parameter_labels,
        active_parameter=active_parameter,
        ))
}

// Signature help uses the analyzed callee identity and the nearest open call frame.
pub fn signature_help_at(
    snapshot: EditorSnapshot&,
    source: SourceId,
    row: u64,
    column: u64,
) -> Option<EditorSignatureHelp> {
    if !snapshot.semantic_complete() { return Option<EditorSignatureHelp>.None; }

    let session = snapshot.session();
    let unit_index = 0u64;
    let tokens = Option<Vec<Token>&>.None;
    while unit_index < session.len() {
        let unit = match session.unit(UnitId(unit_index)) {
            Some(value) => value,
            None => return Option<EditorSignatureHelp>.None,
        };
        if unit.source == source {
            tokens = Option<Vec<Token>&>.Some(&unit.prepared.tokens);
            break;
        }
        unit_index += 1u64;
    }

    let source_tokens = match tokens {
        Some(value) => value,
        None => return Option<EditorSignatureHelp>.None,
    };
    let frames = call_frames(source_tokens, row, column);
    defer frames.drop();
    if frames.len() == 0u64 { return Option<EditorSignatureHelp>.None; }

    let frame_index = frames.len();
    while frame_index != 0u64 {
        frame_index -= 1u64;
        let frame = frames[frame_index];
        let name_index = match callee_token(source_tokens, frame.open_token) {
            Some(value) => value,
            None => continue,
        };
        let name_token = &source_tokens[name_index];
        let reference = match snapshot.resolved_name_at(source, name_token.span.start.row, name_token.span.start.column) {
            Some(value) => value,
            None => continue,
        };
        let symbol = match session.symbols.get(reference.symbol) {
            Some(value) => value,
            None => continue,
        };
        let help = signature_for_type(snapshot, reference.type_id,
            session.names.text(symbol.name), frame.active_parameter);
        if help.is_some() { return help; }
    }

    Option<EditorSignatureHelp>.None
}
