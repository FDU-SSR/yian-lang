}

ffi fn add_enum_attribute(session: IrSession&, function: IrValue, index: u32, name: str) {
    let native_function = checked_value(session, function);
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, length) = @ffi_parts(c_name.as_slice());
    let c_length = c_size(length - 1u64);
    if u64(c_length) != length - 1u64 {
        @panic("LLVM attribute name exceeds C size_t");
    }
    let kind = LLVMGetEnumAttributeKindForName(@ffi_ptr_cast<c_char>(data), c_length);
    if kind == c_uint(0) {
        @panic("unknown LLVM enum attribute");
    }
    let attribute = LLVMCreateEnumAttribute(session.context, kind, 0u64);
    if attribute == @ffi_null<LLVMOpaqueAttribute>() {
        @panic("LLVM attribute creation failed");
    }
    LLVMAddAttributeAtIndex(native_function, c_uint(index), attribute);
}

pub(ffi) ffi fn add_function_attribute(session: IrSession&, function: IrValue, name: str) {
    add_enum_attribute(session, function, 4294967295u32, name);
}

pub(ffi) ffi fn add_parameter_attribute(session: IrSession&, function: IrValue, parameter: u32, name: str) {
    if parameter == 4294967295u32 {
        @panic("LLVM parameter index exceeds the attribute range");
    }
    add_enum_attribute(session, function, parameter + 1u32, name);
}

