    let element_type = checked_type(session, element);
    let native = Vec<cptr<LLVMOpaqueValue>>.new();
    defer native.drop();
    let index: u64 = 0;
    while index < values.len() {
        native.push(checked_value(session, values[index]));
        index += 1;
    }
    let (data, length) = @ffi_parts(native.as_slice());
    return wrap_value(session, LLVMConstArray2(element_type, data, length));
}

