// words 以低 64 位字在前的顺序表示任意宽度整数。
pub(ffi) ffi fn const_int_words(session: IrSession&, ty: IrType, words: u64[]) -> IrValue {
    let native_type = checked_type(session, ty);
    if words.len() == 0u64 {
        @panic("LLVM arbitrary precision constant has no words");
    }
    let (data, count) = @ffi_parts(words);
    return wrap_value(session, LLVMConstIntOfArbitraryPrecision(native_type, checked_count(count), data));
}

