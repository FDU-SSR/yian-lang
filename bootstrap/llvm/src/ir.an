pub(ffi) ffi fn build_icmp(session: IrSession&, predicate: IntCompare, left: IrValue, right: IrValue, name: str) -> IrValue {
    let native_left = checked_value(session, left);
    let native_right = checked_value(session, right);
    let code = match predicate {
        IntCompare.Eq => 32, IntCompare.Ne => 33,
        IntCompare.Ugt => 34, IntCompare.Uge => 35,
        IntCompare.Ult => 36, IntCompare.Ule => 37,
        IntCompare.Sgt => 38, IntCompare.Sge => 39,
        IntCompare.Slt => 40, IntCompare.Sle => 41,
    };
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, _) = @ffi_parts(c_name.as_slice());
    return wrap_value(session, LLVMBuildICmp(session.builder, c_int(code), native_left, native_right, @ffi_ptr_cast<c_char>(data)));
}

pub(ffi) ffi fn build_fcmp(session: IrSession&, predicate: RealCompare, left: IrValue, right: IrValue, name: str) -> IrValue {
    let native_left = checked_value(session, left);
    let native_right = checked_value(session, right);
    let code = match predicate {
        RealCompare.Oeq => 1, RealCompare.Ogt => 2,
        RealCompare.Oge => 3, RealCompare.Olt => 4,
        RealCompare.Ole => 5, RealCompare.One => 6,
        RealCompare.Ord => 7, RealCompare.Uno => 8,
    };
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, _) = @ffi_parts(c_name.as_slice());
    return wrap_value(session, LLVMBuildFCmp(session.builder, c_int(code), native_left, native_right, @ffi_ptr_cast<c_char>(data)));
}

pub(ffi) ffi fn build_cast(session: IrSession&, op: CastOp, value: IrValue, ty: IrType, name: str) -> IrValue {
    let native_value = checked_value(session, value);
    let native_type = checked_type(session, ty);
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, _) = @ffi_parts(c_name.as_slice());
    let c_data = @ffi_ptr_cast<c_char>(data);
    let result = match op {
        CastOp.Trunc => LLVMBuildTrunc(session.builder, native_value, native_type, c_data),
        CastOp.Zext => LLVMBuildZExt(session.builder, native_value, native_type, c_data),
        CastOp.Sext => LLVMBuildSExt(session.builder, native_value, native_type, c_data),
        CastOp.Fptrunc => LLVMBuildFPTrunc(session.builder, native_value, native_type, c_data),
        CastOp.Fpext => LLVMBuildFPExt(session.builder, native_value, native_type, c_data),
        CastOp.Fptoui => LLVMBuildFPToUI(session.builder, native_value, native_type, c_data),
        CastOp.Fptosi => LLVMBuildFPToSI(session.builder, native_value, native_type, c_data),
        CastOp.Uitofp => LLVMBuildUIToFP(session.builder, native_value, native_type, c_data),
        CastOp.Sitofp => LLVMBuildSIToFP(session.builder, native_value, native_type, c_data),
        CastOp.Ptrtoint => LLVMBuildPtrToInt(session.builder, native_value, native_type, c_data),
        CastOp.Inttoptr => LLVMBuildIntToPtr(session.builder, native_value, native_type, c_data),
        CastOp.Bitcast => LLVMBuildBitCast(session.builder, native_value, native_type, c_data),
    };
    return wrap_value(session, result);
}

ffi fn copy_llvm_message(message: cptr<c_char>) -> Vec<u8> {
    if message == @ffi_null<c_char>() {
        return Vec<u8>.new();
    }
    let (bytes, truncated) = copy_c_string(message, 1073741824u64);
    if truncated {
        @panic("LLVM diagnostic exceeds the copy limit");
    }
    return bytes;
}

pub(ffi) ffi fn verify_module(session: IrSession&) -> Result<bool, Vec<u8>> {
    checked_session(session);
    let message = @ffi_null<c_char>();
    let status = LLVMVerifyModule(session.module, c_int(2), @ffi_addr(&message));
    if status != c_int(0) {
        let error = copy_llvm_message(message);
        if message != @ffi_null<c_char>() {
            LLVMDisposeMessage(message);
        }
        return Result<bool, Vec<u8>>.Err(msg=error);
    }
    if message != @ffi_null<c_char>() {
        LLVMDisposeMessage(message);
    }
    return Result<bool, Vec<u8>>.Ok(val=true);
}

pub(ffi) ffi fn module_ir(session: IrSession&) -> Vec<u8> {
    checked_session(session);
    let message = LLVMPrintModuleToString(session.module);
    if message == @ffi_null<c_char>() {
        @panic("LLVM module printing failed");
    }
    defer LLVMDisposeMessage(message);
    return copy_llvm_message(message);
}

pub(ffi) ffi fn module_bitcode(session: IrSession&) -> Vec<u8> {
    checked_session(session);
    let buffer = LLVMWriteBitcodeToMemoryBuffer(session.module);
    if buffer == @ffi_null<LLVMOpaqueMemoryBuffer>() {
        @panic("LLVM bitcode emission failed");
    }
    defer LLVMDisposeMemoryBuffer(buffer);
    return copy_c_bytes(@ffi_ptr_cast<u8>(LLVMGetBufferStart(buffer)), u64(LLVMGetBufferSize(buffer)));
}

pub(ffi) ffi fn module_object(session: IrSession&) -> Result<Vec<u8>, Vec<u8>> {
    checked_session(session);
    if session.optimization_level != 0u8 {
        let pipeline = match session.optimization_level {
            1u8 => checked_c_string("default<O1>"),
            2u8 => checked_c_string("default<O2>"),
            _ => checked_c_string("default<O3>"),
        };
        defer pipeline.drop();
        let (pipeline_data, _) = @ffi_parts(pipeline.as_slice());
        let options = LLVMCreatePassBuilderOptions();
        if options == @ffi_null<LLVMOpaquePassBuilderOptions>() {
            @panic("LLVM pass builder creation failed");
        }
        defer LLVMDisposePassBuilderOptions(options);
        let error = LLVMRunPasses(session.module, @ffi_ptr_cast<c_char>(pipeline_data), session.target_machine, options);
        if error != @ffi_null<LLVMOpaqueError>() {
            let message = LLVMGetErrorMessage(error);
            let bytes = copy_llvm_message(message);
            if message != @ffi_null<c_char>() {
                LLVMDisposeErrorMessage(message);
            }
            return Result<Vec<u8>, Vec<u8>>.Err(msg=bytes);
        }
    }

    let verification = verify_module(session);
    match verification {
        Ok(_) => {},
        Err(message) => return Result<Vec<u8>, Vec<u8>>.Err(msg=message),
    }

    let output = @ffi_null<LLVMOpaqueMemoryBuffer>();
    let emit_message = @ffi_null<c_char>();
    let emit_status = LLVMTargetMachineEmitToMemoryBuffer(
        session.target_machine, session.module, c_int(1), @ffi_addr(&emit_message), @ffi_addr(&output)
    );
    if emit_status != c_int(0) {
        let error = copy_llvm_message(emit_message);
        if emit_message != @ffi_null<c_char>() {
            LLVMDisposeMessage(emit_message);
        }
        if output != @ffi_null<LLVMOpaqueMemoryBuffer>() {
            LLVMDisposeMemoryBuffer(output);
        }
        return Result<Vec<u8>, Vec<u8>>.Err(msg=error);
    }
    if emit_message != @ffi_null<c_char>() {
        LLVMDisposeMessage(emit_message);
    }
    if output == @ffi_null<LLVMOpaqueMemoryBuffer>() {
        @panic("LLVM object emission returned no buffer");
    }
    defer LLVMDisposeMemoryBuffer(output);
    let bytes = copy_c_bytes(@ffi_ptr_cast<u8>(LLVMGetBufferStart(output)), u64(LLVMGetBufferSize(output)));
    return Result<Vec<u8>, Vec<u8>>.Ok(val=bytes);
}
