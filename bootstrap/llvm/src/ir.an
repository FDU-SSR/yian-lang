pub(ffi) ffi fn build_binary(session: IrSession&, op: BinaryOp, left: IrValue, right: IrValue, name: str) -> IrValue {
    let native_left = checked_value(session, left);
    let native_right = checked_value(session, right);
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, _) = @ffi_parts(c_name.as_slice());
    let c_data = @ffi_ptr_cast<c_char>(data);
    let result = match op {
        BinaryOp.Add => LLVMBuildAdd(session.builder, native_left, native_right, c_data),
        BinaryOp.Sub => LLVMBuildSub(session.builder, native_left, native_right, c_data),
        BinaryOp.Mul => LLVMBuildMul(session.builder, native_left, native_right, c_data),
        BinaryOp.Udiv => LLVMBuildUDiv(session.builder, native_left, native_right, c_data),
        BinaryOp.Sdiv => LLVMBuildSDiv(session.builder, native_left, native_right, c_data),
        BinaryOp.Urem => LLVMBuildURem(session.builder, native_left, native_right, c_data),
        BinaryOp.Srem => LLVMBuildSRem(session.builder, native_left, native_right, c_data),
        BinaryOp.Fadd => LLVMBuildFAdd(session.builder, native_left, native_right, c_data),
        BinaryOp.Fsub => LLVMBuildFSub(session.builder, native_left, native_right, c_data),
        BinaryOp.Fmul => LLVMBuildFMul(session.builder, native_left, native_right, c_data),
        BinaryOp.Fdiv => LLVMBuildFDiv(session.builder, native_left, native_right, c_data),
        BinaryOp.Frem => LLVMBuildFRem(session.builder, native_left, native_right, c_data),
        BinaryOp.Shl => LLVMBuildShl(session.builder, native_left, native_right, c_data),
        BinaryOp.Lshr => LLVMBuildLShr(session.builder, native_left, native_right, c_data),
        BinaryOp.Ashr => LLVMBuildAShr(session.builder, native_left, native_right, c_data),
        BinaryOp.And => LLVMBuildAnd(session.builder, native_left, native_right, c_data),
        BinaryOp.Or => LLVMBuildOr(session.builder, native_left, native_right, c_data),
        BinaryOp.Xor => LLVMBuildXor(session.builder, native_left, native_right, c_data),
    };
    return wrap_value(session, result);
}

