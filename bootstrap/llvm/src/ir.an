pub(ffi) ffi fn build_phi(session: IrSession&, ty: IrType, name: str) -> IrValue {
    let native_type = checked_type(session, ty);
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, _) = @ffi_parts(c_name.as_slice());
    return wrap_value(session, LLVMBuildPhi(session.builder, native_type, @ffi_ptr_cast<c_char>(data)));
}

pub(ffi) ffi fn add_incoming(session: IrSession&, phi: IrValue, values: IrValue[], blocks: IrBlock[]) {
    let native_phi = checked_value(session, phi);
    if values.len() != blocks.len() {
        @panic("LLVM phi incoming counts differ");
    }
    let native_values = Vec<cptr<LLVMOpaqueValue>>.new();
    defer native_values.drop();
    let native_blocks = Vec<cptr<LLVMOpaqueBasicBlock>>.new();
    defer native_blocks.drop();
    let index: u64 = 0;
    while index < values.len() {
        native_values.push(checked_value(session, values[index]));
        native_blocks.push(checked_block(session, blocks[index]));
        index += 1;
    }
    let (value_data, length) = @ffi_parts(native_values.as_slice());
    let (block_data, _) = @ffi_parts(native_blocks.as_slice());
    LLVMAddIncoming(native_phi, value_data, block_data, checked_count(length));
}

pub(ffi) ffi fn build_call(session: IrSession&, signature: IrType, function: IrValue, args: IrValue[], name: str) -> IrValue {
    let native_signature = checked_type(session, signature);
    let native_function = checked_value(session, function);
    let native_args = Vec<cptr<LLVMOpaqueValue>>.new();
    defer native_args.drop();
    let index: u64 = 0;
    while index < args.len() {
        native_args.push(checked_value(session, args[index]));
        index += 1;
    }
    let (args_data, length) = @ffi_parts(native_args.as_slice());
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (name_data, _) = @ffi_parts(c_name.as_slice());
    return wrap_value(session, LLVMBuildCall2(session.builder, native_signature, native_function, args_data, checked_count(length), @ffi_ptr_cast<c_char>(name_data)));
}

