pub(ffi) ffi fn build_gep(session: IrSession&, ty: IrType, pointer: IrValue, indices: IrValue[], in_bounds: bool, name: str) -> IrValue {
    let native_type = checked_type(session, ty);
    let native_pointer = checked_value(session, pointer);
    let native_indices = Vec<cptr<LLVMOpaqueValue>>.new();
    defer native_indices.drop();
    let index: u64 = 0;
    while index < indices.len() {
        native_indices.push(checked_value(session, indices[index]));
        index += 1;
    }
    let (indices_data, length) = @ffi_parts(native_indices.as_slice());
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (name_data, _) = @ffi_parts(c_name.as_slice());
    let result = if in_bounds {
        LLVMBuildInBoundsGEP2(session.builder, native_type, native_pointer, indices_data, checked_count(length), @ffi_ptr_cast<c_char>(name_data))
    } else {
        LLVMBuildGEP2(session.builder, native_type, native_pointer, indices_data, checked_count(length), @ffi_ptr_cast<c_char>(name_data))
    };
    return wrap_value(session, result);
}

