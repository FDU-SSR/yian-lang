pub(ffi) ffi fn const_bytes(session: IrSession&, bytes: u8[], null_terminate: bool) -> IrValue {
    checked_session(session);
    let (data, length) = @ffi_parts(bytes);
    let c_length = c_size(length);
    if u64(c_length) != length {
        @panic("LLVM string length exceeds C size_t");
    }
    return wrap_value(session, LLVMConstStringInContext2(session.context, @ffi_ptr_cast<c_char>(data), c_length, c_bool(!null_terminate)));
}

