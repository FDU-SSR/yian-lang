ffi fn checked_c_string(value: str) -> Vec<u8> {
    return match c_string_bytes(value) {
        Ok(bytes) => bytes,
        Err(_) => @panic("LLVM name contains NUL"),
    };
}

ffi fn checked_count(length: u64) -> c_uint {
    let count = c_uint(length);
    if u64(count) != length {
        @panic("LLVM array length exceeds C unsigned");
    }
    return count;
}

ffi fn c_bool(value: bool) -> c_int {
    return if value { c_int(1) } else { c_int(0) };
}

ffi fn checked_session(session: IrSession&) {
    if session.module == @ffi_null<LLVMOpaqueModule>() {
        @panic("LLVM session is closed");
    }
}

ffi fn checked_type(session: IrSession&, ty: IrType) -> cptr<LLVMOpaqueType> {
    checked_session(session);
    if ty.owner != session.module {
        @panic("LLVM type belongs to another module");
    }
    return ty.native;
}

ffi fn checked_value(session: IrSession&, value: IrValue) -> cptr<LLVMOpaqueValue> {
    checked_session(session);
    if value.owner != session.module {
        @panic("LLVM value belongs to another module");
    }
    return value.native;
}

ffi fn checked_block(session: IrSession&, block: IrBlock) -> cptr<LLVMOpaqueBasicBlock> {
    checked_session(session);
    if block.owner != session.module {
        @panic("LLVM block belongs to another module");
    }
    return block.native;
}

ffi fn wrap_type(session: IrSession&, native: cptr<LLVMOpaqueType>) -> IrType {
    if native == @ffi_null<LLVMOpaqueType>() {
        @panic("LLVM returned a null type");
    }
    return IrType(native=native, owner=session.module);
}

ffi fn wrap_value(session: IrSession&, native: cptr<LLVMOpaqueValue>) -> IrValue {
    if native == @ffi_null<LLVMOpaqueValue>() {
        @panic("LLVM returned a null value");
    }
    return IrValue(native=native, owner=session.module);
}

pub(ffi) ffi fn new_session(name: str, optimization_level: u8) -> IrSession {
    if optimization_level > 3u8 {
        @panic("LLVM optimization level must be 0 through 3");
    }
    if YIANLLVMInitializeNativeTarget() != c_int(0) {
        @panic("LLVM native target is unavailable");
    }
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (name_data, _) = @ffi_parts(c_name.as_slice());
    let triple = LLVMGetDefaultTargetTriple();
    if triple == @ffi_null<c_char>() {
        @panic("LLVM host target triple is unavailable");
    }
    let target = @ffi_null<LLVMOpaqueTarget>();
    let target_message = @ffi_null<c_char>();
    let target_status = LLVMGetTargetFromTriple(triple, @ffi_addr(&target), @ffi_addr(&target_message));
    if target_message != @ffi_null<c_char>() {
        LLVMDisposeMessage(target_message);
    }
    if target_status != c_int(0) || target == @ffi_null<LLVMOpaqueTarget>() {
        LLVMDisposeMessage(triple);
        @panic("LLVM host target lookup failed");
    }
    let cpu = checked_c_string("generic");
    defer cpu.drop();
    let features = checked_c_string("");
    defer features.drop();
    let (cpu_data, _) = @ffi_parts(cpu.as_slice());
    let (features_data, _) = @ffi_parts(features.as_slice());
    // LLVM 22 的 LLVMCodeGenOptLevel、LLVMRelocPIC 和 LLVMCodeModelSmall 枚举值。
    let machine = LLVMCreateTargetMachine(
        target, triple, @ffi_ptr_cast<c_char>(cpu_data), @ffi_ptr_cast<c_char>(features_data),
        c_int(optimization_level), c_int(2), c_int(3)
    );
    if machine == @ffi_null<LLVMOpaqueTargetMachine>() {
        LLVMDisposeMessage(triple);
        @panic("LLVM target machine creation failed");
    }
    let layout = LLVMCreateTargetDataLayout(machine);
    if layout == @ffi_null<LLVMOpaqueTargetData>() {
        LLVMDisposeTargetMachine(machine);
        LLVMDisposeMessage(triple);
        @panic("LLVM target data layout creation failed");
    }
    let context = LLVMContextCreate();
    if context == @ffi_null<LLVMOpaqueContext>() {
        LLVMDisposeTargetData(layout);
        LLVMDisposeTargetMachine(machine);
        LLVMDisposeMessage(triple);
        @panic("LLVM context creation failed");
    }
    let module = LLVMModuleCreateWithNameInContext(@ffi_ptr_cast<c_char>(name_data), context);
    if module == @ffi_null<LLVMOpaqueModule>() {
        LLVMContextDispose(context);
        LLVMDisposeTargetData(layout);
        LLVMDisposeTargetMachine(machine);
        LLVMDisposeMessage(triple);
        @panic("LLVM module creation failed");
    }
    LLVMSetTarget(module, triple);
    LLVMSetModuleDataLayout(module, layout);
    let builder = LLVMCreateBuilderInContext(context);
    if builder == @ffi_null<LLVMOpaqueBuilder>() {
        LLVMDisposeModule(module);
        LLVMContextDispose(context);
        LLVMDisposeTargetData(layout);
        LLVMDisposeTargetMachine(machine);
        LLVMDisposeMessage(triple);
        @panic("LLVM builder creation failed");
    }
    return IrSession(
        context=context, module=module, builder=builder,
        target_machine=machine, target_layout=layout,
        target_triple=triple, optimization_level=optimization_level
    );
}

pub(ffi) ffi fn close_session(session: IrSession&) {
    checked_session(session);
    LLVMDisposeBuilder(session.builder);
    LLVMDisposeModule(session.module);
    LLVMContextDispose(session.context);
    LLVMDisposeTargetData(session.target_layout);
    LLVMDisposeTargetMachine(session.target_machine);
    LLVMDisposeMessage(session.target_triple);
    session.builder = @ffi_null<LLVMOpaqueBuilder>();
    session.module = @ffi_null<LLVMOpaqueModule>();
    session.context = @ffi_null<LLVMOpaqueContext>();
    session.target_machine = @ffi_null<LLVMOpaqueTargetMachine>();
    session.target_layout = @ffi_null<LLVMOpaqueTargetData>();
    session.target_triple = @ffi_null<c_char>();
}

pub(ffi) ffi fn abi_size_of(session: IrSession&, ty: IrType) -> u64 {
    let native_type = checked_type(session, ty);
    return LLVMABISizeOfType(session.target_layout, native_type);
}

pub(ffi) ffi fn abi_alignment_of(session: IrSession&, ty: IrType) -> u32 {
    let native_type = checked_type(session, ty);
    return u32(LLVMABIAlignmentOfType(session.target_layout, native_type));
}

pub(ffi) ffi fn void_type(session: IrSession&) -> IrType {
