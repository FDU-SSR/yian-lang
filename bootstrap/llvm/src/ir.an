from std.core.drop import Drop;
from std.core.result import Result;
from std.core.vec import Vec;
from std.ffi.c_string import c_string_bytes;
from ffi.bytes import copy_c_bytes, copy_c_string;
from llvm.raw_types import LLVMOpaqueContext, LLVMOpaqueModule, LLVMOpaqueBuilder;
from llvm.raw_types import LLVMOpaqueType, LLVMOpaqueValue, LLVMOpaqueBasicBlock;
from llvm.raw_types import LLVMOpaqueMemoryBuffer, LLVMOpaqueTarget, LLVMOpaqueTargetMachine;
from llvm.raw_types import LLVMOpaqueTargetData, LLVMOpaquePassBuilderOptions, LLVMOpaqueError;
from llvm.raw_types import LLVMOpaqueAttribute;
from llvm.target_raw import YIANLLVMInitializeNativeTarget, LLVMGetDefaultTargetTriple;
from llvm.target_raw import LLVMGetTargetFromTriple, LLVMCreateTargetMachine, LLVMDisposeTargetMachine;
from llvm.target_raw import LLVMCreateTargetDataLayout, LLVMSetModuleDataLayout, LLVMDisposeTargetData;
from llvm.target_raw import LLVMABISizeOfType, LLVMABIAlignmentOfType;
from llvm.target_raw import LLVMSetTarget, LLVMCreatePassBuilderOptions, LLVMDisposePassBuilderOptions;
from llvm.target_raw import LLVMRunPasses, LLVMGetErrorMessage, LLVMDisposeErrorMessage;
from llvm.target_raw import LLVMTargetMachineEmitToMemoryBuffer;

// 句柄只供受信 FFI 代码使用。复制句柄不复制 LLVM 资源；session 必须覆盖所有子句柄的使用期。
pub struct IrSession {
    context: cptr<LLVMOpaqueContext>,
    module: cptr<LLVMOpaqueModule>,
    builder: cptr<LLVMOpaqueBuilder>,
    target_machine: cptr<LLVMOpaqueTargetMachine>,
    target_layout: cptr<LLVMOpaqueTargetData>,
    target_triple: cptr<c_char>,
    optimization_level: u8,
}

pub struct IrType {
    native: cptr<LLVMOpaqueType>,
    owner: cptr<LLVMOpaqueModule>,
}

pub struct IrValue {
    native: cptr<LLVMOpaqueValue>,
    owner: cptr<LLVMOpaqueModule>,
}

pub struct IrBlock {
    native: cptr<LLVMOpaqueBasicBlock>,
    owner: cptr<LLVMOpaqueModule>,
}

pub enum IntCompare {
    Eq, Ne, Ugt, Uge, Ult, Ule, Sgt, Sge, Slt, Sle,
}

pub enum RealCompare {
    Oeq, Ogt, Oge, Olt, Ole, One, Ord, Uno,
}

pub enum BinaryOp {
    Add, Sub, Mul, Udiv, Sdiv, Urem, Srem,
    Fadd, Fsub, Fmul, Fdiv, Frem,
    Shl, Lshr, Ashr, And, Or, Xor,
}

pub enum CastOp {
    Trunc, Zext, Sext, Fptrunc, Fpext, Fptoui, Fptosi,
    Uitofp, Sitofp, Ptrtoint, Inttoptr, Bitcast,
}

