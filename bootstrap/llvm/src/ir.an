pub(ffi) ffi fn struct_type(session: IrSession&, fields: IrType[], packed: bool) -> IrType {
    checked_session(session);
    let native = Vec<cptr<LLVMOpaqueType>>.new();
    defer native.drop();
    let index: u64 = 0;
    while index < fields.len() {
        native.push(checked_type(session, fields[index]));
        index += 1;
    }
    let (data, length) = @ffi_parts(native.as_slice());
    return wrap_type(session, LLVMStructTypeInContext(session.context, data, checked_count(length), c_bool(packed)));
}

