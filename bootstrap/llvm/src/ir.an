}

pub(ffi) ffi fn int_type(session: IrSession&, bits: u32) -> IrType {
    checked_session(session);
    if bits == 0u32 {
        @panic("LLVM integer width must be positive");
    }
    return wrap_type(session, LLVMIntTypeInContext(session.context, c_uint(bits)));
}

pub(ffi) ffi fn float_type(session: IrSession&) -> IrType {
