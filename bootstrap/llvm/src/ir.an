pub(ffi) ffi fn append_block(session: IrSession&, function: IrValue, name: str) -> IrBlock {
    let native_function = checked_value(session, function);
    let c_name = checked_c_string(name);
    defer c_name.drop();
    let (data, _) = @ffi_parts(c_name.as_slice());
    let block = LLVMAppendBasicBlockInContext(session.context, native_function, @ffi_ptr_cast<c_char>(data));
    if block == @ffi_null<LLVMOpaqueBasicBlock>() {
        @panic("LLVM basic block creation failed");
    }
    return IrBlock(native=block, owner=session.module);
}

pub(ffi) ffi fn position_at_end(session: IrSession&, block: IrBlock) {
    LLVMPositionBuilderAtEnd(session.builder, checked_block(session, block));
}

pub(ffi) ffi fn add_global(session: IrSession&, name: str, ty: IrType) -> IrValue {
