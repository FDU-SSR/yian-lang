from yianc.codegen.llvm.module import FunctionLowering;
from yianc.codegen.cfg.ids import ValueId;
from yianc.codegen.cfg.model import IndexBounds;
from yianc.codegen.error import CodegenError;
from yianc.common.ids import TypeId;
from yianc.frontend.ast.operator import BinaryOperator;
from yianc.codegen.llvm.scalar import binary;
from llvm.ir import IrValue, BinaryOp, CastOp, IntCompare;
from std.core.option import Option;
from std.core.result import Result;

impl FunctionLowering {
    fn pointed_type(type_id: TypeId) -> Result<TypeId, CodegenError> {
        match self.owner.session.types.require(type_id)? {
            Pointer(inner) | Reference(inner) | CPointer(inner) => Result<TypeId, CodegenError>.Ok(*inner),
            _ => Result<TypeId, CodegenError>.Err(CodegenError.invalid("memory operation has no pointee")),
        }
    }

    pub fn pointer_offset(pointer: ValueId, index: ValueId, subtract: bool) -> Result<IrValue, CodegenError> {
        let type_id = self.cfg.value(pointer)?.type_id;
        let element = self.pointed_type(type_id)?;
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(self.owner.types.value_type(type_id)?));
        }
        let offset = self.get(index)?;
        if subtract { offset = self.builder.neg(offset, ""); }
        if self.fat(type_id)? {
            let value = self.get(pointer)?;
            let old_index = self.pointer_index(value);
            let next = self.builder.binary(BinaryOp.Add, old_index, offset, "");
            let valid = self.builder.binary(BinaryOp.And,
                self.builder.icmp(IntCompare.Uge, next, old_index, ""),
                self.builder.icmp(IntCompare.Ule, next, self.pointer_size(value), ""), "");
            self.checked(valid, "S004")?;
            return Result<IrValue, CodegenError>.Ok(self.builder.insert_value(value,
                self.builder.cast(CastOp.Trunc, next, self.owner.module.int_type(32u32), ""), 2u32, ""));
        }
        let indices = [offset];
        Result<IrValue, CodegenError>.Ok(self.builder.gep(self.owner.types.value_type(element)?,
            self.get(pointer)?, indices.as_slice(), false, ""))
    }

    pub fn pointer_difference(left: ValueId, right: ValueId) -> Result<IrValue, CodegenError> {
        let module = self.owner.module;
        let integer = module.int_type(64u32);
        let element = self.pointed_type(self.cfg.value(left)?.type_id)?;
        let size = module.abi_size(self.owner.types.value_type(element)?);
        if size == 0u64 { return Result<IrValue, CodegenError>.Ok(module.const_int(integer, 0u64)); }
        if self.fat(self.cfg.value(left)?.type_id)? {
            let first = self.get(left)?;
            let second = self.get(right)?;
            let same = self.builder.icmp(IntCompare.Eq, self.builder.extract_value(first, 0u32, ""), self.builder.extract_value(second, 0u32, ""), "");
            let lhs_index = self.pointer_index(first);
            let rhs_index = self.pointer_index(second);
            let valid = self.builder.binary(BinaryOp.And, same, self.builder.binary(BinaryOp.And,
                self.builder.icmp(IntCompare.Ule, lhs_index, self.pointer_size(first), ""),
                self.builder.icmp(IntCompare.Ule, rhs_index, self.pointer_size(second), ""), ""), "");
            self.checked(valid, "S005")?;
            return Result<IrValue, CodegenError>.Ok(self.builder.binary(BinaryOp.Sub, lhs_index, rhs_index, ""));
        }
        let lhs = self.builder.cast(CastOp.Ptrtoint, self.get(left)?, integer, "");
        let rhs = self.builder.cast(CastOp.Ptrtoint, self.get(right)?, integer, "");
        let bytes = self.builder.binary(BinaryOp.Sub, lhs, rhs, "");
        Result<IrValue, CodegenError>.Ok(self.builder.binary(BinaryOp.Sdiv, bytes, module.const_int(integer, size), ""))
    }

    pub fn index_address(type_id: TypeId, address: ValueId, element: TypeId, index: ValueId, bounds: IndexBounds&)
    -> Result<IrValue, CodegenError> {
        if self.owner.types.is_zst(type_id)? {
            return Result<IrValue, CodegenError>.Ok(self.owner.module.const_null(self.owner.types.value_type(type_id)?));
        }
        let source_type = self.cfg.value(address)?.type_id;
        let source = self.get(address)?;
        let result_pointer = match self.owner.session.types.require(type_id)? { Pointer(_) => true, _ => false, };
        if self.fat(source_type)? && result_pointer {
            let absolute = self.builder.binary(BinaryOp.Add, self.pointer_index(source), self.get(index)?, "");
            let valid = self.builder.binary(BinaryOp.And,
                self.builder.icmp(IntCompare.Uge, absolute, self.pointer_index(source), ""),
                self.builder.icmp(IntCompare.Ult, absolute, self.pointer_size(source), ""), "");
            self.checked(valid, "S002")?;
            return Result<IrValue, CodegenError>.Ok(self.builder.insert_value(source,
                self.builder.cast(CastOp.Trunc, absolute, self.owner.module.int_type(32u32), ""), 2u32, ""));
        }
        let indices = [self.get(index)?];
        let base = self.pointer_data(source_type, source)?;
        let pointer = self.builder.gep(self.owner.types.value_type(element)?, base, indices.as_slice(), false, "");
        self.make_pointer(type_id, pointer, self.pointer_word(source_type, source)?, self.integer(0u64), self.integer(1u64))
    }

    pub fn binary_value(op: BinaryOperator, left: ValueId, right: ValueId) -> Result<IrValue, CodegenError> {
        let type_id = self.cfg.value(left)?.type_id;
        if self.fat(type_id)? {
            let first = self.get(left)?;
            let second = self.get(right)?;
            let pointer = match self.owner.session.types.require(type_id)? { Pointer(_) => true, _ => false, };
            let equal = self.builder.icmp(IntCompare.Eq, self.builder.extract_value(first, 0u32, ""), self.builder.extract_value(second, 0u32, ""), "");
            if op == BinaryOperator.Eq || op == BinaryOperator.Neq {
                if pointer {
                    equal = self.builder.binary(BinaryOp.And, equal,
                        self.builder.icmp(IntCompare.Eq, self.pointer_index(first), self.pointer_index(second), ""), "");
                }
                return Result<IrValue, CodegenError>.Ok(if op == BinaryOperator.Neq { self.builder.not(equal, "") } else { equal });
            }
            self.checked(equal, "S005")?;
            let predicate = match op {
                Lt => IntCompare.Ult, Leq => IntCompare.Ule, Gt => IntCompare.Ugt, Geq => IntCompare.Uge,
                _ => return Result<IrValue, CodegenError>.Err(CodegenError.invalid("invalid pointer comparison")),
            };
            return Result<IrValue, CodegenError>.Ok(self.builder.icmp(predicate, self.pointer_index(first), self.pointer_index(second), ""));
        }
        binary(&self.builder, self.owner.types, self.owner.module, op, type_id,
            self.cfg.value(right)?.type_id, self.get(left)?, self.get(right)?)
    }

    pub fn array_repeat(result: ValueId, element: ValueId, count: u64) -> Result<IrValue, CodegenError> {
        let module = self.owner.module;
        let type_id = self.cfg.value(result)?.type_id;
        let native = self.owner.types.value_type(type_id)?;
        if self.owner.types.is_zst(type_id)? { return Result<IrValue, CodegenError>.Ok(module.const_null(native)); }
        let slot = **self.array_slots.get(&result).unwrap();
        let integer = module.int_type(64u32);
        let origin = self.builder.insertion_block();
        let header = self.function.append_block("");
        let body = self.function.append_block("");
        let done = self.function.append_block("");
        self.builder.br(header);
        self.builder.position_at_end(header);
        let index = self.builder.phi(integer, "");
        let condition = self.builder.icmp(IntCompare.Ult, index, module.const_int(integer, count), "");
        self.builder.cond_br(condition, body, done);
        self.builder.position_at_end(body);
        let indices = [index];
        let pointer = self.builder.gep(self.owner.types.value_type(self.cfg.value(element)?.type_id)?, slot, indices.as_slice(), false, "");
        self.builder.store(self.get(element)?, pointer);
        let next = self.builder.binary(BinaryOp.Add, index, module.const_int(integer, 1u64), "");
        self.builder.br(header);
        let values = [module.const_int(integer, 0u64), next];
        let blocks = [origin, body];
        self.builder.add_incoming(index, values.as_slice(), blocks.as_slice());
        self.builder.position_at_end(done);
        Result<IrValue, CodegenError>.Ok(self.builder.load(native, slot, ""))
    }

    pub fn fill(destination: ValueId, element: ValueId, count: ValueId) -> Result<(), CodegenError> {
        let module = self.owner.module;
        let integer = module.int_type(64u32);
        let origin = self.builder.insertion_block();
        let header = self.function.append_block("");
        let body = self.function.append_block("");
        let done = self.function.append_block("");
        self.builder.br(header);
        self.builder.position_at_end(header);
        let index = self.builder.phi(integer, "");
        let condition = self.builder.icmp(IntCompare.Ult, index, self.get(count)?, "");
        self.builder.cond_br(condition, body, done);
        self.builder.position_at_end(body);
        let indices = [index];
        let destination_type = self.cfg.value(destination)?.type_id;
        let base = self.pointer_data(destination_type, self.get(destination)?)?;
        let pointer = self.builder.gep(self.owner.types.value_type(self.cfg.value(element)?.type_id)?,
            base, indices.as_slice(), false, "");
        self.builder.store(self.get(element)?, pointer);
        let next = self.builder.binary(BinaryOp.Add, index, module.const_int(integer, 1u64), "");
        self.builder.br(header);
        let values = [module.const_int(integer, 0u64), next];
        let blocks = [origin, body];
        self.builder.add_incoming(index, values.as_slice(), blocks.as_slice());
        self.builder.position_at_end(done);
        Result<(), CodegenError>.Ok(())
    }
}
