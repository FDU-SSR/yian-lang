from yianc.analysis.constant.integer import magnitude, is_negative, normalized;
from yianc.analysis.constant.value import IntegerValue, IntegerWidth, ConstEvalError;
from yianc.frontend.ast.operator import BinaryOperator;
from std.core.result import Result;
from std.num.f64 import from_bits, to_bits;

// Classify bit patterns directly; float comparisons use ordered predicates.
pub fn is_nan(value: f64) -> bool {
    let magnitude_mask = 0x7FFFFFFFFFFFFFFFu64;
    let infinity_bits = 0x7FF0000000000000u64;
    (to_bits(value) & magnitude_mask) > infinity_bits
}

pub fn is_infinite(value: f64) -> bool {
    let magnitude_mask = 0x7FFFFFFFFFFFFFFFu64;
    let infinity_bits = 0x7FF0000000000000u64;
    (to_bits(value) & magnitude_mask) == infinity_bits
}

fn signed_inf(negative: bool) -> f64 {
    let infinity_bits = 0x7FF0000000000000u64;
    let sign_bit = 0x8000000000000000u64;
    from_bits(infinity_bits | if negative {
            sign_bit
        } else {
            0u64
        })
}

fn quiet_nan() -> f64 {
    from_bits(0x7FF8000000000000u64)
}

// Rounding uses the discarded suffix, including the halfway ties-to-even case.
fn round_shift(value: u64, shift: u32) -> u64 {
    if shift == 0 {
        return value;
    }

    if shift > 63 {
        return 0;
    }

    let quotient = value >> shift;
    let remainder = value & ((1u64 << shift) - 1);
    let half = 1u64 << (shift - 1);
    quotient + if remainder > half || (remainder == half && (quotient & 1) != 0) { 1u64 } else { 0u64 }
}

pub fn round_float(value: f64, width: u32) -> f64 {
    if width == 64 {
        return value;
    }

    if width == 32 {
        return f64(f32(value));
    }

    if width != 16 {
        @panic("E599: unsupported floating-point width");
    }

    round_half(value)
}

// Binary16 conversion avoids an intermediate binary32 rounding step.
fn round_half(value: f64) -> f64 {
    let fraction_bits = 52u32;
    let exponent_mask = 0x7FFu64;
    let fraction_mask = 0x000FFFFFFFFFFFFFu64;
    let sign_mask = 0x8000000000000000u64;
    let exponent_bias = 1023i32;
    let half_max_exponent = 15i32;
    let half_min_normal_exponent = -14i32;
    let half_min_rounding_exponent = -25i32;
    let bits = to_bits(value);
    let negative = (bits & sign_mask) != 0;
    let exponent = u32((bits >> fraction_bits) & exponent_mask);

    if exponent == u32(exponent_mask) {
        return value;
    }

    let signed_zero = from_bits(bits & sign_mask);

    if exponent == 0 {
        return signed_zero;
    }

    let power = i32(exponent) - exponent_bias;

    if power > half_max_exponent {
        return signed_inf(negative);
    }

    if power < half_min_rounding_exponent {
        return signed_zero;
    }

    let significand = (1u64 << fraction_bits) | (bits & fraction_mask);
    let result = if power < half_min_normal_exponent {
        half_subnormal(significand, power)
    } else {
        half_normal(significand, power)
    };

    if negative {
        -result
    } else {
        result
    }
}

fn half_subnormal(significand: u64, power: i32) -> f64 {
    // Subnormals are integer multiples of 2^-24; 52 - 24 determines the shift.
    let binary64_fraction_bits = 52i32;
    let subnormal_scale_bits = 24i32;
    let unit = 0.000000059604644775390625f64;
    let rounded = round_shift(significand, u32(binary64_fraction_bits - subnormal_scale_bits - power));
    f64(rounded) * unit
}

fn half_normal(significand: u64, power: i32) -> f64 {
    let discarded_bits = 42u32;
    let hidden_bit = 1024u64;
    let carry_bit = hidden_bit * 2;
    let rounded = round_shift(significand, discarded_bits);

    if rounded == carry_bit {
        rounded = hidden_bit;
        power += 1;
    }

    if power > 15 {
        return signed_inf(false);
    }

    let exponent_bias = 1023i32;
    let fraction_bits = 52u32;
    let scale = from_bits(u64(power + exponent_bias) << fraction_bits);
    (f64(rounded) / f64(hidden_bit)) * scale
}

fn divide(left: f64, right: f64) -> f64 {
    if is_nan(left) || is_nan(right) {
        return quiet_nan();
    }

    if right != 0.0 {
        return left / right;
    }

    if left == 0.0 {
        return quiet_nan();
    }

    let sign_mask = 0x8000000000000000u64;
    signed_inf(((to_bits(left) ^ to_bits(right)) & sign_mask) != 0)
}

fn remainder(left: f64, right: f64) -> f64 {
    if is_nan(left) || is_nan(right) || right == 0.0 || is_infinite(left) {
        return quiet_nan();
    }

    if is_infinite(right) {
        return left;
    }

    left % right
}

pub fn float_binary(op: BinaryOperator, left: f64, right: f64, width: u32) -> Result<f64, ConstEvalError> {
    let result = match op {
        Add => left + right,
        Sub => left - right,
        Mul => left * right,
        Div => divide(left, right),
        Mod => remainder(left, right),
        _ => return Result<f64, ConstEvalError>.Err(ConstEvalError.InvalidOperator),
    };

    Result<f64, ConstEvalError>.Ok(round_float(result, width))
}

pub fn integer_float(value: IntegerValue) -> f64 {
    let result = f64(magnitude(value));

    if is_negative(value) {
        -result
    } else {
        result
    }
}

pub fn float_integer(value: f64, width: IntegerWidth, signed: bool) -> Result<IntegerValue, ConstEvalError> {
    if is_nan(value) || is_infinite(value) {
        return Result<IntegerValue, ConstEvalError>.Err(ConstEvalError.InvalidCast);
    }

    let fraction_bits = 52u32;
    let fraction_mask = 0x000FFFFFFFFFFFFFu64;
    let exponent_mask = 0x7FFu64;
    let sign_mask = 0x8000000000000000u64;
    let exponent_bias = 1023i32;
    let bits = to_bits(value);
    let power = i32((bits >> fraction_bits) & exponent_mask) - exponent_bias;

    if power < 0 {
        return Result<IntegerValue, ConstEvalError>.Ok(normalized(0, width, signed));
    }

    // Truncation followed by fixed-width normalization uses only the low integer bits.
    // Decomposing binary64 avoids undefined host conversion for large finite values.
    let significand = (1u64 << fraction_bits) | (bits & fraction_mask);
    let integer = if power < i32(fraction_bits) {
        significand >> u32(i32(fraction_bits) - power)
    } else {
        let shift = u32(power - i32(fraction_bits));
        if shift >= width.bits() {
            0u64
        } else {
            significand << shift
        }
    };

    Result<IntegerValue, ConstEvalError>.Ok(normalized(if (bits & sign_mask) != 0 {
            0u64 - integer
        } else {
            integer
        }, width, signed))
}
