from yianc.common.ids import NameId, SymbolId, ScopeId, SourceId;
from yianc.common.location import SourceSpan;
from yianc.analysis.symbol.model import Symbol, SymbolKind;
from std.collections.hash_set import HashSet;
from yianc.diagnostics.model import AnalysisError;
from std.collections.arena import Arena;
from std.collections.hash_map import HashMap;
from std.core.clone import Clone;
from std.core.drop import Drop;
from std.core.iter import Iterator, IntoIterator;
from std.core.ops import Index;
from std.core.option import Option;
from std.core.result import Result;
from std.core.vec import Vec;

pub struct Scope {
    parent: Option<ScopeId>,
    names: HashMap<NameId, SymbolId>,
    ordered_names: Vec<NameId>,
    unavailable: HashMap<NameId, SourceSpan>,
}

impl Scope {
    static fn new(parent: Option<ScopeId>) -> Self {
        Self(parent, HashMap<NameId, SymbolId>.new(), Vec<NameId>.new(), HashMap<NameId, SourceSpan>.new())
    }

    pub fn get(name: NameId) -> Option<SymbolId> {
        match self.names.get(&name) {
            Some(id) => Option<SymbolId>.Some(*id),
            None => Option<SymbolId>.None
        }
    }

    fn bind(name: NameId, symbol: SymbolId) -> bool {
        if self.names.contains(&name) {
            return false;
        }

        self.names.insert(name, symbol);
        self.ordered_names.push(name);
        true
    }

    fn snapshot() -> Self {
        Self(self.parent, self.names.clone(), self.ordered_names.clone(), self.unavailable.clone())
    }
}

impl Drop for Scope {
    pub fn drop() {
        self.names.drop();
        self.ordered_names.drop();
        self.unavailable.drop();
    }
}

pub struct VisibleSymbol {
    pub id: SymbolId,
    pub is_local: bool,
}

pub struct SymbolStore {
    symbols: Arena<Symbol>,
    scopes: Arena<Scope>
}

impl SymbolStore {
    static pub fn new() -> Self {
        Self(Arena<Symbol>.new(), Arena<Scope>.new())
    }

    pub fn add(symbol: Symbol) -> SymbolId {
        let id = SymbolId(self.symbols.len());
        self.symbols.alloc(symbol);
        id
    }

    pub fn get(id: SymbolId) -> Option<Symbol&> {
        self.symbols.get(id.index)
    }

    pub fn symbol_count() -> u64 { self.symbols.len() }

    pub fn symbol_at(index: u64) -> Option<Symbol&> { self.symbols.get(index) }

    fn add_scope(scope: Scope) -> ScopeId {
        let id = ScopeId(self.scopes.len());
        self.scopes.alloc(scope);
        id
    }

    pub fn scope(id: ScopeId) -> Option<Scope&> {
        self.scopes.get(id.index)
    }

    // Checkpoints own only maps; symbols and their identities stay session-owned.
    pub fn checkpoint(id: ScopeId) -> Result<Scope, AnalysisError> {
        match self.scope(id) {
            Some(scope) => Result<Scope, AnalysisError>.Ok(scope.snapshot()),
            None => Result<Scope, AnalysisError>.Err(AnalysisError.internal("invalid scope checkpoint")),
        }
    }

    pub fn restore(id: ScopeId, checkpoint: Scope) {
        let scope = *self.scope(id).unwrap();
        scope.drop();
        *scope = checkpoint;
    }

    pub fn block_unavailable(id: ScopeId, name: NameId, span: SourceSpan) {
        self.scope(id).unwrap().unavailable.insert(name, span);
    }

    // Parents must already exist, so append-only creation cannot introduce cycles.
    pub fn create_scope(parent: Option<ScopeId>) -> Result<ScopeId, AnalysisError> {
        match parent {
            Some(id) => {
                if self.scope(id).is_none() {
                    return Result<ScopeId, AnalysisError>.Err(AnalysisError.internal("invalid parent scope"));
                }
            },
            None => {},
        }

        Result<ScopeId, AnalysisError>.Ok(self.add_scope(Scope.new(parent)))
    }

    pub fn bind(scope: ScopeId, name: NameId, symbol: SymbolId) -> Result<bool, AnalysisError> {
        if self.get(symbol).is_none() {
            return Result<bool, AnalysisError>.Err(AnalysisError.internal("invalid symbol ID"));
        }

        match self.scope(scope) {
            Some(target) => Result<bool, AnalysisError>.Ok(target.bind(name, symbol)),
            None => Result<bool, AnalysisError>.Err(AnalysisError.internal("invalid scope ID")),
        }
    }

    pub fn lookup(scope: ScopeId, name: NameId) -> Option<SymbolId> {
        let current = Option<ScopeId>.Some(scope);

        while current.is_some() {
            let id = *current.unwrap();

            if id.index >= self.scopes.len() {
                return Option<SymbolId>.None;
            }

            let found = (*self.scopes.get(id.index).unwrap()).get(name);
            if self.scopes.get(id.index).unwrap().unavailable.contains(&name) { return Option<SymbolId>.None; }

            if found.is_some() {
                return found;
            }

            current = (*self.scopes.get(id.index).unwrap()).parent;
        }

        Option<SymbolId>.None
    }

    // Return only the innermost visible binding for each name at the cursor.
    pub fn visible_symbols_with_metadata_at(scope: ScopeId, source: SourceId, row: u64, column: u64)
    -> Result<Vec<VisibleSymbol>, AnalysisError> {
        let locals = Vec<VisibleSymbol>.new();
        let globals = Vec<VisibleSymbol>.new();
        let names = HashSet<NameId>.new();
        defer names.drop();
        let current = Option<ScopeId>.Some(scope);
        let visited_scopes = 0u64;

        while current.is_some() {
            let id = *current.unwrap();
            if id.index >= self.scopes.len() || visited_scopes >= self.scopes.len() {
                locals.drop();
                globals.drop();
                return Result<Vec<VisibleSymbol>, AnalysisError>.Err(AnalysisError.internal("invalid scope chain"));
            }
            visited_scopes += 1u64;
            let record = *self.scopes.get(id.index).unwrap();

            for entry in record.unavailable.entries() {
                let location = entry[1];
                if location.source == source && (location.span.start.row < row ||
                    (location.span.start.row == row && location.span.start.column <= column)) {
                    names.insert(*entry[0]);
                }
            }

            for name in record.ordered_names {
                let symbol_id = match record.get(*name) {
                    Some(value) => value,
                    None => continue,
                };
                let symbol = match self.get(symbol_id) {
                    Some(value) => value,
                    None => continue,
                };
                let local_value = record.parent.is_some() &&
                (symbol.kind == SymbolKind.Variable || symbol.kind == SymbolKind.Parameter);
                if record.parent.is_some() && !local_value && symbol.kind != SymbolKind.Type {
                    continue;
                }
                let declared = if local_value {
                    match &symbol.span {
                        Some(location) => location.source == source && (
                            location.span.start.row < row ||
                            (location.span.start.row == row && location.span.start.column <= column)),
                        None => true,
                    }
                } else {
                    true
                };
                if !declared || names.contains(name) {
                    continue;
                }

                names.insert(*name);
                let candidate = VisibleSymbol(id=symbol_id, is_local=local_value);
                if local_value {
                    let location = match &symbol.span {
                        Some(value) if value.source == source => value,
                        None => {
                            locals.push(candidate);
                            continue;
                        },
                        _ => { globals.push(candidate); continue; },
                    };
                    let insert_at = locals.len();
                    let index = 0u64;
                    while index < locals.len() {
                        let existing = match self.get(locals[index].id) {
                            Some(value) => value,
                            None => { index += 1u64; continue; },
                        };
                        let existing_location = match &existing.span {
                            Some(value) if value.source == source => value,
                            _ => { index += 1u64; continue; },
                        };
                        if existing_location.span.start.row > location.span.start.row ||
                        (existing_location.span.start.row == location.span.start.row &&
                            existing_location.span.start.column > location.span.start.column) {
                            insert_at = index;
                            break;
                        }
                        index += 1u64;
                    }
                    locals.insert(insert_at, candidate);
                } else {
                    globals.push(candidate);
                }
            }

            current = record.parent;
        }

        locals.extend(&globals);
        globals.drop();
        Result<Vec<VisibleSymbol>, AnalysisError>.Ok(locals)
    }

    // Preserve the identity-only query surface for existing compiler callers.
    pub fn visible_symbols_at(scope: ScopeId, source: SourceId, row: u64, column: u64)
    -> Result<Vec<SymbolId>, AnalysisError> {
        let visible = self.visible_symbols_with_metadata_at(scope, source, row, column)?;
        defer visible.drop();
        let result = Vec<SymbolId>.with_capacity(visible.len());
        for candidate in visible { result.push(candidate.id); }
        Result<Vec<SymbolId>, AnalysisError>.Ok(result)
    }

    // A closure shares lexical type identities without granting access to uncaptured variables.
    pub fn inherit_types(target: ScopeId, source: ScopeId) -> Result<(), AnalysisError> {
        let seen = HashSet<NameId>.new();
        defer seen.drop();
        let current = Option<ScopeId>.Some(source);

        while current.is_some() {
            let scope = *self.scope(*current.unwrap()).unwrap();

            for name in scope.ordered_names {
                if seen.contains(name) {
                    continue;
                }

                seen.insert(*name);
                let symbol_id = scope.get(*name).unwrap();
                let symbol = *self.get(*symbol_id).unwrap();

                if symbol.kind == SymbolKind.Type || symbol.kind == SymbolKind.Alias {
                    self.bind(target, *name, *symbol_id)?;
                }
            }

            current = scope.parent;
        }

        Result<(), AnalysisError>.Ok(())
    }

    // Copy the complete parent chain so mutations in either branch stay isolated.
    pub fn snapshot(scope: ScopeId) -> Result<ScopeId, AnalysisError> {
        let chain = Vec<ScopeId>.new();
        defer chain.drop();
        let current = Option<ScopeId>.Some(scope);

        while current.is_some() {
            let id = *current.unwrap();

            if id.index >= self.scopes.len() {
                return Result<ScopeId, AnalysisError>.Err(AnalysisError.internal("invalid scope ID"));
            }

            if chain.len() >= self.scopes.len() {
                return Result<ScopeId, AnalysisError>.Err(AnalysisError.internal("cyclic scope chain"));
            }

            chain.push(id);
            current = (*self.scopes.get(id.index).unwrap()).parent;
        }

        // Clone from the root down; the copied chain never references old scopes.
        let parent = Option<ScopeId>.None;
        let remaining = chain.len();

        while remaining > 0 {
            remaining -= 1;
            let copy = (*self.scopes.get(chain[remaining].index).unwrap()).snapshot();
            copy.parent = parent;
            parent = Option<ScopeId>.Some(self.add_scope(copy));
        }

        Result<ScopeId, AnalysisError>.Ok(*parent.unwrap())
    }
}

impl Drop for SymbolStore {
    pub fn drop() {
        for scope in self.scopes {
            scope.drop();
        }

        self.scopes.drop();
        self.symbols.drop();
    }
}
