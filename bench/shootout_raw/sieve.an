// bench/shootout_raw/sieve.an — 埃拉托斯特尼筛法 (shootout sieve)
// raw 适配套件: T*→T[] 用 from_raw_parts(裸模式下隐式 coerce 被拒, expr_checker.py L351-355)
// tiered-pointers t6 标注: sieve 的 flags 参数改 bool[]; main 局部 flags
//   保持 bool* (del 仅 T* 合法), 调用侧经 from_raw_parts 视图传递。
//
// 语义权威源: bak/old_exp/performance/c/sieve.c (C 版)
// 规模参数取自原 .an (bak/old_exp/performance/an/sieve.an):
//   原规模 SIEVE_SIZE=2000000 × 5000 次迭代。
//   规模调整: 实测全胖模式 2M×5000 远超 60s, 折中为
//   SIEVE_SIZE=2000000 × ITER=500 次迭代 (三态同源码, 不影响归因;
//   每趟仍完整覆盖 2M 位数组, 断言 prime_count==148933 与原版一致)。
//
// 算法: 每趟将 flags[0..SIEVE_SIZE-1] 全置 true (i 表示数 i+1),
//        sieve() 从 i=2 起标记合数, 统计素数个数。
//
// 编译: python3 -m compiler.main -O2 lib bench/shootout_raw/sieve.an -o build/shootout_check/sieve
// 预期: exit 0 (断言全过)

from std.core.io import print;
from std.core.slice import from_raw_parts;

fn sieve(flags: bool[], size: u64) -> i32 {
    let prime_count: i32 = 0;
    let i: u64 = 2;
    while i < size {
        if flags[i - 1] {
            prime_count += 1;
            let k: u64 = i + i;
            while k <= size {
                flags[k - 1] = false;
                k += i;
            }
        }
        i += 1;
    }
    return prime_count;
}

fn main() {
    let SIEVE_SIZE: u64 = 2000000;
    let ITER: u64 = 500;
    let flags: bool* = dyn[SIEVE_SIZE] bool;
    let iter: u64 = 0;
    while iter < ITER {
        let i: u64 = 0;
        while i < SIEVE_SIZE {
            flags[i] = true;
            i += 1;
        }
        let prime_count: i32 = sieve(from_raw_parts(flags, SIEVE_SIZE), SIEVE_SIZE);
        assert prime_count == 148933: "sieve: prime_count is not correct";
        iter += 1;
    }
    del flags;
    print("sieve pass\n");
}
