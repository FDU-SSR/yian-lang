// bench/shootout_raw/list.an — 链表 tail 递归归约 (shootout list)
// raw 适配套件: T*→T[] 用 from_raw_parts(裸模式下隐式 coerce 被拒, expr_checker.py L351-355)
//
// 语义权威源: bak/old_exp/performance/c/list.c (C 版)
// 规模参数取自原 .an (bak/old_exp/performance/an/list.an):
//   原规模 make_list 45/30/20, 断言 tail 结果长度 == 30。
//   (规模未调整; 与 C 版语义一致。)
//
// 算法: 单链表 (val + next 指针)。Element_make_list 递归建表 (长度
//       递减, val=length), tail(x,y,z) 三链表归约: 当 y 比 x 短时
//       同时前移三者指针后对 (next_x,y,z)/(next_y,z,x)/(next_z,x,y)
//       递归嵌套, 否则返回 z。最终 tail 结果指向原 z 表的中段, 断言
//       其长度 == 30。free_list 释放整条链 (含头节点)。
//
// tiered-pointers t6 标注: tail 递归热路径 x/y/z 为可空链表指针
//   (is_shorter_than/递归前移均需 != nullptr 判断), T& 不支持 nullptr
//   比较, 保持 Element*。Element_length_method 的 self 改为 Element&
//   (入参非空, 单元素解引用; 内部 current 保持 Element* 需 del)。
//   Element_free_method/free_list 需要 del, 保持 Element*。
//
// 编译: python3 -m compiler.main -O2 lib bench/shootout_raw/list.an -o build/shootout_check/list
// 预期: exit 0 (断言全过)

from std.core.io import print;

struct Element {
    val: i32,
    next: Element*,
}

fn Element_make_list(length: i32) -> Element* {
    if length == 0 {
        return nullptr;
    }
    let rest_of_list: Element* = Element_make_list(length - 1);
    let e: Element* = dyn Element(length, rest_of_list);
    return e;
}

fn Element_length_method(self: Element&) -> i32 {
    let len: i32 = 1;
    let current: Element* = self.next;
    while current != nullptr {
        len += 1;
        current = current.next;
    }
    return len;
}

fn Element_free_method(self: Element*) {
    let current: Element* = self.next;
    while current != nullptr {
        let next: Element* = current.next;
        del current;
        current = next;
    }
}

fn Element_length(e: Element*) -> i32 {
    if e == nullptr {
        return 0;
    }
    let sv: Element& = e;
    return Element_length_method(sv);
}

fn is_shorter_than(x: Element*, y: Element*) -> bool {
    let x_tail: Element* = x;
    let y_tail: Element* = y;
    while y_tail != nullptr {
        if x_tail == nullptr {
            return true;
        }
        x_tail = x_tail.next;
        y_tail = y_tail.next;
    }
    return false;
}

fn tail(x: Element*, y: Element*, z: Element*) -> Element* {
    if is_shorter_than(y, x) {
        let next_x: Element* = nullptr;
        if x != nullptr {
            next_x = x.next;
        }
        let next_y: Element* = nullptr;
        if y != nullptr {
            next_y = y.next;
        }
        let next_z: Element* = nullptr;
        if z != nullptr {
            next_z = z.next;
        }
        return tail(
            tail(next_x, y, z),
            tail(next_y, z, x),
            tail(next_z, x, y)
        );
    }
    return z;
}

fn free_list(e: Element*) {
    if e == nullptr {
        return;
    }
    Element_free_method(e);
    del e;
}

fn benchmark_list() -> i32 {
    let x: Element* = Element_make_list(45);
    let y: Element* = Element_make_list(30);
    let z: Element* = Element_make_list(20);

    let result: Element* = tail(x, y, z);
    let l: i32 = Element_length(result);

    free_list(x);
    free_list(y);
    free_list(z);

    return l;
}

fn main() {
    let result: i32 = benchmark_list();
    assert result == 30: "list: tail result length should be 30";
    print("list pass\n");
}
