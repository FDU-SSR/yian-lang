// bench/shootout_raw/list.an — 链表 tail 递归归约 (shootout list)
// raw 适配套件: T*→T[] 用 from_raw_parts(裸模式下隐式 coerce 被拒, expr_checker.py L351-355)
//
// 语义权威源: bak/old_exp/performance/c/list.c (C 版)
// 规模参数取自原 .an (bak/old_exp/performance/an/list.an):
//   原规模 make_list 45/30/20, 断言 tail 结果长度 == 30。
//   (规模未调整; 与 C 版语义一致。)
//
// 算法: 单链表 (val + next 指针)。Element_make_list 递归建表 (长度
//       递减, val=length), tail(x,y,z) 三链表归约: 当 y 比 x 短时
//       同时前移三者指针后对 (next_x,y,z)/(next_y,z,x)/(next_z,x,y)
//       递归嵌套, 否则返回 z。最终 tail 结果指向原 z 表的中段, 断言
//       其长度 == 30。free_list 释放整条链 (含头节点)。
//
// Option<T&> 迁移 (2026-08, 与 shootout 版同步): next 字段改为
// Option<Element&> (raw 下 T& 退化为裸 8B, Option<T&> 为 8B); 遍历位置
// 一律用 match 解包读取 (match 风格, 2026-08; towers 同款)。match
// Some(e) 对 Option<T&> 绑定 e 为 T& → 读路径局部一律 Element& (字段
// 访问经 T& 自动解引用, 零 bitcast); 节点本体直接 dyn Element(...) 绑
// T& (let T& = dyn 直连, 2026-08; binarytree 同款直连先例)。
// del 直接作用于 match 所得 T& (del-view: del T& 合法, 零 bitcast;
// raw 下同样成立; T&→T* 无隐式折算, 故释放形参保持 T&)。
//
// 赋值回归 (2026-08): 赋值/传参按位复制, Option<Element&> 直接传递,
//       不再需要 clone/move 调用。
//
// 编译: python3 -m compiler.main -O2 lib bench/shootout_raw/list.an -o build/shootout_check/list
// 预期: exit 0 (断言全过)

from std.core.io import print;

struct Element {
    val: i32,
    next: Option<Element&>,
}

// 非破坏性复制 Option<Element&>(按位复制下 Option 值可直接传递,
// 此辅助保留以最小化 diff; 经 match 解包重建与直接赋值等价)
fn opt_copy(src: Option<Element&>*) -> Option<Element&> {
    return match (*src) {
        Some(e) => Option<Element&>.Some(e),
        None => Option<Element&>.None,
    };
}

// 取节点 opt 的 next(空/链尾 → None)
fn opt_next(src: Option<Element&>*) -> Option<Element&> {
    return match (*src) {
        None => Option<Element&>.None,
        Some(n) => {
            match n.next {
                Some(nn) => Option<Element&>.Some(nn),
                None => Option<Element&>.None,
            }
        }
    };
}

fn Element_make_list(length: i32) -> Option<Element&> {
    if length == 0 {
        return Option<Element&>.None;
    }
    let rest_of_list: Option<Element&> = Element_make_list(length - 1);
    return Option<Element&>.Some(dyn Element(length, rest_of_list));
}

fn Element_length_method(self: Element&) -> i32 {
    let len: i32 = 1;
    let current: Option<Element&> = match self.next {
        Some(n) => Option<Element&>.Some(n),
        None => Option<Element&>.None,
    };
    loop {
        match current {
            None => { break; },
            Some(cn) => {
                len = len + 1;
                current = match cn.next {
                    Some(n) => Option<Element&>.Some(n),
                    None => Option<Element&>.None,
                };
            }
        }
    };
    return len;
}

fn Element_free_method(self: Element&) {
    let current: Option<Element&> = match self.next {
        Some(n) => Option<Element&>.Some(n),
        None => Option<Element&>.None,
    };
    loop {
        match current {
            None => { break; },
            Some(cn) => {
                let next: Option<Element&> = match cn.next {
                    Some(n) => Option<Element&>.Some(n),
                    None => Option<Element&>.None,
                };
                // 先读 next 再释放 cn (无 UAF: next 已取, cn 释放后不再读)
                del cn;
                current = next;
            }
        }
    };
}

fn Element_length(e: Option<Element&>*) -> i32 {
    return match (*e) {
        None => 0,
        Some(sv) => Element_length_method(sv),
    };
}

fn is_shorter_than(x: Option<Element&>*, y: Option<Element&>*) -> bool {
    let x_tail: Option<Element&> = opt_copy(x);
    let y_tail: Option<Element&> = opt_copy(y);
    loop {
        match y_tail {
            None => { break; },
            Some(yn) => {
                match x_tail {
                    None => { return true; },
                    Some(xn) => {
                        x_tail = match xn.next {
                            Some(n) => Option<Element&>.Some(n),
                            None => Option<Element&>.None,
                        };
                        y_tail = match yn.next {
                            Some(n) => Option<Element&>.Some(n),
                            None => Option<Element&>.None,
                        };
                    }
                }
            }
        }
    }
    return false;
}

fn tail(x: Option<Element&>, y: Option<Element&>, z: Option<Element&>) -> Option<Element&> {
    if is_shorter_than(&y, &x) {
        let next_x: Option<Element&> = opt_next(&x);
        let next_y: Option<Element&> = opt_next(&y);
        let next_z: Option<Element&> = opt_next(&z);
        return tail(
            tail(opt_copy(&next_x), opt_copy(&y), opt_copy(&z)),
            tail(opt_copy(&next_y), opt_copy(&z), opt_copy(&x)),
            tail(opt_copy(&next_z), opt_copy(&x), opt_copy(&y))
        );
    }
    return z;
}

fn free_list(e: Option<Element&>*) {
    match (*e) {
        None => { return; },
        Some(el) => {
            // 先释放后继链 (Element_free_method 释放 el.next 起), 再释放头节点
            Element_free_method(el);
            del el;
        }
    }
}

fn benchmark_list() -> i32 {
    let x: Option<Element&> = Element_make_list(45);
    let y: Option<Element&> = Element_make_list(30);
    let z: Option<Element&> = Element_make_list(20);

    let result: Option<Element&> = tail(opt_copy(&x), opt_copy(&y), opt_copy(&z));
    let l: i32 = Element_length(&result);

    free_list(&x);
    free_list(&y);
    free_list(&z);

    return l;
}

fn main() {
    let result: i32 = benchmark_list();
    assert result == 30: "list: tail result length should be 30";
    print("list pass\n");
}
