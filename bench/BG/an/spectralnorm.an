// bench/BG/an/spectralnorm.an: spectral norm (shootout spectralnorm).
//
// Adapted from Benchmarks Game (shootout); upstream: Revised BSD, Copyright 2008-2012 Isaac Gouy.
// Semantic reference: bench/BG/c/spectralnorm.c, the project's C implementation.
// Scale: N=8000; assert res%256==78.
//
// Square roots use std.num.f64.sqrt (llvm.sqrt.f64 -> sqrtsd), matching the C reference's
//     libm sqrt primitive and assertion result 78.
//
// Algorithm: matrix A(i,j)=((i+j)*(i+j+1)/2)+i+1; ten mult_AtAv iterations compute
//        sqrt(dot_uv/dot_vv), with res=int(spec*100)%256.
//
// Array parameters in dot/mult_Av/mult_Atv/mult_AtAv/normalize use f64[]
//   block-access semantics, 32 B representations without index fields. main binds u/v/tmp directly as f64[]:
//   let x:T[]=dyn[n] T; del T[] validly releases the whole block.
//
// Fat and raw modes share this source.
// Use inferred dyn types and x[0u64..n] range views for both modes, retaining fat-mode checks.
from std.core.io import print;
from std.num.f64 import sqrt;

fn A(i: u64, j: u64) -> i32 {
    return i32((i + j) * (i + j + 1) / 2 + i + 1);
}

fn dot(v: f64[], w: f64[], n: u64) -> f64 {
    let sum: f64 = 0.0;
    let i: u64 = 0;
    while i < n {
        sum += v[i] * w[i];
        i += 1;
    }
    return sum;
}

fn mult_Av(v: f64[], out: f64[], n: u64) {
    let i: u64 = 0;
    while i < n {
        let sum: f64 = 0.0;
        let j: u64 = 0;
        while j < n {
            sum += v[j] / f64(A(i, j));
            j += 1;
        }
        out[i] = sum;
        i += 1;
    }
}

fn mult_Atv(v: f64[], out: f64[], n: u64) {
    let i: u64 = 0;
    while i < n {
        let sum: f64 = 0.0;
        let j: u64 = 0;
        while j < n {
            sum += v[j] / f64(A(j, i));
            j += 1;
        }
        out[i] = sum;
        i += 1;
    }
}

fn mult_AtAv(v: f64[], out: f64[], n: u64, tmp: f64[]) {
    mult_Av(v, tmp, n);
    mult_Atv(tmp, out, n);
}

fn normalize(v: f64[], n: u64) {
    let norm: f64 = 0.0;
    let i: u64 = 0;
    while i < n {
        norm += v[i] * v[i];
        i += 1;
    }
    norm = 1.0 / sqrt(norm);
    let j: u64 = 0;
    while j < n {
        v[j] *= norm;
        j += 1;
    }
}

fn main() {
    let n: u64 = 8000;
    let u = dyn[n] 0.0;
    let v = dyn[n] 0.0;
    let tmp = dyn[n] 0.0;

    let us: f64[] = u[0u64..n];
    let vs: f64[] = v[0u64..n];
    let ts: f64[] = tmp[0u64..n];

    let i: u64 = 0;
    while i < n {
        u[i] = 1.0;
        v[i] = 1.0;
        i += 1;
    }

    let it: u64 = 0;
    while it < 10 {
        mult_AtAv(us, vs, n, ts);
        mult_AtAv(vs, us, n, ts);

        if it % 2 == 0 {
            normalize(us, n);
        }
        it += 1;
    }

    mult_AtAv(us, vs, n, ts);
    let dot_uv: f64 = dot(us, vs, n);
    let dot_vv: f64 = dot(vs, vs, n);
    let spectral_norm: f64 = sqrt(dot_uv / dot_vv);
    let res: i32 = i32(spectral_norm * 100.0);
    assert res % 256 == 78: "spectralnorm: result is not correct";

    del u;
    del v;
    del tmp;
    print("spectralnorm pass\n");
}
