// bench/BG/an/fann.an — fannkuchredux (shootout fannkuchredux)
//
// Adapted from Benchmarks Game (shootout); upstream: Revised BSD, Copyright 2008-2012 Isaac Gouy.
// Semantic reference: bench/BG/c/fann.c, the project's C implementation.
// Scale: n=11 (11!=39.9M permutations); assert max_flips==51, matching C at n=11.
//
// Algorithm: classic fannkuchredux, incrementally generating permutations and reversing prefixes
//        of length first_element+1, accumulating maximum flip count and checksum.
//
// Both modes share this source. dyn uses inference; ranges such as
//         x[0u64..n] work in both modes and retain checks in fat mode.
from std.core.io import print;

fn fannkuchredux(n: u64) -> i32 {
    let perm: i32[12] = [0; 12];
    let perm1: i32[12] = [0; 12];
    let count: i32[12] = [0; 12];
    let max_flips_count: i32 = 0;
    let perm_count: i32 = 0;
    let checksum: i32 = 0;
    let done: i32 = 0;

    let i: u64 = 0;
    while i < n {
        perm1[i] = i32(i);
        count[i] = 0;
        i += 1;
    }
    let r: i32 = i32(n);

    while done == 0 {
        while r != 1 {
            count[u64(r - 1)] = r;
            r -= 1;
        }

        let j: u64 = 0;
        while j < n {
            perm[j] = perm1[j];
            j += 1;
        }
        let flips_count: i32 = 0;
        let k: i32 = perm[0];

        while k != 0 {
            let k2: i32 = (k + 1) >> 1;
            let m: i32 = 0;
            while m < k2 {
                let temp: i32 = perm[u64(m)];
                perm[u64(m)] = perm[u64(k - m)];
                perm[u64(k - m)] = temp;
                m += 1;
            }
            flips_count += 1;
            k = perm[0];
        }
        if flips_count > max_flips_count {
            max_flips_count = flips_count;
        }

        if perm_count % 2 == 0 {
            checksum += flips_count;
        } else {
            checksum -= flips_count;
        }

        // Incremental permutation generation (next permutation).
        while true {
            if r == i32(n) {
                done = 1;
                break;
            }
            let perm0: i32 = perm1[0];
            let idx: u64 = 0;
            while idx < u64(r) {
                let j2: u64 = idx + 1;
                perm1[idx] = perm1[j2];
                idx = j2;
            }
            perm1[u64(r)] = perm0;
            count[u64(r)] -= 1;
            if count[u64(r)] > 0 {
                break;
            }
            r += 1;
        }

        if done == 0 {
            perm_count += 1;
        }
    }
    return max_flips_count;
}

fn main() {
    let n: u64 = 11;
    let result: i32 = fannkuchredux(n);
    assert result == 51: "fann: max_flips_count is not correct";
    print("fann pass\n");
}
