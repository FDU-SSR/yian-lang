// bench/BG/an/revcomp.an: reverse complement (shootout revcomp, compute-only).
//
// Adapted from Benchmarks Game (shootout); upstream: Revised BSD, Copyright 2008-2012 Isaac Gouy.
// Semantic reference: bench/BG/c/revcomp.c, the project's checksum-only C implementation,
//   without printing reverse-complement sequences.
// Scale: iterations=2000000; assert i32(checksum)%256==128.
//   Checksum grows linearly with iterations: each round contributes the same amount, cycling modulo 256.
//
// Character-level I/O uses byte views, str.as_slice()->u8[].
//     Input is a fixed 386-byte FASTA document with three sequences; each round scans all sequences,
//     computes their reverse complements, and accumulates checksum using the ATCGGCTA...N pairs.
//
// Fat and raw modes share this source.
// Use inferred dyn types and x[0u64..n] range views for both modes, retaining fat-mode checks.

fn main() {
    let input: str = ">ONE Homo sapiens alu\nGGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG\nGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA\nCCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT\nACAAAAATTAGCCGGGCGTGGTGGCGGGCGCCTGTAATCCCA\n>TWO IUB ambiguity codes\nGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG\nAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC\nAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA\n>THREE Homo sapiens frequency\nTTT\nAAA\nGGG\nCCC\n";
    let ibytes: u8[] = input.as_slice();

    let tbl: u8[256] = [0; 256];
    let pairs: str = "ATCGGCTAUAMKRYWWSSYRKMVBHDDHBVNN";
    let pbytes: u8[] = pairs.as_slice();
    let i: u64 = 0;
    while i < pbytes.len() {
        tbl[u64(pbytes[i])] = pbytes[i + 1];
        i += 2;
    };

    let temp_buf: u8[400] = [0; 400];
    let end: u64 = 386;
    let checksum: i64 = 0;
    let iterations: u64 = 2000000;

    let iter: u64 = 0;
    while iter < iterations {
        let in_offset: u64 = 0;

        while in_offset < end && ibytes[in_offset] != b'>' {
            in_offset += 1;
        };

        while in_offset < end {
            while in_offset < end && ibytes[in_offset] != b'\n' {
                in_offset += 1;
            };
            if in_offset < end {
                in_offset += 1;
            };

            let seq_start: u64 = in_offset;
            while in_offset < end && ibytes[in_offset] != b'>' {
                in_offset += 1;
            };
            let seq_end: u64 = in_offset;

            let clean_len: u64 = 0;
            let k: u64 = seq_start;
            while k < seq_end {
                let t: u8 = ibytes[k];
                if t != b'\n' {
                    temp_buf[clean_len] = t;
                    clean_len += 1;
                };
                k += 1;
            };

            let left: i64 = 0;
            let right: i64 = i64(clean_len) - 1;
            while left < right {
                let lc: u8 = temp_buf[u64(left)];
                let lcomp: u8 = tbl[u64(lc)];
                if lcomp != 0 {
                    lc = lcomp;
                };
                let rc: u8 = temp_buf[u64(right)];
                let rcomp: u8 = tbl[u64(rc)];
                if rcomp != 0 {
                    rc = rcomp;
                };

                temp_buf[u64(left)] = rc;
                temp_buf[u64(right)] = lc;
                checksum += i64(lc) + i64(rc);

                left += 1;
                right -= 1;
            };

            if clean_len % 2 == 1 {
                let mid: u64 = clean_len / 2;
                let mcomp: u8 = tbl[u64(temp_buf[mid])];
                if mcomp != 0 {
                    temp_buf[mid] = mcomp;
                };
                checksum += i64(temp_buf[mid]);
            };

            let newlines: u64 = 0;
            if clean_len > 0 {
                newlines = (clean_len - 1) / 60;
            };
            checksum += i64(newlines) * 10;

            while in_offset < end && ibytes[in_offset] != b'>' {
                in_offset += 1;
            };
        };
        iter += 1;
    };

    let res: i32 = i32(checksum % 256);
    assert res == 128: "revcomp: checksum is not correct";
    @print("revcomp pass\n");
}
