from std.core.env import args;

// bench/AWFY/an/json.an: JSON parsing (Json, AWFY macrobenchmark).
//
// Upstream: AWFY benchmarks/Java/src/Json.java and json/*.java.
//       MIT, Copyright (c) 2015 Stefan Marr; json/*.java also carries EclipseSource
//        MIT copyright headers. Json.java's verifyResult checks:
//       the root is an object, head is an object, and operations is
//       an array of size 156.
// Semantic reference: bench/AWFY/c/json.c, with the same scale and checks.
//
// Algorithm: recursive descent following upstream JsonPureStringParser, with one-character lookahead
//       and capture ranges; parse the embedded minified JSON and verify its root structure.
//
// YIAN implementation:
//   1. No trait objects/dynamic dispatch: upstream JsonValue's subclasses JsonObject/
//      JsonArray/JsonString/JsonNumber/JsonLiteral form one tagged
//      JsonValue enum {Object/Array/Str/Num/Literal}, dispatched with match.
//      JsonObject retains parallel names/values and a 32-slot HashIndexTable.
//      Child values are separately allocated JsonValue& nodes, matching upstream's reference graph.
//   2. The parser reads u8 lookahead from a u8[] document; capture uses start/end ranges.
//   3. Parse errors terminate with assert false; benchmark input is valid JSON.
//   4. Traversal uses explicit loops without closures during parsing.
//   5. Unescaped strings are zero-copy str views of the document. Escaped strings follow upstream
//      captureBuffer semantics, accumulating into String stored in an arena of String buffers
//      to preserve lifetimes. This document has no backslashes, so that path is unused.
//   6. Like upstream JsonNumber, numbers retain their original text as str. The work unit
//      only validates the parse tree, without f64 parsing/formatting.
//   7. Parser column stays zero; errors terminate through assert without reading it.
//   8. Embedded document: upstream Json.java's rapBenchmarkMinified, decoded from Java literals
//      and escaped for YIAN. The document is ASCII without escapes or newlines.
//
// Fat and raw modes share this source.
//
// Scale: parse the document once per work unit and verify 156 operations.
// Outer repetitions repeat complete parsing and release.

// -- JSON values (tagged enum for upstream json/JsonValue.java and subclasses) --

enum JsonValue {
    Object { names: Vec<str>, values: Vec<JsonValue&>, table: Vec<i32> },
    Array { values: Vec<JsonValue&> },
    Str { value: str },
    Num { value: str },
    Literal { value: str },
}

// Upstream JsonObject.HashIndexTable.stringHash and hashSlotFor (32 slots, power of two).
fn hash_slot(name: str) -> u64 {
    return (name.as_slice().len() * 1402589u64) & 31u64;
}

// Upstream JsonObject.indexOf: return an index on a hit, -1 on a miss (upstream throws
// NotImplemented; all benchmark keys exist).
fn index_of(names: Vec<str>, table: Vec<i32>, name: str) -> i32 {
    let slot: u64 = hash_slot(name);
    let idx: i32 = (table[u64(slot)] & 0xff) - 1;
    if idx != -1 {
        if names[u64(idx)] == name {
            return idx;
        }
    }
    return -1;
}

// -- Parser (upstream json/JsonPureStringParser.java) --

struct Parser {
    input: str,
    bytes: u8[],
    index: i64,
    line: i32,
    column: i32,
    current: i32,
    capture_start: i64,
    capture_buffer: String,
    arena: Vec<String>&,
}


fn Parser_fail(self: Parser&) {
    assert false: "json: parse error";
}

    // Upstream read(): current=-1 indicates end of input (upstream uses null).
fn Parser_read(self: Parser&) {
    if self.current == 10 {
        self.line += 1;
        self.column = 0;
    }
    self.index += 1;
    if self.index < i64(self.bytes.len()) {
        self.current = i32(self.bytes[u64(self.index)]);
    } else {
        self.current = -1;
    }
}

fn Parser_read_char(self: Parser&, ch: u8) -> bool {
    if self.current != i32(ch) {
        return false;
    }
    Parser_read(self);
    return true;
}

fn Parser_read_digit(self: Parser&) -> bool {
    if self.current < 48 || self.current > 57 {
        return false;
    }
    Parser_read(self);
    return true;
}

fn Parser_is_white_space(self: Parser&) -> bool {
    return self.current == 32 || self.current == 9 || self.current == 10 || self.current == 13;
}

fn Parser_is_end_of_text(self: Parser&) -> bool {
    return self.current < 0;
}

fn Parser_skip_white_space(self: Parser&) {
    while Parser_is_white_space(self) {
        Parser_read(self);
    }
}

fn Parser_start_capture(self: Parser&) {
    self.capture_start = self.index;
}

    // Upstream pauseCapture.
fn Parser_pause_capture(self: Parser&) {
    let end: i64 = if self.current < 0 { self.index } else { self.index - 1 };
    let start: u64 = u64(self.capture_start);
    let piece: str = self.input[u64(start)..u64(end + 1)];
    self.capture_buffer.push_str(piece);
    self.capture_start = -1;
}

    // Upstream endCapture: return a view for unescaped text, otherwise captureBuffer contents.
fn Parser_end_capture(self: Parser&) -> str {
    let end: i64 = if self.current < 0 { self.index } else { self.index - 1 };
    let start: u64 = u64(self.capture_start);
    let piece: str = self.input[u64(start)..u64(end + 1)];
    self.capture_start = -1;
    if self.capture_buffer.len() == 0 {
        return piece;
    }
    self.capture_buffer.push_str(piece);
    let buf: String = self.capture_buffer;
    self.capture_buffer = String.new();
    self.arena.push(buf);
    let store: Vec<String> = *self.arena;
    return store[u64(store.len() - 1u64)].as_str();
}

    // Upstream readEscape.
fn Parser_read_escape(self: Parser&) {
    Parser_read(self);
    if self.current == 34 {
        self.capture_buffer.push('"');
    } elif self.current == 47 {
        self.capture_buffer.push('/');
    } elif self.current == 92 {
        self.capture_buffer.push('\\');
    } elif self.current == 98 {
        self.capture_buffer.push(char(8));
    } elif self.current == 102 {
        self.capture_buffer.push(char(12));
    } elif self.current == 110 {
        self.capture_buffer.push('\n');
    } elif self.current == 114 {
        self.capture_buffer.push('\r');
    } elif self.current == 116 {
        self.capture_buffer.push('\t');
    } else {
        Parser_fail(self);
    }
    Parser_read(self);
}

    // Upstream readStringInternal with an additional premature-end parse-error check;
    // upstream throws NPE here when current is null.
fn Parser_read_string_internal(self: Parser&) -> str {
    Parser_read(self);
    Parser_start_capture(self);
    while self.current != 34 {
        if self.current < 0 {
            Parser_fail(self);
            return "";
        }
        if self.current == 92 {
            Parser_pause_capture(self);
            Parser_read_escape(self);
            Parser_start_capture(self);
        } else {
            Parser_read(self);
        }
    }
    let captured: str = Parser_end_capture(self);
    Parser_read(self);
    return captured;
}

fn Parser_read_string(self: Parser&) -> JsonValue& {
    return dyn JsonValue.Str(value=Parser_read_string_internal(self));
}

fn Parser_read_name(self: Parser&) -> str {
    if self.current != 34 {
        Parser_fail(self);
        return "";
    }
    return Parser_read_string_internal(self);
}

fn Parser_require(self: Parser&, ch: u8) {
    if !Parser_read_char(self, ch) {
        Parser_fail(self);
    }
}

fn Parser_read_null(self: Parser&) -> JsonValue& {
    Parser_read(self);
    Parser_require(self, 117);
    Parser_require(self, 108);
    Parser_require(self, 108);
    return dyn JsonValue.Literal(value="null");
}

fn Parser_read_true(self: Parser&) -> JsonValue& {
    Parser_read(self);
    Parser_require(self, 114);
    Parser_require(self, 117);
    Parser_require(self, 101);
    return dyn JsonValue.Literal(value="true");
}

fn Parser_read_false(self: Parser&) -> JsonValue& {
    Parser_read(self);
    Parser_require(self, 97);
    Parser_require(self, 108);
    Parser_require(self, 115);
    Parser_require(self, 101);
    return dyn JsonValue.Literal(value="false");
}

    // Upstream readNumber.
fn Parser_read_number(self: Parser&) -> JsonValue& {
    Parser_start_capture(self);
    Parser_read_char(self, 45);
    let first_digit: i32 = self.current;
    if !Parser_read_digit(self) {
        Parser_fail(self);
    }
    if first_digit != 48 {
        while Parser_read_digit(self) {
        }
    }
    Parser_read_fraction(self);
    Parser_read_exponent(self);
    return dyn JsonValue.Num(value=Parser_end_capture(self));
}

fn Parser_read_fraction(self: Parser&) {
    if !Parser_read_char(self, 46) {
        return;
    }
    if !Parser_read_digit(self) {
        Parser_fail(self);
    }
    while Parser_read_digit(self) {
    }
}

fn Parser_read_exponent(self: Parser&) {
    if !Parser_read_char(self, 101) {
        if !Parser_read_char(self, 69) {
            return;
        }
    }
    if !Parser_read_char(self, 43) {
        Parser_read_char(self, 45);
    }
    if !Parser_read_digit(self) {
        Parser_fail(self);
    }
    while Parser_read_digit(self) {
    }
}

fn Parser_read_array(self: Parser&) -> JsonValue& {
    Parser_read(self);
    let values: Vec<JsonValue&> = Vec<JsonValue&>.new();
    Parser_skip_white_space(self);
    if Parser_read_char(self, 93) {
        return dyn JsonValue.Array(values=values);
    }
    loop {
        Parser_skip_white_space(self);
        values.push(Parser_read_value(self));
        Parser_skip_white_space(self);
        if !Parser_read_char(self, 44) {
            break;
        }
    }
    if !Parser_read_char(self, 93) {
        Parser_fail(self);
    }
    return dyn JsonValue.Array(values=values);
}

fn Parser_read_object(self: Parser&) -> JsonValue& {
    Parser_read(self);
    let names: Vec<str> = Vec<str>.new();
    let values: Vec<JsonValue&> = Vec<JsonValue&>.new();
    let table: Vec<i32> = Vec<i32>.with_capacity(32u64);
    let k: u64 = 0;
    while k < 32u64 {
        table.push(0);
        k += 1;
    }
    Parser_skip_white_space(self);
    if Parser_read_char(self, 125) {
        return dyn JsonValue.Object(names=names, values=values, table=table);
    }
    loop {
        Parser_skip_white_space(self);
        let name: str = Parser_read_name(self);
        Parser_skip_white_space(self);
        if !Parser_read_char(self, 58) {
            Parser_fail(self);
        }
        Parser_skip_white_space(self);
        // Upstream HashIndexTable.add(name,names.size()).
        if names.len() < 255u64 {
            let slot: u64 = hash_slot(name);
            table[u64(slot)] = (i32(names.len()) + 1) & 0xff;
        }
        names.push(name);
        values.push(Parser_read_value(self));
        Parser_skip_white_space(self);
        if !Parser_read_char(self, 44) {
            break;
        }
    }
    if !Parser_read_char(self, 125) {
        Parser_fail(self);
    }
    return dyn JsonValue.Object(names=names, values=values, table=table);
}

    // Upstream readValue.
fn Parser_read_value(self: Parser&) -> JsonValue& {
    let c: i32 = self.current;
    if c == 110 {
        return Parser_read_null(self);
    }
    if c == 116 {
        return Parser_read_true(self);
    }
    if c == 102 {
        return Parser_read_false(self);
    }
    if c == 34 {
        return Parser_read_string(self);
    }
    if c == 91 {
        return Parser_read_array(self);
    }
    if c == 123 {
        return Parser_read_object(self);
    }
    if c == 45 || (c >= 48 && c <= 57) {
        return Parser_read_number(self);
    }
    Parser_fail(self);
    return dyn JsonValue.Literal(value="null");
}


// Upstream JsonPureStringParser.parse; the caller owns the arena to preserve str lifetimes.
// This document has no escapes, so the arena stays empty.
fn parse_document(doc: str, bytes: u8[], arena: Vec<String>&) -> JsonValue& {
    let p: Parser = Parser(input=doc, bytes=bytes, index=-1i64, line=1, column=0, current=-1, capture_start=-1i64, capture_buffer=String.new(), arena=arena);
    Parser_read(&p);
    Parser_skip_white_space(&p);
    let result: JsonValue& = Parser_read_value(&p);
    Parser_skip_white_space(&p);
    if !Parser_is_end_of_text(&p) {
        Parser_fail(&p);
    }
    p.capture_buffer.drop();
    return result;
}

// -- Upstream Json.verifyResult: operations must be an array with size 156 --

fn ops_size(root: JsonValue&) -> u64 {
    match *root {
        Object(names, values, table) => {
            let head_idx: i32 = index_of(names, table, "head");
            if head_idx < 0 {
                assert false: "json: head member missing";
            }
            match *values[u64(head_idx)] {
                Object(head_names, head_values, head_table) => {
                    let _head_size: u64 = head_names.len() + head_values.len() + head_table.len();
                },
                _ => {
                    assert false: "json: head is not an object";
                },
            }
            let idx: i32 = index_of(names, table, "operations");
            if idx < 0 {
                assert false: "json: operations member missing";
            }
            match *values[u64(idx)] {
                Array(av) => {
                    return av.len();
                },
                _ => {
                    assert false: "json: operations is not an array";
                },
            }
        },
        _ => {
            assert false: "json: root is not an object";
        },
    }
    return 0u64;
}

// Recursively release separately allocated nodes and their children.
fn free_value(v: JsonValue&) {
    match *v {
        Object(names, values, table) => {
            names.drop();
            table.drop();
            let i: u64 = 0;
            while i < values.len() {
                let child: JsonValue& = values[u64(i)];
                free_value(child);
                del child;
                i += 1;
            }
            values.drop();
        },
        Array(values) => {
            let i: u64 = 0;
            while i < values.len() {
                let child: JsonValue& = values[u64(i)];
                free_value(child);
                del child;
                i += 1;
            }
            values.drop();
        },
        Str(sv) => {
        },
        Num(nv) => {
        },
        Literal(lv) => {
        },
    }
}

// Decimal prefix parsing for the C atoi/atoll workload argument.
fn c_decimal(text: str) -> i64 {
    let bytes = text.as_slice();
    let i: u64 = 0;
    while i < bytes.len() && (bytes[u64(i)] == 32 || (bytes[u64(i)] >= 9 && bytes[u64(i)] <= 13)) { i += 1; }
    let negative: bool = false;
    if i < bytes.len() && (bytes[u64(i)] == b'-' || bytes[u64(i)] == b'+') {
        negative = bytes[u64(i)] == b'-';
        i += 1;
    }
    let value: i64 = 0;
    while i < bytes.len() && bytes[u64(i)] >= b'0' && bytes[u64(i)] <= b'9' {
        value = value * 10 + i64(bytes[u64(i)] - b'0');
        i += 1;
    }
    return if negative { -value } else { value };
}

