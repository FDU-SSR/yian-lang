from std.core.env import args;

// bench/AWFY/an/havlak.an: Havlak loop recognition (AWFY macrobenchmark).
//
// Upstream: AWFY benchmarks/Java/src/Havlak.java and havlak/*.java.
//       Havlak.java and BasicBlock/BasicBlockEdge/ControlFlowGraph/HavlakLoopFinder/
//       LoopStructureGraph/LoopTesterApp/SimpleLoop.java:
//         `// Copyright 2011 Google Inc.` and Apache-2.0 (see licenses/LICENSE-APACHE);
//       UnionFindNode.java and som/*.java (Vector/Set/IdentitySet/IdentityDictionary):
//         MIT, Copyright (c) 2001-2016 Stefan Marr / AWFY AUTHORS.md (see licenses/LICENSE-MIT).
// Semantic reference: bench/AWFY/c/havlak.c, following upstream with matching official assertions:
//       innerIterations=1→(1605,5213), 15→(1647,5213), 150→(2052,5213), 1500→(6102,5213))
//
// Algorithm: DFS preorder numbers CFG nodes; last[w] intervals determine ancestry. Split incoming edges
//       into back/non-back edges, then process headers in reverse order, tracing back-edge sources and using
//       union-find to collapse SCCs into SimpleLoops in a LoopStructureGraph; recursively assign nesting levels.
//
// YIAN implementation:
//   1. SimpleLoop/BasicBlock/BasicBlockEdge/ControlFlowGraph/LoopStructureGraph/
//      HavlakLoopFinder/LoopTesterApp use structs; som.Vector/Set/IdentitySet
//      use Vec<T> (som.Set is an insertion-ordered set with linear scans).
//   2. BasicBlock identity is its unique CFG name; SimpleLoop uses a unique LoopStructureGraph counter.
//      IdentitySet.contains, node comparison, and reuse compare IDs.
//   3. Union-find parents are u64 nodes-array indices; a node pointing to itself is a root.
//   4. findSet path compression follows nodeList.forEach(iter -> iter.union(parent)) updates.
//      The C reference uses the same rules and checks 6102/5213.
//   5. BBClass is an enum with seven payload-free variants; bb_is_self and
//      bb_is_irreducible perform comparisons through match.
//   6. initAllNodes/doDFS/processEdges/stepD/stepE/setLoopAttributes/
//      calculateNestingLevel* uses explicit loops without forEach closures;
//      stepE can append to nonBackPreds[x.dfsNumber] while traversing it when w==x.dfsNumber,
//      so YIAN rereads the length to match Java Vector.forEach semantics.
//   7. IdentityDictionary<BasicBlock,Integer> number uses customHash()=BasicBlock.name,
//      so, like header/last/nodes, it is an array indexed by the CFG's unique node names.
//   8. Each benchmark round explicitly releases finder buffers, LoopStructureGraph,
//      including each SimpleLoop's basicBlocks/children, and ControlFlowGraph.
//   9. No restricted builtins (@bitcast/@memcpy/@slice_from_parts/@str_from_parts); this benchmark
//      needs no sqrt/sin/cos or custom math.
//
// Both modes share this source, with Option<T&>/Vec<T&> trees and sets, without slices.
//         Bind dyn variables as T& without T[]/T* annotations for compatibility with both modes.
// Scale: official innerIterations=1500 per work unit, producing 6102/5213.
// Outer repetitions repeat complete LoopTesterApp runs.
// Assert loops=6102 and nodes=5213 each round, matching the C reference.

// -- Basic blocks / edges / CFG (upstream havlak/BasicBlock.java, BasicBlockEdge.java,
//    ControlFlowGraph.java) ──

struct BasicBlock {
    name: i32,
    in_edges: Vec<BasicBlock&>,
    out_edges: Vec<BasicBlock&>,
}

struct BasicBlockEdge {
    src: BasicBlock&,
    dst: BasicBlock&,
}

struct ControlFlowGraph {
    // basicBlockMap: index equals name; None means the node has not been created.
    basic_blocks: Vec<Option<BasicBlock&>>,
    start_node: Option<BasicBlock&>,
    edge_list: Vec<BasicBlockEdge&>,
}


pub fn ControlFlowGraph_new() -> ControlFlowGraph& {
    return dyn ControlFlowGraph(basic_blocks=Vec<Option<BasicBlock&>>.new(), start_node=Option<BasicBlock&>.None, edge_list=Vec<BasicBlockEdge&>.new());
}

    // Upstream createNode: reuse existing nodes, otherwise create; set startNode when size first reaches one.
pub fn ControlFlowGraph_create_node(self: ControlFlowGraph&, name: i32) -> BasicBlock& {
    let idx: u64 = u64(name);
    if idx < self.basic_blocks.len() && self.basic_blocks[u64(idx)].is_some() {
        let existing: BasicBlock& = *self.basic_blocks[u64(idx)].unwrap();
        if self.basic_blocks.len() == 1 {
            self.start_node = Option<BasicBlock&>.Some(existing);
        }
        return existing;
    }
    let node: BasicBlock& = dyn BasicBlock(name=name, in_edges=Vec<BasicBlock&>.new(), out_edges=Vec<BasicBlock&>.new());
    while self.basic_blocks.len() <= idx {
        self.basic_blocks.push(Option<BasicBlock&>.None);
    }
    self.basic_blocks[u64(idx)] = Option<BasicBlock&>.Some(node);
    if self.basic_blocks.len() == 1 {
        self.start_node = Option<BasicBlock&>.Some(node);
    }
    return node;
}

pub fn ControlFlowGraph_num_nodes(self: ControlFlowGraph&) -> i32 {
    return i32(self.basic_blocks.len());
}


// Upstream BasicBlockEdge constructor: create/get endpoints, attach outgoing/incoming edges, register in edgeList.
fn new_basic_block_edge(cfg: ControlFlowGraph&, from_name: i32, to_name: i32) {
    let from_node: BasicBlock& = ControlFlowGraph_create_node(cfg, from_name);
    let to_node: BasicBlock& = ControlFlowGraph_create_node(cfg, to_name);
    from_node.out_edges.push(to_node);
    to_node.in_edges.push(from_node);
    let edge: BasicBlockEdge& = dyn BasicBlockEdge(src=from_node, dst=to_node);
    cfg.edge_list.push(edge);
}

// -- Loops (upstream havlak/SimpleLoop.java, LoopStructureGraph.java) --

struct SimpleLoop {
    counter: i32,        // Identity ID for IdentitySet deduplication.
    basic_blocks: Vec<BasicBlock&>,
    children: Vec<SimpleLoop&>,
    parent: Option<SimpleLoop&>,
    root_flag: bool,
    is_reducible: bool,
    nesting_level: i32,
    depth_level: i32,
}


    // Upstream SimpleLoop(bb,isReducible); bb=None denotes the artificial root.
pub fn SimpleLoop_new(bb: Option<BasicBlock&>, is_reducible: bool) -> SimpleLoop& {
    let loop_: SimpleLoop& = dyn SimpleLoop(counter=0, basic_blocks=Vec<BasicBlock&>.new(), children=Vec<SimpleLoop&>.new(), parent=Option<SimpleLoop&>.None, root_flag=false, is_reducible=is_reducible, nesting_level=0, depth_level=0);
    if bb.is_some() {
        let b: BasicBlock& = *bb.unwrap();
        SimpleLoop_add_node(loop_, b);
    }
    return loop_;
}

pub fn SimpleLoop_add_node(self: SimpleLoop&, bb: BasicBlock&) {
    let i: u64 = 0;
    while i < self.basic_blocks.len() {
        if self.basic_blocks[u64(i)].name == bb.name {
            return;
        }
        i += 1;
    }
    self.basic_blocks.push(bb);
}

pub fn SimpleLoop_add_child_loop(self: SimpleLoop&, child: SimpleLoop&) {
    let i: u64 = 0;
    while i < self.children.len() {
        if self.children[u64(i)].counter == child.counter {
            return;
        }
        i += 1;
    }
    self.children.push(child);
}

    // Upstream setParent(parent): record parent and add self to parent.children.
pub fn SimpleLoop_set_parent(self: SimpleLoop&, parent: SimpleLoop&) {
    self.parent = Option<SimpleLoop&>.Some(parent);
    SimpleLoop_add_child_loop(parent, self);
}

pub fn SimpleLoop_set_counter(self: SimpleLoop&, value: i32) {
    self.counter = value;
}

pub fn SimpleLoop_set_nesting_level(self: SimpleLoop&, level: i32) {
    self.nesting_level = level;
    if level == 0 {
        self.root_flag = true;
    }
}

pub fn SimpleLoop_set_depth_level(self: SimpleLoop&, level: i32) {
    self.depth_level = level;
}

pub fn SimpleLoop_is_root(self: SimpleLoop&) -> bool {
    return self.root_flag;
}

pub fn SimpleLoop_get_children_len(self: SimpleLoop&) -> u64 {
    return self.children.len();
}

pub fn SimpleLoop_get_child(self: SimpleLoop&, i: u64) -> SimpleLoop& {
    return self.children[u64(i)];
}

pub fn SimpleLoop_get_nesting_level(self: SimpleLoop&) -> i32 {
    return self.nesting_level;
}


struct LoopStructureGraph {
    root: SimpleLoop&,
    loops: Vec<SimpleLoop&>,
    loop_counter: i32,
}


pub fn LoopStructureGraph_new() -> LoopStructureGraph& {
    let root: SimpleLoop& = SimpleLoop_new(Option<BasicBlock&>.None, true);
    let lsg: LoopStructureGraph& = dyn LoopStructureGraph(root=root, loops=Vec<SimpleLoop&>.new(), loop_counter=0);
    SimpleLoop_set_nesting_level(root, 0);
    SimpleLoop_set_counter(root, lsg.loop_counter);
    lsg.loop_counter += 1;
    lsg.loops.push(root);
    return lsg;
}

pub fn LoopStructureGraph_create_new_loop(self: LoopStructureGraph&, bb: BasicBlock&, is_reducible: bool) -> SimpleLoop& {
    let loop_: SimpleLoop& = SimpleLoop_new(Option<BasicBlock&>.Some(bb), is_reducible);
    SimpleLoop_set_counter(loop_, self.loop_counter);
    self.loop_counter += 1;
    self.loops.push(loop_);
    return loop_;
}

pub fn LoopStructureGraph_num_loops(self: LoopStructureGraph&) -> i32 {
    return i32(self.loops.len());
}

pub fn LoopStructureGraph_get_loop(self: LoopStructureGraph&, i: u64) -> SimpleLoop& {
    return self.loops[u64(i)];
}

    // Upstream calculateNestingLevel.
pub fn LoopStructureGraph_calculate_nesting_level(self: LoopStructureGraph&) {
    let i: u64 = 0;
    while i < self.loops.len() {
        let loop_: SimpleLoop& = self.loops[u64(i)];
        if !SimpleLoop_is_root(loop_) {
            if loop_.parent.is_none() {
                SimpleLoop_set_parent(loop_, self.root);
            }
        }
        i += 1;
    }
    LoopStructureGraph_calculate_nesting_level_rec(self, self.root, 0);
}

fn LoopStructureGraph_calculate_nesting_level_rec(self: LoopStructureGraph&, loop_: SimpleLoop&, depth: i32) {
    SimpleLoop_set_depth_level(loop_, depth);
    let i: u64 = 0;
    while i < SimpleLoop_get_children_len(loop_) {
        let child: SimpleLoop& = SimpleLoop_get_child(loop_, i);
        LoopStructureGraph_calculate_nesting_level_rec(self, child, depth + 1);
        let candidate: i32 = 1 + SimpleLoop_get_nesting_level(child);
        if SimpleLoop_get_nesting_level(loop_) < candidate {
            SimpleLoop_set_nesting_level(loop_, candidate);
        }
        i += 1;
    }
}


// -- Union/find (upstream havlak/UnionFindNode.java) --
// parent is a nodes-array index; self-parent means a root.

struct UnionFindNode {
    parent: u64,
    bb: Option<BasicBlock&>,
    loop_: Option<SimpleLoop&>,
    dfs_number: i32,
}

// -- Node classification (upstream HavlakLoopFinder.BasicBlockClass) --

enum BBClass {
    Top,
    NonHeader,
    Reducible,
    SelfLoop,
    Irreducible,
    Dead,
    Last,
}

fn bb_is_self(k: BBClass) -> bool {
    return match k {
        SelfLoop => true,
        _ => false,
    };
}

fn bb_is_irreducible(k: BBClass) -> bool {
    return match k {
        Irreducible => true,
        _ => false,
    };
}

// -- Integer set (upstream som.Set<Integer>: insertion order and linear deduplication) --

struct IntSet {
    items: Vec<i32>,
}


pub fn IntSet_new() -> IntSet {
    return IntSet(items=Vec<i32>.new());
}

pub fn IntSet_add(self: IntSet&, v: i32) {
    let i: u64 = 0;
    while i < self.items.len() {
        if self.items[u64(i)] == v {
            return;
        }
        i += 1;
    }
    self.items.push(v);
}

pub fn IntSet_len(self: IntSet&) -> u64 {
    return self.items.len();
}

pub fn IntSet_get(self: IntSet&, i: u64) -> i32 {
    return self.items[u64(i)];
}

pub fn IntSet_drop_all(self: IntSet&) {
    self.items.drop();
}


fn vec_u64_has(v: Vec<u64>&, x: u64) -> bool {
    let i: u64 = 0;
    while i < v.len() {
        if v.deref()[u64(i)] == x {
            return true;
        }
        i += 1;
    }
    return false;
}

// -- Loop recognition (upstream havlak/HavlakLoopFinder.java) --

struct HavlakLoopFinder {
    cfg: ControlFlowGraph&,
    lsg: LoopStructureGraph&,
    non_back_preds: Vec<IntSet>,
    back_preds: Vec<Vec<i32>>,
    number: Vec<i32>,
    header: Vec<i32>,
    bb_type: Vec<BBClass>,
    last: Vec<i32>,
    nodes: Vec<UnionFindNode>,
}


pub fn HavlakLoopFinder_new(cfg: ControlFlowGraph&, lsg: LoopStructureGraph&) -> HavlakLoopFinder {
    return HavlakLoopFinder(cfg=cfg, lsg=lsg, non_back_preds=Vec<IntSet>.new(), back_preds=Vec<Vec<i32>>.new(), number=Vec<i32>.new(), header=Vec<i32>.new(), bb_type=Vec<BBClass>.new(), last=Vec<i32>.new(), nodes=Vec<UnionFindNode>.new());
}

    // Upstream isAncestor: test ancestry using DFS preorder numbers.
fn HavlakLoopFinder_is_ancestor(self: HavlakLoopFinder&, w: i32, v: i32) -> bool {
    return w <= v && v <= self.last[u64(w)];
}

    // Upstream UnionFindNode.findSet: the final union uses this.parent (AWFY semantics).
fn HavlakLoopFinder_find_set(self: HavlakLoopFinder&, x: u64) -> u64 {
    let node_list: Vec<u64> = Vec<u64>.new();
    let node: u64 = x;
    while node != self.nodes[u64(node)].parent {
        let p: u64 = self.nodes[u64(node)].parent;
        if p != self.nodes[u64(p)].parent {
            node_list.push(node);
        }
        node = p;
    }
    let parent: u64 = self.nodes[u64(x)].parent;
    let k: u64 = 0;
    while k < node_list.len() {
        self.nodes[u64(node_list[u64(k)])].parent = parent;
        k += 1;
    }
    node_list.drop();
    return node;
}

    // Upstream doDFS.
fn HavlakLoopFinder_do_dfs(self: HavlakLoopFinder&, current_node: BasicBlock&, current: i32) -> i32 {
    let ci: u64 = u64(current);
    self.nodes[u64(ci)].parent = ci;
    self.nodes[u64(ci)].bb = Option<BasicBlock&>.Some(current_node);
    self.nodes[u64(ci)].dfs_number = current;
    self.nodes[u64(ci)].loop_ = Option<SimpleLoop&>.None;
    self.number[u64(current_node.name)] = current;

    let last_id: i32 = current;
    let i: u64 = 0;
    while i < current_node.out_edges.len() {
        let target: BasicBlock& = current_node.out_edges[u64(i)];
        if self.number[u64(target.name)] == 2147483647 {
            last_id = HavlakLoopFinder_do_dfs(self, target, last_id + 1);
        }
        i += 1;
    }
    self.last[u64(ci)] = last_id;
    return last_id;
}

    // Upstream processEdges.
fn HavlakLoopFinder_process_edges(self: HavlakLoopFinder&, node_w: BasicBlock&, w: i32) {
    if node_w.in_edges.len() > 0 {
        let i: u64 = 0;
        while i < node_w.in_edges.len() {
            let node_v: BasicBlock& = node_w.in_edges[u64(i)];
            let v: i32 = self.number[u64(node_v.name)];
            if v != 2147483647 {
                if HavlakLoopFinder_is_ancestor(self, w, v) {
                    self.back_preds[u64(w)].push(v);
                } else {
                    IntSet_add(&self.non_back_preds[u64(w)], v);
                }
            }
            i += 1;
        }
    }
}

    // Upstream identifyEdges.
fn HavlakLoopFinder_identify_edges(self: HavlakLoopFinder&, size: i32) {
    let w: u64 = 0;
    while i32(w) < size {
        let wi: u64 = u64(i32(w));
        self.header[u64(wi)] = 0;
        self.bb_type[u64(wi)] = BBClass.NonHeader;
        if self.nodes[u64(wi)].bb.is_none() {
            self.bb_type[u64(wi)] = BBClass.Dead;
        } else {
            let node_w: BasicBlock& = *self.nodes[u64(wi)].bb.unwrap();
            HavlakLoopFinder_process_edges(self, node_w, i32(w));
        }
        w += 1;
    }
}

    // Upstream stepD.
fn HavlakLoopFinder_step_d(self: HavlakLoopFinder&, w: i32, node_pool: Vec<u64>&) {
    let wi: u64 = u64(w);
    let i: u64 = 0;
    while i < self.back_preds[u64(wi)].len() {
        let v: i32 = self.back_preds[u64(wi)][u64(i)];
        if v != w {
            let root: u64 = HavlakLoopFinder_find_set(self, u64(v));
            node_pool.push(root);
        } else {
            self.bb_type[u64(wi)] = BBClass.SelfLoop;
        }
        i += 1;
    }
}

    // Upstream stepEProcessNonBackPreds.
fn HavlakLoopFinder_step_e(self: HavlakLoopFinder&, w: i32, node_pool: Vec<u64>&, work_list: Vec<u64>&, x: u64) {
    let nbp: u64 = u64(self.nodes[u64(x)].dfs_number);
    let k: u64 = 0;
    while k < IntSet_len(&self.non_back_preds[u64(nbp)]) {
        let iter: i32 = IntSet_get(&self.non_back_preds[u64(nbp)], k);
        let ydash: u64 = HavlakLoopFinder_find_set(self, u64(iter));
        let ydash_dfs: i32 = self.nodes[u64(ydash)].dfs_number;

        if !HavlakLoopFinder_is_ancestor(self, w, ydash_dfs) {
            self.bb_type[u64(w)] = BBClass.Irreducible;
            IntSet_add(&self.non_back_preds[u64(w)], ydash_dfs);
        } else {
            if ydash_dfs != w {
                if !vec_u64_has(node_pool, ydash) {
                    work_list.push(ydash);
                    node_pool.push(ydash);
                }
            }
        }
        k += 1;
    }
}

    // Upstream setLoopAttributes.
fn HavlakLoopFinder_set_loop_attributes(self: HavlakLoopFinder&, w: i32, node_pool: Vec<u64>&, loop_: SimpleLoop&) {
    self.nodes[u64(w)].loop_ = Option<SimpleLoop&>.Some(loop_);
    let i: u64 = 0;
    while i < node_pool.len() {
        let n: u64 = node_pool.deref()[u64(i)];
        self.header[u64(self.nodes[u64(n)].dfs_number)] = w;
        self.nodes[u64(n)].parent = u64(w);
        if self.nodes[u64(n)].loop_.is_some() {
            let child: SimpleLoop& = *self.nodes[u64(n)].loop_.unwrap();
            SimpleLoop_set_parent(child, loop_);
        } else {
            let bb: BasicBlock& = *self.nodes[u64(n)].bb.unwrap();
            SimpleLoop_add_node(loop_, bb);
        }
        i += 1;
    }
}

    // Upstream findLoops.
pub fn HavlakLoopFinder_find_loops(self: HavlakLoopFinder&) {
    if self.cfg.start_node.is_none() {
        return;
    }

    let size: i32 = ControlFlowGraph_num_nodes(self.cfg);

    let i: u64 = 0;
    while i < u64(size) {
        self.header.push(0);
        self.bb_type.push(BBClass.NonHeader);
        self.last.push(0);
        self.number.push(2147483647);
        self.nodes.push(UnionFindNode(parent=i, bb=Option<BasicBlock&>.None, loop_=Option<SimpleLoop&>.None, dfs_number=0));
        self.non_back_preds.push(IntSet_new());
        self.back_preds.push(Vec<i32>.new());
        i += 1;
    }

    // Upstream initAllNodes: mark all UNVISITED and assign DFS numbers.
    let start: BasicBlock& = *self.cfg.start_node.unwrap();
    HavlakLoopFinder_do_dfs(self, start, 0);

    HavlakLoopFinder_identify_edges(self, size);

    // The start node is the root of all other loops.
    self.header[u64(0)] = 0;

    // Step c
    let w: u64 = u64(size);
    while w > 0 {
        w -= 1;
        let node_pool: Vec<u64> = Vec<u64>.new();
        let wi: u64 = u64(i32(w));
        if self.nodes[u64(wi)].bb.is_some() {
            let node_w: BasicBlock& = *self.nodes[u64(wi)].bb.unwrap();
            HavlakLoopFinder_step_d(self, i32(w), &node_pool);

            let work_list: Vec<u64> = Vec<u64>.new();
            let ci: u64 = 0;
            while ci < node_pool.len() {
                work_list.push(node_pool.deref()[u64(ci)]);
                ci += 1;
            }

            if node_pool.len() != 0 {
                self.bb_type[u64(wi)] = BBClass.Reducible;
            }

            let head: u64 = 0;
            while head < work_list.len() {
                let x: u64 = work_list.deref()[u64(head)];
                head += 1;

                let non_back_size: u64 = IntSet_len(&self.non_back_preds[u64(self.nodes[u64(x)].dfs_number)]);
                if non_back_size > 32768u64 {
                    node_pool.drop();
                    work_list.drop();
                    return;
                }
                HavlakLoopFinder_step_e(self, i32(w), &node_pool, &work_list, x);
            }

            if node_pool.len() > 0 || bb_is_self(self.bb_type[u64(wi)]) {
                let loop_: SimpleLoop& = LoopStructureGraph_create_new_loop(self.lsg, node_w, !bb_is_irreducible(self.bb_type[u64(wi)]));
                HavlakLoopFinder_set_loop_attributes(self, i32(w), &node_pool, loop_);
            }
            work_list.drop();
        }
        node_pool.drop();
    }
}

    // Release all finder buffers; upstream uses GC.
pub fn HavlakLoopFinder_free_buffers(self: HavlakLoopFinder&) {
    let i: u64 = 0;
    while i < self.non_back_preds.len() {
        let s: IntSet = self.non_back_preds[u64(i)];
        IntSet_drop_all(&s);
        i += 1;
    }
    self.non_back_preds.drop();

    let j: u64 = 0;
    while j < self.back_preds.len() {
        let b: Vec<i32> = self.back_preds[u64(j)];
        b.drop();
        j += 1;
    }
    self.back_preds.drop();

    self.number.drop();
    self.header.drop();
    self.bb_type.drop();
    self.last.drop();
    self.nodes.drop();
}


// -- Release helpers --

fn free_cfg(cfg: ControlFlowGraph&) {
    let i: u64 = 0;
    while i < cfg.edge_list.len() {
        let e: BasicBlockEdge& = cfg.edge_list[u64(i)];
        del e;
        i += 1;
    }
    cfg.edge_list.drop();

    let j: u64 = 0;
    while j < cfg.basic_blocks.len() {
        if cfg.basic_blocks[u64(j)].is_some() {
            let b: BasicBlock& = *cfg.basic_blocks[u64(j)].unwrap();
            b.in_edges.drop();
            b.out_edges.drop();
            del b;
        }
        j += 1;
    }
    cfg.basic_blocks.drop();
    del cfg;
}

fn free_lsg(lsg: LoopStructureGraph&) {
    let i: u64 = 0;
    while i < lsg.loops.len() {
        let l: SimpleLoop& = lsg.loops[u64(i)];
        l.basic_blocks.drop();
        l.children.drop();
        del l;
        i += 1;
    }
    lsg.loops.drop();
    del lsg;
}

// -- Test driver (upstream havlak/LoopTesterApp.java) --

struct AppResult {
    loops: i32,
    nodes: i32,
}

struct LoopTesterApp {
    cfg: ControlFlowGraph&,
    lsg: LoopStructureGraph&,
}


pub fn LoopTesterApp_new() -> LoopTesterApp {
    let cfg: ControlFlowGraph& = ControlFlowGraph_new();
    let lsg: LoopStructureGraph& = LoopStructureGraph_new();
    ControlFlowGraph_create_node(cfg, 0);
    return LoopTesterApp(cfg=cfg, lsg=lsg);
}

    // Upstream buildDiamond.
fn LoopTesterApp_build_diamond(self: LoopTesterApp&, start: i32) -> i32 {
    let bb0: i32 = start;
    new_basic_block_edge(self.cfg, bb0, bb0 + 1);
    new_basic_block_edge(self.cfg, bb0, bb0 + 2);
    new_basic_block_edge(self.cfg, bb0 + 1, bb0 + 3);
    new_basic_block_edge(self.cfg, bb0 + 2, bb0 + 3);
    return bb0 + 3;
}

    // Upstream buildConnect.
fn LoopTesterApp_build_connect(self: LoopTesterApp&, start: i32, end: i32) {
    new_basic_block_edge(self.cfg, start, end);
}

    // Upstream buildStraight.
fn LoopTesterApp_build_straight(self: LoopTesterApp&, start: i32, n: i32) -> i32 {
    let i: u64 = 0;
    while i32(i) < n {
        LoopTesterApp_build_connect(self, start + i32(i), start + i32(i) + 1);
        i += 1;
    }
    return start + n;
}

    // Upstream buildBaseLoop.
fn LoopTesterApp_build_base_loop(self: LoopTesterApp&, from: i32) -> i32 {
    let header: i32 = LoopTesterApp_build_straight(self, from, 1);
    let diamond1: i32 = LoopTesterApp_build_diamond(self, header);
    let d11: i32 = LoopTesterApp_build_straight(self, diamond1, 1);
    let diamond2: i32 = LoopTesterApp_build_diamond(self, d11);
    let footer: i32 = LoopTesterApp_build_straight(self, diamond2, 1);
    LoopTesterApp_build_connect(self, diamond2, d11);
    LoopTesterApp_build_connect(self, diamond1, header);

    LoopTesterApp_build_connect(self, footer, from);
    let footer2: i32 = LoopTesterApp_build_straight(self, footer, 1);
    return footer2;
}

    // Upstream constructCFG.
fn LoopTesterApp_construct_cfg(self: LoopTesterApp&, par_loops: i32, ppar_loops: i32, pppar_loops: i32) {
    let n: i32 = 2;
    let parlooptrees: u64 = 0;
    while i32(parlooptrees) < par_loops {
        ControlFlowGraph_create_node(self.cfg, n + 1);
        LoopTesterApp_build_connect(self, 2, n + 1);
        n += 1;

        let i: u64 = 0;
        while i32(i) < ppar_loops {
            let top: i32 = n;
            n = LoopTesterApp_build_straight(self, n, 1);
            let j: u64 = 0;
            while i32(j) < pppar_loops {
                n = LoopTesterApp_build_base_loop(self, n);
                j += 1;
            }
            let bottom: i32 = LoopTesterApp_build_straight(self, n, 1);
            LoopTesterApp_build_connect(self, n, top);
            n = bottom;
            i += 1;
        }
        LoopTesterApp_build_connect(self, n, 1);
        parlooptrees += 1;
    }
}

    // Upstream findLoops(loopStructure).
fn LoopTesterApp_run_find_loops(self: LoopTesterApp&, loop_structure: LoopStructureGraph&) {
    let finder: HavlakLoopFinder = HavlakLoopFinder_new(self.cfg, loop_structure);
    HavlakLoopFinder_find_loops(&finder);
    HavlakLoopFinder_free_buffers(&finder);
}

    // Upstream addDummyLoops.
fn LoopTesterApp_add_dummy_loops(self: LoopTesterApp&, num_dummy_loops: i32) {
    let dummyloop: u64 = 0;
    while i32(dummyloop) < num_dummy_loops {
        LoopTesterApp_run_find_loops(self, self.lsg);
        dummyloop += 1;
    }
}

    // Upstream constructSimpleCFG.
fn LoopTesterApp_construct_simple_cfg(self: LoopTesterApp&) {
    ControlFlowGraph_create_node(self.cfg, 0);
    LoopTesterApp_build_base_loop(self, 0);
    ControlFlowGraph_create_node(self.cfg, 1);
    new_basic_block_edge(self.cfg, 0, 2);
}

    // Upstream LoopTesterApp.main.
pub fn LoopTesterApp_run(self: LoopTesterApp&, num_dummy_loops: i32, find_loop_iterations: i32, par_loops: i32, ppar_loops: i32, pppar_loops: i32) -> AppResult {
    LoopTesterApp_construct_simple_cfg(self);
    LoopTesterApp_add_dummy_loops(self, num_dummy_loops);
    LoopTesterApp_construct_cfg(self, par_loops, ppar_loops, pppar_loops);

    LoopTesterApp_run_find_loops(self, self.lsg);
    let i: u64 = 0;
    while i32(i) < find_loop_iterations {
        let tmp: LoopStructureGraph& = LoopStructureGraph_new();
        LoopTesterApp_run_find_loops(self, tmp);
        free_lsg(tmp);
        i += 1;
    }

    LoopStructureGraph_calculate_nesting_level(self.lsg);
    return AppResult(loops=LoopStructureGraph_num_loops(self.lsg), nodes=ControlFlowGraph_num_nodes(self.cfg));
}


// One complete app run (one upstream Havlak.innerBenchmarkLoop invocation).
fn benchmark(inner_iterations: i32) -> AppResult {
    let app: LoopTesterApp = LoopTesterApp_new();
    let result: AppResult = LoopTesterApp_run(&app, inner_iterations, 50, 10, 10, 5);
    free_lsg(app.lsg);
    free_cfg(app.cfg);
    return result;
}

// Decimal prefix parsing for the C atoi/atoll workload argument.
fn c_decimal(text: str) -> i64 {
    let bytes = text.as_slice();
    let i: u64 = 0;
    while i < bytes.len() && (bytes[u64(i)] == 32 || (bytes[u64(i)] >= 9 && bytes[u64(i)] <= 13)) { i += 1; }
    let negative: bool = false;
    if i < bytes.len() && (bytes[u64(i)] == b'-' || bytes[u64(i)] == b'+') {
        negative = bytes[u64(i)] == b'-';
        i += 1;
    }
    let value: i64 = 0;
    while i < bytes.len() && bytes[u64(i)] >= b'0' && bytes[u64(i)] <= b'9' {
        value = value * 10 + i64(bytes[u64(i)] - b'0');
        i += 1;
    }
    return if negative { -value } else { value };
}

fn main() {
    let ITER: u64 = 47;  // bench-scale
    let argv = args();
    if argv.len() > 1u64 {
        let requested = i32(c_decimal(argv[1u64].as_str()));
        ITER = if requested > 0 { u64(requested) } else { 0u64 };
    }
    for argument in &argv { argument.drop(); }
    argv.drop();
    let i: u64 = 0;
    while i < ITER {
        let r: AppResult = benchmark(1500);
        assert r.loops == 6102: "havlak: loop count is not correct";
        assert r.nodes == 5213: "havlak: node count is not correct";
        i += 1;
    }
}
