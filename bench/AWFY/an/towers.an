// bench/AWFY/an/towers.an — 汉诺塔指针栈模拟 (shootout towers)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/Towers.java; 本文件为本仓库改写版 (上游许可见 AWFY LICENSE.md)
// 语义权威源: bench/AWFY/c/towers.c (项目自写 C 参考)
// 规模: disks=30, 断言 moves_done == 1073741823 (2^30 - 1)。
//
// 算法: 3 根柱子各存一张 TowersDisk 链表 (按 size 从大到小, 栈顶最小)。
//       push_disk 把 disk 压到某柱 (校验 size 递增), pop_disk_from 弹出
//       栈顶, move_top_disk 完成单次移动并计数, move_disks 递归汉诺塔。
//       build_tower_at 建 0..disks 的塔, 结束后 free_pile 逐节点释放。
//       总移动次数 = 2^disks - 1。
//
// Option/T& 表示: 链表尾/空柱由 Option 表达。push_disk 接收 Option 以表示
//       C 参考实现的可空参数；pop_disk_from 在非空路径返回 T&，空柱路径
//       输出错误并终止。节点本体由 dyn T 分配并绑定 T&，free_pile 直接
//       del T&。
//
// 单一源: fat 与 raw 共用本文件。
// 合并规则: dyn 用类型推断; 需要切片处用范围视图 x[0u64..n]（两模式通用, fat 下仍受检查）。
from std.core.io import Stderr;
from std.core.env import exit;

struct TowersDisk {
    size: i32,
    next: Option<TowersDisk&>,
}

struct TowersState {
    piles: Option<TowersDisk&>[3],
    moves_done: i32,
}

fn fail(message: str) -> ! {
    Stderr.write_all(message).unwrap();
    exit(1)
}

fn push_disk(maybe_disk: Option<TowersDisk&>, pile: i32, state: TowersState&) {
    match maybe_disk {
        None => { return; },
        Some(disk) => {
            disk.next = match state.piles[u64(pile)] {
                Some(d) => {
                    if disk.size >= d.size {
                        fail("Cannot put a big disk on a smaller one\n");
                    }
                    Option<TowersDisk&>.Some(d)
                },
                None => Option<TowersDisk&>.None,
            }
            state.piles[u64(pile)] = Option<TowersDisk&>.Some(disk);
        },
    }
}

fn pop_disk_from(pile: i32, state: TowersState&) -> TowersDisk& {
    return match state.piles[u64(pile)] {
        None => fail("Attempting to remove a disk from an empty pile\n"),
        Some(tt) => {
            state.piles[u64(pile)] = match tt.next {
                Some(n) => Option<TowersDisk&>.Some(n),
                None => Option<TowersDisk&>.None,
            };
            tt.next = Option<TowersDisk&>.None;
            tt
        }
    };
}

fn move_top_disk(from_pile: i32, to_pile: i32, state: TowersState&) {
    let disk: TowersDisk& = pop_disk_from(from_pile, state);
    push_disk(Option<TowersDisk&>.Some(disk), to_pile, state);
    state.moves_done = state.moves_done + 1;
}

fn build_tower_at(pile: i32, disks: i32, state: TowersState&) {
    let i: i32 = disks;
    while i >= 0 {
        let disk: TowersDisk& = dyn TowersDisk(i, Option<TowersDisk&>.None);
        push_disk(Option<TowersDisk&>.Some(disk), pile, state);
        i -= 1;
    };
}

fn move_disks(disks: i32, from_pile: i32, to_pile: i32, state: TowersState&) {
    if disks == 1 {
        move_top_disk(from_pile, to_pile, state);
    } else {
        let other_pile: i32 = 3 - from_pile - to_pile;
        move_disks(disks - 1, from_pile, other_pile, state);
        move_top_disk(from_pile, to_pile, state);
        move_disks(disks - 1, other_pile, to_pile, state);
    }
}

fn free_pile(disk: TowersDisk&) {
    let cur: TowersDisk& = disk;
    loop {
        let next: Option<TowersDisk&> = match cur.next {
            Some(n) => Option<TowersDisk&>.Some(n),
            None => Option<TowersDisk&>.None,
        };
        // 先读 next 再释放 cur (无 UAF: next 已取, cur 释放后不再读)
        del cur;
        match next {
            Some(n) => { cur = n; },
            None => { break; },
        }
    };
}

fn benchmark() -> i32 {
    let state: TowersState& = dyn TowersState(
        [Option<TowersDisk&>.None, Option<TowersDisk&>.None, Option<TowersDisk&>.None], 0);
    build_tower_at(0, 30, state);
    move_disks(30, 0, 1, state);

    let i: u64 = 0;
    while i < 3 {
        match state.piles[i] {
            Some(p) => { free_pile(p); },
            None => {},
        }
        i += 1;
    };

    let moves: i32 = state.moves_done;
    del state;
    return moves;
}

fn main() {
    let result: i32 = benchmark();
    assert result == 1073741823: "towers: moves_done should be 1073741823";
}
