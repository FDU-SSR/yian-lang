// bench/AWFY/an/deltablue.an — DeltaBlue 增量约束求解器 (AWFY 宏基准)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/DeltaBlue.java + deltablue/*.java
//       (MIT, Copyright (c) 2001-2016 Stefan Marr; 这批文件源自 Mario Wolczko 的
//        Java/Smalltalk DeltaBlue, 许可指向已归档的 Sun Labs 页面, 见 AWFY LICENSE.md)
// 语义权威源: bench/AWFY/c/deltablue.c (C 参考实现; 与之逐项对齐, 断言值一致)
//
// 算法: DeltaBlue 增量约束求解器。Planner 维护约束图与数据流图, 用单调递增的
//       mark 值做环检测 (addPropagate/removePropagateFrom)。约束分 STRENGTH 层级
//       (REQUIRED/STRONG_DEFAULT/DEFAULT/PREFERRED/ABSOLUTE_WEAKEST...), 强度比较
//       决定传播方向 (chooseMethod)。chainTest(n): n 条 REQUIRED 等式链, 一端
//       STRONG_DEFAULT stay, 另一端 PREFERRED edit; 反复把 vars[0] 设为 i 并执行
//       plan, 断言 vars[n]==i (i=0..99)。projectionTest(n): n 组
//       src --ScaleConstraint(scale=10, offset=1000)--> dst (src 带 DEFAULT stay),
//       依次 change(src,17) / change(dst,1050) / change(scale,5) / change(offset,2000),
//       断言 dst==1170、src==5、dests[i]==(i+1)*5+1000 再 (i+1)*5+2000。
//
// YIAN 侧适配 (逐条):
//   - 无 trait object/动态分派: 上游抽象类层次
//     AbstractConstraint -> UnaryConstraint/BinaryConstraint -> Equality/Scale/Stay/Edit
//     改为 tagged enum Constraint { Equality {...}, Scale {...}, Stay {...}, Edit {...} }
//     + match 分派。上游虚方法 isInput/isSatisfied/addToGraph/removeFromGraph/
//     chooseMethod/execute/inputsDo/inputsHasOne/inputsKnown/markUnsatisfied/
//     getOutput/recalculate 各成为 Constraint 上的一个方法, 分派到对应变体;
//     Scale 的 addToGraph/removeFromGraph/inputs/recalculate 按上游覆写语义处理。
//   - Strength (Strength.java) 是 interned 常量对象, 上游只用 arithmeticValue 比较
//     (sameAs/stronger/weaker/strongest/weakest), 且 sameAs(required) 也只看算术值;
//     故这里用 i32 arithmeticValue 直接表示, 语义等价 (无对象身份依赖)。
//   - 引用不能比较相等 (== 对 T& 报 E406): 约束带自增唯一 id (Planner.next_id),
//     上游的 `c != determiningC` (addConstraintsConsumingTo/constraintsConsuming) 与
//     `determinedBy == c` (Variable.removeConstraint) 改比 id; Variable 无需身份比较。
//   - 上游 ForEachInterface/TestInterface 闭包 + forEach 改显式循环 (等价, 无闭包分配);
//     inputsKnown 直接写成「该约束所有输入都已知」的布尔合取。
//   - 上游 Vector.removeFirst 队列用「Vec + head 游标」表达 (语义与分配次数不变);
//     unsatisfied 的 sort 手写稳定插入排序, 与 Java TimSort 在
//     「stronger ? -1 : 1」比较器下的稳定性一致 (等强度保持入队顺序)。
//   - 无 GC: 每个测试结束时显式释放全部 Variable/Constraint (Java 靠 GC 回收);
//     change() 内部的 EditConstraint 在 destroyConstraint 后 del。分配次数与上游一致
//     (chainTest: n+1 Variable, n Equality + 1 Stay + 1 Edit; projectionTest:
//      2n+2 Variable, n Stay + n Scale + 4 Edit)。
//   - 上游 Planner.propagateFrom 未被 chainTest/projectionTest 使用, 本移植省略。
//
// 单一源: fat 与 raw 共用本文件; 约束/变量互相引用用 T&, 约束列表用 Vec<Constraint&>。
// 规模: 每个工作单元执行 chainTest(12000) 与 projectionTest(12000) 各一次。
// 外层重复只重复完整工作单元。
from std.core.vec import Vec;

// ── Direction (上游 deltablue/Direction.java) ──
// 上游 direction 为 null 表示约束当前未被满足; 这里用第三个变体 Unset 表示 null。
enum Flow {
    Forward,
    Backward,
    Unset,
}

// ── Strength (上游 deltablue/Strength.java) ──
// 上游 Strength 是 interned 常量, 只用 arithmeticValue 参与比较, 故这里直接用 i32。
fn strength_absolute_weakest() -> i32 { return 10000; }
fn strength_required() -> i32 { return -800; }
fn strength_strong_default() -> i32 { return -200; }
fn strength_default() -> i32 { return 0; }
fn strength_preferred() -> i32 { return -400; }

// 对应 Strength.stronger / weaker / weakest (arithmeticValue 越小越强)。
fn strength_stronger(a: i32, b: i32) -> bool { return a < b; }
fn strength_weaker(a: i32, b: i32) -> bool { return a > b; }
fn strength_weakest(a: i32, b: i32) -> i32 {
    if a > b {
        return a;
    }
    return b;
}

// ── 约束 (上游 AbstractConstraint + Unary/Binary + Equality/Scale/Stay/Edit) ──
// 上游类层次折叠为一个 tagged enum, 用 match 分派。
enum Constraint {
    Equality {
        id: u64,
        strength: i32,
        v1: Variable&,
        v2: Variable&,
        direction: Flow,
    },
    Scale {
        id: u64,
        strength: i32,
        v1: Variable&,
        v2: Variable&,
        scale: Variable&,
        offset: Variable&,
        direction: Flow,
    },
    Stay {
        id: u64,
        strength: i32,
        output: Variable&,
        satisfied: bool,
    },
    Edit {
        id: u64,
        strength: i32,
        output: Variable&,
        satisfied: bool,
    },
}

// ── Variable (上游 deltablue/Variable.java) ──
struct Variable {
    value: i32,
    constraints: Vec<Constraint&>,
    determined_by: Option<Constraint&>,
    mark: i32,
    walk_strength: i32,
    stay: bool,
}

// ── Planner (上游 deltablue/Planner.java) ──
struct Planner {
    current_mark: i32,
    next_id: u64,
}

// BinaryConstraint.chooseMethod 的共享体 (Equality/Scale 共用), 返回选定方向。
fn binary_choose(strength: i32, v1: Variable&, v2: Variable&, mark: i32) -> Flow {
    if v1.mark == mark {
        if v2.mark != mark && strength_stronger(strength, v2.walk_strength) {
            return Flow.Forward;
        }
        return Flow.Unset;
    }
    if v2.mark == mark {
        if v1.mark != mark && strength_stronger(strength, v1.walk_strength) {
            return Flow.Backward;
        }
        return Flow.Unset;
    }
    // 两变量都未被标记: 可自由选方向
    if strength_weaker(v1.walk_strength, v2.walk_strength) {
        if strength_stronger(strength, v1.walk_strength) {
            return Flow.Backward;
        }
        return Flow.Unset;
    }
    if strength_stronger(strength, v2.walk_strength) {
        return Flow.Forward;
    }
    return Flow.Unset;
}

impl Variable {
    static pub fn new() -> Variable& {
        return dyn Variable(0, Vec<Constraint&>.new(), Option<Constraint&>.None, 0, strength_absolute_weakest(), true);
    }

    // 上游 Variable.value(int)
    static pub fn value(v: i32) -> Variable& {
        return dyn Variable(v, Vec<Constraint&>.new(), Option<Constraint&>.None, 0, strength_absolute_weakest(), true);
    }

    pub fn add_constraint(c: Constraint&) {
        self.constraints.push(c);
    }

    // 上游 Vector.remove(c) (按对象身份移除第一个匹配项) + determinedBy 复位。
    pub fn remove_constraint(c: Constraint&) {
        let i: u64 = 0;
        let idx: i64 = -1;
        while i < self.constraints.len() {
            let x: Constraint& = self.constraints[i];
            if idx < 0 && x.get_id() == c.get_id() {
                idx = i64(i);
            }
            i += 1;
        }
        if idx >= 0 {
            let removed: Constraint& = self.constraints.remove(u64(idx));
        }
        match self.determined_by {
            Some(d) => {
                if d.get_id() == c.get_id() {
                    self.determined_by = Option<Constraint&>.None;
                }
            },
            None => {
            },
        }
    }
}

impl Constraint {
    pub fn get_id() -> u64 {
        return match self {
            Equality(id, strength, v1, v2, direction) => *id,
            Scale(id, strength, v1, v2, scale, offset, direction) => *id,
            Stay(id, strength, output, satisfied) => *id,
            Edit(id, strength, output, satisfied) => *id,
        };
    }

    pub fn get_strength() -> i32 {
        return match self {
            Equality(id, strength, v1, v2, direction) => *strength,
            Scale(id, strength, v1, v2, scale, offset, direction) => *strength,
            Stay(id, strength, output, satisfied) => *strength,
            Edit(id, strength, output, satisfied) => *strength,
        };
    }

    // 上游 AbstractConstraint.isInput / EditConstraint.isInput
    pub fn is_input() -> bool {
        return match self {
            Equality(id, strength, v1, v2, direction) => false,
            Scale(id, strength, v1, v2, scale, offset, direction) => false,
            Stay(id, strength, output, satisfied) => false,
            Edit(id, strength, output, satisfied) => true,
        };
    }

    // 上游 isSatisfied: 二元看 direction != null, 一元看 satisfied。
    pub fn is_satisfied() -> bool {
        return match self {
            Equality(id, strength, v1, v2, direction) => match *direction {
                Forward => true,
                Backward => true,
                Unset => false,
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => match *direction {
                Forward => true,
                Backward => true,
                Unset => false,
            },
            Stay(id, strength, output, satisfied) => *satisfied,
            Edit(id, strength, output, satisfied) => *satisfied,
        };
    }

    // 上游 addToGraph
    pub fn add_to_graph() {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                v1.add_constraint(self);
                v2.add_constraint(self);
                *direction = Flow.Unset;
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                v1.add_constraint(self);
                v2.add_constraint(self);
                scale.add_constraint(self);
                offset.add_constraint(self);
                *direction = Flow.Unset;
            },
            Stay(id, strength, output, satisfied) => {
                output.add_constraint(self);
                *satisfied = false;
            },
            Edit(id, strength, output, satisfied) => {
                output.add_constraint(self);
                *satisfied = false;
            },
        }
    }

    // 上游 removeFromGraph
    pub fn remove_from_graph() {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                v1.remove_constraint(self);
                v2.remove_constraint(self);
                *direction = Flow.Unset;
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                v1.remove_constraint(self);
                v2.remove_constraint(self);
                scale.remove_constraint(self);
                offset.remove_constraint(self);
                *direction = Flow.Unset;
            },
            Stay(id, strength, output, satisfied) => {
                output.remove_constraint(self);
                *satisfied = false;
            },
            Edit(id, strength, output, satisfied) => {
                output.remove_constraint(self);
                *satisfied = false;
            },
        }
    }

    // 上游 chooseMethod (ScaleConstraint 不覆写, 与 BinaryConstraint 相同)
    pub fn choose_method(mark: i32) {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                *direction = binary_choose(*strength, *v1, *v2, mark);
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                *direction = binary_choose(*strength, *v1, *v2, mark);
            },
            Stay(id, strength, output, satisfied) => {
                *satisfied = output.mark != mark && strength_stronger(*strength, output.walk_strength);
            },
            Edit(id, strength, output, satisfied) => {
                *satisfied = output.mark != mark && strength_stronger(*strength, output.walk_strength);
            },
        }
    }

    // 上游 execute
    pub fn execute() {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                match *direction {
                    Forward => {
                        v2.value = v1.value;
                    },
                    Backward => {
                        v1.value = v2.value;
                    },
                    Unset => {
                    },
                }
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                match *direction {
                    Forward => {
                        v2.value = v1.value * scale.value + offset.value;
                    },
                    Backward => {
                        v1.value = (v2.value - offset.value) / scale.value;
                    },
                    Unset => {
                    },
                }
            },
            Stay(id, strength, output, satisfied) => {
            },
            Edit(id, strength, output, satisfied) => {
            },
        }
    }

    // 上游 inputsDo(in -> in.setMark(mark)): 标记本约束的输入变量。
    fn mark_inputs(mark: i32) {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                match *direction {
                    Forward => {
                        v1.mark = mark;
                    },
                    Backward => {
                        v2.mark = mark;
                    },
                    Unset => {
                        v2.mark = mark;
                    },
                }
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                match *direction {
                    Forward => {
                        v1.mark = mark;
                        scale.mark = mark;
                        offset.mark = mark;
                    },
                    Backward => {
                        v2.mark = mark;
                        scale.mark = mark;
                        offset.mark = mark;
                    },
                    Unset => {
                        v2.mark = mark;
                        scale.mark = mark;
                        offset.mark = mark;
                    },
                }
            },
            Stay(id, strength, output, satisfied) => {
            },
            Edit(id, strength, output, satisfied) => {
            },
        }
    }

    // 上游 inputsKnown(mark): 所有输入都「已知」(已标记 / stay / 无约束决定)。
    pub fn inputs_known(mark: i32) -> bool {
        return match self {
            Equality(id, strength, v1, v2, direction) => {
                let input: Variable& = match *direction {
                    Forward => *v1,
                    Backward => *v2,
                    Unset => *v2,
                };
                return input.mark == mark || input.stay || input.determined_by.is_none();
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                let input: Variable& = match *direction {
                    Forward => *v1,
                    Backward => *v2,
                    Unset => *v2,
                };
                return (input.mark == mark || input.stay || input.determined_by.is_none())
                    && (scale.mark == mark || scale.stay || scale.determined_by.is_none())
                    && (offset.mark == mark || offset.stay || offset.determined_by.is_none());
            },
            Stay(id, strength, output, satisfied) => {
                // UnaryConstraint.inputsHasOne 恒为 false
                return true;
            },
            Edit(id, strength, output, satisfied) => {
                return true;
            },
        };
    }

    // 上游 markUnsatisfied
    pub fn mark_unsatisfied() {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                *direction = Flow.Unset;
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                *direction = Flow.Unset;
            },
            Stay(id, strength, output, satisfied) => {
                *satisfied = false;
            },
            Edit(id, strength, output, satisfied) => {
                *satisfied = false;
            },
        }
    }

    // 上游 getOutput
    pub fn get_output() -> Variable& {
        return match self {
            Equality(id, strength, v1, v2, direction) => match *direction {
                Forward => *v2,
                Backward => *v1,
                Unset => *v1,
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => match *direction {
                Forward => *v2,
                Backward => *v1,
                Unset => *v1,
            },
            Stay(id, strength, output, satisfied) => *output,
            Edit(id, strength, output, satisfied) => *output,
        };
    }

    // 上游 recalculate
    pub fn recalculate() {
        match self {
            Equality(id, strength, v1, v2, direction) => {
                let input: Variable& = match *direction {
                    Forward => *v1,
                    Backward => *v2,
                    Unset => *v2,
                };
                let out: Variable& = match *direction {
                    Forward => *v2,
                    Backward => *v1,
                    Unset => *v1,
                };
                out.walk_strength = strength_weakest(*strength, input.walk_strength);
                out.stay = input.stay;
                if out.stay {
                    self.execute();
                }
            },
            Scale(id, strength, v1, v2, scale, offset, direction) => {
                let input: Variable& = match *direction {
                    Forward => *v1,
                    Backward => *v2,
                    Unset => *v2,
                };
                let out: Variable& = match *direction {
                    Forward => *v2,
                    Backward => *v1,
                    Unset => *v1,
                };
                out.walk_strength = strength_weakest(*strength, input.walk_strength);
                out.stay = input.stay && scale.stay && offset.stay;
                if out.stay {
                    self.execute();
                }
            },
            Stay(id, strength, output, satisfied) => {
                output.walk_strength = *strength;
                output.stay = !self.is_input();
                if output.stay {
                    self.execute();
                }
            },
            Edit(id, strength, output, satisfied) => {
                output.walk_strength = *strength;
                output.stay = !self.is_input();
                if output.stay {
                    self.execute();
                }
            },
        }
    }

    // 上游 AbstractConstraint.satisfy
    pub fn satisfy(mark: i32, planner: Planner&) -> Option<Constraint&> {
        self.choose_method(mark);

        if self.is_satisfied() {
            // 标记输入以支持 addPropagate 的环检测
            self.mark_inputs(mark);

            let out: Variable& = self.get_output();
            let overridden: Option<Constraint&> = out.determined_by;
            match overridden {
                Some(o) => {
                    o.mark_unsatisfied();
                },
                None => {
                },
            }
            out.determined_by = Option<Constraint&>.Some(self);
            if !planner.add_propagate(self, mark) {
                assert false: "Cycle encountered";
            }
            out.mark = mark;
            return overridden;
        }

        assert self.get_strength() != strength_required(): "Could not satisfy a required constraint";
        return Option<Constraint&>.None;
    }

    // 上游 AbstractConstraint.destroyConstraint
    pub fn destroy_constraint(planner: Planner&) {
        if self.is_satisfied() {
            planner.incremental_remove(self);
        }
        self.remove_from_graph();
    }

    // ── 构造 (上游各约束构造函数: 建图 + incrementalAdd) ──

    static pub fn equality(v1: Variable&, v2: Variable&, strength: i32, planner: Planner&) -> Constraint& {
        let id: u64 = planner.new_constraint_id();
        let c: Constraint& = dyn Constraint.Equality(id, strength, v1, v2, Flow.Unset);
        c.add_to_graph();
        planner.incremental_add(c);
        return c;
    }

    static pub fn scale(v1: Variable&, scale: Variable&, offset: Variable&, v2: Variable&, strength: i32, planner: Planner&) -> Constraint& {
        let id: u64 = planner.new_constraint_id();
        let c: Constraint& = dyn Constraint.Scale(id, strength, v1, v2, scale, offset, Flow.Unset);
        c.add_to_graph();
        planner.incremental_add(c);
        return c;
    }

    static pub fn stay(output: Variable&, strength: i32, planner: Planner&) -> Constraint& {
        let id: u64 = planner.new_constraint_id();
        let c: Constraint& = dyn Constraint.Stay(id, strength, output, false);
        c.add_to_graph();
        planner.incremental_add(c);
        return c;
    }

    static pub fn edit(output: Variable&, strength: i32, planner: Planner&) -> Constraint& {
        let id: u64 = planner.new_constraint_id();
        let c: Constraint& = dyn Constraint.Edit(id, strength, output, false);
        c.add_to_graph();
        planner.incremental_add(c);
        return c;
    }
}

// 执行 plan (上游 Plan.execute: forEach(c -> c.execute()))
fn execute_plan(plan: Vec<Constraint&>) {
    let i: u64 = 0;
    while i < plan.len() {
        let c: Constraint& = plan[i];
        c.execute();
        i += 1;
    }
}

// 释放辅助 (Java 侧靠 GC; 本移植显式回收)
fn free_constraints(cons: Vec<Constraint&>) {
    let i: u64 = 0;
    while i < cons.len() {
        let c: Constraint& = cons[i];
        del c;
        i += 1;
    }
    cons.drop();
}

fn free_variables(vars: Vec<Variable&>) {
    let i: u64 = 0;
    while i < vars.len() {
        let v: Variable& = vars[i];
        v.constraints.drop();
        del v;
        i += 1;
    }
    vars.drop();
}

// unsatisfied.sort((c1,c2) -> c1.strength.stronger(c2.strength) ? -1 : 1)
// 稳定插入排序: 强度强者在前, 等强度保持入队顺序 (与 Java TimSort 稳定性一致)。
fn sort_unsatisfied(v: Vec<Constraint&>) {
    let i: u64 = 1;
    while i < v.len() {
        let key: Constraint& = v[i];
        let key_strength: i32 = key.get_strength();
        let j: i64 = i64(i) - 1;
        while j >= 0 && strength_weaker(v[u64(j)].get_strength(), key_strength) {
            v[u64(j) + 1] = v[u64(j)];
            j -= 1;
        }
        v[u64(j) + 1] = key;
        i += 1;
    }
}

impl Planner {
    static pub fn new() -> Planner& {
        return dyn Planner(1, 1u64);
    }

    // 唯一约束 id (用于身份比较, 见头部适配说明)
    pub fn new_constraint_id() -> u64 {
        self.next_id += 1u64;
        return self.next_id;
    }

    // 上游 newMark
    pub fn new_mark() -> i32 {
        self.current_mark += 1;
        return self.current_mark;
    }

    // 上游 incrementalAdd
    pub fn incremental_add(c: Constraint&) {
        let mark: i32 = self.new_mark();
        let cur: Option<Constraint&> = c.satisfy(mark, self);
        while cur.is_some() {
            let overridden: Constraint& = *cur.unwrap();
            cur = overridden.satisfy(mark, self);
        }
    }

    // 上游 incrementalRemove
    pub fn incremental_remove(c: Constraint&) {
        let out: Variable& = c.get_output();
        c.mark_unsatisfied();
        c.remove_from_graph();

        let unsatisfied: Vec<Constraint&> = self.remove_propagate_from(out);
        let i: u64 = 0;
        while i < unsatisfied.len() {
            self.incremental_add(unsatisfied[i]);
            i += 1;
        }
        unsatisfied.drop();
    }

    // 上游 addConstraintsConsumingTo(闭包 -> 显式循环)
    pub fn add_constraints_consuming_to(v: Variable&, coll: Vec<Constraint&>&) {
        let determining: Option<Constraint&> = v.determined_by;
        let i: u64 = 0;
        while i < v.constraints.len() {
            let c: Constraint& = v.constraints[i];
            let consuming: bool = c.is_satisfied();
            match determining {
                Some(d) => {
                    if d.get_id() == c.get_id() {
                        consuming = false;
                    }
                },
                None => {
                },
            }
            if consuming {
                coll.push(c);
            }
            i += 1;
        }
    }

    // 上游 makePlan (todo 用 Vec + head 游标; sources 由本函数接管并释放)
    pub fn make_plan(sources: Vec<Constraint&>) -> Vec<Constraint&> {
        let mark: i32 = self.new_mark();
        let plan: Vec<Constraint&> = Vec<Constraint&>.new();

        let head: u64 = 0;
        while head < sources.len() {
            let c: Constraint& = sources[head];
            head += 1;

            let out: Variable& = c.get_output();
            if out.mark != mark && c.inputs_known(mark) {
                // 尚未入 plan 且可入 plan
                plan.push(c);
                out.mark = mark;
                self.add_constraints_consuming_to(out, &sources);
            }
        }
        sources.drop();
        return plan;
    }

    // 上游 extractPlanFromConstraints
    pub fn extract_plan_from_constraints(constraints: Vec<Constraint&>) -> Vec<Constraint&> {
        let sources: Vec<Constraint&> = Vec<Constraint&>.new();
        let i: u64 = 0;
        while i < constraints.len() {
            let c: Constraint& = constraints[i];
            if c.is_input() && c.is_satisfied() {
                sources.push(c);
            }
            i += 1;
        }
        return self.make_plan(sources);
    }

    // 上游 addPropagate
    pub fn add_propagate(c: Constraint&, mark: i32) -> bool {
        let todo: Vec<Constraint&> = Vec<Constraint&>.new();
        todo.push(c);

        let head: u64 = 0;
        while head < todo.len() {
            let d: Constraint& = todo[head];
            head += 1;

            let out: Variable& = d.get_output();
            if out.mark == mark {
                todo.drop();
                self.incremental_remove(c);
                return false;
            }
            d.recalculate();
            self.add_constraints_consuming_to(out, &todo);
        }
        todo.drop();
        return true;
    }

    // 上游 constraintsConsuming(闭包 -> 内联) + removePropagateFrom
    pub fn remove_propagate_from(out: Variable&) -> Vec<Constraint&> {
        let unsatisfied: Vec<Constraint&> = Vec<Constraint&>.new();

        out.determined_by = Option<Constraint&>.None;
        out.walk_strength = strength_absolute_weakest();
        out.stay = true;

        let todo: Vec<Variable&> = Vec<Variable&>.new();
        todo.push(out);

        let head: u64 = 0;
        while head < todo.len() {
            let v: Variable& = todo[head];
            head += 1;

            let i: u64 = 0;
            while i < v.constraints.len() {
                let c: Constraint& = v.constraints[i];
                if !c.is_satisfied() {
                    unsatisfied.push(c);
                }
                i += 1;
            }

            let determining: Option<Constraint&> = v.determined_by;
            let j: u64 = 0;
            while j < v.constraints.len() {
                let c: Constraint& = v.constraints[j];
                let consuming: bool = c.is_satisfied();
                match determining {
                    Some(d) => {
                        if d.get_id() == c.get_id() {
                            consuming = false;
                        }
                    },
                    None => {
                    },
                }
                if consuming {
                    c.recalculate();
                    todo.push(c.get_output());
                }
                j += 1;
            }
        }
        todo.drop();

        sort_unsatisfied(unsatisfied);
        return unsatisfied;
    }

    // 上游 change
    pub fn change(var: Variable&, new_value: i32) {
        let edit_c: Constraint& = Constraint.edit(var, strength_preferred(), self);
        let edit_v: Vec<Constraint&> = Vec<Constraint&>.new();
        edit_v.push(edit_c);
        let plan: Vec<Constraint&> = self.extract_plan_from_constraints(edit_v);
        edit_v.drop();

        let i: i32 = 0;
        while i < 10 {
            var.value = new_value;
            execute_plan(plan);
            i += 1;
        }
        plan.drop();

        edit_c.destroy_constraint(self);
        del edit_c;
    }

    // 上游 chainTest: 返回校验值 (100 次迭代中 vars[n] 之和, 恒为 0+..+99 = 4950)
    static pub fn chain_test(n: i32) -> i64 {
        let planner: Planner& = Planner.new();

        let vars: Vec<Variable&> = Vec<Variable&>.new();
        let i: i32 = 0;
        while i <= n {
            vars.push(Variable.new());
            i += 1;
        }

        let cons: Vec<Constraint&> = Vec<Constraint&>.new();

        // n 条 REQUIRED 等式链
        let k: i32 = 0;
        while k < n {
            let c: Constraint& = Constraint.equality(vars[u64(k)], vars[u64(k) + 1u64], strength_required(), planner);
            cons.push(c);
            k += 1;
        }

        let stay_c: Constraint& = Constraint.stay(vars[u64(n)], strength_strong_default(), planner);
        cons.push(stay_c);
        let edit_c: Constraint& = Constraint.edit(vars[0], strength_preferred(), planner);
        cons.push(edit_c);

        let edit_v: Vec<Constraint&> = Vec<Constraint&>.new();
        edit_v.push(edit_c);
        let plan: Vec<Constraint&> = planner.extract_plan_from_constraints(edit_v);
        edit_v.drop();

        let acc: i64 = 0;
        let t: i32 = 0;
        while t < 100 {
            vars[0].value = t;
            execute_plan(plan);
            assert vars[u64(n)].value == t: "Chain test failed!";
            acc += i64(vars[u64(n)].value);
            t += 1;
        }
        plan.drop();

        edit_c.destroy_constraint(planner);

        free_constraints(cons);
        free_variables(vars);
        del planner;
        return acc;
    }

    // 上游 projectionTest: 返回校验值 (change 后各断言值 + 被检查的 dests 之和)
    static pub fn projection_test(n: i32) -> i64 {
        let planner: Planner& = Planner.new();

        let all_vars: Vec<Variable&> = Vec<Variable&>.new();
        let all_cons: Vec<Constraint&> = Vec<Constraint&>.new();
        let dests: Vec<Variable&> = Vec<Variable&>.new();

        let scale: Variable& = Variable.value(10);
        let offset: Variable& = Variable.value(1000);
        all_vars.push(scale);
        all_vars.push(offset);

        let src: Variable& = scale;
        let dst: Variable& = scale;
        let i: i32 = 1;
        while i <= n {
            let s: Variable& = Variable.value(i);
            let d: Variable& = Variable.value(i);
            all_vars.push(s);
            all_vars.push(d);
            dests.push(d);

            let stay_c: Constraint& = Constraint.stay(s, strength_default(), planner);
            all_cons.push(stay_c);
            let scale_c: Constraint& = Constraint.scale(s, scale, offset, d, strength_required(), planner);
            all_cons.push(scale_c);

            src = s;
            dst = d;
            i += 1;
        }

        let acc: i64 = 0;

        planner.change(src, 17);
        assert dst.value == 1170: "Projection test 1 failed!";
        acc += i64(dst.value);

        planner.change(dst, 1050);
        assert src.value == 5: "Projection test 2 failed!";
        acc += i64(src.value);

        planner.change(scale, 5);
        let j: i32 = 0;
        while j < n - 1 {
            let d: Variable& = dests[u64(j)];
            assert d.value == (j + 1) * 5 + 1000: "Projection test 3 failed!";
            acc += i64(d.value);
            j += 1;
        }

        planner.change(offset, 2000);
        j = 0;
        while j < n - 1 {
            let d: Variable& = dests[u64(j)];
            assert d.value == (j + 1) * 5 + 2000: "Projection test 4 failed!";
            acc += i64(d.value);
            j += 1;
        }
        acc += i64(src.value) + i64(dst.value) + i64(scale.value) + i64(offset.value);

        dests.drop();
        free_constraints(all_cons);
        free_variables(all_vars);
        del planner;
        return acc;
    }
}

fn main() {
    let ITER: u64 = 134;  // bench-scale
    let i: u64 = 0;
    while i < ITER {
        Planner.chain_test(12000);
        Planner.projection_test(12000);
        i += 1;
    }
}
