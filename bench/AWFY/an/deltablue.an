from std.core.env import args;

// bench/AWFY/an/deltablue.an: DeltaBlue incremental constraint solver (AWFY macrobenchmark).
//
// Upstream: AWFY benchmarks/Java/src/DeltaBlue.java and deltablue/*.java.
//       MIT, Copyright (c) 2001-2016 Stefan Marr; these files derive from Mario Wolczko's
//        Java/Smalltalk DeltaBlue, licensed through an archived Sun Labs page; see AWFY LICENSE.md.
// Semantic reference: bench/AWFY/c/deltablue.c; operations and assertion values match.
//
// Algorithm: Planner maintains constraint/dataflow graphs and detects cycles using monotonic
//       marks in addPropagate/removePropagateFrom. Constraints have STRENGTH levels
//       (REQUIRED/STRONG_DEFAULT/DEFAULT/PREFERRED/ABSOLUTE_WEAKEST...), with comparisons
//       selecting propagation direction via chooseMethod. chainTest(n) creates n REQUIRED equalities,
//       a STRONG_DEFAULT stay at one end and a PREFERRED edit at the other; set vars[0]=i, execute
//       the plan, and assert vars[n]==i for i=0..99. projectionTest(n) creates n groups:
//       src --ScaleConstraint(scale=10,offset=1000)--> dst, with DEFAULT stays on src.
//       Apply change(src,17), change(dst,1050), change(scale,5), and change(offset,2000),
//       asserting dst==1170, src==5, then dests[i]==(i+1)*5+1000 and (i+1)*5+2000.
//
// YIAN implementation:
//   - Constraint is a tagged enum with Equality/Scale/Stay/Edit variants and variant-based dispatch.
//       Scale's addToGraph/removeFromGraph/inputs/recalculate preserve its constraint rules.
//   - Upstream Strength uses interned constants, compared only through arithmeticValue
//       (sameAs/stronger/weaker/strongest/weakest), including sameAs(required).
//       Represent Strength by i32 arithmeticValue without object identity.
//   - Planner.next_id assigns unique constraint IDs for identity comparison.
//   - Explicit loops replace ForEachInterface/TestInterface closures;
//       inputsKnown is a conjunction requiring every input to be known.
//   - Queues use Vec plus a head cursor; stable insertion sort orders unsatisfied constraints,
//       matching Java TimSort under stronger ? -1 : 1 and preserving equal-strength insertion order.
//   - Release all Variables/Constraints after each test; change() deletes its EditConstraint
//       after destroyConstraint. Allocation counts match upstream.
//     (chainTest: n+1 Variable, n Equality + 1 Stay + 1 Edit; projectionTest:
//      2n+2 Variable, n Stay + n Scale + 4 Edit)。
//   - Planner.propagateFrom is outside the chainTest/projectionTest work-unit call paths.
//
// Both modes share this source: T& links constraints/variables; lists use Vec<Constraint&>.
// Scale: each work unit runs chainTest(12000) and projectionTest(12000) once.
// Outer repetitions repeat complete work units.

// -- Direction (upstream deltablue/Direction.java) --
// Flow.Unset means the constraint has no satisfied propagation direction.
enum Flow {
    Forward,
    Backward,
    Unset,
}

// -- Strength (upstream deltablue/Strength.java) --
// Upstream interned Strength constants compare only arithmeticValue, represented here as i32.
const S_ABSOLUTE_WEAKEST: i32 = 10000;
const S_REQUIRED: i32 = -800;
const S_STRONG_DEFAULT: i32 = -200;
const S_DEFAULT: i32 = 0;
const S_PREFERRED: i32 = -400;

// Strength.stronger/weaker/weakest: lower arithmeticValue means stronger.
fn strength_stronger(a: i32, b: i32) -> bool { return a < b; }
fn strength_weaker(a: i32, b: i32) -> bool { return a > b; }
fn strength_weakest(a: i32, b: i32) -> i32 {
    if a > b {
        return a;
    }
    return b;
}

// -- Constraints (upstream AbstractConstraint, Unary/Binary, Equality/Scale/Stay/Edit) --
// Represent the upstream class hierarchy as one tagged enum with match dispatch.
enum Constraint {
    Equality {
        id: u64,
        strength: i32,
        v1: Variable&,
        v2: Variable&,
        direction: Flow,
    },
    Scale {
        id: u64,
        strength: i32,
        v1: Variable&,
        v2: Variable&,
        scale: Variable&,
        offset: Variable&,
        direction: Flow,
    },
    Stay {
        id: u64,
        strength: i32,
        output: Variable&,
        satisfied: bool,
    },
    Edit {
        id: u64,
        strength: i32,
        output: Variable&,
        satisfied: bool,
    },
}

// -- Variable (upstream deltablue/Variable.java) --
struct Variable {
    value: i32,
    constraints: Vec<Constraint&>,
    determined_by: Option<Constraint&>,
    mark: i32,
    walk_strength: i32,
    stay: bool,
}

// -- Planner (upstream deltablue/Planner.java) --
struct Planner {
    current_mark: i32,
    next_id: u64,
}

// Shared BinaryConstraint.chooseMethod logic for Equality/Scale; return the selected direction.
fn binary_choose(strength: i32, v1: Variable&, v2: Variable&, mark: i32) -> Flow {
    if v1.mark == mark {
        if v2.mark != mark && strength_stronger(strength, v2.walk_strength) {
            return Flow.Forward;
        }
        return Flow.Unset;
    }
    if v2.mark == mark {
        if v1.mark != mark && strength_stronger(strength, v1.walk_strength) {
            return Flow.Backward;
        }
        return Flow.Unset;
    }
    // Neither variable is marked, so either direction can be chosen.
    if strength_weaker(v1.walk_strength, v2.walk_strength) {
        if strength_stronger(strength, v1.walk_strength) {
            return Flow.Backward;
        }
        return Flow.Unset;
    }
    if strength_stronger(strength, v2.walk_strength) {
        return Flow.Forward;
    }
    return Flow.Unset;
}


pub fn Variable_new() -> Variable& {
    return dyn Variable(0, Vec<Constraint&>.new(), Option<Constraint&>.None, 0, S_ABSOLUTE_WEAKEST, true);
}

    // Upstream Variable.value(int).
pub fn Variable_value(v: i32) -> Variable& {
    return dyn Variable(v, Vec<Constraint&>.new(), Option<Constraint&>.None, 0, S_ABSOLUTE_WEAKEST, true);
}

pub fn Variable_add_constraint(self: Variable&, c: Constraint&) {
    self.constraints.push(c);
}

    // Upstream Vector.remove(c): remove the first identity match and reset determinedBy.
pub fn Variable_remove_constraint(self: Variable&, c: Constraint&) {
    let i: u64 = 0;
    let idx: i32 = -1;
    while i < self.constraints.len() {
        let x: Constraint& = self.constraints[u64(i)];
        if idx < 0 && Constraint_get_id(x) == Constraint_get_id(c) {
            idx = i32(i);
        }
        i += 1;
    }
    if idx >= 0 {
        let removed: Constraint& = self.constraints.remove(u64(idx));
    }
    match self.determined_by {
        Some(d) => {
            if Constraint_get_id(d) == Constraint_get_id(c) {
                self.determined_by = Option<Constraint&>.None;
            }
        },
        None => {
        },
    }
}



pub fn Constraint_get_id(self: Constraint&) -> u64 {
    return match self {
        Equality(id, strength, v1, v2, direction) => *id,
        Scale(id, strength, v1, v2, scale, offset, direction) => *id,
        Stay(id, strength, output, satisfied) => *id,
        Edit(id, strength, output, satisfied) => *id,
    };
}

pub fn Constraint_get_strength(self: Constraint&) -> i32 {
    return match self {
        Equality(id, strength, v1, v2, direction) => *strength,
        Scale(id, strength, v1, v2, scale, offset, direction) => *strength,
        Stay(id, strength, output, satisfied) => *strength,
        Edit(id, strength, output, satisfied) => *strength,
    };
}

    // Upstream AbstractConstraint.isInput / EditConstraint.isInput.
pub fn Constraint_is_input(self: Constraint&) -> bool {
    return match self {
        Equality(id, strength, v1, v2, direction) => false,
        Scale(id, strength, v1, v2, scale, offset, direction) => false,
        Stay(id, strength, output, satisfied) => false,
        Edit(id, strength, output, satisfied) => true,
    };
}

    // Upstream isSatisfied: binary direction != null, unary satisfied flag.
pub fn Constraint_is_satisfied(self: Constraint&) -> bool {
    return match self {
        Equality(id, strength, v1, v2, direction) => match *direction {
            Forward => true,
            Backward => true,
            Unset => false,
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => match *direction {
            Forward => true,
            Backward => true,
            Unset => false,
        },
        Stay(id, strength, output, satisfied) => *satisfied,
        Edit(id, strength, output, satisfied) => *satisfied,
    };
}

    // Upstream addToGraph.
pub fn Constraint_add_to_graph(self: Constraint&) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            Variable_add_constraint(*v1, self);
            Variable_add_constraint(*v2, self);
            *direction = Flow.Unset;
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            Variable_add_constraint(*v1, self);
            Variable_add_constraint(*v2, self);
            Variable_add_constraint(*scale, self);
            Variable_add_constraint(*offset, self);
            *direction = Flow.Unset;
        },
        Stay(id, strength, output, satisfied) => {
            Variable_add_constraint(*output, self);
            *satisfied = false;
        },
        Edit(id, strength, output, satisfied) => {
            Variable_add_constraint(*output, self);
            *satisfied = false;
        },
    }
}

    // Upstream removeFromGraph.
pub fn Constraint_remove_from_graph(self: Constraint&) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            Variable_remove_constraint(*v1, self);
            Variable_remove_constraint(*v2, self);
            *direction = Flow.Unset;
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            Variable_remove_constraint(*v1, self);
            Variable_remove_constraint(*v2, self);
            Variable_remove_constraint(*scale, self);
            Variable_remove_constraint(*offset, self);
            *direction = Flow.Unset;
        },
        Stay(id, strength, output, satisfied) => {
            Variable_remove_constraint(*output, self);
            *satisfied = false;
        },
        Edit(id, strength, output, satisfied) => {
            Variable_remove_constraint(*output, self);
            *satisfied = false;
        },
    }
}

    // Upstream chooseMethod; ScaleConstraint inherits BinaryConstraint's implementation.
pub fn Constraint_choose_method(self: Constraint&, mark: i32) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            *direction = binary_choose(*strength, *v1, *v2, mark);
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            *direction = binary_choose(*strength, *v1, *v2, mark);
        },
        Stay(id, strength, output, satisfied) => {
            *satisfied = output.mark != mark && strength_stronger(*strength, output.walk_strength);
        },
        Edit(id, strength, output, satisfied) => {
            *satisfied = output.mark != mark && strength_stronger(*strength, output.walk_strength);
        },
    }
}

    // Upstream execute.
pub fn Constraint_execute(self: Constraint&) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            match *direction {
                Forward => {
                    v2.value = v1.value;
                },
                Backward => {
                    v1.value = v2.value;
                },
                Unset => {
                },
            }
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            match *direction {
                Forward => {
                    v2.value = v1.value * scale.value + offset.value;
                },
                Backward => {
                    v1.value = (v2.value - offset.value) / scale.value;
                },
                Unset => {
                },
            }
        },
        Stay(id, strength, output, satisfied) => {
        },
        Edit(id, strength, output, satisfied) => {
        },
    }
}

    // Upstream inputsDo(in -> in.setMark(mark)): mark this constraint's input variables.
fn Constraint_mark_inputs(self: Constraint&, mark: i32) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            match *direction {
                Forward => {
                    v1.mark = mark;
                },
                Backward => {
                    v2.mark = mark;
                },
                Unset => {
                    v2.mark = mark;
                },
            }
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            match *direction {
                Forward => {
                    v1.mark = mark;
                    scale.mark = mark;
                    offset.mark = mark;
                },
                Backward => {
                    v2.mark = mark;
                    scale.mark = mark;
                    offset.mark = mark;
                },
                Unset => {
                    v2.mark = mark;
                    scale.mark = mark;
                    offset.mark = mark;
                },
            }
        },
        Stay(id, strength, output, satisfied) => {
        },
        Edit(id, strength, output, satisfied) => {
        },
    }
}

    // Upstream inputsKnown(mark): every input is marked, has a stay, or is not constraint-determined.
pub fn Constraint_inputs_known(self: Constraint&, mark: i32) -> bool {
    return match self {
        Equality(id, strength, v1, v2, direction) => {
            let input: Variable& = match *direction {
                Forward => *v1,
                Backward => *v2,
                Unset => *v2,
            };
            return input.mark == mark || input.stay || input.determined_by.is_none();
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            let input: Variable& = match *direction {
                Forward => *v1,
                Backward => *v2,
                Unset => *v2,
            };
            return (input.mark == mark || input.stay || input.determined_by.is_none())
                && (scale.mark == mark || scale.stay || scale.determined_by.is_none())
                && (offset.mark == mark || offset.stay || offset.determined_by.is_none());
        },
        Stay(id, strength, output, satisfied) => {
            // UnaryConstraint.inputsHasOne is always false.
            return true;
        },
        Edit(id, strength, output, satisfied) => {
            return true;
        },
    };
}

    // Upstream markUnsatisfied.
pub fn Constraint_mark_unsatisfied(self: Constraint&) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            *direction = Flow.Unset;
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            *direction = Flow.Unset;
        },
        Stay(id, strength, output, satisfied) => {
            *satisfied = false;
        },
        Edit(id, strength, output, satisfied) => {
            *satisfied = false;
        },
    }
}

    // Upstream getOutput.
pub fn Constraint_get_output(self: Constraint&) -> Variable& {
    return match self {
        Equality(id, strength, v1, v2, direction) => match *direction {
            Forward => *v2,
            Backward => *v1,
            Unset => *v1,
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => match *direction {
            Forward => *v2,
            Backward => *v1,
            Unset => *v1,
        },
        Stay(id, strength, output, satisfied) => *output,
        Edit(id, strength, output, satisfied) => *output,
    };
}

    // Upstream recalculate.
pub fn Constraint_recalculate(self: Constraint&) {
    match self {
        Equality(id, strength, v1, v2, direction) => {
            let input: Variable& = match *direction {
                Forward => *v1,
                Backward => *v2,
                Unset => *v2,
            };
            let out: Variable& = match *direction {
                Forward => *v2,
                Backward => *v1,
                Unset => *v1,
            };
            out.walk_strength = strength_weakest(*strength, input.walk_strength);
            out.stay = input.stay;
            if out.stay {
                Constraint_execute(self);
            }
        },
        Scale(id, strength, v1, v2, scale, offset, direction) => {
            let input: Variable& = match *direction {
                Forward => *v1,
                Backward => *v2,
                Unset => *v2,
            };
            let out: Variable& = match *direction {
                Forward => *v2,
                Backward => *v1,
                Unset => *v1,
            };
            out.walk_strength = strength_weakest(*strength, input.walk_strength);
            out.stay = input.stay && scale.stay && offset.stay;
            if out.stay {
                Constraint_execute(self);
            }
        },
        Stay(id, strength, output, satisfied) => {
            output.walk_strength = *strength;
            output.stay = !Constraint_is_input(self);
            if output.stay {
                Constraint_execute(self);
            }
        },
        Edit(id, strength, output, satisfied) => {
            output.walk_strength = *strength;
            output.stay = !Constraint_is_input(self);
            if output.stay {
                Constraint_execute(self);
            }
        },
    }
}

    // Upstream AbstractConstraint.satisfy.
pub fn Constraint_satisfy(self: Constraint&, mark: i32, planner: Planner&) -> Option<Constraint&> {
    Constraint_choose_method(self, mark);

    if Constraint_is_satisfied(self) {
        // Mark inputs for addPropagate's cycle detection.
        Constraint_mark_inputs(self, mark);

        let out: Variable& = Constraint_get_output(self);
        let overridden: Option<Constraint&> = out.determined_by;
        match overridden {
            Some(o) => {
                Constraint_mark_unsatisfied(o);
            },
            None => {
            },
        }
        out.determined_by = Option<Constraint&>.Some(self);
        if !Planner_add_propagate(planner, self, mark) {
            assert false: "Cycle encountered";
        }
        out.mark = mark;
        return overridden;
    }

    assert Constraint_get_strength(self) != S_REQUIRED: "Could not satisfy a required constraint";
    return Option<Constraint&>.None;
}

    // Upstream AbstractConstraint.destroyConstraint.
pub fn Constraint_destroy_constraint(self: Constraint&, planner: Planner&) {
    if Constraint_is_satisfied(self) {
        Planner_incremental_remove(planner, self);
    }
    Constraint_remove_from_graph(self);
}

    // -- Construction: upstream constructors build the graph and call incrementalAdd --

pub fn Constraint_equality(v1: Variable&, v2: Variable&, strength: i32, planner: Planner&) -> Constraint& {
    let id: u64 = Planner_new_constraint_id(planner);
    let c: Constraint& = dyn Constraint.Equality(id, strength, v1, v2, Flow.Unset);
    Constraint_add_to_graph(c);
    Planner_incremental_add(planner, c);
    return c;
}

pub fn Constraint_scale(v1: Variable&, scale: Variable&, offset: Variable&, v2: Variable&, strength: i32, planner: Planner&) -> Constraint& {
    let id: u64 = Planner_new_constraint_id(planner);
    let c: Constraint& = dyn Constraint.Scale(id, strength, v1, v2, scale, offset, Flow.Unset);
    Constraint_add_to_graph(c);
    Planner_incremental_add(planner, c);
    return c;
}

pub fn Constraint_stay(output: Variable&, strength: i32, planner: Planner&) -> Constraint& {
    let id: u64 = Planner_new_constraint_id(planner);
    let c: Constraint& = dyn Constraint.Stay(id, strength, output, false);
    Constraint_add_to_graph(c);
    Planner_incremental_add(planner, c);
    return c;
}

pub fn Constraint_edit(output: Variable&, strength: i32, planner: Planner&) -> Constraint& {
    let id: u64 = Planner_new_constraint_id(planner);
    let c: Constraint& = dyn Constraint.Edit(id, strength, output, false);
    Constraint_add_to_graph(c);
    Planner_incremental_add(planner, c);
    return c;
}


// Execute the plan (upstream Plan.execute: forEach(c -> c.execute())).
fn execute_plan(plan: Vec<Constraint&>) {
    let i: u64 = 0;
    while i < plan.len() {
        let c: Constraint& = plan[u64(i)];
        Constraint_execute(c);
        i += 1;
    }
}

// Release helpers (Java uses GC; this port releases explicitly).
fn free_constraints(cons: Vec<Constraint&>) {
    let i: u64 = 0;
    while i < cons.len() {
        let c: Constraint& = cons[u64(i)];
        del c;
        i += 1;
    }
    cons.drop();
}

fn free_variables(vars: Vec<Variable&>) {
    let i: u64 = 0;
    while i < vars.len() {
        let v: Variable& = vars[u64(i)];
        v.constraints.drop();
        del v;
        i += 1;
    }
    vars.drop();
}

// unsatisfied.sort((c1,c2) -> c1.strength.stronger(c2.strength) ? -1 : 1)
// Stable insertion sort: stronger first, preserving equal-strength enqueue order as Java TimSort does.
fn sort_unsatisfied(v: Vec<Constraint&>) {
    let i: u64 = 1;
    while i < v.len() {
        let key: Constraint& = v[u64(i)];
        let key_strength: i32 = Constraint_get_strength(key);
        let j: u64 = i;
        while j > 0 && strength_weaker(Constraint_get_strength(v[u64(j - 1)]), key_strength) {
            v[u64(j)] = v[u64(j - 1)];
            j -= 1;
        }
        v[u64(j)] = key;
        i += 1;
    }
}


pub fn Planner_new() -> Planner& {
    return dyn Planner(1, 1u64);
}

    // Unique constraint ID for identity comparison.
pub fn Planner_new_constraint_id(self: Planner&) -> u64 {
    self.next_id += 1u64;
    return self.next_id;
}

    // Upstream newMark.
pub fn Planner_new_mark(self: Planner&) -> i32 {
    self.current_mark += 1;
    return self.current_mark;
}

    // Upstream incrementalAdd.
pub fn Planner_incremental_add(self: Planner&, c: Constraint&) {
    let mark: i32 = Planner_new_mark(self);
    let cur: Option<Constraint&> = Constraint_satisfy(c, mark, self);
    while cur.is_some() {
        let overridden: Constraint& = *cur.unwrap();
        cur = Constraint_satisfy(overridden, mark, self);
    }
}

    // Upstream incrementalRemove.
pub fn Planner_incremental_remove(self: Planner&, c: Constraint&) {
    let out: Variable& = Constraint_get_output(c);
    Constraint_mark_unsatisfied(c);
    Constraint_remove_from_graph(c);

    let unsatisfied: Vec<Constraint&> = Planner_remove_propagate_from(self, out);
    let i: u64 = 0;
    while i < unsatisfied.len() {
        Planner_incremental_add(self, unsatisfied[u64(i)]);
        i += 1;
    }
    unsatisfied.drop();
}

    // Upstream addConstraintsConsumingTo, using an explicit loop instead of a closure.
pub fn Planner_add_constraints_consuming_to(self: Planner&, v: Variable&, coll: Vec<Constraint&>&) {
    let determining: Option<Constraint&> = v.determined_by;
    let i: u64 = 0;
    while i < v.constraints.len() {
        let c: Constraint& = v.constraints[u64(i)];
        let consuming: bool = Constraint_is_satisfied(c);
        match determining {
            Some(d) => {
                if Constraint_get_id(d) == Constraint_get_id(c) {
                    consuming = false;
                }
            },
            None => {
            },
        }
        if consuming {
            coll.push(c);
        }
        i += 1;
    }
}

    // Upstream makePlan: todo uses Vec plus head; this function takes ownership of sources and releases it.
pub fn Planner_make_plan(self: Planner&, sources: Vec<Constraint&>) -> Vec<Constraint&> {
    let mark: i32 = Planner_new_mark(self);
    let plan: Vec<Constraint&> = Vec<Constraint&>.new();

    let head: u64 = 0;
    while head < sources.len() {
        let c: Constraint& = sources[u64(head)];
        head += 1;

        let out: Variable& = Constraint_get_output(c);
        if out.mark != mark && Constraint_inputs_known(c, mark) {
            // Not yet in the plan, but eligible for inclusion.
            plan.push(c);
            out.mark = mark;
            Planner_add_constraints_consuming_to(self, out, &sources);
        }
    }
    sources.drop();
    return plan;
}

    // Upstream extractPlanFromConstraints.
pub fn Planner_extract_plan_from_constraints(self: Planner&, constraints: Vec<Constraint&>) -> Vec<Constraint&> {
    let sources: Vec<Constraint&> = Vec<Constraint&>.new();
    let i: u64 = 0;
    while i < constraints.len() {
        let c: Constraint& = constraints[u64(i)];
        if Constraint_is_input(c) && Constraint_is_satisfied(c) {
            sources.push(c);
        }
        i += 1;
    }
    return Planner_make_plan(self, sources);
}

    // Upstream addPropagate.
pub fn Planner_add_propagate(self: Planner&, c: Constraint&, mark: i32) -> bool {
    let todo: Vec<Constraint&> = Vec<Constraint&>.new();
    todo.push(c);

    let head: u64 = 0;
    while head < todo.len() {
        let d: Constraint& = todo[u64(head)];
        head += 1;

        let out: Variable& = Constraint_get_output(d);
        if out.mark == mark {
            todo.drop();
            Planner_incremental_remove(self, c);
            return false;
        }
        Constraint_recalculate(d);
        Planner_add_constraints_consuming_to(self, out, &todo);
    }
    todo.drop();
    return true;
}

    // Upstream constraintsConsuming inlined, followed by removePropagateFrom.
pub fn Planner_remove_propagate_from(self: Planner&, out: Variable&) -> Vec<Constraint&> {
    let unsatisfied: Vec<Constraint&> = Vec<Constraint&>.new();

    out.determined_by = Option<Constraint&>.None;
    out.walk_strength = S_ABSOLUTE_WEAKEST;
    out.stay = true;

    let todo: Vec<Variable&> = Vec<Variable&>.new();
    todo.push(out);

    let head: u64 = 0;
    while head < todo.len() {
        let v: Variable& = todo[u64(head)];
        head += 1;

        let i: u64 = 0;
        while i < v.constraints.len() {
            let c: Constraint& = v.constraints[u64(i)];
            if !Constraint_is_satisfied(c) {
                unsatisfied.push(c);
            }
            i += 1;
        }

        let determining: Option<Constraint&> = v.determined_by;
        let j: u64 = 0;
        while j < v.constraints.len() {
            let c: Constraint& = v.constraints[u64(j)];
            let consuming: bool = Constraint_is_satisfied(c);
            match determining {
                Some(d) => {
                    if Constraint_get_id(d) == Constraint_get_id(c) {
                        consuming = false;
                    }
                },
                None => {
                },
            }
            if consuming {
                Constraint_recalculate(c);
                todo.push(Constraint_get_output(c));
            }
            j += 1;
        }
    }
    todo.drop();

    sort_unsatisfied(unsatisfied);
    return unsatisfied;
}

    // Upstream change.
pub fn Planner_change(self: Planner&, var: Variable&, new_value: i32) {
    let edit_c: Constraint& = Constraint_edit(var, S_PREFERRED, self);
    let edit_v: Vec<Constraint&> = Vec<Constraint&>.new();
    edit_v.push(edit_c);
    let plan: Vec<Constraint&> = Planner_extract_plan_from_constraints(self, edit_v);
    edit_v.drop();

    let i: u64 = 0;
    while i32(i) < 10 {
        var.value = new_value;
        execute_plan(plan);
        i += 1;
    }
    plan.drop();

    Constraint_destroy_constraint(edit_c, self);
    del edit_c;
}

    // Upstream chainTest: return the sum of vars[n] over 100 iterations, 0+...+99=4950.
pub fn Planner_chain_test(n: i32) -> i64 {
    let planner: Planner& = Planner_new();

    let vars: Vec<Variable&> = Vec<Variable&>.new();
    let i: u64 = 0;
    while i32(i) <= n {
        vars.push(Variable_new());
        i += 1;
    }

    let cons: Vec<Constraint&> = Vec<Constraint&>.new();

    // Chain of n REQUIRED equalities.
    let k: u64 = 0;
    while i32(k) < n {
        let c: Constraint& = Constraint_equality(vars[u64(i32(k))], vars[u64(u64(i32(k)) + 1u64)], S_REQUIRED, planner);
        cons.push(c);
        k += 1;
    }

    let stay_c: Constraint& = Constraint_stay(vars[u64(n)], S_STRONG_DEFAULT, planner);
    cons.push(stay_c);
    let edit_c: Constraint& = Constraint_edit(vars[u64(0)], S_PREFERRED, planner);
    cons.push(edit_c);

    let edit_v: Vec<Constraint&> = Vec<Constraint&>.new();
    edit_v.push(edit_c);
    let plan: Vec<Constraint&> = Planner_extract_plan_from_constraints(planner, edit_v);
    edit_v.drop();

    let acc: i64 = 0;
    let t: u64 = 0;
    while i32(t) < 100 {
        vars[u64(0)].value = i32(t);
        execute_plan(plan);
        assert vars[u64(n)].value == i32(t): "Chain test failed!";
        acc += i64(vars[u64(n)].value);
        t += 1;
    }
    plan.drop();

    Constraint_destroy_constraint(edit_c, planner);

    free_constraints(cons);
    free_variables(vars);
    del planner;
    return acc;
}

    // Upstream projectionTest: return checked values after change plus the sum of inspected dests.
pub fn Planner_projection_test(n: i32) -> i64 {
    let planner: Planner& = Planner_new();

    let all_vars: Vec<Variable&> = Vec<Variable&>.new();
    let all_cons: Vec<Constraint&> = Vec<Constraint&>.new();
    let dests: Vec<Variable&> = Vec<Variable&>.new();

    let scale: Variable& = Variable_value(10);
    let offset: Variable& = Variable_value(1000);
    all_vars.push(scale);
    all_vars.push(offset);

    let src: Variable& = scale;
    let dst: Variable& = scale;
    let i: u64 = 1;
    while i32(i) <= n {
        let s: Variable& = Variable_value(i32(i));
        let d: Variable& = Variable_value(i32(i));
        all_vars.push(s);
        all_vars.push(d);
        dests.push(d);

        let stay_c: Constraint& = Constraint_stay(s, S_DEFAULT, planner);
        all_cons.push(stay_c);
        let scale_c: Constraint& = Constraint_scale(s, scale, offset, d, S_REQUIRED, planner);
        all_cons.push(scale_c);

        src = s;
        dst = d;
        i += 1;
    }

    let acc: i64 = 0;

    Planner_change(planner, src, 17);
    assert dst.value == 1170: "Projection test 1 failed!";
    acc += i64(dst.value);

    Planner_change(planner, dst, 1050);
    assert src.value == 5: "Projection test 2 failed!";
    acc += i64(src.value);

    Planner_change(planner, scale, 5);
    let j: u64 = 0;
    while i32(j) < n - 1 {
        let d: Variable& = dests[u64(i32(j))];
        assert d.value == (i32(j) + 1) * 5 + 1000: "Projection test 3 failed!";
        acc += i64(d.value);
        j += 1;
    }

    Planner_change(planner, offset, 2000);
    j = 0;
    while i32(j) < n - 1 {
        let d: Variable& = dests[u64(i32(j))];
        assert d.value == (i32(j) + 1) * 5 + 2000: "Projection test 4 failed!";
        acc += i64(d.value);
        j += 1;
    }
    acc += i64(src.value) + i64(dst.value) + i64(scale.value) + i64(offset.value);

    dests.drop();
    free_constraints(all_cons);
    free_variables(all_vars);
    del planner;
    return acc;
}


// Decimal prefix parsing for the C atoi/atoll workload argument.
fn c_decimal(text: str) -> i64 {
    let bytes = text.as_slice();
    let i: u64 = 0;
    while i < bytes.len() && (bytes[u64(i)] == 32 || (bytes[u64(i)] >= 9 && bytes[u64(i)] <= 13)) { i += 1; }
    let negative: bool = false;
    if i < bytes.len() && (bytes[u64(i)] == b'-' || bytes[u64(i)] == b'+') {
        negative = bytes[u64(i)] == b'-';
        i += 1;
    }
    let value: i64 = 0;
    while i < bytes.len() && bytes[u64(i)] >= b'0' && bytes[u64(i)] <= b'9' {
        value = value * 10 + i64(bytes[u64(i)] - b'0');
        i += 1;
    }
    return if negative { -value } else { value };
}

fn main() {
    let ITER: u64 = 134;  // bench-scale
    let argv = args();
    if argv.len() > 1u64 {
        let requested = i32(c_decimal(argv[1u64].as_str()));
        ITER = if requested > 0 { u64(requested) } else { 0u64 };
    }
    for argument in &argv { argument.drop(); }
    argv.drop();
    let i: u64 = 0;
    while i < ITER {
        Planner_chain_test(12000);
        Planner_projection_test(12000);
        i += 1;
    }
}
