// bench/AWFY/an/storage.an — 递归数组树分配/释放 (shootout storage)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/Storage.java; 本文件为本仓库改写版 (上游许可见 AWFY LICENSE.md)
// 语义权威源: bench/AWFY/c/storage.c (项目自写 C 参考)
// 规模: depth=7、内部节点分支数为 4, 断言 count_arrays == 5461。
//
// 算法: build_tree_depth 递归建树 — depth==1 时按 LCG 随机分配
//       (1..10) 个叶数组 (children=null), 否则分配 4 个内部节点并在
//       children 挂子数组。每次调用计数 +1 (count_arrays)。free_tree
//       递归释放全部子数组。随机数使用官方 16 位 LCG。
//
// 表示: children 字段为 Option (叶子数组 children=None); free_tree 经取址
//       参数 + is_some 判定。children 元素类型为 Option<array_tree[]>
//       (切片自带长度, niche 编码支持); build_tree_depth 直绑切片, free_tree
//       遍历 view.len() 后 del view 整块归还, 节点本体保持 dyn 数组分配 (T[])。
//
// 模式专源: 本文件供 fat 模式使用; raw 下 T*→T[] 无隐式转换, 每次分配都要
//       显式构造切片, 故 raw 使用同目录的 storage.raw.an。
struct array_tree {
    children: Option<array_tree[]>,
    child_count: i32,
}

struct Random {
    stage: u64,
}

fn Random_init(r: Random&, seed: u64) {
    r.stage = seed;
}

fn Random_next(r: Random&) -> u64 {
    r.stage = (r.stage * 1309u64 + 13849u64) & 65535u64;
    return r.stage;
}

fn build_tree_depth(depth: i32, random: Random&, count: i64&, out_count: i32&) -> Option<array_tree[]> {
    *count += 1;

    if depth == 1 {
        let n: u64 = Random_next(random) % 10 + 1;
        let arr: array_tree[] = dyn[n] array_tree(Option<array_tree[]>.None, 0);
        let i: u64 = 0;
        while i < n {
            arr[i].children = Option<array_tree[]>.None;
            arr[i].child_count = 0;
            i += 1;
        };
        *out_count = i32(n);
        return Option<array_tree[]>.Some(arr);
    }

    let n: u64 = 4;
    let arr: array_tree[] = dyn[n] array_tree(Option<array_tree[]>.None, 0);
    let i: u64 = 0;
    while i < n {
        let child_count: i32 = 0;
        arr[i].children = build_tree_depth(depth - 1, random, count, &child_count);
        arr[i].child_count = child_count;
        i += 1;
    };
    *out_count = i32(n);
    return Option<array_tree[]>.Some(arr);
}

fn free_tree(arr: Option<array_tree[]>) {
    if arr.is_none() {
        return;
    }
    let view: array_tree[] = *arr.unwrap();
    let i: u64 = 0;
    while i < view.len() {
        if view[i].children.is_some() && view[i].child_count > 0 {
            free_tree(view[i].children);
        }
        i += 1;
    };
    del view;
}

fn benchmark_storage(root_depth: i32) -> i64 {
    let random: Random& = dyn Random(74755);
    Random_init(random, 74755);

    let count: i64 = 0;
    let root_count: i32 = 0;
    let result: Option<array_tree[]> = build_tree_depth(root_depth, random, &count, &root_count);

    free_tree(result);
    del random;

    return count;
}

fn main() {
    let ITER: u64 = 9885;  // bench-scale
    let iter: u64 = 0;
    while iter < ITER {
        let result: i64 = benchmark_storage(7);
        assert result == 5461: "storage count not expected";
        iter += 1;
    }
}
