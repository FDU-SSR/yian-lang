// bench/AWFY/an/permute.an — 全排列递归交换 (shootout permute)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/Permute.java; 本文件为本仓库改写版 (上游许可见 AWFY LICENSE.md)
// 语义权威源: bench/AWFY/c/permute.c (项目自写 C 参考)
// 规模: n=11, 断言 count == 823059745。
//
// 算法: permute_inner(n, v) 对长度 n 的前缀做递归交换排列, 每次调用
//       count+=1; n==0 时仅计数返回, 否则先递归 (n-1) 再对 i 从 n-1
//       递减到 0 做 swap+递归+swap。swap_indices 通过指针索引交换
//       v[i] 与 v[j]。总调用次数 = 1 + n*(1 + (n-1)*(1 + ...))。
//
// 数组表示: swap_indices/permute_inner 的数组参数 v 为 i32[] (块访问语义,
//   免 index 字段), count 为 i32& (引用)。benchmark_permute 局部 v 直绑
//   i32[] (let x: T[] = dyn[n] T, del-view 后 del T[] 整块合法)。
//
// 单一源: fat 与 raw 共用本文件。
// 合并规则: dyn 用类型推断; 需要切片处用范围视图 x[0u64..n]（两模式通用, fat 下仍受检查）。
from std.core.io import print;

fn swap_indices(i: u64, j: u64, v: i32[]) {
    let tmp: i32 = v[i];
    v[i] = v[j];
    v[j] = tmp;
}

fn permute_inner(n: i32, v: i32[], count: i32&) {
    *count += 1;
    if n != 0 {
        let n1: i32 = n - 1;
        permute_inner(n1, v, count);
        let i: i32 = n1;
        while i >= 0 {
            swap_indices(u64(n1), u64(i), v);
            permute_inner(n1, v, count);
            swap_indices(u64(n1), u64(i), v);
            i -= 1;
        }
    }
}

fn benchmark_permute() -> i32 {
    let count: i32 = 0;
    let v = dyn[11] i32;
    let i: u64 = 0;
    while i < 11 {
        v[i] = i32(i);
        i += 1;
    }
    permute_inner(11, v[0u64..11u64], &count);
    del v;
    return count;
}

fn main() {
    let result: i32 = benchmark_permute();
    let expected: i32 = 823059745;
    assert result == expected: "permute count not expected";
    print("permute pass\n");
}
