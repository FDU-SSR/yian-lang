// bench/AWFY/an/sieve.an — 埃拉托斯特尼筛法 (shootout sieve)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/Sieve.java; 本文件为本仓库改写版 (上游许可见 AWFY LICENSE.md)
// 语义权威源: bench/AWFY/c/sieve.c (项目自写 C 参考)
// 规模: SIEVE_SIZE=2000000 × ITER=500 次迭代, 每趟断言 prime_count==148933。
//
// 算法: 每趟将 flags[0..SIEVE_SIZE-1] 全置 true (i 表示数 i+1),
//        sieve() 从 i=2 起标记合数, 统计素数个数。
//
// 数组表示: sieve 的 flags 参数为 bool[] (块访问语义, 免 index 字段)。
//   main 局部 flags 直绑 bool[] (let x: T[] = dyn[n] T, del-view 后
//   del T[] 整块合法)。
//
// 单一源: fat 与 raw 共用本文件。
// 合并规则: dyn 用类型推断; 需要切片处用范围视图 x[0u64..n]（两模式通用, fat 下仍受检查）。
from std.core.io import print;

fn sieve(flags: bool[], size: u64) -> i32 {
    let prime_count: i32 = 0;
    let i: u64 = 2;
    while i < size {
        if flags[i - 1] {
            prime_count += 1;
            let k: u64 = i + i;
            while k <= size {
                flags[k - 1] = false;
                k += i;
            }
        }
        i += 1;
    }
    return prime_count;
}

fn main() {
    let SIEVE_SIZE: u64 = 2000000;
    let ITER: u64 = 500;  // bench-scale
    let flags = dyn[SIEVE_SIZE] bool;
    // 视图是循环不变量: 提到循环外, 两模式每次运行只构造一次 (合并前 fat 源直接传切片)。
    // 填充也走视图: dyn 变量直接下标会走 Index trait 派发, 胖模式下比内建切片索引慢约 16%
    // (分支 fat 源因标注了 bool[] 而走内建路径); 视图与 flags 指向同一块内存, 语义不变。
    let flags_view: bool[] = flags[0u64..SIEVE_SIZE];
    let iter: u64 = 0;
    while iter < ITER {
        let i: u64 = 0;
        while i < SIEVE_SIZE {
            flags_view[i] = true;
            i += 1;
        }
        let prime_count: i32 = sieve(flags_view, SIEVE_SIZE);
        assert prime_count == 148933: "sieve: prime_count is not correct";
        iter += 1;
    }
    del flags;
    print("sieve pass\n");
}
