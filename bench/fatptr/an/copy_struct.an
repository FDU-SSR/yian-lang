// bench/fatptr/an/copy_struct.an: copying/passing structs containing fat values.
//
// Isolate representation size: elements contain T& and T* fields; the hot loop makes shallow
//       struct copies without entering elements. The checksum uses only data values, yielding equal stdout,
//       so fat/raw differences come from representation size and by-value argument passing.
//       Reference and pointer fields contribute independently to struct size and argument-passing costs.
// Scale: ROUNDS at the // bench-scale marker; ITEMS fixed at 100000.
// C reference: bench/fatptr/c/copy_struct.c, same algorithm/scale with 8 B raw pointer fields.
//
// Layout: one payloads array and one Item array; Item.ref=&payloads[i] references heap data,
//           Item.view=&payloads[0]+i selects the element by index;
//           shallow-copy src[i] through a local into dst[i], and pass it by value to sum_item.
//
// Both modes share this source; raw T&/T* use 8 B pointers.

struct Payload {
    value: i64,
}

struct Item {
    value: i64,
    ref: Payload&,
    view: Payload*,
}

// Receive a struct containing fat values by value; arguments over 16 B use memory.
fn sum_item(src: Item) -> i64 {
    return src.value;
}

fn main() {
    let ITEMS: u64 = 100000;
    let ROUNDS: u64 = 1024;  // bench-scale
    let payloads = dyn[ITEMS] Payload(0);
    let src = dyn[ITEMS] Item(0, &payloads[0], payloads);
    let dst = dyn[ITEMS] Item(0, &payloads[0], payloads);
    let i: u64 = 0;
    while i < ITEMS {
        payloads[i] = Payload(i64(i));
        src[i] = Item(i64(i), &payloads[i], payloads);
        i += 1;
    }
    let acc: i64 = 0;
    let round: u64 = 0;
    while round < ROUNDS {
        i = 0;
        while i < ITEMS {
            let item: Item = src[i];
            dst[i] = item;
            acc = acc + sum_item(item);
            i += 1;
        }
        round += 1;
    }
    let expect: i64 = i64(ROUNDS) * (i64(ITEMS) * (i64(ITEMS) - 1) / 2);
    assert acc == expect: "copy_struct checksum";
    let check: i64 = 0;
    i = 0;
    while i < ITEMS {
        check = check + dst[i].value + dst[i].ref.value + dst[i].view[i].value;
        i += 1;
    }
    assert check == 3 * (i64(ITEMS) * (i64(ITEMS) - 1) / 2): "copy_struct dst";
    @print("copy_struct pass\n");
    del dst;
    del src;
    del payloads;
}
