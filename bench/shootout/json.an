// bench/shootout/json.an — JSON 解析 + 序列化 (Json, AWFY 宏基准)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/Json.java + json/*.java
//       (MIT, Copyright (c) 2015 Stefan Marr; json/*.java 另含 EclipseSource
//        MIT 版权头, 见 /tmp/awfy/Java/src/json/)。Json.java 的校验值
//       (verifyResult) 为: 解析结果是 object, head 是 object, operations 是
//       array 且 size == 156。
// 语义权威源: bench/c/json.c (C 参考实现, 与本文件同规模同校验值)
//
// 算法: 逐字对应上游 JsonPureStringParser 的递归下降解析器 (1 字符前瞻 +
//       capture 区间), 解析内嵌的 minified JSON 文档, 然后按上游 JsonValue
//       结构做 minified 序列化 (对象按插入序, 数组按元素序, 数字保留原文),
//       统计 operations 数组长度、序列化长度与序列化字节的 FNV-1a 32 校验和。
//
// YIAN 侧适配 (逐条):
//   1. 无 trait object/动态分派: 上游 JsonValue 的类层次 (JsonObject /
//      JsonArray / JsonString / JsonNumber / JsonLiteral) 表达为一个 tagged
//      enum JsonValue { Object / Array / Str / Num / Literal }, 分派用 match。
//      JsonObject 保持上游的平行结构 names/values + HashIndexTable(32 槽)。
//      子值按值内联在父节点的 Vec<JsonValue> 里 (enum 本身即节点), 与上游
//      "引用构成的对象图" 不同, 但解析/遍历/序列化顺序完全一致。
//   2. 无 1 字符 String: 上游用 input.substring(index, index+1) 维护 current
//      并逐字符分配; YIAN 侧改成对文档字节切片 (u8[]) 的 u8 前瞻 (等价;
//      bench 下 @str_from_parts 等受限内建不可用)。capture 仍按上游区间语义。
//   3. 无异常: 上游 throw expected(...)/ParseException 改为 assert false
//      (解析错误立即终止; 合法输入下不可达)。
//   4. 上游 forEach 闭包已无 (该基准无闭包); 循环全部显式。
//   5. 字符串捕获: 无转义的串是内嵌文档的零拷贝 str 切片; 含转义的串按上游
//      captureBuffer 语义拼进 String, 再寄存到 arena (String 缓冲) 以保证
//      生命周期 —— 本文档不含任何反斜杠, 该分支不会执行。
//   6. 数字: 上游 JsonNumber 保存原始文本, 本实现同样保存 str 原文, 序列化
//      直接回写 -> 无 f64 解析/格式化, 也不需要 f64.from / Double.toString。
//   7. 上游 column 字段在 read() 中从不自增 (列号恒为 0), 本实现照抄该行为,
//      仅保留字段以对齐结构 (错误路径不可达)。
//   8. 内嵌文档: 上游 Json.java 的 rapBenchmarkMinified 字符串逐字搬运 (Java
//      字面量解码后重新按 YIAN 转义写回; 文档为纯 ASCII、无转义、无换行)。
//
// 单一源: fat 与 raw 共用本文件。raw 模式下 "enum 变体的 payload 结构体按值
//   包含 Vec<自身>" 曾触发编译器 LLVM 类型布局的重入缺陷 (payload 结构体在自身
//   body 未完成时被 get_abi_size), 一度靠声明顺序规避; 该缺陷已修 (类型体延迟
//   填充, 见 compiler/codegen/llvm/types.py 的 __declare_pointee 与
//   docs/llvm_note.md), 顺序不再有约束。
//
// 规模: ITER=2000 (fat 单趟约 2.0s / raw 约 0.8s, 空闲核实测)。
// 校验值 (两态逐字节一致, 与 bench/c/json.c 相同):
//   operations 数组长度 156 (上游官方期望值) * ITER = 312000
//   序列化长度 25820 * ITER                         = 51640000
//   FNV-1a 32 校验和 2934551514 * ITER              = 5869103028000
//   stdout: "json 312000 51640000 5869103028000"
//
// 编译: yianc -O2 lib/src bench/shootout/json.an -o build/bench/json.fat
//       yianc -O2 --raw-pointers lib/src bench/shootout/json.an -o build/bench/json.raw
from std.core.io import print;
from std.core.vec import Vec;
from std.core.string import String;
from std.core.fmt import ToString;

// ── JSON 值 (上游 json/JsonValue.java 及其子类的 tagged enum 表达) ──

enum JsonValue {
    Object { names: Vec<str>, values: Vec<JsonValue>, table: Vec<i32> },
    Array { values: Vec<JsonValue> },
    Str { value: str },
    Num { value: str },
    Literal { value: str },
}

// 上游 JsonObject.HashIndexTable.stringHash + hashSlotFor (32 槽, 2 的幂)
fn hash_slot(name: str) -> u64 {
    return (name.as_slice().len() * 1402589u64) & 31u64;
}

// 上游 JsonObject.indexOf: 命中返回下标, 未命中返回 -1 (上游此处抛
// NotImplemented; 本基准的键都在表内)。
fn index_of(names: Vec<str>, table: Vec<i32>, name: str) -> i32 {
    let slot: u64 = hash_slot(name);
    let idx: i32 = (table[slot] & 0xff) - 1;
    if idx != -1 {
        if names[u64(idx)] == name {
            return idx;
        }
    }
    return -1;
}

// ── 解析器 (上游 json/JsonPureStringParser.java) ──

struct Parser {
    input: str,
    bytes: u8[],
    index: i64,
    line: i32,
    column: i32,
    current: i32,
    capture_start: i64,
    capture_buffer: String,
    arena: Vec<String>&,
}

impl Parser {
    fn fail() {
        assert false: "json: parse error";
    }

    // 上游 read(): current == -1 表示文本结束 (上游为 null)
    fn read() {
        if self.current == 10 {
            self.line += 1;
            self.column = 0;
        }
        self.index += 1;
        if self.index < i64(self.bytes.len()) {
            self.current = i32(self.bytes[u64(self.index)]);
        } else {
            self.current = -1;
        }
    }

    fn read_char(ch: u8) -> bool {
        if self.current != i32(ch) {
            return false;
        }
        self.read();
        return true;
    }

    fn read_digit() -> bool {
        if self.current < 48 || self.current > 57 {
            return false;
        }
        self.read();
        return true;
    }

    fn is_white_space() -> bool {
        return self.current == 32 || self.current == 9 || self.current == 10 || self.current == 13;
    }

    fn is_end_of_text() -> bool {
        return self.current < 0;
    }

    fn skip_white_space() {
        while self.is_white_space() {
            self.read();
        }
    }

    fn start_capture() {
        self.capture_start = self.index;
    }

    // 上游 pauseCapture
    fn pause_capture() {
        let end: i64 = if self.current < 0 { self.index } else { self.index - 1 };
        let start: u64 = u64(self.capture_start);
        let piece: str = self.input[start..u64(end + 1)];
        self.capture_buffer.push_str(piece);
        self.capture_start = -1;
    }

    // 上游 endCapture: 无转义时直接切片, 有转义时返回 captureBuffer 内容
    fn end_capture() -> str {
        let end: i64 = if self.current < 0 { self.index } else { self.index - 1 };
        let start: u64 = u64(self.capture_start);
        let piece: str = self.input[start..u64(end + 1)];
        self.capture_start = -1;
        if self.capture_buffer.len() == 0 {
            return piece;
        }
        self.capture_buffer.push_str(piece);
        let buf: String = self.capture_buffer;
        self.capture_buffer = String.new();
        self.arena.push(buf);
        let store: Vec<String> = *self.arena;
        return store[store.len() - 1u64].as_str();
    }

    // 上游 readEscape
    fn read_escape() {
        self.read();
        if self.current == 34 {
            self.capture_buffer.push('"');
        } elif self.current == 47 {
            self.capture_buffer.push('/');
        } elif self.current == 92 {
            self.capture_buffer.push('\\');
        } elif self.current == 98 {
            self.capture_buffer.push(char(8));
        } elif self.current == 102 {
            self.capture_buffer.push(char(12));
        } elif self.current == 110 {
            self.capture_buffer.push('\n');
        } elif self.current == 114 {
            self.capture_buffer.push('\r');
        } elif self.current == 116 {
            self.capture_buffer.push('\t');
        } else {
            self.fail();
        }
        self.read();
    }

    // 上游 readStringInternal (额外防护: 文本提前结束时判定为解析错误,
    // 上游在此处会因 current == null 抛 NPE)
    fn read_string_internal() -> str {
        self.read();
        self.start_capture();
        while self.current != 34 {
            if self.current < 0 {
                self.fail();
                return "";
            }
            if self.current == 92 {
                self.pause_capture();
                self.read_escape();
                self.start_capture();
            } else {
                self.read();
            }
        }
        let captured: str = self.end_capture();
        self.read();
        return captured;
    }

    fn read_string() -> JsonValue {
        return JsonValue.Str(value=self.read_string_internal());
    }

    fn read_name() -> str {
        if self.current != 34 {
            self.fail();
            return "";
        }
        return self.read_string_internal();
    }

    fn require(ch: u8) {
        if !self.read_char(ch) {
            self.fail();
        }
    }

    fn read_null() -> JsonValue {
        self.read();
        self.require(117);
        self.require(108);
        self.require(108);
        return JsonValue.Literal(value="null");
    }

    fn read_true() -> JsonValue {
        self.read();
        self.require(114);
        self.require(117);
        self.require(101);
        return JsonValue.Literal(value="true");
    }

    fn read_false() -> JsonValue {
        self.read();
        self.require(97);
        self.require(108);
        self.require(115);
        self.require(101);
        return JsonValue.Literal(value="false");
    }

    // 上游 readNumber
    fn read_number() -> JsonValue {
        self.start_capture();
        self.read_char(45);
        let first_digit: i32 = self.current;
        if !self.read_digit() {
            self.fail();
        }
        if first_digit != 48 {
            while self.read_digit() {
            }
        }
        self.read_fraction();
        self.read_exponent();
        return JsonValue.Num(value=self.end_capture());
    }

    fn read_fraction() {
        if !self.read_char(46) {
            return;
        }
        if !self.read_digit() {
            self.fail();
        }
        while self.read_digit() {
        }
    }

    fn read_exponent() {
        if !self.read_char(101) {
            if !self.read_char(69) {
                return;
            }
        }
        if !self.read_char(43) {
            self.read_char(45);
        }
        if !self.read_digit() {
            self.fail();
        }
        while self.read_digit() {
        }
    }

    fn read_array() -> JsonValue {
        self.read();
        let values: Vec<JsonValue> = Vec<JsonValue>.new();
        self.skip_white_space();
        if self.read_char(93) {
            return JsonValue.Array(values=values);
        }
        loop {
            self.skip_white_space();
            values.push(self.read_value());
            self.skip_white_space();
            if !self.read_char(44) {
                break;
            }
        }
        if !self.read_char(93) {
            self.fail();
        }
        return JsonValue.Array(values=values);
    }

    fn read_object() -> JsonValue {
        self.read();
        let names: Vec<str> = Vec<str>.new();
        let values: Vec<JsonValue> = Vec<JsonValue>.new();
        let table: Vec<i32> = Vec<i32>.with_capacity(32u64);
        let k: u64 = 0;
        while k < 32u64 {
            table.push(0);
            k += 1;
        }
        self.skip_white_space();
        if self.read_char(125) {
            return JsonValue.Object(names=names, values=values, table=table);
        }
        loop {
            self.skip_white_space();
            let name: str = self.read_name();
            self.skip_white_space();
            if !self.read_char(58) {
                self.fail();
            }
            self.skip_white_space();
            // 上游 HashIndexTable.add(name, names.size())
            if names.len() < 255u64 {
                let slot: u64 = hash_slot(name);
                table[slot] = (i32(names.len()) + 1) & 0xff;
            }
            names.push(name);
            values.push(self.read_value());
            self.skip_white_space();
            if !self.read_char(44) {
                break;
            }
        }
        if !self.read_char(125) {
            self.fail();
        }
        return JsonValue.Object(names=names, values=values, table=table);
    }

    // 上游 readValue
    fn read_value() -> JsonValue {
        let c: i32 = self.current;
        if c == 110 {
            return self.read_null();
        }
        if c == 116 {
            return self.read_true();
        }
        if c == 102 {
            return self.read_false();
        }
        if c == 34 {
            return self.read_string();
        }
        if c == 91 {
            return self.read_array();
        }
        if c == 123 {
            return self.read_object();
        }
        if c == 45 || (c >= 48 && c <= 57) {
            return self.read_number();
        }
        self.fail();
        return JsonValue.Literal(value="null");
    }
}

// 上游 JsonPureStringParser.parse (arena 由调用方持有, 保证 str 生命周期;
// 本文档无转义, arena 始终为空)
fn parse_document(doc: str, bytes: u8[], arena: Vec<String>&) -> JsonValue {
    let p: Parser = Parser(input=doc, bytes=bytes, index=-1i64, line=1, column=0, current=-1, capture_start=-1i64, capture_buffer=String.new(), arena=arena);
    p.read();
    p.skip_white_space();
    let result: JsonValue = p.read_value();
    p.skip_white_space();
    if !p.is_end_of_text() {
        p.fail();
    }
    p.capture_buffer.drop();
    return result;
}

// ── 序列化 (minified; 对象按插入序, 数组按元素序, 数字保留原文) ──

fn hex_digit(b: u8) -> char {
    if b < 10u8 {
        return char(b'0' + b);
    }
    return char(b'a' + b - 10u8);
}

fn write_escaped(out: String&, s: str) {
    let bytes: u8[] = s.as_slice();
    out.push('"');
    let i: u64 = 0;
    while i < bytes.len() {
        let b: u8 = bytes[i];
        if b == 34u8 {
            out.push_str("\\\"");
        } elif b == 92u8 {
            out.push_str("\\\\");
        } elif b == 8u8 {
            out.push_str("\\b");
        } elif b == 12u8 {
            out.push_str("\\f");
        } elif b == 10u8 {
            out.push_str("\\n");
        } elif b == 13u8 {
            out.push_str("\\r");
        } elif b == 9u8 {
            out.push_str("\\t");
        } elif b < 32u8 {
            out.push_str("\\u00");
            out.push(hex_digit(b / 16u8));
            out.push(hex_digit(b % 16u8));
        } else {
            out.push(char(b));
        }
        i += 1;
    }
    out.push('"');
}

fn write_value(out: String&, v: JsonValue) {
    match v {
        Object(names, values, table) => {
            out.push('{');
            let i: u64 = 0;
            while i < names.len() {
                write_escaped(out, names[i]);
                out.push(':');
                write_value(out, values[i]);
                if i + 1u64 < names.len() {
                    out.push(',');
                }
                i += 1;
            }
            out.push('}');
        },
        Array(values) => {
            out.push('[');
            let i: u64 = 0;
            while i < values.len() {
                write_value(out, values[i]);
                if i + 1u64 < values.len() {
                    out.push(',');
                }
                i += 1;
            }
            out.push(']');
        },
        Str(sv) => {
            write_escaped(out, sv);
        },
        Num(nv) => {
            out.push_str(nv);
        },
        Literal(lv) => {
            out.push_str(lv);
        },
    }
}

// 序列化字节的 FNV-1a 32 (C 参考实现同款)
fn fnv1a32(s: str) -> u32 {
    let h: u32 = 2166136261u32;
    let bytes: u8[] = s.as_slice();
    let i: u64 = 0;
    while i < bytes.len() {
        h = (h ^ u32(bytes[i])) * 16777619u32;
        i += 1;
    }
    return h;
}

// ── 上游 Json.verifyResult: operations 必须是 array 且 size == 156 ──

fn ops_size(root: JsonValue) -> u64 {
    match root {
        Object(names, values, table) => {
            let idx: i32 = index_of(names, table, "operations");
            if idx < 0 {
                assert false: "json: operations member missing";
            }
            match values[u64(idx)] {
                Array(av) => {
                    return av.len();
                },
                _ => {
                    assert false: "json: operations is not an array";
                },
            }
        },
        _ => {
            assert false: "json: root is not an object";
        },
    }
    return 0u64;
}

// 递归释放树 (节点内联在父 Vec 中, 逐层释放 Vec 缓冲)
fn free_value(v: JsonValue) {
    match v {
        Object(names, values, table) => {
            names.drop();
            table.drop();
            let i: u64 = 0;
            while i < values.len() {
                free_value(values[i]);
                i += 1;
            }
            values.drop();
        },
        Array(values) => {
            let i: u64 = 0;
            while i < values.len() {
                free_value(values[i]);
                i += 1;
            }
            values.drop();
        },
        Str(sv) => {
        },
        Num(nv) => {
        },
        Literal(lv) => {
        },
    }
}

fn main() {
