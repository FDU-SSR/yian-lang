    let bytes: u8[] = DOC.as_slice();

    let ITER: u64 = 2000;
    let total_ops: u64 = 0;
    let total_len: u64 = 0;
    let total_hash: u64 = 0;

    let arena: Vec<String> = Vec<String>.new();
    let out: String = String.new();
    let i: u64 = 0;
    while i < ITER {
        let root: JsonValue = parse_document(DOC, bytes, &arena);
        total_ops += ops_size(root);
        out.clear();
        write_value(&out, root);
        total_len += out.len();
        total_hash += u64(fnv1a32(out.as_str()));
        free_value(root);
        i += 1;
    }
    out.drop();
    let a: u64 = 0;
    while a < arena.len() {
        arena[a].drop();
        a += 1;
    }
    arena.drop();

    assert total_ops == 156u64 * ITER: "json: operations size is not 156";
    assert total_len == 25820u64 * ITER: "json: serialized length mismatch";
    assert total_hash == 2934551514u64 * ITER: "json: checksum mismatch";

    print("json ");
    print(total_ops.to_string().as_str());
    print(" ");
    print(total_len.to_string().as_str());
    print(" ");
    print(total_hash.to_string().as_str());
    print("\n");
}
