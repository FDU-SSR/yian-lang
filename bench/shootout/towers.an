// bench/shootout/towers.an — 汉诺塔指针栈模拟 (shootout towers)
//
// 语义权威源: bak/old_exp/performance/c/towers.c (C 版)
// 规模参数取自原 .an (bak/old_exp/performance/an/towers.an):
//   原规模 disks=30, 断言 moves_done == 1073741823 (2^30 - 1)。
//   (规模未调整; 与 C 版语义一致。)
//
// 算法: 3 根柱子各存一张 TowersDisk 链表 (按 size 从大到小, 栈顶最小)。
//       push_disk 把 disk 压到某柱 (校验 size 递增), pop_disk_from 弹出
//       栈顶, move_top_disk 完成单次移动并计数, move_disks 递归汉诺塔。
//       build_tower_at 建 0..disks 的塔, 结束后 free_pile 逐节点释放。
//       总移动次数 = 2^disks - 1。
//
// Option 迁移 (2026-08): 链表尾哨兵/空柱由 Option 表达。Option 值禁止
// 简单复制 → 遍历位置用 is_some/unwrap 非破坏性读取,字段写入用构造表达式。
// T& 迁移 (2026-08): next 与 piles 元素由 Option 指针 payload 升级为
// Option<TowersDisk&>(40B→24B);push_disk 参数改 T& 避免热路径 bitcast
// (调用侧传 T* 隐式折算),节点本体保持 dyn T 分配 (T*),free_pile
// 释放路径 bitcast 回 T* 再 del(只跑一次,可接受)。
//
// 编译: python3 -m compiler.main -O2 lib bench/shootout/towers.an -o build/shootout_check/towers
// 预期: exit 0 (断言全过)

from std.core.io import print;

struct TowersDisk {
    size: i32,
    next: Option<TowersDisk&>,
}

struct TowersState {
    piles: Option<TowersDisk&>[3],
    moves_done: i64,
}

fn push_disk(disk: TowersDisk&, pile: u64, state: TowersState&) {
    let top: Option<TowersDisk&>;
    if state.piles[pile].is_some() {
        top = Option<TowersDisk&>.Some(state.piles[pile].unwrap()[0]);
    } else {
        top = Option<TowersDisk&>.None;
    };
    if top.is_some() {
        let tt: TowersDisk& = top.unwrap()[0];
        if disk.size >= tt.size {
            return;
        }
    }
    disk.next = top.move();
    state.piles[pile] = Option<TowersDisk&>.Some(disk);
}

fn pop_disk_from(pile: u64, state: TowersState&) -> Option<TowersDisk&> {
    let top: Option<TowersDisk&>;
    if state.piles[pile].is_some() {
        top = Option<TowersDisk&>.Some(state.piles[pile].unwrap()[0]);
    } else {
        top = Option<TowersDisk&>.None;
    };
    if top.is_none() {
        return Option<TowersDisk&>.None;
    }
    let tt: TowersDisk& = top.unwrap()[0];
    if tt.next.is_some() {
        state.piles[pile] = Option<TowersDisk&>.Some(tt.next.unwrap()[0]);
    } else {
        state.piles[pile] = Option<TowersDisk&>.None;
    };
    tt.next = Option<TowersDisk&>.None;
    return Option<TowersDisk&>.Some(tt);
}

fn move_top_disk(from_pile: u64, to_pile: u64, state: TowersState&) {
    let disk: Option<TowersDisk&> = pop_disk_from(from_pile, state);
    if disk.is_some() {
        push_disk(disk.unwrap()[0], to_pile, state);
    }
    state.moves_done = state.moves_done + 1;
}

fn build_tower_at(pile: u64, disks: i32, state: TowersState&) {
    let i: i32 = disks;
    while i >= 0 {
        let disk: TowersDisk* = dyn TowersDisk(i, Option<TowersDisk&>.None);
        push_disk(disk, pile, state);
        i -= 1;
    };
}

fn move_disks(disks: i32, from_pile: u64, to_pile: u64, state: TowersState&) {
    if disks == 1 {
        move_top_disk(from_pile, to_pile, state);
    } else {
        let other_pile: u64 = u64(3 - i32(from_pile) - i32(to_pile));
        move_disks(disks - 1, from_pile, other_pile, state);
        move_top_disk(from_pile, to_pile, state);
        move_disks(disks - 1, other_pile, to_pile, state);
    }
}

fn free_pile(disk: TowersDisk&) {
    let cur: TowersDisk& = disk;
    loop {
        let next: Option<TowersDisk&>;
        if cur.next.is_some() {
            next = Option<TowersDisk&>.Some(cur.next.unwrap()[0]);
        } else {
            next = Option<TowersDisk&>.None;
        };
        del bitcast<TowersDisk*>(cur);
        if next.is_none() {
            break;
        };
        cur = next.unwrap()[0];
    };
}

fn benchmark() -> i64 {
    let state: TowersState* = dyn TowersState(
        [Option<TowersDisk&>.None, Option<TowersDisk&>.None, Option<TowersDisk&>.None], 0);
    let sv: TowersState& = state;
    build_tower_at(0, 30, sv);
    move_disks(30, 0, 1, sv);

    let i: u64 = 0;
    while i < 3 {
        if state.piles[i].is_some() {
            free_pile(state.piles[i].unwrap()[0]);
        }
        i += 1;
    };

    let moves: i64 = state.moves_done;
    del state;
    return moves;
}

fn main() {
    let result: i64 = benchmark();
    assert result == 1073741823: "towers: moves_done should be 1073741823";
    print("towers pass\n");
}
