// bench/shootout/binarytree.an — 二叉树递归构建/检查/删除 (shootout binary-trees)
//
// 上游: Benchmarks Game (shootout) 改写; 本文件为本仓库改写版 (上游为 Revised BSD, Copyright 2008-2012 Isaac Gouy)
// 语义权威源: bench/c/binarytree.c (项目自写 C 参考)
// 规模: N=20, minDepth=4, 断言 check % 256 == 176。
//
// 算法: BottomUpTree 递归建满二叉树 (每节点两子指针), ItemCheck 递归
//       求和 (空子树贡献 1, 非空加左右子树的 ItemCheck), DeleteTree
//       递归后序删除。main 分三段: stretch tree (maxDepth+1) 建删、
//       longLived tree (maxDepth) 保留至最后、中间按 depth 步进 2 建
//       删 1<<(maxDepth-depth+minDepth) 棵临时树并累计 check。
//
// 数据布局: left/right 为 Option<treeNode&> (空子树由 None 表达); 节点由
//       dyn treeNode(...) 分配, ItemCheck 读路径为 treeNode&, DeleteTree
//       释放路径直接 del T&。
//
// 单一源: fat 与 raw 共用本文件。dyn 用类型推断; 需要切片处用范围视图
//         x[0u64..n]（两模式通用, fat 下仍受检查）。
from std.core.io import print;

struct treeNode {
    left: Option<treeNode&>,
    right: Option<treeNode&>,
}

fn NewTreeNode(left: Option<treeNode&>, right: Option<treeNode&>) -> Option<treeNode&> {
    return Option<treeNode&>.Some(dyn treeNode(left, right));
}

fn BottomUpTree(depth: u64) -> Option<treeNode&> {
    if depth > 0 {
        let left_child: Option<treeNode&> = BottomUpTree(depth - 1);
        let right_child: Option<treeNode&> = BottomUpTree(depth - 1);
        return NewTreeNode(left_child, right_child);
    }
    return NewTreeNode(Option<treeNode&>.None, Option<treeNode&>.None);
}

fn ItemCheck(tree: treeNode&) -> i64 {
    let res: i64 = 1;
    match tree.left {
        Some(lc) => { res = res + ItemCheck(lc); },
        None => { },
    }
    match tree.right {
        Some(rc) => { res = res + ItemCheck(rc); },
        None => { },
    }
    return res;
}

fn DeleteTree(tree: Option<treeNode&>) {
    match tree {
        None => { return; },
        Some(tt) => {
            match tt.left {
                Some(l) => { DeleteTree(Option<treeNode&>.Some(l)); },
                None => { },
            }
            match tt.right {
                Some(r) => { DeleteTree(Option<treeNode&>.Some(r)); },
                None => { },
            }
            // 后序: 子树已删, 释放本节点 (tt 释放后不再读)
            del tt;
        }
    }
}

fn main() {
    let N: u64 = 20;
    let minDepth: u64 = 4;
    let maxDepth: u64 = N;
    let check: i64 = 0;

    if (minDepth + 2) > N {
        maxDepth = minDepth + 2;
    }

    let stretchDepth: u64 = maxDepth + 1;
    let stretchTree: Option<treeNode&> = BottomUpTree(stretchDepth);
    DeleteTree(stretchTree);

    let longLivedTree: Option<treeNode&> = BottomUpTree(maxDepth);

    let depth: u64 = minDepth;
    while depth <= maxDepth {
        let iterations: i64 = 1 << (maxDepth - depth + minDepth);
        let i: i64 = 0;
        while i < iterations {
            let tempTree: Option<treeNode&> = BottomUpTree(depth);
            match tempTree {
                Some(tt) => { check = check + ItemCheck(tt); },
                None => { },
            }
            DeleteTree(tempTree);
            i += 1;
        };
        depth += 2;
    };

    DeleteTree(longLivedTree);

    assert check % 256 == 176: "binarytree: check % 256 mismatch";
    print("binarytree pass\n");
}
