// bench/shootout/permute.an — 全排列递归交换 (shootout permute)
//
// 语义权威源: bak/old_exp/performance/c/permute.c (C 版)
// 规模参数取自原 .an (bak/old_exp/performance/an/permute.an):
//   原规模 n=12, 断言 count == 2109842094 (i32 回绕值)。
//   规模调整: 全胖模式 n=12 (真实调用 1.07e10 次) 实测 ~6 分钟, 远超
//   可接受运行时长; 折中为 n=11 (真实调用 823059745 次, 未回绕), 断言
//   count == 823059745 (C 版同规模实测值, 三态同源码, 不影响归因)。
//
// 算法: permute_inner(n, v) 对长度 n 的前缀做递归交换排列, 每次调用
//       count+=1; n==0 时仅计数返回, 否则先递归 (n-1) 再对 i 从 n-1
//       递减到 0 做 swap+递归+swap。swap_indices 通过指针索引交换
//       v[i] 与 v[j]。总调用次数 = 1 + n*(1 + (n-1)*(1 + ...)) 即
//       n=12 时为 2109842094。
//
// tiered-pointers t6 标注: 热路径 (swap_indices/permute_inner) 数组参数
//   v 改为 i32[] (块访问语义, 免 index 字段), count 改为 i32& (引用)。
//   benchmark_permute 局部 v 保持 i32* (del 仅 T* 合法); 调用侧隐式 coerce
//   T*→T[] 传递 (expr_checker.py L347-356, 胖模式允许)。
//
// 编译: python3 -m compiler.main -O2 lib bench/shootout/permute.an -o build/shootout_check/permute
// 预期: exit 0 (断言全过)

from std.core.io import print;

fn swap_indices(i: u64, j: u64, v: i32[]) {
    let tmp: i32 = v[i];
    v[i] = v[j];
    v[j] = tmp;
}

fn permute_inner(n: i32, v: i32[], count: i32&) {
    *count += 1;
    if n != 0 {
        let n1: i32 = n - 1;
        permute_inner(n1, v, count);
        let i: i32 = n1;
        while i >= 0 {
            swap_indices(u64(n1), u64(i), v);
            permute_inner(n1, v, count);
            swap_indices(u64(n1), u64(i), v);
            i -= 1;
        }
    }
}

fn benchmark_permute() -> i32 {
    let count: i32 = 0;
    let v: i32* = dyn[11] i32;
    let i: u64 = 0;
    while i < 11 {
        v[i] = i32(i);
        i += 1;
    }
    permute_inner(11, v, &count);
    del v;
    return count;
}

fn main() {
    let result: i32 = benchmark_permute();
    let expected: i32 = 823059745;
    assert result == expected: "permute count not expected";
    print("permute pass\n");
}
