// bench/shootout/cd.an — 碰撞检测 (CD, AWFY 宏基准)
//
// 上游: AWFY (are-we-fast-yet) benchmarks/Java/src/CD.java + cd/*.java
//       (MIT, Copyright (c) 2001-2016 Stefan Marr; cd/*.java 无逐文件许可头)
// 语义权威源: bench/c/cd.c (C 参考实现, 与上游 Java 断言值一致:
//       aircraft=2→42, 10→390, 100→4305, 250→10830 次碰撞)
//
// 算法: 200 帧, 每帧 simulate(time) 生成 numAircrafts 架飞机的位置
//       (y = cos/sin(time)*2 + i*3), CollisionDetector 维护上一帧位置
//       (CallSign → Vector3D 红黑树), 生成本帧 Motion 集合; 再把每条 Motion
//       画到体素图 (Vector2D → Motion 列表, 红黑树) 上, 同一体素内两两求
//       线段球体相交 (Motion.findIntersection), 累计碰撞数。
//
// YIAN 侧适配 (与上游逐行对应, 仅以下写法差异):
//   - 无 trait object/动态分派: 上游 Java 泛型红黑树 + Comparable 用「带标签键
//     enum Key + 泛型 RBTree<V>」的单一实现表达; 键比较 key_compare 与上游
//     CallSign.compareTo / Vector2D.compareTo 逐行对应。
//   - 引用不可比较相等 (== 对 T& 报 E406): 节点带唯一 id (自增, 树内唯一),
//     上游的 `x == y.left` / `y != z` 等身份判定改比 id, 语义等价。
//   - 上游 ForEachInterface 闭包改为显式中序遍历 (等价, 无闭包分配)。
//   - 无 sin/cos 内建: mysin/mycos 用区间归约 + fdlibm 内核多项式 (精度 <1ulp),
//     与 libm/Java 的 ULP 差异不影响碰撞计数 (已用 bench/c/cd.c 的 libm 版本核对:
//     2/10/100/250 架的计数完全一致)。sqrt 用标准库 std.num.f64.sqrt
//     (llvm.sqrt.f64 → sqrtsd), 与 C 参考的 libm sqrt 同一原语; 碰撞计数对 sqrt
//     的末位差异敏感, 换用该精确实现后计数仍为上游校验值 4305 (实测)。
//     同一 discr 只开方一次 (上游 Java 写了两次 Math.sqrt, 等值)。
//   - state 树的值为 Vector3D 值型 (上游是对象引用), 树节点/键布局见下。
//
// 单一源: fat 与 raw 共用本文件; 树链用 Option<RBNode<V>&> (两模式通用)。
// 规模: AIRCRAFT=100 (上游校验值 4305), FRAMES=200, ITER=80 (fat 单趟约 2.7s)。
// 编译: yianc -O2 lib/src bench/shootout/cd.an -o build/bench/cd.fat
from std.core.io import print;
from std.num.f64 import sqrt;
from std.core.vec import Vec;

// ── 浮点数学 (YIAN 无 sin/cos 内建) ──

fn fabs(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    return x;
}

// fdlibm __kernel_sin, 有效区间 |x| <= π/4
fn sin_core(x: f64) -> f64 {
    let z: f64 = x * x;
    return x * (1.0 + z * (-1.66666666666666324348e-01 + z * (8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * (2.75573137070700676789e-06 + z * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10))))));
}

// fdlibm __kernel_cos, 有效区间 |x| <= π/4
fn cos_core(x: f64) -> f64 {
    let z: f64 = x * x;
    return 1.0 - 0.5 * z + z * z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * (2.48015872894767294178e-05 + z * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))));
}

// 归约到 [-π, π]: x - 2π·trunc(x/2π)
fn reduce_angle(x: f64) -> f64 {
    let PI: f64 = 3.14159265358979323846;
    let TWO_PI: f64 = 6.28318530717958647692;
    let k: i64 = i64(x * 0.15915494309189533577);
    let r: f64 = x - f64(k) * TWO_PI;
    if r > PI {
        return r - TWO_PI;
    }
    if r < -PI {
        return r + TWO_PI;
    }
    return r;
}

// sin(a), a ∈ [0, π]
fn sin_pos(a: f64) -> f64 {
    let PI: f64 = 3.14159265358979323846;
    let PI_4: f64 = 0.78539816339744830962;
    let PI_2: f64 = 1.57079632679489661923;
    if a <= PI_4 {
        return sin_core(a);
    }
    if a <= PI_2 {
        return cos_core(PI_2 - a);
    }
    let b: f64 = PI - a;
    if b <= PI_4 {
        return sin_core(b);
    }
    return cos_core(PI_2 - b);
}

// cos(a), a ∈ [0, π]
fn cos_pos(a: f64) -> f64 {
    let PI: f64 = 3.14159265358979323846;
    let PI_4: f64 = 0.78539816339744830962;
    let PI_2: f64 = 1.57079632679489661923;
    if a <= PI_4 {
        return cos_core(a);
    }
    if a <= PI_2 {
        return sin_core(PI_2 - a);
    }
    let b: f64 = PI - a;
    if b <= PI_4 {
        return -cos_core(b);
    }
    return -sin_core(PI_2 - b);
}

fn mysin(x: f64) -> f64 {
    let r: f64 = reduce_angle(x);
    if r < 0.0 {
        return -sin_pos(-r);
    }
    return sin_pos(r);
}

fn mycos(x: f64) -> f64 {
    return cos_pos(fabs(reduce_angle(x)));
}

// ── 值类型 (上游 cd/Vector2D.java, cd/Vector3D.java) ──

struct Vector2D {
    x: f64,
    y: f64,
}

struct Vector3D {
    x: f64,
    y: f64,
    z: f64,
}

struct Aircraft {
    callsign: i32,
    position: Vector3D,
}

struct Motion {
    callsign: i32,
    pos_one: Vector3D,
    pos_two: Vector3D,
}

fn v2_plus(a: Vector2D, b: Vector2D) -> Vector2D {
    return Vector2D(x=a.x + b.x, y=a.y + b.y);
}

fn v2_minus(a: Vector2D, b: Vector2D) -> Vector2D {
    return Vector2D(x=a.x - b.x, y=a.y - b.y);
}

fn v3_plus(a: Vector3D, b: Vector3D) -> Vector3D {
    return Vector3D(x=a.x + b.x, y=a.y + b.y, z=a.z + b.z);
}

fn v3_minus(a: Vector3D, b: Vector3D) -> Vector3D {
    return Vector3D(x=a.x - b.x, y=a.y - b.y, z=a.z - b.z);
}

fn v3_times(a: Vector3D, s: f64) -> Vector3D {
    return Vector3D(x=a.x * s, y=a.y * s, z=a.z * s);
}

fn v3_dot(a: Vector3D, b: Vector3D) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

fn v3_squared_magnitude(a: Vector3D) -> f64 {
    return v3_dot(a, a);
}

fn v3_magnitude(a: Vector3D) -> f64 {
    return sqrt(v3_squared_magnitude(a));
}

// ── 红黑树键 (上游 CallSign / Vector2D 的 Comparable) ──

enum Key {
    Sign { value: i32 },
    Voxel { x: f64, y: f64 },
}

fn compare_numbers(a: f64, b: f64) -> i32 {
    if a == b {
        return 0;
    }
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    // NaN 视为最小
    if a == a {
        return 1;
    }
    return -1;
}

fn key_compare(a: Key, b: Key) -> i32 {
    match a {
        Sign(av) => {
            match b {
                Sign(bv) => {
                    if av == bv {
                        return 0;
                    }
                    if av < bv {
                        return -1;
                    }
                    return 1;
                },
                Voxel(bx, by) => {
                    return -1;
                },
            }
        },
        Voxel(ax, ay) => {
            match b {
                Sign(bv) => {
                    return 1;
                },
                Voxel(bx, by) => {
                    let result: i32 = compare_numbers(ax, bx);
                    if result != 0 {
                        return result;
                    }
                    return compare_numbers(ay, by);
                },
            }
        },
    }
}

fn key_sign_value(k: Key) -> i32 {
    match k {
        Sign(v) => {
            return v;
        },
        Voxel(x, y) => {
            return 0;
        },
    }
}

// ── 红黑树 (移植自上游 cd/RedBlackTree.java) ──

struct RBNode<V> {
    id: u64,
    key: Key,
    value: V,
    left: Option<RBNode<V>&>,
    right: Option<RBNode<V>&>,
    parent: Option<RBNode<V>&>,
    red: bool,
}

struct RBTree<V> {
    root: Option<RBNode<V>&>,
    next_id: u64,
}

impl<V> RBNode<V> {
    pub fn is_left_child() -> bool {
        match self.parent {
            None => {
                return false;
            },
            Some(p) => {
                match p.left {
                    None => {
                        return false;
                    },
                    Some(l) => {
                        return l.id == self.id;
                    },
                }
            },
        }
    }

    pub fn is_right_child() -> bool {
        match self.parent {
            None => {
                return false;
            },
            Some(p) => {
                match p.right {
                    None => {
                        return false;
                    },
                    Some(r) => {
                        return r.id == self.id;
                    },
                }
            },
        }
    }
}

impl<V> RBTree<V> {
    static pub fn new() -> Self {
        return Self(root=Option<RBNode<V>&>.None, next_id=1u64);
    }

    // 上游 treeMinimum
    pub fn first() -> Option<RBNode<V>&> {
        let current: Option<RBNode<V>&> = self.root;
        if current.is_none() {
            return Option<RBNode<V>&>.None;
        }
        let node: RBNode<V>& = *current.unwrap();
        while node.left.is_some() {
            node = *node.left.unwrap();
        }
        return Option<RBNode<V>&>.Some(node);
    }

    // 上游 Node.successor()
    pub fn successor(node: RBNode<V>&) -> Option<RBNode<V>&> {
        if node.right.is_some() {
            let right: RBNode<V>& = *node.right.unwrap();
            let current: RBNode<V>& = right;
            while current.left.is_some() {
                current = *current.left.unwrap();
            }
            return Option<RBNode<V>&>.Some(current);
        }
        let x: RBNode<V>& = node;
        let y: Option<RBNode<V>&> = x.parent;
        while y.is_some() {
            if y.unwrap().right.is_some() && y.unwrap().right.unwrap().id == x.id {
                x = *y.unwrap();
                y = x.parent;
            } else {
                return y;
            }
        }
        return y;
    }

    fn find_node(key: Key) -> Option<RBNode<V>&> {
        let current: Option<RBNode<V>&> = self.root;
        while current.is_some() {
            let node: RBNode<V>& = *current.unwrap();
            let comparison: i32 = key_compare(key, node.key);
            if comparison == 0 {
                return Option<RBNode<V>&>.Some(node);
            }
            if comparison < 0 {
                current = node.left;
            } else {
                current = node.right;
            }
        }
        return Option<RBNode<V>&>.None;
    }

    pub fn get(key: Key) -> Option<V*> {
        let node: Option<RBNode<V>&> = self.find_node(key);
        if node.is_none() {
            return Option<V*>.None;
        }
        return Option<V*>.Some(&node.unwrap().value);
    }

    // 上游 put: 返回被覆盖的旧值 (无则 None)
    pub fn put(key: Key, value: V) -> Option<V> {
        let parent: Option<RBNode<V>&> = Option<RBNode<V>&>.None;
        let current: Option<RBNode<V>&> = self.root;

        while current.is_some() {
            let node: RBNode<V>& = *current.unwrap();
            parent = Option<RBNode<V>&>.Some(node);
            let comparison: i32 = key_compare(key, node.key);
            if comparison < 0 {
                current = node.left;
            } elif comparison > 0 {
                current = node.right;
            } else {
                let old: V = node.value;
                node.value = value;
                return Option<V>.Some(old);
            }
        }

        let id: u64 = self.next_id;
        self.next_id += 1;
        let z: RBNode<V>& = dyn RBNode<V>(id, key, value, Option<RBNode<V>&>.None, Option<RBNode<V>&>.None, parent, true);
        match parent {
            None => {
                self.root = Option<RBNode<V>&>.Some(z);
            },
            Some(p) => {
                if key_compare(key, p.key) < 0 {
                    p.left = Option<RBNode<V>&>.Some(z);
                } else {
                    p.right = Option<RBNode<V>&>.Some(z);
                }
            },
        }

        // 插入修复 (上游 put 的 while 循环)
        let root: RBNode<V>& = *self.root.unwrap();
        let x: RBNode<V>& = z;
        while x.id != root.id && x.parent.unwrap().red {
            let x_parent: RBNode<V>& = *x.parent.unwrap();
            if x_parent.is_left_child() {
                let y: Option<RBNode<V>&> = x_parent.parent.unwrap().right;
                if y.is_some() && y.unwrap().red {
                    // Case 1
                    x_parent.red = false;
                    y.unwrap().red = false;
                    x_parent.parent.unwrap().red = true;
                    x = *x_parent.parent.unwrap();
                } else {
                    if x.is_right_child() {
                        // Case 2
                        x = x_parent;
                        self.left_rotate(x);
                    }
                    // Case 3
                    x.parent.unwrap().red = false;
                    x.parent.unwrap().parent.unwrap().red = true;
                    self.right_rotate(*(x.parent.unwrap().parent.unwrap()));
                }
            } else {
                let y: Option<RBNode<V>&> = x_parent.parent.unwrap().left;
                if y.is_some() && y.unwrap().red {
                    // Case 1
                    x_parent.red = false;
                    y.unwrap().red = false;
                    x_parent.parent.unwrap().red = true;
                    x = *x_parent.parent.unwrap();
                } else {
                    if x.is_left_child() {
                        // Case 2
                        x = x_parent;
                        self.right_rotate(x);
                    }
                    // Case 3
                    x.parent.unwrap().red = false;
                    x.parent.unwrap().parent.unwrap().red = true;
                    self.left_rotate(*(x.parent.unwrap().parent.unwrap()));
                }
            }
        }
        self.root.unwrap().red = false;
        return Option<V>.None;
    }

    // 上游 remove: 返回被删除的值 (无则 None)
    pub fn remove(key: Key) -> Option<V> {
        let found: Option<RBNode<V>&> = self.find_node(key);
        if found.is_none() {
            return Option<V>.None;
        }
        let z: RBNode<V>& = *found.unwrap();

        let y: RBNode<V>& = z;
        if !(z.left.is_none() || z.right.is_none()) {
            y = *self.successor(z).unwrap();
        }

        let x: Option<RBNode<V>&> = y.left;
        if x.is_none() {
            x = y.right;
        }

        let x_parent: Option<RBNode<V>&> = y.parent;
        if x.is_some() {
            x.unwrap().parent = y.parent;
        }
        match y.parent {
            None => {
                self.root = x;
            },
            Some(yp) => {
                if y.is_left_child() {
                    yp.left = x;
                } else {
                    yp.right = x;
                }
            },
        }

        if y.id != z.id {
            if !y.red {
                self.remove_fixup(x, x_parent);
            }
            y.parent = z.parent;
            y.red = z.red;
            y.left = z.left;
            y.right = z.right;
            if z.left.is_some() {
                z.left.unwrap().parent = Option<RBNode<V>&>.Some(y);
            }
            if z.right.is_some() {
                z.right.unwrap().parent = Option<RBNode<V>&>.Some(y);
            }
            match z.parent {
                Some(zp) => {
                    if z.is_left_child() {
                        zp.left = Option<RBNode<V>&>.Some(y);
                    } else {
                        zp.right = Option<RBNode<V>&>.Some(y);
                    }
                },
                None => {
                    self.root = Option<RBNode<V>&>.Some(y);
                },
            }
        } elif !y.red {
            self.remove_fixup(x, x_parent);
        }

        let value: V = z.value;
        del z;
        return Option<V>.Some(value);
    }

    static fn is_left_slot(x: Option<RBNode<V>&>, p: RBNode<V>&) -> bool {
        if x.is_none() {
            return p.left.is_none();
        }
        if p.left.is_none() {
            return false;
        }
        return p.left.unwrap().id == x.unwrap().id;
    }

    // 上游 removeFixup (x 可能为 None)
    fn remove_fixup(x: Option<RBNode<V>&>, x_parent: Option<RBNode<V>&>) {
        let node: Option<RBNode<V>&> = x;
        let parent: Option<RBNode<V>&> = x_parent;
        let root: RBNode<V>& = *self.root.unwrap();

        while (node.is_none() || node.unwrap().id != root.id) && (node.is_none() || !node.unwrap().red) {
            let p: RBNode<V>& = *parent.unwrap();
            if RBTree<V>.is_left_slot(node, p) {
                let w: RBNode<V>& = *p.right.unwrap();
                if w.red {
                    // Case 1
                    w.red = false;
                    p.red = true;
                    self.left_rotate(p);
                    w = *p.right.unwrap();
                }
                let wl_black: bool = w.left.is_none() || !w.left.unwrap().red;
                let wr_black: bool = w.right.is_none() || !w.right.unwrap().red;
                if wl_black && wr_black {
                    // Case 2
                    w.red = true;
                    node = parent;
                    parent = node.unwrap().parent;
                } else {
                    if w.right.is_none() || !w.right.unwrap().red {
                        // Case 3
                        w.left.unwrap().red = false;
                        w.red = true;
                        self.right_rotate(w);
                        w = *p.right.unwrap();
                    }
                    // Case 4
                    w.red = p.red;
                    p.red = false;
                    if w.right.is_some() {
                        w.right.unwrap().red = false;
                    }
                    self.left_rotate(p);
                    node = Option<RBNode<V>&>.Some(root);
                    parent = node.unwrap().parent;
                }
            } else {
                let w: RBNode<V>& = *p.left.unwrap();
                if w.red {
                    // Case 1
                    w.red = false;
                    p.red = true;
                    self.right_rotate(p);
                    w = *p.left.unwrap();
                }
                let wr_black: bool = w.right.is_none() || !w.right.unwrap().red;
                let wl_black: bool = w.left.is_none() || !w.left.unwrap().red;
                if wr_black && wl_black {
                    // Case 2
                    w.red = true;
                    node = parent;
                    parent = node.unwrap().parent;
                } else {
                    if w.left.is_none() || !w.left.unwrap().red {
                        // Case 3
                        w.right.unwrap().red = false;
                        w.red = true;
                        self.left_rotate(w);
                        w = *p.left.unwrap();
                    }
                    // Case 4
                    w.red = p.red;
                    p.red = false;
                    if w.left.is_some() {
                        w.left.unwrap().red = false;
                    }
                    self.right_rotate(p);
                    node = Option<RBNode<V>&>.Some(root);
                    parent = node.unwrap().parent;
                }
            }
        }
        if node.is_some() {
            node.unwrap().red = false;
        }
    }

    fn left_rotate(x: RBNode<V>&) {
        let y: RBNode<V>& = *x.right.unwrap();
        x.right = y.left;
        if y.left.is_some() {
            y.left.unwrap().parent = Option<RBNode<V>&>.Some(x);
        }
        y.parent = x.parent;
        match x.parent {
            None => {
                self.root = Option<RBNode<V>&>.Some(y);
            },
            Some(p) => {
                if x.is_left_child() {
                    p.left = Option<RBNode<V>&>.Some(y);
                } else {
                    p.right = Option<RBNode<V>&>.Some(y);
                }
            },
        }
        y.left = Option<RBNode<V>&>.Some(x);
        x.parent = Option<RBNode<V>&>.Some(y);
    }

    fn right_rotate(y: RBNode<V>&) {
        let x: RBNode<V>& = *y.left.unwrap();
        y.left = x.right;
        if x.right.is_some() {
            x.right.unwrap().parent = Option<RBNode<V>&>.Some(y);
        }
        x.parent = y.parent;
        match y.parent {
            None => {
                self.root = Option<RBNode<V>&>.Some(x);
            },
            Some(p) => {
                if y.is_left_child() {
                    p.left = Option<RBNode<V>&>.Some(x);
                } else {
                    p.right = Option<RBNode<V>&>.Some(x);
                }
            },
        }
        x.right = Option<RBNode<V>&>.Some(y);
        y.parent = Option<RBNode<V>&>.Some(x);
    }

    // 释放全部节点 (值型, 无嵌套分配)
    static fn free_subtree(node: Option<RBNode<V>&>) {
        if node.is_none() {
            return;
        }
        let n: RBNode<V>& = *node.unwrap();
        RBTree<V>.free_subtree(n.left);
        RBTree<V>.free_subtree(n.right);
        del n;
    }

    pub fn free_nodes() {
        RBTree<V>.free_subtree(self.root);
        self.root = Option<RBNode<V>&>.None;
    }
}

// ── 碰撞检测 (移植自上游 cd/Motion.java, cd/CollisionDetector.java, cd/Simulator.java) ──

fn motion_delta(m: Motion&) -> Vector3D {
    return v3_minus(m.pos_two, m.pos_one);
}

fn motion_find_intersection(m1: Motion&, m2: Motion&) -> Option<Vector3D> {
    let init1: Vector3D = m1.pos_one;
    let init2: Vector3D = m2.pos_one;
    let vec1: Vector3D = motion_delta(m1);
    let vec2: Vector3D = motion_delta(m2);
    let radius: f64 = 1.0;

    let a: f64 = v3_squared_magnitude(v3_minus(vec2, vec1));
    if a == 0.0 {
        // 同速平行/静止: 距离恒定
        let dist: f64 = v3_magnitude(v3_minus(init2, init1));
        if dist <= radius {
            return Option<Vector3D>.Some(v3_times(v3_plus(init1, init2), 0.5));
        }
        return Option<Vector3D>.None;
    }

    let b: f64 = 2.0 * v3_dot(v3_minus(init1, init2), v3_minus(vec1, vec2));
    let c: f64 = -radius * radius + v3_squared_magnitude(v3_minus(init2, init1));
    let discr: f64 = b * b - 4.0 * a * c;
    if discr < 0.0 {
        return Option<Vector3D>.None;
    }

    let root: f64 = sqrt(discr);  // 同一个 discr 只开方一次 (与上游等值)
    let v1: f64 = (-b - root) / (2.0 * a);
    let v2: f64 = (-b + root) / (2.0 * a);
    if v1 <= v2 && ((v1 <= 1.0 && 1.0 <= v2) || (v1 <= 0.0 && 0.0 <= v2) || (0.0 <= v1 && v2 <= 1.0)) {
        let v: f64 = v1;
        if v1 <= 0.0 {
            v = 0.0;
        }
        let result1: Vector3D = v3_plus(init1, v3_times(vec1, v));
        let result2: Vector3D = v3_plus(init2, v3_times(vec2, v));
        let result: Vector3D = v3_times(v3_plus(result1, result2), 0.5);
        if result.x >= 0.0 && result.x <= 1000.0 && result.y >= 0.0 && result.y <= 1000.0 && result.z >= 0.0 && result.z <= 10.0 {
            return Option<Vector3D>.Some(result);
        }
    }
    return Option<Vector3D>.None;
}

fn is_in_voxel(voxel: Vector2D, motion: Motion&) -> bool {
    if voxel.x > 1000.0 || voxel.x < 0.0 || voxel.y > 1000.0 || voxel.y < 0.0 {
        return false;
    }

    let init: Vector3D = motion.pos_one;
    let fin: Vector3D = motion.pos_two;

    let v_s: f64 = 2.0;
    let r: f64 = 0.5;

    let v_x: f64 = voxel.x;
    let x0: f64 = init.x;
    let xv: f64 = fin.x - init.x;

    let v_y: f64 = voxel.y;
    let y0: f64 = init.y;
    let yv: f64 = fin.y - init.y;

    let low_x: f64 = (v_x - r - x0) / xv;
    let high_x: f64 = (v_x + v_s + r - x0) / xv;
    if xv < 0.0 {
        let tmp: f64 = low_x;
        low_x = high_x;
        high_x = tmp;
    }

    let low_y: f64 = (v_y - r - y0) / yv;
    let high_y: f64 = (v_y + v_s + r - y0) / yv;
    if yv < 0.0 {
        let tmp: f64 = low_y;
        low_y = high_y;
        high_y = tmp;
    }

    return (((xv == 0.0 && v_x <= x0 + r && x0 - r <= v_x + v_s) || (low_x <= 1.0 && 1.0 <= high_x) || (low_x <= 0.0 && 0.0 <= high_x) || (0.0 <= low_x && high_x <= 1.0)) && ((yv == 0.0 && v_y <= y0 + r && y0 - r <= v_y + v_s) || ((low_y <= 1.0 && 1.0 <= high_y) || (low_y <= 0.0 && 0.0 <= high_y) || (0.0 <= low_y && high_y <= 1.0))) && (xv == 0.0 || yv == 0.0 || (low_y <= high_x && high_x <= high_y) || (low_y <= low_x && low_x <= high_y) || (low_x <= low_y && high_y <= high_x)));
}

fn voxel_hash(position: Vector3D) -> Vector2D {
    let x_div: i32 = i32(position.x / 2.0);
    let y_div: i32 = i32(position.y / 2.0);
    let x: f64 = 2.0 * f64(x_div);
    let y: f64 = 2.0 * f64(y_div);
    if position.x < 0.0 {
        x -= 2.0;
    }
    if position.y < 0.0 {
        y -= 2.0;
    }
    return Vector2D(x=x, y=y);
}

fn put_into_map(voxel_map: RBTree<Vec<Motion&>>&, voxel: Vector2D, motion: Motion&) {
    let key: Key = Key.Voxel(voxel.x, voxel.y);
    let found: Option<Vec<Motion&>*> = voxel_map.get(key);
    if found.is_none() {
        voxel_map.put(key, Vec<Motion&>.new());
    }
    let list: Vec<Motion&>* = *voxel_map.get(key).unwrap();
    list.push(motion);
}

fn recurse_voxels(voxel_map: RBTree<Vec<Motion&>>&, seen: RBTree<bool>&, next_voxel: Vector2D, motion: Motion&) {
    if !is_in_voxel(next_voxel, motion) {
        return;
    }
    let key: Key = Key.Voxel(next_voxel.x, next_voxel.y);
    if seen.put(key, true).is_some() {
        return;
    }
    put_into_map(voxel_map, next_voxel, motion);

    let horizontal: Vector2D = Vector2D(x=2.0, y=0.0);
    let vertical: Vector2D = Vector2D(x=0.0, y=2.0);
    recurse_voxels(voxel_map, seen, v2_minus(next_voxel, horizontal), motion);
    recurse_voxels(voxel_map, seen, v2_plus(next_voxel, horizontal), motion);
    recurse_voxels(voxel_map, seen, v2_minus(next_voxel, vertical), motion);
    recurse_voxels(voxel_map, seen, v2_plus(next_voxel, vertical), motion);
    recurse_voxels(voxel_map, seen, v2_minus(v2_minus(next_voxel, horizontal), vertical), motion);
    recurse_voxels(voxel_map, seen, v2_plus(v2_minus(next_voxel, horizontal), vertical), motion);
    recurse_voxels(voxel_map, seen, v2_minus(v2_plus(next_voxel, horizontal), vertical), motion);
    recurse_voxels(voxel_map, seen, v2_plus(v2_plus(next_voxel, horizontal), vertical), motion);
}

fn draw_motion_on_voxel_map(voxel_map: RBTree<Vec<Motion&>>&, motion: Motion&) {
    let seen: RBTree<bool> = RBTree<bool>.new();
    recurse_voxels(voxel_map, &seen, voxel_hash(motion.pos_one), motion);
    seen.free_nodes();
}

struct CollisionDetector {
    state: RBTree<Vector3D>,
}

impl CollisionDetector {
    static pub fn new() -> Self {
        return Self(state=RBTree<Vector3D>.new());
    }

    pub fn handle_new_frame(frame: Aircraft[]) -> i64 {
        let motions: Vec<Motion&> = Vec<Motion&>.new();
        let seen: RBTree<bool> = RBTree<bool>.new();

        let i: u64 = 0;
        while i < frame.len() {
            let callsign: i32 = frame[i].callsign;
            let new_position: Vector3D = frame[i].position;
            let key: Key = Key.Sign(callsign);
            let old_opt: Option<Vector3D> = self.state.put(key, new_position);
            seen.put(key, true);

            let old_position: Vector3D = new_position;
            match old_opt {
                Some(op) => {
                    old_position = op;
                },
                None => {
                },
            }
            let motion: Motion& = dyn Motion(callsign, old_position, new_position);
            motions.push(motion);
            i += 1;
        }

        // 移除本帧未出现的飞机
        let to_remove: Vec<i32> = Vec<i32>.new();
        let cur: Option<RBNode<Vector3D>&> = self.state.first();
        while cur.is_some() {
            let node: RBNode<Vector3D>& = *cur.unwrap();
            if seen.get(node.key).is_none() {
                to_remove.push(key_sign_value(node.key));
            }
            cur = self.state.successor(node);
        }
        let r: u64 = 0;
        while r < to_remove.len() {
            self.state.remove(Key.Sign(to_remove[r]));
            r += 1;
        }
        to_remove.drop();

        // 体素归并
        let voxel_map: RBTree<Vec<Motion&>> = RBTree<Vec<Motion&>>.new();
        let mi: u64 = 0;
        while mi < motions.len() {
            draw_motion_on_voxel_map(&voxel_map, motions[mi]);
            mi += 1;
        }

        // 同体素内两两求交
        let collisions: i64 = 0;
        let cur2: Option<RBNode<Vec<Motion&>>&> = voxel_map.first();
        while cur2.is_some() {
            let node: RBNode<Vec<Motion&>>& = *cur2.unwrap();
            let list: Vec<Motion&> = node.value;
            if list.len() > 1 {
                let a: u64 = 0;
                while a < list.len() {
                    let b: u64 = a + 1;
                    while b < list.len() {
                        match motion_find_intersection(list[a], list[b]) {
                            Some(position) => {
                                collisions += 1;
                            },
                            None => {
                            },
                        }
                        b += 1;
                    }
                    a += 1;
                }
            }
            cur2 = voxel_map.successor(node);
        }

        // 释放本帧结构: 先释放体素桶 (Vec 缓冲), 再释放树节点与 Motion
        let cur3: Option<RBNode<Vec<Motion&>>&> = voxel_map.first();
        while cur3.is_some() {
            let node: RBNode<Vec<Motion&>>& = *cur3.unwrap();
            let list: Vec<Motion&> = node.value;
            list.drop();
            cur3 = voxel_map.successor(node);
        }
        voxel_map.free_nodes();
        seen.free_nodes();
        let mf: u64 = 0;
        while mf < motions.len() {
            let motion: Motion& = motions[mf];
            del motion;
            mf += 1;
        }
        motions.drop();
        return collisions;
    }
}

fn simulate(aircraft: Vec<i32>, time: f64) -> Vec<Aircraft> {
    let frame: Vec<Aircraft> = Vec<Aircraft>.new();
    let i: u64 = 0;
    while i < aircraft.len() {
        let callsign: i32 = aircraft[i];
        frame.push(Aircraft(callsign=callsign, position=Vector3D(x=time, y=mycos(time) * 2.0 + f64(i) * 3.0, z=10.0)));
        frame.push(Aircraft(callsign=aircraft[i + 1], position=Vector3D(x=time, y=mysin(time) * 2.0 + f64(i) * 3.0, z=10.0)));
        i += 2;
    }
    return frame;
}

fn benchmark(num_aircrafts: i32) -> i64 {
    let aircraft: Vec<i32> = Vec<i32>.new();
    let a: i32 = 0;
    while a < num_aircrafts {
        aircraft.push(a);
        a += 1;
    }

    let detector: CollisionDetector = CollisionDetector.new();
    let actual_collisions: i64 = 0;
    let frame_index: i32 = 0;
    while frame_index < 200 {
        let time: f64 = f64(frame_index) / 10.0;
        let frame: Vec<Aircraft> = simulate(aircraft, time);
        actual_collisions += detector.handle_new_frame(frame.deref());
        frame.drop();
        frame_index += 1;
    }

    aircraft.drop();
    return actual_collisions;
}

fn main() {
    let AIRCRAFT: i32 = 100;
    let ITER: i64 = 80;
    let total: i64 = 0;
    let i: i64 = 0;
    while i < ITER {
        total += benchmark(AIRCRAFT);
        i += 1;
    }
    assert total == 4305 * ITER: "cd: collision count is not correct";
    print("cd pass\n");
}
