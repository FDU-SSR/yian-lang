// bench/shootout/spectralnorm.an — 谱范数 (shootout spectralnorm)
//
// 上游: Benchmarks Game (shootout) 改写; 本文件为本仓库改写版 (上游为 Revised BSD, Copyright 2008-2012 Isaac Gouy)
// 语义权威源: bench/c/spectralnorm.c (项目自写 C 参考)
// 规模: N=8000, 断言 res % 256 == 78。
//
// 注: 平方根用标准库 std.num.f64.sqrt (llvm.sqrt.f64 → sqrtsd), 与 C 参考的
//     libm sqrt 同一原语; 断言结果 78 与 C 版一致。
//
// 算法: 对称矩阵 A(i,j)=((i+j)(i+j+1)/2)+i+1, 迭代 10 次 mult_AtAv
//        求谱范数 sqrt(dot_uv/dot_vv), 输出 res = int(spec*100) % 256。
//
// 数组表示: dot/mult_Av/mult_Atv/mult_AtAv/normalize 的数组参数为 f64[]
//   (块访问语义, 32B 表示, 免 index 字段)。main 局部 u/v/tmp 直绑 f64[]
//   (let x: T[] = dyn[n] T, del-view 后 del T[] 整块合法)。
//
// 单一源: fat 与 raw 共用本文件。
// 合并规则: dyn 用类型推断; 需要切片处用范围视图 x[0u64..n]（两模式通用, fat 下仍受检查）。
from std.core.io import print;
from std.num.f64 import sqrt;

fn A(i: u64, j: u64) -> i32 {
    return i32((i + j) * (i + j + 1) / 2 + i + 1);
}

fn dot(v: f64[], w: f64[], n: u64) -> f64 {
    let sum: f64 = 0.0;
    let i: u64 = 0;
    while i < n {
        sum += v[i] * w[i];
        i += 1;
    }
    return sum;
}

fn mult_Av(v: f64[], out: f64[], n: u64) {
    let i: u64 = 0;
    while i < n {
        let sum: f64 = 0.0;
        let j: u64 = 0;
        while j < n {
            sum += v[j] / f64(A(i, j));
            j += 1;
        }
        out[i] = sum;
        i += 1;
    }
}

fn mult_Atv(v: f64[], out: f64[], n: u64) {
    let i: u64 = 0;
    while i < n {
        let sum: f64 = 0.0;
        let j: u64 = 0;
        while j < n {
            sum += v[j] / f64(A(j, i));
            j += 1;
        }
        out[i] = sum;
        i += 1;
    }
}

fn mult_AtAv(v: f64[], out: f64[], n: u64, tmp: f64[]) {
    mult_Av(v, tmp, n);
    mult_Atv(tmp, out, n);
}

fn normalize(v: f64[], n: u64) {
    let norm: f64 = 0.0;
    let i: u64 = 0;
    while i < n {
        norm += v[i] * v[i];
        i += 1;
    }
    norm = 1.0 / sqrt(norm);
    let j: u64 = 0;
    while j < n {
        v[j] *= norm;
        j += 1;
    }
}

fn main() {
    let n: u64 = 8000;
    let u = dyn[n] f64;
    let v = dyn[n] f64;
    let tmp = dyn[n] f64;

    let us: f64[] = u[0u64..n];
    let vs: f64[] = v[0u64..n];
    let ts: f64[] = tmp[0u64..n];

    let i: u64 = 0;
    while i < n {
        u[i] = 1.0;
        v[i] = 1.0;
        i += 1;
    }

    let it: u64 = 0;
    while it < 10 {
        mult_AtAv(us, vs, n, ts);
        mult_AtAv(vs, us, n, ts);

        if it % 2 == 0 {
            normalize(us, n);
        }
        it += 1;
    }

    mult_AtAv(us, vs, n, ts);
    let dot_uv: f64 = dot(us, vs, n);
    let dot_vv: f64 = dot(vs, vs, n);
    let spectral_norm: f64 = sqrt(dot_uv / dot_vv);
    let res: i32 = i32(spectral_norm * 100.0);
    assert res % 256 == 78: "spectralnorm: result is not correct";

    del u;
    del v;
    del tmp;
    print("spectralnorm pass\n");
}
