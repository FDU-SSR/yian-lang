// bench/shootout/spectralnorm.an — 谱范数 (shootout spectralnorm)
//
// 语义权威源: bak/old_exp/performance/c/spectralnorm.c (C 版)
// 规模参数取自原 .an (bak/old_exp/performance/an/spectralnorm.an):
//   原规模 N=8000, 断言 res % 256 == 78。
//   规模调整: N 保留原版 8000 (实测全胖 ~27s < 60s)
//   (C 版实测 N=2000/4000/8000 均 res % 256 == 78, 断言值与原版
//   一致; 三态同源码, 不影响归因)。
//
// 注: 当前语法无 sqrt 内建, 用牛顿迭代 mysqrt 实现 (相对误差 ~1ulp,
//     C 版 N=8000 结果 78 已实测对齐)。
//
// 算法: 对称矩阵 A(i,j)=((i+j)(i+j+1)/2)+i+1, 迭代 10 次 mult_AtAv
//        求谱范数 sqrt(dot_uv/dot_vv), 输出 res = int(spec*100) % 256。
//
// tiered-pointers t6 标注: 热路径 (dot/mult_Av/mult_Atv/mult_AtAv/normalize)
//   数组参数改为 f64[] (块访问语义, 32B 表示, 免 index 字段)。
//   main 局部 u/v/tmp 直绑 f64[] (let x: T[] = dyn[n] T, del-view 后
//   del T[] 整块合法)。
//
// 编译: python3 -m compiler.main -O2 lib bench/shootout/spectralnorm.an -o build/shootout_check/spectralnorm
// 预期: exit 0 (断言全过)
// 单一源: fat 与 raw 共用本文件（分支 archive/secl-paper-20260909 曾用 shootout/shootout_raw 两份）。
// 合并规则: dyn 用类型推断; 需要切片处用范围视图 x[0u64..n]（两模式通用, fat 下仍受检查）;
//           不引入热路径构造, 算法与规模与分支版本一致。
from std.core.io import print;

fn mysqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let r: f64 = (x + 1.0) * 0.5;
    let i: u32 = 0;
    while i < 40 {
        r = (r + x / r) * 0.5;
        i += 1;
    }
    return r;
}

fn A(i: u64, j: u64) -> i32 {
    return i32((i + j) * (i + j + 1) / 2 + i + 1);
}

fn dot(v: f64[], w: f64[], n: u64) -> f64 {
    let sum: f64 = 0.0;
    let i: u64 = 0;
    while i < n {
        sum += v[i] * w[i];
        i += 1;
    }
    return sum;
}

fn mult_Av(v: f64[], out: f64[], n: u64) {
    let i: u64 = 0;
    while i < n {
        let sum: f64 = 0.0;
        let j: u64 = 0;
        while j < n {
            sum += v[j] / f64(A(i, j));
            j += 1;
        }
        out[i] = sum;
        i += 1;
    }
}

fn mult_Atv(v: f64[], out: f64[], n: u64) {
    let i: u64 = 0;
    while i < n {
        let sum: f64 = 0.0;
        let j: u64 = 0;
        while j < n {
            sum += v[j] / f64(A(j, i));
            j += 1;
        }
        out[i] = sum;
        i += 1;
    }
}

fn mult_AtAv(v: f64[], out: f64[], n: u64, tmp: f64[]) {
    mult_Av(v, tmp, n);
    mult_Atv(tmp, out, n);
}

fn normalize(v: f64[], n: u64) {
    let norm: f64 = 0.0;
    let i: u64 = 0;
    while i < n {
        norm += v[i] * v[i];
        i += 1;
    }
    norm = 1.0 / mysqrt(norm);
    let j: u64 = 0;
    while j < n {
        v[j] *= norm;
        j += 1;
    }
}

fn main() {
    let n: u64 = 8000;
    let u = dyn[n] f64;
    let v = dyn[n] f64;
    let tmp = dyn[n] f64;

    let us: f64[] = u[0u64..n];
    let vs: f64[] = v[0u64..n];
    let ts: f64[] = tmp[0u64..n];

    let i: u64 = 0;
    while i < n {
        u[i] = 1.0;
        v[i] = 1.0;
        i += 1;
    }

    let it: u64 = 0;
    while it < 10 {
        mult_AtAv(us, vs, n, ts);
        mult_AtAv(vs, us, n, ts);

        if it % 2 == 0 {
            normalize(us, n);
        }
        it += 1;
    }

    mult_AtAv(us, vs, n, ts);
    let dot_uv: f64 = dot(us, vs, n);
    let dot_vv: f64 = dot(vs, vs, n);
    let spectral_norm: f64 = mysqrt(dot_uv / dot_vv);
    let res: i32 = i32(spectral_norm * 100.0);
    assert res % 256 == 78: "spectralnorm: result is not correct";

    del u;
    del v;
    del tmp;
    print("spectralnorm pass\n");
}
