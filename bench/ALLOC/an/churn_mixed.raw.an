// bench/ALLOC/an/churn_mixed.raw.an: mixed-size churn (raw mode), using the same algorithm as churn_mixed.an.
// Elements use T* (raw mode has no slices).
//
// Scale: 20000 rounds, each with one 16 KiB block and 256 blocks of 16 B.
// Assert checksum == rounds * (5 for the large block + 256 * 2 for small blocks).

from std.core.io import print;

fn main() {
    let rounds: u64 = 20000;  // bench-scale
    let small_count: u64 = 256;
    let checksum: i64 = 0;
    let expected: i64 = i64(rounds) * (5 + i64(small_count) * 2);

    let seed = dyn[1] 0i32;
    let round: u64 = 0;
    while round < rounds {
        let big = dyn[4000] 0i32;
        big[0] = 5;
        checksum += i64(big[0]);

        let smalls = dyn[small_count] seed;
        let i: u64 = 0;
        while i < small_count {
            smalls[i] = dyn[4] 0i32;
            smalls[i][0] = 2;
            checksum += i64(smalls[i][0]);
            i += 1;
        }

        del big;
        let j: u64 = 0;
        while j < small_count {
            let small: i32* = smalls[j];
            del small;
            j += 1;
        }
        del smalls;
        round += 1;
    }

    del seed;
    assert checksum == expected: "mixed churn checksum";
    print("mixed pass\n");
}
