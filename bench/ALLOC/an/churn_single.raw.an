// bench/ALLOC/an/churn_single.raw.an: same-size churn (raw mode), using churn_single.an's algorithm.
// Elements use T* (raw mode has no slices).
//
// Scale: 1000 rounds * 4096 dyn[4] i32 blocks (16 B payloads).
// Assert checksum == value 2 read per block * blocks * rounds.

fn main() {
    let batch_count: u64 = 4096;
    let rounds: u64 = 1000;  // bench-scale
    let checksum: i64 = 0;

    let seed = dyn[1] 0i32;
    let round: u64 = 0;
    while round < rounds {
        let batch = dyn[batch_count] seed;
        let i: u64 = 0;
        while i < batch_count {
            batch[i] = dyn[4] 0i32;
            batch[i][0] = 2;
            i += 1;
        }
        let j: u64 = 0;
        while j < batch_count {
            let block: i32* = batch[j];
            checksum += i64(block[0]);
            del block;
            j += 1;
        }
        del batch;
        round += 1;
    }

    del seed;
    assert checksum == i64(batch_count) * i64(rounds) * 2: "single-size churn checksum";
    print("single pass\n");
}
