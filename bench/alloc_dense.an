// bench/alloc_dense.an — 分配密集基准 (allocation-dense)
//
// 负载描述:
//   两阶段混合分配压力,目标让 Malloc/Delete 路径 (lock-slot 写入、
//   key 单调递增、free 校验) 成为本基准区别于其它两个基准的主导成本:
//     Phase A — Vec<i32> push/pop 反复churn: R1=220000 轮,每轮
//               Vec<i32>.new() 从容量 0 长到 32 (4 次 grow:
//               0→4→8→16→32, 每次 grow = 新块 Malloc + 旧块 free,
//               首次 0→4 无旧块; grow 4 次共 4 malloc + 3 free),push 32 次 +
//               pop 32 次 (每次过指针写/读 CheckSafeAccess),循环结束
//               Vec drop → 缓冲区 Delete (第 4 个 free)。
//     Phase B — dyn 分配 + 释放循环: R2=150000 轮,每轮 dyn[32] i32
//               分配 → 32 次写 → 2 次读 → del (恰好 1 Malloc + 1 Delete)。
//
//   规模约束: R2=150000 的取参依据 —— 原编译器缺陷 (循环体内读取
//   胖指针返回值的函数调用) 每次迭代向栈下泄漏 ~24B 且不回收,
//   R2=150000 时泄漏 ≈ 3.6MB < 默认 8MB 栈,留 2 倍余量以保证稳定运行。
//   该缺陷已修复 (alloca entry 提升,2026-08-14),不再泄漏;
//   R2=150000 规模保持不变,与既有基线一致。
//
// 已知缺陷 (已修复,alloca entry 提升,2026-08-14):
//   循环体内 “读路径” 的胖指针返回调用 (如 block[0] 经 Index<T*> 返回
//   40B 胖指针) 每次迭代向栈下压低 rsp ~24B,循环不恢复 → 栈溢出
//   (SIGSEGV exit 139)。R2=300000 时复现。修复方式: 循环体内的 alloca
//   提升到函数入口 (alloca entry hoisting),迭代间复用栈槽,不再向栈下
//   累积 —— 该缺陷已修复,不再限制分配密集循环的规模。
//
// 访问密度特征 (Malloc/Delete 主导 — 三基准中分配检查占比最高):
//   Phase A 每轮: 4× grow (Malloc+memmove+free), 32× push 写检查,
//                 32× pop 读检查, 1× drop free, ~16× validity_assert。
//   Phase B 每轮: 1× Malloc (libc malloc + GenKey + 锁槽写), 32× 元素写
//                 (CheckElementArith + CheckSafeAccess), 2× 读, 1× Delete。
//   全程序共 ≈ 22万×8 + 15万×2 ≈ 206 万次 Malloc/free 路径 (含检查),
//   与元素访问检查交错 — 分配/释放密度远高于 ptr_traverse / mixed。
//
// 正确性: checksum = PhaseA 和 + PhaseB 和,闭式断言 (防优化掉)。
//
// 编译:   python3 -m compiler.main -O2 lib bench/alloc_dense.an -o build/bench/alloc_dense
// 预期:   exit 0 (断言全过,无 trap)

from std.core.vec import Vec;
from std.core.option import Option;

fn main() {
    let checksum: i64 = 0;

    // ---- Phase A: Vec push/pop churn ----
    let rounds_a: u64 = 220000;
    let r: u64 = 0;
    while r < rounds_a {
        let v: Vec<i32> = Vec<i32>.new();
        let i: u64 = 0;
        while i < 32 {
            v.push(i32(i));
            i += 1;
        }
        let j: u64 = 0;
        while j < 32 {
            let popped: Option<i32> = v.pop();
            checksum += i64(*popped.unwrap());
            j += 1;
        }
        r += 1;
    }

    // ---- Phase B: dyn 分配 + del 循环 (Malloc/Delete dominated) ----
    let rounds_b: u64 = 150000;
    let r2: u64 = 0;
    while r2 < rounds_b {
        let block: i32* = dyn[32] i32;
        let k: u64 = 0;
        while k < 32 {
            block[k] = i32(k);
            k += 1;
        }
        // 保留块存活两次读,防止分配/填充被优化掉
        checksum += i64(block[0]) + i64(block[31]);
        del block;
        r2 += 1;
    }

    // 闭式断言: PhaseA 每轮 pop 回 0..31 (和 496), PhaseB 每轮 +0+31
    let expected_a: i64 = i64(496) * i64(rounds_a);
    let expected_b: i64 = i64(31) * i64(rounds_b);
    let expected: i64 = expected_a + expected_b;
    assert checksum == expected: "alloc_dense: churn checksum mismatch";
}
