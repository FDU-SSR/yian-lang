// bench/alloc/churn_mixed.raw.an — 混合尺寸 churn (裸态): 与 churn_mixed.an 同算法,
// 元素类型是 T* (裸态没有切片).
//
// 规模: 20000 轮, 每轮 1 个 16 KiB 大块 + 256 个 16 B 小块.
// 断言: checksum == 轮数 × (大块 5 + 小块 256 × 2).

from std.core.io import print;

fn main() {
    let rounds: u64 = 20000;
    let small_count: u64 = 256;
    let checksum: i64 = 0;
    let expected: i64 = i64(rounds) * (5 + i64(small_count) * 2);

    let round: u64 = 0;
    while round < rounds {
        let big = dyn[4000] i32;
        big[0] = 5;
        checksum += i64(big[0]);

        let smalls = dyn[small_count] i32*;
        let i: u64 = 0;
        while i < small_count {
            smalls[i] = dyn[4] i32;
            smalls[i][0] = 2;
            checksum += i64(smalls[i][0]);
            i += 1;
        }

        del big;
        let j: u64 = 0;
        while j < small_count {
            let small: i32* = smalls[j];
            del small;
            j += 1;
        }
        del smalls;
        round += 1;
    }

    assert checksum == expected: "mixed churn checksum";
    print("mixed pass\n");
}
