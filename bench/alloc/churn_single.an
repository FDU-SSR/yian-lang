// bench/alloc/churn_single.an — 同尺寸 churn (胖态): 每轮分配一批同尺寸块并整批释放.
//
// 规模: 1000 轮 × 4096 个 dyn[4] i32 (16 B 负载).
// 断言: checksum == 每轮读回值 2 × 块数 × 轮数.
//
// 块指针整批寄存在堆数组里 (逃逸), 因此两种模式下分配都不会被优化器删除.
// 裸态用 churn_single.raw.an (元素类型是 T* 而不是 T[]).

from std.core.io import print;

fn main() {
    let batch_count: u64 = 4096;
    let rounds: u64 = 1000;
    let checksum: i64 = 0;

    let round: u64 = 0;
    while round < rounds {
        let batch = dyn[batch_count] i32[];
        let i: u64 = 0;
        while i < batch_count {
            batch[i] = dyn[4] i32;
            batch[i][0] = 2;
            i += 1;
        }
        let j: u64 = 0;
        while j < batch_count {
            let block: i32[] = batch[j];
            checksum += i64(block[0]);
            del block;
            j += 1;
        }
        del batch;
        round += 1;
    }

    assert checksum == i64(batch_count) * i64(rounds) * 2: "single-size churn checksum";
    print("single pass\n");
}
