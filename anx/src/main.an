from std.core.env import args;
from std.core.fs import resolve;
from std.core.path import PathBuf;
from std.cli import ArgumentParser, Action, ArgMatches, Nargs, ParseOutcome, ValueType, CliError;
from anx.diagnostics.model import AX_NO_PROJECT_ROOT, Diagnostic, release_diagnostics;
from anx.driver.build import compile_project, compile_project_profiled, run_executable;
from anx.driver.runtime_profile import run_runtime_profile;
from anx.driver.fmt import format_project;
from anx.driver.new import scaffold;
from anx.driver.support import load_project;
from anx.driver.test import PointerMode, run as run_tests;
from anx.driver.profile import BuildProfile;
from anx.project.graph import graph_json, graph_text;
from anx.project.load import discover, load;
from anx.project.model import LoadReport, Project;
from anx.project.paths import standard_library_root;

fn release_args(values: Vec<String>&) {
    let index = 0u64;
    while index < values.len() { values[index].drop(); index += 1u64; }
    values.drop();
}

fn help_text() -> str {
    "Usage: anx <command> [options]\n\nCommands:\n  new <name>              Create a package\n  build [project]         Build an executable package\n  build profile [project] Build and write compile statistics\n  run [project]           Build and run a package\n  run profile [project]   Build, run, and record runtime statistics\n  check [project]         Check a package\n  test [project]          Run package tests\n  fmt [project]           Format package sources\n  graph [project]         Show the dependency graph\n"
}

fn release_strings(values: Vec<String>&) {
    let index = 0u64;
    while index < values.len() { values[index].drop(); index += 1u64; }
    values.drop();
}

fn argument_views(argv: Vec<String>&, start: u64, end: u64) -> Vec<str> {
    let views = Vec<str>.new();
    let index = start;
    while index < end {
        views.push(argv[index].as_str());
        index += 1u64;
    }
    views
}

fn report_argument_error(command: str, parser: ArgumentParser&, problem: CliError) -> i32 {
    match parser.format_usage() {
        Ok(usage) => { @eprint(f"{usage.as_str()}"); usage.drop(); },
        Err(error) => error.drop(),
    }
    let message = problem.format();
    @eprint("anx ");
    @eprint(f"{command}");
    @eprint(": ");
    @eprintln(f"{message.as_str()}");
    message.drop();
    problem.drop();
    2i32
}

fn argument_string(arg_matches: ArgMatches&, name: str, fallback: str) -> String {
    match arg_matches.get_string(name) {
        Ok(Some(value)) => String.from(&value),
        _ => String.from(&fallback),
    }
}

fn argument_bool(arg_matches: ArgMatches&, name: str) -> bool {
    match arg_matches.get_bool(name) {
        Ok(Some(value)) => value,
        _ => false,
    }
}

fn argument_level(arg_matches: ArgMatches&, name: str) -> Option<u8> {
    match arg_matches.get_u64(name) {
        Ok(Some(value)) => Option<u8>.Some(u8(value)),
        _ => Option<u8>.None,
    }
}

fn build_parser(command: str, profile_mode: bool) -> ArgumentParser {
    let name = String.from(&"anx ");
    name.push_str(command);
    if profile_mode { name.push_str(" profile"); }
    let parser = ArgumentParser.new(name.as_str());
    name.drop();
    if profile_mode {
        parser.description("Build an executable package and write compile statistics.");
    } else {
        parser.description("Build an executable and pass compiler options through to yianc.");
    }
    parser.add_argument("project").nargs(Nargs.Optional).default_value(".")
    .help("Project root directory (default: cwd)");
    parser.add_argument("optimization").short('O').value_type(ValueType.U64)
    .choices(["0", "1", "2", "3"].as_slice()).metavar("{0,1,2,3}")
    .help("Optimization level forwarded to the compiler");
    parser.add_argument("release").long("release").action(Action.StoreTrue)
    .help("Shorthand for -O3");
    parser.add_argument("raw-pointers").long("raw-pointers").action(Action.StoreTrue)
    .help("Build with bare pointers; for anx test, this selects raw mode");
    if profile_mode {
        parser.add_argument("profile-dir").long("profile-dir").metavar("PATH")
        .help("Report root directory (default: build/profile; relative paths resolve from the project root)");
    }
    parser
}

fn runtime_profile_parser() -> ArgumentParser {
    let parser = ArgumentParser.new("anx run profile");
    parser.description("Build, run, and record runtime statistics.");
    parser.add_argument("project").nargs(Nargs.Optional).default_value(".")
    .help("Project root directory (default: cwd)");
    parser.add_argument("optimization").short('O').value_type(ValueType.U64)
    .choices(["0", "1", "2", "3"].as_slice()).metavar("{0,1,2,3}")
    .help("Optimization level forwarded to the compiler");
    parser.add_argument("release").long("release").action(Action.StoreTrue)
    .help("Shorthand for -O3");
    parser.add_argument("raw-pointers").long("raw-pointers").action(Action.StoreTrue)
    .help("Build with bare pointers");
    parser.add_argument("profile-dir").long("profile-dir").metavar("PATH")
    .help("Report root directory (default: build/runtime-profile; relative paths resolve from the project root)");
    parser
}

fn legacy_profile_argument(argv: Vec<String>&, start: u64, end: u64, command: str) -> bool {
    let index = start;
    while index < end {
        if argv[index].as_str() == "--profile" {
            @eprint("anx ");
            @eprint(f"{command}");
            @eprintln(": --profile was removed; use 'anx build profile' for compile statistics");
            return true;
        }
        index += 1u64;
    }
    false
}

fn nonempty_option(arg_matches: ArgMatches&, name: str) -> Option<String> {
    match arg_matches.get_string(name) {
        Ok(Some(value)) => if value.as_slice().len() == 0u64 { Option<String>.None } else { Option<String>.Some(String.from(&value)) },
        _ => Option<String>.None,
    }
}

fn build_command(argv: Vec<String>&, command: str, start: u64, end: u64, profile_mode: bool,
    program_arguments: Vec<String>&) -> i32 {
    let parser = build_parser(command, profile_mode);
    defer parser.drop();
    let views = argument_views(argv, start, end);
    defer views.drop();
    let outcome = match parser.parse_args(views.as_slice()) {
        Ok(value) => value,
        Err(problem) => return report_argument_error(command, &parser, problem),
    };

    match outcome {
        Help(text) => {
            @print(f"{text.as_str()}");
            text.drop();
            0i32
        },
        Parsed(arg_matches) => {
            defer arg_matches.drop();
            let project = argument_string(&arg_matches, "project", ".");
            defer project.drop();
            let optimization = argument_level(&arg_matches, "optimization");
            let release = argument_bool(&arg_matches, "release");
            let raw = argument_bool(&arg_matches, "raw-pointers");
            let mode = if raw { "raw" } else { "fat" };
            if profile_mode {
                let provided = match arg_matches.was_provided("profile-dir") { Ok(value) => value, Err(_) => false };
                let root_value = nonempty_option(&arg_matches, "profile-dir");
                defer { match root_value.take() { Some(value) => value.drop(), None => {}, } };
                if provided && root_value.is_none() {
                    @eprintln("anx build profile: --profile-dir requires a non-empty path");
                    return 2i32;
                }
                let root = match &root_value { Some(value) => value.as_str(), None => "" };
                let level = match optimization { Some(value) => value, None => if release { 3u8 } else { 0u8 } };
                let profile = BuildProfile.new_with_root("build", "exe", level, mode, root);
                defer profile.drop();
                let executable = Option<PathBuf>.None;
                let succeeded = compile_project_profiled(project.as_str(), "exe", optimization, release, raw,
                    &executable, Option<BuildProfile&>.Some(&profile));
                match executable.take() { Some(path) => path.drop(), None => {}, }
                if !succeeded {
                    profile.finalize(false, 1i32);
                    let directory = String.from(&profile.report_dir());
                    defer directory.drop();
                    if !directory.is_empty() {
                        @eprint("anx build profile: report written to ");
                        @eprintln(f"{directory.as_str()}");
                    }
                    return 1i32;
                }
                profile.finalize(true, 0i32);
                let directory = String.from(&profile.report_dir());
                defer directory.drop();
                if !directory.is_empty() {
                    @eprint("anx build profile: report written to ");
                    @eprintln(f"{directory.as_str()}");
                }
                return 0i32;
            }
            let target = if command == "check" { "check" } else { "exe" };
            let executable = Option<PathBuf>.None;
            let succeeded = compile_project(project.as_str(), target, optimization, release, raw, &executable);
            if !succeeded { return 1i32; }
            if command == "run" {
                let path = match executable.take() {
                    Some(value) => value,
                    None => {
                        @eprintln("error: no executable was produced");
                        return 1i32;
                    },
                };
                return run_executable(path, program_arguments);
            }
            match executable.take() { Some(path) => path.drop(), None => {}, }
            0i32
        },
    }
}

fn format_command(argv: Vec<String>&) -> i32 {
    let parser = ArgumentParser.new("anx fmt");
    defer parser.drop();
    parser.description("Format the root package's own sources.");
    parser.add_argument("project").nargs(Nargs.Optional).default_value(".")
    .help("Project root directory (default: cwd)");
    parser.add_argument("check").long("check").action(Action.StoreTrue)
    .help("Report files that need formatting without rewriting them");
    let views = argument_views(argv, 2u64, argv.len());
    defer views.drop();
    let outcome = match parser.parse_args(views.as_slice()) {
        Ok(value) => value,
        Err(problem) => return report_argument_error("fmt", &parser, problem),
    };
    match outcome {
        Help(text) => {
            @print(f"{text.as_str()}");
            text.drop();
            0i32
        },
        Parsed(arg_matches) => {
            defer arg_matches.drop();
            let project = argument_string(&arg_matches, "project", ".");
            defer project.drop();
            format_project(project.as_str(), argument_bool(&arg_matches, "check"))
        },
    }
}

fn test_command(argv: Vec<String>&) -> i32 {
    if legacy_profile_argument(argv, 2u64, argv.len(), "test") { return 2i32; }
    let parser = build_parser("test", false);
    defer parser.drop();
    parser.description("Run the root package's tests.");
    parser.add_argument("pointer-mode").long("pointer-mode")
    .choices(["both", "fat", "raw"].as_slice()).metavar("{both,fat,raw}")
    .help("Pointer mode for package tests (default: both)");
    let views = argument_views(argv, 2u64, argv.len());
    defer views.drop();
    let outcome = match parser.parse_args(views.as_slice()) {
        Ok(value) => value,
        Err(problem) => return report_argument_error("test", &parser, problem),
    };
    match outcome {
        Help(text) => {
            @print(f"{text.as_str()}");
            text.drop();
            0i32
        },
        Parsed(arg_matches) => {
            defer arg_matches.drop();
            let selected_mode = match arg_matches.get_string("pointer-mode") {
                Ok(Some("fat")) => Option<PointerMode>.Some(PointerMode.Fat),
                Ok(Some("raw")) => Option<PointerMode>.Some(PointerMode.Raw),
                Ok(Some(_)) => Option<PointerMode>.Some(PointerMode.Both),
                _ => Option<PointerMode>.None,
            };
            let legacy_raw = argument_bool(&arg_matches, "raw-pointers");
            if legacy_raw && selected_mode.is_some() {
                @eprintln("anx test: --raw-pointers cannot be combined with --pointer-mode");
                return 2i32;
            }
            let pointer_mode = if legacy_raw {
                PointerMode.Raw
            } else {
                match selected_mode {
                    Some(value) => value,
                    None => PointerMode.Both,
                }
            };
            let project_path = argument_string(&arg_matches, "project", ".");
            defer project_path.drop();
            let project = match load_project(project_path.as_str()) {
                Some(value) => value,
                None => return 1i32,
            };
            defer project.drop();
            run_tests(&project, pointer_mode,
                argument_level(&arg_matches, "optimization"), argument_bool(&arg_matches, "release"))
        },
    }
}

fn new_command(argv: Vec<String>&) -> i32 {
    let parser = ArgumentParser.new("anx new");
    defer parser.drop();
    parser.description("Create a package skeleton.");
    parser.add_argument("name").help("Package directory and name");
    parser.add_argument("kind").long("kind").choices(["bin", "lib", "hybrid"].as_slice())
    .default_value("bin").help("Package kind (default: bin)");
    parser.add_argument("lib").long("lib").action(Action.StoreTrue)
    .help("Shorthand for --kind lib");
    let views = argument_views(argv, 2u64, argv.len());
    defer views.drop();
    let outcome = match parser.parse_args(views.as_slice()) {
        Ok(value) => value,
        Err(problem) => return report_argument_error("new", &parser, problem),
    };
    match outcome {
        Help(text) => {
            @print(f"{text.as_str()}");
            text.drop();
            0i32
        },
        Parsed(arg_matches) => {
            defer arg_matches.drop();
            let name = argument_string(&arg_matches, "name", "");
            defer name.drop();
            let kind = if argument_bool(&arg_matches, "lib") {
                String.from(&"lib")
            } else {
                argument_string(&arg_matches, "kind", "bin")
            };
            defer kind.drop();
            scaffold(name.as_str(), kind.as_str())
        },
    }
}

fn empty_report(start: str) -> LoadReport {
    let resolved = match resolve(start) {
        Ok(value) => value,
        Err(problem) => { problem.drop(); PathBuf.from(start) },
    };
    let message = String.from(&"no package.anx found in ");
    message.push_str(resolved.as_str());
    message.push_str(" or any parent directory");
    defer message.drop();
    let diagnostics = Vec<Diagnostic>.new();
    diagnostics.push(Diagnostic.new(AX_NO_PROJECT_ROOT, message.as_str(),
        Option<str>.Some(resolved.as_str()), Option<str>.None));
    resolved.drop();
    LoadReport.new(Option<Project>.None, diagnostics)
}

fn render_graph(project_arg: String, json: bool) -> i32 {
    defer project_arg.drop();
    let std_root = match standard_library_root() {
        Ok(value) => value,
        Err(message) => {
            @eprint("error: ");
            @eprintln(f"{message.as_str()}");
            message.drop();
            return 1i32;
        },
    };
    let root = discover(project_arg.as_str());
    let report = match root {
        Some(path) => {
            let loaded = load(path.as_str(), std_root.as_str());
            path.drop();
            loaded
        },
        None => empty_report(project_arg.as_str()),
    };
    std_root.drop();

    let status = if report.clean() && report.project().is_some() { 0i32 } else { 1i32 };
    let output = if json { graph_json(&report) } else { graph_text(&report) };
    @print(f"{output.as_str()}");
    @println("");
    output.drop();
    report.drop();
    status
}

fn graph_command(argv: Vec<String>&) -> i32 {
    let parser = ArgumentParser.new("anx graph");
    defer parser.drop();
    parser.description("Show the package graph and indexed source files.");
    parser.add_argument("project").nargs(Nargs.Optional).default_value(".")
    .help("Project root directory (default: cwd)");
    parser.add_argument("json").long("json").action(Action.StoreTrue)
    .help("Emit machine-readable JSON");
    let views = argument_views(argv, 2u64, argv.len());
    defer views.drop();
    let outcome = match parser.parse_args(views.as_slice()) {
        Ok(value) => value,
        Err(problem) => return report_argument_error("graph", &parser, problem),
    };
    match outcome {
        Help(text) => {
            @print(f"{text.as_str()}");
            text.drop();
            0i32
        },
        Parsed(arg_matches) => {
            defer arg_matches.drop();
            render_graph(argument_string(&arg_matches, "project", "."), argument_bool(&arg_matches, "json"))
        },
    }
}

fn build_dispatch(argv: Vec<String>&, command: str) -> i32 {
    let program_arguments = Vec<String>.new();
    defer release_strings(&program_arguments);
    let profile_mode = command == "build" && argv.len() > 2u64 && argv[2].as_str() == "profile";
    let start = if profile_mode { 3u64 } else { 2u64 };
    let end = argv.len();
    if command == "run" {
        let index = start;
        while index < argv.len() {
            if argv[index].as_str() == "--" {
                end = index;
                index += 1u64;
                while index < argv.len() {
                    program_arguments.push(String.from(&argv[index].as_str()));
                    index += 1u64;
                }
                break;
            }
            index += 1u64;
        }
    }
    if legacy_profile_argument(argv, start, end, command) { return 2i32; }
    if command == "run" && argv.len() > 2u64 && argv[2].as_str() == "profile" {
        let parser = runtime_profile_parser();
        defer parser.drop();
        let views = argument_views(argv, 3u64, end);
        defer views.drop();
        let outcome = match parser.parse_args(views.as_slice()) {
            Ok(value) => value,
            Err(problem) => return report_argument_error("run profile", &parser, problem),
        };
        match outcome {
            Help(text) => { @print(f"{text.as_str()}"); text.drop(); 0i32 },
            Parsed(arg_matches) => {
                defer arg_matches.drop();
                let project = argument_string(&arg_matches, "project", ".");
                defer project.drop();
                let provided = match arg_matches.was_provided("profile-dir") { Ok(value) => value, Err(_) => false };
                let root_value = nonempty_option(&arg_matches, "profile-dir");
                defer { match root_value.take() { Some(value) => value.drop(), None => {}, } };
                if provided && root_value.is_none() {
                    @eprintln("anx run profile: --profile-dir requires a non-empty path");
                    return 2i32;
                }
                let root = match &root_value { Some(value) => value.as_str(), None => "" };
                return run_runtime_profile(project.as_str(), argument_level(&arg_matches, "optimization"),
                    argument_bool(&arg_matches, "release"), argument_bool(&arg_matches, "raw-pointers"),
                    root, &program_arguments);
            },
        }
    }
    build_command(argv, command, start, end, profile_mode, &program_arguments)
}

fn run(argv: Vec<String>&) -> i32 {
    if argv.len() < 2u64 {
        @print(f"{help_text()}");
        return 1i32;
    }
    let command = argv[1].as_str();
    if command == "-h" || command == "--help" || command == "help" {
        @print(f"{help_text()}");
        return 0i32;
    }
    if command == "graph" { return graph_command(argv); }
    if command == "build" || command == "run" || command == "check" {
        return build_dispatch(argv, command);
    }
    if command == "fmt" { return format_command(argv); }
    if command == "new" { return new_command(argv); }
    if command == "test" { return test_command(argv); }
    @eprintln("anx: unknown command");
    2i32
}

fn main() {
    let arguments = args();
    let status = run(&arguments);
    release_args(&arguments);
    if status != 0i32 { exit(status); }
}
