from std.core.fs import canonicalize, create_dir_all, try_exists;
from std.core.path import Path, PathBuf;
from std.core.process import temporary_directory;
from anx.driver.build import compile_loaded, run_executable, load_project_for_build, CompileOptions;
from anx.driver.profile import BuildProfile;

fn report_root(root: str, override_path: str) -> Result<PathBuf, String> {
    if override_path.as_slice().len() == 0u64 {
        return Result<PathBuf, String>.Ok(Path.new(root).join("build/runtime-profile"));
    }
    if override_path.starts_with("/") {
        return Result<PathBuf, String>.Ok(PathBuf.from(override_path));
    }
    Result<PathBuf, String>.Ok(Path.new(root).join(override_path))
}

fn warn(message: str) {
    @eprint("anx run: warning: ");
    @eprintln(f"{message}");
}

// One invocation allocates an exclusive report directory and an exclusive artifact
// directory, so earlier runs and the ordinary build/app are never replaced.
pub struct RuntimeProfileBuild { executable: PathBuf, report_dir: PathBuf }

pub fn build_runtime_profile(start: str, options: CompileOptions&, profile_root: str,
    profile: Option<BuildProfile&>) -> Option<RuntimeProfileBuild> {
    let project = match load_project_for_build(start, profile) {
        Some(value) => value,
        None => return Option<RuntimeProfileBuild>.None,
    };
    defer project.drop();
    let root_index = match project.package_index(project.root_package()) {
        Some(value) => value,
        None => { @eprintln("anx run: error: project root package is missing"); return Option<RuntimeProfileBuild>.None; },
    };
    let root = project.package(root_index).root();
    let base = match report_root(root, profile_root) {
        Ok(value) => value,
        Err(message) => { @eprintln(f"{message.as_str()}"); message.drop(); return Option<RuntimeProfileBuild>.None; },
    };
    defer base.drop();
    match create_dir_all(base.as_str()) {
        Ok(_) => {},
        Err(problem) => {
            @eprint("anx run: error: cannot create report root: ");
            @eprintln(f"{problem.msg()}");
            problem.drop();
            return Option<RuntimeProfileBuild>.None;
        },
    }
    let report_root_path = match canonicalize(base.as_str()) {
        Ok(value) => value,
        Err(problem) => {
            @eprint("anx run: error: cannot resolve report root: ");
            @eprintln(f"{problem.msg()}");
            problem.drop();
            return Option<RuntimeProfileBuild>.None;
        },
    };
    defer report_root_path.drop();
    let run_directory = match temporary_directory(report_root_path.as_str()) {
        Ok(value) => value,
        Err(problem) => {
            @eprint("anx run: error: cannot create report directory: ");
            @eprintln(f"{problem.msg()}");
            problem.drop();
            return Option<RuntimeProfileBuild>.None;
        },
    };
    defer run_directory.drop();
    let artifact_base = Path.new(root).join("build/runtime-profile-artifacts");
    defer artifact_base.drop();
    match create_dir_all(artifact_base.as_str()) {
        Ok(_) => {},
        Err(problem) => {
            @eprint("anx run: error: cannot create artifact root: ");
            @eprintln(f"{problem.msg()}");
            problem.drop();
            return Option<RuntimeProfileBuild>.None;
        },
    }
    let artifact_directory = match temporary_directory(artifact_base.as_str()) {
        Ok(value) => value,
        Err(problem) => {
            @eprint("anx run: error: cannot create artifact directory: ");
            @eprintln(f"{problem.msg()}");
            problem.drop();
            return Option<RuntimeProfileBuild>.None;
        },
    };
    defer artifact_directory.drop();
    let artifact = Path.new(artifact_directory.as_str()).join("app");
    defer artifact.drop();

    let executable = Option<PathBuf>.None;
    let succeeded = compile_loaded(&project, "exe", options, &executable,
        Option<str>.Some(artifact.as_str()), Option<str>.Some(run_directory.as_str()),
        profile);
    if !succeeded { return Option<RuntimeProfileBuild>.None; }
    let program = match executable.take() {
        Some(path) => path,
        None => { @eprintln("error: no executable was produced"); return Option<RuntimeProfileBuild>.None; },
    };
    Option<RuntimeProfileBuild>.Some(RuntimeProfileBuild(program, PathBuf.from(run_directory.as_str())))
}

impl RuntimeProfileBuild {
    pub fn run(program_arguments: Vec<String>&) -> i32 {
        let program = PathBuf.from(self.executable.as_str());
        let status = run_executable(program, program_arguments);
        if status == 0i32 {
            let json_path = Path.new(self.report_dir.as_str()).join("profile.json");
            defer json_path.drop();
            let text_path = Path.new(self.report_dir.as_str()).join("summary.txt");
            defer text_path.drop();
            let json_ready = match try_exists(json_path.as_str()) { Ok(value) => value, Err(problem) => { problem.drop(); false } };
            let text_ready = match try_exists(text_path.as_str()) { Ok(value) => value, Err(problem) => { problem.drop(); false } };
            if json_ready && text_ready {
                @eprint("anx run: runtime profile report written to ");
                @eprintln(f"{self.report_dir.as_str()}");
            } else {
                warn("the expected runtime report files are missing");
            }
        }
        status
    }
}
impl Drop for RuntimeProfileBuild {
    pub fn drop() { self.executable.drop(); self.report_dir.drop(); }
}
