from std.core.drop import Drop;
from std.core.fs import resolve;
from std.core.io import eprint, eprintln;
from std.core.path import PathBuf;
from anx.diagnostics.model import AX_NO_PROJECT_ROOT, Diagnostic;
from anx.project.load import discover, load;
from anx.project.model import Project;
from anx.project.paths import standard_library_root;
from anx.driver.profile import BuildProfile;

fn print_diagnostic(item: Diagnostic&) {
    eprint("error[");
    eprint(item.code());
    eprint("]: ");
    match item.path() { Some(path) => { eprint(path); eprint(": "); }, None => {}, }
    eprintln(item.message());
    match item.hint() { Some(hint) => { eprint("  hint: "); eprintln(hint); }, None => {}, }
}

pub fn load_project(start: str) -> Option<Project> {
    load_project_profiled(start, Option<BuildProfile&>.None)
}

pub fn load_project_profiled(start: str, profile: Option<BuildProfile&>) -> Option<Project> {
    let project_load_token = match profile { Some(value) => value.begin("anx.project_load"), None => 0u64 };
    let loaded = false;
    defer { match profile { Some(value) => value.finish(project_load_token, loaded), None => {}, }; };
    let std_root = match standard_library_root() {
        Ok(value) => value,
        Err(message) => {
            eprint("error: ");
            eprintln(message.as_str());
            message.drop();
            return Option<Project>.None;
        },
    };
    defer std_root.drop();
    let root = discover(start);
    let root_path = match root {
        Some(value) => value,
        None => {
            let path = match resolve(start) {
                Ok(value) => value,
                Err(problem) => { problem.drop(); PathBuf.from(start) },
            };
            let message = String.from(&"no package.anx found in ");
            message.push_str(path.as_str());
            message.push_str(" or any parent directory");
            defer { message.drop(); path.drop(); };
            let diagnostic = Diagnostic.new(AX_NO_PROJECT_ROOT, message.as_str(),
                Option<str>.Some(path.as_str()), Option<str>.None);
            print_diagnostic(&diagnostic);
            diagnostic.drop();
            return Option<Project>.None;
        },
    };
    defer root_path.drop();
    match profile { Some(value) => value.set_project_root(root_path.as_str()), None => {}, }
    let report = load(root_path.as_str(), std_root.as_str());
    defer report.drop();
    let diagnostics = report.diagnostics();
    let index = 0u64;
    while index < diagnostics.len() {
        print_diagnostic(&diagnostics[index]);
        index += 1u64;
    }
    if diagnostics.len() != 0u64 { return Option<Project>.None; }
    match report.take_project() {
        Some(project) => { loaded = true; Option<Project>.Some(project) },
        None => {
            eprintln("error: could not load project");
            Option<Project>.None
        },
    }
}
