from std.core.drop import Drop;
from std.core.fs import resolve;
from std.core.path import PathBuf;
from std.core.process import Command;
from anx.diagnostics.model import AX_NO_PROJECT_ROOT, Diagnostic;
from anx.driver.formatter import formatter_program;
from anx.project.load import discover, load;
from anx.project.model import LoadReport, Project;
from anx.project.paths import standard_library_root;

fn print_diagnostic(item: Diagnostic&) {
    @eprint("error[");
    @eprint(f"{item.code()}");
    @eprint("]: ");
    match item.path() { Some(path) => { @eprint(f"{path}"); @eprint(": "); }, None => {}, }
    @eprintln(f"{item.message()}");
    match item.hint() { Some(hint) => { @eprint("  hint: "); @eprintln(f"{hint}"); }, None => {}, }
}

fn load_project(start: str) -> Option<Project> {
    let std_root = match standard_library_root() {
        Ok(value) => value,
        Err(message) => { @eprint("error: "); @eprintln(f"{message.as_str()}"); message.drop(); return Option<Project>.None; },
    };
    defer std_root.drop();
    let root = discover(start);
    let root_path = match root {
        Some(value) => value,
        None => {
            let path = match resolve(start) {
                Ok(value) => value,
                Err(problem) => { problem.drop(); PathBuf.from(start) },
            };
            let message = String.from(&"no package.anx found in ");
            message.push_str(path.as_str());
            message.push_str(" or any parent directory");
            defer { message.drop(); path.drop(); };
            let diagnostic = Diagnostic.new(AX_NO_PROJECT_ROOT, message.as_str(),
                Option<str>.Some(path.as_str()), Option<str>.None);
            print_diagnostic(&diagnostic);
            diagnostic.drop();
            return Option<Project>.None;
        },
    };
    defer root_path.drop();
    let report = load(root_path.as_str(), std_root.as_str());
    defer report.drop();
    let diagnostics = report.diagnostics();
    let index = 0u64;
    while index < diagnostics.len() { print_diagnostic(&diagnostics[index]); index += 1u64; }
    if diagnostics.len() != 0u64 { return Option<Project>.None; }
    report.take_project()
}

fn package_sources(project: Project&) -> Vec<u64> {
    let indices = Vec<u64>.new();
    let index = 0u64;
    while index < project.file_count() {
        if project.file(index).package() == project.root_package() { indices.push(index); }
        index += 1u64;
    }
    indices
}

// Root-package selection stays in the package manager. The formatter owns
// parsing, rendering, rewriting and the summary; this driver passes the
// selected absolute source paths through one child process.
pub fn format_project(start: str, check: bool) -> i32 {
    let project = match load_project(start) {
        Some(value) => value,
        None => return 1i32,
    };
    defer project.drop();
    let files = package_sources(&project);
    defer files.drop();
    if files.is_empty() {
        if check { @println("0 of 0 file(s) need formatting"); } else { @println("0 file(s) checked, 0 rewritten"); }
        return 0i32;
    }

    let program = match formatter_program() {
        Ok(value) => value,
        Err(message) => { @eprintln(f"{message.as_str()}"); message.drop(); return 1i32; },
    };
    defer program.drop();
    let command = Command.new(program.as_str());
    defer command.drop();
    if check { command.arg("--check"); } else { command.arg("--write"); }
    command.arg("--");
    let index = 0u64;
    while index < files.len() {
        let file = project.file(files[index]);
        command.arg(file.path());
        index += 1u64;
    }
    match command.status() {
        Ok(status) => if status.success() { 0i32 } else { 1i32 },
        Err(problem) => {
            @eprint("error: could not run yian-fmt: ");
            @eprintln(f"{problem.msg()}");
            problem.drop();
            1i32
        },
    }
}
