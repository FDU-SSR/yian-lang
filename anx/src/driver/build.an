from std.core.drop import Drop;
from std.core.fs import create_dir_all, read_to_string, resolve, write_string;
from std.core.io import IoErrorKind, eprint, eprintln;
from std.core.path import Path, PathBuf;
from std.core.process import Command, ExitStatus;
from anx.diagnostics.model import Diagnostic;
from anx.driver.compiler import compiler_program;
from anx.project.load import discover, load;
from anx.manifest.model import PackageKind;
from anx.project.model import LoadReport, Project;
from anx.project.package_map import package_map_json;
from anx.project.paths import standard_library_root;
from anx.driver.profile import BuildProfile, InvocationHandle;

fn release_paths(values: Vec<PathBuf>&) {
    let index = 0u64;
    while index < values.len() { values[index].drop(); index += 1u64; }
    values.drop();
}

fn write_diagnostic(item: Diagnostic&) {
    eprint("error[");
    eprint(item.code());
    eprint("]: ");
    match item.path() { Some(path) => { eprint(path); eprint(": "); }, None => {}, }
    eprintln(item.message());
    match item.hint() {
        Some(hint) => { eprint("  hint: "); eprintln(hint); },
        None => {},
    }
}

fn report_diagnostics(report: LoadReport&) -> bool {
    let diagnostics = report.diagnostics();
    let index = 0u64;
    while index < diagnostics.len() {
        write_diagnostic(&diagnostics[index]);
        index += 1u64;
    }
    diagnostics.len() != 0u64
}

fn package_map_path(project: Project&) -> Result<PathBuf, String> {
    let root_index = match project.package_index(project.root_package()) {
        Some(value) => value,
        None => return Result<PathBuf, String>.Err(msg=String.from(&"project root package is missing")),
    };
    let root = project.package(root_index).root();
    let build = Path.new(root).join("build");
    defer build.drop();
    match create_dir_all(build.as_str()) {
        Ok(_) => {},
        Err(problem) => {
            let message = String.from(&"Cannot create build directory: ");
            message.push_str(problem.msg());
            problem.drop();
            return Result<PathBuf, String>.Err(msg=message);
        },
    }
    let path = Path.new(build.as_str()).join("pkg.json");
    let expected = package_map_json(project);
    defer expected.drop();
    let unchanged = match read_to_string(path.as_str()) {
        Ok(actual) => {
            defer actual.drop();
            actual.as_str() == expected.as_str()
        },
        Err(problem) => {
            if problem.kind() == IoErrorKind.NotFound {
                problem.drop();
                false
            } else {
                let message = String.from(&"Cannot read package map: ");
                message.push_str(problem.msg());
                problem.drop();
                path.drop();
                return Result<PathBuf, String>.Err(msg=message);
            }
        },
    };
    if !unchanged {
        match write_string(path.as_str(), expected.as_str()) {
            Ok(_) => {},
            Err(problem) => {
                let message = String.from(&"Cannot write package map: ");
                message.push_str(problem.msg());
                problem.drop();
                path.drop();
                return Result<PathBuf, String>.Err(msg=message);
            },
        }
    }
    Result<PathBuf, String>.Ok(val=path)
}

fn load_project_for_build(start: str, profile: Option<BuildProfile&>) -> Option<Project> {
    let token = profile_begin(profile, "anx.project_load");
    let loaded = false;
    defer { profile_finish(profile, token, loaded); };
    let std_root = match standard_library_root() {
        Ok(value) => value,
        Err(message) => {
            eprint("error: ");
            eprintln(message.as_str());
            message.drop();
            return Option<Project>.None;
        },
    };
    defer std_root.drop();
    let discovered = discover(start);
    let root_path = match discovered {
        Some(value) => value,
        None => {
            let resolved = match resolve(start) {
                Ok(value) => value,
                Err(problem) => { problem.drop(); PathBuf.from(start) },
            };
            let message = String.from(&"error[AX001]: no package.anx found in ");
            message.push_str(resolved.as_str());
            message.push_str(" or any parent directory\n");
            eprint(message.as_str());
            message.drop();
            resolved.drop();
            return Option<Project>.None;
        },
    };
    defer root_path.drop();
    match profile { Some(value) => value.set_project_root(root_path.as_str()), None => {}, }
    let report = load(root_path.as_str(), std_root.as_str());
    defer report.drop();
    if report_diagnostics(&report) { return Option<Project>.None; }
    let project = match report.take_project() {
        Some(value) => value,
        None => { eprintln("error: could not load project"); return Option<Project>.None; },
    };
    loaded = true;
    Option<Project>.Some(project)
}

fn profile_begin(profile: Option<BuildProfile&>, pass_id: str) -> u64 {
    match profile { Some(value) => value.begin(pass_id), None => 0u64 }
}

fn profile_finish(profile: Option<BuildProfile&>, token: u64, success: bool) {
    match profile { Some(value) => value.finish(token, success), None => {}, }
}

fn status_code(status: ExitStatus) -> i32 {
    match status { Exited(code) => code, Signaled(signal) => -signal }
}

fn compiler_command(program: str, project: Project&, target: str, level: Option<u8>, release: bool,
    raw_pointers: bool, map_path: str, executable: Option<PathBuf>, runtime_profile_dir: Option<str>,
    profile: Option<BuildProfile&>) -> bool {
    let command = Command.new(program);
    defer command.drop();
    command.interruptible(true);
    let root_index = match project.package_index(project.root_package()) {
        Some(value) => value,
        None => { eprintln("error: project root package is missing"); return false; },
    };
    command.current_dir(project.package(root_index).root());
    command.arg("--packages");
    command.arg(map_path);
    if target == "check" {
        command.arg("--check");
    } else {
        command.arg("-t");
        command.arg(target);
    }
    match executable {
        Some(path) => { command.arg("-o"); command.arg(path.as_str()); path.drop(); },
        None => {},
    }
    match level {
        Some(value) => {
            command.arg("-O");
            let text = u64(value).to_string();
            command.arg(text.as_str());
            text.drop();
        },
        None => if release { command.arg("-O"); command.arg("3"); },
    }
    if raw_pointers { command.arg("--raw-pointers"); }
    match runtime_profile_dir {
        Some(directory) => { command.arg("--runtime-profile-dir"); command.arg(directory); },
        None => {},
    }
    let optimization = match level { Some(value) => value, None => if release { 3u8 } else { 0u8 } };
    let mode = if raw_pointers { "raw" } else { "fat" };
    let invocation = match profile {
        Some(value) => Option<InvocationHandle>.Some(value.begin_invocation(Option<str>.None, mode, target, optimization, program)),
        None => Option<InvocationHandle>.None,
    };
    match &invocation {
        Some(value) => if !value.profile_path.is_empty() { command.arg("--profile-output"); command.arg(value.profile_path.as_str()); },
        None => {},
    }
    let files = project.build_files();
    defer release_paths(&files);
    let index = 0u64;
    while index < files.len() {
        command.arg(files[index].as_str());
        index += 1u64;
    }
    let wait_token = profile_begin(profile, "anx.compiler_wait");
    let status_result = command.status();
    let status = match status_result {
        Ok(value) => value,
        Err(problem) => {
            profile_finish(profile, wait_token, false);
            match invocation.take() {
                Some(handle) => match profile {
                    Some(observer) => observer.finish_invocation(handle, Option<i32>.None),
                    None => { handle.drop(); Option<i64>.None },
                },
                None => Option<i64>.None,
            }
            eprint("error: could not start YIAN compiler: ");
            eprintln(problem.msg());
            problem.drop();
            return false;
        },
    };
    let report_requested = match &invocation { Some(handle) => !handle.profile_path.is_empty(), None => false };
    let work_finished_at_ns = match invocation.take() {
        Some(handle) => match profile {
            Some(observer) => observer.finish_invocation(handle, Option<i32>.Some(status_code(status))),
            None => { handle.drop(); Option<i64>.None },
        },
        None => Option<i64>.None,
    };
    match profile {
        Some(observer) => if report_requested {
            observer.finish_at(wait_token, status.success(), work_finished_at_ns);
        } else {
            observer.finish(wait_token, status.success())
        },
        None => {},
    }
    status.success()
}

pub fn compile_project(start: str, target: str, level: Option<u8>, release: bool,
    raw_pointers: bool, executable_out: Option<PathBuf>&) -> bool {
    compile_project_profiled(start, target, level, release, raw_pointers, executable_out, Option<BuildProfile&>.None)
}

pub fn compile_project_profiled(start: str, target: str, level: Option<u8>, release: bool,
    raw_pointers: bool, executable_out: Option<PathBuf>&, profile: Option<BuildProfile&>) -> bool {
    let loaded = load_project_for_build(start, profile);
    let project = match loaded { Some(value) => value, None => return false };
    defer project.drop();
    compile_loaded(&project, target, level, release, raw_pointers, executable_out,
        Option<str>.None, Option<str>.None, profile)
}

// compile_loaded builds an already loaded root package. output_override selects the artifact
// path, and runtime_profile_dir enables the instrumented build in the compiler.
pub fn compile_loaded(project: Project&, target: str, level: Option<u8>, release: bool,
    raw_pointers: bool, executable_out: Option<PathBuf>&, output_override: Option<str>,
    runtime_profile_dir: Option<str>, profile: Option<BuildProfile&>) -> bool {
    let compiler = match compiler_program() {
        Ok(value) => value,
        Err(message) => { eprint("error: "); eprintln(message.as_str()); message.drop(); return false; },
    };
    defer compiler.drop();

    let root_index = match project.package_index(project.root_package()) {
        Some(value) => value,
        None => { eprintln("error: project root package is missing"); return false; },
    };
    let root_package = project.package(root_index);
    if root_package.kind() == PackageKind.Lib && target == "exe" {
        eprintln("error: 'anx build' is not supported for kind 'lib' packages: this stage produces no library artifact");
        return false;
    }
    let map_token = profile_begin(profile, "anx.package_map");
    let map_result = package_map_path(project);
    let map = match map_result {
        Ok(value) => { profile_finish(profile, map_token, true); value },
        Err(message) => { profile_finish(profile, map_token, false); eprint("error: "); eprintln(message.as_str()); message.drop(); return false; },
    };
    defer map.drop();
    let project_root = project.package(root_index).root();
    let output = if target == "exe" {
        match &output_override {
            Some(value) => Option<PathBuf>.Some(PathBuf.from(*value)),
            None => Option<PathBuf>.Some(Path.new(project_root).join("build/app")),
        }
    } else { Option<PathBuf>.None };
    let command_output = match &output {
        Some(path) => Option<PathBuf>.Some(PathBuf.from(path.as_str())),
        None => Option<PathBuf>.None,
    };
    let succeeded = compiler_command(compiler.as_str(), project, target, level, release, raw_pointers,
        map.as_str(), command_output, runtime_profile_dir, profile);
    if !succeeded {
        match output.take() { Some(path) => path.drop(), None => {}, }
        return false;
    }
    match output.take() {
        Some(path) => { *executable_out = Option<PathBuf>.Some(path); },
        None => {},
    }
    true
}

pub fn run_executable(executable: PathBuf, arguments: Vec<String>&) -> i32 {
    let command = Command.new(executable.as_str());
    defer command.drop();
    command.inherit_stdin();
    command.interruptible(true);
    let index = 0u64;
    while index < arguments.len() {
        command.arg(arguments[index].as_str());
        index += 1u64;
    }
    let status = match command.status() {
        Ok(value) => value,
        Err(problem) => {
            if problem.kind() == IoErrorKind.Interrupted {
                problem.drop();
                return 130i32;
            }
            eprint("error: could not start program: ");
            eprintln(problem.msg());
            problem.drop();
            return 1i32;
        },
    };
    match status {
        Exited(code) => code,
        Signaled(signal) => -signal,
    }
}
