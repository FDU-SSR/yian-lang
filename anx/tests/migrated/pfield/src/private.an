// A unit containing public and private items
// Do not compile this file standalone

pub struct ExportableStruct {
    pub pub_field: i32,
    priv_field: i32,
}

struct NonExportableStruct {
    pub pub_field: i32,
    priv_field: i32,
}

impl ExportableStruct {
    static pub fn new(a: i32, b: i32) -> Self {
        return ExportableStruct(a, b);
    }
}

pub fn make_non_exportable(a: i32, b: i32) -> NonExportableStruct {
    return NonExportableStruct(a, b);
}

fn make_exportable(a: i32, b: i32) -> ExportableStruct {
    return ExportableStruct(a, b);
}

pub fn get_priv_field(es: ExportableStruct*) -> i32 {
    return es.priv_field;
}