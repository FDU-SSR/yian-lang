// Test importing a type and using its methods and traits
//
// Expected output: Person is walking.

from std.core.io import print;

from typetest.person import Person;

fn main() -> i32 {
    let p: Person = Person.new(25, 175.5);

    assert p.get_age() == 25;
    assert p.get_height() > 175.0 && p.get_height() < 176.0;

    p.walk();

    assert p.get_age() == 26;
    assert p.get_height() > 176.0 && p.get_height() < 177.0;

    return 0;
}